+      nullptr,
+      nullptr,
+      nullptr,
+      nullptr,
+      src_k_layers.data_ptr<uintptr_t>(),
+      dst_k_layers.data_ptr<uintptr_t>(),
+      src_v_layers.data_ptr<uintptr_t>(),
+      dst_v_layers.data_ptr<uintptr_t>(),
+      src_indices,
+      dst_indices,
+      0,
+      num_layers,
+      item_size,
+      block_quota,
+      sgs_per_wg);
+}
