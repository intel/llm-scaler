+        x.contiguous(),
+        router_logits.contiguous(),
+        w13,
+        _expert_scale(layer.w13_weight_scale, "w13 scale"),
+        w2,
+        _expert_scale(layer.w2_weight_scale, "w2 scale"),
+        _expert_scale(per_expert_scale, "output scale"),
+        8,
+        128,
+    )
+
