+        #   mtp.fc.weight                  -> fc.weight            (bare nn.Linear)
+        #   mtp.pre_fc_norm_*              -> pre_fc_norm_*
+        #   mtp.norm.weight                -> model.norm.weight    (wrapped final norm)
