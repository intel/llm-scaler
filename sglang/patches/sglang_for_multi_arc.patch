+    # from raw pointers (a mismatch would fault with DEVICE_LOST).
+    if qs.dim() != 2 or scale.dim() != 2:
+        return None
+    if qs.dtype != torch.int8 or scale.dtype != torch.float16:
+        return None
+    if qs.shape[1] % 32 != 0 or scale.shape[0] != qs.shape[0]:
