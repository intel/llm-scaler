+            return None
+        qs, sc = rep0[1], rep0[2]
+        hidden = hidden_states.shape[1]
+        if qs.dim() != 2 or qs.shape[1] != hidden:
+            logger.warning("[gguf_resadd_norm] %s: q8_0 K=%s != hidden=%s",
+                           tag, tuple(qs.shape), hidden)
