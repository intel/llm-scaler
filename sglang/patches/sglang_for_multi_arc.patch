+                if cached is None or cached.dtype != x.dtype:
+                    cached = self.weight.to(x.dtype).contiguous()
+                    self._weight_cast_cache = cached
+                weight = cached
+            x_shape_og = x.shape
+            x2d = x.reshape(-1, x.shape[-1]).contiguous()
