+        if lin1 is not None:
+            rep1 = _gguf_xpu_rep(lin1, "fp16")
+            if rep1 is None or rep1[1].dim() != 2 or rep1[1].shape[1] != hidden:
+                logger.warning("[gguf_resadd_norm] %s: ba is not a single fp16 [N,%s] rep",
+                               tag, hidden)
+                layer._gguf_norm_q8_off = True
+                return None
+            w1 = rep1[1].contiguous()
