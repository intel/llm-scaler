+    hi = (qs >> 4) & 0x0F                             # nib of elems 16..31
+    nib = torch.cat([lo, hi], dim=2)                  # [N, blocks, 32], nib[...,i]=elem i
+    even = nib[:, :, 0::2]                            # elems 0,2,...,30
+    odd = nib[:, :, 1::2]                             # elems 1,3,...,31
+    packed = (even | (odd << 4)).to(torch.uint8).view(N, blocks * 16)  # [N, K/2]
