+def _nan_probe(tag, t, layer_id=None, forward_batch=None, residual=None):
+    if not _NAN_PROBE:
+        return
+    try:
+        nan_h, inf_h = _np_bad(t)
+        nan_r, inf_r = _np_bad(residual)
+        if (nan_h + inf_h + nan_r + inf_r) == 0:
+            return
+        mode = "?"
+        if forward_batch is not None:
