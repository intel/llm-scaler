+    """Run the Gemma4-26B TP=2 decode MoE from raw router logits."""
+    w13 = layer.w13_weight
+    w2 = layer.w2_weight
+    fp8_dtypes = (torch.float8_e4m3fn, torch.float8_e5m2)
+    if (
+        x.device.type != "xpu"
+        or x.dtype != torch.float16
