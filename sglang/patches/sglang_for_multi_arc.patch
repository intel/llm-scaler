+def _xpu_rms_norm_gated_op_available() -> bool:
+    """Cached check for sgl_kernel.gdn_rms_norm_gated availability on XPU."""
+    if not _is_xpu:
+        return False
+    try:
+        import sgl_kernel  # noqa: F401
+        return hasattr(torch.ops.sgl_kernel, "gdn_rms_norm_gated")
+    except Exception:
+        return False
