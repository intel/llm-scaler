// ===========================================================================
// spec_sampling.sycl — XPU support for speculative decoding with temperature>0
//
// SYCL port of the tree-walk half of
//   sgl-kernel/csrc/speculative/speculative_sampling.cuh
//   :: TreeSpeculativeSamplingTargetOnly
//
// Why only "half": the CUDA kernel fuses two distinct phases into one block
// kernel.
//
//   Phase 1 (this file) — an inherently *sequential* walk down each request's
//     draft tree performing rejection sampling against the target
//     distribution. It is irregular pointer chasing, one work-item per
//     request, and cannot be expressed efficiently with torch ops.
//
//   Phase 2 — sampling one token from the residual distribution
//     relu(target_probs[row] - draft_probs[row]). That is a plain
//     reduction + prefix-scan over the vocabulary, which torch already
//     expresses exactly (and vectorised across the batch). CUDA only fuses
//     it here to reuse the block's shared memory.
//
// Splitting at that seam keeps the hard, irregular part in SYCL while leaving
// the numerically delicate part in torch where it is easy to verify. The
// python wrapper in sglang re-joins the two and exposes the exact
// `tree_speculative_sampling_target_only` signature the CUDA path uses.
//
// Note on `draft_probs`: despite the name, the caller passes an all-zero
// tensor and the kernel uses it as *scratch*. Whenever a candidate is
// rejected, its target mass is written into draft_probs so that phase 2's
// relu(target - draft) residual excludes tokens already rejected at that
// node. This mirrors the CUDA code (see its "FIXME: leverage draft probs").
//
// dtype contract (matches the CUDA op and sglang's eagle_info_v2 call site):
//   predicts / accept_index / accept_token_num / prob_row / last_idx : int32
//   candidates / retrive_index / retrive_next_token /
//     retrive_next_sibling                                           : int64
//   uniform_samples / target_probs / draft_probs                     : float32
// ===========================================================================
#include <torch/extension.h>
#include <c10/xpu/XPUStream.h>
#include <sycl/sycl.hpp>

namespace {

struct TreeSpecSamplingWalkFn {
  int32_t* predicts;          // [tot_num_draft_tokens]        (mutable)
  int32_t* accept_index;      // [bs, num_spec_step]           (mutable)
  int32_t* accept_token_num;  // [bs]                          (mutable)
  float* draft_probs;         // [bs, num_draft_tokens, d]     (mutable scratch)
  int32_t* prob_row;          // [bs]                          (mutable, out)
  int32_t* last_idx;          // [bs]                          (mutable, out)
  const int64_t* candidates;            // [bs, num_draft_tokens]
  const int64_t* retrive_index;         // [bs, num_draft_tokens]
  const int64_t* retrive_next_token;    // [bs, num_draft_tokens]
  const int64_t* retrive_next_sibling;  // [bs, num_draft_tokens]
  const float* uniform_samples;         // [bs, num_draft_tokens]
  const float* target_probs;            // [bs, num_draft_tokens, d]
  int num_speculative_tokens;
  int num_draft_tokens;
  int64_t d;
  float threshold_single;
  float threshold_acc;

  void operator()(sycl::nd_item<1> it) const {
    const int bx = it.get_group(0);
    const int64_t base = static_cast<int64_t>(bx) * num_draft_tokens;

    float prob_acc = 0.0f;
    // Row of `target_probs` (flattened over bs*num_draft_tokens) that the next
    // acceptance test reads from: the node whose distribution predicts the
    // token currently under consideration.
    int64_t cur_row = base;
    float coin = uniform_samples[base];
    int64_t last_accepted_retrive_idx = retrive_index[base];
    accept_index[bx * num_speculative_tokens] =
        static_cast<int32_t>(last_accepted_retrive_idx);
    int num_accepted_tokens = 0;
    int64_t cur_index = 0;

    for (int j = 1; j < num_speculative_tokens; ++j) {
      cur_index = retrive_next_token[base + cur_index];
      while (cur_index != -1) {
        const int64_t draft_index = retrive_index[base + cur_index];
        const int64_t draft_token_id = candidates[base + cur_index];
        const float target_prob_single = target_probs[cur_row * d + draft_token_id];
        prob_acc += target_prob_single;

        if (coin <= prob_acc / threshold_acc || target_prob_single >= threshold_single) {
          // Accept: descend to this node and draw a fresh coin for the next level.
          prob_acc = 0.0f;
          cur_row = base + cur_index;
          coin = uniform_samples[base + cur_index];
          predicts[last_accepted_retrive_idx] = static_cast<int32_t>(draft_token_id);
          ++num_accepted_tokens;
          accept_index[bx * num_speculative_tokens + num_accepted_tokens] =
              static_cast<int32_t>(draft_index);
          last_accepted_retrive_idx = draft_index;
          break;
        } else {
          // Reject: record the consumed mass so the residual distribution used
          // by phase 2 cannot re-draw this token, then try the next sibling.
          draft_probs[cur_row * d + draft_token_id] =
              target_probs[cur_row * d + draft_token_id];
          cur_index = retrive_next_sibling[base + cur_index];
        }
      }
      if (cur_index == -1) break;
    }

    accept_token_num[bx] = num_accepted_tokens;
    prob_row[bx] = static_cast<int32_t>(cur_row);
    last_idx[bx] = static_cast<int32_t>(last_accepted_retrive_idx);
  }
};

}  // namespace

void tree_spec_sampling_walk(
    at::Tensor predicts,
    at::Tensor accept_index,
    at::Tensor accept_token_num,
    at::Tensor draft_probs,
    at::Tensor prob_row,
    at::Tensor last_idx,
    at::Tensor candidates,
    at::Tensor retrive_index,
    at::Tensor retrive_next_token,
    at::Tensor retrive_next_sibling,
    at::Tensor uniform_samples,
    at::Tensor target_probs,
    double threshold_single,
    double threshold_acc) {
  TORCH_CHECK(predicts.scalar_type() == at::kInt, "predicts must be int32");
  TORCH_CHECK(accept_index.scalar_type() == at::kInt, "accept_index must be int32");
  TORCH_CHECK(accept_token_num.scalar_type() == at::kInt, "accept_token_num must be int32");
  TORCH_CHECK(prob_row.scalar_type() == at::kInt, "prob_row must be int32");
  TORCH_CHECK(last_idx.scalar_type() == at::kInt, "last_idx must be int32");
  TORCH_CHECK(candidates.scalar_type() == at::kLong, "candidates must be int64");
  TORCH_CHECK(retrive_index.scalar_type() == at::kLong, "retrive_index must be int64");
  TORCH_CHECK(retrive_next_token.scalar_type() == at::kLong, "retrive_next_token must be int64");
  TORCH_CHECK(retrive_next_sibling.scalar_type() == at::kLong, "retrive_next_sibling must be int64");
  TORCH_CHECK(uniform_samples.scalar_type() == at::kFloat, "uniform_samples must be float32");
  TORCH_CHECK(target_probs.scalar_type() == at::kFloat, "target_probs must be float32");
  TORCH_CHECK(draft_probs.scalar_type() == at::kFloat, "draft_probs must be float32");
  TORCH_CHECK(target_probs.dim() == 3, "target_probs must be (bs, num_draft_tokens, vocab)");
  TORCH_CHECK(draft_probs.sizes() == target_probs.sizes(), "draft_probs must match target_probs");
  TORCH_CHECK(target_probs.is_contiguous(), "target_probs must be contiguous");
  TORCH_CHECK(draft_probs.is_contiguous(), "draft_probs must be contiguous");

  const int batch_size = static_cast<int>(candidates.size(0));
  const int num_draft_tokens = static_cast<int>(candidates.size(1));
  const int num_spec_step = static_cast<int>(accept_index.size(1));
  const int64_t d = target_probs.size(2);
  TORCH_CHECK(target_probs.size(0) == batch_size && target_probs.size(1) == num_draft_tokens,
              "target_probs shape does not match candidates");

  TreeSpecSamplingWalkFn k{
      static_cast<int32_t*>(predicts.data_ptr()),
      static_cast<int32_t*>(accept_index.data_ptr()),
      static_cast<int32_t*>(accept_token_num.data_ptr()),
      static_cast<float*>(draft_probs.data_ptr()),
      static_cast<int32_t*>(prob_row.data_ptr()),
      static_cast<int32_t*>(last_idx.data_ptr()),
      static_cast<const int64_t*>(candidates.data_ptr()),
      static_cast<const int64_t*>(retrive_index.data_ptr()),
      static_cast<const int64_t*>(retrive_next_token.data_ptr()),
      static_cast<const int64_t*>(retrive_next_sibling.data_ptr()),
      static_cast<const float*>(uniform_samples.data_ptr()),
      static_cast<const float*>(target_probs.data_ptr()),
      num_spec_step,
      num_draft_tokens,
      d,
      static_cast<float>(threshold_single),
      static_cast<float>(threshold_acc)};

  // One work-item per request, mirroring the CUDA launch (grid=bs, block=1)
  // for this phase. The walk is sequential per request.
  sycl::queue& q = c10::xpu::getCurrentXPUStream(target_probs.device().index()).queue();
  q.submit([&](sycl::handler& h) {
    h.parallel_for(sycl::nd_range<1>(static_cast<size_t>(batch_size), 1), k);
  });
}

TORCH_LIBRARY_FRAGMENT(spec_sampling_ops, m) {
  m.def(
      "tree_spec_sampling_walk(Tensor! predicts, Tensor! accept_index, Tensor! accept_token_num, "
      "Tensor! draft_probs, Tensor! prob_row, Tensor! last_idx, Tensor candidates, "
      "Tensor retrive_index, Tensor retrive_next_token, Tensor retrive_next_sibling, "
      "Tensor uniform_samples, Tensor target_probs, float threshold_single, float threshold_acc) -> ()");
}

TORCH_LIBRARY_IMPL(spec_sampling_ops, XPU, m) {
  m.impl("tree_spec_sampling_walk", &tree_spec_sampling_walk);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
  m.def("tree_spec_sampling_walk", &tree_spec_sampling_walk, "tree_spec_sampling_walk");
}
