# Every distribution installed into the runtime venv, except the native
# wheels built by docker/Dockerfile (installed with --no-deps). Versions of the
# shared XPU stack come from runtime-xpu.constraints.txt and
# intel-runtime.overrides.txt. Regenerate the lock with
# docker/compile_runtime_requirements.sh; do not edit transitive pins by hand.

# Installers kept in the venv.
pip
wheel

# PyTorch XPU stack. triton and triton-xpu are separate distributions.
torch
torchvision
torchaudio
triton
triton-xpu
-r intel-runtime.overrides.txt

# vLLM XPU runtime requirements from the patched source tree, without the
# vllm_xpu_kernels URL dependency that is replaced by the local wheel.
-r vllm-requirements/xpu.txt

# Serving extras.
transformers==5.18.0
accelerate
hf_transfer
modelscope!=1.15.0
librosa
soundfile
decord
ijson

# LMCache MP / filesystem / observability profile. The LMCache wheel itself
# declares CUDA, Redis and cloud-storage backends that are not enabled here.
aiofiles
aiohttp>=3.13.3
blake3
fastapi>=0.133.0,<0.137.0
httpx
huggingface-hub>=1.5.0
httptools
msgspec
numba==0.65.0
numpy<=2.2.6
opentelemetry-api>=1.27.0,<=1.40.0
opentelemetry-sdk>=1.27.0
opentelemetry-exporter-otlp>=1.27.0
opentelemetry-exporter-prometheus>=0.50b0,<=0.61b0
