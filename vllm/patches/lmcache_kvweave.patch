+
+    @pytest.mark.parametrize("scaling_method", ["per_tensor", "per_channel", "per_token"])
+    def test_ssm_rh_round_trip_with_power_of_two_length(
+        self, scaling_method: str
+    ) -> None:
+        """With a power-of-2 transform length, rh must round-trip correctly
+        for ssm (all three scaling methods support rh for ssm).
+
+        Shape (2, 2, 4, 4) makes every method's transform length a power of
+        2: per_tensor over head_num*head_dim=16, per_channel over
+        head_num*head_dim=16, per_token over head_num*head_dim=16.
+        """
+        num_layers, num_blocks, head_num, head_dim = 2, 2, 4, 4
+        tensor = torch.randn(
+            num_layers, num_blocks, head_num, head_dim, dtype=torch.float32
+        )
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="ssm", scaling_method=scaling_method, rh=True
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        assert (restored - tensor).abs().max().item() < 1.0
+
+    def test_conv_rh_round_trip_with_per_token(self) -> None:
+        """conv supports rh only with per_token scaling; with a power-of-2
+        head_dim it must round-trip correctly."""
+        num_layers, num_blocks, head_dim = 2, 2, 16
+        tensor = torch.randn(num_layers, num_blocks, head_dim, dtype=torch.float32)
+
+        payload = quantize_mamba_substate_4bit(
