+    if tensor.dtype not in _DTYPE_TO_CODE:
+        raise ValueError(f"unsupported dtype for 4-bit quantization: {tensor.dtype}")
+    if substate not in _SUBSTATE_TO_CODE:
+        raise ValueError(f"unsupported substate: {substate!r}")
+    if scaling_method not in _SCALING_METHOD_TO_CODE:
+        raise ValueError(f"unsupported scaling_method: {scaling_method!r}")
+    if tensor.dim() < 2:
+        raise ValueError(
+            "Mamba sub-state tensors require at least 2 dimensions "
+            "(num_layers, num_blocks, ...)"
