+def test_submit_store_narrows_full_layer_shm_chunk_to_engine_group():
+    ctx = DataTransferContext()
+    full_chunk = torch.zeros(2, 24, 4, 8)
+    fake_non_gpu_context = _FakeNonGpuContext([full_chunk])
+    ctx._non_gpu_context = fake_non_gpu_context
+    ctx._engine_group_infos = [
+        EngineGroupInfo(
+            engine_group_id=0, layer_indices=tuple(range(6)), tokens_per_block=4
+        )
+    ]
+    ctx._chunk_size_tokens = 4
+
+    kv_caches = {f"layer_{i}": torch.empty(2, 1, 4, 1, 8) for i in range(24)}
+
+    with (
+        patch(
+            "lmcache.v1.multiprocess.transfer_context.worker_transfer.torch_dev.synchronize"
+        ),
+        patch(
+            "lmcache.v1.multiprocess.transfer_context.worker_transfer.gather_paged_kv_to_cpu",
+            return_value=[torch.empty(2, 6, 4, 8)],
+        ) as gather,
+    ):
+        future = ctx.submit_store(
+            "req",
+            object(),
+            0,
+            kv_caches,
+            [[0]],
+            MagicMock(),
+            1,
+        )
+
+    assert future.result() is True
+    group_out = gather.call_args.kwargs["out"]
+    assert group_out is not None
+    assert group_out[0].shape == (2, 6, 4, 8)
+    group_out[0].fill_(3)
+    assert torch.all(full_chunk[:, :6] == 3)
+    assert torch.all(full_chunk[:, 6:] == 0)
