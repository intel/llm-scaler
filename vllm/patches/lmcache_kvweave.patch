+def serialize_mamba_substate_raw(tensor: torch.Tensor) -> bytes:
+    """Serialize one Mamba sub-state without quantization."""
+    if tensor.dtype not in _DTYPE_TO_CODE:
+        raise ValueError(f"unsupported dtype for raw Mamba payload: {tensor.dtype}")
+    tensor = tensor.detach().to("cpu").contiguous()
+    shape = tuple(int(dim) for dim in tensor.shape)
+    header = _RAW_MAGIC + struct.pack(">BB", _DTYPE_TO_CODE[tensor.dtype], len(shape))
+    header += struct.pack(">" + "i" * len(shape), *shape)
+    return header + bytes(tensor.view(torch.uint8).numpy().tobytes())
