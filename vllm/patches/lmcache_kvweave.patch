+    header = _MAGIC + struct.pack(
+        ">BBBBBB",
+        _QBIT,
+        _DTYPE_TO_CODE[tensor.dtype],
+        flags,
+        _SCALING_METHOD_TO_CODE[scaling_method],
+        _SUBSTATE_TO_CODE[substate],
+        tensor.dim(),
