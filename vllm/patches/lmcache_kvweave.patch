+    def test_conv_per_token_treats_state_len_as_token_like(self) -> None:
+        """conv's real shape has an extra ``state_len`` dim beyond
+        ``num_blocks`` (matching vLLM's ``(state_len, conv_dim)`` per-block
+        shape). Under per_token, each ``(block, state_len-position)`` pair
+        must get its own independent scale -- not one scale shared across
+        the whole block's state_len positions -- so wildly different
+        magnitudes across state_len positions within the same block must
+        still dequantize accurately."""
+        num_layers, num_blocks, state_len, conv_dim = 2, 2, 4, 8
+        tensor = torch.zeros(num_layers, num_blocks, state_len, conv_dim)
+        # Each state_len position spans a different magnitude within the
+        # same block: position s ~ N(0, 10^s).
+        for s in range(state_len):
+            tensor[:, :, s, :] = torch.randn(num_layers, num_blocks, conv_dim) * (
+                10.0**s
+            )
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        assert restored.shape == tensor.shape
+        for s in range(state_len):
+            position_scale = max(tensor[:, :, s, :].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, :, s, :] - tensor[:, :, s, :]).abs().max().item()
+                / position_scale
+            )
+            assert rel_err < 0.2, f"state_len position {s} relative error {rel_err} too large"
+
+    def test_conv_per_token_rh_round_trip_with_state_len(self) -> None:
+        """per_token+rh for conv must fold state_len into blocks_num (each
+        (block, state_len-position) is its own token), so the transform
+        length is conv_dim alone -- must round-trip when conv_dim is a
+        power of 2, even though num_blocks * state_len * conv_dim is not."""
+        num_layers, num_blocks, state_len, conv_dim = 2, 3, 3, 16
+        numel = num_layers * num_blocks * state_len * conv_dim
+        assert (numel & (numel - 1)) != 0, (
+            "fixture must make the whole per-layer size non-power-of-2, so "
+            "this only passes if state_len folds into blocks_num, not head_dim"
+        )
+        tensor = torch.randn(
+            num_layers, num_blocks, state_len, conv_dim, dtype=torch.float32
