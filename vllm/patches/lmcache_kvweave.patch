+# SPDX-License-Identifier: Apache-2.0
+
+"""Tests for Mamba conv/ssm chunk splitting and 4-bit quantization."""
+
+# Standard
+import threading
+
+# Third Party
+import pytest
+import torch
+
+# First Party
+from lmcache.v1.multiprocess.group_view import MambaSubStateWireLayout
+from lmcache.v1.multiprocess.transfer_context.mamba_quant import (
+    MambaChunkSplit,
+    _allocate_scale_id,
+    merge_mamba_chunk,
+    pack_mamba_payloads,
+    split_mamba_chunk,
+    unpack_mamba_payloads,
+)
+
+try:
+    # Third Party
+    from kvweave import kvweave_quant  # noqa: F401
+
+    _has_kvweave_quant = True
+except ImportError:
+    _has_kvweave_quant = False
+
+native_only = pytest.mark.skipif(
+    not _has_kvweave_quant, reason="requires the kvweave_quant native extension"
+)
+
+if _has_kvweave_quant:
+    # First Party
+    from lmcache.v1.multiprocess.transfer_context.mamba_quant import (
+        dequantize_mamba_substate_4bit,
+        quantize_mamba_substate_4bit,
+    )
+
+_NUM_KV = 2
+_NUM_LAYERS = 3
+_CHUNK_TOKENS = 8
+_HIDDEN_DIM = 4
+_BLOCK_SIZE = 2
+# conv's real per-block shape is 2D, matching vLLM's own
+# (state_len, conv_dim) -- no separate head axis, but not flat either.
+_CONV_STATE_LEN = 2
+_CONV_DIM = 3
+_CONV_HEAD_DIM = _CONV_DIM  # true last dim, per _mamba_quant_layout's contract
+_SSM_HEAD_NUM = 2
+_SSM_HEAD_DIM = 5
+_CONV_ELEMS = _CONV_STATE_LEN * _CONV_DIM
+_SSM_ELEMS = _SSM_HEAD_NUM * _SSM_HEAD_DIM
+
+
+def _make_layout() -> tuple[MambaSubStateWireLayout, MambaSubStateWireLayout]:
+    """Build a ``(conv, ssm)`` layout pair covering one full synthetic page.
+
+    Returns:
+        A layout pair whose combined byte length exactly equals
+        ``2 * _BLOCK_SIZE * _HIDDEN_DIM`` float32 elements (no padding), so
+        every byte in a reassembled page belongs to either sub-state. conv's
+        real per-block shape is 2D (``shape=(_CONV_STATE_LEN, _CONV_DIM)``,
+        matching vLLM's ``(state_len, conv_dim)``); ssm's is 3D in
+        production (``(num_heads, head_v_dim, head_k_dim)``) but this
+        fixture uses a 2D ``(_SSM_HEAD_NUM, _SSM_HEAD_DIM)`` tail, which
+        already exercises the "fold everything but the last dim into
+        head_num" path.
+    """
+    return (
+        MambaSubStateWireLayout(
+            byte_offset=0,
+            byte_length=_CONV_ELEMS * 4,
+            dtype_str="torch.float32",
+            shape=(_CONV_STATE_LEN, _CONV_DIM),
+        ),
+        MambaSubStateWireLayout(
+            byte_offset=_CONV_ELEMS * 4,
+            byte_length=_SSM_ELEMS * 4,
+            dtype_str="torch.float32",
+            shape=(_SSM_HEAD_NUM, _SSM_HEAD_DIM),
+        ),
+    )
+
+
+class TestSplitMambaChunk:
+    """Tests for :func:`split_mamba_chunk`."""
+
+    def test_splits_into_expected_shapes_and_dtypes(self) -> None:
+        """conv/ssm must come back with their own real per-head shape and
+        dtype, independent of the page's addressing dtype."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+        num_blocks = _CHUNK_TOKENS // _BLOCK_SIZE
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+        assert split.conv.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _CONV_STATE_LEN,
+            _CONV_DIM,
+        )
+        assert split.ssm.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _SSM_HEAD_NUM,
+            _SSM_HEAD_DIM,
+        )
+        assert split.conv.dtype == torch.float32
+        assert split.ssm.dtype == torch.float32
+
+    def test_splits_noncontiguous_input(self) -> None:
+        """A non-contiguous ``raw_chunk`` (as ``gather_paged_kv_to_cpu`` may
+        produce via slicing) must still split without error or shape drift."""
+        conv_layout, ssm_layout = _make_layout()
+        base = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS * 2, _HIDDEN_DIM)
+        raw_chunk = base[:, :, ::2, :]
+        assert not raw_chunk.is_contiguous()
+        num_blocks = _CHUNK_TOKENS // _BLOCK_SIZE
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+        assert split.conv.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _CONV_STATE_LEN,
+            _CONV_DIM,
+        )
+        assert split.ssm.shape == (
+            _NUM_LAYERS,
+            num_blocks,
+            _SSM_HEAD_NUM,
+            _SSM_HEAD_DIM,
+        )
+
+    def test_rejects_chunk_tokens_not_multiple_of_block_size(self) -> None:
+        """A ``chunk_tokens`` not divisible by ``block_size`` must raise."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS + 1, _HIDDEN_DIM)
+        with pytest.raises(ValueError, match="chunk_tokens"):
+            split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+
+
+class TestMergeMambaChunk:
+    """Tests for :func:`merge_mamba_chunk`, the inverse of
+    :func:`split_mamba_chunk`."""
+
+    def test_round_trip_preserves_conv_and_ssm_bytes(self) -> None:
+        """``split(merge(split(raw)))`` must reproduce the same conv/ssm
+        tensors as the initial ``split(raw)``, since conv/ssm fully cover the
+        synthetic page and no bytes are lost to padding."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+        merged = merge_mamba_chunk(
+            split, (conv_layout, ssm_layout), _BLOCK_SIZE, _HIDDEN_DIM
+        )
+        assert merged.shape == raw_chunk.shape
+
+        split_again = split_mamba_chunk(
+            merged, (conv_layout, ssm_layout), _BLOCK_SIZE
+        )
+        assert torch.equal(split.conv, split_again.conv)
+        assert torch.equal(split.ssm, split_again.ssm)
+
+
+class TestAllocateScaleId:
+    """Tests for the lock-free :func:`_allocate_scale_id`."""
+
+    def test_returns_unique_ids_sequentially(self) -> None:
+        """Sequential calls must never repeat within a small run."""
+        ids = [_allocate_scale_id() for _ in range(100)]
+        assert len(set(ids)) == len(ids)
+
+    def test_returns_unique_ids_across_threads(self) -> None:
+        """Concurrent callers from multiple threads must never collide,
+        verifying the counter needs no explicit lock under the GIL."""
+        allocated: list[int] = []
+        lock = threading.Lock()
+
+        def _worker() -> None:
+            local_ids = [_allocate_scale_id() for _ in range(200)]
+            with lock:
+                allocated.extend(local_ids)
+
+        threads = [threading.Thread(target=_worker) for _ in range(8)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join()
+
+        assert len(set(allocated)) == len(allocated)
+
+
+class TestPackMambaPayloads:
+    """Tests for :func:`pack_mamba_payloads`/:func:`unpack_mamba_payloads`."""
+
+    def test_round_trip(self) -> None:
+        """Packing then unpacking must return the original payload bytes."""
+        conv_payload = b"conv-bytes-123"
+        ssm_payload = b"ssm-bytes-4567"
+        blob = pack_mamba_payloads(conv_payload, ssm_payload)
+        unpacked_conv, unpacked_ssm = unpack_mamba_payloads(blob)
+        assert unpacked_conv == conv_payload
+        assert unpacked_ssm == ssm_payload
+
+    def test_round_trip_with_empty_payloads(self) -> None:
+        """Empty payloads must round-trip without corrupting framing."""
+        blob = pack_mamba_payloads(b"", b"")
+        unpacked_conv, unpacked_ssm = unpack_mamba_payloads(blob)
+        assert unpacked_conv == b""
+        assert unpacked_ssm == b""
+
