+@native_only
+class TestQuantizeMambaSubstate4Bit:
+    """Tests for :func:`quantize_mamba_substate_4bit`/
+    :func:`dequantize_mamba_substate_4bit`."""
+
+    @pytest.mark.parametrize("dtype", [torch.float16, torch.float32, torch.bfloat16])
+    def test_round_trip_preserves_shape_and_dtype(self, dtype: torch.dtype) -> None:
+        """Dequantizing a quantized tensor must recover its shape and dtype."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=dtype)
+        payload = quantize_mamba_substate_4bit(tensor, substate="conv")
+        restored = dequantize_mamba_substate_4bit(payload)
+        assert restored.shape == tensor.shape
+        assert restored.dtype == tensor.dtype
+
+    def test_round_trip_is_approximately_lossless(self) -> None:
+        """4-bit quantization is lossy; error must stay within a loose bound
+        rather than exploding (e.g. from a scale/shape mismatch bug)."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        payload = quantize_mamba_substate_4bit(tensor, substate="conv")
+        restored = dequantize_mamba_substate_4bit(payload)
+        assert (restored - tensor).abs().max().item() < 1.0
+
+    def test_rejects_unsupported_dtype(self) -> None:
+        """A tensor dtype outside the supported set must raise."""
+        tensor = torch.randn(4, 4, dtype=torch.float64)
+        with pytest.raises(ValueError, match="unsupported dtype"):
+            quantize_mamba_substate_4bit(tensor, substate="conv")
+
+    def test_rejects_unsupported_substate(self) -> None:
+        """An unrecognized substate must raise."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="substate"):
+            quantize_mamba_substate_4bit(tensor, substate="qkv")
+
+    def test_rejects_unsupported_scaling_method(self) -> None:
+        """An unrecognized scaling method must raise."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="scaling_method"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_head"
+            )
+
+    def test_rejects_1d_tensor(self) -> None:
+        """Mamba sub-state tensors need a (layer, block, ...) shape; a 1D
+        tensor has no separate layer/block axes."""
+        tensor = torch.randn(_CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="at least 2 dimensions"):
+            quantize_mamba_substate_4bit(tensor, substate="conv")
+
+    def test_conv_rejects_rh_with_per_tensor(self) -> None:
+        """rh is not supported for conv combined with per_tensor -- a
+        caller-imposed restriction since conv has no real head axis."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="rh is not supported"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_tensor", rh=True
+            )
+
+    def test_conv_rejects_rh_with_per_channel(self) -> None:
+        """rh is not supported for conv combined with per_channel."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        with pytest.raises(ValueError, match="rh is not supported"):
+            quantize_mamba_substate_4bit(
+                tensor, substate="conv", scaling_method="per_channel", rh=True
+            )
+
+    def test_rejects_unrecognized_payload_magic(self) -> None:
+        """A payload with a corrupted magic prefix must raise."""
+        with pytest.raises(ValueError, match="magic"):
+            dequantize_mamba_substate_4bit(b"XXXXgarbage")
+
+    @pytest.mark.parametrize("scaling_method", ["per_tensor", "per_channel", "per_token"])
+    @pytest.mark.parametrize("asym", [False, True])
+    def test_full_conv_ssm_pipeline_round_trip(
+        self, scaling_method: str, asym: bool
+    ) -> None:
+        """The full store/retrieve path -- split, quantize, pack, unpack,
+        dequantize, merge -- must reproduce the original conv/ssm bytes,
+        across all scaling methods and symmetric/asymmetric quantization."""
+        conv_layout, ssm_layout = _make_layout()
+        raw_chunk = torch.randn(_NUM_KV, _NUM_LAYERS, _CHUNK_TOKENS, _HIDDEN_DIM)
+
+        split = split_mamba_chunk(raw_chunk, (conv_layout, ssm_layout), _BLOCK_SIZE)
+        blob = pack_mamba_payloads(
+            quantize_mamba_substate_4bit(
+                split.conv,
+                substate="conv",
+                scaling_method=scaling_method,
+                asym=asym,
+            ),
+            quantize_mamba_substate_4bit(
+                split.ssm,
+                substate="ssm",
+                scaling_method=scaling_method,
+                asym=asym,
+            ),
+        )
+        conv_payload, ssm_payload = unpack_mamba_payloads(blob)
+        restored = MambaChunkSplit(
+            conv=dequantize_mamba_substate_4bit(conv_payload),
+            ssm=dequantize_mamba_substate_4bit(ssm_payload),
+        )
+
+        assert restored.conv.shape == split.conv.shape
+        assert restored.ssm.shape == split.ssm.shape
+        assert (restored.conv - split.conv).abs().max().item() < 1.0
+        assert (restored.ssm - split.ssm).abs().max().item() < 1.0
+
+    def test_per_channel_uses_last_dim_as_head_dim(self) -> None:
+        """per_channel must scale independently per position along the last
+        dimension: a tensor whose channels have wildly different magnitudes
+        must still dequantize accurately for every channel, which a single
+        per_tensor scale would blur."""
+        num_blocks, num_channels = 4, 8
+        tensor = torch.zeros(_NUM_LAYERS, num_blocks, num_channels)
+        # Each channel spans a different magnitude: channel c ~ N(0, 10^c).
+        for c in range(num_channels):
+            tensor[:, :, c] = torch.randn(_NUM_LAYERS, num_blocks) * (10.0**c)
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_channel"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        for c in range(num_channels):
+            channel_scale = max(tensor[:, :, c].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, :, c] - tensor[:, :, c]).abs().max().item()
+                / channel_scale
+            )
+            assert rel_err < 0.2, f"channel {c} relative error {rel_err} too large"
+
+    def test_per_token_scales_independently_per_layer_block(self) -> None:
+        """per_token must scale independently per (layer, block) position: a
+        tensor whose token positions have wildly different magnitudes must
+        still dequantize accurately for every position, which a single
+        per_tensor scale would blur."""
+        num_blocks, num_channels = 4, 8
+        tensor = torch.zeros(_NUM_LAYERS, num_blocks, num_channels)
+        # Each block spans a different magnitude: block b ~ N(0, 10^b).
+        for b in range(num_blocks):
+            tensor[:, b, :] = torch.randn(_NUM_LAYERS, num_channels) * (10.0**b)
+
+        payload = quantize_mamba_substate_4bit(
+            tensor, substate="conv", scaling_method="per_token"
+        )
+        restored = dequantize_mamba_substate_4bit(payload)
+
+        for b in range(num_blocks):
+            block_scale = max(tensor[:, b, :].abs().max().item(), 1e-6)
+            rel_err = (
+                (restored[:, b, :] - tensor[:, b, :]).abs().max().item()
+                / block_scale
+            )
+            assert rel_err < 0.2, f"block {b} relative error {rel_err} too large"
+
+    def test_rh_requires_power_of_two_transform_length(self) -> None:
+        """rh with a per_token transform length that is not a power of 2
+        must raise instead of silently corrupting data or crashing in C++."""
+        tensor = torch.randn(_NUM_LAYERS, 4, _CONV_HEAD_DIM, dtype=torch.float32)
+        assert (_CONV_HEAD_DIM & (_CONV_HEAD_DIM - 1)) != 0, (
