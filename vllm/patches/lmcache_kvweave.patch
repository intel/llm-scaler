@@ -0,0 +1,653 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Per-tensor/per-channel 4-bit quantization for Mamba ``conv_state``/``ssm_state``.
+
+``lmcache.integration.vllm.kv_cache_group_edits._MambaPageViewEdit`` reinterprets
+a Mamba page (``conv_state | ssm_state | pad``) as one opaque tensor in
+``conv_state``'s dtype so it can flow through the attention-shaped paged KV
+transfer path. ``gather_paged_kv_to_cpu`` then physically splits that opaque
+page in half along a synthetic "kv" axis (see
+``lmcache/v1/multiprocess/transfer_context/base.py``), which can cut
+``ssm_state``'s real bytes across the two halves when ``conv_state`` and
+``ssm_state`` don't happen to fill exactly one half each.
+
+This module undoes both steps for quantized store/retrieve: it reassembles
+``conv_state``/``ssm_state``'s real per-block bytes (each read with its own
+real dtype, not the page's addressing dtype -- see
+``_MambaPageViewEdit.real_layout``) from the post-gather opaque chunk, and
+provides a minimal 4-bit quantizer that does not depend on
+``kvweave_serde``'s attention-shaped (``[2, L, T, H]``, ``kv_size == 2``)
+tensor contract, since neither sub-state has a real K/V split. It supports
+``"per_tensor"`` (one scale for the whole sub-state), ``"per_channel"``
+(one scale per position along the sub-state's last dimension), and
+``"per_token"`` (one scale per Mamba page, i.e. per token position) scaling,
+plus an optional randomized Hadamard (``rh``) transform.
+"""
+
+# Future
+from __future__ import annotations
+
+# Standard
+from dataclasses import dataclass
+from itertools import count
+import json
+import os
+import struct
+import threading
+
+# Third Party
+from kvweave import kvweave_quant
+import torch
+
+# First Party
+from lmcache.utils import init_logger
+from lmcache.v1.distributed.serde.kvweave_config import KVWeaveCodecConfig
+from lmcache.v1.multiprocess.group_view import MambaSubStateWireLayout
+
+logger = init_logger(__name__)
+
+# Debugging aid for the SSM int4 root-cause investigation (see
+# MIGRATION_PLAN.md, "下一步计划：真正解决 SSM int4 量化问题", in the sibling
+# lmcache-main checkout). When set, the real store-time conv/ssm sub-states
+# are dumped to disk *before* quantization so they can be compared against
+# the same dump taken from the vllm-v0.26.0 / lmcache-main stack. Not read
+# anywhere else; purely a side-channel observability hook, never gates
+# behavior.
+_SSM_DUMP_DIR = os.environ.get("LMCACHE_MP_KVWEAVE_SSM_DUMP_DIR")
+_ssm_dump_seq = count()
+
+
+def _dump_mamba_substate(substate: str, tensor: torch.Tensor) -> None:
+    """Best-effort dump of a pre-quantization Mamba sub-state tensor to disk.
+
+    No-op unless ``LMCACHE_MP_KVWEAVE_SSM_DUMP_DIR`` is set. Never raises --
+    a dump failure must not affect the store path.
+    """
+    if not _SSM_DUMP_DIR:
+        return
+    try:
+        os.makedirs(_SSM_DUMP_DIR, exist_ok=True)
+        seq = next(_ssm_dump_seq)
+        stem = f"{substate}_chunk{seq}"
+        torch.save(tensor.detach().cpu(), os.path.join(_SSM_DUMP_DIR, f"{stem}.pt"))
+        with open(os.path.join(_SSM_DUMP_DIR, f"{stem}.json"), "w") as f:
+            json.dump(
+                {
+                    "substate": substate,
+                    "shape": list(tensor.shape),
+                    "dtype": str(tensor.dtype),
+                },
+                f,
+            )
+    except Exception:
+        logger.warning("Failed to dump Mamba %s sub-state", substate, exc_info=True)
+
+# Payload header: magic, qbit, dtype code, flags (bit0=rh, bit1=asym),
+# scaling method code, ndim, then ndim int32 shape dims, then the
+# scale/zeropoint bytes produced by ``kvweave_quant.get_scales_for_id``
+# (length-prefixed), then the packed qbit-wide values.
+_MAGIC = b"MQ01"
+_RAW_MAGIC = b"MR01"
+_DTYPE_TO_CODE = {torch.float16: 0, torch.float32: 1, torch.bfloat16: 2}
+_CODE_TO_DTYPE = {v: k for k, v in _DTYPE_TO_CODE.items()}
+_QBIT = 4
+
+_SCALING_METHOD_TO_CODE = {"per_tensor": 0, "per_channel": 1, "per_token": 2}
+_CODE_TO_SCALING_METHOD = {v: k for k, v in _SCALING_METHOD_TO_CODE.items()}
+_FLAG_RH = 1 << 0
+_FLAG_ASYM = 1 << 1
+
+# Preconditioner (P&D matrix) source for the ``rh`` transform. Only
+# ``get_pd_matrix`` is used, deterministically keyed by hadamard size -- this
+# does not read ``KVWEAVE_CONFIG_FILE`` and shares no state with the
+# attention-shaped ``_KVWeaveCodec`` codec.
+_PRECOND_CONFIG = KVWeaveCodecConfig()
+_PRECOND_LOCK = threading.Lock()
+
+
+def _precond_pair(hadamard_size: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return the ``(signs, perm)`` pair for the ``rh`` transform.
+
+    Args:
+        hadamard_size: The Hadamard transform length. Must be a power of 2.
+
+    Returns:
+        ``signs`` (float32, +/-1) and ``perm`` (int32 permutation), each of
+        length ``hadamard_size``.
+
+    Raises:
+        ValueError: If ``hadamard_size`` is not a power of 2.
+    """
+    if hadamard_size <= 0 or (hadamard_size & (hadamard_size - 1)) != 0:
+        raise ValueError(
+            f"rh requires a power-of-2 transform length, got {hadamard_size}"
+        )
+    with _PRECOND_LOCK:
+        signs, perm = _PRECOND_CONFIG.get_pd_matrix(hadamard_size)
+    return (
+        torch.as_tensor(signs, dtype=torch.float32).contiguous(),
+        torch.as_tensor(perm, dtype=torch.int32).contiguous(),
+    )
+
+
+_UNSUPPORTED_CONV_RH_METHODS = frozenset({"per_tensor", "per_channel"})
+
+
+def _mamba_quant_layout(
+    substate: str,
+    shape: tuple[int, ...],
+    numel: int,
+    scaling_method: str,
+) -> tuple[int, int, int, int]:
+    """Return the ``(blocks_num, head_num, head_dim, num_chunks)`` layout the
+    native fused kernel needs for one Mamba sub-state and ``scaling_method``.
+
+    ``conv_state``/``ssm_state`` can have a real per-block shape of any rank
+    (e.g. conv's is ``(state_len, conv_dim)``, ssm's is ``(num_heads,
+    head_v_dim, head_k_dim)``, per vLLM's ``MambaStateShapeCalculator``).
+    ``head_dim`` is always the tensor's true last dimension (the axis the
+    native kernel's ``"per_channel"`` contract scales independently over).
+    Every other tail dim (beyond ``num_blocks``) is either "token-like"
+    (folded into ``blocks_num``/``num_chunks`` under ``"per_token"``, so each
+    position gets its own scale) or "head-like" (folded into ``head_num``,
+    sharing one scale) -- this distinction is substate-specific and only
+    matters for ``"per_token"``:
+
+    * ``"per_channel"``: ``num_chunks == head_dim`` (the real last-dim size),
+      one scale per position along it, shared across every other dim --
+      matches the native kernel's ``stride = head_dim`` contract exactly
+      (see ``quantize_block`` in ``kvweave/csrc/quant.h``). Substate-independent.
+    * ``"per_token"``: one scale per token-like position.
+      ``conv_state``'s extra tail dim (``state_len``) is token-like -- each
+      ``(block, state_len-position)`` pair is its own token, so it folds
+      into ``blocks_num``/``num_chunks`` (``head_num == 1``).
+      ``ssm_state``'s extra tail dims (``num_heads``, ``head_v_dim``) are
+      head-like -- shared under one scale per ``(block, head)`` position, so
+      they fold into ``head_num`` instead (``num_chunks == blocks_num``,
+      unaffected by ``head_v_dim``).
+    * ``"per_tensor"``: ``num_chunks == 1``. Substate-independent.
+
+    ``shape`` is ``(num_layers, num_blocks, *sub_state_shape)`` (as returned
+    by :func:`split_mamba_chunk`). The native fused kernel quantizes each
+    layer independently when ``num_layers > 1`` (see
+    ``use_per_layer_quantization``), so ``blocks_num`` here is *per layer*
+    (``shape[1]``, matching ``kvweave_serde``'s own convention of
+    ``blocks_num = chunk_tokens // block_size``, a per-layer count) --
+    passing the cross-layer total would make the native kernel index past
+    one layer's buffer. ``blocks_num * block_size * head_num * head_dim``
+    (with ``block_size == 1`` here) must equal ``numel // num_layers``, the
+    per-layer element count.
+
+    Args:
+        substate: ``"conv"`` or ``"ssm"``.
+        shape: The sub-state tensor's real shape,
+            ``(num_layers, num_blocks, *sub_state_shape)``.
+        numel: The tensor's total element count.
+        scaling_method: ``"per_tensor"``, ``"per_channel"``, or
+            ``"per_token"``.
+
+    Returns:
+        ``(blocks_num, head_num, head_dim, num_chunks)``, where
+        ``num_chunks`` is the per-layer chunk count.
+    """
+    num_layers = max(shape[0], 1)
+    num_blocks = max(shape[1], 1) if len(shape) > 1 else 1
+    numel_per_layer = max(numel // num_layers, 1)
+    tail_numel = max(numel_per_layer // num_blocks, 1)
+    tail_shape = shape[2:]
+    real_head_dim = max(tail_shape[-1], 1) if tail_shape else tail_numel
+    # Everything in the tail besides the true last dim (head_dim), folded
+    # into one number -- interpreted as token-like or head-like below,
+    # depending on scaling_method and substate.
+    middle_numel = max(tail_numel // real_head_dim, 1)
+
+    if scaling_method == "per_channel":
+        blocks_num = max(numel_per_layer // (middle_numel * real_head_dim), 1)
+        return blocks_num, middle_numel, real_head_dim, real_head_dim
+    if scaling_method == "per_token":
+        if substate == "conv":
+            # state_len is token-like: each (block, state_len-position) is
+            # its own independently-scaled position.
+            token_blocks_num = num_blocks * middle_numel
+            return token_blocks_num, 1, real_head_dim, token_blocks_num
+        # ssm: fold num_heads/head_v_dim into blocks_num so each contiguous
+        # row along the true last dimension gets its own scale.
+        row_blocks = num_blocks * middle_numel
+        return row_blocks, 1, real_head_dim, row_blocks
+    # per_tensor: num_chunks == 1, blocks_num/head_num/head_dim are unused by
+    # the native kernel but must still multiply out to numel_per_layer.
+    blocks_num = max(numel_per_layer // (middle_numel * real_head_dim), 1)
+    return blocks_num, middle_numel, real_head_dim, 1
+
+
+# ``count().__next__()`` is implemented in C and, under the GIL, advances
+# atomically -- no explicit lock needed to hand out distinct values to
+# concurrent callers. As with the prior lock-protected counter, values still
+# wrap modulo 2**32 to fit ``kvweave_quant``'s uint32 scale_id, so ids can
+# repeat after ~4 billion allocations.
+_SCALE_ID_COUNTER = count(1)
+
+
+def _allocate_scale_id() -> int:
+    """Return a fresh ``scale_id`` for ``kvweave_quant``'s thread-local scale maps.
+
+    Returns:
+        A ``uint32``-wrapping monotonic counter value, unique per call
+        (barring wraparound after ~4 billion allocations).
+    """
+    return next(_SCALE_ID_COUNTER) & 0xFFFFFFFF
+
+
+@dataclass(frozen=True)
+class MambaChunkSplit:
+    """One chunk's real ``conv_state``/``ssm_state`` tensors, split from the
+    opaque page-view chunk gathered by ``gather_paged_kv_to_cpu``.
+
+    Args:
+        conv: Real ``conv_state`` data, shaped
+            ``(num_layers, num_blocks, *conv_shape)`` in its own real dtype.
+        ssm: Real ``ssm_state`` data, shaped
+            ``(num_layers, num_blocks, *ssm_shape)`` in its own real dtype.
+    """
+
+    conv: torch.Tensor
+    ssm: torch.Tensor
+
+
+def split_mamba_chunk(
+    raw_chunk: torch.Tensor,
+    mamba_real_layout: tuple[MambaSubStateWireLayout, MambaSubStateWireLayout],
+    block_size: int,
+) -> MambaChunkSplit:
+    """Reassemble real ``conv_state``/``ssm_state`` tensors from a gathered chunk.
+
+    ``raw_chunk`` is the opaque tensor ``gather_paged_kv_to_cpu`` produces for
+    a Mamba group: shape ``(2, num_layers, chunk_tokens, hidden_dim)`` in
+    ``conv_state``'s dtype, where the leading ``2`` axis is a physical split
+    of each page's flat bytes into two equal halves (not a real K/V split;
+    see ``_MambaPageViewEdit.apply``). One Mamba page/block occupies
+    ``block_size`` consecutive token slots in ``chunk_tokens``, and its real
+    ``conv_state``/``ssm_state`` bytes may straddle the ``kv=0``/``kv=1``
+    boundary, so each block's flat per-page bytes are reconstructed before
+    slicing out the two real sub-states.
+
+    Args:
+        raw_chunk: The gathered opaque tensor, shape
+            ``(2, num_layers, chunk_tokens, hidden_dim)``.
+        mamba_real_layout: The group's ``(conv, ssm)`` real byte layout, as
+            carried by ``EngineGroupInfo.mamba_real_layout``.
+        block_size: Tokens per Mamba page (``EngineGroupInfo.tokens_per_block``).
+
+    Returns:
+        The chunk's real ``conv_state``/``ssm_state`` tensors, each shaped
+        ``(num_layers, num_blocks, *sub_state_shape)`` in its own real dtype.
+
+    Raises:
+        ValueError: If ``chunk_tokens`` is not a multiple of ``block_size``.
+    """
+    conv_layout, ssm_layout = mamba_real_layout
+    conv_dtype = getattr(torch, conv_layout.dtype_str.removeprefix("torch."))
+    ssm_dtype = getattr(torch, ssm_layout.dtype_str.removeprefix("torch."))
+    conv_elem_size = torch.empty((), dtype=conv_dtype).element_size()
+
+    num_kv, num_layers, chunk_tokens, hidden_dim = raw_chunk.shape
+    if chunk_tokens % block_size != 0:
+        raise ValueError(
+            f"chunk_tokens ({chunk_tokens}) is not a multiple of "
+            f"block_size ({block_size})"
+        )
+    num_blocks = chunk_tokens // block_size
+    elems_per_page = num_kv * block_size * hidden_dim
+
+    # View each page as its original flat (conv | ssm | pad) byte layout: one
+    # page spans block_size token slots across both kv halves, flattened in
+    # the same (kv, t, h) order _MambaPageViewEdit.apply used to build the
+    # opaque view (o = ((kv * block_size + t) * hidden_dim + h)).
+    pages = (
+        raw_chunk.permute(1, 0, 2, 3)  # (num_layers, 2, chunk_tokens, hidden_dim)
+        .reshape(num_layers, num_kv, num_blocks, block_size, hidden_dim)
+        .permute(0, 2, 1, 3, 4)  # (num_layers, num_blocks, 2, block_size, hidden_dim)
+        .reshape(num_layers, num_blocks, elems_per_page)
+    )
+    page_bytes = pages.contiguous().view(torch.uint8).reshape(
+        num_layers, num_blocks, elems_per_page * conv_elem_size
+    )
+
+    conv_bytes = page_bytes[:, :, conv_layout.byte_offset : conv_layout.byte_offset + conv_layout.byte_length]
+    ssm_bytes = page_bytes[:, :, ssm_layout.byte_offset : ssm_layout.byte_offset + ssm_layout.byte_length]
+
+    conv_real = (
+        conv_bytes.contiguous()
+        .view(conv_dtype)
+        .reshape(num_layers, num_blocks, *conv_layout.shape)
+    )
+    ssm_real = (
+        ssm_bytes.contiguous()
+        .view(ssm_dtype)
+        .reshape(num_layers, num_blocks, *ssm_layout.shape)
+    )
+    logger.debug(
+        "split_mamba_chunk before quant: conv_real.shape=%s conv_real.dtype=%s "
+        "ssm_real.shape=%s ssm_real.dtype=%s",
+        conv_real.shape,
+        conv_real.dtype,
+        ssm_real.shape,
+        ssm_real.dtype,
+    )
+    return MambaChunkSplit(conv=conv_real, ssm=ssm_real)
+
+
+def merge_mamba_chunk(
+    split: MambaChunkSplit,
+    mamba_real_layout: tuple[MambaSubStateWireLayout, MambaSubStateWireLayout],
+    block_size: int,
+    hidden_dim: int,
+) -> torch.Tensor:
+    """Rebuild the opaque page-view chunk tensor from real conv/ssm tensors.
+
+    Inverse of :func:`split_mamba_chunk`: reassembles each page's flat
+    ``(conv | ssm | pad)`` bytes (zero-filling the pad region) and re-splits
+    them into the ``(2, num_layers, chunk_tokens, hidden_dim)`` opaque layout
+    ``scatter_cpu_to_paged_kv`` expects.
+
+    Args:
+        split: The chunk's real ``conv_state``/``ssm_state`` tensors, as
+            returned by :func:`split_mamba_chunk`.
+        mamba_real_layout: The group's ``(conv, ssm)`` real byte layout.
+        block_size: Tokens per Mamba page.
+        hidden_dim: The opaque view's synthetic head size
+            (``page_size_bytes / (2 * block_size * conv_state.element_size())``).
+
+    Returns:
+        The opaque chunk tensor, shape ``(2, num_layers, chunk_tokens, hidden_dim)``,
+        in ``conv_state``'s dtype.
+    """
+    conv_layout, ssm_layout = mamba_real_layout
+    conv_dtype = getattr(torch, conv_layout.dtype_str.removeprefix("torch."))
+    conv_elem_size = torch.empty((), dtype=conv_dtype).element_size()
+
+    num_layers, num_blocks = split.conv.shape[0], split.conv.shape[1]
+    elems_per_page = 2 * block_size * hidden_dim
+    page_size_bytes = elems_per_page * conv_elem_size
+
+    page_bytes = torch.zeros(
+        (num_layers, num_blocks, page_size_bytes), dtype=torch.uint8
+    )
+    conv_bytes = split.conv.contiguous().view(torch.uint8).reshape(
+        num_layers, num_blocks, conv_layout.byte_length
+    )
+    ssm_bytes = split.ssm.contiguous().view(torch.uint8).reshape(
+        num_layers, num_blocks, ssm_layout.byte_length
+    )
+    page_bytes[:, :, conv_layout.byte_offset : conv_layout.byte_offset + conv_layout.byte_length] = conv_bytes
+    page_bytes[:, :, ssm_layout.byte_offset : ssm_layout.byte_offset + ssm_layout.byte_length] = ssm_bytes
+
+    pages = page_bytes.view(conv_dtype).reshape(
+        num_layers, num_blocks, 2, block_size, hidden_dim
+    )
+    return (
+        pages.permute(2, 0, 1, 3, 4)  # (2, num_layers, num_blocks, block_size, hidden_dim)
+        .reshape(2, num_layers, num_blocks * block_size, hidden_dim)
+        .contiguous()
+    )
+
+
+_SUBSTATE_TO_CODE = {"conv": 0, "ssm": 1}
+_CODE_TO_SUBSTATE = {v: k for k, v in _SUBSTATE_TO_CODE.items()}
+
+
+def quantize_mamba_substate_4bit(
+    tensor: torch.Tensor,
+    *,
+    substate: str,
+    scaling_method: str = "per_tensor",
+    rh: bool = False,
+    asym: bool = False,
+) -> bytes:
+    """Quantize a real-valued Mamba sub-state tensor to a self-describing payload.
+
+    Calls ``kvweave_quant.kvweave_serialize_chunk_state``, the single-tensor
+    (no K/V split) analog of ``kvweave_serde``'s fused
+    ``kvweave_serialize_chunk``, appropriate here since neither
+    ``conv_state`` nor ``ssm_state`` has a real K/V split.
+
+    ``scaling_method`` partitions ``tensor`` using its real per-block shape
+    (see :func:`_mamba_quant_layout`): ``"per_channel"`` scales independently
+    per position along ``tensor``'s true last dimension (``conv_dim`` for
+    ``conv_state``, ``head_k_dim`` for ``ssm_state``), regardless of how many
+    dims precede it.
+
+    Args:
+        tensor: A real-valued (float16/float32/bfloat16) CPU tensor, shaped
+            ``(num_layers, num_blocks, *sub_state_shape)`` as returned by
+            :func:`split_mamba_chunk`.
+        substate: ``"conv"`` or ``"ssm"``.
+        scaling_method: ``"per_tensor"``, ``"per_channel"``, or ``"per_token"``.
+        rh: Apply a randomized Hadamard transform before quantization. The
+            transform length is the resulting chunk size and must be a
+            power of 2. Not supported for ``substate="conv"`` combined with
+            ``scaling_method`` in ``"per_tensor"``/``"per_channel"`` -- this
+            is a caller-imposed restriction for this module, not a native
+            kernel limitation.
+        asym: Use asymmetric (zero-point) quantization instead of symmetric.
+
+    Returns:
+        A payload: 4-byte magic, 1-byte qbit, 1-byte dtype code, 1-byte
+        flags (bit0=rh, bit1=asym), 1-byte scaling method code, 1-byte
+        substate code, 1-byte ndim, ``ndim`` big-endian int32 shape dims,
+        then the fused native payload (scale-length-prefixed scale bytes
+        followed by the packed 4-bit values).
