+        substate == "conv"
+        and rh
+        and scaling_method in _UNSUPPORTED_CONV_RH_METHODS
+    ):
+        raise ValueError(
+            f"rh is not supported for substate='conv' with "
+            f"scaling_method={scaling_method!r}; use scaling_method='per_token'"
