+
+def dequantize_mamba_substate_4bit(payload: bytes) -> torch.Tensor:
+    """Invert :func:`quantize_mamba_substate_4bit`.
+
+    Reads back the ``substate``/``scaling_method``/``rh``/``asym`` the
+    payload was quantized with (from its header) and calls
+    ``kvweave_quant.kvweave_dequantize_chunk_state`` with matching
+    arguments -- callers do not need to track how a payload was produced.
+
+    Args:
+        payload: A payload produced by :func:`quantize_mamba_substate_4bit`.
+
+    Returns:
+        The reconstructed tensor, in its original shape and dtype.
+
+    Raises:
+        ValueError: If ``payload``'s magic, qbit, dtype code, scaling
+            method code, or substate code is unrecognized.
+    """
+    if payload[:4] == _RAW_MAGIC:
+        dtype_code, ndim = struct.unpack(">BB", payload[4:6])
+        if dtype_code not in _CODE_TO_DTYPE:
+            raise ValueError(f"unrecognized raw dtype code: {dtype_code}")
+        offset = 6
+        shape = struct.unpack(">" + "i" * ndim, payload[offset : offset + 4 * ndim])
+        offset += 4 * ndim
+        dtype = _CODE_TO_DTYPE[dtype_code]
+        numel = 1
+        for dim in shape:
+            numel *= dim
+        expected_nbytes = numel * torch.empty((), dtype=dtype).element_size()
+        raw_bytes = payload[offset : offset + expected_nbytes]
+        if len(raw_bytes) != expected_nbytes:
+            raise ValueError(
+                f"raw Mamba payload truncated: got {len(raw_bytes)} bytes, "
+                f"expected {expected_nbytes}"
+            )
+        return torch.frombuffer(
+            bytearray(raw_bytes), dtype=dtype
+        ).reshape(shape).clone()
+    if payload[:4] != _MAGIC:
+        raise ValueError(f"unrecognized payload magic: {payload[:4]!r}")
+    qbit, dtype_code, flags, scaling_method_code, substate_code, ndim = (
+        struct.unpack(">BBBBBB", payload[4:10])
+    )
+    if qbit != _QBIT:
+        raise ValueError(f"unsupported qbit in payload: {qbit} (expected {_QBIT})")
+    if dtype_code not in _CODE_TO_DTYPE:
+        raise ValueError(f"unrecognized dtype code: {dtype_code}")
+    if scaling_method_code not in _CODE_TO_SCALING_METHOD:
+        raise ValueError(f"unrecognized scaling method code: {scaling_method_code}")
+    if substate_code not in _CODE_TO_SUBSTATE:
+        raise ValueError(f"unrecognized substate code: {substate_code}")
+    offset = 10
+    shape = struct.unpack(">" + "i" * ndim, payload[offset : offset + 4 * ndim])
+    offset += 4 * ndim
+
+    dtype = _CODE_TO_DTYPE[dtype_code]
+    scaling_method = _CODE_TO_SCALING_METHOD[scaling_method_code]
+    substate = _CODE_TO_SUBSTATE[substate_code]
+    rh = bool(flags & _FLAG_RH)
+    asym = bool(flags & _FLAG_ASYM)
+    numel = 1
+    for dim in shape:
+        numel *= dim
+    num_layers = shape[0]
+    num_blocks = shape[1]
+    blocks_num, head_num, head_dim, num_chunks = _mamba_quant_layout(
+        substate, shape, numel, scaling_method
+    )
+
+    (scale_bytes_len,) = struct.unpack(">I", payload[offset : offset + 4])
+    offset += 4
+    scale_bytes = payload[offset : offset + scale_bytes_len]
+    offset += scale_bytes_len
+    q_data = torch.frombuffer(
+        bytearray(payload[offset:]), dtype=torch.int8 if qbit <= 8 else torch.int16
+    )
+
+    signs, perm = (None, None)
+    if rh:
+        numel_per_layer = max(numel // num_layers, 1)
+        signs, perm = _precond_pair(max(numel_per_layer // num_chunks, 1))
+
+    flat = kvweave_quant.kvweave_dequantize_chunk_state(
+        q_data,
+        scale_bytes,
+        num_layers,
+        num_blocks,
+        numel // (num_layers * num_blocks),
+        qbit=_QBIT,
+        blocks_num=blocks_num,
+        block_size=1,
+        head_num=head_num,
+        head_dim=head_dim,
+        rh=rh,
+        asym=asym,
+        scaling_method=scaling_method,
+        output_dtype=dtype,
+        signs=signs,
+        perm=perm,
+    )
+    return flat.reshape(shape)
+
+
+def pack_mamba_payloads(conv_payload: bytes, ssm_payload: bytes) -> bytes:
+    """Frame a Mamba chunk's two quantized payloads into one stored blob.
+
+    Args:
+        conv_payload: ``conv_state``'s payload, from :func:`quantize_mamba_substate_4bit`.
+        ssm_payload: ``ssm_state``'s payload, from :func:`quantize_mamba_substate_4bit`.
+
+    Returns:
+        ``conv_payload``'s length as a big-endian uint32, followed by
+        ``conv_payload``, followed by ``ssm_payload``.
+    """
+    return struct.pack(">I", len(conv_payload)) + conv_payload + ssm_payload
+
+
+def unpack_mamba_payloads(blob: bytes) -> tuple[bytes, bytes]:
+    """Invert :func:`pack_mamba_payloads`.
+
+    Args:
+        blob: A blob produced by :func:`pack_mamba_payloads`.
+
+    Returns:
+        The ``(conv_payload, ssm_payload)`` pair.
+    """
+    (conv_len,) = struct.unpack(">I", blob[:4])
+    conv_payload = blob[4 : 4 + conv_len]
+    ssm_payload = blob[4 + conv_len :]
+    return conv_payload, ssm_payload
