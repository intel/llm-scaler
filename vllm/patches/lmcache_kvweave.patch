diff --git a/lmcache/v1/distributed/serde/kvweave_config.py b/lmcache/v1/distributed/serde/kvweave_config.py
new file mode 100644
index 0000000..9f8f194
--- /dev/null
+++ b/lmcache/v1/distributed/serde/kvweave_config.py
@@ -0,0 +1,131 @@
+"""KVWeave codec configuration.
+
+This module is the single source of truth for the KVWeave codec settings used
+by the LMCache L1 worker-side quantization path
+(``lmcache/v1/multiprocess/transfer_context/worker_transfer.py``): it defines
+the ``KVWeaveCodecConfig`` dataclass consumed directly by ``_KVWeaveCodec``
+(see ``kvweave_serde.py``), and by the Mamba/linear preconditioner in
+``mamba_quant.py``.
+
+Preconditioning (P&D) matrices
+------------------------------
+When ``precond`` is true the caller needs the D (``signs``, +/-1) and P
+(``perm``, permutation) matrices for a given ``hadamard_size``.
+:meth:`KVWeaveCodecConfig.get_pd_matrix` provides them:
+
+* If ``precond_path`` is set, the matrices are loaded from that file (a NumPy
+  ``.npz`` or a torch ``.pt``) keyed by ``hadamard_size`` -- this is the seam
+  for injecting data-driven / GHA-computed preconditioners.
+* Otherwise they are generated deterministically from ``precond_seed`` (the
+  historical seed-42 behavior).
+
+The matrices are returned as NumPy arrays; the caller coerces them to torch
+tensors and validates them before use.
+"""
+from __future__ import annotations
+
+import threading
+from dataclasses import dataclass
+from typing import Optional, Tuple
+
+import numpy as np
+
+# Historical default seed used to generate the random sign-flip / permutation
+# preconditioner.  Kept so behavior is unchanged when no precond file is given.
+_DEFAULT_PRECOND_SEED = 42
+
+
+@dataclass
+class KVWeaveCodecConfig:
+    """Typed KVWeave codec settings."""
+
+    quantize: bool = True
+    qbit: int = 4
+    scaling_method: str = "per_channel"
+    rh: bool = True
+    asym: bool = True
+    log: bool = False
+    precond: bool = False
+    num_threads: int = 1
+    precond_seed: int = _DEFAULT_PRECOND_SEED
+    # Optional path to a file of precomputed P&D matrices (.npz or .pt),
+    # keyed by hadamard_size (see get_pd_matrix).  None -> seeded generator.
+    precond_path: Optional[str] = None
+
+    def __post_init__(self):
+        # Caches keyed by hadamard_size so we generate/load each size once.
+        self._pd_cache: dict = {}
+        self._pd_lock = threading.Lock()
+        self._pd_file: Optional[dict] = None  # lazily loaded precond_path
+        self.scaling_method = str(self.scaling_method)
+
+    # -- P&D matrix interface ------------------------------------------------
+    def get_pd_matrix(
+        self, hadamard_size: int
+    ) -> Optional[Tuple[np.ndarray, np.ndarray]]:
+        """Return ``(signs, perm)`` for ``hadamard_size`` or ``None``.
+
+        ``signs`` is a float32 array of +/-1 with length ``hadamard_size``;
+        ``perm`` is an int32 permutation of ``range(hadamard_size)``.
+
+        Returns ``None`` only if the caller should fall back to its own default
+        (never happens here -- the seeded generator is always available), but a
+        ``None`` return is honored by the caller for forward compatibility.
+        """
+        cached = self._pd_cache.get(hadamard_size)
+        if cached is not None:
+            return cached
+        with self._pd_lock:
+            cached = self._pd_cache.get(hadamard_size)
+            if cached is None:
+                if self.precond_path:
+                    cached = self._load_pd_from_file(hadamard_size)
+                else:
+                    cached = self._generate_pd(hadamard_size)
+                self._pd_cache[hadamard_size] = cached
+        return cached
+
+    def _generate_pd(self, hadamard_size: int) -> Tuple[np.ndarray, np.ndarray]:
+        rng = np.random.default_rng(self.precond_seed)
+        signs = rng.choice([-1.0, 1.0], size=hadamard_size).astype(np.float32)
+        perm = rng.permutation(hadamard_size).astype(np.int32)
+        return signs, perm
+
+    def _load_pd_from_file(
+        self, hadamard_size: int
+    ) -> Tuple[np.ndarray, np.ndarray]:
+        """Load (signs, perm) for ``hadamard_size`` from ``precond_path``.
+
+        Supported layouts:
+          * ``.npz`` with arrays named ``signs_<h>`` / ``perm_<h>``.
+          * ``.pt``  with a dict mapping the same keys to tensors/arrays.
+        """
+        if self._pd_file is None:
+            self._pd_file = self._read_pd_file(self.precond_path)
+        s_key, p_key = f"signs_{hadamard_size}", f"perm_{hadamard_size}"
+        if s_key not in self._pd_file or p_key not in self._pd_file:
+            raise KeyError(
+                f"precond_path={self.precond_path!r} has no P&D matrices for "
+                f"hadamard_size={hadamard_size} (expected keys {s_key!r}, "
+                f"{p_key!r})."
+            )
+        signs = np.asarray(self._pd_file[s_key], dtype=np.float32).reshape(-1)
+        perm = np.asarray(self._pd_file[p_key], dtype=np.int32).reshape(-1)
+        return signs, perm
+
+    @staticmethod
+    def _read_pd_file(path: str) -> dict:
+        if path.endswith(".npz"):
+            with np.load(path) as npz:
+                return {k: npz[k] for k in npz.files}
+        if path.endswith((".pt", ".pth")):
+            import torch  # local import: keep module import torch-free
+
+            obj = torch.load(path, map_location="cpu")
+            return {
+                k: (v.numpy() if hasattr(v, "numpy") else np.asarray(v))
+                for k, v in obj.items()
+            }
+        raise ValueError(
+            f"Unsupported precond_path extension: {path!r} (use .npz or .pt)."
+        )
diff --git a/lmcache/v1/distributed/serde/kvweave_serde.py b/lmcache/v1/distributed/serde/kvweave_serde.py
new file mode 100644
index 0000000..ad89d1f
--- /dev/null
+++ b/lmcache/v1/distributed/serde/kvweave_serde.py
@@ -0,0 +1,645 @@
+"""KVWeave L1 quantization codec for LMCache MP mode.
+
+This module provides ``_KVWeaveCodec``, called directly by the L1 worker-side
+transfer path (``lmcache/v1/multiprocess/transfer_context/worker_transfer.py``)
+to quantize attention-shaped KV chunks before L1 store and dequantize them
+after L1 load, plus the ``_copy_bytes_to_tensor`` helper it uses to land
+serialized bytes into a destination tensor.
+"""
+from __future__ import annotations
+
+import io
+import struct
+import threading
+from dataclasses import dataclass
+from typing import Optional
+
+import torch
+
+from lmcache.logging import init_logger
+from lmcache.v1.distributed.api import MemoryLayoutDesc
+
+try:
+    from lmcache.v1.memory_management import MemoryFormat
+except ImportError:  # pragma: no cover - compatibility with older LMCache trees
+    MemoryFormat = None  # type: ignore[assignment]
+
+from lmcache.v1.distributed.serde import kvweave_config
+
+logger = init_logger(__name__)
+
+_KVW_MAGIC_RAW = b"KVW0"
+_KVW_MAGIC_QUANT = b"KVW3"
+_KVW_BLOCK_SIZE = 64
+
+_KVW_SCALING_TO_INT = {"per_tensor": 0, "per_token": 1, "per_channel": 2}
+_KVW_INT_TO_SCALING = {v: k for k, v in _KVW_SCALING_TO_INT.items()}
+
+_KVW_FMT_TO_INT = {}
+_KVW_INT_TO_FMT = {}
+if MemoryFormat is not None:
+    _KVW_FMT_TO_INT = {
+        MemoryFormat.KV_2LTD: 0,
+        MemoryFormat.KV_T2D: 1,
+        MemoryFormat.KV_2TD: 2,
+        MemoryFormat.KV_MLA_FMT: 3,
+    }
+    _KVW_INT_TO_FMT = {v: k for k, v in _KVW_FMT_TO_INT.items()}
+
+_KVW_DTYPE_TO_INT = {torch.float16: 0, torch.bfloat16: 1, torch.float32: 2}
+_KVW_INT_TO_DTYPE = {v: k for k, v in _KVW_DTYPE_TO_INT.items()}
+
+_KVW_SCALE_COUNTER = 0
+_KVW_SCALE_LOCK = threading.Lock()
+
+
+def _allocate_scale_ids(n: int) -> list[int]:
+    global _KVW_SCALE_COUNTER
+    ids = []
+    with _KVW_SCALE_LOCK:
+        for _ in range(n):
+            _KVW_SCALE_COUNTER = (_KVW_SCALE_COUNTER + 1) & 0xFFFFFFFF
+            ids.append(_KVW_SCALE_COUNTER)
+    return ids
+
+
+def _quantized_half_bytes(half_elements: int, qbit: int) -> int:
+    if qbit == 4:
+        return (half_elements + 1) // 2
+    if qbit <= 8:
+        return half_elements
+    return half_elements * 2
+
+
+def _element_size(dtype: torch.dtype) -> int:
+    if dtype in (torch.float16, torch.bfloat16):
+        return 2
+    if dtype == torch.float32:
+        return 4
+    return torch.tensor([], dtype=dtype).element_size()
+
+
+def _tensor_nbytes(tensor: torch.Tensor) -> int:
+    return int(tensor.numel() * tensor.element_size())
+
+
+def _copy_bytes_to_tensor(payload: bytes, dst_tensor: torch.Tensor) -> None:
+    if not dst_tensor.is_contiguous():
+        raise ValueError("KVWeave serde destination byte buffer must be contiguous")
+    flat = dst_tensor.reshape(-1)
+    if flat.dtype != torch.uint8:
+        flat = dst_tensor.view(torch.uint8).reshape(-1)
+    if len(payload) > flat.numel():
+        raise ValueError(
+            f"KVWeave payload ({len(payload)} bytes) exceeds serde buffer "
+            f"capacity ({flat.numel()} bytes)"
+        )
+    src = torch.frombuffer(payload, dtype=torch.uint8)
+    flat[: len(payload)].copy_(src)
+
+
+def _tensor_to_bytes(tensor: torch.Tensor) -> bytes:
+    if tensor.dtype == torch.uint8:
+        return bytes(tensor.detach().cpu().contiguous().numpy().tobytes())
+    return bytes(tensor.detach().cpu().contiguous().view(torch.uint8).numpy().tobytes())
+
+
+@dataclass
+class _KVShape:
+    tensor4d: torch.Tensor
+    header_shape: tuple[int, ...]
+    num_layers: int
+    chunk_tokens: int
+    h_merged: int
+    original_ndim: int
+
+
+class _KVWeaveCodec:
+    def __init__(self, kwargs: dict[str, object]):
+        cfg_obj = kvweave_config.KVWeaveCodecConfig(
+            quantize=bool(kwargs.get("quantize", True)),
+            qbit=int(kwargs.get("qbit", 4)),
+            scaling_method=str(kwargs.get("scaling_method", "per_channel")),
+            rh=bool(kwargs.get("rh", True)),
+            asym=bool(kwargs.get("asym", True)),
+            log=bool(kwargs.get("log", False)),
+            precond=bool(kwargs.get("precond", False)),
+            num_threads=int(kwargs.get("num_threads", 1)),
+            precond_seed=int(kwargs.get("precond_seed", 42)),
+            precond_path=kwargs.get("precond_path") or None,
+        )
+        self._kvw_cfg = cfg_obj
+        self.quantize = bool(cfg_obj.quantize)
+        self.log = bool(cfg_obj.log)
+        self.qbit = int(cfg_obj.qbit)
+        self.rh = bool(cfg_obj.rh)
+        self.asym = bool(cfg_obj.asym)
+        self.scaling_method = str(cfg_obj.scaling_method)
+        self.precond = bool(cfg_obj.precond)
+        self.linear_rh = bool(kwargs.get("linear_rh", False))
+        self.linear_asym = bool(kwargs.get("linear_asym", False))
+        self.linear_precond = bool(kwargs.get("linear_precond", False))
+        self.num_threads = int(cfg_obj.num_threads)
+        self.block_size = int(kwargs.get("block_size", _KVW_BLOCK_SIZE))
+        self.num_kv_heads = int(kwargs.get("num_kv_heads", kwargs.get("head_num", 1)))
+        self.head_dim = int(kwargs.get("head_dim", 0))
+        self._precond_cache: dict[tuple[str, int], tuple[torch.Tensor, torch.Tensor]] = {}
+        self._precond_lock = threading.Lock()
+
+        self._cpu_quant_mod = None
+        if self.quantize:
+            from kvweave import kvweave_quant
+
+            self._cpu_quant_mod = kvweave_quant
+
+    def estimate_serialized_size(
+        self,
+        layout_desc: MemoryLayoutDesc,
+        scaling_method: Optional[str] = None,
+    ) -> int:
+        total = 0
+        for shape, dtype in zip(layout_desc.shapes, layout_desc.dtypes, strict=True):
+            total += self._estimate_one(
+                tuple(int(x) for x in shape),
+                dtype,
+                scaling_method=scaling_method,
+            )
+        return total
+
+    def serialize_tensor(
+        self,
+        src_tensor: torch.Tensor,
+        scaling_method: Optional[str] = None,
+    ) -> bytes:
+        method = str(scaling_method or self.scaling_method)
+        rh, asym, precond = self._quant_flags_for_method(method)
+        cpu_tensor = src_tensor.detach().to("cpu").contiguous()
+        kv_shape = self._normalize_src(cpu_tensor)
+        raw_bytes = _tensor_nbytes(cpu_tensor)
+        if (
+            not self.quantize
+            or self._cpu_quant_mod is None
+            or not self._is_attention_shape(kv_shape.h_merged)
+        ):
+            payload = self._serialize_raw(cpu_tensor, kv_shape)
+            if self.log:
+                logger.debug(
+                    "KVWeave store raw shape=%s dtype=%s raw_bytes=%d payload_bytes=%d "
+                    "attention_shape=%s",
+                    tuple(cpu_tensor.shape), cpu_tensor.dtype, raw_bytes, len(payload),
+                    self._is_attention_shape(kv_shape.h_merged),
+                )
+            return payload
+
+        header = self._build_kvw3_header(
+            kv_shape,
+            cpu_tensor.dtype,
+            scaling_method=method,
+            rh=rh,
+            asym=asym,
+            precond=precond,
+        )
+        signs_cpu, perm_cpu = (None, None)
+        if precond:
+            signs_cpu, perm_cpu = self._precond_pair(
+                kv_shape.chunk_tokens,
+                kv_shape.h_merged,
+                scaling_method=method,
+            )
+        scale_ids = _allocate_scale_ids(2)
+        blocks_num = max(1, kv_shape.chunk_tokens // self.block_size)
+        payload = self._cpu_quant_mod.kvweave_serialize_chunk(
+            kv_shape.tensor4d,
+            header,
+            scale_ids[0],
+            scale_ids[1],
+            qbit=self.qbit,
+            blocks_num=blocks_num,
+            block_size=self.block_size,
+            head_num=self._head_num(kv_shape.h_merged),
+            head_dim=self._head_dim(kv_shape.h_merged),
+            num_layers=kv_shape.num_layers,
+            rh=rh,
+            asym=asym,
+            scaling_method=method,
+            signs=signs_cpu,
+            perm=perm_cpu,
+            num_threads=self.num_threads,
+        )
+        inner_payload = bytes(payload)
+        payload_bytes = inner_payload
+        if self.log:
+            half_elements = int(kv_shape.num_layers) * int(kv_shape.chunk_tokens) * int(kv_shape.h_merged)
+            q_bytes = 2 * _quantized_half_bytes(half_elements, self.qbit)
+            scale_bytes = max(0, len(inner_payload) - len(header) - 8 - q_bytes)
+            ratio = (len(payload_bytes) / raw_bytes) if raw_bytes else 0.0
+            logger.debug(
+                "KVWeave quantize store shape=%s dtype=%s qbit=%d scaling=%s "
+                "raw_bytes=%d payload_bytes=%d ratio=%.4f q_bytes=%d scale_bytes=%d",
+                tuple(cpu_tensor.shape), cpu_tensor.dtype, self.qbit, raw_bytes,
+                method, len(payload_bytes), ratio, q_bytes, scale_bytes,
+            )
+        return payload_bytes
+
+    def deserialize_tensor(self, src_tensor: torch.Tensor, dst_tensor: torch.Tensor) -> None:
+        raw = _tensor_to_bytes(src_tensor)
+        parsed = self._parse_payload(raw)
+        copied_direct = False
+        if parsed["raw"]:
+            tensor = self._decode_raw(parsed, dst_tensor)
+            if self.log:
+                logger.debug(
+                    "KVWeave load raw shape=%s payload_buffer_bytes=%d restored_bytes=%d",
+                    tuple(parsed["shape"]), len(raw), _tensor_nbytes(tensor),
+                )
+        else:
+            if self._cpu_quant_mod is None:
+                from kvweave import kvweave_quant
+
+                self._cpu_quant_mod = kvweave_quant
+            if (
+                len(parsed["shape"]) == 4
+                and hasattr(self._cpu_quant_mod, "kvweave_dequantize_chunk_into_4d")
+            ):
+                self._cpu_dequantize_into_4d(parsed, dst_tensor)
+                tensor = dst_tensor
+                copied_direct = True
+            else:
+                tensor = self._cpu_dequantize(parsed)
+            if self.log:
+                q_bytes = len(parsed["q_data"])
+                scale_bytes = len(parsed["k_scale_bytes"]) + len(parsed["v_scale_bytes"])
+                logger.debug(
+                    "KVWeave dequantize load shape=%s qbit=%d payload_buffer_bytes=%d "
+                    "q_bytes=%d scale_bytes=%d restored_bytes=%d",
+                    tuple(parsed["shape"]), int(parsed["qbit"]), len(raw),
+                    q_bytes, scale_bytes, _tensor_nbytes(tensor),
+                )
+        if not copied_direct:
+            self._copy_restored(tensor, dst_tensor)
+
+    def _estimate_one(
+        self,
+        shape: tuple[int, ...],
+        dtype: torch.dtype,
+        scaling_method: Optional[str] = None,
+    ) -> int:
+        if len(shape) == 3:
+            chunk_tokens, kv_size, h_merged = shape
+            num_layers = 1
+            original_ndim = 3
+        elif len(shape) == 4:
+            kv_size, num_layers, chunk_tokens, h_merged = shape
+            original_ndim = 4
+        else:
+            nbytes = _element_size(dtype)
+            for dim in shape:
+                nbytes *= dim
+            return 64 + nbytes
+        if kv_size != 2:
+            raise ValueError(f"KVWeave serde expects K/V dimension size 2, got {shape}")
+
+        method = str(scaling_method or self.scaling_method)
+        _, _, precond = self._quant_flags_for_method(method)
+        header = 4 + 8 + 4 * original_ndim
+        if precond:
+            header += 4 + 8 * self._hadamard_size(
+                chunk_tokens,
+                h_merged,
+                scaling_method=method,
+            )
+
+        half_elements = int(num_layers) * int(chunk_tokens) * int(h_merged)
+        if not self.quantize:
+            return header + 16 + 2 * half_elements * _element_size(dtype)
+
+        q_bytes = 2 * _quantized_half_bytes(half_elements, self.qbit)
+        scale_count = max(
+            1,
+            self._scale_count(
+                chunk_tokens,
+                h_merged,
+                num_layers,
+                scaling_method=method,
+            ),
+        )
+        scale_bytes = 2 * (4 + scale_count * 12)
+        estimated = header + 8 + scale_bytes + q_bytes
+        return int(estimated * 1.02) + 4096
+
+    def _normalize_src(self, tensor: torch.Tensor) -> _KVShape:
+        if tensor.dim() == 3:
+            chunk_tokens, kv_size, h_merged = (int(x) for x in tensor.shape)
+            if kv_size != 2:
+                raise ValueError(f"KVWeave serde expects shape [T,2,H], got {tuple(tensor.shape)}")
+            tensor4d = tensor.permute(1, 0, 2).unsqueeze(1).contiguous()
+            return _KVShape(tensor4d, (chunk_tokens, 2, h_merged), 1, chunk_tokens, h_merged, 3)
+        if tensor.dim() == 4:
+            kv_size, num_layers, chunk_tokens, h_merged = (int(x) for x in tensor.shape)
+            if kv_size != 2:
+                raise ValueError(f"KVWeave serde expects shape [2,L,T,H], got {tuple(tensor.shape)}")
+            return _KVShape(tensor.contiguous(), tuple(int(x) for x in tensor.shape), num_layers, chunk_tokens, h_merged, 4)
+        raise ValueError(f"Unsupported KV tensor shape for KVWeave serde: {tuple(tensor.shape)}")
+
+    def _serialize_raw(self, tensor: torch.Tensor, kv_shape: _KVShape) -> bytes:
+        header = struct.pack(
+            ">4sBBB",
+            _KVW_MAGIC_RAW,
+            kv_shape.original_ndim,
+            _KVW_FMT_TO_INT.get(getattr(MemoryFormat, "KV_T2D", None), 1),
+            _KVW_DTYPE_TO_INT.get(tensor.dtype, 0),
+        )
+        header += struct.pack(">" + "i" * kv_shape.original_ndim, *kv_shape.header_shape)
+        return header + bytes(tensor.contiguous().numpy().tobytes())
+
+    def _build_kvw3_header(
+        self,
+        kv_shape: _KVShape,
+        src_dtype: torch.dtype,
+        scaling_method: str,
+        rh: bool,
+        asym: bool,
+        precond: bool,
+    ) -> bytes:
+        header = struct.pack(
+            ">4sBBBBBBBB",
+            _KVW_MAGIC_QUANT,
+            self.qbit,
+            int(rh),
+            int(asym),
+            int(precond),
+            kv_shape.original_ndim,
+            _KVW_FMT_TO_INT.get(getattr(MemoryFormat, "KV_T2D", None), 1),
+            _KVW_SCALING_TO_INT.get(scaling_method, 1),
+            _KVW_DTYPE_TO_INT.get(src_dtype, 0),
+        )
+        if precond:
+            signs_cpu, perm_cpu = self._precond_pair(
+                kv_shape.chunk_tokens,
+                kv_shape.h_merged,
+                scaling_method=scaling_method,
+            )
+            h = signs_cpu.numel()
+            header += struct.pack(">I", h)
+            header += signs_cpu.numpy().tobytes()
+            header += perm_cpu.numpy().tobytes()
+        header += struct.pack(">" + "i" * kv_shape.original_ndim, *kv_shape.header_shape)
+        return header
+
+    def _parse_payload(self, raw: bytes) -> dict[str, object]:
+        buf = io.BytesIO(raw)
+        magic = buf.read(4)
+        if magic == _KVW_MAGIC_RAW:
+            ndim, fmt_byte, dtype_byte = struct.unpack(">BBB", buf.read(3))
+            shape = tuple(struct.unpack(">" + "i" * ndim, buf.read(4 * ndim)))
+            dtype = _KVW_INT_TO_DTYPE.get(dtype_byte, torch.float16)
+            nbytes = _element_size(dtype)
+            for dim in shape:
+                nbytes *= int(dim)
+            return {
+                "raw": True,
+                "tensor_bytes": buf.read(nbytes),
+                "shape": shape,
+                "output_dtype": dtype,
+                "fmt": _KVW_INT_TO_FMT.get(fmt_byte),
+            }
+        if magic != _KVW_MAGIC_QUANT:
+            raise ValueError(f"KVWeave bad magic: {magic!r}")
+
+        qbit, rh, asym, precond, ndim, fmt_byte, scaling_byte, dtype_byte = struct.unpack(
+            ">BBBBBBBB", buf.read(8)
+        )
+        signs: Optional[torch.Tensor] = None
+        perm: Optional[torch.Tensor] = None
+        if precond:
+            h = struct.unpack(">I", buf.read(4))[0]
+            signs = torch.frombuffer(buf.read(4 * h), dtype=torch.float32).clone()
+            perm = torch.frombuffer(buf.read(4 * h), dtype=torch.int32).clone()
+
+        shape = tuple(struct.unpack(">" + "i" * ndim, buf.read(4 * ndim)))
+        if len(shape) == 3:
+            shape_4d = (shape[1], 1, shape[0], shape[2])
+        else:
+            shape_4d = shape
+        kv_size, num_layers, chunk_tokens, h_merged = shape_4d
+
+        scale_blobs = []
+        for _ in range(kv_size):
+            scale_len = struct.unpack(">I", buf.read(4))[0]
+            scale_blobs.append(buf.read(scale_len))
+        half_elements = int(num_layers) * int(chunk_tokens) * int(h_merged)
+        half_bytes = _quantized_half_bytes(half_elements, qbit)
+        q_raw = buf.read(2 * half_bytes)
+        head_num = self._head_num(int(h_merged))
+        head_dim = int(h_merged) // head_num if head_num > 1 else int(h_merged)
+        blocks_num = max(1, int(chunk_tokens) // self.block_size)
+        scaling_method = _KVW_INT_TO_SCALING.get(scaling_byte, self.scaling_method)
+
+        return {
+            "raw": False,
+            "q_data": q_raw,
+            "k_scale_bytes": scale_blobs[0] if len(scale_blobs) > 0 else b"",
+            "v_scale_bytes": scale_blobs[1] if len(scale_blobs) > 1 else b"",
+            "qbit": qbit,
+            "rh": bool(rh),
+            "asym": bool(asym),
+            "scaling_method": scaling_method,
+            "output_dtype": _KVW_INT_TO_DTYPE.get(dtype_byte, torch.float16),
+            "shape": shape,
+            "chunk_tokens": int(chunk_tokens),
+            "h_merged": int(h_merged),
+            "num_layers": int(num_layers),
+            "blocks_num": int(blocks_num),
+            "block_size": self.block_size,
+            "head_num": int(head_num),
+            "head_dim": int(head_dim),
+            "signs": signs,
+            "perm": perm,
+            "fmt": _KVW_INT_TO_FMT.get(fmt_byte),
+        }
+
+    def _decode_raw(self, parsed: dict[str, object], dst_tensor: torch.Tensor) -> torch.Tensor:
+        tensor = torch.frombuffer(bytearray(parsed["tensor_bytes"]), dtype=parsed["output_dtype"])
+        return tensor.reshape(tuple(parsed["shape"]))
+
+    def _cpu_dequantize(self, parsed: dict[str, object]) -> torch.Tensor:
+        qbit = int(parsed["qbit"])
+        q_dtype = torch.int8 if qbit <= 8 else torch.int16
+        q_data = torch.frombuffer(bytearray(parsed["q_data"]), dtype=q_dtype)
+        result = self._cpu_quant_mod.kvweave_dequantize_chunk(
+            q_data,
+            parsed["k_scale_bytes"],
+            parsed["v_scale_bytes"],
+            int(parsed["num_layers"]),
+            int(parsed["chunk_tokens"]),
+            int(parsed["h_merged"]),
+            qbit=qbit,
+            blocks_num=int(parsed["blocks_num"]),
+            block_size=int(parsed["block_size"]),
+            head_num=int(parsed["head_num"]),
+            head_dim=int(parsed["head_dim"]),
+            rh=bool(parsed["rh"]),
+            asym=bool(parsed["asym"]),
+            scaling_method=str(parsed["scaling_method"]),
+            output_dtype=parsed["output_dtype"],
+            signs=parsed["signs"],
+            perm=parsed["perm"],
+            num_threads=self.num_threads,
+        )
+        if len(parsed["shape"]) == 3:
+            return result.squeeze(1).permute(1, 0, 2)
+        return result.contiguous()
+
+    def _cpu_dequantize_into_4d(self, parsed: dict[str, object], dst_tensor: torch.Tensor) -> None:
+        qbit = int(parsed["qbit"])
+        q_dtype = torch.int8 if qbit <= 8 else torch.int16
+        q_data = torch.frombuffer(bytearray(parsed["q_data"]), dtype=q_dtype)
+        self._cpu_quant_mod.kvweave_dequantize_chunk_into_4d(
+            q_data,
+            parsed["k_scale_bytes"],
+            parsed["v_scale_bytes"],
+            dst_tensor,
+            int(parsed["num_layers"]),
+            int(parsed["chunk_tokens"]),
+            int(parsed["h_merged"]),
+            qbit=qbit,
+            blocks_num=int(parsed["blocks_num"]),
+            block_size=int(parsed["block_size"]),
+            head_num=int(parsed["head_num"]),
+            head_dim=int(parsed["head_dim"]),
+            rh=bool(parsed["rh"]),
+            asym=bool(parsed["asym"]),
+            scaling_method=str(parsed["scaling_method"]),
+            output_dtype=parsed["output_dtype"],
+            signs=parsed["signs"],
+            perm=parsed["perm"],
+            num_threads=self.num_threads,
+        )
+
+    @staticmethod
+    def _copy_restored(tensor: torch.Tensor, dst_tensor: torch.Tensor) -> None:
+        if tuple(tensor.shape) != tuple(dst_tensor.shape):
+            tensor = tensor.reshape(dst_tensor.shape)
+        dst_tensor.copy_(tensor.to(device=dst_tensor.device, dtype=dst_tensor.dtype))
+
+    def _head_num(self, h_merged: int) -> int:
+        if self.num_kv_heads > 1 and h_merged % self.num_kv_heads == 0:
+            return self.num_kv_heads
+        return 1
+
+    def _quant_flags_for_method(self, scaling_method: str) -> tuple[bool, bool, bool]:
+        """Resolve effective quant flags for one scaling method.
+
+        Per-tensor path is reserved for linear/mamba groups; its RH/ASYM/
+        PRECOND are controlled independently from the attention path via
+        linear_rh/linear_asym/linear_precond.
+        """
+        method = str(scaling_method)
+        if method == "per_tensor":
+            return self.linear_rh, self.linear_asym, self.linear_precond
+        return self.rh, self.asym, self.precond
+
+    def _head_dim(self, h_merged: int) -> int:
+        if self.head_dim > 0:
+            return self.head_dim
+        head_num = self._head_num(h_merged)
+        return h_merged // head_num if head_num > 1 else h_merged
+
+    def _is_attention_shape(self, h_merged: int) -> bool:
+        """Whether ``h_merged`` matches this model's real attention KV width.
+
+        Hybrid Mamba/attention models (e.g. Qwen3.5) reinterpret Mamba
+        ``[conv_state, ssm_state]`` pages as attention-shaped tensors purely so
+        LMCache's transfer path can address them (see
+        ``lmcache/integration/vllm/kv_cache_group_edits.py:_MambaPageViewEdit``
+        upstream); those bytes are opaque, not real K/V, so content-aware
+        quantization must not run on them. Real attention chunks have
+        ``h_merged == num_kv_heads * head_dim``; anything else is treated as
+        non-attention and stored raw (see ``serialize_tensor``).
+        """
+        return self.num_kv_heads > 0 and self.head_dim > 0 and h_merged == self.num_kv_heads * self.head_dim
+
+    def _hadamard_size(
+        self,
+        chunk_tokens: int,
+        h_merged: int,
+        scaling_method: Optional[str] = None,
+    ) -> int:
+        half_elements = int(chunk_tokens) * int(h_merged)
+        blocks_num = max(1, int(chunk_tokens) // self.block_size)
+        method = str(scaling_method or self.scaling_method)
+        if method == "per_token":
+            return max(1, half_elements // (blocks_num * self.block_size))
+        if method == "per_channel":
+            return max(1, half_elements // self._head_dim(h_merged))
+        return max(1, half_elements)
+
+    def _scale_count(
+        self,
+        chunk_tokens: int,
+        h_merged: int,
+        num_layers: int,
+        scaling_method: Optional[str] = None,
+    ) -> int:
+        """Return number of scales per K/V half for one chunk.
+
+        This follows kvweave_quant_wrapper.cpp behavior:
+        - per-layer quantization is always used when num_layers > 1, so each
+          layer gets its own independent scale.
+        - otherwise (num_layers == 1) quantization runs on the flattened half
+          and emits one set of scales for the whole half.
+        """
+        method = str(scaling_method or self.scaling_method)
+
+        if method == "per_token":
+            base = max(1, int(chunk_tokens))
+        elif method == "per_channel":
+            base = max(1, self._head_dim(h_merged))
+        else:
+            # per_tensor uses a single scale for one flattened half.
+            base = 1
+
+        use_per_layer = int(num_layers) > 1
+        return base * max(1, int(num_layers)) if use_per_layer else base
+
+    def _precond_pair(
+        self,
+        chunk_tokens: int,
+        h_merged: Optional[int] = None,
+        scaling_method: Optional[str] = None,
+    ):
+        method = str(scaling_method or self.scaling_method)
+        _, _, precond = self._quant_flags_for_method(method)
+        if not precond:
+            return None, None
+        if h_merged is None:
+            raise ValueError("h_merged is required when preconditioning is enabled")
+        hadamard_size = self._hadamard_size(
+            chunk_tokens,
+            h_merged,
+            scaling_method=method,
+        )
+        cache_key = (method, hadamard_size)
+        cached = self._precond_cache.get(cache_key)
+        if cached is not None:
+            return cached
+        with self._precond_lock:
+            cached = self._precond_cache.get(cache_key)
+            if cached is None:
+                signs_arr, perm_arr = self._kvw_cfg.get_pd_matrix(hadamard_size)
+                signs = torch.as_tensor(signs_arr, dtype=torch.float32).reshape(-1).contiguous()
+                perm = torch.as_tensor(perm_arr, dtype=torch.int32).reshape(-1).contiguous()
+                self._validate_precond(signs, perm, hadamard_size)
+                cached = (signs, perm)
+                self._precond_cache[cache_key] = cached
+        return cached
+
+    @staticmethod
+    def _validate_precond(signs: torch.Tensor, perm: torch.Tensor, hadamard_size: int) -> None:
+        if signs.numel() != hadamard_size or perm.numel() != hadamard_size:
+            raise ValueError("P&D matrix length mismatch")
+        if not torch.all((signs == 1.0) | (signs == -1.0)):
+            raise ValueError("signs must contain only +1/-1 values")
+        expected = torch.arange(hadamard_size, dtype=perm.dtype)
+        if not torch.equal(torch.sort(perm).values, expected):
+            raise ValueError("perm must be a permutation of range(h)")
