+# SPDX-License-Identifier: Apache-2.0
+"""Regression tests for hybrid Mamba terminal-prefix external hits.
+
+These tests use only the scheduler-side connector seam.  No server, device, or
+vLLM engine is started: the fake adapter models a completed lookup and records
+the lock-release request that a real MP lookup needs.
+"""
+
+# Standard
+from types import SimpleNamespace
+
+# Third Party
+from vllm.v1.request import RequestStatus
+
+# First Party
+from lmcache.integration.vllm.lmcache_mp_connector import LMCacheMPConnector
+
+
+class _Adapter:
+    lmcache_tokens_per_chunk = 1024
+
+    def __init__(self, matched_tokens: int) -> None:
+        self.matched_tokens = matched_tokens
+        self.lookups: list[tuple[str, list[int], str]] = []
+        self.released: list[tuple[list[int], int, int, str, str]] = []
+
+    def maybe_submit_lookup_request(
+        self, request_id: str, token_ids: list[int], cache_salt: str
+    ) -> None:
+        self.lookups.append((request_id, token_ids, cache_salt))
+
+    def check_lookup_result(self, request_id: str) -> int:
+        return self.matched_tokens
+
+    def free_lookup_locks(
+        self,
+        token_ids: list[int],
+        start: int,
+        end: int,
+        request_id: str,
+        cache_salt: str,
+    ) -> None:
+        self.released.append((token_ids, start, end, request_id, cache_salt))
+
+
+def _connector(
+    matched_tokens: int, *, hybrid_mamba: bool = True
+) -> tuple[LMCacheMPConnector, _Adapter]:
+    """Construct just enough connector state to exercise scheduler lookup."""
+    adapter = _Adapter(matched_tokens)
+    connector = object.__new__(LMCacheMPConnector)
+    connector.scheduler_adapter = adapter
+    connector.request_trackers = {}
+    connector._hit_alignment_tokens = 1024
+    connector._has_hybrid_mamba = hybrid_mamba
+    return connector, adapter
+
+
+def _request(token_count: int, request_id: str = "request") -> SimpleNamespace:
+    return SimpleNamespace(
+        request_id=request_id,
+        all_token_ids=list(range(token_count)),
+        cache_salt="tenant-a",
+        status=RequestStatus.WAITING,
+    )
+
+
+def test_hybrid_exact_one_block_reuses_nothing_and_releases_all_locks():
+    connector, adapter = _connector(1024)
+    request = _request(1024)
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (0, False)
+    assert adapter.released == [
+        (request.all_token_ids, 0, 1024, "request", "tenant-a")
+    ]
+    tracker = connector.request_trackers["request"]
+    assert tracker.num_lmcache_hit_tokens == 0
+    assert tracker.num_stored_tokens == 0
+
+
+def test_hybrid_two_blocks_reuses_only_preceding_block_and_releases_tail_lock():
+    connector, adapter = _connector(2048)
+    request = _request(2048)
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (1024, True)
+    # vLLM can poll a completed lookup again before block allocation.  The
+    # cached lookup result must not release the same lock or advance storage.
+    assert connector.get_num_new_matched_tokens(request, 0) == (1024, True)
+    assert adapter.released == [
+        (request.all_token_ids, 1024, 2048, "request", "tenant-a")
+    ]
+    tracker = connector.request_trackers["request"]
+    assert tracker.num_lmcache_hit_tokens == 1024
+    assert tracker.num_stored_tokens == 1024
+
+
+def test_hybrid_tail_after_block_keeps_preceding_block_without_releasing_it():
+    connector, adapter = _connector(1024)
+    request = _request(1025)
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (1024, True)
+    assert adapter.released == []
+
+
+def test_attention_only_connector_keeps_existing_full_hit_behavior():
+    connector, adapter = _connector(1024, hybrid_mamba=False)
+    request = _request(1024)
+
+    assert connector.get_num_new_matched_tokens(request, 0) == (1024, True)
+    assert adapter.released == []
