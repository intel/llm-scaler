+def _qsa_indexer_norm_rope_enabled(kind: Literal["q", "k"]) -> bool:
+    if os.environ.get("VLLM_XPU_DISABLE_NATIVE_QSA", "0") == "1":
+        return False
+    suffix = "Q" if kind == "q" else "K"
+    return bool(
+        getattr(
+            envs,
+            f"VLLM_XPU_ENABLE_QWEN38_QSA_INDEX_{suffix}_NORM_ROPE_NATIVE",
+            False,
+        )
+        and not getattr(
+            envs,
+            f"VLLM_XPU_DISABLE_QWEN38_QSA_INDEX_{suffix}_NORM_ROPE_NATIVE",
+            False,
+        )
+    )
+
+
+def _qsa_prefill_norm_rope_candidate(rows: int, output_owner: Any) -> bool:
+    if (
+        not 9 <= rows <= 4096
+        or os.environ.get("QWEN38_QSA_PREFILL_NORM_ROPE", "1") != "1"
+        or not using_qwen38_sycl()
+    ):
+        return False
+    try:
+        metadata: Any = get_forward_context().attn_metadata
+        config = get_current_vllm_config()
+    except (AssertionError, RuntimeError):
+        return False
+    if isinstance(metadata, list):
+        metadata = metadata[0] if len(metadata) == 1 else None
+    if not isinstance(metadata, dict):
+        return False
+    prefix = getattr(getattr(output_owner, "raw_key_cache", None), "prefix", None)
+    if not isinstance(prefix, str):
+        return False
+    raw = metadata.get(prefix)
+    starts = getattr(raw, "query_start_loc_cpu", None)
+    speculative = getattr(config, "speculative_config", None)
+    draft = getattr(speculative, "num_speculative_tokens", 0)
+    # 仅消费已有 CPU query 跨度；大批量 decode/verify 不能冒充 prefill。
+    return bool(
+        type(draft) is int
+        and draft >= 0
+        and getattr(raw, "num_actual_tokens", None) == rows
+        and getattr(raw, "num_mapped_tokens", None) == rows
+        and isinstance(starts, tuple)
+        and len(starts) >= 2
+        and all(type(start) is int for start in starts)
+        and starts[0] == 0
+        and starts[-1] == rows
+        and all(end - start > draft + 1 for start, end in zip(starts, starts[1:]))
+    )
+
