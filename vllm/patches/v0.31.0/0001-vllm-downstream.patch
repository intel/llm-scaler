+def _qsa_native_graph_unsafe() -> bool:
+    """Return true when native buffer reuse is unsafe during capture/compile."""
+    try:
+        if not torch.xpu.is_available():
+            return False
+    except Exception:
+        return True
+    try:
+        compiler = getattr(torch, "compiler", None)
+        is_compiling = getattr(compiler, "is_compiling", None)
+        if callable(is_compiling) and bool(is_compiling()):
+            return True
+    except Exception:
+        return True
+    try:
+        is_capturing = getattr(torch.xpu, "is_current_stream_capturing", None)
+        if callable(is_capturing) and bool(is_capturing()):
+            from ..full_decode import active_full_decode_state
+
+            return not (using_qwen38_sycl() and active_full_decode_state() is not None)
+    except Exception:
+        # Unknown capture state is not safe for a stream-keyed mutable buffer.
+        return True
+    return False
