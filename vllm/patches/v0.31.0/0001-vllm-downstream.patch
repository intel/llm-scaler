+            ),
+            Fp8PerTensorOnlineMoEMethod,
+        )
+        if self._qwen38_fp8_quantized and self.shared_expert is not None:
+            self.shared_expert.down_proj._qwen38_fp8_narrow = True
+        config = vllm_config.model_config.hf_text_config
