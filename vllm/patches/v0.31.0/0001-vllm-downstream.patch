+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in routed GELU expert fusion for Gemma4 XPU decode."""
+
+import operator
+
+import torch
+from torch import fx
+from torch._higher_order_ops.auto_functionalize import auto_functionalized
+
+from vllm.config import VllmConfig, get_layers_from_vllm_config
+from vllm.config.utils import Range
+from vllm.logger import init_logger
+from vllm.model_executor.layers.fused_moe.runner.moe_runner import MoERunner
+
+from ..vllm_inductor_pass import VllmInductorPass
+
+logger = init_logger(__name__)
+
+
+class XpuGemmaMoEFusionPass(VllmInductorPass):
+    """Fuse Gemma routing and routed experts; retain dense branch and norms."""
+
+    def __init__(self, config: VllmConfig) -> None:
+        super().__init__(config)
+        from vllm._xpu_ops import xpu_gemma_moe_unsupported_reason
+
+        self.max_tokens = (
+            config.compilation_config.pass_config.xpu_gemma_moe_fusion_max_token_num
+        )
+        self.enabled = (
+            hasattr(torch.ops.vllm, "xpu_gemma_moe_fused")
+            and not config.parallel_config.use_ubatching
+        )
+        self.matched_count = 0
+        if not self.enabled:
+            return
+        runners = get_layers_from_vllm_config(config, MoERunner)
+        self.enabled = self.enabled and bool(runners)
+        for name, runner in runners.items():
+            reason = xpu_gemma_moe_unsupported_reason(runner)
+            if reason is not None:
+                logger.debug("Gemma expert fusion skipped for %s: %s", name, reason)
+                self.enabled = False
+                break
+        self.matched_count = 0
+
+    def is_applicable_for_range(self, compile_range: Range) -> bool:
+        return self.enabled and compile_range.end <= self.max_tokens
+
+    @VllmInductorPass.time_and_log
+    def __call__(self, graph: fx.Graph) -> None:
+        self.matched_count = 0
+        if not self.enabled:
+            return
+        for node in list(graph.nodes):
+            if (
+                node.op != "call_function"
+                or node.target is not auto_functionalized
+                or not node.args
+                or node.args[0] is not torch.ops.vllm.moe_forward.default
+                or node.kwargs.get("shared_experts_input") is not None
+                or node.kwargs.get("input_ids") is not None
+                or node.kwargs.get("hidden_dim_unpadded", 0) != 0
+                or len(node.users) != 1
+            ):
+                continue
+            routed = next(iter(node.users))
+            if (
+                routed.op != "call_function"
+                or routed.target is not operator.getitem
+                or routed.args != (node, 0)
+            ):
+                continue
+            hidden, logits, layer = (
+                node.kwargs.get(n)
+                for n in ("hidden_states", "router_logits", "layer_name")
+            )
+            val = hidden.meta.get("val") if isinstance(hidden, fx.Node) else None
+            if (
+                not isinstance(val, torch.Tensor)
+                or val.ndim != 2
+                or val.shape[1] != 2816
+                or not val.is_contiguous()
+                or val.dtype not in (torch.float16, torch.bfloat16)
+                or val.device.type != "xpu"
+                or logits is None
+                or layer is None
+            ):
+                continue
+            with graph.inserting_before(node):
+                fused = graph.call_function(
+                    torch.ops.vllm.xpu_gemma_moe_fused.default, (hidden, logits, layer)
+                )
+            fused.meta = dict(routed.meta)
+            routed.replace_all_uses_with(fused)
+            graph.erase_node(routed)
+            graph.erase_node(node)
+            self.matched_count += 1
+        logger.info(
+            "XpuGemmaMoEFusionPass replaced %d routed expert layers", self.matched_count
+        )
+
+    def uuid(self) -> str:
+        from vllm._xpu_ops import xpu_gemma_moe_unsupported_reason
+
+        return self.hash_source(self, xpu_gemma_moe_unsupported_reason)
diff --git a/vllm/compilation/passes/fusion/xpu_moe_decode_fusion.py b/vllm/compilation/passes/fusion/xpu_moe_decode_fusion.py
new file mode 100644
index 0000000000..ab82584225
--- /dev/null
+++ b/vllm/compilation/passes/fusion/xpu_moe_decode_fusion.py
@@ -0,0 +1,207 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Opt-in routed and shared-expert MoE fusion for XPU decode."""
+
+import operator
+
+import torch
+from torch import fx
+
+from vllm.config import VllmConfig, get_layers_from_vllm_config
+from vllm.config.utils import Range
+from vllm.logger import init_logger
+
+from ..vllm_inductor_pass import VllmInductorPass
+
+logger = init_logger(__name__)
+
+
+def _is_fp8_per_tensor(config: VllmConfig) -> bool:
+    quant = config.quant_config
+    if quant is None:
+        return False
+    if quant.get_name() == "online":
+        # Online quantization of an unquantized checkpoint (what
+        # --quantization fp8 resolves to for one): fp8 per-tensor static
+        # weights, unquantized activations, for both linears and experts.
+        from vllm.model_executor.layers.quantization.utils.quant_utils import (
+            kFp8StaticTensorSym,
+        )
+
+        args = getattr(quant, "args", None)
+        return (
+            args is not None
+            and args.targets is None
+            and all(
+                spec is not None
+                and spec.weight == kFp8StaticTensorSym
+                and spec.activation is None
+                for spec in (args.linear, args.moe)
+            )
+        )
+    if quant.get_name() != "fp8":
+        return False
+    return getattr(quant, "weight_block_size", None) is None
+
+
+def _xpu_moe_shared_decode_available() -> bool:
+    # vllm._xpu_ops needs vllm_xpu_kernels; treat an import failure as "not
+    # available" so compilation never fails because of this pass.
+    try:
+        from vllm._xpu_ops import xpu_moe_shared_decode_available
+    except ImportError:
+        return False
+    return xpu_moe_shared_decode_available()
+
+
+class XpuMoESharedDecodeFusionPass(VllmInductorPass):
+    """Replace routed + shared MoE with one fused XPU op for small token counts.
+
+    Matches, per MoE layer::
+
+        out = vllm.moe_forward_shared(hidden, hidden, hidden, None, layer, 0)
+        shared, routed = out[0], out[1]
+        y = shared + routed
+
+    and rewrites it to ``y = vllm.xpu_moe_shared_decode(hidden, hidden, layer)``.
+    The TP all-reduce consuming ``y`` is kept. Only applied for compile ranges
+    whose end is <= ``pass_config.xpu_moe_shared_decode_max_token_num``, and only
+    when every MoE layer of the model supports the fused op; anything that does
+    not match the pattern is left unchanged.
+    """
+
+    def __init__(self, config: VllmConfig):
+        super().__init__(config)
+
+        pass_config = config.compilation_config.pass_config
+        self.max_token_num = pass_config.xpu_moe_shared_decode_max_token_num
+        mc = config.model_config
+        hf = mc.hf_text_config if mc is not None else None
+        pc = config.parallel_config
+        self.enabled = (
+            hf is not None
+            and mc.dtype in (torch.float16, torch.bfloat16)
+            and getattr(hf, "hidden_size", None) == 2048
+            and getattr(hf, "num_experts", None) == 256
+            and getattr(hf, "num_experts_per_tok", None) == 8
+            and getattr(hf, "shared_expert_intermediate_size", 0) > 0
+            and _is_fp8_per_tensor(config)
+            and config.lora_config is None
+            and not pc.enable_expert_parallel
+            and not pc.enable_eplb
+            and not pc.use_ubatching
+            and _xpu_moe_shared_decode_available()
+        )
+        if not self.enabled:
+            logger.warning_once(
+                "XpuMoESharedDecodeFusionPass disabled: model, quantization, parallel "
+                "config or kernel not supported."
+            )
+        else:
+            self.enabled = self._all_moe_layers_supported(config)
+        self.matched_count = 0
+
+    @staticmethod
+    def _all_moe_layers_supported(config: VllmConfig) -> bool:
+        from vllm._xpu_ops import xpu_moe_shared_decode_unsupported_reason
+        from vllm.model_executor.layers.fused_moe.runner.moe_runner import MoERunner
+
+        runners = get_layers_from_vllm_config(config, MoERunner)
+        if not runners:
+            logger.warning_once("XpuMoESharedDecodeFusionPass disabled: no MoE layers.")
+            return False
+        for name, runner in runners.items():
+            reason = xpu_moe_shared_decode_unsupported_reason(runner)
+            if reason is not None:
+                logger.warning_once(
+                    "XpuMoESharedDecodeFusionPass disabled: MoE layer %s is not "
+                    "supported (%s).",
+                    name,
+                    reason,
+                )
+                return False
+        return True
+
+    def is_applicable_for_range(self, compile_range: Range) -> bool:
+        return self.enabled and compile_range.end <= self.max_token_num
+
+    @staticmethod
+    def _match(node: fx.Node) -> tuple[fx.Node | None, str]:
+        """Return the `add` node combining shared and routed outputs."""
+        if len(node.args) != 6 or len(node.users) != 2:
+            return None, "unsupported arguments or extra output consumers"
+        hidden, router_in, shared_in, input_ids, _layer, unpadded = node.args
+        if router_in is not hidden:
+            return None, "router input is not the hidden states"
+        if shared_in is not hidden or input_ids is not None or unpadded != 0:
+            return None, "unsupported moe_forward_shared arguments"
+        getitems = {}
+        for user in node.users:
+            if (
+                user.target is not operator.getitem
+                or len(user.args) != 2
+                or user.args[1] not in (0, 1)
+                or user.args[1] in getitems
+                or len(user.users) != 1
+            ):
+                return None, "unexpected users of moe_forward_shared"
+            getitems[user.args[1]] = user
+        if set(getitems) != {0, 1}:
+            return None, "unexpected users of moe_forward_shared"
+        add = next(iter(getitems[0].users))
+        if (
+            add is not next(iter(getitems[1].users))
+            or add.target is not torch.ops.aten.add.Tensor
+            or len(add.args) != 2
+            or add.kwargs.get("alpha", 1) != 1
+            or set(add.args) != {getitems[0], getitems[1]}
+        ):
+            return None, "shared and routed outputs are not simply added"
+        val = hidden.meta.get("val")
+        if (
+            not isinstance(val, torch.Tensor)
+            or val.ndim != 2
+            or not val.is_contiguous()
+            or val.dtype not in (torch.float16, torch.bfloat16)
+            or val.shape[-1] != 2048
+        ):
+            return None, "unsupported hidden states dtype/shape"
+        return add, ""
+
+    @VllmInductorPass.time_and_log
+    def __call__(self, graph: fx.Graph) -> None:
+        self.matched_count = 0
+        skipped = 0
+        target = torch.ops.vllm.moe_forward_shared.default
+        for node in list(graph.nodes):
+            if node.op != "call_function" or node.target is not target:
+                continue
+            add, reason = self._match(node)
+            if add is None:
+                logger.debug(
+                    "XpuMoESharedDecodeFusionPass skipped %s: %s", node, reason
+                )
+                skipped += 1
+                continue
+            hidden, router_in, _, _, layer_name = node.args[:5]
+            with graph.inserting_before(add):
+                fused = graph.call_function(
+                    torch.ops.vllm.xpu_moe_shared_decode.default,
+                    (hidden, router_in, layer_name),
+                )
+            fused.meta["val"] = add.meta["val"]
+            add.replace_all_uses_with(fused)
+            getitems = list(node.users)
+            graph.erase_node(add)
+            for g in getitems:
+                graph.erase_node(g)
+            graph.erase_node(node)
+            self.matched_count += 1
+        logger.info(
+            "XpuMoESharedDecodeFusionPass replaced %d MoE layers (%d not matched)",
+            self.matched_count,
+            skipped,
+        )
+
+    def uuid(self) -> str:
+        return self.hash_source(self) + f"|{self.enabled}|{self.max_token_num}"
