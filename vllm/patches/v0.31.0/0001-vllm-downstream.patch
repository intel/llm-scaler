+    inputs = (hidden_states, block_output, injection, weight)
+    if any(
+        _tensors_alias(candidate, input_tensor)
+        for candidate in (combine_output, output)
+        for input_tensor in inputs
+    ) or _tensors_alias(combine_output, output):
+        return REASON_OTHER_CONTRACT
+    return None
