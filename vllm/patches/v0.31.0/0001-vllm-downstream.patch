+
+_MASK64 = (1 << 64) - 1
+_SPLITMIX_GAMMA = 0x9E3779B97F4A7C15
+_SPLITMIX_M1 = 0xBF58476D1CE4E5B9
+_SPLITMIX_M2 = 0x94D049BB133111EB
+_PLE_LAYER_PRIME = 10007
+logger = init_logger(__name__)
+_PLE_SPEC_STATE_GATHER_ENABLED = (
+    os.environ.get("VLLM_XPU_DISABLE_QWEN38_PLE_SPEC_STATE_GATHER", "0") != "1"
+)
+
+
+def _gather_spec_state_rows(state: torch.Tensor, indices: torch.Tensor) -> torch.Tensor:
+    if (
+        _PLE_SPEC_STATE_GATHER_ENABLED
+        and state.ndim == 3
+        and not state.is_contiguous()
+        and indices.ndim == 1
+        and indices.dtype == torch.int64
+    ):
+        # XPU index_select first clones the whole strided cache. Gather reads
+        # only selected rows and, unlike advanced indexing, rejects negatives.
+        expanded = indices.view(-1, 1, 1).expand(-1, state.shape[1], state.shape[2])
+        return state.gather(0, expanded)
+    return state.index_select(0, indices)
+
+
+@dataclass(frozen=True)
+class _PreparedShortConvCall:
+    path: int
+    work_units: int
+    operation: object | None = None
+    args: tuple[object, ...] = ()
+    output: torch.Tensor | None = None
+    fallback_args: tuple[object, ...] = ()
