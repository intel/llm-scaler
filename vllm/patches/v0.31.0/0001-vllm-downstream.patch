+    def _get_embedding_op(self) -> EsimdOp | None:
+        if not self._embedding_op_loaded:
+            try:
+                self._embedding_op = self._op_loader(_EMBEDDING_OP_NAME)
+            except (AttributeError, ImportError):
+                self._embedding_op = None
+            self._embedding_op_loaded = True
+        return self._embedding_op
+
+    def _get_ids_eos_op(self) -> EsimdOp | None:
+        # 新增可选 ABI，旧安装库或 ESIMD 后端仍使用原来的 EOS-aware 组合路径。
+        if not using_qwen38_sycl():
+            return None
+        if not self._ids_eos_op_loaded:
+            try:
+                self._ids_eos_op = self._op_loader(_IDS_EOS_OP_NAME)
+            except (AttributeError, ImportError):
+                self._ids_eos_op = None
+            self._ids_eos_op_loaded = True
+        return self._ids_eos_op
+
+    def _capture_active(self) -> bool:
+        return (
+            self._capture_path is not None and self._capture_count < self._capture_limit
+        )
+
+    @staticmethod
+    def _cpu_clone(tensor: torch.Tensor) -> torch.Tensor:
+        return tensor.detach().to(device="cpu").clone()
+
+    @staticmethod
+    def _tensor_sha256(tensor: torch.Tensor) -> str:
+        tensor = tensor.detach().to(device="cpu").contiguous()
+        digest = hashlib.sha256()
+        digest.update(str(tensor.dtype).encode())
+        digest.update(repr(tuple(tensor.shape)).encode())
+        digest.update(tensor.view(torch.uint8).numpy().tobytes())
+        return digest.hexdigest()
+
+    @staticmethod
+    def _current_stream_metadata(device: torch.device) -> dict[str, Any]:
+        metadata: dict[str, Any] = {"device_type": device.type}
+        if device.type == "xpu":
+            stream = torch.xpu.current_stream(device)
+            metadata.update(
+                {
+                    "device": str(stream.device),
+                    "stream_id": getattr(stream, "stream_id", None),
+                    "repr": repr(stream),
+                }
+            )
+        return metadata
+
+    def _capture_ids(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        ngram_context: torch.Tensor,
+        effective_context: torch.Tensor,
+        output: torch.Tensor,
+    ) -> None:
+        current = input_ids.reshape(-1, 1)
+        previous_2 = effective_context[:, :1]
+        previous = effective_context[:, 1:]
+        bigram = (current * owner.layer_multipliers[0]) ^ (
+            previous * owner.layer_multipliers[1]
+        )
+        trigram = bigram ^ (previous_2 * owner.layer_multipliers[2])
+        mixed = torch.cat((bigram.expand(-1, 8), trigram.expand(-1, 8)), dim=1)
+        reference = (
+            torch.remainder(mixed, owner.ngram_heads_vocab_sizes)
+            + owner.ngram_heads_offsets
+        )
+        ids_parity_ok = torch.equal(output, reference)
+        ids_domain_ok = bool(
+            ((output >= 0) & (output < _QWEN38_GENERATED_VOCAB_SIZE)).all()
+        )
+        self._pending_capture = {
+            "ids_parity_ok": ids_parity_ok,
+            "ids_domain_ok": ids_domain_ok,
+            "input_ids": self._cpu_clone(input_ids),
+            "ngram_context": self._cpu_clone(ngram_context),
+            "effective_context": self._cpu_clone(effective_context),
+            "ngram_ids": self._cpu_clone(output),
+            "ngram_ids_reference": self._cpu_clone(reference),
+        }
+
+    def _capture_local_partial(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+        local_partial_heads: torch.Tensor,
+    ) -> dict[str, Any]:
+        weight = owner.ngram_embedding.weight
+        local_start = owner._esimd_local_vocab_start[0]
+        local_num_rows = owner._esimd_local_num_rows[0]
+        valid = (ngram_ids >= local_start) & (ngram_ids < local_start + local_num_rows)
+        local_ids = torch.where(
+            valid,
+            ngram_ids - local_start,
+            torch.zeros_like(ngram_ids),
+        )
+        gathered = F.embedding(local_ids, weight)
+        reference = torch.where(
+            valid.unsqueeze(-1), gathered, torch.zeros_like(gathered)
+        )
+        local_parity_ok = torch.equal(local_partial_heads, reference)
+        valid_heads = torch.nonzero(valid[0], as_tuple=False).flatten()
+        selected_global_ids = ngram_ids[0].index_select(0, valid_heads)
+        selected_local_ids = local_ids[0].index_select(0, valid_heads)
+        selected_weight_rows = weight.index_select(0, selected_local_ids)
+        return {
+            "local_parity_ok": local_parity_ok,
+            "valid_heads": self._cpu_clone(valid_heads),
+            "selected_global_ids": self._cpu_clone(selected_global_ids),
+            "selected_local_ids": self._cpu_clone(selected_local_ids),
+            "selected_weight_rows": self._cpu_clone(selected_weight_rows),
+            "local_partial": self._cpu_clone(local_partial_heads),
+            "local_partial_reference": self._cpu_clone(reference),
+            "local_vocab_start": self._cpu_clone(owner._esimd_local_vocab_start),
+            "local_num_rows": self._cpu_clone(owner._esimd_local_num_rows),
+        }
+
+    def _write_capture(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+        local_capture: dict[str, Any],
+        reduced: torch.Tensor,
+        flattened: torch.Tensor,
+    ) -> None:
+        if self._capture_path is None or self._pending_capture is None:
+            raise RuntimeError("Qwen3.8 N-gram capture requires both native fast paths")
+        captured_ids = self._pending_capture["ngram_ids"]
+        if not torch.equal(self._cpu_clone(ngram_ids), captured_ids):
+            raise RuntimeError("Qwen3.8 N-gram capture call pairing failed")
+        if self._pending_capture.get("ids_parity_ok") is False:
+            raise RuntimeError("Qwen3.8 N-gram ID capture parity check failed")
+        if self._pending_capture.get("ids_domain_ok") is False:
+            raise RuntimeError("Qwen3.8 N-gram ID escaped the generated domain")
+        if local_capture.get("local_parity_ok") is False:
+            raise RuntimeError(
+                "Qwen3.8 N-gram local embedding capture parity check failed"
+            )
+        rank = self._rank_reader()
+        world_size = self._world_size_reader()
+        if world_size != _QWEN38_TP_SIZE or rank not in range(world_size):
+            raise RuntimeError(
+                "Qwen3.8 N-gram capture requires a valid TP8 process group"
+            )
+        call_index = self._capture_count
+        output_path = self._capture_path / (f"rank{rank:02d}-call{call_index:04d}.pt")
+        backend = None
+        if torch.distributed.is_initialized():
+            backend = str(torch.distributed.get_backend())
+        all_reduce_name = getattr(
+            self._all_reduce,
+            "__qualname__",
+            type(self._all_reduce).__qualname__,
+        )
+        all_reduce_module = getattr(
+            self._all_reduce,
+            "__module__",
+            type(self._all_reduce).__module__,
+        )
+        pre_reduce_heads = owner._esimd_local_partial.view(
+            1, _QWEN38_HEADS, _QWEN38_HEAD_DIM
+        )
+        post_reduce = self._cpu_clone(reduced)
+        post_reduce_flattened = post_reduce.flatten(-2)
+        record = {
+            "schema": "qwen38.tp8.capture.rank.v1",
+            "rank": rank,
+            "world_size": world_size,
+            "call_index": call_index,
+            "run_id": self._capture_run_id,
+            "device": str(ngram_ids.device),
+            "weight_shape": tuple(owner.ngram_embedding.weight.shape),
+            "weight_dtype": str(owner.ngram_embedding.weight.dtype),
+            "stream": self._current_stream_metadata(ngram_ids.device),
+            "collective": {
+                "calls": 1,
+                "callable": f"{all_reduce_module}.{all_reduce_name}",
+                "backend": backend,
+                "reduce_op": "sum",
+                "world_size": world_size,
+                "input_shape": tuple(pre_reduce_heads.shape),
+                "input_dtype": str(pre_reduce_heads.dtype),
+                "input_device": str(pre_reduce_heads.device),
+                "output_aliases_input": reduced.data_ptr()
+                == pre_reduce_heads.data_ptr(),
+            },
+            "layouts": {
+                "local_partial": {
+                    "shape": tuple(owner._esimd_local_partial.shape),
+                    "stride": tuple(owner._esimd_local_partial.stride()),
+                    "storage_offset": owner._esimd_local_partial.storage_offset(),
+                },
+                "pre_reduce_heads": {
+                    "shape": tuple(pre_reduce_heads.shape),
+                    "stride": tuple(pre_reduce_heads.stride()),
+                    "storage_offset": pre_reduce_heads.storage_offset(),
+                },
+                "post_reduce_heads": {
+                    "shape": tuple(reduced.shape),
+                    "stride": tuple(reduced.stride()),
+                    "storage_offset": reduced.storage_offset(),
+                },
+                "flattened": {
+                    "shape": tuple(flattened.shape),
+                    "stride": tuple(flattened.stride()),
+                    "storage_offset": flattened.storage_offset(),
+                },
+                "flatten_aliases_reduced": flattened.data_ptr() == reduced.data_ptr(),
+                "reduced_aliases_workspace": reduced.data_ptr()
+                == owner._esimd_local_partial.data_ptr(),
+            },
+            "post_reduce": post_reduce,
+            "post_reduce_flattened": post_reduce_flattened,
+            **self._pending_capture,
+            **local_capture,
+        }
+        record["tensor_sha256"] = {
+            key: self._tensor_sha256(value)
+            for key, value in record.items()
+            if isinstance(value, torch.Tensor)
+        }
+        try:
+            with output_path.open("xb") as stream:
+                torch.save(record, stream)
+                stream.flush()
+                os.fsync(stream.fileno())
+        except FileExistsError as error:
+            raise FileExistsError(
+                f"refusing to overwrite capture {output_path}"
+            ) from error
+        self._capture_count += 1
+        self._pending_capture = None
+
+    @staticmethod
+    def _effective_context(
+        ngram_context: torch.Tensor,
+        eos_token_id: int,
+        input_ids: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        previous_is_eos = ngram_context[:, 1:] == eos_token_id
+        context_boundary = torch.cat(
+            (previous_is_eos, torch.zeros_like(previous_is_eos)), dim=1
+        )
+        effective = torch.where(context_boundary, eos_token_id, ngram_context)
+        if input_ids is not None:
+            # The specialized ABI has no EOS argument.  Make its context
+            # equivalent to the general EOS-aware path on the device: an EOS
+            # current token starts a fresh segment, so every shifted
+            # predecessor is EOS.  This avoids a host scalar sync and keeps the
+            # fixed ABI fail-closed without crossing segment boundaries.
+            current_is_eos = input_ids.reshape(-1, 1) == eos_token_id
+            effective = torch.where(
+                current_is_eos, torch.full_like(effective, eos_token_id), effective
+            )
+        return effective
+
+    def _ids_fallback_reason(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> int | None:
+        if not self._metadata_eligible:
+            return REASON_METADATA
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if not self._decode_eligible():
+            return REASON_SCENARIO_DECODE_PROOF
+        rows = input_ids.numel()
+        if (
+            not 1 <= rows <= 8
+            or input_ids.shape != (rows,)
+            or query_start_loc.shape != (rows + 1,)
+            or ngram_context.shape != (rows, 2)
+        ):
+            return REASON_SHAPE
+        if (
+            input_ids.dtype != torch.int64
+            or query_start_loc.dtype != torch.int64
+            or ngram_context.dtype != torch.int64
+        ):
+            return REASON_DTYPE
+        if (
+            input_ids.device.type != "xpu"
+            or query_start_loc.device != input_ids.device
+            or ngram_context.device != input_ids.device
+        ):
+            return REASON_DEVICE
+        if (
+            not input_ids.is_contiguous()
+            or not query_start_loc.is_contiguous()
+            or not ngram_context.is_contiguous()
+        ):
+            return REASON_LAYOUT
+
+        output = owner._esimd_ngram_ids_output
+        layer_multipliers = owner.layer_multipliers
+        if not _ids_python_dispatch_safe(
+            (input_ids, query_start_loc, ngram_context, output, layer_multipliers)
+        ):
+            return REASON_OTHER_CONTRACT
+        hooks = torch.nn.modules.module
+        if hooks._global_forward_hooks or hooks._global_forward_pre_hooks:
+            return REASON_OTHER_CONTRACT
+        if any(
+            getattr(module, "_forward_hooks", None)
+            or getattr(module, "_forward_pre_hooks", None)
+            for module in (owner, owner.ngram_embedding)
+        ):
+            return REASON_OTHER_CONTRACT
+        if output.shape != (1, _QWEN38_HEADS) or layer_multipliers.shape != (3,):
+            return REASON_SHAPE
+        if output.dtype != torch.int64 or layer_multipliers.dtype != torch.int64:
+            return REASON_DTYPE
+        if (
+            output.device != input_ids.device
+            or layer_multipliers.device != input_ids.device
+        ):
+            return REASON_DEVICE
+        if not output.is_contiguous() or not layer_multipliers.is_contiguous():
+            return REASON_LAYOUT
+        return None
+
+    @staticmethod
+    def _ids_output(
+        owner: "Qwen3_8FlashNextNGramEmbedding", input_ids: torch.Tensor
+    ) -> torch.Tensor:
+        key = _ids_buffer_key(input_ids)
+        outputs = owner._esimd_ngram_ids_outputs
+        output = outputs.get(key)
+        if output is None:
+            seed = owner._esimd_ngram_ids_output
+            if input_ids.numel() == 1 and not any(
+                value is seed for value in outputs.values()
+            ):
+                output = seed
+            else:
+                output = torch.empty(
+                    (input_ids.numel(), _QWEN38_HEADS),
+                    dtype=torch.int64,
+                    device=input_ids.device,
+                )
+            outputs[key] = output
+        return output
+
+    def try_generate_ids(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> torch.Tensor | None:
+        work_units = input_ids.numel()
+        if work_units == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ZERO_WORK_SKIP, 0)
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ATTEMPT, work_units)
+        try:
+            disabled = self._ids_disabled()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if disabled:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_DISABLED,
+                )
+            return None
+
+        try:
+            self._ensure_metadata(owner)
+            capture_active = self._capture_active()
+            if capture_active:
+                self._pending_capture = None
+            reason = self._ids_fallback_reason(
+                owner,
+                input_ids,
+                query_start_loc,
+                ngram_context,
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if reason is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    reason,
+                )
+            return None
+        try:
+            op = self._get_ids_op()
+            eos_op = self._get_ids_eos_op() if op is not None else None
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ELIGIBLE, work_units)
+        # Only the current SYCL EOS ABI proves support for multiple rows.
+        # An old installed M1 ABI remains usable for its original shape.
+        if op is None or (work_units > 1 and eos_op is None):
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_OP_UNAVAILABLE,
+                )
+            return None
+        try:
+            output = self._ids_output(owner, input_ids)
+            # 正常快路完全由一个 SYCL kernel 处理 EOS；仅调试 capture 保存参考值。
+            effective_context = (
+                self._effective_context(ngram_context, owner.eos_token_id, input_ids)
+                if eos_op is None or capture_active
+                else ngram_context
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_IDS,
+                EVENT_NATIVE_SUBMITTED,
+                work_units,
+            )
+        try:
+            if eos_op is not None:
+                eos_op(
+                    input_ids,
+                    ngram_context,
+                    owner.layer_multipliers,
+                    output,
+                    owner.eos_token_id,
+                )
+            else:
+                op(input_ids, effective_context, owner.layer_multipliers, output)
+            if capture_active:
+                self._capture_ids(
+                    owner,
+                    input_ids,
+                    ngram_context,
+                    effective_context,
+                    output,
+                )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    work_units,
+                )
+            raise
+        return output
+
+    @staticmethod
+    def _embedding_eligible(
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> bool:
+        embedding = owner.ngram_embedding
+        weight = getattr(embedding, "weight", None)
+        return (
+            ngram_ids.shape == (1, _QWEN38_HEADS)
+            and ngram_ids.dtype == torch.int64
+            and ngram_ids.device.type == "xpu"
+            and ngram_ids.is_contiguous()
+            and type(embedding.quant_method) is UnquantizedEmbeddingMethod
+            and isinstance(weight, torch.Tensor)
+            and weight.shape == (_QWEN38_LOCAL_ROWS, _QWEN38_HEAD_DIM)
+            and weight.dtype == torch.float16
+            and weight.device == ngram_ids.device
+            and weight.is_contiguous()
+            and weight.shape[0] == embedding.num_embeddings_per_partition
+        )
+
+    def _embedding_fallback_reason(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> int | None:
+        if not self._metadata_eligible:
+            return REASON_METADATA
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if not self._decode_eligible():
+            return REASON_SCENARIO_DECODE_PROOF
+        if self._embedding_eligible(owner, ngram_ids):
+            return None
+
+        embedding = owner.ngram_embedding
+        weight = getattr(embedding, "weight", None)
+        if ngram_ids.shape != (1, _QWEN38_HEADS):
+            return REASON_SHAPE
+        if ngram_ids.dtype != torch.int64:
+            return REASON_DTYPE
+        if ngram_ids.device.type != "xpu":
+            return REASON_DEVICE
+        if not ngram_ids.is_contiguous():
+            return REASON_LAYOUT
+        if not isinstance(weight, torch.Tensor):
+            return REASON_OTHER_CONTRACT
+        if weight.shape != (_QWEN38_LOCAL_ROWS, _QWEN38_HEAD_DIM):
+            return REASON_SHAPE
+        if weight.dtype != torch.float16:
+            return REASON_DTYPE
+        if weight.device != ngram_ids.device:
+            return REASON_DEVICE
+        if not weight.is_contiguous():
+            return REASON_LAYOUT
+        return REASON_OTHER_CONTRACT
+
+    @staticmethod
+    def _embedding_workspace_fallback_reason(
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> int | None:
+        local_vocab_start = owner._esimd_local_vocab_start
+        local_num_rows = owner._esimd_local_num_rows
+        local_partial = owner._esimd_local_partial
+        if (
+            local_vocab_start.shape != (1,)
+            or local_num_rows.shape != (1,)
+            or local_partial.shape != (1, _QWEN38_EMBED_DIM)
+        ):
+            return REASON_SHAPE
+        if (
+            local_vocab_start.dtype != torch.int64
+            or local_num_rows.dtype != torch.int64
+            or local_partial.dtype != torch.float16
+        ):
+            return REASON_DTYPE
+        if (
+            local_vocab_start.device != ngram_ids.device
+            or local_num_rows.device != ngram_ids.device
+            or local_partial.device != ngram_ids.device
+        ):
+            return REASON_DEVICE
+        if (
+            not local_vocab_start.is_contiguous()
+            or not local_num_rows.is_contiguous()
+            or not local_partial.is_contiguous()
+        ):
+            return REASON_LAYOUT
+        return None
+
+    def try_embedding(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> torch.Tensor | None:
+        work_units = ngram_ids.numel()
+        if work_units == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_ATTEMPT,
+                work_units,
+            )
+        try:
+            disabled = self._embedding_disabled()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if disabled:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_DISABLED,
+                )
+            return None
+
+        try:
+            self._ensure_metadata(owner)
+            capture_active = self._capture_active()
+            reason = self._embedding_fallback_reason(owner, ngram_ids)
+            if reason is None:
+                if capture_active and self._pending_capture is None:
+                    raise RuntimeError(
+                        "Qwen3.8 N-gram capture requires a native ID result"
+                    )
+                embedding = owner.ngram_embedding
+                weight = embedding.weight
+                local_vocab_start = owner._esimd_local_vocab_start
+                local_num_rows = owner._esimd_local_num_rows
+                local_partial = owner._esimd_local_partial
+                reason = self._embedding_workspace_fallback_reason(owner, ngram_ids)
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if reason is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    reason,
+                )
+            return None
+
+        try:
+            op = self._get_embedding_op()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_ELIGIBLE,
+                work_units,
+            )
+        if op is None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_OP_UNAVAILABLE,
+                )
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_NATIVE_SUBMITTED,
+                work_units,
+            )
+        try:
+            op(
+                ngram_ids,
+                weight,
+                local_vocab_start,
+                local_num_rows,
+                local_partial,
+            )
+            local_partial_heads = local_partial.view(1, _QWEN38_HEADS, _QWEN38_HEAD_DIM)
+            local_capture = (
+                self._capture_local_partial(owner, ngram_ids, local_partial_heads)
+                if capture_active
+                else None
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    work_units,
+                )
+            raise
+
+        reduce_work_units = local_partial_heads.shape[0]
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_ATTEMPT,
+                reduce_work_units,
+            )
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_ELIGIBLE,
+                reduce_work_units,
+            )
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_NATIVE_SUBMITTED,
+                reduce_work_units,
+            )
+        try:
+            reduced = self._all_reduce(local_partial_heads)
+            flattened = reduced.flatten(-2)
+            if local_capture is not None:
+                self._write_capture(
+                    owner,
+                    ngram_ids,
+                    local_capture,
+                    reduced,
+                    flattened,
+                )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    reduce_work_units,
+                )
+            raise
+        return flattened
+
+
+__all__ = ["Qwen38NGramEsimdAdapter"]
