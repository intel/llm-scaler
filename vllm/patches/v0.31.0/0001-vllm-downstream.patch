+    "packed_kv": 1,
+    "pipelined_loader": 0,
+    "stage_validity": 0,
+    "bounded_scan": 0,
+    "single_exp": 0,
+    "block_softmax": 0,
+    "fast_exp": 1,
+    "strided_kv": 1,
+    "selection_output_width": 2051,
+}
+_QSA_TOKEN_SPLIT_NATIVE_ABI = {
+    "qsa_token_split_candidate_abi_version": 3,
+    "qsa_token_split_candidate_max_rows": 128,
+    "qsa_token_split_candidate_page_size": 256,
+    "qsa_token_split_candidate_partial_count": 43,
+    "qsa_token_split_candidate_batch_opt_max_rows": 6,
+}
+_QSA_TOKEN_SPLIT_NATIVE_FUSED_ABI = {
+    "qsa_token_split_candidate_fused_abi_version": 1,
+    "qsa_token_split_candidate_fused_single_launch": 1,
+}
+_QSA_Q6_NATIVE_ABI = {
+    "qsa_q6_abi_version": 1,
+    "qsa_q6_query_heads": 6,
+    "qsa_q6_kv_heads": 1,
+    "qsa_q6_token_split_v3": 1,
+    "qsa_q6_page512": 1,
+}
+_QSA_INDEXER_POSTPROCESS_NATIVE_ABI = {
+    "qsa_indexer_postprocess_abi_version": 1,
+    "qsa_indexer_head_dim": 128,
+    "qsa_indexer_rotary_dim": 64,
+    "qsa_indexer_mrope_interleaved": 1,
+    "qsa_indexer_gemma_weight_plus_one": 1,
