+def _hc_combine_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+) -> int | None:
+    if (
+        envs.VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NATIVE
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NATIVE
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or hidden_states.shape != (1, _HC_COMBINE_WIDTH)
+        or block_output.shape != (1, _HC_COMBINE_HIDDEN_SIZE)
+        or injection.shape != (1, _HC_COMBINE_COUNT)
+        or hc_count != _HC_COMBINE_COUNT
+    ):
+        return REASON_SHAPE
+    if (
+        hidden_states.dtype != torch.float16
+        or block_output.dtype != torch.float16
+        or injection.dtype != torch.float16
+    ):
+        return REASON_DTYPE
+    if (
+        hidden_states.device.type != "xpu"
+        or block_output.device != hidden_states.device
+        or injection.device != hidden_states.device
+    ):
+        return REASON_DEVICE
+    if (
+        not hidden_states.is_contiguous()
+        or not block_output.is_contiguous()
+        or not injection.is_contiguous()
+        or not _is_four_byte_aligned_fp16_view(hidden_states)
+        or not _is_four_byte_aligned_fp16_view(block_output)
+        or not _is_four_byte_aligned_fp16_view(injection)
+    ):
+        return REASON_LAYOUT
+    return None
+
+
+def _hc_combine_native_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_combine_input_fallback_reason(
+        hidden_states,
+        block_output,
+        injection,
+        hc_count,
+    )
+    if reason is not None:
+        return reason
+    if not isinstance(output, torch.Tensor):
+        return REASON_OTHER_CONTRACT
+    if output.shape != hidden_states.shape:
+        return REASON_SHAPE
+    if output.dtype != hidden_states.dtype:
+        return REASON_DTYPE
+    if output.device != hidden_states.device:
+        return REASON_DEVICE
+    if not output.is_contiguous() or not _is_four_byte_aligned_fp16_view(output):
+        return REASON_LAYOUT
+    if (
+        _tensors_alias(output, hidden_states)
+        or _tensors_alias(output, block_output)
+        or _tensors_alias(output, injection)
+    ):
+        return REASON_OTHER_CONTRACT
+    return None
+
