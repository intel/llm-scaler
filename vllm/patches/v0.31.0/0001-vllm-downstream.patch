+def try_esimd_qsa_indexer_projection(
+    x: torch.Tensor,
+    projection: Any,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """Project QSA indexer Q/K directly into a stream-owned backing buffer.
+
+    The narrow ABI covers the Qwen3.8 decode geometry ``[1, 2560] -> [1, 640]``.
+    The returned tensors are disjoint views of one caller-owned ``[1, 640]``
+    buffer: the first view is Q ``[1, 512]`` and the second is raw K ``[1, 128]``.
+    Unsupported shapes remain on the reference ``ReplicatedLinear`` path.
+    """
+    if (
+        getattr(envs, "VLLM_XPU_DISABLE_NATIVE_QSA", False)
+        or not getattr(
+            envs,
+            "VLLM_XPU_ENABLE_QWEN38_QSA_INDEXER_PROJECTION_NATIVE",
+            False,
+        )
+        or getattr(
+            envs,
+            "VLLM_XPU_DISABLE_QWEN38_QSA_INDEXER_PROJECTION_NATIVE",
+            False,
+        )
+    ):
+        return None
+    if getattr(torch.compiler, "is_compiling", lambda: False)():
+        return None
+
+    # An inactive LoRA wrapper still owns module hooks and its own forward.
+    if getattr(
+        projection, "base_layer", None
+    ) is not None and not _raw_linear_semantics_unchanged(projection):
+        return None
+    projection = _get_base_layer_for_no_lora(projection)
+    if projection is None or not _raw_linear_semantics_unchanged(projection):
+        return None
+    if (
+        x.ndim != 2
+        or x.shape != (1, 2560)
+        or x.device.type != "xpu"
+        or x.dtype != torch.float16
+        or not x.is_contiguous()
+        or getattr(projection, "bias", None) is not None
+        or getattr(projection, "gather_output", False)
+        or not getattr(getattr(projection, "quant_method", None), "is_sym_int4", False)
+    ):
+        return None
+
+    weight = getattr(projection, "weight_esimd", None)
+    scale = getattr(projection, "scale_esimd", None)
+    source_signature = _indexer_int4_plan_signature(projection)
+    plan = getattr(projection, "_esimd_qsa_indexer_projection_plan", None)
+    if not isinstance(plan, _IndexerInt4ProjectionPlan):
+        plan = None
+    if plan is not None and plan.source_signature != source_signature:
+        plan = None
+
+    if plan is None:
+        if (
+            not isinstance(weight, torch.Tensor)
+            or not isinstance(scale, torch.Tensor)
+            or weight.shape != (640, 1280)
+            or scale.shape != (640, 20)
+            or weight.dtype != torch.uint8
+            or scale.dtype != torch.float16
+            or weight.device != x.device
+            or scale.device != x.device
+            or not weight.is_contiguous()
+            or not scale.is_contiguous()
+        ):
+            return None
+        module = _QWEN3_NEXT_QKV_ESIMD_ADAPTER._get_module()
+        if module is None:
+            raise RuntimeError(
+                "Qwen3.8 QSA indexer projection native DSO is unavailable after enable"
+            )
+        op = getattr(module, "esimd_gemv_int4", None)
+        if not callable(op):
+            raise RuntimeError(
+                "Qwen3.8 QSA indexer projection native ABI symbol is unavailable"
+            )
+        plan = _IndexerInt4ProjectionPlan(
+            op=op,
+            weight=weight,
+            scale=scale,
+            source_signature=source_signature,
+        )
+        projection._esimd_qsa_indexer_projection_plan = plan
+    else:
+        # The live signature above already checked this call's sources; no
+        # callback or device submission intervenes on the cached-plan path.
+        # Keep the original second read for modes/nonstandard tensors whose
+        # metadata access can invoke user code.
+        if not _direct_parameters(x, weight, scale):
+            weight = getattr(projection, "weight_esimd", None)
+            scale = getattr(projection, "scale_esimd", None)
+            source_signature = _indexer_int4_plan_signature(projection)
+        if (
+            not isinstance(weight, torch.Tensor)
+            or not isinstance(scale, torch.Tensor)
+            or source_signature != plan.source_signature
+            or weight.shape != (640, 1280)
+            or scale.shape != (640, 20)
+            or weight.dtype != torch.uint8
+            or scale.dtype != torch.float16
+            or weight.device != x.device
+            or scale.device != x.device
+            or not weight.is_contiguous()
+            or not scale.is_contiguous()
+        ):
+            return None
+
+    stream = torch.xpu.current_stream(device=x.device)
+    stream_key = (x.device, stream)
+    buffers_by_stream = getattr(
+        projection, "_esimd_qsa_indexer_projection_buffers_by_stream", None
+    )
+    if buffers_by_stream is None:
+        buffers_by_stream = {}
+        projection._esimd_qsa_indexer_projection_buffers_by_stream = buffers_by_stream
+    backing = buffers_by_stream.get(stream_key)
+    if not (
+        isinstance(backing, torch.Tensor)
+        and backing.shape == (1, 640)
+        and backing.dtype == torch.float16
+        and backing.device == x.device
+        and backing.is_contiguous()
+    ):
+        backing = torch.empty((1, 640), dtype=torch.float16, device=x.device)
+        buffers_by_stream[stream_key] = backing
+
+    def aliases(lhs: torch.Tensor, rhs: torch.Tensor) -> bool:
+        alias_method = getattr(lhs, "is_alias_of", None)
+        if callable(alias_method):
+            return bool(alias_method(rhs))
+        return bool(torch._C._is_alias_of(lhs, rhs))
+
+    if any(aliases(backing, tensor) for tensor in (x, weight, scale)):
+        return None
+    q = backing[:, :512]
+    raw_key = backing[:, 512:]
+    returned = plan.op(x, weight, scale, backing)
+    returned_aliases_backing = False
+    if isinstance(returned, torch.Tensor):
+        alias_method = getattr(returned, "is_alias_of", None)
+        returned_aliases_backing = (
+            bool(alias_method(backing))
+            if callable(alias_method)
+            else bool(torch._C._is_alias_of(returned, backing))
+        )
+    if (
+        not isinstance(returned, torch.Tensor)
+        or returned.device != backing.device
+        or returned.dtype != backing.dtype
+        or returned.shape != backing.shape
+        or not returned.is_contiguous()
+        or not returned_aliases_backing
+        or returned.data_ptr() != backing.data_ptr()
+    ):
+        raise RuntimeError(
+            "Qwen3.8 QSA indexer projection returned an invalid caller-owned ABI"
+        )
+    return q, raw_key
+
+
