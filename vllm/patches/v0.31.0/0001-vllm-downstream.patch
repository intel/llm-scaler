+                conv_state.device != x_spec.device
+                or conv_weights.device != x_spec.device
+            ):
+                raise ValueError(
+                    "speculative short-conv tensors must share input device"
+                )
+            state_capacity = conv_state.shape[0] if conv_state.ndim > 0 else 0
+            self._validate_cpu_spec_metadata_values(
+                native_query_start_loc,
+                accepted_tokens,
+                spec_state_indices_tensor,
+                work_units,
+                spec_query_len,
+                state_capacity,
+            )
+            reason = self._short_conv_common_fallback_reason(
+                x_spec,
+                conv_state,
+                conv_weights,
+                spec_state_indices_tensor,
+                None,
+                self.conv_state_len + num_spec_tokens,
+            )
+            metadata_views = (
+                native_query_start_loc,
+                accepted_tokens,
+            )
+            if reason is None and any(
+                not tensor.is_contiguous() for tensor in metadata_views
+            ):
+                reason = REASON_LAYOUT
+            if reason is None and any(
+                self._tensors_alias(metadata_tensor, other)
+                for metadata_tensor in metadata_views
+                for other in (
+                    x_spec,
+                    conv_state,
+                    conv_weights,
+                    spec_state_indices_tensor,
+                )
+            ):
+                reason = REASON_OTHER_CONTRACT
+            if reason is None and self._tensors_alias(
+                native_query_start_loc, accepted_tokens
+            ):
+                reason = REASON_OTHER_CONTRACT
+            can_reuse_native_output = (
+                trusted and native_output is not None and work_units == x_spec.shape[0]
+            )
+            if (
+                reason is None
+                and forced_fallback_reason is None
+                and can_reuse_native_output
+            ):
+                reason = self._short_conv_output_fallback_reason(
+                    x_spec,
+                    native_output,
+                    native_query_start_loc,
+                    conv_state,
+                    conv_weights,
+                    spec_state_indices_tensor,
+                    accepted_tokens,
+                )
+            if transactional:
+                self._raise_if_transaction_unsafe(reason)
+
+            def fallback_call() -> _PreparedShortConvCall:
+                output = torch.zeros_like(x_spec)
+                q_starts = native_query_start_loc.to(torch.int64)
+                accepted_state = accepted_tokens.to(
+                    device=conv_state.device, dtype=torch.int64
+                )
+                converted = spec_state_indices_tensor.to(
+                    device=conv_state.device, dtype=torch.int64
+                )
+                valid_state = converted != NULL_BLOCK_ID
+                state_indices = torch.where(
+                    valid_state,
+                    converted,
+                    torch.zeros_like(converted),
+                )
+                return _PreparedShortConvCall(
+                    path,
+                    work_units,
+                    output=output,
+                    fallback_args=(
+                        num_reqs,
+                        q_starts,
+                        accepted_state,
+                        state_indices,
+                        valid_state,
+                        output,
+                    ),
+                )
+
+            if native_disabled:
+                return fallback_call()
+            if forced_fallback_reason is not None:
+                self._record_short_conv_fallback(
+                    path, work_units, forced_fallback_reason
+                )
+                return fallback_call()
+            if reason is not None:
+                self._record_short_conv_fallback(path, work_units, reason)
+                return fallback_call()
+
+            operation = self._resolve_short_conv_op(
+                path,
+                work_units,
+                ("ple_short_conv_spec_trusted" if trusted else "ple_short_conv_spec"),
+                x_spec.device,
+                trusted=trusted,
+            )
+            if operation is None:
+                return fallback_call()
+            output = (
+                native_output if can_reuse_native_output else torch.zeros_like(x_spec)
+            )
+            if trusted:
+                state_indices_native = spec_state_indices_tensor
+                null_block_id = NULL_BLOCK_ID
+            else:
+                converted = spec_state_indices_tensor.to(
+                    device=conv_state.device, dtype=torch.int64
+                )
+                state_indices_native = self._native_state_indices(converted)
+                null_block_id = -1
+        except Exception:
+            if NATIVE_STATS_ENABLED and not native_disabled:
+                NATIVE_STATS.record(path, EVENT_HARD_ERROR_PREFLIGHT, work_units)
+            raise
+
+        return _PreparedShortConvCall(
+            path,
+            work_units,
+            operation,
+            (
+                x_spec,
+                native_query_start_loc,
+                conv_state,
+                conv_weights,
+                state_indices_native,
+                accepted_tokens,
+                output,
+                num_spec_tokens,
+                self.short_conv_dilation,
+                True,
+                null_block_id,
+            ),
+            output,
+        )
