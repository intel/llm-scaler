+def _try_hc_combine_norm_multi_m(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    combine_output: torch.Tensor | None,
+    output: torch.Tensor | None,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    if hidden_states.ndim != 2 or not _is_hc_multi_m_rows(int(hidden_states.shape[0])):
+        return None
+    if (
+        _hc_combine_norm_multi_m_input_fallback_reason(
+            hidden_states, block_output, injection, weight, eps, hc_count
+        )
+        is not None
+    ):
+        return None
+
+    work_units = int(hidden_states.shape[0])
+    _record_hc_combine_norm(EVENT_ATTEMPT, work_units)
+    if combine_output is None:
+        combine_output = torch.empty_like(
+            hidden_states, memory_format=torch.contiguous_format
+        )
+    if output is None:
+        output = torch.empty_like(hidden_states, memory_format=torch.contiguous_format)
+    reason = _hc_combine_norm_multi_m_fallback_reason(
+        hidden_states,
+        block_output,
+        injection,
+        weight,
+        eps,
+        hc_count,
+        combine_output,
+        output,
+    )
+    if reason is not None:
+        _record_hc_combine_norm(EVENT_FALLBACK, work_units, reason)
+        return None
+
+    _record_hc_combine_norm(EVENT_ELIGIBLE, work_units)
+    if injection.is_contiguous():
+        operation = _get_hc_combine_norm_multi_m_operation()
+        if operation is None and work_units == 4:
+            operation = _get_hc_combine_norm_m4_operation()
+    else:
+        # Older DSOs only accept contiguous injection, including their M4
+        # entry. Missing this additive symbol must fall back before submit.
+        operation = _get_hc_combine_norm_multi_m_strided_operation()
+    if operation is None:
+        _record_hc_combine_norm(EVENT_FALLBACK, work_units, REASON_OP_UNAVAILABLE)
+        return None
+
+    _record_hc_combine_norm(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            combine_output,
+            output,
+            eps,
+        )
+    except Exception:
+        _record_hc_combine_norm(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return combine_output, output
+
+
+def _hc_projection_input_fallback_reason(
+    x: torch.Tensor,
+    down_weight: torch.Tensor | None,
+    up_weight: torch.Tensor | None,
+    hc_count: int,
+    merged: bool,
+) -> int | None:
+    if (
+        envs.VLLM_XPU_DISABLE_QWEN38_HC_PROJECTION_NATIVE
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_PROJECTION_NATIVE
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if not isinstance(down_weight, torch.Tensor) or not isinstance(
+        up_weight, torch.Tensor
+    ):
+        return REASON_OTHER_CONTRACT
+    if type(merged) is not bool or hc_count != _HC_PROJECTION_COUNT:
+        return REASON_OTHER_CONTRACT
+    down_width = _HC_PROJECTION_MERGED_WIDTH if merged else _HC_PROJECTION_RANK
+    if (
+        x.shape != (1, _HC_PROJECTION_WIDTH)
+        or down_weight.shape != (down_width, _HC_PROJECTION_WIDTH)
+        or up_weight.shape != (_HC_PROJECTION_WIDTH, _HC_PROJECTION_RANK)
+    ):
+        return REASON_SHAPE
+    inputs = (x, down_weight, up_weight)
+    if any(tensor.dtype != torch.float16 for tensor in inputs):
+        return REASON_DTYPE
+    if x.device.type != "xpu" or any(
+        tensor.device != x.device for tensor in inputs[1:]
+    ):
+        return REASON_DEVICE
+    if any(
+        not tensor.is_contiguous() or not _is_four_byte_aligned_fp16_view(tensor)
+        for tensor in inputs
+    ):
+        return REASON_LAYOUT
+    if any(
+        _tensors_alias(first, second)
+        for index, first in enumerate(inputs)
+        for second in inputs[index + 1 :]
+    ):
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def _hc_projection_native_fallback_reason(
+    x: torch.Tensor,
+    down_weight: torch.Tensor | None,
+    up_weight: torch.Tensor | None,
+    down_output: torch.Tensor | None,
+    up_output: torch.Tensor | None,
+    hc_count: int,
+    merged: bool,
+) -> int | None:
+    reason = _hc_projection_input_fallback_reason(
+        x,
+        down_weight,
+        up_weight,
+        hc_count,
+        merged,
+    )
+    if reason is not None:
+        return reason
+    assert isinstance(down_weight, torch.Tensor)
+    assert isinstance(up_weight, torch.Tensor)
+    if not isinstance(down_output, torch.Tensor) or not isinstance(
+        up_output, torch.Tensor
+    ):
+        return REASON_OTHER_CONTRACT
+    down_width = _HC_PROJECTION_MERGED_WIDTH if merged else _HC_PROJECTION_RANK
+    if down_output.shape != (1, down_width) or up_output.shape != (
+        1,
+        _HC_PROJECTION_WIDTH,
+    ):
+        return REASON_SHAPE
+    outputs = (down_output, up_output)
+    if any(tensor.dtype != x.dtype for tensor in outputs):
+        return REASON_DTYPE
+    if any(tensor.device != x.device for tensor in outputs):
+        return REASON_DEVICE
+    if any(
+        not tensor.is_contiguous() or not _is_four_byte_aligned_fp16_view(tensor)
+        for tensor in outputs
+    ):
+        return REASON_LAYOUT
+    inputs = (x, down_weight, up_weight)
+    if any(
+        _tensors_alias(output_tensor, input_tensor)
+        for output_tensor in outputs
+        for input_tensor in inputs
+    ) or _tensors_alias(down_output, up_output):
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def should_prepare_hc_projection_outputs(
+    x: torch.Tensor,
+    down_weight: torch.Tensor | None,
+    up_weight: torch.Tensor | None,
+    hc_count: int,
+    merged: bool,
+) -> bool:
+    """Return whether the caller should allocate both projection outputs."""
+    try:
+        return (
+            _hc_projection_input_fallback_reason(
+                x,
+                down_weight,
+                up_weight,
+                hc_count,
+                merged,
+            )
+            is None
+        )
+    except Exception:
+        return False
+
+
+def _get_hc_projection_operations():
+    global _HC_PROJECTION_OPERATIONS
+    global _HC_PROJECTION_OPERATIONS_RESOLVED
+
+    if not _HC_PROJECTION_OPERATIONS_RESOLVED:
+        try:
+            down_operation = get_qwen38_hc_op(_HC_PROJECTION_DOWN_OP_NAME)
+        except Qwen38HCOpUnavailableError:
+            down_operation = None
+        try:
+            up_operation = get_qwen38_hc_op(_HC_PROJECTION_UP_OP_NAME)
+        except Qwen38HCOpUnavailableError:
+            up_operation = None
+        _HC_PROJECTION_OPERATIONS = (down_operation, up_operation)
+        _HC_PROJECTION_OPERATIONS_RESOLVED = True
+    return _HC_PROJECTION_OPERATIONS
+
+
+def try_hc_projection_native(
+    x: torch.Tensor,
+    down_weight: torch.Tensor | None,
+    up_weight: torch.Tensor | None,
+    down_output: torch.Tensor | None,
+    up_output: torch.Tensor | None,
+    hc_count: int,
+    *,
+    merged: bool,
+) -> tuple[torch.Tensor, torch.Tensor | None] | None:
+    """Run the fixed HC down+SiLU and up GEMVs as one transaction."""
+    work_units = int(x.shape[0]) if x.ndim else 1
+    if x.numel() == 0:
+        _record_hc_projection(EVENT_ZERO_WORK_SKIP, 0)
+        return None
+
+    _record_hc_projection(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_projection_native_fallback_reason(
+            x,
+            down_weight,
+            up_weight,
+            down_output,
+            up_output,
+            hc_count,
+            merged,
+        )
+    except Exception:
+        _record_hc_projection(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_projection(EVENT_FALLBACK, work_units, reason)
+        return None
+
+    _record_hc_projection(EVENT_ELIGIBLE, work_units)
+    try:
+        operations = _get_hc_projection_operations()
+    except Exception:
+        _record_hc_projection(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    assert operations is not None
+    down_operation, up_operation = operations
+    if down_operation is None or up_operation is None:
+        _record_hc_projection(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return None
+
+    assert isinstance(down_weight, torch.Tensor)
+    assert isinstance(up_weight, torch.Tensor)
+    assert isinstance(down_output, torch.Tensor)
+    assert isinstance(up_output, torch.Tensor)
+    lora = down_output[:, :_HC_PROJECTION_RANK]
+    injection = (
+        down_output[
+            :,
+            _HC_PROJECTION_RANK : _HC_PROJECTION_RANK + _HC_PROJECTION_COUNT,
+        ]
+        if merged
+        else None
+    )
+    _record_hc_projection(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        down_operation(x, down_weight, down_output)
+        up_operation(lora, up_weight, up_output)
+    except Exception:
+        _record_hc_projection(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return up_output, injection
+
+
+def hc_silu(x: torch.Tensor, hc_count: int) -> torch.Tensor:
+    """SiLU applied to the low-rank gate pre-activation scaled by ``1/HC``."""
+    return F.silu(x / hc_count)
+
+
+def _hc_combine_torch(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+) -> torch.Tensor:
+    hidden_size = block_output.shape[-1]
+    injection_weight = 2.0 * torch.sigmoid(injection.float() / hc_count)
+    residual = hidden_states.float().unflatten(-1, (hc_count, hidden_size))
+    combined = residual + block_output.float().unsqueeze(-2) * (
+        injection_weight.unsqueeze(-1)
+    )
+    return combined.flatten(-2).to(hidden_states.dtype)
+
+
+def hc_combine(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+    *,
+    output: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Inject a block output with an optional native output buffer."""
+    work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+    prefill = _try_hc_prefill(
+        "combine", hidden_states, (block_output, injection), hc_count, (output,)
+    )
+    if prefill is not None:
+        return prefill[0]
+    if hidden_states.numel() == 0:
+        _record_hc_combine(EVENT_ZERO_WORK_SKIP, 0)
+        return _hc_combine_torch(hidden_states, block_output, injection, hc_count)
+
+    _record_hc_combine(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_combine_native_fallback_reason(
+            hidden_states,
+            block_output,
+            injection,
+            hc_count,
+            output,
+        )
+    except Exception:
+        _record_hc_combine(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_combine(EVENT_FALLBACK, work_units, reason)
+        return _hc_combine_torch(hidden_states, block_output, injection, hc_count)
+
+    _record_hc_combine(EVENT_ELIGIBLE, work_units)
+    try:
+        operation = _get_hc_combine_operation()
+    except Exception:
+        _record_hc_combine(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if operation is None:
+        _record_hc_combine(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return _hc_combine_torch(hidden_states, block_output, injection, hc_count)
+
+    assert output is not None
+    _record_hc_combine(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(hidden_states, block_output, injection, output)
+    except Exception:
+        _record_hc_combine(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return output
+
+
+def _hc_combine_norm_sequential(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    combine_output: torch.Tensor | None,
+    output: torch.Tensor | None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    combined = hc_combine(
+        hidden_states,
+        block_output,
+        injection,
+        hc_count,
+        output=combine_output,
+    )
+    normed = grouped_gemma_rmsnorm(
+        combined,
+        weight,
+        eps,
+        hc_count,
+        output=output,
+    )
+    return combined, normed
+
+
+def hc_combine_norm(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    *,
+    combine_output: torch.Tensor | None = None,
+    output: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Fuse HC combine and grouped RMSNorm when the fixed ABI is eligible."""
+    dense = _try_hc_dense(
+        "combine_norm",
+        hidden_states,
+        (block_output, injection, weight),
+        hc_count,
+        (combine_output, output),
+        eps,
+    )
+    if dense is not None:
+        return dense
+    work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+    prefill = _try_hc_prefill(
+        "combine_norm",
+        hidden_states,
+        (block_output, injection, weight),
+        hc_count,
+        (combine_output, output),
+        eps,
+    )
+    if prefill is not None:
+        return prefill
+    if hidden_states.numel() == 0:
+        _record_hc_combine_norm(EVENT_ZERO_WORK_SKIP, 0)
+        return _hc_combine_norm_sequential(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            eps,
+            hc_count,
+            combine_output,
+            output,
+        )
+
+    multi_outputs = _try_hc_combine_norm_multi_m(
+        hidden_states,
+        block_output,
+        injection,
+        weight,
+        eps,
+        hc_count,
+        combine_output,
+        output,
+    )
+    if multi_outputs is not None:
+        return multi_outputs
+
+    _record_hc_combine_norm(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_combine_norm_native_fallback_reason(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            eps,
+            hc_count,
+            combine_output,
+            output,
+        )
+    except Exception:
+        _record_hc_combine_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_combine_norm(EVENT_FALLBACK, work_units, reason)
+        return _hc_combine_norm_sequential(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            eps,
+            hc_count,
+            combine_output,
+            output,
+        )
+
+    _record_hc_combine_norm(EVENT_ELIGIBLE, work_units)
+    try:
+        operation = _get_hc_combine_norm_operation()
+    except Exception:
+        _record_hc_combine_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if operation is None:
+        _record_hc_combine_norm(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return _hc_combine_norm_sequential(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            eps,
+            hc_count,
+            combine_output,
+            output,
+        )
+
+    assert combine_output is not None
+    assert output is not None
+    _record_hc_combine_norm(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            combine_output,
+            output,
+            eps,
+        )
+    except Exception:
+        _record_hc_combine_norm(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return combine_output, output
+
+
+__all__ = [
+    "grouped_gemma_rmsnorm",
+    "hc_combine",
+    "hc_combine_norm",
+    "hc_gate_mix",
+    "hc_silu",
+    "should_prepare_hc_combine_output",
+    "should_prepare_hc_projection_outputs",
+    "try_hc_projection_native",
+    "try_hc_dense_down",
+    "should_prepare_hc_combine_norm_outputs",
+    "should_prepare_hc_gate_mix_output",
+    "should_prepare_hc_grouped_norm_output",
+]
