+            embedding = owner.ngram_embedding
+            shard_indices = embedding.shard_indices
+            local_start = int(shard_indices.org_vocab_start_index)
+            local_end = int(shard_indices.org_vocab_end_index)
+            tp_size = embedding.tp_size
+            local_rows = (
+                _QWEN38_PADDED_VOCAB_SIZE // tp_size if tp_size in (4, 8) else 0
+            )
+            valid_starts = range(
+                0,
+                _QWEN38_PADDED_VOCAB_SIZE,
