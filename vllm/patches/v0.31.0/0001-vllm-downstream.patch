+def _hc_combine_norm_multi_m_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> int | None:
+    if getattr(
+        envs,
+        "VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NORM_MULTI_M_NATIVE",
+        False,
+    ) or not getattr(
+        envs,
+        "VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NORM_MULTI_M_NATIVE",
+        False,
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or not _is_hc_multi_m_rows(int(hidden_states.shape[0]))
+        or hidden_states.shape[1] != _HC_COMBINE_WIDTH
+        or block_output.shape != (hidden_states.shape[0], _HC_COMBINE_HIDDEN_SIZE)
+        or injection.shape != (hidden_states.shape[0], _HC_COMBINE_COUNT)
+        or weight.shape != (_HC_COMBINE_WIDTH,)
+        or hc_count != _HC_COMBINE_COUNT
+    ):
+        return REASON_SHAPE
+    if any(
+        tensor.dtype != torch.float16
+        for tensor in (hidden_states, block_output, injection, weight)
+    ):
+        return REASON_DTYPE
+    eps_value = float(eps)
+    if (
+        not math.isfinite(eps_value)
+        or eps_value < _HC_FP32_MIN_POSITIVE
+        or eps_value > _HC_FP32_MAX
+    ):
+        return REASON_OTHER_CONTRACT
+    if hidden_states.device.type != "xpu" or any(
+        tensor.device != hidden_states.device
+        for tensor in (block_output, injection, weight)
+    ):
+        return REASON_DEVICE
+    if any(
+        not tensor.is_contiguous() or not _is_four_byte_aligned_fp16_view(tensor)
+        for tensor in (hidden_states, block_output, weight)
+    ) or (
+        # Merged HC down projections expose injection as [:, 320:324]
+        # of [M,336]. Read the row stride directly; do not copy per layer.
+        injection.stride(1) != 1
+        or injection.stride(0) < _HC_COMBINE_COUNT
+        or not _is_four_byte_aligned_fp16_view(injection)
+    ):
+        return REASON_LAYOUT
+    return None
