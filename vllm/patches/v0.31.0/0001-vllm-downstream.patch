+            # [0, max_model_len). Equal row counts alone do not prove bounds
+            # when VLLM_ALLOW_LONG_MAX_MODEL_LEN permits a larger context than
+            # the RoPE cache. XDRoPE positions need a separate value witness.
+            max_model_len = getattr(self, "max_model_len", None)
+            return bool(
+                num_model_tokens is not None
+                and num_tokens > 0
+                and num_tokens == num_model_tokens
+                and not getattr(self, "uses_xdrope_dim", 0)
+                and type(max_model_len) is int
