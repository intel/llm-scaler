+    def _qwen38_moe_m1_input_fallback_reason(
+        self, hidden_states: torch.Tensor
+    ) -> int | None:
+        if (
+            envs.VLLM_XPU_DISABLE_QWEN38_MOE_M1_ASYMMETRIC_NATIVE
+            or not envs.VLLM_XPU_ENABLE_QWEN38_MOE_M1_ASYMMETRIC_NATIVE
+        ):
+            return REASON_DISABLED
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if hidden_states.device.type != "xpu":
+            return REASON_DEVICE
+        if hidden_states.dtype != torch.float16:
+            return REASON_DTYPE
+        if tuple(hidden_states.shape) != (1, _QWEN38_MOE_M1_HIDDEN_SIZE):
+            return REASON_SHAPE
+        if not hidden_states.is_contiguous() or hidden_states.data_ptr() % 16 != 0:
+            return REASON_LAYOUT
+        if (
+            getattr(self, "tp_size", None) not in (4, _QWEN38_MOE_M1_TP_SIZE)
+            or getattr(self, "ep_size", None) != 1
+            or getattr(self, "enable_eplb", False)
+            or getattr(self, "is_sequence_parallel", False)
+            or getattr(self, "n_routed_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_logical_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_physical_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_local_physical_experts", None)
+            != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_redundant_experts", None) != 0
+            or getattr(self, "n_shared_experts", None) != 1
+        ):
+            return REASON_TP_GEOMETRY
+        return None
+
+    def _qwen38_moe_multi_m_input_fallback_reason(
+        self, hidden_states: torch.Tensor
+    ) -> int | None:
+        if (
+            envs.VLLM_XPU_DISABLE_QWEN38_MOE_MULTI_M_ASYMMETRIC_NATIVE
+            or not envs.VLLM_XPU_ENABLE_QWEN38_MOE_MULTI_M_ASYMMETRIC_NATIVE
+        ):
+            return REASON_DISABLED
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if hidden_states.device.type != "xpu":
+            return REASON_DEVICE
+        if hidden_states.dtype != torch.float16:
+            return REASON_DTYPE
+        if (
+            hidden_states.ndim != 2
+            or not _QWEN38_MOE_MULTI_M_MIN_TOKENS
+            <= hidden_states.shape[0]
+            <= _QWEN38_MOE_MULTI_M_MAX_TOKENS
+            or hidden_states.shape[1] != _QWEN38_MOE_M1_HIDDEN_SIZE
+        ):
+            return REASON_SHAPE
+        if not hidden_states.is_contiguous() or hidden_states.data_ptr() % 16 != 0:
+            return REASON_LAYOUT
+        if (
+            getattr(self, "tp_size", None) not in (4, _QWEN38_MOE_M1_TP_SIZE)
+            or getattr(self, "ep_size", None) != 1
+            or getattr(self, "enable_eplb", False)
+            or getattr(self, "is_sequence_parallel", False)
+            or getattr(self, "n_routed_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_logical_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_physical_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_local_physical_experts", None)
+            != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(self, "n_redundant_experts", None) != 0
+            or getattr(self, "n_shared_experts", None) != 1
+        ):
+            return REASON_TP_GEOMETRY
+        return None
+
+    def _qwen38_moe_m1_sources_fallback_reason(
+        self, sources: "_Qwen38MoeSources | None"
+    ) -> int | None:
+        if sources is None:
+            return REASON_OTHER_CONTRACT
+        compact_size = compact_intermediate(
+            getattr(sources.routed_experts, "w13_weight", None)
+        )
+        tp4 = getattr(self, "tp_size", None) == 4
+        if tp4 and compact_size != 160:
+            return REASON_TP_GEOMETRY
+        moe_config = getattr(sources.experts, "moe_config", None)
+        activation = getattr(moe_config, "activation", None)
+        router = getattr(sources.experts, "router", None)
+        if (
+            type(router) is not FusedTopKRouter
+            or getattr(router, "top_k", None) != _QWEN38_MOE_M1_TOP_K
+            or getattr(router, "global_num_experts", None) != _QWEN38_MOE_M1_NUM_EXPERTS
+            or getattr(router, "scoring_func", None) != "softmax"
+            or getattr(router, "renormalize", None) is not True
+            or getattr(router, "eplb_state", None) is not None
+            or getattr(sources.experts, "routed_input_transform", None) is not None
+            or getattr(sources.experts, "routed_output_transform", None) is not None
+            or getattr(sources.experts, "routed_scaling_factor", 1.0) != 1.0
+            or getattr(sources.experts, "enable_dbo", False)
+        ):
+            return REASON_OTHER_CONTRACT
+        if (
+            # The legacy caller supplies sources.gate logits; the hostchain
+            # computes the same logits from gate.weight_esimd. In both cases
+            # the raw MoE ABI owns top-k and the runner marker does not cause
+            # double routing.
+            getattr(moe_config, "experts_per_token", None) != _QWEN38_MOE_M1_TOP_K
+            or getattr(moe_config, "intermediate_size", None)
+            != _QWEN38_MOE_M1_ROUTED_GLOBAL
+            or getattr(moe_config, "intermediate_size_per_partition", None)
+            != (160 if tp4 else _QWEN38_MOE_M1_ROUTED_LOGICAL)
+            or getattr(activation, "value", activation) != "silu"
+            or getattr(moe_config, "has_bias", False)
+            or getattr(moe_config, "skip_final_all_reduce", False)
+            or getattr(
+                sources.routed_experts,
+                "_int4_intermediate_size_padded",
+                None,
+            )
+            != (compact_size or _QWEN38_MOE_M1_ROUTED_PHYSICAL)
+        ):
+            return REASON_TP_GEOMETRY
+        if any(
+            getattr(layer, "bias", None) is not None
+            for layer in (
+                sources.gate,
+                sources.shared_gate_up_proj,
+                sources.shared_down_proj,
+                sources.shared_expert_gate,
+            )
+        ):
+            return REASON_OTHER_CONTRACT
+        method = getattr(sources.routed_experts, "quant_method", None)
+        if not (
+            getattr(method, "is_sym_int4", False)
+            and callable(getattr(method, "get_xpu_fused_moe_impl", None))
+        ):
+            return REASON_OTHER_CONTRACT
+        return None
+
+    @staticmethod
+    def _qwen38_moe_m1_router_hostchain_sources(
+        sources: "_Qwen38MoeSources",
+        device: torch.device,
+        *,
+        native_preflight: bool = False,
+    ) -> tuple[torch.Tensor, torch.Tensor] | None:
+        if not _QWEN38_MOE_M1_ROUTER_HOSTCHAIN_ENABLED or _int4_esimd_disabled():
+            return None
+        gate = getattr(sources, "gate", None)
+        gate_method = getattr(gate, "quant_method", None)
+        router_weight = getattr(gate, "weight_esimd", None)
+        router_scale = getattr(gate, "scale_esimd", None)
+        if (
+            type(gate) not in (ReplicatedLinear, GateLinear)
+            or "forward" in gate.__dict__
+            or type(gate_method) is not SymInt4LinearMethod
+            or getattr(gate, "bias", None) is not None
+            or not isinstance(router_weight, torch.Tensor)
+            or not isinstance(router_scale, torch.Tensor)
+        ):
+            return None
+        # Quantized GateLinear is equivalent only with every specialized tier
+        # disabled and no output cast. Recheck its mutable state on each call.
+        if type(gate) is GateLinear and (
+            getattr(gate, "out_dtype", torch.float32) not in (None, torch.float16)
+            or any(
+                getattr(gate, name, None) is not False
+                for name in (
+                    "is_unquantized",
+                    "allow_specialized_router_gemm",
+                    "allow_ll_bf16_gemm",
+                    "allow_fp32_router_gemm",
+                    "allow_bf16x3_router_gemm",
+                    "allow_cublas_router_gemm",
+                )
+            )
+        ):
+            return None
+        if native_preflight:
+            # A custom Linear forward must not be replaced by its raw weights.
+            if (
+                not getattr(gate, "_sym_int4_allow_batch_esimd", False)
+                or getattr(gate, "_int4_in_features_padded", None) != 2560
+                or os.environ.get("DISABLE_ESIMD_INT4_GEMM", "0") == "1"
+                or os.environ.get("DISABLE_GEMMA4_INT4_BATCH_ESIMD", "0") == "1"
+            ):
+                return None
+            return router_weight, router_scale
+        for tensor, shape, dtype in (
+            (
+                router_weight,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE // 2,
+                ),
+                torch.uint8,
+            ),
+            (
+                router_scale,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE // 128,
+                ),
+                torch.float16,
+            ),
+        ):
+            if (
+                _qwen38_moe_m1_tensor_fallback_reason(
+                    tensor, shape=shape, dtype=dtype, device=device
+                )
+                is not None
+            ):
+                return None
+        return router_weight, router_scale
+
+    @staticmethod
+    def _qwen38_moe_m1_plan_matches_sources(
+        plan: _Qwen38MoeM1AsymmetricPlan,
+        sources: "_Qwen38MoeSources",
+        operation: Callable[..., torch.Tensor],
+        quant_method: object,
+        impl: object,
+        w13_source: torch.Tensor,
+        w13_scale_source: torch.Tensor,
+        w2_source: torch.Tensor,
+        w2_scale_source: torch.Tensor,
+        router_weight_source: torch.Tensor | None = None,
+        router_scale_source: torch.Tensor | None = None,
+    ) -> bool:
+        return (
+            plan.operation is operation
+            and plan.routed_experts is sources.routed_experts
+            and plan.gate is sources.gate
+            and plan.shared_gate_up_proj is sources.shared_gate_up_proj
+            and plan.shared_down_proj is sources.shared_down_proj
+            and plan.shared_expert_gate is sources.shared_expert_gate
+            and plan.quant_method is quant_method
+            and plan.impl is impl
+            and plan.w13_source is w13_source
+            and _qwen38_moe_cached_weight_view_matches_source(plan.w13, w13_source)
+            and plan.w13_scale_source is w13_scale_source
+            and plan.w2_source is w2_source
+            and _qwen38_moe_cached_weight_view_matches_source(plan.w2, w2_source)
+            and plan.w2_scale_source is w2_scale_source
+            and plan.shared_w13 is sources.shared_gate_up_proj.weight
+            and plan.shared_w2 is sources.shared_down_proj.weight
+            and plan.shared_expert_gate_weight is sources.shared_expert_gate.weight
+            and getattr(plan, "router_weight_source", None) is router_weight_source
+            and getattr(plan, "router_scale_source", None) is router_scale_source
+            and (
+                router_weight_source is None
+                and getattr(plan, "router_weight", None) is None
+                or router_weight_source is not None
+                and _qwen38_moe_cached_weight_view_matches_source(
+                    getattr(plan, "router_weight", None),
+                    router_weight_source,
+                )
+            )
+            and getattr(plan, "router_scale", None) is router_scale_source
+        )
+
+    @staticmethod
+    def _qwen38_moe_m1_plan_fallback_reason(
+        plan: _Qwen38MoeM1AsymmetricPlan, device: torch.device
+    ) -> int | None:
+        # Older unit-test plans only expose the converted w13 field.  Real
+        # cached plans always carry w13_source, but keep this checker tolerant
+        # of the legacy lightweight fixture shape.
+        w13_source = getattr(plan, "w13_source", getattr(plan, "w13", None))
+        compact = compact_intermediate(w13_source)
+        physical = compact or _QWEN38_MOE_M1_ROUTED_PHYSICAL
+        shared_size = 160 if compact == 160 else _QWEN38_MOE_M1_SHARED
+        router_weight = getattr(plan, "router_weight", None)
+        router_scale = getattr(plan, "router_scale", None)
+        if (router_weight is None) != (router_scale is None):
+            return REASON_OTHER_CONTRACT
+        if _MOE_BATCHED_PREFLIGHT and device.type == "xpu":
+            operations = (
+                ((compact160_ops() if compact == 160 else compact80_ops())[3],)
+                if compact
+                else _moe_metadata_operations()
+            )
+            weights = (
+                plan.w13,
+                plan.w13_scale,
+                plan.w2,
+                plan.w2_scale,
+                plan.shared_w13,
+                plan.shared_w2,
+                plan.shared_expert_gate_weight,
+            )
+            if operations is not None and all(
+                isinstance(weight, torch.Tensor) for weight in weights
+            ):
+                status = operations[0](weights, device)
+                if not 0 <= status < len(_MOE_WEIGHT_CONTRACT_REASONS):
+                    raise RuntimeError("invalid MoE weight preflight status")
+                reason = _MOE_WEIGHT_CONTRACT_REASONS[status]
+                if reason is not None:
+                    return reason
+                return (
+                    None
+                    if plan.experts_per_token == _QWEN38_MOE_M1_TOP_K
+                    else REASON_TP_GEOMETRY
+                )
+        specs = (
+            (
+                plan.w13,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    2 * physical,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE // 2,
+                ),
+                torch.uint8,
+            ),
+            (
+                plan.w13_scale,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    2 * physical,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE // 128,
+                ),
+                torch.float16,
+            ),
+            (
+                plan.w2,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE,
+                    physical // 2,
+                ),
+                torch.uint8,
+            ),
+            (
+                plan.w2_scale,
+                (
+                    _QWEN38_MOE_M1_NUM_EXPERTS,
+                    _QWEN38_MOE_M1_HIDDEN_SIZE,
+                    (physical + 127) // 128,
+                ),
+                torch.float16,
+            ),
+            (
+                plan.shared_w13,
+                (2 * shared_size, _QWEN38_MOE_M1_HIDDEN_SIZE),
+                torch.float16,
+            ),
+            (
+                plan.shared_w2,
+                (_QWEN38_MOE_M1_HIDDEN_SIZE, shared_size),
+                torch.float16,
+            ),
+            (
+                plan.shared_expert_gate_weight,
+                (1, _QWEN38_MOE_M1_HIDDEN_SIZE),
+                torch.float16,
+            ),
+        )
+        for tensor, shape, dtype in specs:
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                tensor, shape=shape, dtype=dtype, device=device
+            )
+            if reason is not None:
+                return reason
+        if plan.experts_per_token != _QWEN38_MOE_M1_TOP_K:
+            return REASON_TP_GEOMETRY
+        return None
+
+    def _prepare_qwen38_moe_asymmetric_plan(
+        self,
+        sources: "_Qwen38MoeSources",
+        operation: Callable[..., torch.Tensor],
+        device: torch.device,
+        *,
+        cache_name: str,
+        router_weight_source: torch.Tensor | None = None,
+        router_scale_source: torch.Tensor | None = None,
+    ) -> tuple[_Qwen38MoeM1AsymmetricPlan | None, int | None]:
+        method = sources.routed_experts.quant_method
+        experts_per_token = sources.experts.moe_config.experts_per_token
+        impl = method.get_xpu_fused_moe_impl(sources.routed_experts, experts_per_token)
+        # Dynamic quantization implementations cross this boundary as Any;
+        # the unchanged batched Tensor guard below validates all four fields.
+        w13_source: Any = getattr(impl, "w13", None)
+        w13_scale_source: Any = getattr(impl, "gemm1_wei_scales", None)
+        w2_source: Any = getattr(impl, "w2", None)
+        w2_scale_source: Any = getattr(impl, "gemm2_wei_scales", None)
+        if w13_scale_source is None:
+            w13_scale_source = getattr(sources.routed_experts, "w13_scales", None)
+        if w2_scale_source is None:
+            w2_scale_source = getattr(sources.routed_experts, "w2_scales", None)
+        if not all(
+            isinstance(tensor, torch.Tensor)
+            for tensor in (
+                w13_source,
+                w13_scale_source,
+                w2_source,
+                w2_scale_source,
+            )
+        ):
+            return None, REASON_OTHER_CONTRACT
+
+        plan = getattr(self, cache_name, None)
+        if plan is not None and self._qwen38_moe_m1_plan_matches_sources(
+            plan,
+            sources,
+            operation,
+            method,
+            impl,
+            w13_source,
+            w13_scale_source,
+            w2_source,
+            w2_scale_source,
+            router_weight_source,
+            router_scale_source,
+        ):
+            return plan, self._qwen38_moe_m1_plan_fallback_reason(plan, device)
+
+        w13 = w13_source
+        w2 = w2_source
+        if w13.dtype == torch.int8:
+            w13 = w13.view(torch.uint8)
+        if w2.dtype == torch.int8:
+            w2 = w2.view(torch.uint8)
+        candidate = _Qwen38MoeM1AsymmetricPlan(
+            operation=operation,
+            routed_experts=sources.routed_experts,
+            gate=sources.gate,
+            shared_gate_up_proj=sources.shared_gate_up_proj,
+            shared_down_proj=sources.shared_down_proj,
+            shared_expert_gate=sources.shared_expert_gate,
+            quant_method=method,
+            impl=impl,
+            w13_source=w13_source,
+            w13_scale_source=w13_scale_source,
+            w2_source=w2_source,
+            w2_scale_source=w2_scale_source,
+            w13=w13,
+            w13_scale=w13_scale_source,
+            w2=w2,
+            w2_scale=w2_scale_source,
+            shared_w13=sources.shared_gate_up_proj.weight,
+            shared_w2=sources.shared_down_proj.weight,
+            shared_expert_gate_weight=sources.shared_expert_gate.weight,
+            experts_per_token=experts_per_token,
+            router_weight_source=router_weight_source,
+            router_scale_source=router_scale_source,
+            router_weight=router_weight_source,
+            router_scale=router_scale_source,
+        )
+        reason = self._qwen38_moe_m1_plan_fallback_reason(candidate, device)
+        if reason is not None:
+            return None, reason
+        if compact_intermediate(w13_source):
+            logger.info_once(
+                "compact%d native MoE plan enabled: %s",
+                compact_intermediate(w13_source),
+                cache_name,
+            )
+        setattr(self, cache_name, candidate)
+        return candidate, None
+
+    def _prepare_qwen38_moe_m1_asymmetric_plan(
+        self,
+        sources: "_Qwen38MoeSources",
+        operation: Callable[..., torch.Tensor],
+        device: torch.device,
+        *,
+        router_weight_source: torch.Tensor | None = None,
+        router_scale_source: torch.Tensor | None = None,
+    ) -> tuple[_Qwen38MoeM1AsymmetricPlan | None, int | None]:
+        return self._prepare_qwen38_moe_asymmetric_plan(
+            sources,
+            operation,
+            device,
+            cache_name="_qwen38_moe_m1_asymmetric_plan",
+            router_weight_source=router_weight_source,
+            router_scale_source=router_scale_source,
+        )
+
+    def _prepare_qwen38_moe_multi_m_asymmetric_plan(
+        self,
+        sources: "_Qwen38MoeSources",
+        operation: Callable[..., torch.Tensor],
+        device: torch.device,
+    ) -> tuple[_Qwen38MoeM1AsymmetricPlan | None, int | None]:
+        return self._prepare_qwen38_moe_asymmetric_plan(
+            sources,
+            operation,
+            device,
+            cache_name="_qwen38_moe_multi_m_asymmetric_plan",
+        )
+
+    def _get_qwen38_moe_m1_asymmetric_output(
+        self,
+        hidden_states: torch.Tensor,
+        plan: _Qwen38MoeM1AsymmetricPlan,
+    ) -> torch.Tensor:
+        stream = torch.xpu.current_stream(device=hidden_states.device)
+        stream_device = torch.device(stream.device)
+        if stream_device != hidden_states.device:
+            raise RuntimeError(
+                "Qwen3.8 M=1 asymmetric MoE stream does not match input device"
+            )
+        key = (hidden_states.device, stream, _QWEN38_MOE_M1_GEOMETRY)
+        outputs = getattr(self, "_qwen38_moe_m1_asymmetric_outputs", None)
+        if outputs is None:
+            outputs = {}
+            self._qwen38_moe_m1_asymmetric_outputs = outputs
+        output = outputs.get(key)
+        if output is None:
+            candidate = torch.empty(
+                (1, _QWEN38_MOE_M1_HIDDEN_SIZE),
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                candidate,
+                shape=(1, _QWEN38_MOE_M1_HIDDEN_SIZE),
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            if reason is not None:
+                raise RuntimeError(
+                    "Qwen3.8 M=1 asymmetric MoE output allocation violated its "
+                    "fixed tensor contract"
+                )
+            output = candidate
+            outputs[key] = output
+        else:
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                output,
+                shape=(1, _QWEN38_MOE_M1_HIDDEN_SIZE),
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            if reason is not None:
+                raise RuntimeError(
+                    "Qwen3.8 M=1 asymmetric MoE output cache is inconsistent"
+                )
+
+        inputs: tuple[torch.Tensor, ...] = (
+            hidden_states,
+            plan.w13,
+            plan.w13_scale,
+            plan.w2,
+            plan.w2_scale,
+            plan.shared_w13,
+            plan.shared_w2,
+            plan.shared_expert_gate_weight,
+        )
+        router_weight = getattr(plan, "router_weight", None)
+        router_scale = getattr(plan, "router_scale", None)
+        if router_weight is not None and router_scale is not None:
+            inputs += (router_weight, router_scale)
+        if _qwen38_moe_m1_aliases(output, inputs):
+            raise RuntimeError(
+                "Qwen3.8 M=1 asymmetric MoE output aliases an input tensor"
+            )
+        return output
+
+    def _get_qwen38_moe_multi_m_asymmetric_output(
+        self,
+        hidden_states: torch.Tensor,
+        plan: _Qwen38MoeM1AsymmetricPlan,
+    ) -> torch.Tensor:
+        stream = torch.xpu.current_stream(device=hidden_states.device)
+        stream_device = torch.device(stream.device)
+        if stream_device != hidden_states.device:
+            raise RuntimeError(
+                "Qwen3.8 M=2..32 asymmetric MoE stream does not match input device"
+            )
+        n_tokens = int(hidden_states.shape[0])
+        key = (
+            hidden_states.device,
+            stream,
+            n_tokens,
+            _QWEN38_MOE_MULTI_M_GEOMETRY,
+        )
+        outputs = getattr(self, "_qwen38_moe_multi_m_asymmetric_outputs", None)
+        if outputs is None:
+            outputs = {}
+            self._qwen38_moe_multi_m_asymmetric_outputs = outputs
+        output = outputs.get(key)
+        shape = (n_tokens, _QWEN38_MOE_M1_HIDDEN_SIZE)
+        if output is None:
+            candidate = torch.empty(
+                shape,
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                candidate,
+                shape=shape,
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            if reason is not None:
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE output allocation violated "
+                    "its fixed tensor contract"
+                )
+            output = candidate
+            outputs[key] = output
+        else:
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                output,
+                shape=shape,
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            if reason is not None:
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE output cache is inconsistent"
+                )
+
+        inputs = (
+            hidden_states,
+            plan.w13,
+            plan.w13_scale,
+            plan.w2,
+            plan.w2_scale,
+            plan.shared_w13,
+            plan.shared_w2,
+            plan.shared_expert_gate_weight,
+        )
+        if _qwen38_moe_m1_aliases(output, inputs):
+            raise RuntimeError(
+                "Qwen3.8 M=2..32 asymmetric MoE output aliases an input tensor"
+            )
+        return output
+
+    def _forward_qwen38_moe_m1_asymmetric(
+        self, hidden_states: torch.Tensor
+    ) -> torch.Tensor | None:
+        work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+        _record_qwen38_moe_m1_asymmetric(EVENT_ATTEMPT, work_units)
+        try:
+            reason = self._qwen38_moe_m1_input_fallback_reason(hidden_states)
+            if reason is not None:
+                _record_qwen38_moe_m1_asymmetric(EVENT_FALLBACK, work_units, reason)
+                return None
+
+            sources = self._get_esimd_moe_sources()
+            reason = self._qwen38_moe_m1_sources_fallback_reason(sources)
+            if reason is not None:
+                _record_qwen38_moe_m1_asymmetric(EVENT_FALLBACK, work_units, reason)
+                return None
+            assert sources is not None
+
+            router_weight_source = None
+            router_scale_source = None
+            routed_w13_weight = getattr(sources.routed_experts, "w13_weight", None)
+            compact = compact_intermediate(routed_w13_weight)
+            try:
+                if compact == 160:
+                    router_sources = self._qwen38_moe_m1_router_hostchain_sources(
+                        sources, hidden_states.device
+                    )
+                    operation = compact160_ops()[0]
+                    if router_sources is not None:
+                        operation = compact160_ops()[4]
+                        router_weight_source, router_scale_source = router_sources
+                elif compact:
+                    router_sources = (
+                        self._qwen38_moe_m1_router_hostchain_sources(
+                            sources, hidden_states.device
+                        )
+                        if _QWEN38_MOE_M1_ROUTER_HOSTCHAIN_ENABLED
+                        else None
+                    )
+                    if router_sources is not None:
+                        try:
+                            operation = get_qwen38_moe_m1_router_hostchain_op()
+                        except Qwen38MoeM1RouterHostchainOpUnavailableError:
+                            operation = compact80_ops()[0]
+                        else:
+                            router_weight_source, router_scale_source = router_sources
+                    else:
+                        operation = compact80_ops()[0]
+                else:
+                    operation = get_qwen38_moe_m1_asymmetric_op()
+            except Qwen38MoeM1AsymmetricOpUnavailableError:
+                _record_qwen38_moe_m1_asymmetric(
+                    EVENT_FALLBACK, work_units, REASON_DSO_NOT_CONFIGURED
+                )
+                return None
+
+            plan, reason = self._prepare_qwen38_moe_m1_asymmetric_plan(
+                sources,
+                operation,
+                hidden_states.device,
+                router_weight_source=router_weight_source,
+                router_scale_source=router_scale_source,
+            )
+            if reason is not None:
+                _record_qwen38_moe_m1_asymmetric(EVENT_FALLBACK, work_units, reason)
+                return None
+            assert plan is not None
+            router_logits = None
+            if plan.router_weight is None:
+                # Preserve legacy stream ordering: gate() is allowed to
+                # change the current stream, so output allocation must remain
+                # after gate() and router-logit validation.
+                router_result = sources.gate(hidden_states)
+                if not isinstance(router_result, tuple) or len(router_result) != 2:
+                    raise RuntimeError(
+                        "Qwen3.8 M=1 asymmetric MoE router returned an invalid result"
+                    )
+                router_logits = router_result[0]
+                reason = _qwen38_moe_m1_tensor_fallback_reason(
+                    router_logits,
+                    shape=(1, _QWEN38_MOE_M1_NUM_EXPERTS),
+                    dtype=torch.float16,
+                    device=hidden_states.device,
+                )
+                if reason is not None:
+                    raise RuntimeError(
+                        "Qwen3.8 M=1 asymmetric MoE router logits violated the "
+                        "fixed tensor contract"
+                    )
+                output = self._get_qwen38_moe_m1_asymmetric_output(hidden_states, plan)
+                if _qwen38_moe_m1_aliases(output, (router_logits,)):
+                    raise RuntimeError(
+                        "Qwen3.8 M=1 asymmetric MoE output aliases router logits"
+                    )
+            else:
+                # The native hostchain consumes router logits internally and
+                # has no Python gate call whose stream change must be observed.
+                output = self._get_qwen38_moe_m1_asymmetric_output(hidden_states, plan)
+        except Exception:
+            _record_qwen38_moe_m1_asymmetric(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+            raise
+
+        _record_qwen38_moe_m1_asymmetric(EVENT_ELIGIBLE, work_units)
+        _record_qwen38_moe_m1_asymmetric(EVENT_NATIVE_SUBMITTED, work_units)
+        try:
+            if plan.router_weight is not None:
+                native_output = plan.operation(
+                    hidden_states,
+                    plan.router_weight,
+                    plan.router_scale,
+                    plan.w13,
+                    plan.w13_scale,
+                    plan.w2,
+                    plan.w2_scale,
+                    plan.shared_w13,
+                    plan.shared_w2,
+                    plan.shared_expert_gate_weight,
+                    output,
+                    plan.experts_per_token,
+                    1,
+                    self.n_routed_experts,
+                )
+            else:
+                native_output = plan.operation(
+                    hidden_states,
+                    router_logits,
+                    plan.w13,
+                    plan.w13_scale,
+                    plan.w2,
+                    plan.w2_scale,
+                    plan.shared_w13,
+                    plan.shared_w2,
+                    plan.shared_expert_gate_weight,
+                    output,
+                    plan.experts_per_token,
+                    1,
+                    self.n_routed_experts,
+                )
+            if not _qwen38_moe_matches_output_alias(native_output, output):
+                raise RuntimeError(
+                    "Qwen3.8 M=1 asymmetric MoE op violated caller-owned output ABI"
+                )
+            if self.tp_size > 1:
+                # 独立的 caller-owned 输出；未归约值到此为最后一次使用。
+                native_output = _qwen38_moe_validate_all_reduce_output(
+                    full_decode_all_reduce(
+                        native_output, fallback=tensor_model_parallel_all_reduce
+                    ),
+                    output,
+                )
+        except Exception:
+            _record_qwen38_moe_m1_asymmetric(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+            raise
+        return native_output
+
+    def _forward_qwen38_moe_multi_m_asymmetric(
+        self, hidden_states: torch.Tensor
+    ) -> torch.Tensor | None:
+        work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+        _record_qwen38_moe_multi_m_asymmetric(EVENT_ATTEMPT, work_units)
+        try:
+            reason = self._qwen38_moe_multi_m_input_fallback_reason(hidden_states)
+            if reason is not None:
+                _record_qwen38_moe_multi_m_asymmetric(
+                    EVENT_FALLBACK, work_units, reason
+                )
+                return None
+
+            sources = self._get_esimd_moe_sources()
+            reason = self._qwen38_moe_m1_sources_fallback_reason(sources)
+            if reason is not None:
+                _record_qwen38_moe_multi_m_asymmetric(
+                    EVENT_FALLBACK, work_units, reason
+                )
+                return None
+            assert sources is not None
+
+            if compact_intermediate(sources.routed_experts.w13_weight) == 160:
+                operation = compact160_ops()[1]
+            elif is_compact80(sources.routed_experts.w13_weight):
+                if (
+                    _QWEN38_MOE_COMPACT80_GROUPED_ENABLED
+                    and work_units in _QWEN38_MOE_COMPACT80_GROUPED_DEFAULT_TOKEN_COUNTS
+                ):
+                    try:
+                        operation = get_qwen38_moe_compact80_grouped_op()
+                    except Qwen38MoeCompact80GroupedOpUnavailableError:
+                        # The grouped ABI is additive.  Keep the old compact80
+                        # operator available for an older installed DSO.
+                        operation = compact80_ops()[1]
+                else:
+                    operation = compact80_ops()[1]
+            else:
+                try:
+                    operation = get_qwen38_moe_multi_m_asymmetric_op()
+                except Qwen38MoeMultiMAsymmetricOpUnavailableError:
+                    _record_qwen38_moe_multi_m_asymmetric(
+                        EVENT_FALLBACK, work_units, REASON_DSO_NOT_CONFIGURED
+                    )
+                    return None
+
+            plan, reason = self._prepare_qwen38_moe_multi_m_asymmetric_plan(
+                sources, operation, hidden_states.device
+            )
+            if reason is not None:
+                _record_qwen38_moe_multi_m_asymmetric(
+                    EVENT_FALLBACK, work_units, reason
+                )
+                return None
+            assert plan is not None
+            router_result = sources.gate(hidden_states)
+            if not isinstance(router_result, tuple) or len(router_result) != 2:
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE router returned an invalid result"
+                )
+            router_logits = router_result[0]
+            reason = _qwen38_moe_m1_tensor_fallback_reason(
+                router_logits,
+                shape=(work_units, _QWEN38_MOE_M1_NUM_EXPERTS),
+                dtype=torch.float16,
+                device=hidden_states.device,
+            )
+            if reason is not None:
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE router logits violated the "
+                    "fixed tensor contract"
+                )
+            output = self._get_qwen38_moe_multi_m_asymmetric_output(hidden_states, plan)
+            if _qwen38_moe_m1_aliases(output, (router_logits,)):
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE output aliases router logits"
+                )
+        except Exception:
+            _record_qwen38_moe_multi_m_asymmetric(
+                EVENT_HARD_ERROR_PREFLIGHT, work_units
+            )
+            raise
+
+        _record_qwen38_moe_multi_m_asymmetric(EVENT_ELIGIBLE, work_units)
+        _record_qwen38_moe_multi_m_asymmetric(EVENT_NATIVE_SUBMITTED, work_units)
+        try:
+            native_output = plan.operation(
+                hidden_states,
+                router_logits,
+                plan.w13,
+                plan.w13_scale,
+                plan.w2,
+                plan.w2_scale,
+                plan.shared_w13,
+                plan.shared_w2,
+                plan.shared_expert_gate_weight,
+                output,
+                plan.experts_per_token,
+                1,
+                self.n_routed_experts,
+            )
+            if not _qwen38_moe_matches_output_alias(native_output, output):
+                raise RuntimeError(
+                    "Qwen3.8 M=2..32 asymmetric MoE op violated caller-owned output ABI"
+                )
+            if self.tp_size > 1:
+                native_output = _qwen38_moe_validate_all_reduce_output(
+                    tensor_model_parallel_all_reduce(native_output), output
+                )
+        except Exception:
+            _record_qwen38_moe_multi_m_asymmetric(
+                EVENT_HARD_ERROR_POST_SUBMIT, work_units
+            )
+            raise
+        return native_output
+
+    def _moe_workspace_sources(self, hidden_states: torch.Tensor):
+        live = (
+            _DIRECT_WORKSPACE
+            and using_qwen38_sycl()
+            and standard_direct_parameters(hidden_states)
+        )
+        sources = (
+            self._get_esimd_moe_sources(refresh_weight_bindings=False)
+            if live
+            else self._get_esimd_moe_sources()
+        )
+        return sources, live
+
+    @staticmethod
+    def _moe_workspace_weights(sources, live_bindings: bool):
+        routed = sources.routed_experts
+        method = routed.quant_method
+        if live_bindings:
+            if type(method) is not SymInt4MoEMethod:
+                return None
+
+            def live_weights():
+                return (
+                    routed.w13_weight,
+                    routed.w13_scales,
+                    routed.w2_weight,
+                    routed.w2_scales,
+                    sources.shared_gate_up_proj.weight,
+                    sources.shared_down_proj.weight,
+                    sources.shared_expert_gate.weight,
+                )
+
+            weights = live_weights()
+            if not standard_direct_parameters(*weights):
+                return None
+            if weights[0].dtype != torch.int8 or weights[2].dtype != torch.int8:
+                # Cold U4/reload must use the canonical conversion/cache-key
+                # path. uint8 is not proof of the workspace's signed S4 recipe.
+                with standard_parameter_context(*weights):
+                    method.get_xpu_fused_moe_impl(
+                        routed, sources.experts.moe_config.experts_per_token
+                    )
+                weights = live_weights()
+                if (
+                    not standard_direct_parameters(*weights)
+                    or weights[0].dtype != torch.int8
+                    or weights[2].dtype != torch.int8
+                ):
+                    raise RuntimeError("canonical MoE preparation must produce live S4")
+            return weights
+        impl = method.get_xpu_fused_moe_impl(
+            routed, sources.experts.moe_config.experts_per_token
+        )
+        s13 = getattr(impl, "gemm1_wei_scales", None)
+        s2 = getattr(impl, "gemm2_wei_scales", None)
+        return (
+            getattr(impl, "w13", None),
+            s13 if s13 is not None else getattr(routed, "w13_scales", None),
+            getattr(impl, "w2", None),
+            s2 if s2 is not None else getattr(routed, "w2_scales", None),
+            sources.shared_gate_up_proj.weight,
+            sources.shared_down_proj.weight,
+            sources.shared_expert_gate.weight,
+        )
+
+    def _try_moe_multi_workspace(self, hidden_states: torch.Tensor):
+        if (
+            not _DIRECT_WORKSPACE
+            or not standard_direct_parameters(hidden_states)
+            or hidden_states.ndim != 2
+            or not 2 <= hidden_states.shape[0] <= 8
+            or self._qwen38_moe_multi_m_input_fallback_reason(hidden_states) is not None
+        ):
+            return None
+        sources, live_bindings = Qwen3_8FlashNextSparseMoeBlock._moe_workspace_sources(
+            self, hidden_states
+        )
+        if self._qwen38_moe_m1_sources_fallback_reason(sources) is not None:
+            return None
+        compact = compact_intermediate(sources.routed_experts.w13_weight)
+        if compact not in (80, 160):
+            return None
+        factory = _moe_multi_workspace_class()
+        if factory is None:
+            return None
+        router = self._qwen38_moe_m1_router_hostchain_sources(
+            sources, hidden_states.device, native_preflight=True
+        )
+        if router is None:
+            return None
+        weights = Qwen3_8FlashNextSparseMoeBlock._moe_workspace_weights(
+            sources, live_bindings
+        )
+        if weights is None:
+            return None
+        if not standard_direct_parameters(hidden_states, *router, *weights):
+            return None
+        grouped = (
+            compact == 80
+            and _QWEN38_MOE_COMPACT80_GROUPED_ENABLED
+            and hidden_states.shape[0]
+            in _QWEN38_MOE_COMPACT80_GROUPED_DEFAULT_TOKEN_COUNTS
+        )
+        run = getattr(self, "_moe_multi_workspace_run", None)
+        if run is None:
+            workspace = factory()
+            run = workspace.try_run
+            if not callable(run):
+                raise RuntimeError("MoE multi workspace has invalid try_run")
+            self._moe_multi_workspace = workspace
+            self._moe_multi_workspace_run = run
+        output = run(hidden_states, *router, weights, compact, grouped)
+        if output is None:
+            return None  # Eligibility miss before any native submission.
+        if self.tp_size > 1:
+            # Native preflight keeps output disjoint from input/router/weights.
+            # The unreduced result has no consumer beyond this same-stream sum.
+            return _qwen38_moe_validate_all_reduce_output(
+                full_decode_all_reduce(
+                    output, fallback=tensor_model_parallel_all_reduce
+                ),
+                output,
+            )
+        return output
+
+    def _try_moe_m1_workspace(self, hidden_states: torch.Tensor):
+        if self._qwen38_moe_m1_input_fallback_reason(hidden_states) is not None:
+            return None
+        sources, live_bindings = Qwen3_8FlashNextSparseMoeBlock._moe_workspace_sources(
+            self, hidden_states
+        )
+        if (
+            sources is None
+            or self._qwen38_moe_m1_sources_fallback_reason(sources) is not None
+        ):
+            return None
+        compact = compact_intermediate(sources.routed_experts.w13_weight)
+        if compact not in (80, 160) or (
+            compact == 80 and not _QWEN38_MOE_M1_ROUTER_HOSTCHAIN_ENABLED
+        ):
+            return None
+        workspace_class = _moe_m1_workspace_class()
+        if workspace_class is None:
+            return None
+        router = self._qwen38_moe_m1_router_hostchain_sources(
+            sources, hidden_states.device
+        )
+        if router is None:
+            return None
+        weights = Qwen3_8FlashNextSparseMoeBlock._moe_workspace_weights(
+            sources, live_bindings
+        )
+        if weights is None:
+            return None
+        direct_eligible = (
+            standard_direct_parameters(hidden_states, *router, *weights)
+            if live_bindings
+            else None
+        )
+        if live_bindings and not direct_eligible:
+            return None
+        if not all(isinstance(weight, torch.Tensor) for weight in weights):
+            return None
+        run = getattr(self, "_moe_m1_workspace_run", None)
+        if run is None:
+            # Factories can invoke Python callbacks; only a cached warm call
+            # may reuse the guard taken after this call's live-weight getter.
+            direct_eligible = None
+            workspace = workspace_class()
+            run = workspace.try_run
+            if not callable(run):
+                raise RuntimeError("MoE workspace exposes a non-callable try_run")
+            self._moe_m1_workspace = workspace
+            self._moe_m1_workspace_run = run
+            direct_run = None
+            if _DIRECT_WORKSPACE:
+                direct_class = _moe_m1_direct_workspace_class()
+                if direct_class is not None:
+                    direct = direct_class()
+                    direct_run = direct.try_run
+                    if not callable(direct_run):
+                        raise RuntimeError("MoE direct workspace has invalid try_run")
+                    self._moe_m1_direct_workspace = direct
+            self._moe_m1_direct_workspace_run = direct_run
+        direct_run = self._moe_m1_direct_workspace_run
+        if (
+            _DIRECT_WORKSPACE
+            and direct_run is not None
+            and (
+                direct_eligible
+                if direct_eligible is not None
+                else standard_direct_parameters(hidden_states, *router, *weights)
+            )
+        ):
+            output = direct_run(hidden_states, *router, weights, compact)
+        else:
+            context = (
+                standard_parameter_context(hidden_states, *router, *weights)
+                if _MOE_M1_PARAMETER_GUARD
+                else nullcontext()
+            )
+            with context:
+                output = run(hidden_states, *router, weights, compact)
+        if output is None:
+            return None  # Native eligibility miss, before any kernel submission.
+        if self.tp_size > 1:
+            # workspace 输出与输入分离；同一有序 stream 上先消费再覆写。
+            return _qwen38_moe_validate_all_reduce_output(
+                full_decode_all_reduce(
+                    output, fallback=tensor_model_parallel_all_reduce
+                ),
+                output,
+            )
+        return output
+
+    def _forward_esimd_moe(self, hidden_states, num_tokens, router_logits=None):
+        sources = self._get_esimd_moe_sources(
+            refresh_weight_bindings=not using_qwen38_sycl()
+        )
+        if sources is not None and hasattr(
+            sources.routed_experts, "w13_weight_scale_inv"
+        ):
+            return super()._forward_esimd_moe(hidden_states, num_tokens, router_logits)
+        if router_logits is not None:
+            return None
+        # The inherited scalar-FP8 path assumes 64-aligned shared-down K and
+        # global scratch. Never send Qwen3.8's I=80/160 back to that path.
+        output = try_fp8_moe(self, hidden_states, sources)
+        if output is not None and self.tp_size > 1:
+            return _qwen38_moe_validate_all_reduce_output(
+                full_decode_all_reduce(
+                    output, fallback=tensor_model_parallel_all_reduce
+                ),
+                output,
+            )
+        return output
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        already_sequence_parallel: bool = False,
+    ) -> torch.Tensor:
+        if getattr(self, "_qwen38_fp8_quantized", False):
+            if (
+                using_qwen38_sycl()
+                and not torch.compiler.is_compiling()
+                and hidden_states.ndim == 2
+                and 1 <= hidden_states.shape[0] <= 8
+            ):
+                output = self._forward_esimd_moe(hidden_states, hidden_states.shape[0])
+                if output is not None:
+                    return output
+            return super().forward(
+                hidden_states, already_sequence_parallel=already_sequence_parallel
+            )
+        if hidden_states.numel() == 0:
+            _record_qwen38_moe_m1_asymmetric(EVENT_ZERO_WORK_SKIP, 0)
+        elif hidden_states.ndim == 2 and hidden_states.shape[0] == 1:
+            if _MOE_M1_WORKSPACE and not NATIVE_STATS_ENABLED:
+                output = self._try_moe_m1_workspace(hidden_states)
+                if output is not None:
+                    return output
+            output = self._forward_qwen38_moe_m1_asymmetric(hidden_states)
+            if output is not None:
+                return output
+        elif (
+            hidden_states.ndim == 2
+            and _QWEN38_MOE_MULTI_M_MIN_TOKENS
+            <= hidden_states.shape[0]
+            <= _QWEN38_MOE_MULTI_M_MAX_TOKENS
+        ):
+            if _MOE_MULTI_WORKSPACE and not NATIVE_STATS_ENABLED:
+                output = self._try_moe_multi_workspace(hidden_states)
+                if output is not None:
+                    return output
+            output = self._forward_qwen38_moe_multi_m_asymmetric(hidden_states)
+            if output is not None:
+                return output
+        return super().forward(
+            hidden_states,
+            already_sequence_parallel=already_sequence_parallel,
+        )
+
+
+class Qwen3_8FlashNextDecoderLayer(nn.Module):
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        layer_type: str,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        config: Qwen3_8FlashNextTextConfig = vllm_config.model_config.hf_text_config
+        model_config = vllm_config.model_config
+        cache_config = vllm_config.cache_config
+        quant_config = vllm_config.quant_config
+
+        self.config = config
+        self.layer_type = layer_type
+        self.layer_idx = extract_layer_index(prefix)
+        if vllm_config.parallel_config.use_sequence_parallel_moe:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next HC does not support sequence-parallel MoE"
+            )
+        self.ple: Qwen3_8FlashNextPLELayer | None = None
+        ple_layer_ids = config.ple_layer_ids
+        if (self.layer_idx + 1) in ple_layer_ids:
+            ple_layer_ids_sorted = sorted(set(ple_layer_ids))
+            ple_dense_layer_id_map = {
+                abs_id: idx for idx, abs_id in enumerate(ple_layer_ids_sorted)
+            }
+            ple_dense_layer_id = ple_dense_layer_id_map[self.layer_idx + 1]
+            self.ple = Qwen3_8FlashNextPLELayer(
+                config,
+                vllm_config=vllm_config,
+                layer_idx=self.layer_idx,
+                ple_dense_layer_id=ple_dense_layer_id,
+                prefix=f"{prefix}.ple",
+            )
+
+        if layer_type == "linear_attention":
+            self.linear_attn = QwenGatedDeltaNetAttention(
+                config,
+                vllm_config=vllm_config,
+                prefix=f"{prefix}.linear_attn",
+                gqa_interleaved_layout=False,
+            )
+        elif layer_type in ATTENTION_LAYER_TYPES:
+            use_qsa = (
+                layer_type == QSA_LAYER_TYPE
+                or getattr(config, "indexer_n_heads", None) is not None
+            )
+            if not use_qsa:
+                self.self_attn = Qwen3NextAttention(
+                    config,
+                    model_config=model_config,
+                    cache_config=cache_config,
+                    quant_config=quant_config,
+                    prefix=f"{prefix}.self_attn",
+                )
+            else:
+                self.self_attn = Qwen3_8FlashNextQSAAttention(
+                    vllm_config=vllm_config,
+                    config=config,
+                    layer_id=self.layer_idx,
+                    quant_config=quant_config,
+                    prefix=f"{prefix}.self_attn",
+                )
+        else:
+            raise ValueError(f"Invalid layer_type {layer_type}")
+
+        self_attn = getattr(self, "self_attn", None)
+        _enable_qwen38_batch_int4_esimd(
+            linear_attn=getattr(self, "linear_attn", None),
+            ple=self.ple,
+            qsa_attn=(
+                self_attn
+                if isinstance(self_attn, Qwen3_8FlashNextQSAAttention)
+                else None
+            ),
+        )
+
+        mlp_only_layers = getattr(config, "mlp_only_layers", [])
+        num_experts = getattr(config, "num_experts", 0) or 0
+        absolute_layer_id = self.layer_idx + 1
+        is_moe_layer = self.layer_idx not in mlp_only_layers and (
+            num_experts > 0 and absolute_layer_id % config.decoder_sparse_step == 0
+        )
+        if is_moe_layer:
+            self.mlp = Qwen3_8FlashNextSparseMoeBlock(
+                vllm_config=vllm_config, prefix=f"{prefix}.mlp"
+            )
+        else:
+            self.mlp = Qwen3NextMLP(
+                hidden_size=config.hidden_size,
+                intermediate_size=config.intermediate_size,
+                hidden_act=config.hidden_act,
+                quant_config=quant_config,
+                prefix=f"{prefix}.mlp",
+            )
+
+        from .full_decode import (
+            dense_operators_enabled,
+            flash_decode_optimizations_enabled,
+        )
+
+        if dense_operators_enabled(vllm_config) and isinstance(self.mlp, Qwen3NextMLP):
+            projections = [self.mlp.gate_up_proj, self.mlp.down_proj]
+            if layer_type == "linear_attention":
+                projections.extend(
+                    (
+                        self.linear_attn.in_proj_qkvz,
+                        self.linear_attn.in_proj_ba,
+                        self.linear_attn.out_proj,
+                    )
+                )
+            elif isinstance(
+                self.self_attn, (Qwen3NextAttention, Qwen3_8FlashNextQSAAttention)
+            ):
+                projections.extend((self.self_attn.qkv_proj, self.self_attn.o_proj))
+                if isinstance(self.self_attn, Qwen3_8FlashNextQSAAttention):
+                    projections.append(self.self_attn.indexer.index_qk_proj)
+            for projection in projections:
+                if vllm_config.model_config.quantization == "sym_int4":
+                    projection._qwen4_dense_int4 = True
+                else:
+                    projection._qwen4_dense_fp8 = True
+
+        hc_config = HyperConnectionConfig(
+            hc_count=config.hc_count,
+            hidden_size=config.hidden_size,
+            params_dtype=vllm_config.model_config.dtype,
+            hc_lowrank=config.hc_lowrank,
+            rms_norm_eps=config.rms_norm_eps,
+            hc_per_branch_norm=True,
+        )
+        self.attn_hyper_connection = GatedResidual(
+            hc_config,
+            prefix=maybe_prefix(prefix, "attn_hyper_connection"),
+            shard_lowrank=_use_dense_hc_tp2(vllm_config),
+            native_dense=dense_operators_enabled(vllm_config),
+        )
+        self.mlp_hyper_connection = GatedResidual(
+            hc_config,
+            prefix=maybe_prefix(prefix, "mlp_hyper_connection"),
+            shard_lowrank=_use_dense_hc_tp2(vllm_config),
+            native_dense=dense_operators_enabled(vllm_config),
+        )
+        flash_ordinary = flash_decode_optimizations_enabled(vllm_config)
+        for hc in (self.attn_hyper_connection, self.mlp_hyper_connection):
+            hc._fused_multi_allowed = flash_ordinary
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        prev_block_output: torch.Tensor | None,
+        prev_injection: torch.Tensor | None,
+        positions: torch.Tensor,
+        *,
+        input_ids: torch.Tensor | None,
+        query_start_loc: torch.Tensor | None,
+        ngram_context: torch.Tensor | None,
+        post_attention_rows: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        layer_timing = None
+        attn_timing = None
+        mlp_timing = None
+        if self.layer_idx == _QWEN38_LAYER_TIMING_LAYER:
+            layer_timing = _qsa_model_timing_begin(f"layer_{self.layer_idx}")
+        attn_hc = self.attn_hyper_connection
+        if self.ple is not None:
+            # PLE adds directly to the multi-stream state, so pending HC state
+            # must be materialized before the addition.
+            if prev_block_output is not None and prev_injection is not None:
+                hidden_states = attn_hc.combine(
+                    hidden_states, prev_block_output, prev_injection
+                )
+                prev_block_output = prev_injection = None
+
+            if input_ids is None or query_start_loc is None or ngram_context is None:
+                raise RuntimeError("PLE inputs were not prepared")
+            hidden_states = hidden_states + self.ple(
+                hidden_states,
+                input_ids,
+                query_start_loc,
+                ngram_context,
+            )
+            _qwen38_debug_boundary(self.layer_idx, "after_ple")
+
+        # Fuse a pending combine with this HC module's mix when possible.
+        if prev_block_output is not None and prev_injection is not None:
+            hidden_states, block_input, injection = attn_hc.combine_and_mix(
+                hidden_states, prev_block_output, prev_injection
+            )
+        else:
+            hidden_states, block_input, injection = attn_hc.mix(hidden_states)
+
+        if self.layer_type == "linear_attention":
+            attn_timing = (
+                _qsa_model_timing_begin(f"attn_layer_{self.layer_idx}")
+                if layer_timing is not None
+                else None
+            )
+            attn_out = self.linear_attn(hidden_states=block_input)
+        elif self.layer_type in ATTENTION_LAYER_TYPES:
+            attn_timing = (
+                _qsa_model_timing_begin(f"attn_layer_{self.layer_idx}")
+                if layer_timing is not None
+                else None
+            )
+            attn_out = self.self_attn(
+                hidden_states=block_input,
+                positions=positions,
+            )
+        else:
+            raise ValueError("Invalid layer_type")
+        _qsa_timing_end(attn_timing)
+        _qwen38_debug_boundary(self.layer_idx, "after_attention")
+
+        if post_attention_rows is not None:
+            # 完整 attention 已写完全部 KV/history；只裁剪无跨 token 状态的后半段。
+            assert injection is not None
+            hidden_states = hidden_states.index_select(0, post_attention_rows)
+            attn_out = attn_out.index_select(0, post_attention_rows)
+            injection = injection.index_select(0, post_attention_rows)
+
+        mlp_hc = self.mlp_hyper_connection
+        hidden_states, block_input, injection = mlp_hc.combine_and_mix(
+            hidden_states, attn_out, injection
+        )
+        mlp_timing = (
+            _qsa_model_timing_begin(f"mlp_layer_{self.layer_idx}")
+            if layer_timing is not None
+            else None
+        )
+        mlp_out = self.mlp(block_input)
+        _qsa_timing_end(mlp_timing)
+        _qwen38_debug_boundary(self.layer_idx, "after_mlp")
+        _qsa_timing_end(layer_timing)
+        return hidden_states, mlp_out, injection
+
+
+class Qwen3_8FlashNextMixtureOfExperts(MixtureOfExperts):
+    """Expose Qwen3.8-Flash-Next routed experts through vLLM's EPLB protocol."""
+
+    def set_moe_parameters(self, layers: Iterable[nn.Module]) -> None:
+        self.moe_layers = []
+        self.moe_mlp_layers = []
+        example_moe = None
+        for layer in layers:
+            if isinstance(layer, Qwen3_8FlashNextDecoderLayer) and isinstance(
+                layer.mlp, Qwen3_8FlashNextSparseMoeBlock
+            ):
+                example_moe = layer.mlp
+                self.moe_mlp_layers.append(layer.mlp)
+                self.moe_layers.append(layer.mlp.experts)
+
+        self.num_moe_layers = len(self.moe_layers)
+        if example_moe is None:
+            self.num_expert_groups = 0
+            self.num_shared_experts = 0
+            self.num_logical_experts = 0
+            self.num_physical_experts = 0
+            self.num_local_physical_experts = 0
+            self.num_routed_experts = 0
+            self.num_redundant_experts = 0
+            return
+
+        self.num_expert_groups = 1
+        self.num_shared_experts = example_moe.n_shared_experts
+        self.num_logical_experts = example_moe.n_logical_experts
+        self.num_physical_experts = example_moe.n_physical_experts
+        self.num_local_physical_experts = example_moe.n_local_physical_experts
+        self.num_routed_experts = example_moe.n_routed_experts
+        self.num_redundant_experts = example_moe.n_redundant_experts
+
+    def update_physical_experts_metadata(
+        self,
+        num_physical_experts: int,
+        num_local_physical_experts: int,
+    ) -> None:
+        assert self.num_local_physical_experts == num_local_physical_experts
+        self.num_physical_experts = num_physical_experts
+        self.num_local_physical_experts = num_local_physical_experts
+        self.num_redundant_experts = num_physical_experts - self.num_logical_experts
+        for moe in self.moe_mlp_layers:
+            moe.n_physical_experts = num_physical_experts
+            moe.n_local_physical_experts = num_local_physical_experts
+            moe.n_redundant_experts = self.num_redundant_experts
+            moe.experts.update_expert_map()
+
+
+@support_torch_compile(
+    dynamic_arg_dims={
+        "input_ids": 0,
+        "positions": -1,
+        "intermediate_tensors": 0,
+        "inputs_embeds": 0,
+        "query_start_loc": 0,
+        "ngram_context": 0,
+        "deepstack_input_embeds": 0,
+    }
+)
+class Qwen3_8FlashNextModel(nn.Module):
+    hf_to_vllm_mapper = Qwen3_5Model.hf_to_vllm_mapper | _HC_WEIGHTS_MAPPER
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        config: Qwen3_8FlashNextTextConfig = vllm_config.model_config.hf_text_config
+        self.config = config
+        self.num_redundant_experts = (
+            vllm_config.parallel_config.eplb_config.num_redundant_experts
+        )
+        self.vocab_size = config.vocab_size
+        self._qsa_layer_ids = frozenset(
+            layer_idx
+            for layer_idx, layer_type in enumerate(config.layer_types)
+            if layer_type == QSA_LAYER_TYPE
+            or (
+                layer_type == "full_attention"
+                and getattr(config, "indexer_n_heads", None) is not None
+            )
+        )
+        self.embed_tokens = VocabParallelEmbedding(self.vocab_size, config.hidden_size)
+
+        def get_layer(prefix: str) -> Qwen3_8FlashNextDecoderLayer:
+            layer_idx = extract_layer_index(prefix)
+            return Qwen3_8FlashNextDecoderLayer(
+                vllm_config,
+                layer_type=config.layer_types[layer_idx],
+                prefix=prefix,
+            )
+
+        self.start_layer, self.end_layer, self.layers = make_layers(
+            config.num_hidden_layers, get_layer, prefix=f"{prefix}.layers"
+        )
+        intermediate_size = config.hidden_size * config.hc_count
+        self.make_empty_intermediate_tensors = make_empty_intermediate_tensors_factory(
+            ["hidden_states"], intermediate_size
+        )
+
+        self.hyper_connection_mixer: GatedResidual | None
+        if get_pp_group().is_last_rank:
+            from .full_decode import dense_operators_enabled
+
+            hc_config = HyperConnectionConfig(
+                hc_count=config.hc_count,
+                hidden_size=config.hidden_size,
+                params_dtype=vllm_config.model_config.dtype,
+                hc_lowrank=config.hc_lowrank,
+                rms_norm_eps=config.rms_norm_eps,
+                hc_per_branch_norm=True,
+            )
+            self.hyper_connection_mixer = GatedResidual(
+                hc_config,
+                use_combine=False,
+                prefix=maybe_prefix(prefix, "hyper_connection_mixer"),
+                shard_lowrank=_use_dense_hc_tp2(vllm_config),
+                native_dense=dense_operators_enabled(vllm_config),
+            )
+        else:
+            self.hyper_connection_mixer = None
+
+        spec_config = vllm_config.speculative_config
+        # MTP HC multi-stream outputs: when speculative method=="mtp" and the
+        # model uses HC with hc_count>1, retain the pre-final-mixer multi-stream
+        # hidden state [T, hc_count*H] so the MTP drafter can feed a real
+        # multi-stream backbone hidden on its first step (scheme A). Derived
+        # purely from config (NOT node identity) so P/D nodes stay consistent.
+        needs_mtp_hidden = (
+            spec_config is not None
+            and getattr(spec_config, "method", None) == "mtp"
+            and get_pp_group().is_last_rank
+        )
+        if needs_mtp_hidden:
+            self._mtp_hidden_buffer = torch.empty(
+                vllm_config.scheduler_config.max_num_batched_tokens,
+                config.hc_count * config.hidden_size,
+                dtype=vllm_config.model_config.dtype,
+                device=vllm_config.device_config.device,
+            )
+        else:
+            self._mtp_hidden_buffer = None
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.embed_tokens(input_ids)
+
+    def forward(
+        self,
+        input_ids: torch.Tensor | None,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+        query_start_loc: torch.Tensor | None = None,
+        ngram_context: torch.Tensor | None = None,
+        deepstack_input_embeds: IntermediateTensors | None = None,
+    ) -> torch.Tensor | IntermediateTensors:
+        model_timing = _qsa_model_timing_begin("model")
+        if get_pp_group().is_first_rank:
+            if inputs_embeds is not None:
+                hidden_states = inputs_embeds
+            else:
+                if input_ids is None:
+                    raise ValueError("input_ids or inputs_embeds is required")
+                hidden_states = self.embed_input_ids(input_ids)
+            hidden_states = hidden_states.repeat(1, self.config.hc_count)
+        else:
+            if intermediate_tensors is None:
+                raise ValueError("pipeline stage requires intermediate tensors")
+            hidden_states = intermediate_tensors["hidden_states"]
+
+        block_output = None
+        injection = None
+        last_layer = None
+        for layer_idx, layer in islice(
+            enumerate(self.layers), self.start_layer, self.end_layer
+        ):
+            last_layer = layer
+            hidden_states, block_output, injection = layer(
+                hidden_states=hidden_states,
+                prev_block_output=block_output,
+                prev_injection=injection,
+                positions=positions,
+                input_ids=input_ids,
+                query_start_loc=query_start_loc,
+                ngram_context=ngram_context,
+            )
+            if deepstack_input_embeds is not None and layer_idx < len(
+                deepstack_input_embeds
+            ):
+                deepstack_embed = deepstack_input_embeds[
+                    f"deepstack_input_embeds_{layer_idx}"
+                ]
+                deepstack_embed = (
+                    deepstack_embed.unsqueeze(-2)
+                    .expand(
+                        *deepstack_embed.shape[:-1],
+                        self.config.hc_count,
+                        self.config.hidden_size,
+                    )
+                    .flatten(-2)
+                )
+                # Deepstack is an external addition to the materialized
+                # multi-stream state and therefore terminates delayed combine.
+                hidden_states = layer.mlp_hyper_connection.combine(
+                    hidden_states, block_output, injection
+                )
+                block_output = None
+                injection = None
+                hidden_states = hidden_states + deepstack_embed
+
+        if not get_pp_group().is_last_rank:
+            # PP transports one tensor, not the delayed HC tuple. Materialize
+            # with the HC module that produced the pending injection.
+            if last_layer is not None and block_output is not None:
+                hidden_states = last_layer.mlp_hyper_connection.combine(
+                    hidden_states, block_output, injection
+                )
+            _qsa_timing_end(model_timing)
+            return IntermediateTensors({"hidden_states": hidden_states})
+
+        # The final mixer consumes the last pending combine and returns both
+        # the sampled single stream and the materialized multi-stream state.
+        final_mixer = self.hyper_connection_mixer
+        assert final_mixer is not None
+        mtp_hidden_output = None
+        if self._mtp_hidden_buffer is None:
+            multi_hidden, sample_hidden_states, _ = final_mixer.combine_and_mix(
+                hidden_states, block_output, injection
+            )
+        else:
+            num_tokens = hidden_states.shape[0]
+            mtp_hidden_output = self._mtp_hidden_buffer[:num_tokens]
+            multi_hidden, sample_hidden_states, _ = final_mixer.combine_and_mix(
+                hidden_states,
+                block_output,
+                injection,
+                combine_output=mtp_hidden_output,
+            )
+        if mtp_hidden_output is not None and multi_hidden is not mtp_hidden_output:
+            # Native fixed-shape combine returns the preferred output object.
+            # Unsupported and fallback paths retain the original copy behavior.
+            mtp_hidden_output.copy_(multi_hidden)
+        _qsa_timing_end(model_timing)
+        return sample_hidden_states
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        weights = (
+            (
+                _remap_qsa_cache_scale_name(name, self._qsa_layer_ids),
+                weight,
+            )
+            for name, weight in weights
+        )
+        weights = maybe_fuse_shared_experts(
+            weights,
+            enabled=False,  # XPU keeps shared experts separate from routed slots.
+            n_routed_experts=getattr(self.config, "num_experts", 0) or 0,
+            n_shared_experts=1,
+            ckpt_prefix="mlp.shared_expert",
+        )
+        # Non-persistent PLE state rebuilt in __init__; skip any ckpt
+        # column for them.
+        skip_substrs = [
+            "hashstats_",
+            "token_lookup",
+            "hyper_connection_mixer.block_inject_weight",
+        ]
+        mapper = self.hf_to_vllm_mapper | WeightsMapper(
+            orig_to_new_substr={name: None for name in skip_substrs}
+        )
+        loader = AutoWeightsLoader(
+            self,
+            ignore_unexpected_prefixes=(
+                ["hyper_connection_mixer."]
+                if self.hyper_connection_mixer is None
+                else []
+            ),
+            ignore_unexpected_suffixes=_QWEN38_FLASH_NEXT_IGNORED_MISSING_SUFFIXES.copy(),
+        )
+        loaded = loader.load_weights(
+            weights,
+            mapper=mapper,
+        )
+        return loaded
+
+
+class Qwen3_8FlashNextForCausalLM(
+    nn.Module,
+    HasInnerState,
+    SupportsLoRA,
+    SupportsMRoPE,
+    SupportsPP,
+    Qwen3_8FlashNextMixtureOfExperts,
+    IsHybrid,
+):
+    packed_modules_mapping = {
+        "qkv_proj": ["q_proj", "k_proj", "v_proj"],
+        "gate_up_proj": ["gate_proj", "up_proj"],
+        "in_proj_qkvz": ["in_proj_qkv", "in_proj_z"],
+        "in_proj_ba": ["in_proj_b", "in_proj_a"],
+        "input_mix_weight_down_block_inject": [
+            "input_mix_weight_down",
+            "block_inject_weight",
+            "_input_mix_padding",
+        ],
+    }
+    hf_to_vllm_mapper = WeightsMapper(
+        orig_to_new_prefix={"model.language_model.": "model."}
+    )
+    requires_raw_input_tokens = True
+
+    def __init__(self, *, vllm_config: VllmConfig, prefix: str = "") -> None:
+        super().__init__()
+        config: Qwen3_8FlashNextTextConfig = vllm_config.model_config.hf_text_config
+        self.vllm_config = vllm_config
+        self.model_config = vllm_config.model_config
+        self.quant_config = vllm_config.quant_config
+        self.config = config
+        self.scheduler_config = vllm_config.scheduler_config
+        if vllm_config.cache_config.mamba_cache_mode == "all":
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next currently does not support 'all' prefix caching, "
+                "please use '--mamba-cache-mode=align' instead"
+            )
+        self.model = Qwen3_8FlashNextModel(
+            vllm_config=vllm_config, prefix=maybe_prefix(prefix, "model")
+        )
+        self.lm_head = ParallelLMHead(
+            config.vocab_size,
+            config.hidden_size,
+            prefix=maybe_prefix(prefix, "lm_head"),
+        )
+        self.logits_processor = LogitsProcessor(config.vocab_size)
+        self.make_empty_intermediate_tensors = (
+            self.model.make_empty_intermediate_tensors
+        )
+        self.set_moe_parameters(self.model.layers)
+        enable_qwen38next_low_latency_gemm(self, self.model_config.dtype)
+
+    @staticmethod
+    def get_model_state_cls():
+        from .model_state import Qwen3_8FlashNextModelState
+
+        return Qwen3_8FlashNextModelState
+
+    def forward(
+        self,
+        input_ids: torch.Tensor | None,
+        positions: torch.Tensor,
+        intermediate_tensors: IntermediateTensors | None = None,
+        inputs_embeds: torch.Tensor | None = None,
+        **kwargs: object,
+    ) -> torch.Tensor | IntermediateTensors:
+        # Forward kwargs unchanged so the runner's _maybe_add_ngram_kwargs
+        # path (query_start_loc / ngram_context) reaches Qwen3_8FlashNextModel.
+        return self.model(
+            input_ids,
+            positions,
+            intermediate_tensors,
+            inputs_embeds,
+            **kwargs,
+        )
+
+    def embed_input_ids(self, input_ids: torch.Tensor) -> torch.Tensor:
+        return self.model.embed_input_ids(input_ids)
+
+    @classmethod
+    def get_ple_mamba_state_dtype_from_config(
+        cls,
+        vllm_config: VllmConfig,
+    ) -> tuple[torch.dtype, ...]:
+        return MambaStateDtypeCalculator.short_conv_state_dtype(
+            vllm_config.model_config.dtype,
+            vllm_config.cache_config.mamba_cache_dtype,
+        )
+
+    @classmethod
+    def get_ple_mamba_state_shape_from_config(
+        cls, vllm_config: VllmConfig
+    ) -> tuple[tuple[int, int]]:
+        hf_config = vllm_config.model_config.hf_text_config
+        conv_kernel_size = hf_config.ple_conv_kernel_size
+        short_conv_dilation = hf_config.ngram_size
+        conv_state_len = (conv_kernel_size - 1) * short_conv_dilation
+        num_spec = (
+            vllm_config.speculative_config.num_speculative_tokens
+            if vllm_config.speculative_config
+            else 0
+        )
+        hc_count = hf_config.hc_count
+        hc_hidden_size = hf_config.hidden_size * hc_count
+        return MambaStateShapeCalculator.short_conv_state_shape(
+            tp_world_size=1,
+            intermediate_size=hc_hidden_size,
+            conv_kernel=conv_state_len + 1,
+            num_spec=num_spec,
+        )
+
+    @classmethod
+    def get_gdn_mamba_state_dtype_from_config(
+        cls, vllm_config: VllmConfig
+    ) -> tuple[torch.dtype, torch.dtype]:
+        return MambaStateDtypeCalculator.gated_delta_net_state_dtype(
+            vllm_config.model_config.dtype,
+            vllm_config.cache_config.mamba_cache_dtype,
+            vllm_config.cache_config.mamba_ssm_cache_dtype,
+        )
+
+    @classmethod
+    def get_gdn_mamba_state_shape_from_config(
+        cls, vllm_config: VllmConfig
+    ) -> tuple[tuple[int, int], tuple[int, int]]:
+        parallel_config = vllm_config.parallel_config
+        hf_config = vllm_config.model_config.hf_text_config
+        tp_size = parallel_config.tensor_parallel_size
+        num_spec = (
+            vllm_config.speculative_config.num_speculative_tokens
+            if vllm_config.speculative_config
+            else 0
+        )
+        return MambaStateShapeCalculator.gated_delta_net_state_shape(
+            tp_size,
+            hf_config.linear_num_key_heads,
+            hf_config.linear_num_value_heads,
+            hf_config.linear_key_head_dim,
+            hf_config.linear_value_head_dim,
+            hf_config.linear_conv_kernel_dim,
+            num_spec,
+        )
+
+    @classmethod
+    def get_mamba_state_dtype_from_config(
+        cls,
+        vllm_config: VllmConfig,
+    ) -> tuple[torch.dtype, torch.dtype]:
+        return cls.get_gdn_mamba_state_dtype_from_config(vllm_config)
+
+    @classmethod
+    def get_mamba_state_shape_from_config(
+        cls, vllm_config: VllmConfig
+    ) -> tuple[tuple[int, int], tuple[int, int]]:
+        return cls.get_gdn_mamba_state_shape_from_config(vllm_config)
+
+    @classmethod
+    def get_mamba_state_copy_func(
+        cls,
+    ) -> tuple[MambaStateCopyFunc, MambaStateCopyFunc]:
+        return MambaStateCopyFuncCalculator.gated_delta_net_state_copy_func()
+
+    @classmethod
+    def get_mamba_state_copy_funcs(
+        cls,
+        mamba_types: set[MambaAttentionBackendEnum],
+    ) -> MambaStateCopyFuncsByType:
+        copy_funcs_by_type = {
+            MambaAttentionBackendEnum.GDN_ATTN: cls.get_mamba_state_copy_func(),
+            MambaAttentionBackendEnum.SHORT_CONV: (
+                MambaStateCopyFuncCalculator.short_conv_state_copy_func()
+            ),
+        }
+        missing_types = mamba_types - copy_funcs_by_type.keys()
+        assert not missing_types, f"missing state copy funcs for {missing_types}"
+        return {
+            mamba_type: copy_funcs_by_type[mamba_type] for mamba_type in mamba_types
+        }
+
+    @classmethod
+    def get_mamba_specs_from_config(
+        cls, vllm_config: VllmConfig
+    ) -> tuple[MambaSpec, ...]:
+        """Return all MambaSpecs for this model (GDN layers + PLE layer).
+
+        The PLE layer uses a separate short_conv MambaSpec whose page_size_bytes
+        may exceed the GDN spec; callers should take the maximum.
+        """
+        return (
+            MambaSpec(
+                shapes=cls.get_gdn_mamba_state_shape_from_config(vllm_config),
+                dtypes=cls.get_gdn_mamba_state_dtype_from_config(vllm_config),
+                block_size=-1,
+                mamba_type=MambaAttentionBackendEnum.GDN_ATTN,
+            ),
+            MambaSpec(
+                shapes=cls.get_ple_mamba_state_shape_from_config(vllm_config),
+                dtypes=cls.get_ple_mamba_state_dtype_from_config(vllm_config),
+                block_size=-1,
+                tp_replicated=True,
+                mamba_type=MambaAttentionBackendEnum.SHORT_CONV,
+            ),
+        )
+
+    def compute_logits(self, hidden_states: torch.Tensor) -> torch.Tensor | None:
+        return self.logits_processor(self.lm_head, hidden_states)
+
+    def get_mtp_target_hidden_states(self) -> torch.Tensor | None:
+        return self.model._mtp_hidden_buffer
+
+    def get_mrope_input_positions(
+        self,
+        input_tokens: list[int],
+        mm_features: list[MultiModalFeatureSpec],
+    ) -> tuple[torch.Tensor, int]:
+        positions = torch.arange(len(input_tokens), dtype=torch.long)
+        return positions.unsqueeze(0).expand(3, -1), 0
+
+    def load_weights(self, weights: Iterable[tuple[str, torch.Tensor]]) -> set[str]:
+        mapper = self.hf_to_vllm_mapper | WeightsMapper(
+            orig_to_new_prefix={"model.visual.": None},
+            orig_to_new_substr={"mtp.": None},
+        )
+        loader = AutoWeightsLoader(
+            self,
+            ignore_unexpected_suffixes=_QWEN38_FLASH_NEXT_IGNORED_MISSING_SUFFIXES.copy(),
+        )
+        return loader.load_weights(weights, mapper=mapper)
+
