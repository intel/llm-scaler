+        raise RuntimeError("Qwen3.8 FP8 linear module exposed a non-callable operation")
+    return operation
+
+
+def _is_xpu_tensor(value: object) -> bool:
+    return isinstance(value, torch.Tensor) and value.device.type == "xpu"
+
+
+def _is_qwen38_fp8_narrow_shape(n: int, k: int) -> bool:
+    return (n, k) in _QWEN38_FP8_NARROW_SHAPES
+
+
+def _prepare_xpu_w8a16_weight(
+    weight: torch.Tensor, out_features: int, in_features: int
+) -> torch.Tensor:
+    """Store W8A16 weights as contiguous checkpoint-order ``[N, K]``."""
+    if weight.shape not in {(out_features, in_features), (in_features, out_features)}:
+        raise ValueError(
+            "XPU W8A16 FP8 expects weight shape "
+            f"({out_features}, {in_features}) or ({in_features}, {out_features}), "
+            f"got {tuple(weight.shape)}"
+        )
+    loader_transposed = weight.shape == (in_features, out_features) and (
+        in_features != out_features or not weight.is_contiguous()
+    )
+    return (weight.t() if loader_transposed else weight).contiguous()
+
+
+def _try_qwen38_fp8_linear(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+) -> torch.Tensor | None:
+    """Try the optional exact-shape Qwen3.8 native-width W8A16 path."""
+    # This local import keeps the linear kernel module independent from the
+    # Qwen model import graph.  A direct pybind call must not bypass active
+    # TorchFunction/TorchDispatch modes or unknown Tensor subclasses; ordinary
+    # torch.Tensor/torch.nn.Parameter and vLLM's standard parameter classes are
+    # accepted by the shared guard.
+    from vllm.model_executor.models._qwen3_next_xpu import _direct_parameters
+
+    if (
+        not _direct_parameters(x, weight, weight_scale)
+        or _DISABLE_ESIMD_FP8
+        or getattr(torch.compiler, "is_compiling", lambda: False)()
+        or (_DISABLE_ESIMD_FP8_BATCH and x.ndim == 2 and x.shape[0] > 1)
+        or bias is not None
+    ):
+        return None
+
+    # The ordinary SYCL-TLA provider wins the other Qwen projections. The
+    # native-width candidate only beats it for M1 shared DOWN K80/K160.
+    if using_qwen38_sycl() and not (
+        x.ndim == weight.ndim == 2
+        and x.shape[0] == 1
+        and weight.shape[0] == 2560
+        and weight.shape[1] in (80, 160)
+    ):
+        return None
+
+    try:
+        operation = _load_qwen38_fp8_linear_op()
+    except (ImportError, OSError):
+        return None
+    if operation is None:
+        return None
+
+    output = operation(x, weight, weight_scale)
+    if output is not None:
+        logger.info_once(
+            "XPU runtime-FP8 linear is using the Qwen3.8 native-width path.",
+            scope="local",
+        )
+    return output
+
+
+def _try_esimd_fp8_linear(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    bias: torch.Tensor | None,
+    allow_qwen_spec_n48: bool = False,
+) -> torch.Tensor | None:
+    """Use ESIMD FP8 GEMV/GEMM for decode and small/measured batches."""
+    from vllm.model_executor.models._qwen3_next_xpu import _direct_parameters
+
+    if not _direct_parameters(x, weight, weight_scale, bias):
+        return None
+    is_compiling = getattr(torch.compiler, "is_compiling", lambda: False)()
+
+    if (
+        _DISABLE_ESIMD_FP8
+        or is_compiling
+        or bias is not None
+        or x.ndim != 2
+        or weight.ndim != 2
+        or not 1 <= x.shape[0] <= 64
+        or x.shape[1] != weight.shape[1]
+    ):
+        return None
+
+    if (
+        weight.shape[0] % _ESIMD_FP8_ALIGNMENT != 0
+        and not (allow_qwen_spec_n48 and weight.shape[0] == 48)
+    ) or weight.shape[1] % _ESIMD_FP8_ALIGNMENT != 0:
+        if not _is_qwen38_fp8_narrow_shape(weight.shape[0], weight.shape[1]):
+            return None
+        # Native preflight handles dtype/device/layout in one C++ call.
+        return _try_qwen38_fp8_linear(x, weight, weight_scale, bias)
+
+    if (
+        x.dtype != torch.float16
+        or weight.dtype != torch.float8_e4m3fn
+        or weight_scale.dtype != torch.float32
+        or weight_scale.numel() != 1
+        or not x.is_contiguous()
+        or not weight.is_contiguous()
+        or not weight_scale.is_contiguous()
+        or not all(_is_xpu_tensor(t) for t in (x, weight, weight_scale))
+        or x.device != weight.device
+        or x.device != weight_scale.device
+    ):
+        return None
+
+    is_decode = x.shape[0] == 1 and weight.shape[0] <= _ESIMD_FP8_GEMV_MAX_N
+    if not is_decode:
+        if _DISABLE_ESIMD_FP8_BATCH:
+            return None
+        is_small_batch_gemm = 2 <= x.shape[0] <= _ESIMD_FP8_MAX_M
+        measured_region = x.shape[0] in _ESIMD_FP8_BATCH_CAPABILITIES.get(
+            (weight.shape[0], weight.shape[1]), ()
+        )
+        if not (is_small_batch_gemm or measured_region):
+            return None
+    try:
+        op = _load_esimd_op(is_decode)
+    except (AttributeError, ImportError, OSError):
+        return None
+
+    output = torch.empty(
+        (x.shape[0], weight.shape[0]), dtype=torch.float16, device=x.device
+    )
+    op(x, weight, weight_scale, output)
+    logger.info_once(
+        "XPU runtime-FP8 linear is using the ESIMD %s path.",
+        "GEMV" if is_decode else "GEMM",
+        scope="local",
+    )
+    return output
+
 
