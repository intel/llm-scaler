+class Qwen3_8FlashNextQSAFlashAttentionImpl(FlashAttentionImpl):
+    """Run paged sparse GQA with the portable pure-torch QSA op on XPU."""
+
+    supports_dcp: bool = False
+    supports_pcp: bool = False
+
+    def __init__(self, *args, **kwargs) -> None:
+        super().__init__(*args, **kwargs)
+        if self.dcp_world_size != 1:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA does not support decode context parallelism"
+            )
+        if self.kv_cache_dtype not in _QSA_CACHE_DTYPES:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires an FP16 or BF16 main KV cache"
+            )
+        self.supports_quant_query_input = False
+
+    def forward_qsa(
+        self,
+        layer: torch.nn.Module,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        kv_cache: torch.Tensor,
+        attn_metadata: FlashAttentionMetadata,
+        output: torch.Tensor,
+        token_to_req: torch.Tensor,
+        num_mapped_tokens: int,
+        output_scale: torch.Tensor | None = None,
+        output_block_scale: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        if output_scale is not None or output_block_scale is not None:
+            raise NotImplementedError("QSA does not support fused output quantization")
+        if self.alibi_slopes is not None or self.sinks is not None:
+            raise NotImplementedError("QSA does not support ALiBi or attention sinks")
+        if self.sliding_window != (-1, -1):
+            raise NotImplementedError("QSA does not support sliding-window attention")
+
+        num_tokens = attn_metadata.num_actual_tokens
+        if not 0 <= num_mapped_tokens <= num_tokens:
+            raise RuntimeError(
+                "QSA mapped token count must be within the physical token count: "
+                f"mapped={num_mapped_tokens}, physical={num_tokens}"
+            )
+        if num_mapped_tokens == 0:
+            # There is no native attention submission in this case, so the
+            # whole physical output must be defined for the caller.
+            output.zero_()
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_ATTENTION,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+            return output
+
+        # Both the native attention ABIs and the torch fallback write every
+        # element of the mapped prefix.  The old unconditional full-buffer
+        # clear therefore only added a device fill/launch on the QSA critical
+        # path.  Clear physical padding only when it exists; this preserves
+        # the output contract for mixed mapped/physical batches without
+        # serializing an unnecessary fill before the optimized kernel.
+        if num_mapped_tokens < output.shape[0]:
+            output[num_mapped_tokens:].zero_()
+
+        topk_buffer = getattr(layer, "topk_indices_buffer", None)
+        if topk_buffer is None:
+            raise RuntimeError("QSA owner did not provide its top-k buffer")
+        logical_indices = topk_buffer[:num_mapped_tokens]
+        token_to_req = token_to_req[:num_mapped_tokens]
+        key_cache, value_cache = kv_cache.transpose(1, 2).split(self.head_size, dim=-1)
+        key_cache = canonicalize_singleton_dim_strides(key_cache)
+        value_cache = canonicalize_singleton_dim_strides(value_cache)
+        expected_dtype = query.dtype
+        runtime_tensors = {
+            "key": key,
+            "value": value,
+            "key_cache": key_cache,
+            "value_cache": value_cache,
+            "output": output,
+        }
+        if expected_dtype not in _QSA_DTYPES or any(
+            tensor.dtype != expected_dtype for tensor in runtime_tensors.values()
+        ):
+            actual = ", ".join(
+                f"{name}={tensor.dtype}" for name, tensor in runtime_tensors.items()
+            )
+            raise RuntimeError(
+                "Qwen3.8-Flash-Next QSA requires matching FP16/BF16 runtime "
+                f"dtypes; query={expected_dtype}, {actual}"
+            )
+
+        from .ops.qsa import qsa_sparse_paged_attention
+
+        output_prefix = output[:num_mapped_tokens]
+        returned = qsa_sparse_paged_attention(
+            query[:num_mapped_tokens],
+            key_cache,
+            value_cache,
+            logical_indices,
+            attn_metadata.block_table,
+            token_to_req,
+            output_prefix,
+        )
+        if (
+            not (
+                returned is output_prefix
+                and type(returned) is torch.Tensor
+                and standard_direct_parameters(returned)
+            )
+            and returned.data_ptr() != output_prefix.data_ptr()
+        ):
+            raise RuntimeError("QSA attention did not preserve its caller output")
+        return output
+
+
+class Qwen3_8FlashNextQSAAttention(Qwen3NextAttention, AttentionLayerBase):
+    """Merged Qwen full-attention owner with a QSA index side branch."""
+
+    supports_dcp = False
+
+    def __init__(
+        self,
+        *,
+        vllm_config: VllmConfig,
+        config: Qwen3_8FlashNextTextConfig,
+        layer_id: int,
+        quant_config: QuantizationConfig | None = None,
+        reduce_results: bool = True,
+        prefix: str = "",
+    ) -> None:
+        nn.Module.__init__(self)
+        cache_config = vllm_config.cache_config
+        model_config = vllm_config.model_config
+        if cache_config is None:
+            raise ValueError("Qwen3.8-Flash-Next QSA requires a paged KV cache")
+        if model_config.dtype not in _QSA_DTYPES:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires an FP16 or BF16 model dtype"
+            )
+        if cache_config.cache_dtype not in _QSA_CACHE_DTYPES:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires an FP16 or BF16 main KV cache"
+            )
+        if getattr(quant_config, "kv_cache_scheme", None) is not None:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA does not support KV quantization"
+            )
+        parallel_config = vllm_config.parallel_config
+        if (
+            parallel_config.prefill_context_parallel_size > 1
+            or parallel_config.decode_context_parallel_size > 1
+        ):
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA does not support context parallelism"
+            )
+        if not getattr(config, "is_causal", True):
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires causal decoder attention"
+            )
+
+        _validate_qwen4_qsa_full_native(vllm_config)
+        self.config = config
+        self.hidden_size = int(config.hidden_size)
+        self._native_qsa_available = False
+        if model_config.dtype == torch.float16:
+            from .ops.qsa import preload_qsa_native_ops
+
+            self._native_qsa_available = preload_qsa_native_ops()
+        tp_size = get_tensor_model_parallel_world_size()
+        self.total_num_heads = int(config.num_attention_heads)
+        if self.total_num_heads % tp_size:
+            raise ValueError("QSA attention heads must be divisible by TP size")
+        self.num_heads = self.total_num_heads // tp_size
+        self.total_num_kv_heads = int(config.num_key_value_heads)
+        if self.total_num_kv_heads >= tp_size:
+            if self.total_num_kv_heads % tp_size:
+                raise ValueError("QSA KV heads must be divisible by TP size")
+        elif tp_size % self.total_num_kv_heads:
+            raise ValueError("TP size must be divisible by replicated QSA KV heads")
+        self.num_kv_heads = max(1, self.total_num_kv_heads // tp_size)
+        self.head_dim = int(config.head_dim or self.hidden_size // self.num_heads)
+        self.q_size = self.num_heads * self.head_dim
+        self.kv_size = self.num_kv_heads * self.head_dim
+        self.scaling = self.head_dim**-0.5
+        self.dual_chunk_attention_config = getattr(
+            config, "dual_chunk_attention_config", None
+        )
+        if self.dual_chunk_attention_config is not None:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA does not support dual-chunk RoPE"
+            )
+        # Qwen3.8-Flash-Next full-attention checkpoints always pack a sigmoid output
+        # gate next to Q, even when an inherited config default says otherwise.
+        self.attn_output_gate = True
+
+        # Imported lazily to avoid an import cycle with ``.model``.
+        from .model import without_modelopt_fp4
+
+        self.qkv_proj = QKVParallelLinear(
+            self.hidden_size,
+            self.head_dim,
+            self.total_num_heads * (1 + self.attn_output_gate),
+            self.total_num_kv_heads,
+            bias=False,
+            quant_config=without_modelopt_fp4(quant_config),
+            prefix=f"{prefix}.qkv_proj",
+        )
+        self.o_proj = RowParallelLinear(
+            self.total_num_heads * self.head_dim,
+            self.hidden_size,
+            bias=False,
+            reduce_results=reduce_results,
+            quant_config=quant_config,
+            prefix=f"{prefix}.o_proj",
+        )
+        self.rotary_emb = get_rope(
+            head_size=self.head_dim,
+            max_position=config.max_position_embeddings,
+            rope_parameters=config.rope_parameters,
+        )
+        self.q_norm = GemmaRMSNorm(self.head_dim, eps=config.rms_norm_eps)
+        self.k_norm = GemmaRMSNorm(self.head_dim, eps=config.rms_norm_eps)
+
+        mm_config = model_config.multimodal_config
+        text_only = mm_config is None or mm_config.language_model_only
+        mrope_section = getattr(self.rotary_emb, "mrope_section", None)
+        supports_mrope = bool(
+            type(self.rotary_emb) is MRotaryEmbedding
+            and mrope_section
+            and len(mrope_section) == 3
+            and sum(mrope_section) == self.rotary_emb.rotary_dim // 2
+            and getattr(self.rotary_emb, "mrope_interleaved", False)
+        )
+        supports_dtype = getattr(self.rotary_emb, "dtype", None) in (
+            torch.float16,
+            torch.bfloat16,
+        )
+        self.use_fused_qk_norm_rope_gate = (
+            self.attn_output_gate
+            and getattr(self.rotary_emb, "is_neox_style", False)
+            and current_platform.is_cuda()
+            and supports_dtype
+            and (text_only or supports_mrope)
+        )
+
+        self.layer_name = f"{prefix}.attn"
+        self.attn_type = AttentionType.DECODER
+        self.kv_cache_dtype = cache_config.cache_dtype
+        self.kv_cache_torch_dtype = kv_cache_dtype_str_to_dtype(
+            self.kv_cache_dtype, model_config
+        )
+        if self.kv_cache_torch_dtype != model_config.dtype:
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires main KV cache dtype to match "
+                f"model dtype; model={model_config.dtype}, "
+                f"cache={self.kv_cache_torch_dtype}"
+            )
+        self._runtime_dtype_validated = False
+        self.kv_sharing_target_layer_name = None
+        self.kv_cache = torch.tensor([])
+        set_default_quant_scales(self, register_buffer=True)
+
+        self.attn_backend = Qwen3_8FlashNextQSAFlashAttentionBackend
+        self.impl = Qwen3_8FlashNextQSAFlashAttentionImpl(
+            self.num_heads,
+            self.head_dim,
+            self.scaling,
+            self.num_kv_heads,
+            None,
+            None,
+            self.kv_cache_dtype,
+            None,
+            AttentionType.DECODER,
+            None,
+        )
+        self.indexer = QSAIndexer(
+            vllm_config=vllm_config,
+            config=config,
+            layer_id=layer_id,
+            rotary_emb=self.rotary_emb,
+            quant_config=quant_config,
+            prefix=f"{prefix}.indexer",
+        )
+        max_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        self.register_buffer(
+            "topk_indices_buffer",
+            torch.empty(
+                max_tokens,
+                self.indexer.output_width,
+                dtype=torch.int32,
+            ),
+            persistent=False,
+        )
+
+        static_context = vllm_config.compilation_config.static_forward_context
+        if self.layer_name in static_context:
+            raise ValueError(f"Duplicate layer name: {self.layer_name}")
+        static_context[self.layer_name] = self
+
+    def get_attn_backend(self) -> type[AttentionBackend]:
+        return self.attn_backend
+
+    def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:
+        return Qwen38FullAttentionSpec(
+            block_size=vllm_config.cache_config.block_size,
+            num_kv_heads=self.num_kv_heads,
+            head_size=self.head_dim,
+            head_size_v=self.head_dim,
+            dtype=self.kv_cache_torch_dtype,
+            kv_quant_mode=get_kv_quant_mode(self.kv_cache_dtype),
+            dcp_sharded=False,
+            max_tp_shards=self.total_num_kv_heads,
+        )
+
+    def _validate_runtime_dtypes(
+        self,
+        hidden_states: torch.Tensor,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        output: torch.Tensor,
+    ) -> None:
+        if self._runtime_dtype_validated:
+            return
+        expected_dtype = self.kv_cache_torch_dtype
+        runtime_tensors = {
+            "hidden_states": hidden_states,
+            "query": query,
+            "key": key,
+            "value": value,
+            "output": output,
+            "main_kv_cache": self.kv_cache,
+            "raw_key_cache": self.indexer.raw_key_cache.kv_cache,
+            "compressed_key_cache": self.indexer.compressed_key_cache.kv_cache,
+        }
+        mismatches = {
+            name: tensor.dtype
+            for name, tensor in runtime_tensors.items()
+            if tensor.dtype != expected_dtype
+        }
+        if mismatches:
+            actual = ", ".join(f"{name}={dtype}" for name, dtype in mismatches.items())
+            raise RuntimeError(
+                "Qwen3.8-Flash-Next QSA runtime dtype mismatch: "
+                f"expected={expected_dtype}; {actual}"
+            )
+        if _LOG_RUNTIME_DTYPE:
+            logger.info(
+                "Qwen3.8-Flash-Next QSA dtype fingerprint: tp_rank=%d, "
+                "device=%s, model_and_caches=%s",
+                get_tensor_model_parallel_rank(),
+                query.device,
+                expected_dtype,
+            )
+        self._runtime_dtype_validated = True
+
+    def _run_qsa(
+        self,
+        hidden_states: torch.Tensor,
+        positions: torch.Tensor,
+        query: torch.Tensor,
+        key: torch.Tensor,
+        value: torch.Tensor,
+        output: torch.Tensor,
+    ) -> None:
+        metadata = get_forward_context().attn_metadata
+        if isinstance(metadata, list):
+            metadata = metadata[0]
+        if not isinstance(metadata, dict):
+            output.zero_()
+            return
+        main_metadata = cast(FlashAttentionMetadata, metadata[self.layer_name])
+        if self.kv_cache.numel() == 0:
+            raise RuntimeError("QSA main K/V cache is not bound")
+        self._validate_runtime_dtypes(
+            hidden_states,
+            query,
+            key,
+            value,
+            output,
+        )
+
+        num_tokens = main_metadata.num_actual_tokens
+        side_metadata = cast(
+            QSAForwardMetadata,
+            metadata[self.indexer.raw_key_cache.prefix],
+        )
+        compressed_metadata = cast(
+            QSAForwardMetadata,
+            metadata[self.indexer.compressed_key_cache.prefix],
+        )
+        if (
+            side_metadata.num_actual_tokens != num_tokens
+            or compressed_metadata.num_actual_tokens != num_tokens
+        ):
+            raise RuntimeError("QSA main and side metadata token counts disagree")
+        num_mapped_tokens = side_metadata.num_mapped_tokens
+        if compressed_metadata.num_mapped_tokens != num_mapped_tokens:
+            raise RuntimeError("QSA side metadata mapped token counts disagree")
+        if self.kv_cache.ndim != 4:
+            raise RuntimeError("QSA main K/V cache has an invalid rank")
+        main_page_size = int(self.kv_cache.shape[2])
+        compressed_key_cache = self.indexer.compressed_key_cache.kv_cache
+        if compressed_key_cache.ndim != 4:
+            raise RuntimeError("QSA compressed key cache has an invalid rank")
+        compressed_page_size = int(compressed_key_cache.shape[1])
+        if compressed_metadata.storage_block_size != compressed_page_size:
+            raise RuntimeError(
+                "QSA compressed metadata/cache page sizes disagree: "
+                f"metadata={compressed_metadata.storage_block_size}, "
+                f"cache={compressed_page_size}"
+            )
+        if compressed_metadata.compress_ratio != self.indexer.compress_ratio:
+            raise RuntimeError(
+                "QSA compressed metadata compression ratio disagrees: "
+                f"metadata={compressed_metadata.compress_ratio}, "
+                f"indexer={self.indexer.compress_ratio}"
+            )
+        if main_page_size != compressed_page_size * int(
+            compressed_metadata.compress_ratio
+        ):
+            raise RuntimeError(
+                "QSA main/compressed page sizes are incompatible: "
+                f"main={main_page_size}, compressed={compressed_page_size}, "
+                f"ratio={compressed_metadata.compress_ratio}"
+            )
+        selected = self.indexer(
+            hidden_states,
+            positions,
+            self.topk_indices_buffer[:num_tokens],
+        )
+        if selected.shape != (
+            num_tokens,
+            self.indexer.output_width,
+        ):
+            raise RuntimeError("QSA indexer returned an invalid selection shape")
+        impl = cast(Qwen3_8FlashNextQSAFlashAttentionImpl, self.impl)
+        impl.do_kv_cache_update(
+            self,
+            key,
+            value,
+            self.kv_cache,
+            main_metadata.slot_mapping,
+        )
+        impl.forward_qsa(
+            self,
+            query,
+            key,
+            value,
+            self.kv_cache,
+            main_metadata,
+            output,
+            token_to_req=side_metadata.token_to_req,
+            num_mapped_tokens=num_mapped_tokens,
+        )
+
+    def _try_dense_qkv_postprocess(
+        self, qkv: torch.Tensor, positions: torch.Tensor, positions_bounds_proven: bool
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor] | None:
+        if not (
+            envs.VLLM_XPU_ENABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and not envs.VLLM_XPU_DISABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and positions_bounds_proven
+            and self.attn_output_gate
+            and self.head_dim == 256
+            and self.rotary_emb.rotary_dim == 64
+            and type(self.rotary_emb) is MRotaryEmbedding
+            and _raw_linear_semantics_unchanged(self.rotary_emb)
+            and any(
+                getattr(self.qkv_proj, name, False) is True
+                for name in ("_qwen4_dense_fp8", "_qwen4_dense_int4")
+            )
+        ):
+            return None
+        for norm in (self.q_norm, self.k_norm):
+            method = getattr(norm, "_forward_method", None)
+            if (
+                type(norm) is not GemmaRMSNorm
+                or norm.variance_epsilon != 1e-6
+                or not _raw_linear_semantics_unchanged(norm)
+                or getattr(method, "__func__", None)
+                not in (GemmaRMSNorm.forward_native, GemmaRMSNorm.forward_xpu)
+            ):
+                return None
+        result = try_qwen4_dense_qkv_norm_rope(
+            qkv,
+            positions,
+            self.qkv_proj,
+            self.q_norm.weight,
+            self.k_norm.weight,
+            self.rotary_emb.cos_sin_cache,
+            getattr(self.rotary_emb, "mrope_section", None),
+            getattr(self.rotary_emb, "mrope_interleaved", False),
+        )
+        if result is None:
+            return None
+        q, k, gate = result
+        value = qkv[:, self.q_size * 2 + self.kv_size :]
+        return q, k, value, gate
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        qkv, _ = self.qkv_proj(hidden_states)
+        fused_qkv = None
+        positions_bounds_proven = False
+        # The Qwen3.8 checkpoint uses true three-axis MRoPE.  Only the
+        # versioned exact ABI may consume [3, T] positions; the existing
+        # plain/text helper is restricted to 1D positions here.
+        if (
+            envs.VLLM_XPU_ENABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and not envs.VLLM_XPU_DISABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+        ):
+            if (
+                positions.ndim == 2
+                or envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+            ):
+                try:
+                    forward_context = get_forward_context()
+                except AssertionError:
+                    forward_metadata = None
+                else:
+                    forward_metadata = getattr(forward_context, "attn_metadata", None)
+                if isinstance(forward_metadata, list):
+                    forward_metadata = (
+                        forward_metadata[0] if len(forward_metadata) == 1 else None
+                    )
+                if isinstance(forward_metadata, dict):
+                    layer_metadata = forward_metadata.get(self.layer_name)
+                    positions_bounds_proven = bool(
+                        getattr(
+                            layer_metadata,
+                            "mrope_positions_bounds_proven",
+                            False,
+                        )
+                    )
+            fused_qkv = try_esimd_qkv_mrope_postprocess(
+                qkv,
+                positions,
+                projection=self.qkv_proj,
+                norm_wq=self.q_norm.weight,
+                norm_wk=self.k_norm.weight,
+                cos_sin_cache=self.rotary_emb.cos_sin_cache,
+                q_heads=self.num_heads,
+                kv_heads=self.num_kv_heads,
+                head_dim=self.head_dim,
+                rotary_dim=self.rotary_emb.rotary_dim,
+                norm_epsilon=self.q_norm.variance_epsilon,
+                mrope_section=tuple(
+                    getattr(self.rotary_emb, "mrope_section", ()) or ()
+                ),
+                mrope_interleaved=bool(
+                    getattr(self.rotary_emb, "mrope_interleaved", False)
+                ),
+                attn_output_gate=self.attn_output_gate,
+                positions_bounds_proven=positions_bounds_proven,
+            )
+        if fused_qkv is None:
+            fused_qkv = self._try_dense_qkv_postprocess(
+                qkv, positions, positions_bounds_proven
+            )
+        if (
+            fused_qkv is None
+            and positions.ndim == 1
+            and envs.VLLM_XPU_ENABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and not envs.VLLM_XPU_DISABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+        ):
+            fused_qkv = try_esimd_qkv_postprocess(
+                qkv,
+                positions,
+                projection=self.qkv_proj,
+                norm_wq=self.q_norm.weight,
+                norm_wk=self.k_norm.weight,
+                cos_sin_cache=self.rotary_emb.cos_sin_cache,
+                q_heads=self.num_heads,
+                kv_heads=self.num_kv_heads,
+                head_dim=self.head_dim,
+                rotary_dim=self.rotary_emb.rotary_dim,
+                norm_epsilon=self.q_norm.variance_epsilon,
+                is_neox_style=getattr(self.rotary_emb, "is_neox_style", False),
+                attn_output_gate=self.attn_output_gate,
+                text_only=False,
+                positions_bounds_proven=positions_bounds_proven,
+            )
+        if fused_qkv is None:
+            q, k, v, gate = self._project_qkv_gate(qkv, positions)
+            gate_is_sigmoid = False
+        else:
+            q, k, v, gate = fused_qkv
+            gate_is_sigmoid = True
+        num_tokens = hidden_states.shape[0]
+        query = q.view(num_tokens, self.num_heads, self.head_dim)
+        if not query.is_contiguous():
+            copy_bytes = query.numel() * query.element_size()
+            query = query.contiguous()
+            logger.info_once(
+                "QSA_QUERY_CONTIGUOUS_COPY bytes=%d rank=%s local_rank=%s",
+                copy_bytes,
+                os.environ.get("RANK", "unknown"),
+                os.environ.get("LOCAL_RANK", "unknown"),
+                scope="local",
+            )
+        key = k.view(num_tokens, self.num_kv_heads, self.head_dim)
+        value = v.view(num_tokens, self.num_kv_heads, self.head_dim)
+        attn_output = torch.empty_like(query)
+        encoded_layer_name = _encode_layer_name(self.layer_name)
+        if current_platform.opaque_attention_op():
+            torch.ops.vllm.qwen3_8_flash_next_qsa_with_output(
+                hidden_states,
+                positions,
+                query,
+                key,
+                value,
+                attn_output,
+                encoded_layer_name,
+            )
+        else:
+            qwen3_8_flash_next_qsa_with_output(
+                hidden_states,
+                positions,
+                query,
+                key,
+                value,
+                attn_output,
+                encoded_layer_name,
+            )
+        flat_output = attn_output.view(num_tokens, -1)
+        if (
+            gate is not None
+            and gate_is_sigmoid
+            and getattr(self.o_proj, "_qwen4_dense_fp8", False) is True
+        ):
+            from vllm.model_executor.kernels.linear.scaled_mm.xpu import (
+                try_qwen4_dense_fp8_gated_linear,
+            )
+
+            output = try_qwen4_dense_fp8_gated_linear(flat_output, gate, self.o_proj)
+            if output is not None:
+                if self.o_proj.reduce_results and self.o_proj.tp_size > 1:
+                    from .dense_all_reduce import try_dense_local_all_reduce
+
+                    if not try_dense_local_all_reduce(
+                        output, self.o_proj, flat_output, extra_inputs=(gate,)
+                    ):
+                        output = tensor_model_parallel_all_reduce(output)
+                return output
+        if gate is not None:
+            flat_output = _apply_qsa_attention_gate(flat_output, gate, gate_is_sigmoid)
+        output, _ = self.o_proj(flat_output)
+        return output
+
+
+def _apply_qsa_attention_gate(
+    flat_output: torch.Tensor,
+    gate: torch.Tensor,
+    gate_is_sigmoid: bool,
+) -> torch.Tensor:
+    if not gate_is_sigmoid:
+        gate = torch.sigmoid(gate)
+    can_update_in_place = (
+        flat_output.shape[0] == 1
+        and flat_output.shape == gate.shape
+        and flat_output.is_contiguous()
+        and gate.is_contiguous()
+        and flat_output.dtype == gate.dtype
+        and flat_output.device == gate.device
+        and not flat_output.requires_grad
+        and not gate.requires_grad
+        and not torch._C._is_alias_of(flat_output, gate)
+    )
+    if can_update_in_place:
+        flat_output.mul_(gate)
+        return flat_output
+    return flat_output * gate
+
+
+@eager_break_during_capture
+def qwen3_8_flash_next_qsa_with_output(
+    hidden_states: torch.Tensor,
+    positions: torch.Tensor,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: LayerNameType,
+) -> None:
+    """Run the complete QSA state/update/attend transaction."""
+    layer_name = _resolve_layer_name(layer_name)
+    layer = get_forward_context().no_compile_layers[layer_name]
+    if not isinstance(layer, Qwen3_8FlashNextQSAAttention):
+        raise TypeError(f"{layer_name} is not a Qwen3.8-Flash-Next QSA owner")
+    layer._run_qsa(
+        hidden_states,
+        positions,
+        query,
+        key,
+        value,
+        output,
+    )
+
+
+def qwen3_8_flash_next_qsa_with_output_fake(
+    hidden_states: torch.Tensor,
+    positions: torch.Tensor,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: LayerNameType,
+) -> None:
+    del hidden_states, positions, query, key, value, output, layer_name
+
+
+direct_register_custom_op(
+    op_name="qwen3_8_flash_next_qsa_with_output",
+    op_func=qwen3_8_flash_next_qsa_with_output,
+    mutates_args=["output"],
+    fake_impl=qwen3_8_flash_next_qsa_with_output_fake,
+)
+
+
+__all__ = [
+    "QSAIndexer",
+    "Qwen3_8FlashNextQSAAttention",
+    "Qwen3_8FlashNextQSAFlashAttentionBackend",
+    "Qwen3_8FlashNextQSAFlashAttentionImpl",
+    "qwen3_8_flash_next_qsa_with_output",
+]
