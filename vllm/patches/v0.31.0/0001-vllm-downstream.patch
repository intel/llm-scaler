+    def get_qsa_ring_size(
+        self, request_id: str, ring_group_id: int | None = None
+    ) -> int | None:
+        for manager in self.single_type_managers:
+            if (
+                isinstance(manager, Qwen38CircularBufferManager)
+                and (
+                    ring_group_id is None
+                    or manager.kv_cache_group_id == ring_group_id
+                )
+            ):
+                return manager.get_qsa_ring_size(request_id)
+        return None
+
+    def revoke_qsa_ring_owner(
+        self,
+        request_id: str,
+        *,
+        lease: QSAHistoricalRingLease | None = None,
+        ring_group_id: int | None = None,
+    ) -> bool:
+        # A request may own several independent circular side-cache groups.
+        # Revoke every matching owner before returning; stopping at the first
+        # manager would leave another group readable after request finish.
+        revoked = False
+        matched = False
+        for manager in self.single_type_managers:
+            if (
+                isinstance(manager, Qwen38CircularBufferManager)
+                and (
+                    ring_group_id is None
+                    or manager.kv_cache_group_id == ring_group_id
+                )
+            ):
