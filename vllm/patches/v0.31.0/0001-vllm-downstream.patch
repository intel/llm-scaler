+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Small ordinary Qwen3.8 GDN decode metadata with an optional SYCL gather."""
+
+from functools import lru_cache
+from importlib import import_module
+
+import torch
+
+
+def enabled(config, device: torch.device) -> bool:
+    model = config.model_config
+    if device.type != "xpu" or model is None:
+        return False
+    text = model.hf_text_config
+    if (
+        getattr(text, "hidden_size", None),
+        getattr(text, "hc_count", None),
+        getattr(text, "hc_lowrank", None),
+        getattr(text, "num_experts", None),
+    ) != (2560, 4, 320, 512):
+        return False
+
+    from vllm import envs
+
+    from .full_decode import full_decode_enabled
+
+    parallel = config.parallel_config
+    return bool(
+        full_decode_enabled(config)
+        and not config.use_v2_model_runner
+        and model.dtype == torch.float16
+        and (parallel.tensor_parallel_size, model.quantization)
+        in {(4, "sym_int4"), (8, "sym_int4"), (8, "fp8_per_tensor")}
+        and envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+        and config.cache_config.mamba_ssm_cache_dtype == "float16"
+        and config.cache_config.mamba_cache_mode == "align"
+        and config.scheduler_config.async_scheduling
+        and parallel.pipeline_parallel_size == parallel.data_parallel_size == 1
+        and not parallel.enable_expert_parallel
+        and not parallel.enable_eplb
+        and not parallel.use_sequence_parallel_moe
+        and not parallel.enable_dbo
+        and not parallel.use_ubatching
+        and config.lora_config is None
+        and _operation() is not None
+    )
+
+
+@lru_cache(maxsize=1)
+def _operation():
+    try:
+        module = import_module("vllm_xpu_kernels._qwen38_metadata_C")
+    except (ImportError, OSError):
+        return None
+    operation = getattr(module, "try_mamba_align", None)
+    if getattr(module, "mamba_metadata_sycl_abi_version", None) != 1:
+        return None
+    return operation if callable(operation) else None
+
+
+def try_build_gdn(builder, metadata, num_accepted_tokens, num_draft_tokens_cpu):
+    """Return None before submission for prefill, padding, spec or old packages."""
+    rows = metadata.num_reqs
+    if not (
+        1 <= rows <= 8
+        and metadata.num_actual_tokens == rows
+        and metadata.max_query_len == 1
+        and num_accepted_tokens is None
+        and num_draft_tokens_cpu is None
+        and not builder.use_spec_decode
+        and getattr(builder, "mamba_aligned_state_indices", None) is None
+        and builder.kv_cache_spec.num_speculative_blocks == 0
+    ):
+        return None
+    starts = metadata.query_start_loc_cpu
+    upper = metadata.seq_lens_cpu_upper_bound
+    prefilling = metadata.is_prefilling
+    from vllm.model_executor.models._qwen3_next_xpu import _direct_parameters
+
+    if not _direct_parameters(
+        starts,
+        upper,
+        prefilling,
+        metadata.query_start_loc,
+        metadata.block_table_tensor,
+        metadata.seq_lens,
+    ):
+        return None
+    if not (
+        starts.device.type == "cpu"
+        and starts.dtype == torch.int32
+        and starts.shape == (rows + 1,)
+        and starts.is_contiguous()
+        and upper is not None
+        and upper.device.type == "cpu"
+        and upper.dtype == torch.int32
+        and upper.shape == (rows,)
+        and upper.is_contiguous()
+        and (
+            prefilling is None
+            or (
+                prefilling.device.type == "cpu"
+                and prefilling.dtype == torch.bool
+                and prefilling.shape == (rows,)
+                and prefilling.is_contiguous()
+            )
+        )
+    ):
+        return None
+    if starts.tolist() != list(range(rows + 1)):
+        return None
+    if prefilling is not None:
+        flags = prefilling.tolist()
+        if any(flags) and any(
+            flag and length <= 1 for flag, length in zip(flags, upper.tolist())
+        ):
+            return None
+    operation = _operation()
+    if operation is None:
+        return None
+    indices = operation(
+        metadata.block_table_tensor,
+        metadata.seq_lens,
+        builder.kv_cache_spec.block_size,
+        0,
+    )
+    if indices is None:
+        return None
+    # The kernel is now submitted: all subsequent failures propagate.
+    from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+
+    return GDNAttentionMetadata(
+        num_prefills=0,
+        num_prefill_tokens=0,
+        num_decodes=rows,
+        num_decode_tokens=rows,
+        num_spec_decodes=0,
+        num_spec_decode_tokens=0,
+        num_actual_tokens=rows,
+        non_spec_query_start_loc=metadata.query_start_loc,
+        non_spec_state_indices_tensor=indices[:, 0],
+    )
