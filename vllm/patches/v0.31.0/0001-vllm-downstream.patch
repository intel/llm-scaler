+def _try_hc_gate_mix_multi_m(
+    x: torch.Tensor,
+    gate: torch.Tensor,
+    hc_count: int,
+    output: torch.Tensor | None,
+) -> torch.Tensor | None:
+    if x.ndim != 2 or not _is_hc_multi_m_rows(int(x.shape[0])):
+        return None
+    if _hc_gate_mix_multi_m_input_fallback_reason(x, gate, hc_count) is not None:
+        return None
+
+    work_units = int(x.shape[0])
+    _record_hc_gate_mix(EVENT_ATTEMPT, work_units)
+    if output is None:
+        output = torch.empty(
+            (x.shape[0], _HC_GATE_MIX_HIDDEN_SIZE),
+            dtype=x.dtype,
+            device=x.device,
+        )
+    reason = _hc_gate_mix_multi_m_fallback_reason(x, gate, hc_count, output)
+    if reason is not None:
+        _record_hc_gate_mix(EVENT_FALLBACK, work_units, reason)
+        return None
+
+    _record_hc_gate_mix(EVENT_ELIGIBLE, work_units)
+    operation = _get_hc_gate_mix_multi_m_operation()
+    if operation is None and work_units == 4:
+        operation = _get_hc_gate_mix_m4_operation()
+    if operation is None:
+        _record_hc_gate_mix(EVENT_FALLBACK, work_units, REASON_OP_UNAVAILABLE)
+        return None
+
+    _record_hc_gate_mix(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(x, gate, output)
+    except Exception:
+        _record_hc_gate_mix(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return output
+
+
+def _hc_gate_mix_torch(
+    x: torch.Tensor,
+    gate: torch.Tensor,
+    hc_count: int,
+) -> torch.Tensor:
+    hidden_size = x.shape[-1] // hc_count
+    gated = torch.sigmoid(
+        gate.float().unflatten(-1, (hc_count, hidden_size))
+    ) * x.float().unflatten(-1, (hc_count, hidden_size))
+    return gated.mean(-2).to(x.dtype)
+
+
+def hc_gate_mix(
+    x: torch.Tensor,
+    gate: torch.Tensor,
+    hc_count: int,
+    *,
+    output: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Sigmoid-gated HC mean with an optional native output buffer."""
+    dense = _try_hc_dense("gate_mix", x, (gate,), hc_count, (output,))
+    if dense is not None:
+        return dense[0]
+    work_units = int(x.shape[0]) if x.ndim else 1
+    prefill = _try_hc_prefill("gate_mix", x, (gate,), hc_count, (output,))
+    if prefill is not None:
+        return prefill[0]
+    if x.numel() == 0:
+        _record_hc_gate_mix(EVENT_ZERO_WORK_SKIP, 0)
+        return _hc_gate_mix_torch(x, gate, hc_count)
+
+    multi_output = _try_hc_gate_mix_multi_m(x, gate, hc_count, output)
+    if multi_output is not None:
+        return multi_output
+
+    _record_hc_gate_mix(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_gate_mix_native_fallback_reason(
+            x,
+            gate,
+            hc_count,
+            output,
+        )
+    except Exception:
+        _record_hc_gate_mix(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_gate_mix(EVENT_FALLBACK, work_units, reason)
+        return _hc_gate_mix_torch(x, gate, hc_count)
+
+    _record_hc_gate_mix(EVENT_ELIGIBLE, work_units)
+    try:
+        operation = _get_hc_gate_mix_operation()
+    except Exception:
+        _record_hc_gate_mix(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if operation is None:
+        _record_hc_gate_mix(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return _hc_gate_mix_torch(x, gate, hc_count)
+
+    assert output is not None
+    _record_hc_gate_mix(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(x, gate, output)
+    except Exception:
+        _record_hc_gate_mix(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return output
+
+
+def _is_four_byte_aligned_fp16_view(tensor: torch.Tensor) -> bool:
+    return tensor.storage_offset() % 2 == 0
+
