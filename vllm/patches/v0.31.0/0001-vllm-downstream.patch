+def _maybe_fused_hc_class(fallback):
+    from vllm import envs
+
+    if not envs.VLLM_XPU_QWEN38_FUSED_HC:
+        return fallback
+    try:
+        from vllm_xpu_kernels.qwen38_hc_fused import wrap_workspace_class
+    except (ImportError, OSError):
+        return fallback
+    return wrap_workspace_class(fallback)
