+def _find_esimd_package_dir() -> Path:
+    configured = os.environ.get(_ESIMD_PACKAGE_DIR_ENV)
+    if configured:
+        package_dir = Path(configured).expanduser()
+        if not package_dir.is_absolute():
+            raise RuntimeError(
+                f"{_ESIMD_PACKAGE_DIR_ENV} must be an absolute path: {package_dir}"
+            )
+        package_dir = package_dir.resolve()
+        if not package_dir.is_dir():
+            raise RuntimeError(
+                f"custom ESIMD package directory is missing: {package_dir}"
+            )
+        return package_dir
+
+    try:
+        distribution = importlib.metadata.distribution("custom-esimd-kernels-vllm")
+    except importlib.metadata.PackageNotFoundError as exc:
+        raise ImportError("custom-esimd-kernels-vllm is not installed") from exc
+
+    package_dir = Path(distribution.locate_file("custom_esimd_kernels_vllm"))
+    if package_dir.is_dir():
+        return package_dir
+    raise RuntimeError(f"custom ESIMD package directory is missing: {package_dir}")
+
+
+def ensure_esimd_package_path() -> Path:
+    """Make a configured source package visible to Python submodule imports."""
+    package_dir = _find_esimd_package_dir()
+    package = sys.modules.get(_ESIMD_PACKAGE_NAME)
+    if package is None:
+        package_parent = str(package_dir.parent)
+        if package_parent not in sys.path:
+            sys.path.insert(0, package_parent)
+    else:
+        package_path = getattr(package, "__path__", None)
+        if package_path is not None and str(package_dir) not in package_path:
+            package_path.insert(0, str(package_dir))
+    return package_dir
+
+
+def _dispatcher_has_schema(schema: str) -> bool:
+    operator_name, separator, _ = schema.partition("(")
+    registered = torch._C._jit_get_schemas_for_operator(operator_name)
+    if not separator:
+        return bool(registered)
+    return schema in {str(registered_schema) for registered_schema in registered}
+
+
+def _standalone_ple_is_loaded() -> bool:
+    """Detect a PLE-only owner before the production loader touches a DSO."""
+    return _PLE_STANDALONE_LOADED is not None or (
+        any(_dispatcher_has_schema(schema) for schema in _PLE_STANDALONE_SCHEMAS)
+        and not _dispatcher_has_schema(_MAIN_SCHEMA)
+    )
+
+
+def load_qwen38_ple_standalone_library(
+    path: str | os.PathLike[str] | None = None,
+) -> bool:
+    """Load the explicitly selected Qwen3.8 PLE-only DSO once per process.
+
+    The production ESIMD loader intentionally does not discover this artifact:
+    it registers the same dispatcher namespace as the main extension.  A
+    caller must opt in with ``VLLM_XPU_QWEN38_PLE_STANDALONE_DSO`` (or pass an
+    explicit path), and this helper refuses an already-owned namespace rather
+    than risking duplicate operator registration.
+    """
+    global _PLE_STANDALONE_LOADED
+    selected = path
+    if selected is None:
+        selected = os.environ.get(_PLE_STANDALONE_DSO_ENV)
+    if not selected:
+        return False
+
+    with _PLE_NAMESPACE_LOCK:
+        candidate = Path(selected)
+        if not candidate.is_absolute():
+            raise ImportError(
+                f"Qwen3.8 PLE standalone DSO path must be absolute: {candidate}"
+            )
+        if not candidate.is_file():
+            raise ImportError(f"Qwen3.8 PLE standalone DSO does not exist: {candidate}")
+        candidate = candidate.resolve()
+        if candidate == _PLE_STANDALONE_LOADED:
+            return True
+
+        if (
+            _PLE_PRODUCTION_OWNER is not None
+            or _dispatcher_has_schema(_MAIN_SCHEMA)
+            or any(_dispatcher_has_schema(schema) for schema in _PLE_STANDALONE_SCHEMAS)
+        ):
+            raise RuntimeError(
+                "Qwen3.8 PLE dispatcher namespace is already owned by another DSO"
+            )
+
+        try:
+            torch.ops.load_library(str(candidate))
+        except OSError as exc:
+            raise ImportError(
+                f"Qwen3.8 PLE standalone DSO could not be loaded: {candidate}"
+            ) from exc
+
+        missing = [
+            schema
+            for schema in _PLE_STANDALONE_SCHEMAS
+            if not _dispatcher_has_schema(schema)
+        ]
+        if missing:
+            raise RuntimeError(
+                "Qwen3.8 PLE standalone DSO is missing schemas: " + ", ".join(missing)
+            )
+        _PLE_STANDALONE_LOADED = candidate
+        return True
+
+
+def _extension_candidates(package_dir: Path, prefix: str) -> list[Path]:
+    """Return exact extension-prefix matches, excluding similarly named DSOs."""
+    candidates = {
+        candidate
+        for pattern in (f"{prefix}.so", f"{prefix}.*.so")
+        for candidate in package_dir.glob(pattern)
+        if candidate.is_file()
+    }
+    return sorted(candidates)
+
+
+def _require_single_extension(package_dir: Path, prefix: str) -> Path:
+    candidates = _extension_candidates(package_dir, prefix)
+    if not candidates:
+        raise ImportError(
+            f"custom ESIMD shared library is missing from {package_dir}: {prefix}"
+        )
+    if len(candidates) != 1:
+        formatted = ", ".join(str(candidate) for candidate in candidates)
+        raise RuntimeError(
+            f"custom ESIMD shared library prefix is ambiguous for {prefix}: {formatted}"
+        )
+    return candidates[0]
+
+
+def _ensure_qwen38_ple_production_owner() -> Path:
+    """Load and verify the canonical main DSO before caching PLE ownership."""
+    global _PLE_PRODUCTION_OWNER, _PLE_PRODUCTION_READY
+
+    with _PLE_NAMESPACE_LOCK:
+        if _PLE_PRODUCTION_OWNER is not None:
+            if not _PLE_PRODUCTION_READY:
+                raise RuntimeError("canonical ESIMD PLE owner cache is inconsistent")
+            return _PLE_PRODUCTION_OWNER
+
+        _PLE_PRODUCTION_READY = False
+        if _PLE_STANDALONE_LOADED is not None or _standalone_ple_is_loaded():
+            raise RuntimeError(
+                "standalone PLE DSO is already loaded; production ESIMD extensions "
+                "must be loaded in a separate process"
+            )
+
+        package_dir = _find_esimd_package_dir()
+        owner = _require_single_extension(package_dir, _MAIN_EXTENSION_PREFIX).resolve()
+        try:
+            # A pre-registered dispatcher anchor does not prove which DSO owns it.
+            # The configured package directory is the administrator trust boundary,
+            # so always dlopen its exact canonical main DSO before caching ownership.
+            torch.ops.load_library(str(owner))
+        except (ImportError, OSError) as exc:
+            raise RuntimeError(
+                f"canonical ESIMD main DSO could not be loaded: {owner}"
+            ) from exc
+
+        if not _dispatcher_has_schema(_MAIN_SCHEMA):
+            raise RuntimeError(
+                "canonical ESIMD main DSO is missing required schema: " + _MAIN_SCHEMA
+            )
+        missing = [
+            schema for schema in _PLE_SCHEMAS if not _dispatcher_has_schema(schema)
+        ]
+        if missing:
+            raise RuntimeError(
+                "canonical ESIMD main DSO is missing Qwen3.8 PLE schemas: "
+                + ", ".join(missing)
+            )
+
+        _PLE_PRODUCTION_OWNER = owner
+        _PLE_PRODUCTION_READY = True
+        return owner
+
+
+def _load_esimd_extensions() -> None:
+    global _ESIMD_LOADED
+    with _PLE_NAMESPACE_LOCK:
+        if _ESIMD_LOADED:
+            return
+        if _standalone_ple_is_loaded():
+            raise RuntimeError(
+                "standalone PLE DSO is already loaded; production ESIMD extensions "
+                "must be loaded in a separate process"
+            )
+
+        package_dir = _find_esimd_package_dir()
+        # The canonical prefix must not fall through to the GEMM/MoE/LGRF variants.
+        main = _require_single_extension(package_dir, _MAIN_EXTENSION_PREFIX)
+        if not _dispatcher_has_schema(_MAIN_SCHEMA):
+            try:
+                torch.ops.load_library(str(main))
+            except OSError as exc:
+                raise RuntimeError(
+                    f"custom ESIMD shared library could not be loaded: {main}"
+                ) from exc
+        if not _dispatcher_has_schema(_MAIN_SCHEMA):
+            raise RuntimeError(
+                "custom ESIMD main DSO is missing required schema: " + _MAIN_SCHEMA
+            )
+
+        for prefix in _ESIMD_EXTENSION_PREFIXES[1:]:
+            if any(
+                _dispatcher_has_schema(schema)
+                for schema in _ESIMD_EXTENSION_SCHEMAS[prefix]
+            ):
+                continue
+            candidates = _extension_candidates(package_dir, prefix)
+            if not candidates:
+                continue
+            if len(candidates) != 1:
+                formatted = ", ".join(str(candidate) for candidate in candidates)
+                raise RuntimeError(
+                    f"custom ESIMD shared library prefix is ambiguous for {prefix}: "
+                    f"{formatted}"
+                )
+            torch.ops.load_library(str(candidates[0]))
+
+        _ESIMD_LOADED = True
+
+
+def load_esimd_library(prefix: str) -> None:
+    """Load one known optional extension without importing its Python package."""
+    if prefix == _PLE_ONLY_PREFIX:
+        raise ImportError(
+            "ple_ops is a standalone-only DSO and cannot be loaded by the "
+            "production ESIMD loader"
+        )
+    if prefix not in _ESIMD_OPTIONAL_PREFIXES:
+        allowed = ", ".join(sorted(_ESIMD_OPTIONAL_PREFIXES))
+        raise ValueError(
+            f"unsupported custom ESIMD library prefix {prefix!r}; "
+            f"allowed prefixes: {allowed}"
+        )
+
+    with _PLE_NAMESPACE_LOCK:
+        if _standalone_ple_is_loaded():
+            raise RuntimeError(
+                "standalone PLE DSO is already loaded; optional production ESIMD "
+                "libraries must be loaded in a separate process"
+            )
+
+        package_dir = _find_esimd_package_dir()
+        candidate = _require_single_extension(package_dir, prefix)
+        try:
+            torch.ops.load_library(str(candidate))
+        except OSError as exc:
+            raise RuntimeError(
+                f"custom ESIMD shared library could not be loaded: {candidate}"
+            ) from exc
+
