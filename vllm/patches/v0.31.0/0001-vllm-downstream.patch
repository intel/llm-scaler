+        # FusedMoE may intentionally use effective EP=1; align this fixed-ABI
+        # caller with the effective MoE config and full-expert weight layout.
+        moe_config = getattr(self.experts, "moe_config", None)
+        moe_parallel_config = getattr(moe_config, "moe_parallel_config", None)
+        effective_ep_size = getattr(moe_parallel_config, "ep_size", None)
+        effective_ep_rank = getattr(moe_parallel_config, "ep_rank", None)
+        if (
+            isinstance(effective_ep_size, int)
+            and effective_ep_size > 0
+            and isinstance(effective_ep_rank, int)
+        ):
+            self.ep_size = effective_ep_size
+            self.ep_rank = effective_ep_rank
+            self.n_local_physical_experts = self.n_physical_experts // effective_ep_size
+            self.physical_expert_start = self.ep_rank * self.n_local_physical_experts
+            self.physical_expert_end = (
+                self.physical_expert_start + self.n_local_physical_experts
+            )
+        self.n_shared_experts = int(config.shared_expert_intermediate_size > 0)
+        self._qwen38_moe_m1_asymmetric_plan: _Qwen38MoeM1AsymmetricPlan | None = None
+        self._qwen38_moe_m1_asymmetric_outputs: dict[
+            tuple[torch.device, object, tuple[int, ...]], torch.Tensor
+        ] = {}
+        self._qwen38_moe_multi_m_asymmetric_plan: _Qwen38MoeM1AsymmetricPlan | None = (
+            None
