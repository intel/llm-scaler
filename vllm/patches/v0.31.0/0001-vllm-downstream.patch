+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperConnection (HC) glue ops for Intel XPU.
+
+Torch fallbacks mirror the CUDA reference in ``nvidia/ops/hc.py``.
+Supported FP16 shapes use native kernels with caller-owned outputs and
+FP32 reductions. The SYCL dense-HC path supports M=1..8 for decode and
+M=9..8192 for grouped norm, combine-and-norm, and gate mix during uncaptured
+prefill when the loaded DSO advertises the larger-M capability.
+"""
+
+import math
+import os
+from functools import lru_cache
+
+import torch
+import torch.nn.functional as F
+
+import vllm.envs as envs
+from vllm.model_executor.layers.esimd_utils import (
+    Qwen38HCOpUnavailableError,
+    get_qwen38_hc_op,
+    using_qwen38_sycl,
+)
+
+from ..audit import (
+    EVENT_ATTEMPT,
+    EVENT_ELIGIBLE,
+    EVENT_FALLBACK,
+    EVENT_HARD_ERROR_POST_SUBMIT,
+    EVENT_HARD_ERROR_PREFLIGHT,
+    EVENT_NATIVE_SUBMITTED,
+    EVENT_ZERO_WORK_SKIP,
+    NATIVE_STATS,
+    NATIVE_STATS_ENABLED,
+    PATH_HC_COMBINE,
+    PATH_HC_COMBINE_NORM,
+    PATH_HC_GATE_MIX,
+    PATH_HC_GROUPED_NORM,
+    PATH_HC_PROJECTION,
+    REASON_COMPILE_GRAPH,
+    REASON_DEVICE,
+    REASON_DISABLED,
+    REASON_DTYPE,
+    REASON_LAYOUT,
+    REASON_NONE,
+    REASON_OP_UNAVAILABLE,
+    REASON_OTHER_CONTRACT,
+    REASON_SHAPE,
+)
+from ..parameter_dispatch import standard_direct_parameters, standard_parameter_context
+
+_HC_GROUPED_NORM_COUNT = 4
+_HC_GROUPED_NORM_HIDDEN_SIZE = 2560
+_HC_GROUPED_NORM_WIDTH = _HC_GROUPED_NORM_COUNT * _HC_GROUPED_NORM_HIDDEN_SIZE
+_HC_GROUPED_NORM_OP_NAME = "hc_grouped_norm_v1"
+_HC_GROUPED_NORM_OPERATION = None
+_HC_GROUPED_NORM_OPERATION_RESOLVED = False
+_HC_GATE_MIX_COUNT = 4
+_HC_GATE_MIX_HIDDEN_SIZE = 2560
+_HC_GATE_MIX_WIDTH = _HC_GATE_MIX_COUNT * _HC_GATE_MIX_HIDDEN_SIZE
+_HC_GATE_MIX_OP_NAME = "hc_gate_mix_v1"
+_HC_GATE_MIX_OPERATION = None
+_HC_GATE_MIX_OPERATION_RESOLVED = False
+_HC_GATE_MIX_M4_OP_NAME = "hc_gate_mix_m4_v1"
+_HC_GATE_MIX_M4_OPERATION = None
+_HC_GATE_MIX_M4_OPERATION_RESOLVED = False
+_HC_GATE_MIX_MULTI_M_OP_NAME = "hc_gate_mix_multi_m_v1"
+_HC_GATE_MIX_MULTI_M_OPERATION = None
+_HC_GATE_MIX_MULTI_M_OPERATION_RESOLVED = False
+_HC_COMBINE_COUNT = 4
+_HC_COMBINE_HIDDEN_SIZE = 2560
+_HC_COMBINE_WIDTH = _HC_COMBINE_COUNT * _HC_COMBINE_HIDDEN_SIZE
+_HC_COMBINE_OP_NAME = "hc_combine_v1"
+_HC_COMBINE_OPERATION = None
+_HC_COMBINE_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_OP_NAME = "hc_combine_norm_v1"
+_HC_COMBINE_NORM_OPERATION = None
+_HC_COMBINE_NORM_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_M4_OP_NAME = "hc_combine_norm_m4_v1"
+_HC_COMBINE_NORM_M4_OPERATION = None
+_HC_COMBINE_NORM_M4_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_MULTI_M_OP_NAME = "hc_combine_norm_multi_m_v1"
+_HC_COMBINE_NORM_MULTI_M_OPERATION = None
+_HC_COMBINE_NORM_MULTI_M_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION = None
+_HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION_RESOLVED = False
+_HC_PROJECTION_DOWN_OP_NAME = "esimd_hc_down_fp16_out"
+_HC_PROJECTION_UP_OP_NAME = "esimd_gemv_fp16"
+_HC_PROJECTION_OPERATIONS = None
+_HC_PROJECTION_OPERATIONS_RESOLVED = False
+_HC_PROJECTION_COUNT = 4
+_HC_PROJECTION_RANK = 320
+_HC_PROJECTION_WIDTH = 10240
+_HC_PROJECTION_MERGED_WIDTH = 336
+_HC_FP32_MIN_POSITIVE = 2.0**-149
+_HC_FP32_MAX = (2.0 - 2.0**-23) * 2.0**127
+_HC_MULTI_M_MIN = 2
+_HC_MULTI_M_MAX = 8
+
+
+@lru_cache(maxsize=8)
+def _get_hc_dense_operation(kind: str):
+    try:
+        import vllm_xpu_kernels.qwen38  # noqa: F401
+    except ModuleNotFoundError as error:
+        if error.name not in ("vllm_xpu_kernels", "vllm_xpu_kernels.qwen38"):
+            raise
+        return None
+    return getattr(torch.ops._qwen38_C, "hc_dense_" + kind, None)
+
+
+def try_hc_dense_down(
+    x: torch.Tensor, weight: torch.Tensor | None, hc_count: int
+) -> torch.Tensor | None:
+    """Fuse the TP2 FP16 down projection and SiLU, excluding padding rows."""
+    if (
+        weight is None
+        or envs.VLLM_BATCH_INVARIANT
+        or not using_qwen38_sycl()
+        or torch.compiler.is_compiling()
+        or hc_count != 4
+        or x.device.type != "xpu"
+        or x.dtype != torch.float16
+        or x.ndim != 2
+        or not 1 <= x.shape[0] <= 8
+        or x.shape[1] != 20480
+        or not x.is_contiguous()
+        or x.storage_offset() % 2
+        or weight.device != x.device
+        or weight.dtype != x.dtype
+        or weight.shape not in ((320, 20480), (336, 20480))
+        or not weight.is_contiguous()
+        or weight.storage_offset() % 2
+        or not standard_direct_parameters(x, weight)
+        or os.getenv("VLLM_XPU_DISABLE_QWEN4_HC_NATIVE", "0") == "1"
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_PROJECTION_NATIVE
+        or envs.VLLM_XPU_DISABLE_QWEN38_HC_PROJECTION_NATIVE
+    ):
+        return None
+    if x.shape[0] >= 3 and (x.data_ptr() % 64 or weight.data_ptr() % 64):
+        return None
+    kind = "down_silu" if x.shape[0] == 1 else "down_silu_smallm"
+    operation = _get_hc_dense_operation(kind)
+    if operation is None:
+        return None
+    width = 320 if weight.shape[0] == 320 else 324
+    output = torch.empty((x.shape[0], width), dtype=x.dtype, device=x.device)
+    with standard_parameter_context(x, weight, output):
+        operation(x, weight, output)
+    return output
+
+
+def _hc_dense_tp1_down_inputs(
+    x: torch.Tensor, weight: torch.Tensor | None, hc_count: int
+) -> bool:
+    return bool(
+        weight is not None
+        and not envs.VLLM_BATCH_INVARIANT
+        and using_qwen38_sycl()
+        and not torch.compiler.is_compiling()
+        and hc_count == 4
+        and x.device.type == "xpu"
+        and x.dtype == torch.float16
+        and x.ndim == 2
+        and 1 <= x.shape[0] <= 8
+        and x.shape[1] == 20480
+        and x.is_contiguous()
+        and x.data_ptr() % 64 == 0
+        and weight.device == x.device
+        and weight.dtype == x.dtype
+        and weight.shape in ((640, 20480), (656, 20480))
+        and weight.is_contiguous()
+        and weight.data_ptr() % 64 == 0
+        and standard_direct_parameters(x, weight)
+        and os.getenv("VLLM_XPU_DISABLE_QWEN4_HC_NATIVE", "0") != "1"
+        and envs.VLLM_XPU_ENABLE_QWEN38_HC_PROJECTION_NATIVE
+        and not envs.VLLM_XPU_DISABLE_QWEN38_HC_PROJECTION_NATIVE
+    )
+
+
+def try_hc_dense_down_tp1(
+    x: torch.Tensor, weight: torch.Tensor | None, hc_count: int
+) -> tuple[torch.Tensor, torch.Tensor | None] | None:
+    """Keep rank-640 low output contiguous for the TP1 up projection."""
+    if not _hc_dense_tp1_down_inputs(x, weight, hc_count):
+        return None
+    operation = _get_hc_dense_operation("down_silu_tp1")
+    if operation is None:
+        return None
+    assert weight is not None
+    low = torch.empty((x.shape[0], 640), dtype=x.dtype, device=x.device)
+    injection = (
+        torch.empty((x.shape[0], 4), dtype=x.dtype, device=x.device)
+        if weight.shape[0] == 656
+        else None
+    )
+    outputs = (low,) if injection is None else (low, injection)
+    if not standard_direct_parameters(*outputs):
+        return None
+    with standard_parameter_context(x, weight, *outputs):
+        operation(x, weight, low, injection)
+    return low, injection
+
+
+def try_hc_dense_tp1_mix(
+    x: torch.Tensor,
+    down_weight: torch.Tensor | None,
+    up_weight: torch.Tensor | None,
+    hc_count: int,
+) -> tuple[torch.Tensor, torch.Tensor | None] | None:
+    """TP1 down/SiLU then up/FP16 gate/sigmoid/stream mean in two kernels."""
+    if (
+        not _hc_dense_tp1_down_inputs(x, down_weight, hc_count)
+        or up_weight is None
+        or up_weight.device != x.device
+        or up_weight.dtype != x.dtype
+        or up_weight.shape != (20480, 640)
+        or not up_weight.is_contiguous()
+        or up_weight.data_ptr() % 64
+        or not standard_direct_parameters(up_weight)
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_GATE_MIX_NATIVE
+        or envs.VLLM_XPU_DISABLE_QWEN38_HC_GATE_MIX_NATIVE
+    ):
+        return None
+    # Both optional stages are resolved before allocating or submitting any work.
+    down_operation = _get_hc_dense_operation("down_silu_tp1")
+    up_operation = _get_hc_dense_operation("up_gate_mix_tp1")
+    if down_operation is None or up_operation is None:
+        return None
+    assert down_weight is not None
+    low = torch.empty((x.shape[0], 640), dtype=x.dtype, device=x.device)
+    injection = (
+        torch.empty((x.shape[0], 4), dtype=x.dtype, device=x.device)
+        if down_weight.shape[0] == 656
+        else None
+    )
+    mixed = torch.empty((x.shape[0], 5120), dtype=x.dtype, device=x.device)
+    outputs = (low, mixed) if injection is None else (low, mixed, injection)
+    if not standard_direct_parameters(*outputs):
+        return None
+    with standard_parameter_context(x, down_weight, up_weight, *outputs):
+        down_operation(x, down_weight, low, injection)
+        up_operation(low, up_weight, x, mixed)
+    return mixed, injection
+
+
+def _try_hc_dense(
+    kind: str,
+    hidden: torch.Tensor,
+    inputs: tuple[torch.Tensor, ...],
+    hc_count: int,
+    outputs: tuple[torch.Tensor | None, ...],
+    eps: float | None = None,
+) -> tuple[torch.Tensor, ...] | None:
+    if (
+        hidden.ndim != 2
+        or not 1 <= hidden.shape[0] <= 8
+        or hidden.shape[1] != 20480
+        or hidden.dtype != torch.float16
+        or hidden.device.type != "xpu"
+        or hc_count != 4
+        or not using_qwen38_sycl()
+        or torch.compiler.is_compiling()
+        or os.getenv("VLLM_XPU_DISABLE_QWEN4_HC_NATIVE", "0") == "1"
+        or not standard_direct_parameters(
+            hidden, *inputs, *(output for output in outputs if output is not None)
+        )
+        or not hidden.is_contiguous()
+    ):
+        return None
+    suffix = kind.upper()
+    if not getattr(envs, f"VLLM_XPU_ENABLE_QWEN38_HC_{suffix}_NATIVE") or getattr(
+        envs, f"VLLM_XPU_DISABLE_QWEN38_HC_{suffix}_NATIVE"
+    ):
+        return None
+    operation = _get_hc_dense_operation(kind)
+    if operation is None:
+        return None
+    if any(t.device != hidden.device or t.dtype != hidden.dtype for t in inputs):
+        return None
+    if eps is not None and (
+        not math.isfinite(eps) or not _HC_FP32_MIN_POSITIVE <= eps <= _HC_FP32_MAX
+    ):
+        return None
+    if kind in ("grouped_norm", "combine_norm"):
+        weight = inputs[-1]
+        if weight.shape != (20480,) or not weight.is_contiguous():
+            return None
+    if kind == "combine_norm":
+        block, injection = inputs[:2]
+        if (
+            block.shape != (hidden.shape[0], 5120)
+            or not block.is_contiguous()
+            or injection.shape != (hidden.shape[0], 4)
+            or injection.stride(1) != 1
+            or injection.stride(0) < 4
+        ):
+            return None
+    if kind == "gate_mix" and (
+        inputs[0].shape != hidden.shape or not inputs[0].is_contiguous()
+    ):
+        return None
+    width = 5120 if kind == "gate_mix" else 20480
+    allocated = tuple(
+        output
+        if output is not None
+        else torch.empty(
+            (hidden.shape[0], width), device=hidden.device, dtype=hidden.dtype
+        )
+        for output in outputs
+    )
+    if not standard_direct_parameters(*allocated):
+        return None
+    with standard_parameter_context(hidden, *inputs, *allocated):
+        if eps is None:
+            operation(hidden, *inputs, *allocated)
+        else:
+            operation(hidden, *inputs, *allocated, eps)
+    return allocated
+
+
+@lru_cache(maxsize=3)
+def _get_hc_dense_prefill_operation(kind: str):
+    """A native capability miss is checked once, without a trial submission."""
+    if kind not in ("grouped_norm", "combine_norm", "gate_mix"):
+        return None
+    try:
+        from vllm_xpu_kernels import _qwen38_C as native
+    except ModuleNotFoundError as error:
+        if error.name not in ("vllm_xpu_kernels", "vllm_xpu_kernels._qwen38_C"):
+            raise
+        return None
+    maximum = getattr(native, "HC_DENSE_GLUE_MAX_M", 0)
+    if type(maximum) is not int or maximum < 4096:
+        return None
+    return getattr(torch.ops._qwen38_C, "hc_dense_" + kind, None)
+
+
+@lru_cache(maxsize=2)
+def _get_hc_prefill_max_m(dense: bool) -> int:
+    from vllm_xpu_kernels import _qwen38_C as native
+
+    name = "HC_DENSE_GLUE_MAX_M" if dense else "HC_PREFILL_MAX_M"
+    maximum = getattr(native, name, 0 if dense else 4096)
+    return maximum if type(maximum) is int else 0
+
+
+def _try_hc_prefill(
+    kind: str,
+    hidden: torch.Tensor,
+    inputs: tuple[torch.Tensor, ...],
+    hc_count: int,
+    outputs: tuple[torch.Tensor | None, ...],
+    eps: float | None = None,
+) -> tuple[torch.Tensor, ...] | None:
+    # 新入口只覆盖大M；旧decode/verify及自定义Tensor/modes保持原分派。
+    dense = hidden.ndim == 2 and hidden.shape[1] == 20480
+    if dense and kind not in ("grouped_norm", "combine_norm", "gate_mix"):
+        return None
+    hidden_width = 20480 if dense else 10240
+    block_width = hidden_width // 4
+    if (
+        hidden.ndim != 2
+        or not 9 <= hidden.shape[0] <= 8192
+        or hidden.shape[1] != hidden_width
+        or hidden.dtype != torch.float16
+        or hidden.device.type != "xpu"
+        or hc_count != 4
+        or os.getenv("QWEN38_HC_PREFILL_NATIVE", "1") != "1"
+        or not using_qwen38_sycl()
+        or torch.compiler.is_compiling()
+        or torch.xpu.is_current_stream_capturing()
+        or not standard_direct_parameters(hidden, *inputs)
+        or not hidden.is_contiguous()
+    ):
+        return None
+    suffix = kind.upper()
+    if not getattr(envs, f"VLLM_XPU_ENABLE_QWEN38_HC_{suffix}_NATIVE") or getattr(
+        envs, f"VLLM_XPU_DISABLE_QWEN38_HC_{suffix}_NATIVE"
+    ):
+        return None
+    if eps is not None and (
+        not math.isfinite(eps) or not _HC_FP32_MIN_POSITIVE <= eps <= _HC_FP32_MAX
+    ):
+        return None
+    if any(
+        t.device != hidden.device
+        or t.dtype != hidden.dtype
+        or t.is_neg()
+        or t.is_conj()
+        for t in inputs
+    ):
+        return None
+    rows = hidden.shape[0]
+    if kind in ("grouped_norm", "combine_norm"):
+        weight = inputs[-1]
+        if weight.shape != (hidden_width,) or not weight.is_contiguous():
+            return None
+    if kind in ("combine", "combine_norm"):
+        block, injection = inputs[:2]
+        if (
+            block.shape != (rows, block_width)
+            or not block.is_contiguous()
+            or injection.shape != (rows, 4)
+            or injection.stride(1) != 1
+            or injection.stride(0) < 4
+        ):
+            return None
+    if kind == "gate_mix" and (
+        inputs[0].shape != hidden.shape or not inputs[0].is_contiguous()
+    ):
+        return None
+    if dense:
+        if os.getenv("VLLM_XPU_DISABLE_QWEN4_HC_NATIVE", "0") == "1":
+            return None
+        operation = _get_hc_dense_prefill_operation(kind)
+    else:
+        try:
+            import vllm_xpu_kernels.qwen38  # noqa: F401
+        except ModuleNotFoundError as error:
+            if error.name not in ("vllm_xpu_kernels", "vllm_xpu_kernels.qwen38"):
+                raise
+            return None
+
+        operation = getattr(torch.ops._qwen38_C, "hc_prefill_" + kind, None)
+    if operation is None or (rows > 4096 and rows > _get_hc_prefill_max_m(dense)):
+        return None  # 旧库availability miss，尚未分配或提交。
+    width = block_width if kind == "gate_mix" else hidden_width
+    allocated = tuple(
+        output
+        if output is not None
+        else torch.empty(
+            (hidden.shape[0], width), device=hidden.device, dtype=hidden.dtype
+        )
+        for output in outputs
+    )
+    if not standard_direct_parameters(*allocated):
+        return None
+    with standard_parameter_context(hidden, *inputs, *allocated):
+        if eps is None:
+            operation(hidden, *inputs, *allocated)
+        else:
+            operation(hidden, *inputs, *allocated, eps)
+    # 现有native完成所有geometry/alias/stride检查后提交，异常不转fallback。
+    return allocated
+
+
+def _is_hc_multi_m_rows(rows: int) -> bool:
+    return _HC_MULTI_M_MIN <= rows <= _HC_MULTI_M_MAX
+
+
