+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Portable pure-torch QSA (Qwen Sparse Attention) ops for Intel XPU.
+
+These reimplement the CUDA/Triton ops in ``nvidia/ops/qsa.py`` using only
+PyTorch, following the reference algorithms verified in
+``tests/models/qwen3_8_flash_next/test_qsa_reference.py``:
+pre-indexer scoring (paged MQA), block top-k selection, block-to-token
+expansion, sparse paged GQA, cache stores and streaming group compression.
+
+Correctness is prioritized over speed: the selection/attention loops are
+row-serial and intended for the correctness-first XPU bring-up. The public
+signatures match the CUDA module so the QSA owner and indexer import unchanged.
+"""
+
+from __future__ import annotations
+
+import atexit
+import importlib
+import importlib.machinery
+import importlib.util
+import json
+import math
+import os
+import statistics
+import sys
+from collections.abc import Callable
+from functools import lru_cache
+from pathlib import Path
+from types import ModuleType
+
+import torch
+
+import vllm.envs as envs
+from vllm.logger import init_logger
+from vllm.model_executor.layers.esimd_utils import (
+    ensure_esimd_package_path,
+    using_qwen38_sycl,
+)
+from vllm.models.qwen4_exp.xpu.audit import (
+    EVENT_ATTEMPT,
+    EVENT_ELIGIBLE,
+    EVENT_FALLBACK,
+    EVENT_HARD_ERROR_POST_SUBMIT,
+    EVENT_HARD_ERROR_PREFLIGHT,
+    EVENT_NATIVE_SUBMITTED,
+    EVENT_ZERO_WORK_SKIP,
+    NATIVE_STATS,
+    NATIVE_STATS_ENABLED,
+    PATH_QSA_ATTENTION,
+    PATH_QSA_CACHE_STORE,
+    PATH_QSA_GROUP_COMPRESSION,
+    PATH_QSA_SELECTION,
+    QSA_TOKEN_SPLIT_ATTEMPT,
+    QSA_TOKEN_SPLIT_ELIGIBLE,
+    QSA_TOKEN_SPLIT_FALLBACK,
+    QSA_TOKEN_SPLIT_SUBMITTED,
+    QSA_TOKEN_SPLIT_WORKSPACE_ALLOCATED,
+    QSA_TOKEN_SPLIT_WORKSPACE_REUSED,
+    REASON_DEVICE,
+    REASON_DISABLED,
+    REASON_DSO_NOT_CONFIGURED,
+    REASON_DTYPE,
+    REASON_LAYOUT,
+    REASON_NONE,
+    REASON_OP_UNAVAILABLE,
+    REASON_OTHER_CONTRACT,
+    REASON_PAGE_SIZE,
+    REASON_SHAPE,
+)
+from vllm.utils.torch_utils import PIN_MEMORY
+from vllm.v1.core.qsa_provenance import (
+    QSA_ROW_STORE_RECEIPT_ABI_VERSION,
+    QSAHistoricalRingWriteManifest,
+)
+
+# Kept for signature parity with the CUDA module; unused on the torch path.
+_LOGITS_WORKSPACE_BYTES = 1 << 22
+_TOPK_WORKSPACE_BYTES = 1 << 20
+
+_QSA_NATIVE_PACKAGE = "custom_esimd_kernels_vllm"
+_QSA_NATIVE_MODULE = f"{_QSA_NATIVE_PACKAGE}.qsa_ops"
+_QSA_NATIVE_DISABLE_ENV = "VLLM_XPU_DISABLE_NATIVE_QSA"
+# Validate the port's public tensor contract, not ESIMD implementation details
+# such as vector tile size or subgroup width.
+_QSA_SYCL_ABI = {
+    "qsa_sycl_abi_version": 1,
+    "activation_dtype": "float16",
+    "selection_page_sizes": (64, 128),
+    "attention_page_sizes": (256, 512),
+    "selection_output_width": 2051,
+    "packed_kv": 1,
+}
+_QSA_TOKEN_SPLIT_NATIVE_DISABLE_ENV = "VLLM_XPU_DISABLE_QWEN38_QSA_TOKEN_SPLIT_NATIVE"
+_QSA_TOKEN_SPLIT_FUSED_DISABLE_ENV = "VLLM_XPU_DISABLE_QWEN38_QSA_TOKEN_SPLIT_FUSED"
+_QSA_TOKEN_SPLIT_FUSED_ENABLE_ENV = "VLLM_XPU_ENABLE_QWEN38_QSA_TOKEN_SPLIT_FUSED"
+_QSA_SELECTION_NATIVE_DISABLE_ENV = "VLLM_XPU_DISABLE_QWEN38_QSA_SELECTION_NATIVE"
+_QSA_ROW_STORE_NATIVE_ENABLE_ENV = "VLLM_XPU_ENABLE_QWEN38_QSA_CACHE_STORE_NATIVE"
+_QSA_ROW_STORE_NATIVE_DISABLE_ENV = "VLLM_XPU_DISABLE_QWEN38_QSA_CACHE_STORE_NATIVE"
+_QSA_ROW_STORE_RECEIPT_NATIVE_ENABLE_ENV = (
+    "VLLM_XPU_ENABLE_QWEN38_QSA_CACHE_STORE_RECEIPT_NATIVE"
+)
+_QSA_ROW_STORE_RECEIPT_NATIVE_DISABLE_ENV = (
+    "VLLM_XPU_DISABLE_QWEN38_QSA_CACHE_STORE_RECEIPT_NATIVE"
+)
+_QSA_ROW_STORE_PARALLEL_NATIVE_ENABLE_ENV = (
+    "VLLM_XPU_ENABLE_QWEN38_QSA_CACHE_STORE_R_AWARE_NATIVE"
+)
+_QSA_ROW_STORE_PARALLEL_NATIVE_DISABLE_ENV = (
+    "VLLM_XPU_DISABLE_QWEN38_QSA_CACHE_STORE_R_AWARE_NATIVE"
