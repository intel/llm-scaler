+def invalidate_model_weight_caches(model: torch.nn.Module) -> None:
+    """Discard opt-in derived weights before an eager weight update.
+
+    Reload preserves Parameter storage, but that does not update separately
+    quantized weights or plans holding those derived tensors. Keep invalidation
+    on the loading path rather than checking tensor versions on every token.
+    """
+    for layer in model.modules():
+        invalidate = getattr(layer, "invalidate_weight_caches", None)
+        if callable(invalidate):
+            invalidate()
+
+
+@torch.no_grad()
+def refresh_model_weight_caches(model: torch.nn.Module) -> None:
+    """Refresh opt-in derived buffers after all live parameters are restored."""
+    for layer in model.modules():
+        refresh = getattr(layer, "refresh_weight_caches", None)
+        if callable(refresh):
+            refresh()
