+def _tensors_alias(first: torch.Tensor, second: torch.Tensor) -> bool:
+    return bool(torch._C._is_alias_of(first, second))
+
+
+def _hc_grouped_norm_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> int | None:
+    if (
+        envs.VLLM_XPU_DISABLE_QWEN38_HC_GROUPED_NORM_NATIVE
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_GROUPED_NORM_NATIVE
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or hidden_states.shape[0] != 1
+        or hidden_states.shape[1] != _HC_GROUPED_NORM_WIDTH
+        or weight.ndim != 1
+        or weight.shape[0] != _HC_GROUPED_NORM_WIDTH
+        or hc_count != _HC_GROUPED_NORM_COUNT
+    ):
+        return REASON_SHAPE
+    if hidden_states.dtype != torch.float16 or weight.dtype != torch.float16:
+        return REASON_DTYPE
+    if hidden_states.device.type != "xpu" or weight.device != hidden_states.device:
+        return REASON_DEVICE
+    if not hidden_states.is_contiguous() or not weight.is_contiguous():
+        return REASON_LAYOUT
+    if not math.isfinite(float(eps)) or eps <= 0.0:
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def _hc_grouped_norm_native_fallback_reason(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_grouped_norm_input_fallback_reason(
+        hidden_states,
+        weight,
+        eps,
+        hc_count,
+    )
+    if reason is not None:
+        return reason
+    if not isinstance(output, torch.Tensor):
+        return REASON_OTHER_CONTRACT
+    if output.shape != hidden_states.shape:
+        return REASON_SHAPE
+    if output.dtype != hidden_states.dtype:
+        return REASON_DTYPE
+    if output.device != hidden_states.device:
+        return REASON_DEVICE
+    if not output.is_contiguous():
+        return REASON_LAYOUT
+    if _tensors_alias(output, hidden_states) or _tensors_alias(output, weight):
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def should_prepare_hc_grouped_norm_output(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> bool:
+    """Return whether a caller should materialize the private native output."""
+    try:
+        return (
+            _hc_grouped_norm_input_fallback_reason(
+                hidden_states,
+                weight,
+                eps,
+                hc_count,
+            )
+            is None
+        )
+    except Exception:
+        return False
+
+
+def _get_hc_grouped_norm_operation():
+    global _HC_GROUPED_NORM_OPERATION
+    global _HC_GROUPED_NORM_OPERATION_RESOLVED
+
+    if not _HC_GROUPED_NORM_OPERATION_RESOLVED:
+        try:
+            operation = get_qwen38_hc_op(_HC_GROUPED_NORM_OP_NAME)
+        except Qwen38HCOpUnavailableError:
+            operation = None
+        _HC_GROUPED_NORM_OPERATION = operation
+        _HC_GROUPED_NORM_OPERATION_RESOLVED = True
+    return _HC_GROUPED_NORM_OPERATION
+
+
+def _grouped_gemma_rmsnorm_torch(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> torch.Tensor:
+    input_dtype = hidden_states.dtype
+    hidden_size = hidden_states.shape[-1] // hc_count
+    grouped = hidden_states.float().unflatten(-1, (hc_count, hidden_size))
+    variance = grouped.square().mean(-1, keepdim=True)
+    normalized = (grouped * torch.rsqrt(variance + eps)).flatten(-2)
+    return (normalized * (1.0 + weight.float())).to(input_dtype)
+
+
+def grouped_gemma_rmsnorm(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    *,
+    output: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Per-HC-stream GemmaRMSNorm with an optional native output buffer."""
+    dense = _try_hc_dense(
+        "grouped_norm", hidden_states, (weight,), hc_count, (output,), eps
+    )
+    if dense is not None:
+        return dense[0]
+    work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+    prefill = _try_hc_prefill(
+        "grouped_norm", hidden_states, (weight,), hc_count, (output,), eps
+    )
+    if prefill is not None:
+        return prefill[0]
+    if hidden_states.numel() == 0:
+        _record_hc_grouped_norm(EVENT_ZERO_WORK_SKIP, 0)
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    _record_hc_grouped_norm(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_grouped_norm_native_fallback_reason(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+            output,
+        )
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_grouped_norm(EVENT_FALLBACK, work_units, reason)
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    _record_hc_grouped_norm(EVENT_ELIGIBLE, work_units)
+    try:
+        operation = _get_hc_grouped_norm_operation()
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if operation is None:
+        _record_hc_grouped_norm(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    assert output is not None
+    _record_hc_grouped_norm(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(hidden_states, weight, output, eps)
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return output
+
+
+def _hc_gate_mix_multi_m_input_fallback_reason(
+    x: torch.Tensor,
+    gate: torch.Tensor,
+    hc_count: int,
+) -> int | None:
+    if getattr(
+        envs, "VLLM_XPU_DISABLE_QWEN38_HC_GATE_MIX_MULTI_M_NATIVE", False
+    ) or not getattr(envs, "VLLM_XPU_ENABLE_QWEN38_HC_GATE_MIX_MULTI_M_NATIVE", False):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        x.ndim != 2
+        or not _is_hc_multi_m_rows(int(x.shape[0]))
+        or x.shape[1] != _HC_GATE_MIX_WIDTH
+        or gate.shape != x.shape
+        or hc_count != _HC_GATE_MIX_COUNT
+    ):
+        return REASON_SHAPE
+    if x.dtype != torch.float16 or gate.dtype != torch.float16:
+        return REASON_DTYPE
+    if x.device.type != "xpu" or gate.device != x.device:
+        return REASON_DEVICE
+    if (
+        not x.is_contiguous()
+        or not gate.is_contiguous()
+        or not _is_four_byte_aligned_fp16_view(x)
+        or not _is_four_byte_aligned_fp16_view(gate)
+    ):
+        return REASON_LAYOUT
+    return None
+
