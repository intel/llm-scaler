+def _qsa_debug_compare_candidate(
+    module: ModuleType,
+    q: torch.Tensor,
+    packed_kv_source: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    candidate_output: torch.Tensor,
+) -> None:
+    """Compare a few candidate results with the old native ABI on the same queue."""
+    global _QSA_DEBUG_COMPARE_COUNT
+    if not _QSA_DEBUG_COMPARE_ENABLED:
+        return
+    if q.shape[0] < _QSA_DEBUG_COMPARE_MIN_ROWS:
+        return
+    if _QSA_DEBUG_COMPARE_COUNT >= _QSA_DEBUG_COMPARE_LIMIT:
+        return
+    _QSA_DEBUG_COMPARE_COUNT += 1
+    reference = torch.empty_like(candidate_output)
+    returned = module.sparse_paged_attention_v2(
+        q,
+        packed_kv_source,
+        packed_kv_source.as_strided(
+            packed_kv_source.shape,
+            packed_kv_source.stride(),
+            storage_offset=packed_kv_source.storage_offset() + 256,
+        ),
+        logical_indices,
+        block_table,
+        token_to_req,
+        int(packed_kv_source.shape[1]),
+        reference,
+    )
+    _validate_native_output(returned, reference, "debug comparison")
+    torch.xpu.synchronize()
+    candidate_float = candidate_output.float()
+    reference_float = reference.float()
+    diff = (candidate_float - reference_float).abs()
+    finite = bool(torch.isfinite(candidate_float).all().item())
+    print(
+        "[QSA_DEBUG_COMPARE] "
+        f"rows={q.shape[0]} finite={finite} "
+        f"max_abs={float(diff.max().item())} "
+        f"candidate_max={float(candidate_float.abs().max().item())} "
+        f"reference_max={float(reference_float.abs().max().item())}",
+        flush=True,
+    )
