+                return True
+        return False
+
+    def commit_qsa_ring_accepted(
+        self,
+        request_id: str,
+        epoch: int,
+        logical_tags: Sequence[int],
+        *,
+        lease: QSAHistoricalRingLease | None = None,
+        ring_group_id: int | None = None,
+    ) -> bool:
+        for manager in self.single_type_managers:
