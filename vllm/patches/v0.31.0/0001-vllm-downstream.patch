+                receipt.request_id,
+                receipt.lease,
+                receipt.epoch,
+                receipt.logical_tags,
+                receipt.causal_generation,
+            ): receipt
+            for receipt in getattr(self, "_qsa_ring_write_receipts", ())
+        }
+        acknowledgements = []
+        for transaction in self._qsa_ring_pending:
