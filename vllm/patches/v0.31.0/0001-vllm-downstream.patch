index 0000000000..ff6d314038
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/collectives.py
@@ -0,0 +1,218 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""模型局部 FULL decode 路径中已证明 last-use 的通信操作。"""
+
+import threading
+from collections.abc import Callable
+from typing import Any, cast
+
+import torch
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+from vllm import envs
+from vllm.distributed import get_tp_group, tensor_model_parallel_all_reduce
+from vllm.distributed.device_communicators.xpu_communicator import XpuCommunicator
+from vllm.utils.torch_utils import direct_register_custom_op
+
+from .full_decode import (
+    Qwen38FullDecodeState,
+    active_full_decode_state,
+    flash_decode_optimizations_enabled,
+)
+
+_peer_owner_lock = threading.RLock()
+
+
+def _general_peer_owner(communicator, device, width):
+    with _peer_owner_lock:
+        owners = getattr(communicator, "_qwen_peer_general_m1_owners", None)
+        if owners is None:
+            owners = {}
+            communicator._qwen_peer_general_m1_owners = owners
+        if width not in owners:
+            try:
+                from vllm_xpu_kernels.qwen_peer import QwenPeerAllReduce
+            except (ImportError, OSError):
+                owners[width] = False
+            else:
+                owners[width] = QwenPeerAllReduce(communicator.cpu_group, device, width)
+        owner = owners[width]
+    return owner
+
+
+def try_general_peer_all_reduce(tensor, communicator) -> bool:
+    if (
+        not envs.VLLM_XPU_QWEN_PEER_M1
+        or envs.VLLM_BATCH_INVARIANT
+        or type(tensor) is not torch.Tensor
+        or tensor.dtype != torch.float16
+        or tensor.device.type != "xpu"
+        or tensor.ndim != 2
+        or tensor.shape[0] != 1
+        or tensor.shape[1] != 2560
+        or not tensor.is_contiguous()
+        or tensor.is_neg()
+        or tensor.is_conj()
+        or tensor.requires_grad
+        or torch._C._is_torch_function_mode_enabled()
+        or _get_current_dispatch_mode() is not None
+        or torch._C._get_tracing_state() is not None
+        or getattr(communicator, "world_size", None) != 8
+    ):
+        return False
+    owner = _general_peer_owner(communicator, tensor.device, tensor.shape[1])
+    return owner.try_run(tensor) if owner else False
+
+
+def _general_peer_m1_model_enabled() -> bool:
+    state = active_full_decode_state()
+    config = getattr(state, "vllm_config", None)
+    if (
+        type(state) is not Qwen38FullDecodeState
+        or state.num_tokens != 1
+        or config is None
+    ):
+        return False
+    return bool(
+        envs.VLLM_XPU_QWEN_PEER_M1
+        and config.parallel_config.tensor_parallel_size == 8
+        and flash_decode_optimizations_enabled(config)
+    )
+
+
+def _peer_m1_model_enabled() -> bool:
+    config = getattr(active_full_decode_state(), "vllm_config", None)
+    if config is None or config.model_config is None:
+        return False
+    return bool(
+        envs.VLLM_XPU_QWEN38_TP4_PEER_AR
+        and config.parallel_config.tensor_parallel_size == 4
+        and flash_decode_optimizations_enabled(config)
+        and not envs.VLLM_BATCH_INVARIANT
+    )
+
+
+def _try_peer_m1_all_reduce(
+    tensor: torch.Tensor, communicator: XpuCommunicator
+) -> bool:
+    if not envs.VLLM_XPU_QWEN38_TP4_PEER_AR:
+        return False
+    state = active_full_decode_state()
+    if (
+        type(state) is not Qwen38FullDecodeState
+        or state.num_tokens != 1
+        or tuple(tensor.shape) != (1, 2560)
+        or getattr(communicator, "world_size", None) != 4
+        or not _peer_m1_model_enabled()
+    ):
+        return False
+    owner = getattr(communicator, "_qwen38_peer_m1_owner", None)
+    if owner is None:
+        with _peer_owner_lock:
+            owner = getattr(communicator, "_qwen38_peer_m1_owner", None)
+            if owner is None:
+                try:
+                    from vllm_xpu_kernels.qwen38_peer import Qwen38PeerAllReduce
+                except (ImportError, OSError):
+                    cast(Any, communicator)._qwen38_peer_m1_owner = False
+                    return False
+                owner = Qwen38PeerAllReduce(communicator.cpu_group, tensor.device)
+                cast(Any, communicator)._qwen38_peer_m1_owner = owner
+    if owner is False:
+        return False
+    return owner.try_run(tensor)
+
+
+def _full_decode_all_reduce_(tensor: torch.Tensor) -> None:
+    communicator = get_tp_group().device_communicator
+    if not isinstance(communicator, XpuCommunicator):
+        raise RuntimeError("FULL decode all-reduce requires an XPU communicator")
+    if _try_peer_m1_all_reduce(tensor, communicator):
+        return
+    if _general_peer_m1_model_enabled() and try_general_peer_all_reduce(
+        tensor, communicator
+    ):
+        return
+    # 异常可能发生在通信提交之后，不能重试或转入 fallback。
+    output = communicator._all_reduce(tensor, inplace=True)
+    if output is not tensor:
+        raise RuntimeError("FULL decode all-reduce did not mutate its input")
+
+
+def _full_decode_all_reduce_fake(tensor: torch.Tensor) -> None:
+    return None
+
+
+direct_register_custom_op(
+    op_name="qwen38_full_decode_all_reduce_",
+    op_func=_full_decode_all_reduce_,
+    mutates_args=["tensor"],
+    fake_impl=_full_decode_all_reduce_fake,
+    dispatch_key="XPU",
+)
+
+
+def full_decode_all_reduce(
+    tensor: torch.Tensor,
+    *,
+    fallback: Callable[[torch.Tensor], torch.Tensor] | None = None,
+) -> torch.Tensor:
+    """归约已证明 last-use 的中间结果，仅在 FULL decode 中原地修改。
+
+    调用方必须限定 TP4/TP8 INT4/FP8 的 FP16、FULL_DECODE_ONLY，并证明该结果
+    不 alias 生产者的输入（包括 residual），且 unreduced 值没有后续消费者。
+    所有 TP rank 必须选择相同路径；capture 到 replay 期间 TP group 和
+    communicator 必须保持不变。允许借用 native workspace，但生产、归约、
+    消费及下次覆盖必须在同一 ordered stream，且复用前已证明 last-use。
+    普通 decode 允许 owned state 对应的 M1..8；其它已支持的 FULL state
+    只保留既有 M1 路径。Tensor 是否为 view 并不能证明上述所有权契约。
+
+    Args:
+        tensor: 允许覆盖 unreduced 内容的中间结果。
+        fallback: 不支持原地路径时使用的既有归约入口；默认使用标准 TP
+            all-reduce。调用方可显式传入原模块的引用，保留入口及 mock 行为。
+
+    Returns:
+        原地路径返回同一 tensor；输入或 scope 不支持时返回原 TP 归约的结果。
+
+    Raises:
+        RuntimeError: 通信提交或结果校验失败。调用方必须传播异常，不能重放
+            eager fallback。
+
+    """
+    if fallback is None:
+        fallback = tensor_model_parallel_all_reduce
+    # 非 FULL 热路径先返回，不为 eager/PIECEWISE 增加 dispatcher 状态检查。
+    state = active_full_decode_state()
+    if state is None:
+        return fallback(tensor)
+    if (
+        type(tensor) is not torch.Tensor
+        or torch._C._is_torch_function_mode_enabled()
+        or _get_current_dispatch_mode() is not None
+        or torch._C._get_tracing_state() is not None
+        or tensor.device.type != "xpu"
+        or tensor.dtype != torch.float16
+        or tensor.ndim != 2
+        or not 1 <= tensor.shape[0] <= 8
+        or tensor.numel() == 0
+        or not tensor.is_contiguous()
+        or tensor.requires_grad
+        or envs.VLLM_BATCH_INVARIANT
+    ):
+        return fallback(tensor)
+
+    if type(state) is Qwen38FullDecodeState:
+        if tensor.shape[0] != getattr(state, "num_tokens", 1):
+            return fallback(tensor)
+    elif tensor.shape[0] != 1:
+        return fallback(tensor)  # Do not extend the speculative FULL scope.
+
+    group = get_tp_group()
+    if group.world_size not in (4, 8) or not isinstance(
+        group.device_communicator, XpuCommunicator
+    ):
+        return fallback(tensor)
+
+    torch.ops.vllm.qwen38_full_decode_all_reduce_(tensor)
+    return tensor
