+def _decode_eligible() -> bool:
+    if not is_forward_context_available():
+        return False
+    context = get_forward_context()
+    if context.additional_kwargs.get(_QWEN38_NGRAM_DECODE_ELIGIBLE) is True:
+        return True
+    if getattr(context, "cudagraph_runtime_mode", None) != CUDAGraphMode.FULL:
+        return False
+    # 只接受图外已验证每个请求一个 token 的普通 decode；不把 FULL/MTP 当作 proof。
+    # 否则 capture 会永久录入 packed.fill_ 与通用 searchsorted 路径。
+    from .full_decode import active_full_decode_state
