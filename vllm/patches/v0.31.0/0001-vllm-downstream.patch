+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Device-position provenance for eager QSA speculative decoding.
+
+CPU speculative frontiers are optimistic. Track the actual device row tags
+after each successful raw-key store instead. A ring lease includes allocation
+generation and request incarnation; reusing a physical block resets its tags.
+Every history gather is checked on the same ordered stream, without D2H reads.
+
+The sampler/runner supplies a causal accepted prefix. With ring >= R + K,
+speculative writes cannot evict the R-1 historical rows needed after rollback.
+Compression precedes current raw stores, so chunked prefill also reads the
+previous chunk's tail before replacing it. Draft and target indexers each own
+their own ledger; neither can certify the other's writes.
+"""
+
+import os
+
+import torch
+
+from vllm.v1.core.qsa_provenance import QSAHistoricalRingLease
+
+_FUSED_FIRST_POSITIONS = (
+    os.getenv("VLLM_XPU_QWEN38_QSA_FUSED_FIRST_POSITIONS", "1") == "1"
+)
+
+
+def compressed_first_positions(positions, slots, compress_ratio: int):
+    """Derive 1D RoPE positions from this call's device validity witnesses.
+
+    Keep the original Torch semantics for modes, subclasses and unusual
+    layouts. The fused path is an integer-only current-stream operation; it
+    neither reads the optional compression sidecar nor trusts cached tags.
+    """
+    if (
+        _FUSED_FIRST_POSITIONS
+        and compress_ratio == 4
+        and type(positions) is torch.Tensor
+        and type(slots) is torch.Tensor
+        and positions.device.type == "xpu"
+        and slots.device == positions.device
+        and positions.device.index == torch.xpu.current_device()
+        and positions.dtype in (torch.int32, torch.int64)
+        and slots.dtype in (torch.int32, torch.int64)
+        and positions.ndim == 1
+        and slots.shape == positions.shape
+        and positions.numel() > 0
+        and positions.is_contiguous()
+        and slots.is_contiguous()
+        and not positions.is_neg()
+        and not slots.is_neg()
+        and not torch.compiler.is_compiling()
+        and not torch.overrides._is_torch_function_mode_enabled()
+        and torch.utils._python_dispatch._get_current_dispatch_mode() is None
+    ):
+        from .qsa_history_triton import compressed_first_positions_kernel
+
+        result = torch.empty_like(positions)
+        compressed_first_positions_kernel[((positions.numel() + 127) // 128,)](
+            positions,
+            slots,
+            result,
+            positions.numel(),
+            compress_ratio,
+            128,
+            num_warps=4,
+        )
+        return result
+    valid = (slots >= 0) & (positions >= compress_ratio - 1)
+    return torch.where(
+        valid, positions - (compress_ratio - 1), torch.zeros_like(positions)
+    )
+
+
+class QSADeviceRingLedger:
+    def __init__(self, cache: torch.Tensor):
+        self.cache = cache
+        self.ring_size = cache.shape[1]
+        self.num_blocks = cache.shape[0]
+        # Extra sink slot permits masked stores without nonzero()/D2H shape
+        # discovery. Every masked writer stores the same -1 into the sink.
+        self.tags = torch.full(
+            (self.num_blocks * self.ring_size + 1,),
+            -1,
+            dtype=torch.int64,
+            device=cache.device,
+        )
+        self.leases: dict[int, QSAHistoricalRingLease] = {}
+        self._table_key: tuple[int, ...] | None = None
+        self._table_blocks = None
+        self._fused_checks = (
+            cache.device.type == "xpu"
+            and os.getenv("VLLM_XPU_DISABLE_QSA_FUSED_HISTORY", "0") != "1"
+        )
+        self._history_ok = (
+            torch.empty((), dtype=torch.bool, device=cache.device)
+            if self._fused_checks
+            else None
+        )
+        self.stream = (
+            torch.xpu.current_stream(cache.device)
+            if cache.device.type == "xpu"
+            else None
+        )
+
+    def _check_stream(self):
+        if self.stream is not None:
+            current = torch.xpu.current_stream(self.cache.device)
+            if current != self.stream:
+                # The ledger and raw cache are shared state. Order a stream
+                # transition explicitly, rather than silently duplicating tags.
+                current.wait_stream(self.stream)
+                self.stream = current
+
+    def prepare(self, metadata) -> None:
+        self._check_stream()
+        leases = metadata.qsa_ring_device_leases
+        query_starts = metadata.query_start_loc_cpu
+        table = metadata.block_table_cpu
+        if (
+            not isinstance(leases, tuple)
+            or query_starts is None
+            or len(leases) != len(query_starts) - 1
+            or table is None
+            or table.device.type != "cpu"
+            or table.ndim != 2
+            or table.shape[0] < len(leases)
+            or table.shape[1] < 1
+        ):
+            raise RuntimeError("QSA device history requires producer-owned ring leases")
+        changed_blocks = []
+        used_blocks = set()
+        table_blocks = []
+        for req, lease in enumerate(leases):
+            table_blocks.append(int(table[req, 0]))
+            if query_starts[req] == query_starts[req + 1]:
+                continue
+            if type(lease) is not QSAHistoricalRingLease:
+                raise RuntimeError("Missing QSA device-history request lease")
+            block = int(table[req, 0])
+            if (
+                block != lease.block_id
+                or not 0 <= block < self.num_blocks
+                or block in used_blocks
+            ):
+                raise RuntimeError("QSA device-history lease/block ownership mismatch")
+            used_blocks.add(block)
+            if self.leases.get(block) != lease:
+                changed_blocks.append(block)
+                self.leases[block] = lease
+        if changed_blocks:
+            blocks = torch.tensor(changed_blocks, device=self.tags.device)
+            # Exclude the final sink when viewing the physical ring rows.
+            self.tags[:-1].view(self.num_blocks, self.ring_size).index_fill_(
+                0, blocks, -1
+            )
+        table_key = tuple(table_blocks)
+        if self._table_key != table_key:
+            self._table_key = table_key
+            self._table_blocks = torch.tensor(table_key, device=self.tags.device)
+        torch._assert_async(
+            (metadata.block_table[: len(leases), 0] == self._table_blocks).all(),
+            "QSA device block table disagrees with producer-owned leases",
+        )
+
+    def validate_history(self, metadata, compressed_slots, compress_ratio: int) -> None:
+        rows = metadata.num_actual_tokens
+        req_count = len(metadata.query_start_loc_cpu) - 1
+        if not rows:
+            return
+        if req_count <= 0:
+            raise RuntimeError("QSA history rows require a request")
+        if self._fused_checks and rows <= 64 and compress_ratio == 4:
+            from .qsa_history_triton import check_history_kernel
+
+            check_history_kernel[(1,)](
+                self.tags,
+                metadata.token_to_req,
+                metadata.query_start_loc,
+                metadata.logical_positions,
+                metadata.block_table,
+                compressed_slots,
+                self._history_ok,
+                rows,
+                req_count,
+                self.num_blocks,
+                self.ring_size,
+                compress_ratio,
+                max(16, 1 << (rows - 1).bit_length()),
+                metadata.token_to_req.stride(0),
+                metadata.query_start_loc.stride(0),
+                metadata.logical_positions.stride(0),
+                metadata.block_table.stride(0),
+                compressed_slots.stride(0),
+                num_warps=4,
+            )
+            torch._assert_async(
+                self._history_ok,
+                "QSA compression requires valid blocks and producer-written "
+                "historical ring rows",
+            )
+            return
+        req = metadata.token_to_req.long()
+        safe_req = req.clamp(0, max(req_count - 1, 0))
+        row_ids = torch.arange(rows, device=self.tags.device)
+        q_start = metadata.query_start_loc[safe_req].long()
+        q_end = metadata.query_start_loc[safe_req + 1].long()
+        position = metadata.logical_positions.long()
+        chunk_start = position - (row_ids - q_start)
+        valid = (
+            (req >= 0)
+            & (req < req_count)
+            & (row_ids >= q_start)
+            & (row_ids < q_end)
+            & (compressed_slots >= 0)
+            & (position >= compress_ratio - 1)
+        )
+        block = metadata.block_table[safe_req, 0].long()
+        # Bounds are asserted before data-dependent gathers. Clamping also
+        # keeps malformed metadata from causing a stray memory access.
+        torch._assert_async(
+            ((~valid) | ((block >= 0) & (block < self.num_blocks))).all(),
+            "QSA history block is outside the leased ring",
+        )
+        offsets = torch.arange(compress_ratio, device=self.tags.device)
+        historical_positions = position[:, None] - (compress_ratio - 1) + offsets
+        needs_history = valid[:, None] & (historical_positions < chunk_start[:, None])
+        slots = block.clamp(0, self.num_blocks - 1)[:, None] * self.ring_size
+        slots = slots + historical_positions.remainder(self.ring_size)
+        actual_tags = self.tags[slots]
+        torch._assert_async(
+            ((~needs_history) | (actual_tags == historical_positions)).all(),
+            "QSA compression requires producer-written historical ring rows",
+        )
+
+    def acknowledge_store(self, metadata) -> None:
+        rows = metadata.slot_mapping.numel()
+        if self._fused_checks and 0 < rows <= 64:
+            from .qsa_history_triton import acknowledge_kernel
+
+            acknowledge_kernel[(1,)](
+                self.tags,
+                metadata.slot_mapping,
+                metadata.logical_positions,
+                rows,
+                self.num_blocks * self.ring_size,
+                metadata.slot_mapping.stride(0),
+                metadata.logical_positions.stride(0),
+                max(16, 1 << (rows - 1).bit_length()),
+                num_warps=4,
+            )
+            return
+        slots = metadata.slot_mapping.long()
+        capacity = self.num_blocks * self.ring_size
+        valid = (slots >= 0) & (slots < capacity)
+        sink = torch.full_like(slots, capacity)
+        indices = torch.where(valid, slots, sink)
+        positions = torch.where(
+            valid,
+            metadata.logical_positions.long(),
+            torch.full_like(slots, -1),
+        )
+        self.tags.scatter_(0, indices, positions)
+
+
+def prepare_qsa_device_ring_ledger(owner, cache, metadata):
+    if not getattr(metadata, "qsa_ring_device_guard", False):
+        return None
+    ledger = getattr(owner, "_qsa_device_ring_ledger", None)
+    from ..full_decode import active_full_decode_state
+
+    state = active_full_decode_state()
+    prepared = getattr(state, "prepared_history", {}).get(id(owner))
+    if prepared is not None and state is not None and state.owns(metadata):
+        if not (
+            prepared is ledger
+            and ledger.cache.data_ptr() == cache.data_ptr()
+            and ledger.cache.shape == cache.shape
+            and ledger.cache.device == cache.device
+        ):
+            raise RuntimeError("FULL verify history cache binding changed")
+        # wrapper已用本次真实metadata图外prepare；图内仍校验/确认device tags。
+        return ledger
+    if (
+        ledger is None
+        or ledger.cache.data_ptr() != cache.data_ptr()
+        or ledger.cache.shape != cache.shape
+        or ledger.cache.device != cache.device
+    ):
+        ledger = QSADeviceRingLedger(cache)
+        owner._qsa_device_ring_ledger = ledger
+    ledger.prepare(metadata)
+    return ledger
