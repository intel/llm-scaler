index 0000000000..ef4a81e0dc
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/dense_all_reduce.py
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Consume unpublished Qwen4 dense projection results in FULL decode."""
+
+from typing import Any, cast
+
+import torch
+
+from vllm import envs
+from vllm.config import CUDAGraphMode
+from vllm.distributed import get_tp_group
+from vllm.distributed.device_communicators.xpu_communicator import XpuCommunicator
+from vllm.forward_context import get_forward_context, is_forward_context_available
+
+
+def try_dense_local_all_reduce(
+    output: torch.Tensor,
+    projection: Any,
+    source: torch.Tensor,
+    *,
+    extra_inputs: tuple[torch.Tensor, ...] = (),
+) -> bool:
+    """Reduce a last-use local GEMM output, or leave it untouched on a miss.
+
+    Callers own the unreduced output and must call their existing out-of-place
+    collective after False. Exceptions after a native submit must propagate.
+    This does not change the public all-reduce operator's fresh-output schema.
+    """
+    if (
+        envs.VLLM_BATCH_INVARIANT
+        or torch.compiler.is_compiling()
+        or torch.is_grad_enabled()
+        or type(output) is not torch.Tensor
+        or type(source) is not torch.Tensor
+        or not is_forward_context_available()
+        or get_forward_context().cudagraph_runtime_mode != CUDAGraphMode.FULL
+    ):
+        return False
+    from vllm.model_executor.layers.linear import (
+        RowParallelLinear,
+        UnquantizedLinearMethod,
+    )
+    from vllm.model_executor.layers.quantization.online.fp8 import (
+        Fp8PerTensorOnlineLinearMethod,
+    )
+    from vllm.model_executor.layers.quantization.sym_int4 import SymInt4LinearMethod
+    from vllm.model_executor.models._qwen3_next_xpu import (
+        _direct_parameters,
+        _disjoint_writes,
+    )
+
+    if type(projection) is not RowParallelLinear:
+        return False
+    hooks = torch.nn.modules.module
+    method = projection.quant_method
+    parameters: tuple[object, ...]
+    if (
+        projection.tp_size != 2
+        or projection.input_is_parallel is not True
+        or projection.reduce_results is not True
+        or projection.disable_tp
+        or projection.bias is not None
+        or projection._forward_hooks
+        or projection._forward_pre_hooks
+        or hooks._global_forward_hooks
+        or hooks._global_forward_pre_hooks
+        or "forward" in projection.__dict__
+        or "apply" in method.__dict__
+    ):
+        return False
+    if (
+        getattr(projection, "_qwen4_dense_hc_tp2", False) is True
+        and type(method) is UnquantizedLinearMethod
+    ):
+        from vllm.model_executor.layers.utils import default_unquantized_gemm
+
+        if method._gemm_impl is not default_unquantized_gemm:
+            return False
+        geometry = (320, 20480)
+        parameters = (getattr(projection, "weight", None),)
+    elif (
+        getattr(projection, "_qwen4_dense_int4", False) is True
+        and type(method) is SymInt4LinearMethod
+    ):
+        geometry = (projection.input_size_per_partition, 5120)
+        if geometry[0] not in (3072, 7168):
+            return False
+        parameters = tuple(
+            getattr(projection, name, None) for name in ("qweight", "scales", "qzeros")
+        )
+    elif (
+        getattr(projection, "_qwen4_dense_fp8", False) is True
+        and type(method) is Fp8PerTensorOnlineLinearMethod
+    ):
+        from vllm.model_executor.kernels.linear.scaled_mm.xpu import (
+            XPUW8A16FP8LinearKernel,
+        )
+
+        kernel = method.fp8_linear
+        if (
+            type(kernel) is not XPUW8A16FP8LinearKernel
+            or "apply_weights" in kernel.__dict__
+        ):
+            return False
+        geometry = (projection.input_size_per_partition, 5120)
+        if geometry[0] not in (3072, 7168):
+            return False
+        parameters = tuple(
+            getattr(projection, name, None) for name in ("weight", "weight_scale")
+        )
+    else:
+        return False
+    if any(not isinstance(value, torch.Tensor) for value in parameters):
+        return False
+    live_parameters = cast(tuple[torch.Tensor, ...], parameters) + tuple(
+        value
+        for name in ("weight_esimd", "scale_esimd")
+        if isinstance(value := getattr(projection, name, None), torch.Tensor)
+    )
+    if not _direct_parameters(output, source, *extra_inputs, *live_parameters):
+        return False
+    if (
+        output.device.type != "xpu"
+        or source.device != output.device
+        or output.dtype != torch.float16
+        or source.dtype != torch.float16
+        or output.requires_grad
+        or source.requires_grad
+        or any(value.requires_grad for value in (*extra_inputs, *live_parameters))
+        or source.ndim != 2
+        or not 1 <= source.shape[0] <= 8
+        or source.shape[1] != geometry[0]
+        or output.shape != (source.shape[0], geometry[1])
+        or not output.is_contiguous()
+        or projection.input_size_per_partition != geometry[0]
+        or projection.output_size != geometry[1]
+        or any(
+            torch._C._is_alias_of(output, value)
+            for value in (source, *extra_inputs, *live_parameters)
+        )
+        or not _disjoint_writes((output,), (source, *extra_inputs, *live_parameters))
+    ):
+        return False
+    group = get_tp_group()
+    communicator = group.device_communicator
+    if (
+        group.world_size != 2
+        or type(communicator) is not XpuCommunicator
+        or getattr(communicator, "_qwen4_hc_custom_ar", False) is not True
+        or not callable(getattr(communicator, "all_reduce_inplace_", None))
+    ):
+        return False
+    return communicator.all_reduce_inplace_(output)
