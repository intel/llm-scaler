+def _qwen38_moe_m1_tensor_fallback_reason(
+    tensor: Any,
+    *,
+    shape: tuple[int, ...],
+    dtype: torch.dtype,
+    device: torch.device,
+) -> int | None:
+    # This boundary accepts arbitrary DSO/module fields. The existing guard
+    # proves Tensor before access, including after a dynamic Parameter detach.
+    if not isinstance(tensor, torch.Tensor):
+        return REASON_OTHER_CONTRACT
+    if _PLAIN_PARAMETER_VIEWS and isinstance(tensor, BasevLLMParameter):
+        tensor = tensor.detach()
+    if tensor.device != device:
+        return REASON_DEVICE
+    if tensor.dtype != dtype:
+        return REASON_DTYPE
+    if tuple(tensor.shape) != shape:
+        return REASON_SHAPE
+    if not tensor.is_contiguous() or tensor.data_ptr() % 16 != 0:
+        return REASON_LAYOUT
+    return None
+
+
+def _qwen38_moe_m1_aliases(
+    output: torch.Tensor, inputs: tuple[torch.Tensor, ...]
+) -> bool:
+    if _MOE_BATCHED_PREFLIGHT and output.device.type == "xpu":
+        operations = _moe_metadata_operations()
+        if operations is not None:
+            return operations[1](output, inputs)
+    output_begin = output.data_ptr()
+    output_end = output_begin + output.numel() * output.element_size()
+    for tensor in inputs:
+        if _PLAIN_PARAMETER_VIEWS and isinstance(tensor, BasevLLMParameter):
+            tensor = tensor.detach()
+        if tensor.device != output.device or tensor.numel() == 0:
+            continue
+        tensor_begin = tensor.data_ptr()
+        tensor_end = tensor_begin + tensor.numel() * tensor.element_size()
+        if output_begin < tensor_end and tensor_begin < output_end:
+            return True
+    return False
+
+
+def _qwen38_moe_matches_output_alias(result: object, output: torch.Tensor) -> bool:
+    return (
+        isinstance(result, torch.Tensor)
+        and result.device == output.device
+        and result.dtype == output.dtype
+        and tuple(result.shape) == tuple(output.shape)
+        and result.is_contiguous()
+        and result.data_ptr() == output.data_ptr()
+        and torch._C._is_alias_of(result, output)
+    )
+
+
+def _qwen38_moe_cached_weight_view_matches_source(
+    cached_view: object, source: torch.Tensor
+) -> bool:
+    return (
+        isinstance(cached_view, torch.Tensor)
+        and source.dtype in (torch.int8, torch.uint8)
+        and cached_view.dtype == torch.uint8
+        and cached_view.device == source.device
+        and cached_view.data_ptr() == source.data_ptr()
+        and torch._C._is_alias_of(cached_view, source)
+    )
+
+
+def _qwen38_moe_validate_all_reduce_output(
+    result: object, expected: torch.Tensor
+) -> torch.Tensor:
+    if (
+        not isinstance(result, torch.Tensor)
+        or result.device != expected.device
+        or result.dtype != expected.dtype
+        or tuple(result.shape) != tuple(expected.shape)
+        or not result.is_contiguous()
+        or result.data_ptr() % 16 != 0
+    ):
+        raise RuntimeError(
+            "Qwen3.8 asymmetric MoE all-reduce returned an invalid output ABI"
+        )
+    return result
