+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen3.8-Flash-Next low-latency GEMM shim for Intel XPU.
+
+The CUDA Blackwell (sm103) skinny-GEMM plans used by the NVIDIA variant do not
+apply on Intel XPU, so enabling the low-latency path is a no-op here. The module
+is kept with the same public entry point so the shared model wiring stays
+platform-uniform.
+"""
+
+import torch
+from torch import nn
+
+
+def enable_qwen38next_low_latency_gemm(module: nn.Module, dtype: torch.dtype) -> None:
+    """No-op on Intel XPU; the skinny-GEMM plans are CUDA-only."""
+    del module, dtype
+
+
+__all__ = ["enable_qwen38next_low_latency_gemm"]
