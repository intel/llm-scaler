+def _qsa_skip_incomplete_group(
+    raw_metadata: QSAForwardMetadata,
+    compressed_metadata: QSAForwardMetadata,
+    pending_transaction: QSAHistoricalRingPendingTransaction | None,
+    *,
+    compress_ratio: int,
+) -> bool:
+    """Skip only a producer-proven empty compressed write in eager M=1.
+
+    CPU witnesses belong to this forward's validated scheduler transaction,
+    not a cached decode position. No device scalar reads or synchronizations
+    are introduced. Strict manifest receipts and M>1 keep the original path.
+    Raw key/position stores and their stream-ordered acknowledgement MUST
+    still run, since the next group boundary consumes those historical rows.
+    """
+    if not _QSA_SKIP_INCOMPLETE_GROUP or compress_ratio != 4:
+        return False
+    if (
+        not isinstance(pending_transaction, QSAHistoricalRingPendingTransaction)
+        or pending_transaction.write_manifest_required
+        or getattr(raw_metadata, "qsa_ring_pending_transactions", ())
+        != (pending_transaction,)
+    ):
+        return False
+    logical_tags = pending_transaction.logical_tags
+    if len(logical_tags) != 1 or (logical_tags[0] + 1) % compress_ratio == 0:
+        return False
+    source_ids = getattr(raw_metadata, "logical_positions_source_ids", None)
+    if source_ids is None or source_ids != getattr(
+        compressed_metadata, "logical_positions_source_ids", None
+    ):
+        return False
+    for metadata in (raw_metadata, compressed_metadata):
+        if (
+            metadata.num_actual_tokens != 1
+            or metadata.num_mapped_tokens != 1
+            or getattr(metadata, "logical_positions_cpu", None) != logical_tags
+            or getattr(metadata, "query_start_loc_cpu", None) != (0, 1)
+        ):
+            return False
+        # CPU/reference callers can directly verify their witnesses. XPU
+        # witnesses are supplied by the metadata builder/runner transport.
+        if metadata.logical_positions.device.type == "cpu" and (
+            metadata.logical_positions.shape != (1,)
+            or int(metadata.logical_positions[0]) != logical_tags[0]
+        ):
+            return False
+    if compressed_metadata.compress_ratio != compress_ratio:
+        return False
+    return not (
+        compressed_metadata.slot_mapping.device.type == "cpu"
+        and (
+            compressed_metadata.slot_mapping.shape != (1,)
+            or int(compressed_metadata.slot_mapping[0]) != -1
+        )
+    )
+
