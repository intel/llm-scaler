+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-side provenance for Qwen3.8 QSA historical circular-cache rows.
+
+This module deliberately contains no tensor or device operations.  A capability
+is issued only from the scheduler-owned ledger after the corresponding rows
+have been acknowledged as committed.  Block IDs alone are never sufficient:
+allocation generation and request incarnation prevent ABA reuse.
+"""
+
+import hashlib
+import json
+from collections.abc import Iterable
+from dataclasses import dataclass
+from enum import Enum
+
+QSA_HISTORICAL_RING_CAPABILITY_VERSION = 1
+QSA_ROW_STORE_RECEIPT_ABI_VERSION = 4
+
+
+class QSASlotState(str, Enum):
+    INVALID = "invalid"
+    PENDING = "pending"
+    COMMITTED = "committed"
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingLease:
+    """Identity of one request-owned physical circular-cache block."""
+
+    ring_group_id: int
+    block_id: int
+    allocation_generation: int
+    owner_incarnation: int
+
+    def __post_init__(self) -> None:
+        if self.ring_group_id < 0:
+            raise ValueError("ring_group_id must be non-negative")
+        if self.block_id < 0:
+            raise ValueError("block_id must be non-negative")
+        if self.allocation_generation <= 0:
+            raise ValueError("allocation_generation must be positive")
+        if self.owner_incarnation <= 0:
+            raise ValueError("owner_incarnation must be positive")
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingCapability:
+    """Sealed proof for committed or stream-ordered ring positions."""
+
+    lease: QSAHistoricalRingLease
+    epoch: int
+    slot_tags: tuple[tuple[int, int], ...]
+    version: int = QSA_HISTORICAL_RING_CAPABILITY_VERSION
+    sealed: bool = True
+    # The producer includes the ring size so consumers can validate the
+    # physical slot mapping without relying on an untyped side channel.
+    ring_size: int | None = None
+    # Async batch-queue transports may include rows from an earlier pending
+    # frame. Those rows are safe only because the worker submits every frame
+    # on one ordered stream; the flag keeps that provenance explicit.
+    stream_ordered: bool = False
+
+    def __post_init__(self) -> None:
+        if self.version != QSA_HISTORICAL_RING_CAPABILITY_VERSION:
+            raise ValueError("unsupported QSA historical-ring capability version")
+        if type(self.stream_ordered) is not bool:
+            raise ValueError("stream-ordered capability marker must be boolean")
+        if self.epoch < 0:
+            raise ValueError("capability epoch must be non-negative")
+        if self.ring_size is not None and self.ring_size <= 0:
+            raise ValueError("capability ring size must be positive")
+        if not self.sealed:
+            raise ValueError("QSA historical-ring capabilities must be sealed")
+        previous_slot = -1
+        seen_tags: set[int] = set()
+        for slot, logical_tag in self.slot_tags:
+            if slot < 0:
+                raise ValueError("capability slot must be non-negative")
+            if logical_tag < 0:
+                raise ValueError("capability logical tag must be non-negative")
+            if slot <= previous_slot:
+                raise ValueError("capability slots must be strictly ordered")
+            if logical_tag in seen_tags:
+                raise ValueError("capability logical tags must be unique")
+            if self.ring_size is not None and slot != logical_tag % self.ring_size:
+                raise ValueError("capability slot does not match ring mapping")
+            previous_slot = slot
+            seen_tags.add(logical_tag)
+
+    @property
+    def logical_tags(self) -> tuple[int, ...]:
+        return tuple(tag for _, tag in self.slot_tags)
+
+    def proves(self, logical_tag: int) -> bool:
+        return logical_tag in self.logical_tags
+
+    def prefix(self, count: int) -> "QSAHistoricalRingCapability":
+        """Return a capability containing only its first ``count`` rows."""
+        if count < 0 or count > len(self.slot_tags):
+            raise ValueError("capability prefix is outside the sealed range")
+        return QSAHistoricalRingCapability(
+            lease=self.lease,
+            epoch=self.epoch,
+            slot_tags=self.slot_tags[:count],
+            ring_size=self.ring_size,
+            version=self.version,
+            stream_ordered=self.stream_ordered,
+        )
+
+
+@dataclass(slots=True)
+class _SlotRecord:
+    logical_tag: int
+    state: QSASlotState
+    epoch: int
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingPendingTransaction:
+    """Transport record for one scheduler-to-worker ring write."""
+
+    request_id: str
+    lease: QSAHistoricalRingLease
+    epoch: int
+    logical_tags: tuple[int, ...]
+    # Request-local causal generation.  It changes only after a predecessor
+    # frame is rejected or invalidated, fencing optimistic async successors.
+    causal_generation: int = 0
+    # New scheduler transports require a formula-checked write manifest.
+    # The default keeps hand-built legacy test transactions readable while all
+    # production scheduler transactions set this explicitly.
+    write_manifest_required: bool = False
+
+    def __post_init__(self) -> None:
+        if not self.request_id:
+            raise ValueError("request_id must not be empty")
+        if self.epoch < 0:
+            raise ValueError("transaction epoch must be non-negative")
+        if self.causal_generation < 0:
+            raise ValueError("causal generation must be non-negative")
+        if not isinstance(self.write_manifest_required, bool):
+            raise ValueError("write manifest requirement must be boolean")
+        if not self.logical_tags:
+            raise ValueError("a pending transaction must contain at least one tag")
+        if len(set(self.logical_tags)) != len(self.logical_tags):
+            raise ValueError("pending transaction tags must be unique")
+        if any(tag < 0 for tag in self.logical_tags):
+            raise ValueError("pending transaction tags must be non-negative")
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingWriteManifest:
+    """Formula-level proof for one QSA cache-row write transaction.
+
+    The manifest is built from the scheduler transaction and the worker's
+    CPU logical-position witness before any cache store is submitted.  The
+    three slot vectors retain the physical row shape, including ``-1`` for
+    rows that are not part of the circular tail.
+    """
+
+    request_id: str
+    lease: QSAHistoricalRingLease
+    epoch: int
+    logical_tags: tuple[int, ...]
+    row_logical_tags: tuple[int, ...]
+    raw_slots: tuple[int, ...]
+    compressed_slots: tuple[int, ...]
+    position_slots: tuple[int, ...]
+    raw_ring_size: int
+    compressed_block_size: int
+    compress_ratio: int
+    causal_generation: int = 0
+    version: int = QSA_HISTORICAL_RING_CAPABILITY_VERSION
+    # Physical block witnesses are supplied by the worker's CPU cache-group
+    # descriptor. ``None`` retains the legacy single-block formula for
+    # hand-built compatibility fixtures; production manifests always carry
+    # both vectors explicitly.
+    raw_block_ids: tuple[int, ...] | None = None
+    compressed_block_ids: tuple[int, ...] | None = None
+
+    def __post_init__(self) -> None:
+        if self.version != QSA_HISTORICAL_RING_CAPABILITY_VERSION:
+            raise ValueError("unsupported QSA write manifest version")
+        if not self.request_id:
+            raise ValueError("manifest request_id must not be empty")
+        if self.epoch < 0 or self.causal_generation < 0:
+            raise ValueError("manifest epoch and generation must be non-negative")
+        if self.raw_ring_size <= 0 or self.compressed_block_size <= 0:
+            raise ValueError("manifest cache page sizes must be positive")
+        if self.compress_ratio <= 0:
+            raise ValueError("manifest compression ratio must be positive")
+        tags = tuple(self.logical_tags)
+        if not tags or tuple(sorted(tags)) != tags:
+            raise ValueError("manifest logical tags must be strictly ordered")
+        if len(set(tags)) != len(tags) or any(tag < 0 for tag in tags):
+            raise ValueError("manifest logical tags must be unique and non-negative")
+        if len(self.row_logical_tags) != len(self.raw_slots):
+            raise ValueError("manifest raw rows and slots must have equal length")
+        if len(self.raw_slots) != len(self.compressed_slots):
+            raise ValueError("manifest cache slot vectors must have equal length")
+        if len(self.raw_slots) != len(self.position_slots):
+            raise ValueError("manifest position slots must match raw slots")
+        row_tags = tuple(self.row_logical_tags)
+        raw_block_ids = (
+            tuple(
+                self.lease.block_id if slot >= 0 else -1
+                for slot in self.raw_slots
+            )
+            if self.raw_block_ids is None
+            else tuple(self.raw_block_ids)
+        )
+        compressed_block_ids = (
+            tuple(
+                self.lease.block_id if slot >= 0 else -1
+                for slot in self.compressed_slots
+            )
+            if self.compressed_block_ids is None
+            else tuple(self.compressed_block_ids)
+        )
+        if len(raw_block_ids) != len(row_tags):
+            raise ValueError("manifest raw block witness length mismatch")
+        if len(compressed_block_ids) != len(row_tags):
+            raise ValueError("manifest compressed block witness length mismatch")
+        tag_set = set(tags)
+        valid_raw_tags: list[int] = []
+        valid_compressed_tags: list[int] = []
+        expected_compressed_tags = tuple(
+            row_tag
+            for row_tag in row_tags
+            if row_tag >= 0 and (row_tag + 1) % self.compress_ratio == 0
+        )
+        previous_tag = -1
+        for (
+            row_tag,
+            raw_slot,
+            compressed_slot,
+            position_slot,
+            raw_block_id,
+            compressed_block_id,
+        ) in zip(
+            row_tags,
+            self.raw_slots,
+            self.compressed_slots,
+            self.position_slots,
+            raw_block_ids,
+            compressed_block_ids,
+            strict=True,
+        ):
+            if row_tag < -1:
+                raise ValueError("manifest row logical tag must be >= -1")
+            if row_tag >= 0 and row_tag <= previous_tag:
+                raise ValueError("manifest row logical tags must be ordered")
+            if row_tag >= 0:
+                previous_tag = row_tag
+            expected_raw = -1
+            expected_compressed = -1
+            if row_tag in tag_set:
+                if raw_block_id < 0:
+                    raise ValueError("manifest raw block witness is missing")
+                expected_raw = (
+                    raw_block_id * self.raw_ring_size
+                    + row_tag % self.raw_ring_size
+                )
+                valid_raw_tags.append(row_tag)
+            elif raw_block_id != -1:
+                raise ValueError("manifest has an out-of-tail raw block witness")
+            if row_tag >= 0 and (row_tag + 1) % self.compress_ratio == 0:
+                if compressed_block_id < 0:
+                    raise ValueError(
+                        "manifest compressed block witness is missing"
+                    )
+                expected_compressed = (
+                    compressed_block_id * self.compressed_block_size
+                    + (row_tag // self.compress_ratio)
+                    % self.compressed_block_size
+                )
+                valid_compressed_tags.append(row_tag)
+            elif compressed_block_id != -1:
+                raise ValueError(
+                    "manifest has a non-boundary compressed block witness"
+                )
+            if raw_slot != expected_raw:
+                raise ValueError("manifest raw slot does not match logical mapping")
+            if compressed_slot != expected_compressed:
+                raise ValueError(
+                    "manifest compressed slot does not match logical mapping"
+                )
+            if position_slot != expected_raw:
+                raise ValueError("manifest position slot does not match raw mapping")
+        if tuple(valid_raw_tags) != tags:
+            raise ValueError("manifest rows do not cover transaction logical tags")
+        if len(
+            {slot for slot in self.raw_slots if slot >= 0}
+        ) != len(valid_raw_tags):
+            raise ValueError("manifest raw slots must be unique")
+        valid_compressed_slots = [
+            slot for slot in self.compressed_slots if slot >= 0
+        ]
+        if len(set(valid_compressed_slots)) != len(valid_compressed_slots):
+            raise ValueError("manifest compressed slots must be unique")
+        if expected_compressed_tags != tuple(valid_compressed_tags):
+            raise ValueError("manifest compressed boundary rows are inconsistent")
+
+    @classmethod
+    def from_transaction(
+        cls,
+        transaction: "QSAHistoricalRingPendingTransaction",
+        row_logical_tags: tuple[int, ...] | list[int],
+        *,
+        raw_ring_size: int,
+        compressed_block_size: int,
+        compress_ratio: int,
+        raw_block_ids: tuple[int, ...] | None = None,
+        compressed_block_ids: tuple[int, ...] | None = None,
+    ) -> "QSAHistoricalRingWriteManifest":
+        tags = tuple(transaction.logical_tags)
+        tag_set = set(tags)
+        row_tags = tuple(int(tag) for tag in row_logical_tags)
+        if raw_block_ids is None:
+            raw_block_ids = tuple(
+                transaction.lease.block_id if tag in tag_set else -1
+                for tag in row_tags
+            )
+        else:
+            raw_block_ids = tuple(int(block_id) for block_id in raw_block_ids)
+        if compressed_block_ids is None:
+            compressed_block_ids = tuple(
+                transaction.lease.block_id
+                if tag >= 0 and (tag + 1) % compress_ratio == 0
+                else -1
+                for tag in row_tags
+            )
+        else:
+            compressed_block_ids = tuple(
+                int(block_id) for block_id in compressed_block_ids
+            )
+        if len(raw_block_ids) != len(row_tags):
+            raise ValueError("raw block witness length mismatch")
+        if len(compressed_block_ids) != len(row_tags):
+            raise ValueError("compressed block witness length mismatch")
+        raw_slots = []
+        compressed_slots = []
+        position_slots = []
+        for row_tag, raw_block_id, compressed_block_id in zip(
+            row_tags, raw_block_ids, compressed_block_ids, strict=True
+        ):
+            raw_slot = (
+                raw_block_id * raw_ring_size + row_tag % raw_ring_size
+                if row_tag in tag_set
+                else -1
+            )
+            compressed_slot = (
+                compressed_block_id * compressed_block_size
+                + (row_tag // compress_ratio) % compressed_block_size
+                if row_tag >= 0
+                and (row_tag + 1) % compress_ratio == 0
+                else -1
+            )
+            raw_slots.append(raw_slot)
+            compressed_slots.append(compressed_slot)
+            position_slots.append(raw_slot)
+        return cls(
+            request_id=transaction.request_id,
+            lease=transaction.lease,
+            epoch=transaction.epoch,
+            logical_tags=tags,
+            row_logical_tags=row_tags,
+            raw_slots=tuple(raw_slots),
+            compressed_slots=tuple(compressed_slots),
+            position_slots=tuple(position_slots),
+            raw_ring_size=raw_ring_size,
+            compressed_block_size=compressed_block_size,
+            compress_ratio=compress_ratio,
+            causal_generation=transaction.causal_generation,
+            raw_block_ids=raw_block_ids,
+            compressed_block_ids=compressed_block_ids,
+        )
+
+    def expected_slots(self, store_kind: str) -> tuple[int, ...]:
+        if store_kind == "raw":
+            return self.raw_slots
+        if store_kind == "compressed":
+            return self.compressed_slots
+        if store_kind == "position":
+            return self.position_slots
+        raise ValueError(f"unknown QSA manifest store kind: {store_kind}")
+
+    def canonical_bytes(self) -> bytes:
+        """Return the immutable, versioned encoding used for receipt binding."""
+        payload = {
+            "causal_generation": self.causal_generation,
+            "compressed_block_ids": self.compressed_block_ids,
+            "compressed_block_size": self.compressed_block_size,
+            "compressed_slots": self.compressed_slots,
+            "compress_ratio": self.compress_ratio,
+            "epoch": self.epoch,
+            "lease": {
+                "allocation_generation": self.lease.allocation_generation,
+                "block_id": self.lease.block_id,
+                "owner_incarnation": self.lease.owner_incarnation,
+                "ring_group_id": self.lease.ring_group_id,
+            },
+            "logical_tags": self.logical_tags,
+            "position_slots": self.position_slots,
+            "raw_block_ids": self.raw_block_ids,
+            "raw_ring_size": self.raw_ring_size,
+            "raw_slots": self.raw_slots,
+            "request_id": self.request_id,
+            "row_logical_tags": self.row_logical_tags,
+            "version": self.version,
+        }
+        return json.dumps(
+            payload, ensure_ascii=True, separators=(",", ":"), sort_keys=True
+        ).encode("utf-8")
+
+    @property
+    def digest(self) -> str:
+        """Return the SHA-256 digest of the canonical manifest encoding."""
+        return hashlib.sha256(self.canonical_bytes()).hexdigest()
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingWriteAcknowledgement:
+    """Worker contract confirming rows written by the current forward.
+
+    The worker emits this only after the forward and its QSA cache-write path
+    complete.  It repeats the immutable transaction identity so the scheduler
+    cannot turn a successful but unrelated frame into a commit.
+    """
+
+    request_id: str
+    lease: QSAHistoricalRingLease
+    epoch: int
+    logical_tags: tuple[int, ...]
+    causal_generation: int = 0
+    manifest: QSAHistoricalRingWriteManifest | None = None
+    # Manifest acknowledgements must carry an explicit native receipt ABI and
+    # digest.  ``None`` remains the legacy value only for acknowledgements that
+    # intentionally contain no manifest.
+    receipt_abi_version: int | None = None
+    manifest_digest: str | None = None
+
+    def __post_init__(self) -> None:
+        if not self.request_id:
+            raise ValueError("request_id must not be empty")
+        if self.epoch < 0:
+            raise ValueError("acknowledgement epoch must be non-negative")
+        if self.causal_generation < 0:
+            raise ValueError("acknowledgement causal generation must be non-negative")
+        if self.manifest is not None:
+            if type(self.manifest) is not QSAHistoricalRingWriteManifest:
+                raise ValueError("acknowledgement manifest has an invalid type")
+            if (
+                self.manifest.request_id != self.request_id
+                or self.manifest.lease != self.lease
+                or self.manifest.epoch != self.epoch
+                or self.manifest.logical_tags != self.logical_tags
+                or self.manifest.causal_generation != self.causal_generation
+            ):
+                raise ValueError("acknowledgement manifest identity mismatch")
+            if self.receipt_abi_version != QSA_ROW_STORE_RECEIPT_ABI_VERSION:
+                raise ValueError(
+                    "manifest acknowledgement requires an explicit receipt ABI4"
+                )
+            if self.manifest_digest != self.manifest.digest:
+                raise ValueError("acknowledgement manifest digest mismatch")
+        else:
+            if self.receipt_abi_version is None:
+                object.__setattr__(self, "receipt_abi_version", 0)
+            elif self.receipt_abi_version != 0:
+                raise ValueError(
+                    "receipt ABI requires a write manifest"
+                )
+            if self.manifest_digest is not None:
+                raise ValueError("manifest digest requires a write manifest")
+        if self.receipt_abi_version < 0:
+            raise ValueError("acknowledgement receipt ABI must be non-negative")
+        if not self.logical_tags:
+            raise ValueError("an acknowledgement must contain at least one tag")
+        if len(set(self.logical_tags)) != len(self.logical_tags):
+            raise ValueError("acknowledgement tags must be unique")
+        if any(tag < 0 for tag in self.logical_tags):
+            raise ValueError("acknowledgement tags must be non-negative")
+
+
+def merge_qsa_ring_write_acknowledgements(
+    *acknowledgement_groups: Iterable[
+        QSAHistoricalRingWriteAcknowledgement
+    ],
+) -> tuple[QSAHistoricalRingWriteAcknowledgement, ...]:
+    """Merge PP receipt sidecars without weakening provenance checks."""
+    merged: dict[
+        tuple[
+            str,
+            QSAHistoricalRingLease,
+            int,
+            tuple[int, ...],
+            int,
+        ],
+        QSAHistoricalRingWriteAcknowledgement,
+    ] = {}
+    for group in acknowledgement_groups:
+        for acknowledgement in group:
+            if type(acknowledgement) is not QSAHistoricalRingWriteAcknowledgement:
+                raise ValueError(
+                    "QSA acknowledgement sidecar contains an invalid type"
+                )
+            key = (
+                acknowledgement.request_id,
+                acknowledgement.lease,
+                acknowledgement.epoch,
+                acknowledgement.logical_tags,
+                acknowledgement.causal_generation,
+            )
+            previous = merged.get(key)
+            if previous is not None and previous != acknowledgement:
+                raise ValueError(
+                    "conflicting QSA acknowledgement sidecars for one transaction"
+                )
+            merged[key] = acknowledgement
+    return tuple(merged.values())
+
+
+class QSAHistoricalRingLedger:
+    """Scheduler-side state machine for one active ring lease.
+
+    ``begin_pending`` records intent only.  A row becomes readable by a future
+    decode step only after ``commit_accepted`` is called with the same lease,
+    epoch, and logical tag.  A new allocation or owner incarnation invalidates
+    the entire ledger by replacing its lease.
+    """
+
+    def __init__(self, lease: QSAHistoricalRingLease, ring_size: int) -> None:
+        if ring_size <= 0:
+            raise ValueError("ring_size must be positive")
+        self._lease = lease
+        self._ring_size = ring_size
+        self._epoch = 0
+        self._revoked = False
+        self._slots: dict[int, _SlotRecord] = {}
+
+    @property
+    def lease(self) -> QSAHistoricalRingLease:
+        return self._lease
+
+    @property
+    def epoch(self) -> int:
+        return self._epoch
+
+    @property
+    def ring_size(self) -> int:
+        return self._ring_size
+
+    @property
+    def revoked(self) -> bool:
+        return self._revoked
+
+    def _check_lease(self, lease: QSAHistoricalRingLease) -> None:
+        if self._revoked or lease != self._lease:
+            raise RuntimeError("QSA historical-ring lease is stale or revoked")
+
+    def _slot(self, logical_tag: int) -> int:
+        if logical_tag < 0:
+            raise ValueError("logical tag must be non-negative")
+        return logical_tag % self._ring_size
+
+    @staticmethod
+    def _normalize_tags(logical_tags: Iterable[int]) -> tuple[int, ...]:
+        tags = tuple(logical_tags)
+        if len(set(tags)) != len(tags):
+            raise ValueError("logical tags must be unique")
+        if any(tag < 0 for tag in tags):
+            raise ValueError("logical tags must be non-negative")
+        return tags
+
+    def begin_pending(
+        self,
+        lease: QSAHistoricalRingLease,
+        epoch: int,
+        logical_tags: Iterable[int],
+    ) -> None:
+        """Mark rows as pending before the worker starts its cache write."""
+        self._check_lease(lease)
+        if epoch < 0:
+            raise RuntimeError("QSA pending epoch must be non-negative")
+        tags = self._normalize_tags(logical_tags)
+        if len(tags) > self._ring_size:
+            raise ValueError("pending transaction exceeds QSA ring capacity")
+        slots = [self._slot(tag) for tag in tags]
+        if len(set(slots)) != len(slots):
+            raise ValueError("pending transaction aliases a physical ring slot")
+        if epoch > self._epoch:
+            self._epoch = epoch
+        # Do not clear pending rows merely because a later async/PP schedule
+        # started. They are independent transactions; an older commit remains
+        # valid when its physical slot has not been overwritten.
+        for logical_tag in tags:
+            slot = self._slot(logical_tag)
+            old = self._slots.get(slot)
+            if old is not None and old.logical_tag == logical_tag:
+                raise RuntimeError("QSA logical tag is already tracked")
+            # Ring wrap overwrites the prior logical tag.  It is invalidated
+            # before the new row can become pending.
+            self._slots[slot] = _SlotRecord(
+                logical_tag=logical_tag,
+                state=QSASlotState.PENDING,
+                epoch=epoch,
+            )
+
+    def commit_accepted(
+        self,
+        lease: QSAHistoricalRingLease,
+        epoch: int,
+        logical_tags: Iterable[int],
+    ) -> None:
+        """Commit rows whose worker write and acceptance are confirmed.
+
+        Async v2 can have a successor transaction pending before the
+        predecessor's completion is consumed by the scheduler.  If the
+        successor wraps the ring, its ``begin_pending`` necessarily replaces
+        the predecessor's record for the reused physical slot.  That one old
+        row is no longer ours, but the other rows in the predecessor are still
+        valid and must remain available to the next compression group.
+
+        Treat a newer record in the same physical slot as an already-applied
+        overwrite and commit the remaining matching rows.  A missing or older
+        record still fails closed: it means the ledger cannot establish that
+        the requested row survived.
+        """
+        self._check_lease(lease)
+        if epoch < 0 or epoch > self._epoch:
+            raise RuntimeError("QSA commit epoch does not match ledger epoch")
+        for logical_tag in self._normalize_tags(logical_tags):
+            slot = self._slot(logical_tag)
+            record = self._slots.get(slot)
+            if record is None:
+                raise RuntimeError("QSA commit does not match pending row")
+            if record.logical_tag > logical_tag:
+                # A newer transaction has already claimed this physical slot.
+                # Do not resurrect the overwritten logical row and do not let
+                # it poison the still-live rows from this transaction.
+                continue
+            if record.logical_tag != logical_tag:
+                raise RuntimeError("QSA commit does not match pending row")
+            if record.state is QSASlotState.COMMITTED and record.epoch == epoch:
+                # Completion delivery can be duplicated across PP/TP paths.
+                continue
+            if record.state is not QSASlotState.PENDING or record.epoch != epoch:
+                raise RuntimeError("QSA commit does not match pending row")
+            record.state = QSASlotState.COMMITTED
+
+    def rollback(
+        self,
+        lease: QSAHistoricalRingLease,
+        new_epoch: int,
+        logical_tags: Iterable[int] = (),
+        *,
+        transaction_epoch: int | None = None,
+    ) -> None:
+        """Invalidate rejected or failed rows and advance the write epoch.
+
+        ``transaction_epoch`` identifies the schedule being rolled back when
+        async execution has more than one pending epoch. Without it, the
+        newest pending epoch is used for backwards-compatible single-flight
+        callers.
+        """
+        self._check_lease(lease)
+        if new_epoch < self._epoch:
+            raise RuntimeError("QSA rollback epoch is older than ledger epoch")
+        if transaction_epoch is not None and transaction_epoch < 0:
+            raise ValueError("transaction_epoch must be non-negative")
+        tags = set(self._normalize_tags(logical_tags))
+        pending_epochs = [
+            record.epoch
+            for record in self._slots.values()
+            if record.state is QSASlotState.PENDING
+        ]
+        target_epoch = transaction_epoch
+        if target_epoch is None and pending_epochs:
+            target_epoch = max(pending_epochs)
+        if new_epoch > self._epoch:
+            self._epoch = new_epoch
+        for slot, record in tuple(self._slots.items()):
+            if (
+                (
+                    record.logical_tag in tags
+                    and (target_epoch is None or record.epoch == target_epoch)
+                )
+                or (
+                    record.state is QSASlotState.PENDING
+                    and (target_epoch is None or record.epoch == target_epoch)
+                )
+            ):
+                del self._slots[slot]
+
+    def revoke(self) -> None:
+        """Invalidate all rows immediately when the owner is released."""
+        self._revoked = True
+        self._slots.clear()
+
+    def prove_committed(
+        self, lease: QSAHistoricalRingLease, logical_tag: int
+    ) -> bool:
+        """Return true only for an exact current committed logical tag."""
+        self._check_lease(lease)
+        record = self._slots.get(self._slot(logical_tag))
+        return bool(
+            record is not None
+            and record.logical_tag == logical_tag
+            and record.state is QSASlotState.COMMITTED
+        )
+
+    def snapshot(
+        self,
+        lease: QSAHistoricalRingLease,
+        *,
+        include_pending: bool = False,
+    ) -> QSAHistoricalRingCapability | None:
+        """Seal committed rows, optionally including ordered pending rows."""
+        self._check_lease(lease)
+        slot_tags = sorted(
+            (slot, record.logical_tag)
+            for slot, record in self._slots.items()
+            if include_pending or record.state is QSASlotState.COMMITTED
+        )
+        if not slot_tags:
+            return None
+        return QSAHistoricalRingCapability(
+            lease=lease,
+            epoch=self._epoch,
+            slot_tags=tuple(slot_tags),
+            ring_size=self._ring_size,
+            stream_ordered=include_pending,
+        )
