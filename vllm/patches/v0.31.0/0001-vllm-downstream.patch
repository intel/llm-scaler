+            size=size,
+            layers=[name],
+            layer_stride=layout.main_kv_page_size * num_blocks,
+            block_stride=layout.main_kv_page_size,
+            offset=index * layout.main_kv_page_size * num_blocks,
+        )
+        for index, main_kv_name in enumerate(layout.main_kv_names)
+        for name in [main_kv_name] + [
+            group.layer_names[index]
+            for group in layout.mamba_groups
+            if index < len(group.layer_names)
+        ]
+    ]
+    kv_cache_tensors.extend(
+        KVCacheTensor(
+            size=size,
+            layers=[name],
+            layer_stride=layout.compressed_page_size * num_blocks,
+            block_stride=layout.compressed_page_size,
+            offset=(len(layout.main_kv_names) * layout.main_kv_page_size
+                    + index * layout.compressed_page_size) * num_blocks,
+        )
+        for index, compressed_name in enumerate(layout.compressed_names)
+        for name in [compressed_name, layout.compressor_state_names[index]]
+    )
+    return num_blocks, kv_cache_tensors
