index 0000000000..f63b7a5eab
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/greedy_decode.py
@@ -0,0 +1,197 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Pure-greedy TP4/TP8 decode without transporting the full vocabulary logits."""
+
+from __future__ import annotations
+
+import os
+from functools import lru_cache
+from importlib import import_module
+from typing import Any
+
+import torch
+from torch.nn.modules import module as nn_module
+
+from vllm import envs
+from vllm.logger import init_logger
+from vllm.v1.outputs import SamplerOutput
+from vllm.v1.sample.logits_processor.builtin import (
+    LogitBiasLogitsProcessor,
+    MinTokensLogitsProcessor,
+)
+from vllm.v1.sample.sampler import Sampler
+
+from .full_decode import full_decode_enabled
+
+logger = init_logger(__name__)
+
+
+@lru_cache(maxsize=2)
+def _sycl_argmax_ops(tp_size: int = 8):
+    try:
+        module = import_module("vllm_xpu_kernels._qwen38_C")
+    except (ImportError, OSError):
+        return None
+    if getattr(module, "greedy_argmax_sycl_abi_version", None) != 1:
+        return None
+    if tp_size not in getattr(module, "greedy_argmax_sycl_tp_sizes", (8,)):
+        return None
+    local = getattr(module, "try_local_argmax_packet", None)
+    global_ = getattr(module, "try_global_argmax_token", None)
+    global_int32 = getattr(module, "try_global_argmax_token_int32", None)
+    return (
+        (local, global_, global_int32)
+        if callable(local) and callable(global_)
+        else None
+    )
+
+
+def try_sycl_argmax_logits(
+    logits, lm_head, output_dtype: torch.dtype = torch.int64
+) -> torch.Tensor | None:
+    """Fuse M1 reductions and packing; keep the existing XCCL rank order."""
+    if (
+        logits.device.type != "xpu"
+        or logits.dtype != torch.float16
+        or logits.ndim != 2
+        or logits.shape[0] != 1
+        or lm_head.tp_size not in (4, 8)
+    ):
+        return None
+    from vllm.model_executor.models._qwen3_next_xpu import _direct_parameters
+
+    if not _direct_parameters(logits):
+        return None
+    ops = _sycl_argmax_ops(lm_head.tp_size)
+    if ops is None:
+        return None
+    local, global_, global_int32 = ops
+    if output_dtype == torch.int32 and callable(global_int32):
+        global_ = global_int32
+    packet = local(
+        logits,
+        lm_head.shard_indices.org_vocab_start_index,
+        lm_head.shard_indices.num_org_vocab_padding,
+    )
+    if packet is None:
+        return None  # Native eligibility miss before any submission.
+    from vllm.distributed import get_tp_group
+
+    group = get_tp_group()
+    gathered = packet.new_empty((lm_head.tp_size, 64))
+    torch.distributed.all_gather_into_tensor(gathered, packet, group=group.device_group)
+    token = global_(gathered)
+    if token is None:
+        raise RuntimeError("SYCL argmax transport violated its native packet ABI")
+    logger.info_once("Qwen3.8 TP4/TP8 greedy uses fused SYCL argmax packet/reduction.")
+    return token if token.dtype == output_dtype else token.to(output_dtype)
+
+
+def pure_greedy_metadata(metadata: Any) -> bool:
+    """CPU-only proof; never inspect a device tensor's contents."""
+    if (
+        not metadata.all_greedy
+        or not metadata.no_penalties
+        or metadata.max_num_logprobs is not None
+        or metadata.logprob_token_ids
+        or metadata.allowed_token_ids_mask is not None
+        or metadata.bad_words_token_ids
+    ):
+        return False
+    holder = metadata.thinking_budget_state_holder
+    if holder is not None and holder.has_tracked_requests():
+        return False
+    # Greedy sampling skips argmax-invariant processors. The two builtin
+    # non-invariant processors are safe only when their live CPU maps are empty.
+    for processor in metadata.logitsprocs.non_argmax_invariant:
+        if type(processor) is LogitBiasLogitsProcessor:
+            if processor.biases:
+                return False
+        elif type(processor) is MinTokensLogitsProcessor:
+            if processor.min_toks:
+                return False
+        else:
+            return False
+    return True
+
+
+def try_decode_greedy_sample(
+    runner: Any,
+    hidden_states: torch.Tensor,
+    scheduler_output: Any,
+    *,
+    num_scheduled_tokens: int,
+    spec_decode_metadata: Any,
+) -> SamplerOutput | None:
+    config = runner.vllm_config
+    if (
+        os.getenv("VLLM_XPU_QWEN38_GREEDY_SAMPLE", "0") != "1"
+        or not full_decode_enabled(config)
+        or config.parallel_config.tensor_parallel_size not in (4, 8)
+        or config.parallel_config.pipeline_parallel_size != 1
+        or config.lora_config is not None
+        or runner.broadcast_pp_output
+        or runner.use_aux_hidden_state_outputs
+        or num_scheduled_tokens != 1
+        or runner.input_batch.num_reqs != 1
+        or spec_decode_metadata is not None
+        or scheduler_output.has_structured_output_requests
+        or envs.VLLM_COMPUTE_NANS_IN_LOGITS
+        or not pure_greedy_metadata(runner.input_batch.sampling_metadata)
+    ):
+        return None
+    from vllm.model_executor.layers.logits_processor import LogitsProcessor
+    from vllm.model_executor.models._qwen3_next_xpu import _direct_parameters
+
+    raw_model = runner.get_model()
+    model = getattr(raw_model, "language_model", raw_model)
+    processor = getattr(model, "logits_processor", None)
+    head = getattr(model, "lm_head", None)
+    if (
+        type(processor) is not LogitsProcessor
+        or head is None
+        or not _direct_parameters(hidden_states, head.weight)
+        or hidden_states.device.type != "xpu"
+        or hidden_states.dtype != torch.float16
+        or hidden_states.ndim != 2
+        or hidden_states.shape[0] != 1
+        or processor.head_dtype not in (None, torch.float16)
+        or processor.logits_as_input
+        or processor.soft_cap is not None
+        or processor.scale != 1.0
+        or processor._forward_hooks
+        or processor._forward_pre_hooks
+        or processor._backward_pre_hooks
+        or processor._backward_hooks
+        or "forward" in processor.__dict__
+        # This path bypasses both modules' __call__, including global hooks.
+        or type(runner.sampler) is not Sampler
+        or runner.sampler._forward_hooks
+        or runner.sampler._forward_pre_hooks
+        or runner.sampler._backward_hooks
+        or runner.sampler._backward_pre_hooks
+        or "forward" in runner.sampler.__dict__
+        or nn_module._global_forward_hooks
+        or nn_module._global_forward_pre_hooks
+        or nn_module._global_backward_hooks
+        or nn_module._global_backward_pre_hooks
+        or processor.org_vocab_size != processor.vocab_size
+        or processor.org_vocab_size >= 2**24
+        or head.tp_size != config.parallel_config.tensor_parallel_size
+    ):
+        return None
+    # Reuse the existing vocab-parallel reduction: same head computation,
+    # FP32 transport indices, shard padding, NaN and low-index tie behavior.
+    # Runtime/collective exceptions propagate, without a second submission.
+    tokens = processor.get_top_tokens(
+        head, hidden_states, pad_xpu_pairs=True, output_dtype=torch.int32
+    )
+    if not getattr(runner, "_qwen38_greedy_logged", False):
+        runner._qwen38_greedy_logged = True
+        logger.info(
+            "Qwen3.8 TP%d pure-greedy decode uses vocab-parallel argmax, "
+            "local lm_head weight=%s.",
+            head.tp_size,
+            tuple(head.weight.shape),
+        )
+    return SamplerOutput(sampled_token_ids=tokens.view(-1, 1), logprobs_tensors=None)
diff --git a/vllm/models/qwen4_exp/xpu/hyperconnection.py b/vllm/models/qwen4_exp/xpu/hyperconnection.py
