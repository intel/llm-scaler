+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""B1 exact-M2..8 FULL target verify 的固定地址 metadata。
+
+真实 step 必须在 replay 前于图外完成真实 metadata 的 ledger.prepare 和 stage。
+图内仍须执行 validate_history/acknowledge_store，不能以 owns() 代替 proof。
+dummy 不调用真实 ledger.prepare；slot=-1 仅允许 history sink 写入。
+本类只校验 metadata shape/CPU lease，不校验 GPU indices/accepted 的数据范围。
+target/draft 配置隔离、owner-scoped prepare 去重和 runtime wrapper 由调用方接入。
+"""
+
+from __future__ import annotations
+
+from copy import copy
+from typing import Any
+
+import torch
+
+from vllm.compilation.monitor import validate_cudagraph_capturing_enabled
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+from vllm.v1.core.qsa_provenance import QSAHistoricalRingLease
+
+from .full_decode import _try_copy_metadata, _unique_metadata
+from .qsa import Qwen3_8FlashNextQSAMetadata
+from .qsa_cache import QSAForwardMetadata
+from .short_conv import PleShortConvAttentionMetadata
+
+
+class Qwen38FullVerifyState:
+    """只拥有固定地址 metadata buffers；不拥有 cache/tag，也不签发 proof。"""
+
+    def __init__(
+        self,
+        config: Any,
+        metadata: dict[str, Any],
+        *,
+        max_seq_len: int,
+        dummy: bool = False,
+    ) -> None:
+        model, parallel = config.model_config, config.parallel_config
+        spec = config.speculative_config
+        if not (
+            (parallel.tensor_parallel_size, model.quantization)
+            in {(4, "sym_int4"), (8, "sym_int4"), (8, "fp8_per_tensor")}
+            and model.dtype == torch.float16
+            and config.cache_config.mamba_ssm_cache_dtype == "float16"
+            and config.scheduler_config.async_scheduling
+            and parallel.pipeline_parallel_size == parallel.data_parallel_size == 1
+            and not parallel.enable_expert_parallel
+            and not parallel.enable_eplb
+            and not parallel.use_sequence_parallel_moe
+            and not parallel.enable_dbo
+            and config.lora_config is None
+            and spec is not None
+            and spec.method == "mtp"
+            and 1 <= spec.num_speculative_tokens <= 7
+            and 0 < max_seq_len <= model.max_model_len
+        ):
+            raise ValueError(
+                "FULL verify requires TP4 INT4 or TP8 INT4/FP8, "
+                "FP16 activation/SSM, async MTP draft=1..7"
+            )
+        self.is_draft = bool(
+            getattr(
+                getattr(config, "compilation_config", None),
+                "_qwen38_full_draft_graph",
+                False,
+            )
+        )
+        self.num_tokens = 1 if self.is_draft else 1 + spec.num_speculative_tokens
+        self.max_seq_len = max_seq_len
+        self._check(
+            metadata, num_tokens=self.num_tokens, dummy=dummy, draft=self.is_draft
+        )
+        self._names = tuple(metadata)
+        self._aliases = self._object_aliases(metadata)
+        self.metadata: dict[str, Any] = {}
+        self._fields: list[tuple[str, str, torch.Tensor]] = []
+        self._bindings: list[tuple[str, str, torch.Tensor]] = []
+        objects: dict[int, Any] = {}
+        buffers: dict[tuple, torch.Tensor] = {}
+        for name, source in metadata.items():
+            if id(source) in objects:
+                self.metadata[name] = objects[id(source)]
+                continue
+            target = copy(source)
+            objects[id(source)] = target
+            self.metadata[name] = target
+            for field, value in vars(source).items():
+                if isinstance(value, torch.Tensor) and value.device.type == "xpu":
+                    if value.is_neg() or value.is_conj():
+                        raise ValueError("FULL verify rejects lazy metadata views")
+                    key = self._tensor_key(value)
+                    buffer = buffers.get(key)
+                    if buffer is None:
+                        buffer = torch.empty_strided(
+                            value.shape,
+                            value.stride(),
+                            dtype=value.dtype,
+                            device=value.device,
+                        )
+                        buffers[key] = buffer
+                        self._fields.append((name, field, buffer))
+                    setattr(target, field, buffer)
+                    self._bindings.append((name, field, buffer))
+            self._clear_cpu_trust(target)
+            if hasattr(target, "max_seq_len"):
+                target.max_seq_len = self.max_seq_len
+        self._metadata_ids = frozenset(id(m) for m in self.metadata.values())
+
+    @staticmethod
+    def _tensor_key(value: torch.Tensor) -> tuple:
+        return (
+            value.data_ptr(),
+            value.shape,
+            value.stride(),
+            value.dtype,
+            value.device,
+        )
+
+    @staticmethod
+    def _check_dummy_capture() -> None:
+        if not (
+            is_forward_context_available()
+            and get_forward_context().additional_kwargs.get(
+                "qwen38_xpu_full_verify_dummy"
+            )
+            is True
+        ):
+            raise ValueError("FULL verify dummy requires wrapper private capture flag")
+        validate_cudagraph_capturing_enabled()
+
+    @staticmethod
+    def _object_aliases(metadata: dict[str, Any]) -> tuple[int, ...]:
+        seen: dict[int, int] = {}
+        return tuple(seen.setdefault(id(m), len(seen)) for m in metadata.values())
+
+    @staticmethod
+    def _tensor(
+        m: Any, field: str, shape: tuple[int, ...], dtype: torch.dtype = torch.int32
+    ) -> None:
+        value: Any = getattr(m, field, None)
+        if not (
+            type(value) is torch.Tensor
+            and value.device.type == "xpu"
+            and value.shape == shape
+            and not value.is_neg()
+            and not value.is_conj()
+            and value.dtype == dtype
+            and value.is_contiguous()
+        ):
+            raise ValueError(f"Invalid FULL verify metadata field: {field}")
+
+    @classmethod
+    def _check(
+        cls,
+        metadata: dict[str, Any],
+        *,
+        num_tokens: int,
+        dummy: bool = False,
+        draft: bool = False,
+    ) -> None:
+        if not ((draft and num_tokens == 1) or (not draft and 2 <= num_tokens <= 8)):
+            raise ValueError("FULL verify requires M=2..8")
+        if dummy:
+            cls._check_dummy_capture()
+        if not isinstance(metadata, dict) or not metadata:
+            raise ValueError("FULL verify requires per-layer metadata")
+        for _, m in _unique_metadata(metadata):
+            if isinstance(m, QSAForwardMetadata):
+                leases = getattr(m, "qsa_ring_device_leases", ())
+                table = getattr(m, "block_table_cpu", None)
+                if not (
+                    m.num_actual_tokens == m.num_mapped_tokens == num_tokens
+                    and m.compress_ratio in (1, 4)
+                ):
+                    raise ValueError("FULL verify requires exact-M QSA metadata")
+                if not dummy and m.query_start_loc_cpu != (0, num_tokens):
+                    raise ValueError("FULL verify requires exact query span (0,M)")
+                if (
+                    not dummy
+                    and m.compress_ratio == 1
+                    and not (
+                        m.query_start_loc_cpu == (0, num_tokens)
+                        and m.qsa_ring_device_guard is True
+                        and isinstance(leases, tuple)
+                        and len(leases) == 1
+                        and type(leases[0]) is QSAHistoricalRingLease
+                        and isinstance(table, torch.Tensor)
+                        and table.device.type == "cpu"
+                        and table.ndim == 2
+                        and table.shape[0] >= 1
+                        and table.shape[1] > 0
+                        and int(table[0, 0]) == leases[0].block_id
+                    )
+                ):
+                    table_shape = tuple(table.shape) if table is not None else None
+                    lease_block = (
+                        getattr(leases[0], "block_id", None) if leases else None
+                    )
+                    raise ValueError(
+                        "FULL verify requires real B1 device-history leases: "
+                        f"ratio={m.compress_ratio}, starts={m.query_start_loc_cpu}, "
+                        f"guard={m.qsa_ring_device_guard}, leases={len(leases)}, "
+                        f"lease_type={type(leases[0]).__name__ if leases else None}, "
+                        f"table_shape={table_shape}, "
+                        f"block={int(table[0, 0]) if table is not None else None}, "
+                        f"lease_block={lease_block}"
+                    )
+                for field in ("slot_mapping", "logical_positions"):
+                    cls._tensor(m, field, (num_tokens,), torch.int64)
+                cls._tensor(m, "token_to_req", (num_tokens,))
+            elif isinstance(m, (GDNAttentionMetadata, PleShortConvAttentionMetadata)):
+                if not (
+                    m.num_actual_tokens == m.num_spec_decode_tokens == num_tokens
+                    and m.num_spec_decodes == 1
+                    and m.num_decodes == m.num_decode_tokens == m.num_prefills == 0
+                    and m.num_prefill_tokens == 0
+                ):
+                    raise ValueError(
+                        "FULL verify requires one pure exact-M spec sequence"
+                    )
+                cls._tensor(
+                    m,
+                    "spec_state_indices_tensor",
+                    (1, num_tokens) if isinstance(m, GDNAttentionMetadata) else (1,),
+                )
+                cls._tensor(m, "spec_query_start_loc", (2,))
+                cls._tensor(m, "spec_token_indx", (num_tokens,))
+                cls._tensor(m, "num_accepted_tokens", (1,))
+            elif (
+                not isinstance(m, Qwen3_8FlashNextQSAMetadata)
+                or m.num_actual_tokens != num_tokens
+            ):
+                raise ValueError("Unsupported FULL verify metadata")
+            cls._tensor(
+                m,
+                "query_start_loc"
+                if hasattr(m, "query_start_loc")
+                else "spec_query_start_loc",
+                (2,),
+            )
+            for value in vars(m).values():
+                if (
+                    isinstance(value, torch.Tensor)
+                    and value.device.type == "xpu"
+                    and (
+                        type(value) is not torch.Tensor
+                        or value.is_neg()
+                        or value.is_conj()
+                    )
+                ):
+                    raise ValueError("Unsupported FULL verify tensor metadata")
+        for name, raw in metadata.items():
+            if not (
+                isinstance(raw, QSAForwardMetadata)
+                and raw.compress_ratio == 1
+                and name.endswith("raw_key_cache")
+            ):
+                continue
+            paired = metadata.get(
+                name[: -len("raw_key_cache")] + "compressed_key_cache"
+            )
+            if not (
+                isinstance(paired, QSAForwardMetadata)
+                and paired.compress_ratio == 4
+                and raw.logical_positions_source_ids
+                == paired.logical_positions_source_ids
+                and raw.logical_positions_cpu == paired.logical_positions_cpu
+                and raw.query_start_loc_cpu == paired.query_start_loc_cpu
+            ):
+                raise ValueError("FULL verify QSA paired row mapping changed")
+
+    @staticmethod
+    def _clear_cpu_trust(m: Any) -> None:
+        for field in (
+            "historical_ring_proven",
+            "mrope_positions_bounds_proven",
+            "compressed_slots_unique_proven",
+            "token_permutation_proven",
+        ):
+            if hasattr(m, field):
+                setattr(m, field, False)
+        for field in (
+            "construction_proof",
+            "qsa_historical_ring_capabilities",
+            "qsa_ring_pending_transaction",
+        ):
+            if hasattr(m, field):
+                setattr(m, field, None)
+        if isinstance(m, QSAForwardMetadata):
+            m.qsa_ring_pending_transactions = ()
+            m.qsa_ring_device_guard = True  # 启用设备校验，不声明历史有效。
+
+    def stage(
+        self,
+        metadata: dict[str, Any],
+        *,
+        num_tokens: int,
+        num_reqs: int,
+        dummy: bool = False,
+    ) -> None:
+        if (
+            num_tokens != self.num_tokens
+            or num_reqs != 1
+            or tuple(metadata) != self._names
+        ):
+            raise ValueError("FULL verify descriptor must be real B1 exact M")
+        self._check(
+            metadata, num_tokens=self.num_tokens, dummy=dummy, draft=self.is_draft
+        )
+        if self._object_aliases(metadata) != self._aliases:
+            raise ValueError("FULL verify metadata aliases changed")
+        for _, current in _unique_metadata(metadata):
+            if (
+                not dummy
+                and hasattr(current, "max_seq_len")
+                and not (0 <= current.max_seq_len <= self.max_seq_len)
+            ):
+                raise ValueError("FULL verify sequence length exceeds state capacity")
+        # 全部 layout 先检查，再进行任何设备 copy；不检查/猜测 GPU accepted 值。
+        source_aliases: dict[int, tuple] = {}
+        for name, field, target in self._bindings:
+            source: Any = getattr(metadata[name], field, None)
+            if not (
+                type(source) is torch.Tensor
+                and source.device == target.device
+                and source.dtype == target.dtype
+                and source.shape == target.shape
+                and source.stride() == target.stride()
+            ):
+                raise ValueError(f"FULL verify layout changed: {name}.{field}")
+            key = self._tensor_key(source)
+            if source_aliases.setdefault(id(target), key) != key:
+                raise ValueError("FULL verify shared tensor aliases changed")
+        for name, source in _unique_metadata(metadata):
+            target = self.metadata[name]
+            for field, value in vars(source).items():
+                if not isinstance(value, torch.Tensor) or value.device.type != "xpu":
+                    setattr(
+                        target, field, value
+                    )  # 当前真实 CPU lease/table，不冻结旧 owner。
+            self._clear_cpu_trust(target)
+            if hasattr(target, "max_seq_len"):
+                target.max_seq_len = self.max_seq_len
+        sources = [getattr(metadata[name], field) for name, field, _ in self._fields]
+        targets = [target for _, _, target in self._fields]
+        if not _try_copy_metadata(sources, targets):
+            for source, target in zip(sources, targets):
+                target.copy_(source)
+        if dummy:
+            for m in {id(m): m for m in self.metadata.values()}.values():
+                for field in ("slot_mapping",):
+                    value = getattr(m, field, None)
+                    if isinstance(value, torch.Tensor) and value.device.type == "xpu":
+                        value.fill_(-1)
+                for field in ("block_table", "spec_state_indices_tensor"):
+                    value = getattr(m, field, None)
+                    if isinstance(value, torch.Tensor) and value.device.type == "xpu":
+                        value.zero_()
+                if isinstance(m, QSAForwardMetadata):
+                    m.token_to_req.zero_()
+                    m.logical_positions.zero_()
+                    m.query_start_loc_cpu = (0, self.num_tokens)
+                if isinstance(m, (GDNAttentionMetadata, PleShortConvAttentionMetadata)):
+                    accepted: Any = m.num_accepted_tokens
+                    indices: Any = m.spec_token_indx
+                    accepted.fill_(1)
+                    indices.copy_(
+                        torch.arange(
+                            self.num_tokens,
+                            dtype=indices.dtype,
+                            device=indices.device,
+                        )
+                    )
+                for field in ("query_start_loc", "spec_query_start_loc"):
+                    value = getattr(m, field, None)
+                    if isinstance(value, torch.Tensor) and value.device.type == "xpu":
+                        value.copy_(
+                            torch.tensor(
+                                [0, self.num_tokens],
+                                dtype=value.dtype,
+                                device=value.device,
+                            )
+                        )
+
+    def owns(self, metadata: Any) -> bool:
+        """仅证明 buffer 属于本 state；不证明历史有效或 prepare 已执行。"""
+        return id(metadata) in self._metadata_ids
+
+
+class Qwen38FullFirstDraftState(Qwen38FullVerifyState):
+    """B1 first-pass draft: exact K+1 QSA rows, separate from serial M1."""
+
+    def __init__(self, config: Any, metadata: dict[str, Any], **kwargs: Any) -> None:
+        if not (
+            getattr(config.compilation_config, "_qwen38_full_draft_graph", False)
+            and getattr(
+                config.compilation_config, "_qwen38_full_first_draft_graph", False
+            )
+            and 1 <= config.speculative_config.num_speculative_tokens <= 7
+        ):
+            raise ValueError("First draft FULL requires the private B1/K1..7 role")
+        # The parent owns buffers for K+1 rows. Do not mutate the target/draft
+        # configuration shared by layer registration or the graph wrapper.
+        fixed = copy(config)
+        fixed.compilation_config = copy(config.compilation_config)
+        fixed.compilation_config._qwen38_full_draft_graph = False
+        super().__init__(fixed, metadata, **kwargs)
+        self.is_draft = True
+
+    @classmethod
+    def _check(cls, metadata, *, num_tokens, dummy=False, draft=False):
+        if not 2 <= num_tokens <= 8 or any(
+            isinstance(value, (GDNAttentionMetadata, PleShortConvAttentionMetadata))
+            for value in metadata.values()
+        ):
+            raise ValueError("First draft FULL requires K+1 QSA-only rows (2..8)")
+        super()._check(metadata, num_tokens=num_tokens, dummy=dummy, draft=False)
