new file mode 100644
index 0000000000..3771a71be2
--- /dev/null
+++ b/vllm/v1/worker/qwen38_ngram_context.py
@@ -0,0 +1,505 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Device-resident Qwen3.8 N-gram context repair for async spec decode.
+
+Async scheduling advances ``InputBatch`` on CPU optimistically.  The target
+runner corrects ``num_computed_tokens`` on the device after rejection, so a
+context gathered from the CPU token table can include rejected draft tokens.
+
+``Qwen38AsyncNgramContext`` keeps the previous target input and the context
+that preceded it in ping-pong device buffers.  On the next target forward,
+the corrected frontier delta identifies exactly how much of that input became
+part of the real prefix.  One Triton launch both constructs the repaired
+context and snapshots the current target input for the following iteration.
+
+The owner is deliberately runner-local.  Calls may move between streams: a
+device event serializes the ping-pong state without a device-to-host wait.
+Rows that are new, resumed, or otherwise discontinuous must explicitly pass
+``reuse_previous=False`` and provide their known-correct CPU-derived tail in
+``fallback_context``.
+"""
+
+from __future__ import annotations
+
+import threading
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def _advance_and_snapshot_kernel(
+    previous_context_ptr,
+    previous_input_ids_ptr,
+    previous_query_start_loc_ptr,
+    previous_num_computed_ptr,
+    previous_valid_ptr,
+    current_input_ids_ptr,
+    current_is_token_ids_ptr,
+    current_query_start_loc_ptr,
+    current_num_computed_ptr,
+    previous_positions_ptr,
+    reuse_previous_ptr,
+    fallback_context_ptr,
+    output_context_ptr,
+    current_context_snapshot_ptr,
+    current_input_snapshot_ptr,
+    current_query_start_snapshot_ptr,
+    current_num_computed_snapshot_ptr,
+    current_valid_snapshot_ptr,
+    num_reqs,
+    num_reqs_padded,
+    num_input_tokens,
+    previous_num_reqs,
+    previous_num_input_tokens,
+    eos_token_id,
+    CONTEXT_LEN: tl.constexpr,
+    HAS_TOKEN_MASK: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+):
+    offsets = tl.program_id(0) * BLOCK_SIZE + tl.arange(0, BLOCK_SIZE)
+
+    # Build the current prefix tail.  If ``delta`` previous target-input rows
+    # became real, the wanted window starts at ``delta`` in
+    # [previous_context, previous_input[:delta]].
+    context_items = num_reqs_padded * CONTEXT_LEN
+    context_live = offsets < context_items
+    row = offsets // CONTEXT_LEN
+    column = offsets - row * CONTEXT_LEN
+    real_row = context_live & (row < num_reqs)
+    safe_row = tl.maximum(tl.minimum(row, num_reqs - 1), 0)
+
+    previous_row = tl.load(
+        previous_positions_ptr + safe_row, mask=real_row, other=-1
+    ).to(tl.int64)
+    reuse = tl.load(reuse_previous_ptr + safe_row, mask=real_row, other=0).to(tl.int1)
+    mapped = (previous_row >= 0) & (previous_row < previous_num_reqs)
+    safe_previous_row = tl.maximum(tl.minimum(previous_row, previous_num_reqs - 1), 0)
+    previous_valid = tl.load(
+        previous_valid_ptr + safe_previous_row,
+        mask=real_row & mapped,
+        other=0,
+    ).to(tl.int1)
+    previous_start = tl.load(
+        previous_query_start_loc_ptr + safe_previous_row,
+        mask=real_row & mapped,
+        other=0,
+    ).to(tl.int64)
+    previous_end = tl.load(
+        previous_query_start_loc_ptr + safe_previous_row + 1,
+        mask=real_row & mapped,
+        other=0,
+    ).to(tl.int64)
+    previous_frontier = tl.load(
+        previous_num_computed_ptr + safe_previous_row,
+        mask=real_row & mapped,
+        other=0,
+    ).to(tl.int64)
+    current_frontier = tl.load(
+        current_num_computed_ptr + safe_row,
+        mask=real_row,
+        other=0,
+    ).to(tl.int64)
+    delta = current_frontier - previous_frontier
+    previous_query_len = previous_end - previous_start
+    layout_valid = (
+        (previous_start >= 0)
+        & (previous_end >= previous_start)
+        & (previous_end <= previous_num_input_tokens)
+    )
+    chain_valid = (
+        real_row
+        & reuse
+        & mapped
+        & previous_valid
+        & layout_valid
+        & (delta >= 0)
+        & (delta <= previous_query_len)
+    )
+
+    source = delta + column
+    from_previous_context = source < CONTEXT_LEN
+    safe_context_source = tl.maximum(tl.minimum(source, CONTEXT_LEN - 1), 0)
+    previous_context_value = tl.load(
+        previous_context_ptr + safe_previous_row * CONTEXT_LEN + safe_context_source,
+        mask=chain_valid & from_previous_context,
+        other=0,
+    )
+    previous_input_index = previous_start + source - CONTEXT_LEN
+    safe_previous_input_index = tl.maximum(
+        tl.minimum(previous_input_index, previous_num_input_tokens - 1), 0
+    )
+    previous_input_value = tl.load(
+        previous_input_ids_ptr + safe_previous_input_index,
+        mask=chain_valid & ~from_previous_context,
+        other=0,
+    )
+    chained_value = tl.where(
+        from_previous_context, previous_context_value, previous_input_value
+    )
+    fallback_value = tl.load(
+        fallback_context_ptr + offsets, mask=context_live, other=eos_token_id
+    )
+    context_value = tl.where(chain_valid, chained_value, fallback_value)
+    tl.store(output_context_ptr + offsets, context_value, mask=context_live)
+    tl.store(current_context_snapshot_ptr + offsets, context_value, mask=context_live)
+
+    # Exactly one lane records whether each actual row has a reusable snapshot.
+    # A requested-but-invalid chain is not silently trusted by a later step.
+    current_valid = (~reuse) | chain_valid
+    tl.store(
+        current_valid_snapshot_ptr + row,
+        current_valid,
+        mask=real_row & (column == 0),
+    )
+
+    # Snapshot the current packed target input. Prompt-embedding rows are EOS
+    # separators, matching the existing CPU context construction contract.
+    input_live = offsets < num_input_tokens
+    current_token = tl.load(
+        current_input_ids_ptr + offsets, mask=input_live, other=eos_token_id
+    )
+    if HAS_TOKEN_MASK:
+        is_token = tl.load(
+            current_is_token_ids_ptr + offsets, mask=input_live, other=0
+        ).to(tl.int1)
+        current_token = tl.where(is_token, current_token, eos_token_id)
+    tl.store(current_input_snapshot_ptr + offsets, current_token, mask=input_live)
+
+    query_live = offsets < num_reqs + 1
+    query_start = tl.load(
+        current_query_start_loc_ptr + offsets, mask=query_live, other=0
+    )
+    tl.store(
+        current_query_start_snapshot_ptr + offsets,
+        query_start,
+        mask=query_live,
+    )
+
+    request_live = offsets < num_reqs
+    num_computed = tl.load(
+        current_num_computed_ptr + offsets, mask=request_live, other=0
+    )
+    tl.store(
+        current_num_computed_snapshot_ptr + offsets,
+        num_computed,
+        mask=request_live,
+    )
+
+
+def _same_tensor_view(left: torch.Tensor, right: torch.Tensor) -> bool:
+    return (
+        left.device == right.device
+        and left.dtype == right.dtype
+        and left.shape == right.shape
+        and left.stride() == right.stride()
+        and left.storage_offset() == right.storage_offset()
+        and left.data_ptr() == right.data_ptr()
+    )
+
+
+class Qwen38AsyncNgramContext:
+    """Own device snapshots needed to repair Qwen3.8 async N-gram context.
+
+    Integration order for each *real target* forward:
+
+    1. Prepare ``input_ids`` and correct ``num_computed_tokens`` on device.
+    2. Build/copy the existing CPU context tail into ``fallback_context``.
+    3. Call :meth:`prepare` once, before the target model consumes the context.
+
+    ``previous_positions`` maps current rows to the immediately preceding
+    target batch. ``reuse_previous`` must be false for new/resumed/preempted
+    rows even if a request ID happens to map to an old row. Dummy graph-capture
+    forwards must not advance this owner.
+    """
+
+    def __init__(
+        self,
+        *,
+        max_num_reqs: int,
+        max_num_tokens: int,
+        context_len: int,
+        eos_token_id: int,
+        device: torch.device | str,
+    ) -> None:
+        if max_num_reqs <= 0:
+            raise ValueError("max_num_reqs must be positive")
+        if max_num_tokens <= 0:
+            raise ValueError("max_num_tokens must be positive")
+        if context_len <= 0:
+            raise ValueError("context_len must be positive")
+        requested_device = torch.device(device)
+        if requested_device.type not in ("xpu", "cuda"):
+            raise ValueError("Qwen38 async N-gram context requires an XPU/CUDA device")
+        backend = torch.xpu if requested_device.type == "xpu" else torch.cuda
+        if requested_device.index is None:
+            requested_device = torch.device(
+                requested_device.type, backend.current_device()
+            )
+        self.device = requested_device
+        self.max_num_reqs = int(max_num_reqs)
+        self.max_num_tokens = int(max_num_tokens)
+        self.context_len = int(context_len)
+        self.eos_token_id = int(eos_token_id)
+
+        self._contexts = torch.empty(
+            (2, self.max_num_reqs, self.context_len),
+            dtype=torch.int32,
+            device=self.device,
+        )
+        self._input_ids = torch.empty(
+            (2, self.max_num_tokens), dtype=torch.int32, device=self.device
+        )
+        self._query_start_loc = torch.empty(
+            (2, self.max_num_reqs + 1),
+            dtype=torch.int32,
+            device=self.device,
+        )
+        self._num_computed_tokens = torch.empty(
+            (2, self.max_num_reqs), dtype=torch.int32, device=self.device
+        )
+        self._valid = torch.zeros(
+            (2, self.max_num_reqs), dtype=torch.bool, device=self.device
+        )
+
+        # Materialize the ten per-slot views once. Indexing a device tensor on
+        # every decode step creates Python tensor views even though the backing
+        # addresses never change.
+        self._context_slots = self._contexts.unbind(0)
+        self._input_id_slots = self._input_ids.unbind(0)
+        self._query_start_slots = self._query_start_loc.unbind(0)
+        self._num_computed_slots = self._num_computed_tokens.unbind(0)
+        self._valid_slots = self._valid.unbind(0)
+
+        self._backend = backend
+        self._events = (backend.Event(), backend.Event())
+        self._last_slot: int | None = None
+        self._last_stream = None
+        self._previous_reusable = False
+        self._previous_num_reqs = 0
+        self._previous_num_input_tokens = 0
+        self._generation = 0
+        self._lock = threading.Lock()
+
+    @property
+    def generation(self) -> int:
+        return self._generation
+
+    @property
+    def last_validity(self) -> torch.Tensor | None:
+        """Borrow the last per-row device validity flags for diagnostics."""
+        if self._last_slot is None:
+            return None
+        return self._valid_slots[self._last_slot][: self._previous_num_reqs]
+
+    def reset(self) -> None:
+        """Invalidate logical history without synchronizing outstanding work."""
+        with self._lock:
+            self._previous_reusable = False
+            self._previous_num_reqs = 0
+            self._previous_num_input_tokens = 0
+
+    def _check_tensor(
+        self,
+        tensor: torch.Tensor,
+        *,
+        name: str,
+        dtype: torch.dtype,
+        ndim: int,
+    ) -> None:
+        if type(tensor) is not torch.Tensor:
+            raise TypeError(f"{name} must be a plain torch.Tensor")
+        if tensor.device != self.device:
+            raise ValueError(f"{name} must be on {self.device}")
+        if tensor.dtype != dtype:
+            raise TypeError(f"{name} must have dtype {dtype}")
+        if tensor.ndim != ndim:
+            raise ValueError(f"{name} must have rank {ndim}")
+        if not tensor.is_contiguous():
+            raise ValueError(f"{name} must be contiguous")
+
+    @torch.inference_mode()
+    def prepare(
+        self,
+        *,
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        num_computed_tokens: torch.Tensor,
+        previous_positions: torch.Tensor,
+        reuse_previous: torch.Tensor,
+        fallback_context: torch.Tensor,
+        num_reqs: int,
+        num_reqs_padded: int,
+        num_input_tokens: int,
+        is_token_ids: torch.Tensor | None = None,
+        output: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Repair context and atomically snapshot this target input.
+
+        No tensor value is read on the host.  ``fallback_context`` must already
+        contain a correct tail for every row with ``reuse_previous=False`` and
+        EOS padding for rows in ``[num_reqs, num_reqs_padded)``.  It may be the
+        same exact tensor view as ``output``.
+
+        A requested chain that fails device-side metadata validation falls back
+        for memory safety and is marked invalid for the following call.  That is
+        containment for a broken integration invariant, not a correctness
+        recovery for a continuing async row: valid rejection handling must take
+        the chained path.
+        """
+        num_reqs = int(num_reqs)
+        num_reqs_padded = int(num_reqs_padded)
+        num_input_tokens = int(num_input_tokens)
+        if not 0 < num_reqs <= num_reqs_padded <= self.max_num_reqs:
+            raise ValueError("expected 0 < num_reqs <= num_reqs_padded <= max_num_reqs")
+        if not 0 <= num_input_tokens <= self.max_num_tokens:
+            raise ValueError("num_input_tokens is outside the snapshot capacity")
+
+        self._check_tensor(input_ids, name="input_ids", dtype=torch.int32, ndim=1)
+        self._check_tensor(
+            query_start_loc,
+            name="query_start_loc",
+            dtype=torch.int32,
+            ndim=1,
+        )
+        self._check_tensor(
+            num_computed_tokens,
+            name="num_computed_tokens",
+            dtype=torch.int32,
+            ndim=1,
+        )
+        self._check_tensor(
+            previous_positions,
+            name="previous_positions",
+            dtype=torch.int64,
+            ndim=1,
+        )
+        self._check_tensor(
+            reuse_previous,
+            name="reuse_previous",
+            dtype=torch.bool,
+            ndim=1,
+        )
+        self._check_tensor(
+            fallback_context,
+            name="fallback_context",
+            dtype=torch.int32,
+            ndim=2,
+        )
+        if is_token_ids is not None:
+            self._check_tensor(
+                is_token_ids,
+                name="is_token_ids",
+                dtype=torch.bool,
+                ndim=1,
+            )
+        if output is None:
+            output = fallback_context
+        else:
+            self._check_tensor(output, name="output", dtype=torch.int32, ndim=2)
+
+        if input_ids.numel() < num_input_tokens:
+            raise ValueError("input_ids is shorter than num_input_tokens")
+        if is_token_ids is not None and is_token_ids.numel() < num_input_tokens:
+            raise ValueError("is_token_ids is shorter than num_input_tokens")
+        if query_start_loc.numel() < num_reqs + 1:
+            raise ValueError("query_start_loc is shorter than num_reqs + 1")
+        if num_computed_tokens.numel() < num_reqs:
+            raise ValueError("num_computed_tokens is shorter than num_reqs")
+        if previous_positions.numel() < num_reqs:
+            raise ValueError("previous_positions is shorter than num_reqs")
+        if reuse_previous.numel() < num_reqs:
+            raise ValueError("reuse_previous is shorter than num_reqs")
+        expected_context_shape = (num_reqs_padded, self.context_len)
+        if tuple(fallback_context.shape) != expected_context_shape:
+            raise ValueError(
+                f"fallback_context must have shape {expected_context_shape}"
+            )
+        if tuple(output.shape) != expected_context_shape:
+            raise ValueError(f"output must have shape {expected_context_shape}")
+        if torch._C._is_alias_of(output, fallback_context) and not _same_tensor_view(
+            output, fallback_context
+        ):
+            raise ValueError(
+                "output may only alias the exact fallback_context tensor view"
+            )
+        protected: tuple[torch.Tensor, ...] = (
+            input_ids,
+            query_start_loc,
+            num_computed_tokens,
+            previous_positions,
+            reuse_previous,
+        )
+        if is_token_ids is not None:
+            protected += (is_token_ids,)
+        if any(torch._C._is_alias_of(output, tensor) for tensor in protected):
+            raise ValueError("output must not alias input or metadata tensors")
+
+        with self._lock:
+            stream = self._backend.current_stream(self.device)
+            if self._last_slot is not None:
+                if stream != self._last_stream:
+                    # This wait is enqueued on-device. It protects cross-stream
+                    # producer/read ordering and safe reuse of a ping-pong slot.
+                    # Same-stream ordering already provides that guarantee.
+                    stream.wait_event(self._events[self._last_slot])
+                current_slot = 1 - self._last_slot
+            else:
+                current_slot = 0
+
+            previous_available = self._previous_reusable and self._last_slot is not None
+            previous_slot = self._last_slot if previous_available else current_slot
+            previous_num_reqs = self._previous_num_reqs if previous_available else 0
+            previous_num_input_tokens = (
+                self._previous_num_input_tokens if previous_available else 0
+            )
+
+            work_items = max(
+                num_reqs_padded * self.context_len,
+                num_input_tokens,
+                num_reqs + 1,
+            )
+            block_size = 256
+            grid = (triton.cdiv(work_items, block_size),)
+            token_mask = is_token_ids if is_token_ids is not None else input_ids
+            _advance_and_snapshot_kernel[grid](
+                self._context_slots[previous_slot],
+                self._input_id_slots[previous_slot],
+                self._query_start_slots[previous_slot],
+                self._num_computed_slots[previous_slot],
+                self._valid_slots[previous_slot],
+                input_ids,
+                token_mask,
+                query_start_loc,
+                num_computed_tokens,
+                previous_positions,
+                reuse_previous,
+                fallback_context,
+                output,
+                self._context_slots[current_slot],
+                self._input_id_slots[current_slot],
+                self._query_start_slots[current_slot],
+                self._num_computed_slots[current_slot],
+                self._valid_slots[current_slot],
+                num_reqs,
+                num_reqs_padded,
+                num_input_tokens,
+                previous_num_reqs,
+                previous_num_input_tokens,
+                self.eos_token_id,
+                CONTEXT_LEN=self.context_len,
+                HAS_TOKEN_MASK=is_token_ids is not None,
+                BLOCK_SIZE=block_size,
+            )
+            self._events[current_slot].record(stream)
+            self._last_slot = current_slot
+            self._last_stream = stream
+            self._previous_reusable = True
+            self._previous_num_reqs = num_reqs
+            self._previous_num_input_tokens = num_input_tokens
+            self._generation += 1
+        return output
+
+
+__all__ = ["Qwen38AsyncNgramContext"]
