+                    sources.shared_gate_up_proj,
+                    "weight_scale_inv",
+                ),
+                (
+                    sources.shared_down_proj.weight,
+                    sources.shared_down_proj,
+                    "weight_scale_inv",
+                ),
+            ):
+                scale = getattr(module, name, None)
+                shape = (
+                    *weight.shape[:-2],
+                    (weight.shape[-2] + 127) // 128,
+                    (weight.shape[-1] + 127) // 128,
+                )
