+            (experts.w13_weight, (self.n_routed_experts, 2 * intermediate, hidden_dim)),
+            (experts.w2_weight, (self.n_routed_experts, hidden_dim, intermediate)),
+            (sources.shared_gate_up_proj.weight, (2 * intermediate, hidden_dim)),
+            (sources.shared_down_proj.weight, (hidden_dim, intermediate)),
+        )
