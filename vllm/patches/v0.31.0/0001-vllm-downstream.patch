+    def _staged_ple_fallback_reason(
+        self,
+        key: torch.Tensor,
+        query: torch.Tensor,
+        value: torch.Tensor,
+    ) -> int | None:
+        if (
+            not envs.VLLM_XPU_ENABLE_QWEN38_PLE_NATIVE
+            or envs.VLLM_XPU_DISABLE_QWEN38_PLE_STAGED
+        ):
+            return REASON_DISABLED
+        if torch.compiler.is_compiling() or BreakableCUDAGraphCapture.is_active():
+            return REASON_COMPILE_GRAPH
+        if (
+            key.ndim != 3
+            or query.shape != key.shape
+            or value.ndim != 2
+            or value.shape != (key.shape[0], self.hidden_size)
+            or key.shape[1:] != (self.hc_count, self.hidden_size)
+        ):
+            return REASON_SHAPE
+        if (
+            key.dtype != torch.float16
+            or query.dtype != torch.float16
+            or value.dtype != torch.float16
+        ):
+            return REASON_DTYPE
+        if (
+            key.device.type != "xpu"
+            or query.device != key.device
+            or value.device != key.device
+        ):
+            return REASON_DEVICE
+        if (
+            not key.is_contiguous()
+            or not query.is_contiguous()
+            or not value.is_contiguous()
+        ):
+            return REASON_LAYOUT
+        if (
+            self.hc_hidden_size != self.hc_count * self.hidden_size
+            or self.hidden_size <= 0
+            or self.hc_count <= 0
+        ):
+            return REASON_OTHER_CONTRACT
+
+        norms = (self.norm_key, self.norm_query, self.norm_conv)
+        if any(
+            type(norm.group_size) is not int or norm.group_size != self.hidden_size
+            for norm in norms
+        ):
+            return REASON_SHAPE
+        norm_weights = tuple(norm.weight for norm in norms)
+        if any(
+            not isinstance(weight, torch.Tensor)
+            or weight.shape != (self.hc_hidden_size,)
+            for weight in norm_weights
+        ):
+            return REASON_SHAPE
+        if any(weight.dtype != torch.float16 for weight in norm_weights):
+            return REASON_DTYPE
+        if any(weight.device != key.device for weight in norm_weights):
+            return REASON_DEVICE
+        if any(not weight.is_contiguous() for weight in norm_weights):
+            return REASON_LAYOUT
+        return None
+
+    @staticmethod
+    def _gated_value_grouped_norm_fusion_requested() -> bool:
+        return (
+            envs.VLLM_XPU_ENABLE_QWEN38_PLE_GATED_VALUE_NORM_FUSION
+            and not envs.VLLM_XPU_DISABLE_QWEN38_PLE_GATED_VALUE_NORM_FUSION
+        )
+
+    def _gated_value_grouped_norm_fallback_reason(
+        self,
+        gate: torch.Tensor,
+        value: torch.Tensor,
+        weight: torch.Tensor,
+        raw_output: torch.Tensor,
+        normalized_output: torch.Tensor,
+        eps: float,
+    ) -> int | None:
+        if (
+            gate.shape != (1, 4)
+            or value.shape != (1, 2560)
+            or weight.shape != (10240,)
+            or raw_output.shape != (1, 10240)
+            or normalized_output.shape != raw_output.shape
+        ):
+            return REASON_SHAPE
+        tensors = (gate, value, weight, raw_output, normalized_output)
+        if any(tensor.dtype != torch.float16 for tensor in tensors):
+            return REASON_DTYPE
+        if gate.device.type != "xpu" or any(
+            tensor.device != gate.device for tensor in tensors[1:]
+        ):
+            return REASON_DEVICE
+        if any(not tensor.is_contiguous() for tensor in tensors):
+            return REASON_LAYOUT
+        # Torch allocator bases are more strictly aligned than the ABI. An odd
+        # FP16 storage offset is therefore sufficient to reject misaligned views
+        # without reading device data or synchronizing the host.
+        if any(
+            tensor.storage_offset() * tensor.element_size() % 4 for tensor in tensors
+        ):
+            return REASON_LAYOUT
+        outputs = (raw_output, normalized_output)
+        read_tensors = (gate, value, weight)
+        if self._tensors_alias(raw_output, normalized_output) or any(
+            self._tensors_alias(output, input_tensor)
+            for output in outputs
+            for input_tensor in read_tensors
+        ):
+            return REASON_OTHER_CONTRACT
+        try:
+            eps_value = float(eps)
+        except (TypeError, ValueError, OverflowError):
+            return REASON_OTHER_CONTRACT
+        if (
+            not math.isfinite(eps_value)
+            or eps_value <= 2.0**-150
+            or eps_value > 3.4028234663852886e38
+        ):
+            return REASON_OTHER_CONTRACT
+        return None
+
+    @staticmethod
+    def _run_staged_ple_primitive(path: int, work_units: int, operation, *args) -> None:
+        try:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(path, EVENT_ATTEMPT, work_units)
+                NATIVE_STATS.record(path, EVENT_ELIGIBLE, work_units)
+                NATIVE_STATS.record(path, EVENT_NATIVE_SUBMITTED, work_units)
+            operation(*args)
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(path, EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+            raise
+
+    def _staged_ple_forward(
+        self,
+        key: torch.Tensor,
+        query: torch.Tensor,
+        value: torch.Tensor,
+    ) -> torch.Tensor | None:
+        """Run the PLE primitive chain through the canonical production DSO."""
+        if key.numel() == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_PLE_STAGED_CHAIN, EVENT_ZERO_WORK_SKIP, 0)
+            return None
+
+        work_units = int(key.shape[0]) if key.ndim else 1
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_PLE_STAGED_CHAIN, EVENT_ATTEMPT, work_units)
+        try:
+            reason = self._staged_ple_fallback_reason(key, query, value)
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_PLE_STAGED_CHAIN,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if reason is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_PLE_STAGED_CHAIN, EVENT_FALLBACK, work_units, reason
+                )
+            return None
+
+        short_conv_dispatch = None
+        try:
+            self._prepare_production_ple_op("ple_grouped_norm", key.device)
+            if not getattr(self, "_production_ple_available", True):
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_PLE_STAGED_CHAIN,
+                        EVENT_ELIGIBLE,
+                        work_units,
+                    )
+                    NATIVE_STATS.record(
+                        PATH_PLE_STAGED_CHAIN,
+                        EVENT_FALLBACK,
+                        work_units,
+                        REASON_DSO_NOT_CONFIGURED,
+                    )
+                return None
+
+            grouped_norm = self._production_ple_op("ple_grouped_norm")
+            score_gate = self._production_ple_op("ple_score_gate")
+            gated_value_op = self._production_ple_op("ple_gated_value")
+            residual_add = self._production_ple_op("ple_residual_add")
+            operations = (
+                grouped_norm,
+                score_gate,
+                gated_value_op,
+                residual_add,
+            )
+            if any(
+                operation is None or not callable(operation) for operation in operations
+            ):
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_PLE_STAGED_CHAIN,
+                        EVENT_ELIGIBLE,
+                        work_units,
+                    )
+                    NATIVE_STATS.record(
+                        PATH_PLE_STAGED_CHAIN,
+                        EVENT_FALLBACK,
+                        work_units,
+                        REASON_OP_UNAVAILABLE,
+                    )
+                return None
+
+            token_count = key.shape[0]
+            key_flat = key.view(token_count, self.hc_hidden_size)
+            query_flat = query.view(token_count, self.hc_hidden_size)
+            decode_workspaces = (
+                getattr(self, "_ple_decode_key_norm_workspace", None),
+                getattr(self, "_ple_decode_query_norm_workspace", None),
+                getattr(self, "_ple_decode_gated_value_workspace", None),
+                getattr(self, "_ple_decode_normalized_workspace", None),
+                getattr(self, "_ple_decode_output_workspace", None),
+            )
+            decode_gate_workspace = getattr(self, "_ple_decode_gate_workspace", None)
+            all_decode_workspaces = (*decode_workspaces, decode_gate_workspace)
+            reuse_decode_workspace = (
+                token_count == 1
+                and all(
+                    isinstance(workspace, torch.Tensor)
+                    and workspace.shape == (1, self.hc_hidden_size)
+                    and workspace.dtype == key.dtype
+                    and workspace.device == key.device
+                    and workspace.is_contiguous()
+                    for workspace in decode_workspaces
+                )
+                and isinstance(decode_gate_workspace, torch.Tensor)
+                and decode_gate_workspace.shape == (1, self.hc_count)
+                and decode_gate_workspace.dtype == key.dtype
+                and decode_gate_workspace.device == key.device
+                and decode_gate_workspace.is_contiguous()
+                and not any(
+                    self._tensors_alias(first, second)
+                    for index, first in enumerate(all_decode_workspaces)
+                    for second in all_decode_workspaces[index + 1 :]
+                )
+            )
+            if reuse_decode_workspace:
+                (
+                    key_norm,
+                    query_norm,
+                    gated_value_flat,
+                    normalized,
+                    output,
+                ) = decode_workspaces
+                gated_value = gated_value_flat.view(1, self.hc_count, self.hidden_size)
+                gate = decode_gate_workspace
+            else:
+                key_norm = torch.empty_like(key_flat)
+                query_norm = torch.empty_like(query_flat)
+                gate = torch.empty(
+                    (token_count, self.hc_count),
+                    dtype=key.dtype,
+                    device=key.device,
+                )
+                gated_value = torch.empty(
+                    (token_count, self.hc_count, self.hidden_size),
+                    dtype=value.dtype,
+                    device=value.device,
+                )
+                gated_value_flat = gated_value.view(token_count, self.hc_hidden_size)
+                normalized = torch.empty_like(gated_value_flat)
+                output = torch.empty_like(gated_value_flat)
+
+            gated_value_grouped_norm = None
+            if self._gated_value_grouped_norm_fusion_requested():
+                fusion_reason = self._gated_value_grouped_norm_fallback_reason(
+                    gate,
+                    value,
+                    self.norm_conv.weight,
+                    gated_value_flat,
+                    normalized,
+                    self.norm_conv.eps,
+                )
+                if fusion_reason is None:
+                    gated_value_grouped_norm = self._production_ple_op(
+                        "ple_gated_value_grouped_norm"
+                    )
+                    if not callable(gated_value_grouped_norm):
+                        raise RuntimeError(
+                            "enabled PLE gated-value/norm fusion is unavailable"
+                        )
+            short_conv_dispatch = self._prepare_short_conv(
+                normalized,
+                key_norm,
+                mixed_input_workspace=key_norm,
+                mixed_branch_workspace=query_norm,
+                mixed_output=normalized,
+            )
+        except Exception:
+            if short_conv_dispatch is not None:
+                short_conv_dispatch.cancel()
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_PLE_STAGED_CHAIN,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+
+        submitted = False
+        try:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_PLE_STAGED_CHAIN, EVENT_ELIGIBLE, work_units)
+                NATIVE_STATS.record(
+                    PATH_PLE_STAGED_CHAIN,
+                    EVENT_NATIVE_SUBMITTED,
+                    work_units,
+                )
+            submitted = True
+            self._run_staged_ple_primitive(
+                PATH_PLE_GROUPED_NORM,
+                work_units,
+                grouped_norm,
+                key_flat,
+                self.norm_key.weight,
+                key_norm,
+                self.norm_key.eps,
+                self.hidden_size,
+            )
+            self._run_staged_ple_primitive(
+                PATH_PLE_GROUPED_NORM,
+                work_units,
+                grouped_norm,
+                query_flat,
+                self.norm_query.weight,
+                query_norm,
+                self.norm_query.eps,
+                self.hidden_size,
+            )
+            self._run_staged_ple_primitive(
+                PATH_PLE_SCORE_GATE,
+                work_units,
+                score_gate,
+                key_norm,
+                query_norm,
+                gate,
+                self.hidden_size,
+            )
+            if gated_value_grouped_norm is None:
+                self._run_staged_ple_primitive(
+                    PATH_PLE_GATED_VALUE,
+                    work_units,
+                    gated_value_op,
+                    gate,
+                    value,
+                    gated_value,
+                    self.hc_count,
+                )
+                self._run_staged_ple_primitive(
+                    PATH_PLE_GROUPED_NORM,
+                    work_units,
+                    grouped_norm,
+                    gated_value_flat,
+                    self.norm_conv.weight,
+                    normalized,
+                    self.norm_conv.eps,
+                    self.hidden_size,
+                )
+            else:
+                self._run_staged_ple_primitive(
+                    PATH_PLE_GATED_VALUE_GROUPED_NORM,
+                    work_units,
+                    gated_value_grouped_norm,
+                    gate,
+                    value,
+                    self.norm_conv.weight,
+                    gated_value_flat,
+                    normalized,
+                    self.norm_conv.eps,
+                )
+            conv_output = short_conv_dispatch.execute().contiguous()
+            if conv_output.shape != gated_value_flat.shape:
+                raise RuntimeError(
+                    "PLE short-conv returned an unexpected shape for staged path: "
+                    f"got {tuple(conv_output.shape)}, "
+                    f"expected {tuple(gated_value_flat.shape)}"
+                )
+            self._run_staged_ple_primitive(
+                PATH_PLE_RESIDUAL_ADD,
+                work_units,
+                residual_add,
+                gated_value_flat,
+                conv_output,
+                output,
+            )
+        except Exception:
+            short_conv_dispatch.cancel()
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_PLE_STAGED_CHAIN,
+                    (
+                        EVENT_HARD_ERROR_POST_SUBMIT
+                        if submitted
+                        else EVENT_HARD_ERROR_PREFLIGHT
+                    ),
+                    work_units,
+                )
+            raise
+
+        return output
+
+    def _prepare_production_ple_op(self, name: str, device: torch.device) -> None:
+        """Resolve the canonical owner once without caching unexpected errors."""
+        if getattr(self, "_production_ple_probe_done", False):
+            return
+        try:
+            operation = get_qwen38_ple_op(name)
+        except ImportError:
+            self._production_ple_available = False
+        else:
+            self._production_ple_ops = {name: operation}
+            self._production_ple_available = True
+        self._production_ple_probe_done = True
+
+    def _production_ple_op(self, name: str, device: torch.device | None = None):
+        """Return a cached PLE op from the canonical production owner."""
+        if device is not None and device.type != "xpu":
+            return None
+        operations = getattr(self, "_production_ple_ops", None)
+        if operations is None:
+            operations = {}
+            self._production_ple_ops = operations
+        if name not in operations:
+            operations[name] = get_qwen38_ple_op(name)
+        return operations[name]
+
+    @staticmethod
+    def _short_conv_trusted_requested() -> bool:
+        return (
+            envs.VLLM_XPU_ENABLE_QWEN38_PLE_SHORT_CONV_TRUSTED
+            and not envs.VLLM_XPU_DISABLE_QWEN38_PLE_SHORT_CONV_TRUSTED
+        )
+
+    @staticmethod
+    def _short_conv_field_proof_valid(
+        field: object,
+        output: object,
+        source: _PleShortConvSourceCapability,
+    ) -> bool:
+        if (
+            type(field) is not _PleShortConvFieldProof
+            or type(output) is not torch.Tensor
+            or field._seal is not _PLE_SHORT_CONV_PROOF_SEAL
+            or field._field_id != id(field)
+            or field.output is not output
+            or field.output_id != id(output)
+        ):
+            return False
+        try:
+            if field.output_version != output._version:
+                return False
+        except RuntimeError:
+            return False
+        if not (
+            len(field.source_names)
+            == len(field.source_ids)
+            == len(field.source_versions)
+        ):
+            return False
+        for name, source_id, source_version in zip(
+            field.source_names,
+            field.source_ids,
+            field.source_versions,
+        ):
+            source_tensor = getattr(source, name, None)
+            if type(source_tensor) is not torch.Tensor or source_id != id(
+                source_tensor
+            ):
+                return False
+            try:
+                if source_version != source_tensor._version:
+                    return False
+            except RuntimeError:
+                return False
+        return True
+
+    def _short_conv_construction_proof_valid(
+        self,
+        metadata: PleShortConvAttentionMetadata,
+        state_capacity: int,
+    ) -> bool:
+        proof = metadata.construction_proof
+        if (
+            type(proof) is not PleShortConvConstructionProof
+            or proof._seal is not _PLE_SHORT_CONV_PROOF_SEAL
+            or proof._proof_id != id(proof)
+            or type(proof.source) is not _PleShortConvSourceCapability
+        ):
+            return False
+        source = proof.source
+        if (
+            source._seal is not _PLE_SHORT_CONV_PROOF_SEAL
+            or source._source_id != id(source)
+            or type(source.issuer) is not object
+            or proof.issuer is not source.issuer
+            or type(proof.generation) is not int
+            or proof.generation <= 0
+            or proof.generation != source.generation
+            or proof.batch_signature != _batch_signature(metadata)
+            or source.query_start_loc is not metadata.query_start_loc
+            or source.seq_lens is not metadata.seq_lens
+            or not (
+                len(source.source_names)
+                == len(source.source_ids)
+                == len(source.source_versions)
+            )
+        ):
+            return False
+        for name, source_id, source_version in zip(
+            source.source_names,
+            source.source_ids,
+            source.source_versions,
+        ):
+            tensor = getattr(source, name, None)
+            if type(tensor) is not torch.Tensor or source_id != id(tensor):
+                return False
+            try:
+                if source_version != tensor._version:
+                    return False
+            except RuntimeError:
+                return False
+
+        required = (
+            (proof.query_start_loc, metadata.query_start_loc),
+            (proof.state_indices, metadata.state_indices_tensor),
+        )
+        if any(
+            not self._short_conv_field_proof_valid(field, output, source)
+            for field, output in required
+        ):
+            return False
+        state_slots_cpu = proof.state_slots_cpu.output
+        if (
+            not self._short_conv_field_proof_valid(
+                proof.state_slots_cpu,
+                state_slots_cpu,
+                source,
+            )
+            or state_slots_cpu.device.type != "cpu"
+            or state_slots_cpu.ndim != 1
+            or state_slots_cpu.numel() != metadata.num_reqs
+            or state_slots_cpu.dtype not in (torch.int32, torch.int64)
+            or state_capacity <= 0
+            or bool((state_slots_cpu < 0).any().item())
+            or bool((state_slots_cpu == NULL_BLOCK_ID).any().item())
+            or bool((state_slots_cpu >= state_capacity).any().item())
+            or torch.unique(state_slots_cpu).numel() != metadata.num_reqs
+        ):
+            return False
+        if metadata.non_spec_query_start_loc is not None and not (
+            self._short_conv_field_proof_valid(
+                proof.non_spec_query_start_loc,
+                metadata.non_spec_query_start_loc,
+                source,
+            )
+        ):
+            return False
+        if metadata.num_decodes and not self._short_conv_field_proof_valid(
+            proof.has_initial_states_d,
+            metadata.has_initial_states_d,
+            source,
+        ):
+            return False
+        if metadata.num_prefills and (
+            not self._short_conv_field_proof_valid(
+                proof.has_initial_states_p,
+                metadata.has_initial_states_p,
+                source,
+            )
+            or not self._short_conv_field_proof_valid(
+                proof.prefill_query_start_loc,
+                metadata.query_start_loc_p,
+                source,
+            )
+        ):
+            return False
+        if metadata.num_spec_decodes:
+            spec_fields = (
+                (proof.spec_query_start_loc, metadata.spec_query_start_loc),
+                (proof.spec_sequence_masks, metadata.spec_sequence_masks),
+                (proof.spec_state_indices, metadata.spec_state_indices_tensor),
+                (proof.num_accepted_tokens, metadata.num_accepted_tokens),
+                (proof.spec_token_indices, metadata.spec_token_indx),
+                (proof.non_spec_token_indices, metadata.non_spec_token_indx),
+            )
+            if any(
+                not self._short_conv_field_proof_valid(field, output, source)
+                for field, output in spec_fields
+            ):
+                return False
+            cpu_token_facts = (
+                proof.spec_token_indices_cpu,
+                proof.non_spec_token_indices_cpu,
+            )
+            if any(
+                type(field) is not _PleShortConvFieldProof
+                or field.output.device.type != "cpu"
+                or field.output.dtype != torch.int32
+                or not self._short_conv_field_proof_valid(field, field.output, source)
+                for field in cpu_token_facts
+            ):
+                return False
+        return True
+
+    @staticmethod
+    def _native_state_indices(state_indices: torch.Tensor) -> torch.Tensor:
+        """Translate vLLM's reserved slot-0 sentinel to the native ABI."""
+        indices = state_indices.to(dtype=torch.int64)
+        return torch.where(
+            indices == NULL_BLOCK_ID,
+            torch.full_like(indices, -1),
+            indices,
+        )
+
+    @staticmethod
+    def _tensors_alias(first: torch.Tensor, second: torch.Tensor) -> bool:
+        return bool(torch._C._is_alias_of(first, second))
+
+    @staticmethod
+    def _tensor_storage_byte_interval(
+        tensor: torch.Tensor,
+    ) -> tuple[int, int] | None:
+        if tensor.numel() == 0:
+            return None
+        lower = tensor.storage_offset()
+        upper = lower
+        for size, stride in zip(tensor.shape, tensor.stride()):
+            extent = (size - 1) * stride
+            if extent < 0:
+                lower += extent
+            else:
+                upper += extent
+        element_size = tensor.element_size()
+        return lower * element_size, (upper + 1) * element_size
+
+    @classmethod
+    def _tensors_overlap(cls, first: torch.Tensor, second: torch.Tensor) -> bool:
+        if not cls._tensors_alias(first, second):
+            return False
+        first_interval = cls._tensor_storage_byte_interval(first)
+        second_interval = cls._tensor_storage_byte_interval(second)
+        if first_interval is None or second_interval is None:
+            return False
+        return max(first_interval[0], second_interval[0]) < min(
+            first_interval[1], second_interval[1]
+        )
+
+    @staticmethod
+    def _is_positive_non_overlapping(tensor: torch.Tensor) -> bool:
+        required_span = 1
+        for stride, size in sorted(zip(tensor.stride(), tensor.shape)):
+            if stride <= 0:
+                return False
+            if size <= 1:
+                continue
+            if stride < required_span:
+                return False
+            required_span += (size - 1) * stride
+        return True
+
+    def _short_conv_common_fallback_reason(
+        self,
+        inputs: torch.Tensor,
+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        state_indices: torch.Tensor,
+        metadata: torch.Tensor | None,
+        required_capacity: int,
+    ) -> int | None:
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if (
+            inputs.ndim != 2
+            or inputs.shape[1] <= 0
+            or conv_weights.ndim != 2
+            or conv_weights.shape[0] != inputs.shape[1]
+            or conv_weights.shape[1] < 1
+            or conv_state.ndim != 3
+            or conv_state.shape[0] <= 0
+            or conv_state.shape[1] != inputs.shape[1]
+            or state_indices.ndim != 1
+            or (metadata is not None and metadata.ndim != 1)
+        ):
+            return REASON_SHAPE
+        if (
+            inputs.dtype != torch.float16
+            or conv_weights.dtype != torch.float16
+            or conv_state.dtype not in (torch.float16, torch.float32)
+            or state_indices.dtype not in (torch.int32, torch.int64)
+        ):
+            return REASON_DTYPE
+        tensors = [inputs, conv_state, conv_weights, state_indices]
+        if metadata is not None:
+            tensors.append(metadata)
+        if inputs.device.type != "xpu" or any(
+            tensor.device != inputs.device for tensor in tensors[1:]
+        ):
+            return REASON_DEVICE
+        if (
+            not inputs.is_contiguous()
+            or not conv_weights.is_contiguous()
+            or not state_indices.is_contiguous()
+            or (metadata is not None and not metadata.is_contiguous())
+            or not self._is_positive_non_overlapping(conv_state)
+        ):
+            return REASON_LAYOUT
+        if (
+            required_capacity < 0
+            or conv_state.shape[2] < required_capacity
+            or self.short_conv_dilation <= 0
+            or self.conv_state_len
+            != (conv_weights.shape[1] - 1) * self.short_conv_dilation
+        ):
+            return REASON_CAPACITY
+        for index, first in enumerate(tensors):
+            if any(
+                self._tensors_alias(first, second) for second in tensors[index + 1 :]
+            ):
+                return REASON_OTHER_CONTRACT
+        return None
+
+    def _short_conv_output_fallback_reason(
+        self,
+        inputs: torch.Tensor,
+        output: object,
+        *read_tensors: torch.Tensor | None,
+    ) -> int | None:
+        if not isinstance(output, torch.Tensor) or output.shape != inputs.shape:
+            return REASON_SHAPE
+        if output.dtype != inputs.dtype:
+            return REASON_DTYPE
+        if output.device != inputs.device:
+            return REASON_DEVICE
+        if not output.is_contiguous():
+            return REASON_LAYOUT
+        if any(
+            tensor is not None and self._tensors_overlap(output, tensor)
+            for tensor in (inputs, *read_tensors)
+        ):
+            return REASON_OTHER_CONTRACT
+        return None
+
+    def _short_conv_fallback(self, inputs: torch.Tensor) -> torch.Tensor:
+        # Profiling / CUDA graph capture only; conv state is not updated.
+        inputs_t = inputs.transpose(0, 1).unsqueeze(0)
+        output = self.conv1d(inputs_t)[..., : inputs_t.size(-1)]
+        return F.silu(output).squeeze(0).transpose(0, 1)
+
+    @staticmethod
+    def _short_conv_native_disabled() -> bool:
+        return (
+            not envs.VLLM_XPU_ENABLE_QWEN38_PLE_NATIVE
+            or envs.VLLM_XPU_DISABLE_QWEN38_PLE_SHORT_CONV
+        )
+
+    @staticmethod
+    def _record_short_conv_fallback(path: int, work_units: int, reason: int) -> None:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(path, EVENT_FALLBACK, work_units, reason)
+
+    @staticmethod
+    def _record_short_conv_zero_work(
+        path: int, output: torch.Tensor
+    ) -> _PreparedShortConvCall:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(path, EVENT_ZERO_WORK_SKIP, 0)
+        return _PreparedShortConvCall(
+            path,
+            0,
+            output=output,
+            zero_work=True,
+        )
+
+    @staticmethod
+    def _raise_if_transaction_unsafe(reason: int | None) -> None:
+        if reason in (
+            REASON_DEVICE,
+            REASON_SHAPE,
+            REASON_LAYOUT,
+            REASON_METADATA,
+            REASON_CAPACITY,
+            REASON_OTHER_CONTRACT,
+        ):
+            raise ValueError(
+                "PLE short-conv branch failed transaction preflight "
+                f"with reason {reason}"
+            )
+
+    @staticmethod
+    def _validate_cpu_spec_metadata_values(
+        query_start_loc: torch.Tensor,
+        accepted_tokens: torch.Tensor,
+        state_indices: torch.Tensor,
+        work_units: int,
+        spec_query_len: int,
+        state_capacity: int,
+    ) -> None:
+        tensors = (query_start_loc, accepted_tokens, state_indices)
+        if any(
+            tensor.device.type != "cpu" or type(tensor) is not torch.Tensor
+            for tensor in tensors
+        ):
+            return
+
+        starts = query_start_loc.tolist()
+        accepted = accepted_tokens.tolist()
+        states = state_indices.tolist()
+        if starts[0] != 0 or starts[-1] > work_units:
+            raise ValueError(
+                "spec_query_start_loc endpoints are inconsistent with input"
+            )
+        query_lengths = [end - start for start, end in zip(starts, starts[1:])]
+        if any(length < 0 or length > spec_query_len for length in query_lengths):
+            raise ValueError(
+                "spec_query_start_loc must be monotonic with bounded lengths"
+            )
+        if any(index < 0 or index >= state_capacity for index in states):
+            raise ValueError("spec_state_indices_tensor is out of range")
+        if any(value < 0 or value > spec_query_len for value in accepted):
+            raise ValueError("num_accepted_tokens is out of range")
+        if any(
+            state != NULL_BLOCK_ID and (length == 0 or value == 0)
+            for state, length, value in zip(states, query_lengths, accepted)
+        ):
+            raise ValueError(
+                "active speculative requests require tokens and accepted state"
+            )
+
+    def _resolve_short_conv_op(
+        self,
+        path: int,
+        work_units: int,
+        name: str,
+        device: torch.device,
+        *,
+        trusted: bool = False,
+    ) -> object | None:
+        if trusted:
+            operations = getattr(self, "_production_ple_ops", None)
+            if operations is None:
+                operations = {}
+                self._production_ple_ops = operations
+            if name not in operations:
+                operations[name] = get_qwen38_ple_op(name)
+            operation = operations[name]
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(path, EVENT_ELIGIBLE, work_units)
+            if operation is None or not callable(operation):
+                raise RuntimeError(f"trusted PLE short-conv op {name!r} is unavailable")
+            return operation
+
+        self._prepare_production_ple_op(name, device)
+        if not getattr(self, "_production_ple_available", True):
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(path, EVENT_ELIGIBLE, work_units)
+            self._record_short_conv_fallback(
+                path, work_units, REASON_DSO_NOT_CONFIGURED
+            )
+            return None
+
+        operation = self._production_ple_op(name, device)
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(path, EVENT_ELIGIBLE, work_units)
+        if operation is None or not callable(operation):
+            self._record_short_conv_fallback(path, work_units, REASON_OP_UNAVAILABLE)
+            return None
+        return operation
+
+    @staticmethod
+    def _cancel_prepared_short_conv_call(
+        prepared: _PreparedShortConvCall,
+    ) -> None:
+        if prepared.operation is not None and NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                prepared.path,
+                EVENT_HARD_ERROR_PREFLIGHT,
+                prepared.work_units,
+            )
+
+    @staticmethod
+    def _execute_prepared_short_conv_call(
+        prepared: _PreparedShortConvCall,
+    ) -> torch.Tensor:
+        operation = prepared.operation
+        output = prepared.output
+        if operation is None or not callable(operation) or output is None:
+            raise RuntimeError("invalid prepared PLE short-conv native call")
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                prepared.path,
+                EVENT_NATIVE_SUBMITTED,
+                prepared.work_units,
+            )
+        try:
+            operation(*prepared.args)
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    prepared.path,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    prepared.work_units,
+                )
+            raise
+        return output
+
+    def _prepare_short_conv_decode_batched(
+        self,
+        x_d: torch.Tensor,
+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        state_indices_tensor_d: torch.Tensor | None,
+        has_initial_states_d: torch.Tensor | None,
+        work_units: int,
+        native_disabled: bool,
+        trusted: bool = False,
+        forced_fallback_reason: int | None = None,
+        *,
+        transactional: bool,
+        native_output: torch.Tensor | None = None,
+    ) -> _PreparedShortConvCall:
+        path = PATH_PLE_SHORT_CONV_DECODE
+        if work_units == 0:
+            return self._record_short_conv_zero_work(path, torch.empty_like(x_d))
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(path, EVENT_ATTEMPT, work_units)
+        if native_disabled:
+            self._record_short_conv_fallback(path, work_units, REASON_DISABLED)
+
+        try:
+            if not isinstance(state_indices_tensor_d, torch.Tensor):
+                raise ValueError(
+                    "state_indices_tensor_d is required for decode short-conv"
+                )
+            if state_indices_tensor_d.numel() != x_d.shape[0]:
+                raise ValueError(
+                    "state_indices_tensor_d size mismatch: "
+                    f"got {state_indices_tensor_d.numel()}, "
+                    f"need {x_d.shape[0]}."
+                )
+            if has_initial_states_d is not None and not isinstance(
+                has_initial_states_d, torch.Tensor
+            ):
+                raise ValueError("has_initial_states_d must be a tensor when provided")
+            if (
+                has_initial_states_d is not None
+                and has_initial_states_d.numel() < state_indices_tensor_d.numel()
+            ):
+                raise ValueError(
+                    "has_initial_states_d size mismatch: "
+                    f"got {has_initial_states_d.numel()}, "
+                    f"need >= {state_indices_tensor_d.numel()}."
+                )
+            native_state_indices = state_indices_tensor_d
+            native_has_initial = (
+                None
+                if has_initial_states_d is None
+                else has_initial_states_d[: state_indices_tensor_d.numel()]
+            )
+            reason = self._short_conv_common_fallback_reason(
+                x_d,
+                conv_state,
+                conv_weights,
+                native_state_indices,
+                native_has_initial,
+                self.conv_state_len,
+            )
+            if (
+                reason is None
+                and native_has_initial is not None
+                and (
+                    native_has_initial.ndim != 1
+                    or native_has_initial.dtype != torch.bool
+                )
+            ):
+                reason = REASON_SHAPE if native_has_initial.ndim != 1 else REASON_DTYPE
+            if (
+                reason is None
+                and trusted
+                and (
+                    native_state_indices.dtype != torch.int32
+                    or native_has_initial is None
+                )
+            ):
+                reason = REASON_METADATA
+            if (
+                reason is None
+                and forced_fallback_reason is None
+                and trusted
+                and native_output is not None
+            ):
+                reason = self._short_conv_output_fallback_reason(
+                    x_d,
+                    native_output,
+                    conv_state,
+                    conv_weights,
+                    native_state_indices,
+                    native_has_initial,
+                )
+            if transactional:
+                self._raise_if_transaction_unsafe(reason)
+
+            def fallback_args() -> tuple[object, ...]:
+                converted = native_state_indices.to(
+                    device=conv_state.device, dtype=torch.int64
+                )
+                valid_state = converted != NULL_BLOCK_ID
+                state_indices = torch.where(
+                    valid_state,
+                    converted,
+                    torch.zeros_like(converted),
+                )
+                if native_has_initial is None:
+                    has_initial_state = valid_state
+                else:
+                    has_initial_state = native_has_initial.to(
+                        device=conv_state.device, dtype=torch.bool
+                    )
+                    has_initial_state = has_initial_state & valid_state
+                return state_indices, valid_state, has_initial_state
+
+            if native_disabled:
+                return _PreparedShortConvCall(
+                    path,
+                    work_units,
+                    fallback_args=fallback_args(),
+                )
+            if forced_fallback_reason is not None:
+                self._record_short_conv_fallback(
+                    path, work_units, forced_fallback_reason
+                )
+                return _PreparedShortConvCall(
+                    path,
+                    work_units,
+                    fallback_args=fallback_args(),
+                )
+            if reason is not None:
+                self._record_short_conv_fallback(path, work_units, reason)
+                return _PreparedShortConvCall(
+                    path,
+                    work_units,
+                    fallback_args=fallback_args(),
+                )
+
+            operation = self._resolve_short_conv_op(
+                path,
+                work_units,
+                (
+                    "ple_short_conv_decode_trusted"
+                    if trusted
+                    else "ple_short_conv_decode"
+                ),
+                x_d.device,
+                trusted=trusted,
+            )
+            if operation is None:
+                return _PreparedShortConvCall(
+                    path,
+                    work_units,
+                    fallback_args=fallback_args(),
+                )
+            output = (
+                native_output
+                if trusted and native_output is not None
+                else torch.empty_like(x_d)
+            )
+            if trusted:
+                state_indices_native = native_state_indices
+                has_initial_native = native_has_initial
+                null_block_id = NULL_BLOCK_ID
+            else:
+                converted = native_state_indices.to(
+                    device=conv_state.device, dtype=torch.int64
+                )
+                valid_state = converted != NULL_BLOCK_ID
+                has_initial_native = (
+                    valid_state
+                    if native_has_initial is None
+                    else native_has_initial.to(
+                        device=conv_state.device, dtype=torch.bool
+                    )
+                    & valid_state
+                )
+                state_indices_native = self._native_state_indices(converted)
+                null_block_id = -1
+        except Exception:
+            if NATIVE_STATS_ENABLED and not native_disabled:
+                NATIVE_STATS.record(path, EVENT_HARD_ERROR_PREFLIGHT, work_units)
+            raise
+
+        return _PreparedShortConvCall(
+            path,
+            work_units,
+            operation,
+            (
+                x_d,
+                conv_state,
+                conv_weights,
+                state_indices_native,
+                has_initial_native,
+                output,
+                self.short_conv_dilation,
+                True,
+                null_block_id,
+            ),
+            output,
+        )
+
+    def _short_conv_dilated_decode_batched(
+        self,
+        x_d: torch.Tensor,
+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        state_indices_tensor_d: torch.Tensor | None,
+        has_initial_states_d: torch.Tensor | None,
+        native_work_units: int | None = None,
+        _prepared_call: _PreparedShortConvCall | None = None,
+        _native_disabled: bool | None = None,
+    ) -> torch.Tensor:
+        work_units = (
+            int(x_d.shape[0]) if native_work_units is None else int(native_work_units)
+        )
+        prepared = _prepared_call
+        if prepared is None:
+            if work_units == 0:
+                return self._record_short_conv_zero_work(
+                    PATH_PLE_SHORT_CONV_DECODE,
+                    torch.empty_like(x_d),
+                ).output
+            if _native_disabled is None:
+                _native_disabled = self._short_conv_native_disabled()
+            prepared = self._prepare_short_conv_decode_batched(
+                x_d,
+                conv_state,
+                conv_weights,
+                state_indices_tensor_d,
+                has_initial_states_d,
+                work_units,
+                _native_disabled,
+                transactional=False,
+            )
+        if prepared.zero_work:
+            if prepared.output is None:
+                raise RuntimeError("zero-work decode plan has no output")
+            return prepared.output
+        if prepared.operation is not None:
+            return self._execute_prepared_short_conv_call(prepared)
+        if len(prepared.fallback_args) != 3:
+            raise RuntimeError("decode fallback plan is incomplete")
+        state_indices, valid_state, has_initial_state = prepared.fallback_args
+
+        cached_state = conv_state.index_select(0, state_indices)
+        state = cached_state[..., : self.conv_state_len].to(x_d.dtype)
+        if self.conv_state_len > 0:
+            initial_state = torch.where(
+                has_initial_state.view(-1, 1, 1),
+                state,
+                torch.zeros_like(state),
+            )
+            history = torch.cat((initial_state, x_d.unsqueeze(-1)), dim=-1)
+        else:
+            history = x_d.unsqueeze(-1)
+
+        conv_output = F.conv1d(
+            history,
+            conv_weights.unsqueeze(1).contiguous(),
+            groups=history.size(1),
+            dilation=self.short_conv_dilation,
+        ).squeeze(-1)
+        output = F.silu(conv_output)
+        output = output * valid_state.view(-1, 1).to(output.dtype)
+
+        if self.conv_state_len > 0:
+            next_state = history[..., -self.conv_state_len :]
+            # Padded rows are remapped to the reserved null slot. Preserve its
+            # existing value while writing the new states for valid rows.
+            existing_base_state = cached_state[..., : self.conv_state_len]
+            safe_next_state = torch.where(
+                valid_state.view(-1, 1, 1),
+                next_state.to(conv_state.dtype),
+                existing_base_state,
+            )
+            cached_state[..., : self.conv_state_len] = safe_next_state
+            conv_state.index_copy_(0, state_indices, cached_state)
+
+        return output
+
+    def _prepare_short_conv_prefill_batched(
+        self,
+        x_p: torch.Tensor,
+        metadata: PleShortConvAttentionMetadata,
+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        state_indices_tensor_p: torch.Tensor | None,
+        num_prefills: int,
+        num_decode_tokens: int,
+        num_prefill_tokens: int,
+        native_disabled: bool,
+        trusted: bool = False,
+        forced_fallback_reason: int | None = None,
+        *,
+        transactional: bool,
+        native_output: torch.Tensor | None = None,
+    ) -> _PreparedShortConvCall:
+        path = PATH_PLE_SHORT_CONV_PREFILL
+        work_units = int(num_prefill_tokens)
+        if work_units == 0:
+            return self._record_short_conv_zero_work(path, torch.empty_like(x_p))
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(path, EVENT_ATTEMPT, work_units)
+        if native_disabled:
+            self._record_short_conv_fallback(path, work_units, REASON_DISABLED)
+
+        try:
+            non_spec_query_start_loc = metadata.non_spec_query_start_loc
+            if not isinstance(non_spec_query_start_loc, torch.Tensor):
+                raise ValueError("query_start_loc is required for prefill short-conv")
+            has_initial_states_p = metadata.has_initial_states_p
+            if not isinstance(has_initial_states_p, torch.Tensor):
+                raise ValueError(
+                    "has_initial_states_p is required for prefill short-conv"
+                )
+            if not isinstance(state_indices_tensor_p, torch.Tensor):
+                raise ValueError(
+                    "state_indices_tensor_p is required for prefill short-conv"
+                )
+            if num_prefills <= 0 or x_p.shape[0] != num_prefill_tokens:
+                raise ValueError("prefill token metadata does not match input")
+            if (
+                non_spec_query_start_loc.ndim != 1
+                or non_spec_query_start_loc.numel() < num_prefills + 1
+            ):
+                raise ValueError(
+                    "non_spec_query_start_loc does not cover prefill requests"
+                )
+            if non_spec_query_start_loc.dtype not in (
+                torch.int32,
+                torch.int64,
+            ):
+                raise TypeError("non_spec_query_start_loc must use int32 or int64")
+            if state_indices_tensor_p.numel() < num_prefills:
+                raise ValueError(
+                    "state_indices_tensor_p size mismatch: "
+                    f"got {state_indices_tensor_p.numel()}, "
+                    f"need >= {num_prefills}."
+                )
+            if has_initial_states_p.numel() < num_prefills:
+                raise ValueError(
+                    "has_initial_states_p size mismatch: "
+                    f"got {has_initial_states_p.numel()}, "
+                    f"need >= {num_prefills}."
+                )
+            max_len = metadata.max_prefill_query_len
+            if max_len <= 0:
+                raise ValueError(
+                    "max_prefill_query_len must be positive for prefill short-conv"
+                )
