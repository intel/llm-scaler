+++ b/vllm/models/qwen4_exp/xpu/defaults.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""模型级默认值；不修改环境或其它模型的配置。"""
+
+from __future__ import annotations
+
+import os
+from typing import TYPE_CHECKING
+
+import torch
+
+from vllm import envs
+from vllm.config.compilation import CompilationMode, CUDAGraphMode
+from vllm.logger import init_logger
+
+if TYPE_CHECKING:
+    from vllm.config import VllmConfig
+
+logger = init_logger(__name__)
+_MODEL_TYPES = {
+    "qwen3_8_flash_next",
+    "qwen3_8_flash_next_text",
+    "qwen4_exp",
+    "qwen4_exp_text",
+}
+
+
+def _is_tp4_sycl_int4(config: VllmConfig | None) -> bool:
+    if config is None or config.model_config is None:
+        return False
+    model = config.model_config
+    return bool(
+        getattr(model.hf_text_config, "model_type", None)
+        in _MODEL_TYPES | {"qwen3_8_flash_next_mtp", "qwen4_exp_mtp"}
+        and model.quantization == "sym_int4"
+        and model.dtype == torch.float16
+        and config.parallel_config.tensor_parallel_size == 4
+        and envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+    )
+
+
+def apply_full_decode_defaults(config: VllmConfig) -> None:
+    """仅在用户未指定 graph 策略时选择已验证的普通 decode 完整图。"""
+    if not _is_tp4_sycl_int4(config) or (
+        getattr(config.model_config.hf_text_config, "model_type", None)
+        not in _MODEL_TYPES
+    ):
+        return
+    model, parallel = config.model_config, config.parallel_config
+    compilation = config.compilation_config
+    mm = model.multimodal_config
+    if (
+        not envs.VLLM_XPU_QWEN38_FULL_DECODE
+        or model.enforce_eager
+        or model.enable_sleep_mode
+        or config.speculative_config is not None
+        or config.lora_config is not None
+        or config.kv_transfer_config is not None
+        or config.cache_config.mamba_ssm_cache_dtype != "float16"
+        or not config.scheduler_config.async_scheduling
+        or parallel.pipeline_parallel_size != 1
+        or parallel.data_parallel_size != 1
+        or parallel.enable_expert_parallel
+        or parallel.enable_eplb
+        or parallel.use_sequence_parallel_moe
+        or parallel.enable_dbo
+        or parallel.use_ubatching
+        or (mm is not None and not mm.language_model_only)
+        or compilation.cudagraph_mode is not None
+        or compilation.cudagraph_capture_sizes is not None
+        or compilation.max_cudagraph_capture_size is not None
+    ):
+        return
+    # Flash-Next also uses the qwen4_exp aliases. Keep dense Qwen4's prior
+    # B1 default; only the verified TP4 MoE path has ordinary M1..8 coverage.
+    max_capture = 1
+    num_experts = getattr(model.hf_text_config, "num_experts", None)
+    if type(num_experts) is int and num_experts > 0:
+        max_capture = min(8, config.scheduler_config.max_num_seqs)
+    compilation.mode = CompilationMode.NONE
+    compilation.cudagraph_mode = CUDAGraphMode.FULL_DECODE_ONLY
+    compilation.cudagraph_capture_sizes = list(range(1, max_capture + 1))
+    compilation.max_cudagraph_capture_size = max_capture
+    logger.info_once(
+        "Qwen38 XPU: defaulting to non-MTP M1..%d FULL_DECODE_ONLY", max_capture
+    )
+
+
+def use_cpu_ngram_offload(config: VllmConfig | None) -> bool:
+    """TP4 INT4默认使用已验证的CPU shard，保留显式0/1覆盖。"""
+    if "VLLM_PLE_CPU_OFFLOAD" in os.environ:
+        return envs.VLLM_PLE_CPU_OFFLOAD
+    return _is_tp4_sycl_int4(config)
+
+
+def configure_single_host_collectives(config: VllmConfig) -> None:
+    """仅在本模型的单机MP worker内提供通信默认值，保留显式设置。"""
+    if not _is_tp4_sycl_int4(config):
+        return
+    parallel = config.parallel_config
+    if (
+        parallel.distributed_executor_backend != "mp"
+        or parallel.nnodes != 1
+        or parallel.data_parallel_size != 1
+        or parallel.pipeline_parallel_size != 1
+    ):
+        return
+    for name, value in (
+        ("FI_PROVIDER", "tcp"),
+        ("FI_TCP_IFACE", "lo"),
+        ("CCL_ZE_IPC_EXCHANGE", "pidfd"),
+    ):
+        os.environ.setdefault(name, value)
