+                    conv_weights,
+                    spec_state_indices,
+                    metadata.spec_query_start_loc,
+                    metadata.num_accepted_tokens,
+                    metadata.spec_query_len,
+                    metadata.num_spec_decode_tokens,
+                    native_disabled,
+                    trusted=trusted,
+                    forced_fallback_reason=forced_fallback_reason,
+                    transactional=True,
+                    native_output=spec_native_output,
+                )
+                if spec_plan.operation is not None:
+                    prepared_native.append(spec_plan)
+            if has_decode:
+                decode_plan = self._prepare_short_conv_decode_batched(
+                    x_d,
+                    conv_state,
+                    conv_weights,
+                    state_indices_tensor_d,
+                    metadata.has_initial_states_d,
+                    num_decode_tokens,
+                    native_disabled,
+                    trusted=trusted,
+                    forced_fallback_reason=forced_fallback_reason,
+                    transactional=True,
+                    native_output=decode_native_output,
+                )
+                if decode_plan.operation is not None:
+                    prepared_native.append(decode_plan)
+            if has_prefill:
+                prefill_plan = self._prepare_short_conv_prefill_batched(
+                    x_p,
+                    metadata,
+                    conv_state,
+                    conv_weights,
+                    state_indices_tensor_p,
+                    num_prefills,
+                    num_decode_tokens,
+                    num_prefill_tokens,
+                    native_disabled,
+                    trusted=trusted,
+                    forced_fallback_reason=forced_fallback_reason,
+                    transactional=True,
+                    native_output=prefill_native_output,
+                )
+                if prefill_plan.operation is not None:
+                    prepared_native.append(prefill_plan)
+            if has_decode and has_prefill:
+                if reuse_mixed_workspace:
+                    spec_rows = metadata.num_spec_decode_tokens
+                    non_spec_output = mixed_branch_workspace[spec_rows:mixed_work_units]
+                else:
+                    non_spec_output = torch.empty_like(x_non_spec)
+            if has_spec and x_non_spec is not None:
+                if reuse_mixed_workspace:
+                    merged_output = mixed_output
+                else:
+                    merged_output = x.new_empty(
+                        (metadata.num_actual_tokens, x.size(-1))
+                    )
+        except Exception:
+            for prepared in prepared_native:
+                self._cancel_prepared_short_conv_call(prepared)
+            raise
+
+        pending = {id(prepared): prepared for prepared in prepared_native}
+        cancelled = False
+
+        def cancel() -> None:
+            nonlocal cancelled
+            if cancelled:
+                return
+            cancelled = True
+            for prepared in pending.values():
+                self._cancel_prepared_short_conv_call(prepared)
+            pending.clear()
+
+        def consume(prepared: _PreparedShortConvCall | None) -> None:
+            if prepared is not None:
+                pending.pop(id(prepared), None)
+
+        def execute() -> torch.Tensor:
+            try:
+                if mixed_path:
+                    torch.index_select(
+                        x,
+                        0,
+                        spec_gather_indices,
+                        out=x_spec,
+                    )
+                    torch.index_select(
+                        x,
+                        0,
+                        non_spec_gather_indices,
+                        out=x_non_spec,
+                    )
+
+                spec_output = None
+                if has_spec:
+                    consume(spec_plan)
+                    spec_output = self._short_conv_dilated_spec_batched(
+                        x_spec,
+                        conv_state,
+                        conv_weights,
+                        spec_state_indices,
+                        metadata.spec_query_start_loc,
+                        metadata.num_accepted_tokens,
+                        metadata.spec_query_len,
+                        metadata.num_spec_decode_tokens,
+                        spec_plan,
+                    )
+
+                conv_out_non_spec = None
+                if x_non_spec is not None:
+                    if has_prefill:
+                        if has_decode:
+                            consume(decode_plan)
+                            decode_output = self._short_conv_dilated_decode_batched(
+                                x_d,
+                                conv_state,
+                                conv_weights,
+                                state_indices_tensor_d,
+                                metadata.has_initial_states_d,
+                                num_decode_tokens,
+                                decode_plan,
+                            )
+                            if not reuse_mixed_workspace:
+                                non_spec_output[:num_decode_tokens].copy_(decode_output)
+                        consume(prefill_plan)
+                        prefill_output = self._short_conv_dilated_prefill_batched(
+                            x_p,
+                            metadata,
+                            conv_state,
+                            conv_weights,
+                            state_indices_tensor_p,
+                            num_prefills,
+                            num_decode_tokens,
+                            num_prefill_tokens,
+                            prefill_plan,
+                        )
+                        if has_decode:
+                            if not reuse_mixed_workspace:
+                                non_spec_output[num_decode_tokens:].copy_(
+                                    prefill_output
+                                )
+                            conv_out_non_spec = non_spec_output
+                        else:
+                            conv_out_non_spec = prefill_output
+                    else:
+                        consume(decode_plan)
+                        conv_out_non_spec = self._short_conv_dilated_decode_batched(
+                            x_non_spec,
+                            conv_state,
+                            conv_weights,
+                            state_indices_tensor_d,
+                            metadata.has_initial_states_d,
+                            num_decode_tokens,
+                            decode_plan,
+                        )
+
+                if has_spec and conv_out_non_spec is not None:
+                    merged_output.index_copy_(0, spec_gather_indices, spec_output)
+                    merged_output.index_copy_(
+                        0,
+                        non_spec_gather_indices,
+                        conv_out_non_spec,
+                    )
+                    return merged_output
+                if has_spec:
+                    return spec_output
+                if conv_out_non_spec is None:
+                    return x
+                return conv_out_non_spec
+            except Exception:
+                cancel()
+                raise
+
+        return _PreparedShortConvDispatch(execute, cancel)
+
+    def _short_conv_dilated_dispatch(
+        self,
+        inputs: torch.Tensor,
+        metadata: PleShortConvAttentionMetadata,
+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        output: torch.Tensor | None = None,
+        *,
+        mixed_input_workspace: torch.Tensor | None = None,
+        mixed_branch_workspace: torch.Tensor | None = None,
+        mixed_output: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        return self._prepare_short_conv_dilated_dispatch(
+            inputs,
+            metadata,
+            conv_state,
+            conv_weights,
+            output,
+            mixed_input_workspace=mixed_input_workspace,
+            mixed_branch_workspace=mixed_branch_workspace,
+            mixed_output=mixed_output,
+        ).execute()
+
+    def _short_conv_dispatch_args(
+        self, inputs: torch.Tensor
+    ) -> (
+        tuple[
+            PleShortConvAttentionMetadata,
+            torch.Tensor,
+            torch.Tensor,
+        ]
+        | None
+    ):
+        forward_context = get_forward_context()
+        attn_metadata = forward_context.attn_metadata
+        if attn_metadata is None:
+            return None
+        if not isinstance(attn_metadata, dict):
+            raise RuntimeError(
+                "PLE short-conv expects per-layer attention metadata dict "
+                f"during inference, got {type(attn_metadata).__name__}."
+            )
+
+        layer_attn_metadata = attn_metadata.get(self.prefix)
+        if layer_attn_metadata is None:
+            raise RuntimeError(
+                f"Missing short-conv metadata for layer '{self.prefix}'. "
+                "This would bypass conv-state updates and is not allowed."
+            )
+        if not isinstance(layer_attn_metadata, PleShortConvAttentionMetadata):
+            raise TypeError(
+                "Expected PleShortConvAttentionMetadata for layer "
+                f"'{self.prefix}', got "
+                f"{type(layer_attn_metadata).__name__}."
+            )
+
+        conv_state = self.kv_cache[0]
+        if not is_conv_state_dim_first():
+            conv_state = conv_state.transpose(-1, -2)
+        conv_weights = self.conv1d.weight.squeeze(1)
+        state_capacity = self.conv_state_len + self.num_spec_tokens
+        if state_capacity > 0:
+            if conv_state.size(-1) < state_capacity:
+                raise RuntimeError(
+                    "PLE short-conv cache is smaller than expected for "
+                    f"dilated convolution: got {conv_state.size(-1)}, "
+                    f"expect at least {state_capacity}."
+                )
+            conv_state = conv_state[..., -state_capacity:]
+        return (
+            layer_attn_metadata,
+            conv_state,
+            conv_weights.to(dtype=inputs.dtype),
+        )
+
+    def _prepare_short_conv(
+        self,
+        inputs: torch.Tensor,
+        output: torch.Tensor | None = None,
+        *,
+        mixed_input_workspace: torch.Tensor | None = None,
+        mixed_branch_workspace: torch.Tensor | None = None,
+        mixed_output: torch.Tensor | None = None,
+    ) -> _PreparedShortConvDispatch:
+        dispatch_args = self._short_conv_dispatch_args(inputs)
+        if dispatch_args is None:
+            return _PreparedShortConvDispatch(
+                lambda: self._short_conv_fallback(inputs), lambda: None
+            )
+        return self._prepare_short_conv_dilated_dispatch(
+            inputs,
+            *dispatch_args,
+            output,
+            mixed_input_workspace=mixed_input_workspace,
+            mixed_branch_workspace=mixed_branch_workspace,
+            mixed_output=mixed_output,
+        )
+
+    def _short_conv(
+        self,
+        inputs: torch.Tensor,
+        output: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        dispatch_args = self._short_conv_dispatch_args(inputs)
+        if dispatch_args is None:
+            return self._short_conv_fallback(inputs)
+        return self._short_conv_dilated_dispatch(inputs, *dispatch_args, output)
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> torch.Tensor:
+        input_ids = input_ids.reshape(-1)
+        if input_ids.shape[0] != hidden_states.shape[0]:
+            raise ValueError(
+                "PLE expects input_ids and hidden_states to have the same "
+                f"token length, got {input_ids.shape[0]} and "
+                f"{hidden_states.shape[0]}"
+            )
+        embeddings = self.ple_embedding(input_ids, query_start_loc, ngram_context)
+        key, _ = self.key_proj(embeddings)
+        value, _ = self.value_proj(embeddings)
+        token_count = hidden_states.shape[0]
+        key = key.reshape(token_count, self.hc_count, self.hidden_size)
+        query = hidden_states.reshape(token_count, self.hc_count, self.hidden_size)
+        value = value.reshape(token_count, self.hidden_size)
+        staged_output = self._staged_ple_forward(key, query, value)
+        if staged_output is not None:
+            return staged_output
+        key = self._apply_norm(self.norm_key, key)
+        query = self._apply_norm(self.norm_query, query)
+        gate = (key * query).sum(dim=-1, keepdim=True) / math.sqrt(self.hidden_size)
+        gate = torch.sigmoid(gate.sign() * gate.abs().clamp_min(1e-6).sqrt())
+        gated_value = gate * value.unsqueeze(-2)
+        normalized = self._apply_norm(self.norm_conv, gated_value).flatten(-2)
+        conv_output = torch.zeros_like(normalized)
+        torch.ops.vllm.qwen3_8_flash_next_ple_short_conv(
+            normalized,
+            conv_output,
+            self.prefix,
+        )
+        return gated_value.flatten(-2) + conv_output
+
+
+@eager_break_during_capture
+def qwen3_8_flash_next_ple_short_conv(
+    inputs: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: str,
+) -> None:
+    layer = get_forward_context().no_compile_layers[layer_name]
+    result = layer._short_conv(inputs, output)
+    if result is not output:
+        output[: result.shape[0]].copy_(result)
+    if result.shape[0] < output.shape[0]:
+        output[result.shape[0] :].zero_()
+
+
+def qwen3_8_flash_next_ple_short_conv_fake(
+    inputs: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: str,
+) -> None:
+    return
+
+
+direct_register_custom_op(
+    op_name="qwen3_8_flash_next_ple_short_conv",
+    op_func=qwen3_8_flash_next_ple_short_conv,
+    mutates_args=["output"],
+    fake_impl=qwen3_8_flash_next_ple_short_conv_fake,
+)
+
+
+__all__ = [
+    "Qwen3_8FlashNextNGramEmbedding",
+    "Qwen3_8FlashNextPLEGroupedNorm",
+    "Qwen3_8FlashNextPLELayer",
+]
