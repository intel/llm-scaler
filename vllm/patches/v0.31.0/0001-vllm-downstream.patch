+# v2 owns the complete M-row compression contract, including the position
+# sidecar needed by M-RoPE.  The operator is still gated by its explicit
+# environment switch and returns ``None`` for unsupported/stale DSOs.
+_QSA_GROUP_COMPRESSION_NATIVE_INTEGRATION = True
+_QSA_SKIP_INCOMPLETE_GROUP = (
+    os.environ.get("VLLM_XPU_QWEN38_QSA_SKIP_INCOMPLETE_GROUP", "1") == "1"
+)
