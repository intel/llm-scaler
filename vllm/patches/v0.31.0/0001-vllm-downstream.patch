+        self._capture_path: Path | None = None
+        self._capture_run_id: str | None = None
+        self._capture_limit = capture_limit_value
+        if capture_path_text and capture_limit_value > 0:
+            capture_path = Path(capture_path_text)
+            if not capture_path.is_absolute():
+                raise ValueError("Qwen3.8 N-gram capture directory must be absolute")
+            capture_run_id_value = capture_run_id()
+            valid_run_id = 0 < len(capture_run_id_value) <= 128 and all(
+                character.isalnum() or character in "._-"
+                for character in capture_run_id_value
+            )
+            if not valid_run_id:
+                raise ValueError(
+                    "Qwen3.8 N-gram capture run ID must contain only "
+                    "letters, digits, dots, underscores, or hyphens"
+                )
+            capture_path.mkdir(parents=True, exist_ok=True)
+            self._capture_path = capture_path
+            self._capture_run_id = capture_run_id_value
+        self._capture_count = 0
+        self._pending_capture: dict[str, Any] | None = None
+        self._ids_op: EsimdOp | None = None
+        self._ids_eos_op: EsimdOp | None = None
+        self._embedding_op: EsimdOp | None = None
+        self._ids_op_loaded = False
+        self._ids_eos_op_loaded = False
+        self._embedding_op_loaded = False
+        self._metadata_eligible = False
+        self._metadata_pending = False
