+                torch.classes.qwen38_hc_sycl.HCMultiMWorkspaceV1
+            )
+        except RuntimeError:
+            return None
+    # Resolve every optional stage before constructing a workspace. An older
+    # main DSO continues through the established multi-M implementation.
+    try:
+        for name in (
+            "hc_combine_norm_multi_m_strided_v1",
+            "esimd_hc_down_fp16_multi_m_out_v1",
+            "esimd_hc_up_gate_mix_multi_m_v1",
