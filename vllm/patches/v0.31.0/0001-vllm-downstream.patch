+def _try_esimd_qsa_indexer_norm_rope_multi(
+    input_tensor: torch.Tensor,
+    weight: torch.Tensor,
+    positions: torch.Tensor,
+    rotary_emb: nn.Module,
+    *,
+    kind: Literal["q", "k"],
+    output_owner: Any,
+) -> torch.Tensor | None:
+    """M2..8 与可选 SYCL prefill 的设备自检 v2；不伪造 CPU position proof。"""
+    if (
+        os.environ.get("VLLM_XPU_ENABLE_QWEN38_QSA_INDEX_NORM_ROPE_MULTI_NATIVE", "1")
+        != "1"
+        or os.environ.get(
+            "VLLM_XPU_DISABLE_QWEN38_QSA_INDEX_NORM_ROPE_MULTI_NATIVE", "0"
+        )
+        == "1"
+    ):
+        return None
+    from .ops.qsa import _qsa_native_graph_unsafe, get_qsa_indexer_norm_rope_v2_op
+
+    if _qsa_native_graph_unsafe():
+        return None
+    rows = input_tensor.shape[0]
+    heads = 4 if kind == "q" else 1
+    apply_rotary = getattr(rotary_emb, "apply_rotary_emb", None)
+    mrope = positions.ndim == 2
+    sections = tuple(getattr(rotary_emb, "mrope_section", ()) or ())
+    if (
+        input_tensor.shape != (rows, heads, 128)
+        or not (2 <= rows <= 8 or _qsa_prefill_norm_rope_candidate(rows, output_owner))
+        or input_tensor.stride(2) != 1
+        or input_tensor.stride(1) != 128
+        or input_tensor.stride(0) < heads * 128
+        or input_tensor.stride(0) % 8
+        or input_tensor.stride(0) > (2**32 - 1 - heads * 128) // (rows - 1)
+        or getattr(rotary_emb, "rotary_dim", None) != 64
+        or getattr(apply_rotary, "is_neox_style", None) is not True
+        or getattr(apply_rotary, "enable_fp32_compute", None) is not False
+        or sections not in ((), (11, 11, 10))
+        or (mrope and sections != (11, 11, 10))
+        or (mrope and not getattr(rotary_emb, "mrope_interleaved", False))
+        or weight.shape != (128,)
+    ):
+        return None
+    cache = getattr(rotary_emb, "cos_sin_cache", None)
+    if (
+        not isinstance(cache, torch.Tensor)
+        or cache.ndim != 2
+        or cache.shape[1] != 64
+        or not 0 < cache.shape[0] <= (2**32 - 1) // 64
+    ):
+        return None
+    for tensor in (input_tensor, weight, cache):
+        if (
+            tensor.device != input_tensor.device
+            or tensor.dtype != torch.float16
+            or (tensor is not input_tensor and not tensor.is_contiguous())
+            or tensor.is_neg()
+            or tensor.is_conj()
+            or tensor.data_ptr() % 16
+        ):
+            return None
+    if (
+        positions.device != input_tensor.device
+        or positions.dtype not in (torch.int32, torch.int64)
+        or positions.is_neg()
+        or positions.is_conj()
+        or positions.data_ptr() % positions.element_size()
+    ):
+        return None
+    if mrope:
+        if (
+            positions.shape != (3, rows)
+            or positions.stride(1) <= 0
+            or positions.stride(0) <= 0
+            or 2 * positions.stride(0) + (rows - 1) * positions.stride(1) > 2**32 - 1
+        ):
+            return None
+    elif positions.shape != (rows,) or not positions.is_contiguous():
+        return None
+    operation = get_qsa_indexer_norm_rope_v2_op()
+    if operation is None:
+        return None
+
+    output = None
+    buffers: Any = None
+    if rows <= 8:
+        stream = torch.xpu.current_stream(device=input_tensor.device)
+        stream_key = (kind, input_tensor.device, stream, rows)
+        buffers = getattr(output_owner, "_esimd_qsa_indexer_norm_rope_buffers", None)
+        if buffers is None:
+            buffers = {}
+            output_owner._esimd_qsa_indexer_norm_rope_buffers = buffers
+        if not isinstance(buffers, dict):
+            return None
+        output = buffers.get(stream_key)
+
+    def valid_output(tensor: object) -> TypeGuard[torch.Tensor]:
+        if not (
+            isinstance(tensor, torch.Tensor)
+            and tensor.shape == input_tensor.shape
+            and tensor.device == input_tensor.device
+            and tensor.dtype == input_tensor.dtype
+            and tensor.is_contiguous()
+            and not tensor.is_neg()
+            and not tensor.is_conj()
+            and tensor.data_ptr() % 16 == 0
+        ):
+            return False
+        begin = tensor.data_ptr()
+        end = begin + tensor.numel() * tensor.element_size()
+        for source in (input_tensor, weight, positions, cache):
+            # 与 v2 C++ 一致：覆盖正 stride 的整个地址范围，含 padding。
+            elements = 1 + sum(
+                (size - 1) * stride
+                for size, stride in zip(source.shape, source.stride())
+            )
+            left = source.data_ptr()
+            right = left + elements * source.element_size()
+            if begin < right and left < end:
+                return False
+        return True
+
+    # prefill 每次返回独立输出，不按动态行数持久化；小 M 仍验证并复用原缓存。
+    # 借出的输出可能被 set_/resize_ 或经 DLPack 重新包装后作为输入。
+    if not valid_output(output):
+        output = torch.empty(
+            input_tensor.shape, dtype=input_tensor.dtype, device=input_tensor.device
+        )
+        if rows <= 8:
+            buffers[stream_key] = output
+    returned = operation(
+        input_tensor, output, weight, positions, cache, mrope, True, False
+    )
+    if not valid_output(returned) or returned.data_ptr() != output.data_ptr():
+        raise RuntimeError("QSA indexer v2 returned an invalid caller-owned output")
+    return output
+
+
+def try_esimd_qsa_indexer_norm_rope(
+    input_tensor: torch.Tensor,
+    weight: torch.Tensor,
+    positions: torch.Tensor,
+    rotary_emb: nn.Module,
+    *,
+    kind: Literal["q", "k"],
+    output_owner: Any,
+    positions_bounds_proven: bool,
+    variance_epsilon: float,
+) -> torch.Tensor | None:
+    """Run the narrow caller-owned QSA indexer norm+RoPE ABI when eligible."""
+    if not _qsa_indexer_norm_rope_enabled(kind):
+        return None
+    if float(variance_epsilon) != 1e-6:
+        return None
+    if getattr(torch.compiler, "is_compiling", lambda: False)():
+        return None
+    if input_tensor.device.type != "xpu" or input_tensor.dtype != torch.float16:
+        return None
+    if input_tensor.ndim == 3 and (
+        2 <= input_tensor.shape[0] <= 8
+        or _qsa_prefill_norm_rope_candidate(input_tensor.shape[0], output_owner)
+    ):
+        return _try_esimd_qsa_indexer_norm_rope_multi(
+            input_tensor,
+            weight,
+            positions,
+            rotary_emb,
+            kind=kind,
+            output_owner=output_owner,
+        )
+    expected_heads = 4 if kind == "q" else 1
+    if (
+        input_tensor.ndim != 3
+        or input_tensor.shape != (1, expected_heads, 128)
+        or not input_tensor.is_contiguous()
+        or weight.device != input_tensor.device
+        or weight.dtype != torch.float16
+        or weight.shape != (128,)
+        or not weight.is_contiguous()
+    ):
+        return None
+    if positions.device != input_tensor.device or positions.dtype not in (
+        torch.int32,
+        torch.int64,
+    ):
+        return None
+    mrope = positions.ndim == 2
+    if mrope:
+        if (
+            positions.shape != (3, 1)
+            or positions.stride(1) != 1
+            or positions.stride(0) < 1
+            or 2 * positions.stride(0) + positions.shape[1] - 1 > 2**32 - 1
+            or not positions_bounds_proven
+        ):
+            return None
+    elif (
+        positions.ndim != 1
+        or positions.shape != (1,)
+        or not positions.is_contiguous()
+        or not positions_bounds_proven
+    ):
+        return None
+    if (
+        getattr(rotary_emb, "rotary_dim", None) != 64
+        or tuple(getattr(rotary_emb, "mrope_section", ()) or ())
+        not in ((), (11, 11, 10))
+        or (
+            mrope
+            and tuple(getattr(rotary_emb, "mrope_section", ()) or ()) != (11, 11, 10)
+        )
+        or (mrope and not getattr(rotary_emb, "mrope_interleaved", False))
+    ):
+        return None
+    cos_sin_cache = getattr(rotary_emb, "cos_sin_cache", None)
+    if (
+        not isinstance(cos_sin_cache, torch.Tensor)
+        or cos_sin_cache.device != input_tensor.device
+        or cos_sin_cache.dtype != torch.float16
+        or cos_sin_cache.ndim != 2
+        or cos_sin_cache.shape[1] != 64
+        or not cos_sin_cache.is_contiguous()
+    ):
+        return None
+    from .ops.qsa import get_qsa_indexer_norm_rope_op
+
+    operation = get_qsa_indexer_norm_rope_op()
+    if operation is None:
+        raise RuntimeError(
+            "Qwen3.8 QSA indexer norm+RoPE native DSO is unavailable after enable"
+        )
+    stream = torch.xpu.current_stream(device=input_tensor.device)
+    from .full_decode import active_full_decode_state
+
+    full_decode_state = active_full_decode_state()
+    stream_key: tuple[Any, ...] = (kind, input_tensor.device, stream)
+    if full_decode_state is not None:
+        stream_key += (full_decode_state,)
+    buffers = getattr(output_owner, "_esimd_qsa_indexer_norm_rope_buffers", None)
+    if buffers is None:
+        buffers = {}
+        output_owner._esimd_qsa_indexer_norm_rope_buffers = buffers
+    output = buffers.get(stream_key)
+    if not (
+        isinstance(output, torch.Tensor)
+        and output.shape == input_tensor.shape
+        and output.dtype == input_tensor.dtype
+        and output.device == input_tensor.device
+        and output.is_contiguous()
+    ):
+        output = torch.empty_like(input_tensor)
+        buffers[stream_key] = output
+
+    def aliases(lhs: torch.Tensor, rhs: torch.Tensor) -> bool:
+        alias_method = getattr(lhs, "is_alias_of", None)
+        if callable(alias_method):
+            return bool(alias_method(rhs))
+        return bool(torch._C._is_alias_of(lhs, rhs))
+
+    if any(
+        aliases(output, tensor)
+        for tensor in (input_tensor, weight, positions, cos_sin_cache)
+    ):
+        return None
+    returned = operation(
+        input_tensor,
+        output,
+        weight,
+        positions,
+        cos_sin_cache,
+        mrope,
+        bool(positions_bounds_proven),
+    )
+    returned_aliases_output = False
+    if isinstance(returned, torch.Tensor):
+        alias_method = getattr(returned, "is_alias_of", None)
+        returned_aliases_output = (
+            bool(alias_method(output))
+            if callable(alias_method)
+            else bool(torch._C._is_alias_of(returned, output))
+        )
+    if (
+        not isinstance(returned, torch.Tensor)
+        or returned.device != output.device
+        or returned.dtype != output.dtype
+        or returned.shape != output.shape
+        or not returned.is_contiguous()
+        or not returned_aliases_output
+        or returned.data_ptr() != output.data_ptr()
+    ):
+        raise RuntimeError(
+            "Qwen3.8 QSA indexer norm+RoPE returned an invalid caller-owned ABI"
+        )
+    return output
+
+
+def _qsa_q_norm_rope_select_candidate(
+    projected_q: torch.Tensor,
+    norm_weight: torch.Tensor,
+    positions: torch.Tensor,
+    rotary_emb: nn.Module,
+    compressed_key_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    *,
+    positions_bounds_proven: bool,
+    pending_transaction: object | None,
+    num_mapped_tokens: int,
+    token_topk: int,
+    compress_ratio: int,
+    compressed_page_size: int,
+) -> object | None:
+    """Return the fused QSA op only for its fixed, proof-backed contract."""
+    if pending_transaction is not None:
+        return None
+    if getattr(torch.compiler, "is_compiling", lambda: False)():
+        return None
+    if not positions_bounds_proven:
+        return None
+    if token_topk != 2048 or compress_ratio != 4 or compressed_page_size != 64:
+        return None
+    if not 1 <= num_mapped_tokens <= 64:
+        return None
+    if (
+        projected_q.device.type != "xpu"
+        or projected_q.dtype != torch.float16
+        or projected_q.shape != (num_mapped_tokens, 4, 128)
+        or not projected_q.is_contiguous()
+        or norm_weight.device != projected_q.device
+        or norm_weight.dtype != torch.float16
+        or norm_weight.shape != (128,)
+        or not norm_weight.is_contiguous()
+    ):
+        return None
+    if positions.device != projected_q.device or positions.dtype not in (
+        torch.int32,
+        torch.int64,
+    ):
+        return None
+    mrope = positions.ndim == 2
+    if mrope:
+        if (
+            positions.shape != (3, num_mapped_tokens)
+            or positions.stride(1) != 1
+            or positions.stride(0) < num_mapped_tokens
+        ):
+            return None
+    elif (
+        positions.ndim != 1
+        or positions.shape != (num_mapped_tokens,)
+        or not positions.is_contiguous()
+    ):
+        return None
+    mrope_section = tuple(getattr(rotary_emb, "mrope_section", ()) or ())
+    if (
+        getattr(rotary_emb, "rotary_dim", None) != 64
+        or mrope_section not in ((), (11, 11, 10))
+        or (mrope and mrope_section != (11, 11, 10))
+        or (mrope and not getattr(rotary_emb, "mrope_interleaved", False))
+    ):
+        return None
+    cos_sin_cache = getattr(rotary_emb, "cos_sin_cache", None)
+    if (
+        not isinstance(cos_sin_cache, torch.Tensor)
+        or cos_sin_cache.device != projected_q.device
+        or cos_sin_cache.dtype != torch.float16
+        or cos_sin_cache.ndim != 2
+        or cos_sin_cache.shape[1] != 64
+        or not cos_sin_cache.is_contiguous()
+    ):
+        return None
+    if (
+        compressed_key_cache.device != projected_q.device
+        or compressed_key_cache.dtype != torch.float16
+        or compressed_key_cache.shape[1:] != (64, 1, 128)
+        or not compressed_key_cache.is_contiguous()
+    ):
+        return None
+    if (
+        page_table.device != projected_q.device
+        or page_table.dtype != torch.int32
+        or page_table.ndim != 2
+        or page_table.shape[0] == 0
+        or page_table.shape[1] == 0
+        or not page_table.is_contiguous()
+        or token_to_req.device != projected_q.device
+        or token_to_req.dtype != torch.int32
+        or token_to_req.shape != (num_mapped_tokens,)
+        or not token_to_req.is_contiguous()
+        or query_positions.device != projected_q.device
+        or query_positions.dtype != torch.int64
+        or query_positions.shape != (num_mapped_tokens,)
+        or not query_positions.is_contiguous()
+        or sequence_lengths.device != projected_q.device
+        or sequence_lengths.dtype != torch.int32
+        or sequence_lengths.ndim != 1
+        or sequence_lengths.shape[0] != page_table.shape[0]
+        or not sequence_lengths.is_contiguous()
+    ):
+        return None
+    from .ops.qsa import get_qsa_q_norm_rope_select_op
+
+    return get_qsa_q_norm_rope_select_op()
+
+
+def _gemma_rmsnorm(
+    hidden_states: torch.Tensor, weight: torch.Tensor, eps: float
+) -> torch.Tensor:
+    """Portable GemmaRMSNorm (``x_normed * (1 + weight)``) in float."""
+    input_dtype = hidden_states.dtype
+    x = hidden_states.float()
+    variance = x.square().mean(-1, keepdim=True)
+    normalized = x * torch.rsqrt(variance + eps)
+    return (normalized * (1.0 + weight.float())).to(input_dtype)
+
+
+def apply_qsa_rope(
+    rotary_emb: nn.Module,
+    positions: torch.Tensor,
+    tensor: torch.Tensor,
+) -> torch.Tensor:
+    """Apply the main attention's exact 1D/MRoPE composition to QSA heads.
+
+    Portable (pure-torch) variant of the CUDA path: it mirrors
+    ``MRotaryEmbedding.forward_native`` — interleaved-section MRoPE for 2D
+    positions and plain neox/gptj RoPE for 1D positions — using the rotary
+    module's native ``apply_rotary_emb`` kernel.
+    """
+    rotary_dim = rotary_emb.rotary_dim
+    cache = rotary_emb._match_cos_sin_cache_dtype(tensor)  # noqa: SLF001
+    cos_sin = cache[positions]
+    cos, sin = cos_sin.chunk(2, dim=-1)
+    if positions.ndim == 2:
+        mrope_section = rotary_emb.mrope_section
+        if getattr(rotary_emb, "mrope_interleaved", False):
+            cos = apply_interleaved_rope(cos, mrope_section)
+            sin = apply_interleaved_rope(sin, mrope_section)
+        else:
+            cos = torch.cat(
+                [m[i] for i, m in enumerate(cos.split(mrope_section, dim=-1))],
+                dim=-1,
+            )
+            sin = torch.cat(
+                [m[i] for i, m in enumerate(sin.split(mrope_section, dim=-1))],
+                dim=-1,
+            )
+    rotated = rotary_emb.apply_rotary_emb.forward_native(
+        tensor[..., :rotary_dim],
+        cos,
+        sin,
+    )
+    return torch.cat((rotated, tensor[..., rotary_dim:]), dim=-1)
+
+
+class QSAIndexer(nn.Module):
+    """Replicated Q/K projection plus paged, weight-free QSA selection.
+
+    ``prefix`` must be the checkpoint's indexer prefix, normally
+    ``model.layers.N.self_attn.indexer``.  Consequently the trainable names are
+    ``index_qk_proj``, ``q_layernorm`` and ``k_layernorm`` under that prefix.
+    """
+
+    def __init__(
+        self,
+        *,
+        vllm_config: VllmConfig,
+        config: Qwen3_8FlashNextTextConfig,
+        layer_id: int,
+        rotary_emb: nn.Module,
+        quant_config: QuantizationConfig | None = None,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        if vllm_config.cache_config is None:
+            raise ValueError("QSA requires a paged KV cache")
+        model_dtype = vllm_config.model_config.dtype
+        if model_dtype not in (torch.float16, torch.bfloat16):
+            raise NotImplementedError(
+                "Qwen3.8-Flash-Next QSA requires an FP16 or BF16 model dtype"
+            )
+
+        self.dtype = model_dtype
+        self._runtime_dtype_validated = False
+        self.layer_id = int(layer_id)
+        self.index_n_heads = int(config.indexer_n_heads)
+        self.index_kv_heads = int(config.indexer_kv_heads)
+        self.index_head_dim = int(config.indexer_head_dim)
+        self.token_topk = int(config.indexer_budget)
+        self.compress_ratio = int(config.indexer_compress_ratio)
+        self.rotary_emb = rotary_emb
+        # The fused Triton pre-indexer is CUDA-only; the XPU port always runs the
+        # portable unfused reference path below.
+        self.use_fused_pre_indexer = False
+        self.prefix = prefix
+        # MTP step 0 selects the target-aligned rows; later steps reuse them
+        # while continuing to update the QSA side cache.
+        self.skip_topk = False
+        # Strict ABI4 receipt buffers are allocated lazily and reused by this
+        # layer's single active XPU stream.
+        self._qsa_receipt_workspace: Any = None
+
+        self.index_qk_proj = ReplicatedLinear(
+            int(config.hidden_size),
+            (self.index_n_heads + self.index_kv_heads) * self.index_head_dim,
+            bias=False,
+            quant_config=quant_config,
+            prefix=f"{prefix}.index_qk_proj" if prefix else "index_qk_proj",
+        )
+        self.q_layernorm = GemmaRMSNorm(
+            self.index_head_dim,
+            eps=float(getattr(config, "rms_norm_eps", 1e-6)),
+        )
+        self.k_layernorm = GemmaRMSNorm(
+            self.index_head_dim,
+            eps=float(getattr(config, "rms_norm_eps", 1e-6)),
+        )
+
+        cache_config = vllm_config.cache_config
+        cache_prefix = f"{prefix}." if prefix else ""
+        self.raw_key_cache = QSAKeyStateCache(
+            head_size=self.index_head_dim,
+            dtype=model_dtype,
+            # Native group compression requires the raw-key position sidecar
+            # even when the model config's MRoPE flag was normalized away by
+            # the Qwen4Exp alias.  The sidecar is caller-owned cache state and
+            # is still only consumed after the historical proof gate.
+            cache_rope_positions=_QSA_GROUP_COMPRESSION_NATIVE_INTEGRATION,
+            prefix=f"{cache_prefix}raw_key_cache",
+            cache_config=cache_config,
+            compress_ratio=self.compress_ratio,
+            vllm_config=vllm_config,
+        )
+        self.compressed_key_cache = QSACompressedKeyCache(
+            head_size=self.index_head_dim,
+            dtype=model_dtype,
+            compress_ratio=self.compress_ratio,
+            prefix=f"{cache_prefix}compressed_key_cache",
+            cache_config=cache_config,
+            vllm_config=vllm_config,
+        )
+
+    @property
+    def output_width(self) -> int:
+        return self.token_topk + self.compress_ratio - 1
+
+    def _metadata(
+        self,
+    ) -> tuple[QSAForwardMetadata, QSAForwardMetadata] | None:
+        metadata = get_forward_context().attn_metadata
+        if isinstance(metadata, list):
+            metadata = metadata[0]
+        if not isinstance(metadata, dict):
+            return None
+        raw = cast(QSAForwardMetadata, metadata[self.raw_key_cache.prefix])
+        compressed = cast(
+            QSAForwardMetadata, metadata[self.compressed_key_cache.prefix]
+        )
+        if raw.num_actual_tokens != compressed.num_actual_tokens:
+            raise RuntimeError("QSA side-cache metadata token counts disagree")
+        if raw.num_mapped_tokens != compressed.num_mapped_tokens:
+            raise RuntimeError("QSA side-cache metadata mapped token counts disagree")
+        if not 0 <= raw.num_mapped_tokens <= raw.num_actual_tokens:
+            raise RuntimeError(
+                "QSA mapped token count must be within the physical token count"
+            )
+        if (
+            raw.logical_positions.shape != compressed.logical_positions.shape
+            or raw.logical_positions.dtype != compressed.logical_positions.dtype
+            or raw.logical_positions.device != compressed.logical_positions.device
+        ):
+            raise RuntimeError("QSA side-cache metadata positions disagree")
+        raw_positions_cpu = getattr(raw, "logical_positions_cpu", None)
+        compressed_positions_cpu = getattr(compressed, "logical_positions_cpu", None)
+        if (
+            raw_positions_cpu is not None
+            and compressed_positions_cpu is not None
+            and raw_positions_cpu != compressed_positions_cpu
+        ):
+            raise RuntimeError("QSA side-cache CPU position witnesses disagree")
+        if raw.logical_positions.is_cpu:
+            positions_match = torch.equal(
+                raw.logical_positions, compressed.logical_positions
+            )
+        else:
+            raw_source_ids = getattr(raw, "logical_positions_source_ids", None)
+            compressed_source_ids = getattr(
+                compressed, "logical_positions_source_ids", None
+            )
+            positions_match = (
+                raw_source_ids is not None and raw_source_ids == compressed_source_ids
+            )
+        if not positions_match:
+            raise RuntimeError("QSA side-cache metadata positions disagree")
+        return raw, compressed
+
+    def forward(
+        self,
+        hidden_states: torch.Tensor,
+        positions: torch.Tensor,
+        out: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        """Return fixed-width request-relative token indices padded with ``-1``."""
+        metadata = self._metadata()
+        if metadata is None:
+            # Preserve step-0 indices when later MTP steps reuse the buffer.
+            if self.skip_topk and out is not None:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record_qsa_reuse(out.shape[0])
+                return out
+            result = torch.full(
+                (hidden_states.shape[0], self.output_width),
+                -1,
+                dtype=torch.int32,
+                device=hidden_states.device,
+            )
+            if out is not None:
+                out.copy_(result)
+                return out
+            return result
+
+        from .ops.qsa import (
+            QSAWriteReceiptWorkspace,
+            qsa_compress_groups_with_ratio,
+            qsa_select_paged_tokens,
+            qsa_store_cache_rows_transaction,
+            try_qsa_group_compress_native,
+            validate_qsa_write_manifest,
+        )
+
+        raw_metadata, compressed_metadata = metadata
+        from .full_decode import active_full_decode_state
+
+        full_decode_state = active_full_decode_state()
+        full_decode = full_decode_state is not None and full_decode_state.owns(
+            raw_metadata
+        )
+        num_tokens = raw_metadata.num_actual_tokens
+        num_mapped_tokens = raw_metadata.num_mapped_tokens
+        hidden_states = hidden_states[:num_tokens]
+        positions = positions[..., :num_tokens]
+
+        # Q/K projection.  The native decode adapter writes one caller-owned
+        # backing tensor and exposes Q/raw-K as disjoint metadata views.
+        projected = try_esimd_qsa_indexer_projection(hidden_states, self.index_qk_proj)
+        if projected is None:
+            projected_qk, _ = self.index_qk_proj(hidden_states)
+            projected_q, raw_keys = projected_qk.split(
+                (
+                    self.index_n_heads * self.index_head_dim,
+                    self.index_kv_heads * self.index_head_dim,
+                ),
+                dim=-1,
+            )
+        else:
+            projected_q, raw_keys = projected
+        raw_key_state_cache = self.raw_key_cache
+        compressed_key_cache = self.compressed_key_cache.kv_cache
+        if compressed_key_cache.ndim != 4:
+            raise RuntimeError("QSA compressed key cache has an invalid rank")
+        compressed_page_size = int(compressed_key_cache.shape[1])
+        if compressed_metadata.storage_block_size != compressed_page_size:
+            raise RuntimeError(
+                "QSA compressed metadata/cache page sizes disagree: "
+                f"metadata={compressed_metadata.storage_block_size}, "
+                f"cache={compressed_page_size}"
+            )
+        if compressed_metadata.compress_ratio != self.compress_ratio:
+            raise RuntimeError(
+                "QSA compressed metadata compression ratio disagrees: "
+                f"metadata={compressed_metadata.compress_ratio}, "
+                f"indexer={self.compress_ratio}"
+            )
+        if not self._runtime_dtype_validated:
+            runtime_tensors = {
+                "hidden_states": hidden_states,
+                "projected_q": projected_q,
+                "raw_keys": raw_keys,
+                "raw_key_cache": raw_key_state_cache.kv_cache,
+                "compressed_key_cache": compressed_key_cache,
+                "q_layernorm_weight": self.q_layernorm.weight,
+                "k_layernorm_weight": self.k_layernorm.weight,
+            }
+            mismatches = {
+                name: tensor.dtype
+                for name, tensor in runtime_tensors.items()
+                if tensor.dtype != self.dtype
+            }
+            if mismatches:
+                actual = ", ".join(
+                    f"{name}={dtype}" for name, dtype in mismatches.items()
+                )
+                raise RuntimeError(
+                    "Qwen3.8-Flash-Next QSA indexer dtype mismatch: "
+                    f"expected={self.dtype}; {actual}"
+                )
+            self._runtime_dtype_validated = True
+
+        if self.use_fused_pre_indexer:
+            raise RuntimeError(
+                "Fused QSA pre-indexer is CUDA-only and unsupported on XPU"
+            )
+        else:
+            q_input = projected_q.reshape(-1, self.index_n_heads, self.index_head_dim)
+            pending_transaction = getattr(
+                raw_metadata, "qsa_ring_pending_transaction", None
+            )
+            pending_transactions = tuple(
+                getattr(raw_metadata, "qsa_ring_pending_transactions", ())
+            )
+            if pending_transaction is None and len(pending_transactions) == 1:
+                pending_transaction = pending_transactions[0]
+            fusion_operation = _qsa_q_norm_rope_select_candidate(
+                q_input[:num_mapped_tokens],
+                self.q_layernorm.weight,
+                positions[..., :num_mapped_tokens],
+                self.rotary_emb,
+                compressed_key_cache,
+                compressed_metadata.block_table,
+                compressed_metadata.token_to_req[:num_mapped_tokens],
+                compressed_metadata.logical_positions[:num_mapped_tokens],
+                compressed_metadata.seq_lens,
+                positions_bounds_proven=bool(
+                    getattr(raw_metadata, "mrope_positions_bounds_proven", False)
+                ),
+                pending_transaction=pending_transaction,
+                num_mapped_tokens=num_mapped_tokens,
+                token_topk=self.token_topk,
+                compress_ratio=self.compress_ratio,
+                compressed_page_size=compressed_page_size,
+            )
+            q = None
+            if fusion_operation is None:
+                # Q norm+RoPE is optional and remains a complete Torch reference.
+                q = try_esimd_qsa_indexer_norm_rope(
+                    q_input,
+                    self.q_layernorm.weight,
+                    positions,
+                    self.rotary_emb,
+                    kind="q",
+                    output_owner=self,
+                    positions_bounds_proven=bool(
+                        getattr(raw_metadata, "mrope_positions_bounds_proven", False)
+                    ),
+                    variance_epsilon=self.q_layernorm.variance_epsilon,
+                )
+                if q is None:
+                    q = _gemma_rmsnorm(
+                        q_input.reshape(-1, self.index_head_dim),
+                        self.q_layernorm.weight,
+                        self.q_layernorm.variance_epsilon,
+                    ).reshape_as(q_input)
+                    q = apply_qsa_rope(self.rotary_emb, positions, q)
+
+            raw_key_cache = raw_key_state_cache.key_cache
+            rope_position_cache = raw_key_state_cache.rope_position_cache
+            device_ring_ledger = prepare_qsa_device_ring_ledger(
+                self, raw_key_cache, raw_metadata
+            )
+            if rope_position_cache is None:
+                position_rows = raw_metadata.logical_positions.view(-1, 1, 1).expand(
+                    -1, 1, 3
+                )
+            else:
+                position_rows = (
+                    canonical_qsa_rope_positions(positions)
+                    .to(device=raw_key_cache.device)
+                    .contiguous()
+                )
+            raw_keys_for_compression = raw_keys.reshape(-1, 1, self.index_head_dim)
+            skip_compressed_group = not full_decode and _qsa_skip_incomplete_group(
+                raw_metadata,
+                compressed_metadata,
+                pending_transaction,
+                compress_ratio=int(self.compress_ratio),
+            )
+            compressed_keys = None
+            if skip_compressed_group:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_QSA_GROUP_COMPRESSION, EVENT_ZERO_WORK_SKIP, 0
+                    )
+            else:
+                historical_ring_proven = (
+                    full_decode and not hasattr(full_decode_state, "prepared_history")
+                ) or bool(getattr(raw_metadata, "historical_ring_proven", False))
+                if device_ring_ledger is not None:
+                    device_ring_ledger.validate_history(
+                        raw_metadata,
+                        compressed_metadata.slot_mapping,
+                        int(self.compress_ratio),
+                    )
+                    # This is an ordered device assertion of producer tags,
+                    # not a CPU guess about the accepted speculative frontier.
+                    historical_ring_proven = True
+                raw_pending_transactions = tuple(
+                    getattr(raw_metadata, "qsa_ring_pending_transactions", ())
+                )
+                if not historical_ring_proven:
+                    raw_query_start_loc_cpu = getattr(
+                        raw_metadata, "query_start_loc_cpu", None
+                    )
+                    raw_logical_positions_cpu = getattr(
+                        raw_metadata, "logical_positions_cpu", None
+                    )
+                    if (
+                        raw_query_start_loc_cpu is not None
+                        and raw_logical_positions_cpu is not None
+                        and raw_pending_transactions
+                    ):
+                        recomputed_historical_ring_proven = (
+                            _qsa_historical_ring_proven_for_batch(
+                                common_attn_metadata=raw_metadata,
+                                query_start_loc_cpu=raw_query_start_loc_cpu,
+                                logical_positions_cpu=raw_logical_positions_cpu,
+                                num_tokens=raw_metadata.num_actual_tokens,
+                                storage_block_size=raw_metadata.storage_block_size,
+                                compress_ratio=int(self.compress_ratio),
+                            )
+                        )
+                        historical_ring_proven = recomputed_historical_ring_proven
+                compression_work_units = int(raw_keys_for_compression.shape[0])
+                native_compression = None
+                if NATIVE_STATS_ENABLED:
+                    if compression_work_units == 0:
+                        NATIVE_STATS.record(
+                            PATH_QSA_GROUP_COMPRESSION,
+                            EVENT_ZERO_WORK_SKIP,
+                            0,
+                        )
+                    else:
+                        NATIVE_STATS.record(
+                            PATH_QSA_GROUP_COMPRESSION,
+                            EVENT_ATTEMPT,
+                            compression_work_units,
+                        )
+
+                if compression_work_units == 0:
+                    if NATIVE_STATS_ENABLED:
+                        pooled, first_positions = qsa_compress_groups_with_ratio(
+                            raw_keys_for_compression,
+                            position_rows,
+                            raw_key_cache,
+                            raw_metadata.block_table,
+                            raw_metadata.token_to_req,
+                            raw_metadata.query_start_loc,
+                            raw_metadata.logical_positions,
+                            compressed_metadata.slot_mapping,
+                            compress_ratio=int(self.compress_ratio),
+                            rope_cache=rope_position_cache,
+                            historical_ring_proven=historical_ring_proven,
+                            allow_unproven_history=False,
+                        )
+                    else:
+                        pooled, first_positions = qsa_compress_groups_with_ratio(
+                            raw_keys_for_compression,
+                            position_rows,
+                            raw_key_cache,
+                            raw_metadata.block_table,
+                            raw_metadata.token_to_req,
+                            raw_metadata.query_start_loc,
+                            raw_metadata.logical_positions,
+                            compressed_metadata.slot_mapping,
+                            compress_ratio=int(self.compress_ratio),
+                            rope_cache=rope_position_cache,
+                            historical_ring_proven=historical_ring_proven,
+                            allow_unproven_history=False,
+                        )
+                else:
+                    if not _QSA_GROUP_COMPRESSION_NATIVE_INTEGRATION:
+                        if NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record(
+                                PATH_QSA_GROUP_COMPRESSION,
+                                EVENT_FALLBACK,
+                                compression_work_units,
+                                REASON_DISABLED,
+                            )
+                    elif not historical_ring_proven:
+                        # Never read an uncommitted/stale ring merely to preserve
+                        # availability while async provenance is incomplete.
+                        if NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record(
+                                PATH_QSA_GROUP_COMPRESSION,
+                                EVENT_FALLBACK,
+                                compression_work_units,
+                                REASON_SCENARIO_DECODE_PROOF,
+                            )
+                    else:
+                        if NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record(
+                                PATH_QSA_GROUP_COMPRESSION,
+                                EVENT_ELIGIBLE,
+                                compression_work_units,
+                            )
+                        native_compression = try_qsa_group_compress_native(
+                            raw_keys_for_compression,
+                            position_rows,
+                            raw_key_cache,
+                            rope_position_cache,
+                            raw_metadata.block_table,
+                            raw_metadata.token_to_req,
+                            raw_metadata.query_start_loc,
+                            raw_metadata.logical_positions,
+                            compressed_metadata.slot_mapping,
+                            compress_ratio=int(self.compress_ratio),
+                            compressed_capacity=(
+                                compressed_key_cache.shape[0]
+                                * compressed_key_cache.shape[1]
+                            ),
+                            historical_ring_proven=historical_ring_proven,
+                            output_owner=self,
+                        )
+                        if native_compression is not None and NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record(
+                                PATH_QSA_GROUP_COMPRESSION,
+                                EVENT_NATIVE_SUBMITTED,
+                                compression_work_units,
+                            )
+                        elif NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record(
+                                PATH_QSA_GROUP_COMPRESSION,
+                                EVENT_FALLBACK,
+                                compression_work_units,
+                                REASON_OP_UNAVAILABLE,
+                            )
+
+                    if native_compression is None:
+                        pooled, first_positions = qsa_compress_groups_with_ratio(
+                            raw_keys_for_compression,
+                            position_rows,
+                            raw_key_cache,
+                            raw_metadata.block_table,
+                            raw_metadata.token_to_req,
+                            raw_metadata.query_start_loc,
+                            raw_metadata.logical_positions,
+                            compressed_metadata.slot_mapping,
+                            compress_ratio=int(self.compress_ratio),
+                            rope_cache=rope_position_cache,
+                            historical_ring_proven=historical_ring_proven,
+                            # A missing proof must remain fail-closed.  The legacy
+                            # ``allow_unproven_history`` escape hatch is reserved
+                            # for explicit compatibility callers; using it here
+                            # could consume a stale ring slot after an async frame.
+                            allow_unproven_history=False,
+                        )
+                    else:
+                        pooled, first_positions = native_compression
+                mrope_positions = bool(getattr(self.rotary_emb, "mrope_section", None))
+                if mrope_positions:
+                    first_positions = first_positions.transpose(0, 1)
+                else:
+                    # The Qwen4Exp alias currently exposes a plain 1D RoPE module,
+                    # while the native-compression ABI may still allocate the
+                    # optional 3-axis position sidecar.  Do not read that sidecar
+                    # in the 1D path: an unproven historical slot can be stale or
+                    # uninitialized under async scheduling.  A completed group's
+                    # first position is exactly its logical end position minus
+                    # ``compress_ratio - 1`` and the compressed slot mapping is
+                    # the caller-owned validity witness.
+                    first_positions = compressed_first_positions(
+                        raw_metadata.logical_positions,
+                        compressed_metadata.slot_mapping,
+                        self.compress_ratio,
+                    )
+                compressed_input = pooled.reshape(-1, 1, self.index_head_dim)
+                compressed_keys = try_esimd_qsa_indexer_norm_rope(
+                    compressed_input,
+                    self.k_layernorm.weight,
+                    first_positions,
+                    self.rotary_emb,
+                    kind="k",
+                    output_owner=self,
+                    # Ring ownership does not prove RoPE cache bounds. Both
+                    # the history and current-position proofs are required.
+                    positions_bounds_proven=historical_ring_proven
+                    and bool(
+                        getattr(raw_metadata, "mrope_positions_bounds_proven", False)
+                    ),
+                    variance_epsilon=self.k_layernorm.variance_epsilon,
+                )
+                if compressed_keys is None:
+                    compressed_keys = _gemma_rmsnorm(
+                        compressed_input.reshape(-1, self.index_head_dim),
+                        self.k_layernorm.weight,
+                        self.k_layernorm.variance_epsilon,
+                    ).reshape_as(compressed_input)
+                    compressed_keys = apply_qsa_rope(
+                        self.rotary_emb,
+                        first_positions,
+                        compressed_keys,
+                    )
+            write_manifest = None
+            if (
+                pending_transaction is not None
+                and pending_transaction.write_manifest_required
+            ):
+                row_logical_tags = getattr(raw_metadata, "logical_positions_cpu", None)
+                if row_logical_tags is None:
+                    raise RuntimeError(
+                        "QSA write manifest requires a CPU logical-position witness"
+                    )
+                raw_block_table_cpu = getattr(raw_metadata, "block_table_cpu", None)
+                compressed_block_table_cpu = getattr(
+                    compressed_metadata, "block_table_cpu", None
+                )
+                if (
+                    raw_block_table_cpu is None
+                    or compressed_block_table_cpu is None
+                    or raw_block_table_cpu.ndim != 2
+                    or compressed_block_table_cpu.ndim != 2
+                    or raw_block_table_cpu.shape[0] < 1
+                    or compressed_block_table_cpu.shape[0] < 1
+                    or raw_block_table_cpu.shape[1] < 1
+                    or compressed_block_table_cpu.shape[1] < 1
+                ):
+                    raise RuntimeError(
+                        "QSA write manifest requires CPU block-table witnesses"
+                    )
+                if int(raw_block_table_cpu[0, 0]) != pending_transaction.lease.block_id:
+                    raise RuntimeError(
+                        "QSA raw block-table witness disagrees with ring lease"
+                    )
+                raw_block_ids = tuple(
+                    pending_transaction.lease.block_id
+                    if tag in pending_transaction.logical_tags
+                    else -1
+                    for tag in row_logical_tags
+                )
+                compressed_block_ids = []
+                compressed_block_size = int(compressed_metadata.storage_block_size)
+                # The raw circular-buffer metadata may advertise ratio=1;
+                # QSA compression ratio is owned by the validated indexer path.
+                compress_ratio = self.compress_ratio
+                for row_tag in row_logical_tags:
+                    if row_tag < 0 or (row_tag + 1) % compress_ratio != 0:
+                        compressed_block_ids.append(-1)
+                        continue
+                    compressed_position = row_tag // compress_ratio
+                    logical_block = compressed_position // compressed_block_size
+                    if logical_block >= compressed_block_table_cpu.shape[1]:
+                        raise RuntimeError(
+                            "QSA compressed block-table witness is out of range"
+                        )
+                    compressed_block_id = int(
+                        compressed_block_table_cpu[0, logical_block]
+                    )
+                    if compressed_block_id < 0:
+                        raise RuntimeError(
+                            "QSA compressed block-table witness is invalid"
+                        )
+                    compressed_block_ids.append(compressed_block_id)
+                try:
+                    write_manifest = QSAHistoricalRingWriteManifest.from_transaction(
+                        pending_transaction,
+                        row_logical_tags,
+                        raw_ring_size=int(raw_metadata.storage_block_size),
+                        compressed_block_size=compressed_block_size,
+                        compress_ratio=compress_ratio,
+                        raw_block_ids=raw_block_ids,
+                        compressed_block_ids=tuple(compressed_block_ids),
+                    )
+                except (TypeError, ValueError) as exc:
+                    raise RuntimeError("QSA write manifest preflight failed") from exc
+
+            stores: tuple[tuple[torch.Tensor, torch.Tensor, torch.Tensor], ...] = (
+                (raw_key_cache, raw_metadata.slot_mapping, raw_keys),
+            )
+            store_kinds: tuple[str, ...] = ("raw",)
+            store_unique_slots_proven: tuple[bool, ...] = (False,)
+            if rope_position_cache is not None:
+                stores += (
+                    (rope_position_cache, raw_metadata.slot_mapping, position_rows),
+                )
+                store_kinds += ("position",)
+                store_unique_slots_proven += (False,)
+            if not skip_compressed_group:
+                assert compressed_keys is not None
+                stores = (
+                    (
+                        compressed_key_cache,
+                        compressed_metadata.slot_mapping,
+                        compressed_keys,
+                    ),
+                ) + stores
+                store_kinds = ("compressed",) + store_kinds
+                store_unique_slots_proven = (
+                    bool(
+                        getattr(
+                            compressed_metadata, "compressed_slots_unique_proven", False
+                        )
+                    ),
+                ) + store_unique_slots_proven
+            if write_manifest is not None:
+                validate_qsa_write_manifest(stores, store_kinds, write_manifest)
+                receipt_workspace = getattr(self, "_qsa_receipt_workspace", None)
+                if receipt_workspace is None:
+                    receipt_workspace = QSAWriteReceiptWorkspace()
+                    self._qsa_receipt_workspace = receipt_workspace
+                store_completed = qsa_store_cache_rows_transaction(
+                    stores,
+                    store_kinds=store_kinds,
+                    manifest=write_manifest,
+                    receipt_workspace=receipt_workspace,
+                )
+            else:
+                if any(store_unique_slots_proven):
+                    store_completed = qsa_store_cache_rows_transaction(
+                        stores,
+                        unique_slots_proven=store_unique_slots_proven,
+                    )
+                else:
+                    store_completed = qsa_store_cache_rows_transaction(stores)
+            if store_completed is True:
+                if device_ring_ledger is not None:
+                    device_ring_ledger.acknowledge_store(raw_metadata)
+                acknowledgements = []
+                if pending_transactions:
+                    for transaction in pending_transactions:
+                        if (
+                            write_manifest is not None
+                            and transaction == pending_transaction
+                        ):
+                            acknowledgements.append(
+                                QSAHistoricalRingWriteAcknowledgement(
+                                    request_id=transaction.request_id,
+                                    lease=transaction.lease,
+                                    epoch=transaction.epoch,
+                                    logical_tags=transaction.logical_tags,
+                                    causal_generation=transaction.causal_generation,
+                                    manifest=write_manifest,
+                                    receipt_abi_version=(
+                                        QSA_ROW_STORE_RECEIPT_ABI_VERSION
+                                    ),
+                                    manifest_digest=write_manifest.digest,
+                                )
+                            )
+                        elif not transaction.write_manifest_required:
+                            # v2 uses stream order as its completion fence.  No
+                            # host/event synchronization is needed: the next
+                            # v2 launch is enqueued after these row stores on
+                            # the same execution stream.
+                            acknowledgements.append(
+                                QSAHistoricalRingWriteAcknowledgement(
+                                    request_id=transaction.request_id,
+                                    lease=transaction.lease,
+                                    epoch=transaction.epoch,
+                                    logical_tags=transaction.logical_tags,
+                                    causal_generation=transaction.causal_generation,
+                                )
+                            )
+                elif (
+                    write_manifest is not None
+                    and pending_transaction is not None
+                    and pending_transaction.request_id
+                ):
+                    # Preserve the legacy single-transaction manifest path
+                    # for hand-built metadata and existing receipt tests.
+                    acknowledgements.append(
+                        QSAHistoricalRingWriteAcknowledgement(
+                            request_id=pending_transaction.request_id,
+                            lease=pending_transaction.lease,
+                            epoch=pending_transaction.epoch,
+                            logical_tags=pending_transaction.logical_tags,
+                            causal_generation=pending_transaction.causal_generation,
+                            manifest=write_manifest,
+                            receipt_abi_version=QSA_ROW_STORE_RECEIPT_ABI_VERSION,
+                            manifest_digest=write_manifest.digest,
+                        )
+                    )
+                if acknowledgements:
+                    raw_metadata.qsa_ring_write_acknowledgements = tuple(
+                        acknowledgements
+                    )
+                    if len(acknowledgements) == 1:
+                        raw_metadata.qsa_ring_write_acknowledgement = acknowledgements[
+                            0
+                        ]
+
+        if self.skip_topk:
+            if out is None:
+                raise RuntimeError("QSA top-k reuse requires an output buffer")
+            if NATIVE_STATS_ENABLED:
+                if num_mapped_tokens == 0:
+                    NATIVE_STATS.record(
+                        PATH_QSA_SELECTION,
+                        EVENT_ZERO_WORK_SKIP,
+                        0,
+                    )
+                else:
+                    NATIVE_STATS.record_qsa_reuse(num_mapped_tokens)
+            return out
+
+        # Only mapped rows are logically live. Physical padding remains -1.
+        expected_shape = (num_tokens, self.output_width)
+        if out is None:
+            out = torch.full(
+                expected_shape,
+                -1,
+                dtype=torch.int32,
+                device=hidden_states.device,
+            )
+        else:
+            if out.shape != expected_shape:
+                raise RuntimeError("QSA selection buffer has an invalid shape")
+            out.fill_(-1)
+        if num_mapped_tokens == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_SELECTION,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+            return out
+
+        if fusion_operation is not None:
+            from .ops.qsa import get_qsa_long_context_select_op
+
+            parallel_selection = get_qsa_long_context_select_op(
+                getattr(compressed_metadata, "max_seq_len", 0), num_mapped_tokens
+            )
+            if parallel_selection is not None:
+                fusion_operation = parallel_selection
+            cos_sin_cache = getattr(self.rotary_emb, "cos_sin_cache", None)
+            native_kwargs = (
+                {
+                    "max_seq_len": getattr(compressed_metadata, "max_seq_len", 0),
+                    "compressed_page_size": int(compressed_key_cache.shape[1]),
+                }
+                if using_qwen38_sycl()
+                else {}
+            )
+            fused = fusion_operation(
+                q_input[:num_mapped_tokens],
+                self.q_layernorm.weight,
+                positions[..., :num_mapped_tokens],
+                cos_sin_cache,
+                compressed_key_cache,
+                compressed_metadata.block_table,
+                compressed_metadata.token_to_req[:num_mapped_tokens],
+                compressed_metadata.logical_positions[:num_mapped_tokens],
+                compressed_metadata.seq_lens,
+                q_input.new_empty(0),
+                out[:num_mapped_tokens],
+                positions.ndim == 2,
+                bool(getattr(raw_metadata, "mrope_positions_bounds_proven", False)),
+                **native_kwargs,
+            )
+            if (
+                not isinstance(fused, torch.Tensor)
+                or fused.data_ptr() != out.data_ptr()
+                or fused.shape != out[:num_mapped_tokens].shape
+            ):
+                raise RuntimeError(
+                    "QSA fused norm+RoPE+selection did not preserve its output"
+                )
+            return out
+
+        if q is None:
+            raise RuntimeError("QSA norm+RoPE did not produce a selection query")
+        selected = qsa_select_paged_tokens(
+            q[:num_mapped_tokens],
+            compressed_key_cache,
+            compressed_metadata.block_table,
+            compressed_metadata.token_to_req[:num_mapped_tokens],
+            compressed_metadata.logical_positions[:num_mapped_tokens],
+            compressed_metadata.seq_lens,
+            self.token_topk,
+            self.compress_ratio,
+            out[:num_mapped_tokens],
+            max_seq_len=getattr(compressed_metadata, "max_seq_len", 0),
+        )
+        if selected.data_ptr() != out.data_ptr():
+            raise RuntimeError("QSA selection did not preserve its caller output")
+        return out
+
+
+__all__ = [
+    "QSAIndexer",
+    "apply_qsa_rope",
+    "try_esimd_qsa_indexer_norm_rope",
+]
