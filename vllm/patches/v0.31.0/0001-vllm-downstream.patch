+                    attn_output, self.o_proj, "_esimd_int4_output_projection_buffer"
+                )
+                if output is None:
+                    output = try_esimd_fp8_linear(
+                        attn_output, self.o_proj, "_esimd_output_projection_buffer"
+                    )
+        if output is None:
+            output, _ = self.o_proj(attn_output)
+        elif base_o_proj.reduce_results and base_o_proj.tp_size > 1:
+            handled = False
+            if (
+                getattr(self.o_proj, "_qwen4_dense_int4", False) is True
+                or getattr(self.o_proj, "_qwen4_dense_fp8", False) is True
+            ):
+                from vllm.models.qwen4_exp.xpu.dense_all_reduce import (
+                    try_dense_local_all_reduce,
+                )
+
+                handled = try_dense_local_all_reduce(
+                    output,
+                    self.o_proj,
+                    attn_output,
+                    extra_inputs=(gate,) if gate is not None else (),
+                )
+            if not handled:
+                output = tensor_model_parallel_all_reduce(output)
         return output
 
 
