+def get_qsa_long_context_select_op(
+    max_seq_len: int,
+    rows: int = 1,
+    *,
+    preprocessed: bool = False,
+    compressed_page_size: int = 64,
+) -> object | None:
+    """Use host metadata for dispatch, never synchronize device sequence lengths."""
+    # Conservative BMG gates shared by both entry points.
+    # The fused M=32 path needs 16k; preprocessed Q can win below these gates.
+    # Large M already exposes substantial row parallelism without partitioning.
+    if not 1 <= rows <= 32:
+        return None
+    threshold = 4096 if rows <= 8 else 16384
+    # Short TP4 M1 needs the local-Q kernel WITHOUT the five merge launches
+    # of 32-way selection. Older DSOs return None and keep the serial path.
+    if (
+        rows == 1
+        and preprocessed
+        and compressed_page_size == 128
+        and 512 <= max_seq_len < 4096
+        and _qsa_env_flag("VLLM_XPU_QWEN38_QSA_PARALLEL_SELECT", default=True)
+        and _qsa_env_flag("VLLM_XPU_QWEN38_QSA_LOCAL_SELECT", default=True)
+    ):
+        return _load_qsa_local_selection_op(compressed_page_size)
+    if (
+        max_seq_len < threshold
+        or (not preprocessed and not _native_qsa_q_norm_rope_select_enabled())
+        or not _qsa_env_flag("VLLM_XPU_QWEN38_QSA_PARALLEL_SELECT", default=True)
+    ):
+        return None
+    return _load_qsa_parallel_selection_op(preprocessed, compressed_page_size)
