+    scale: torch.Tensor
+    source_signature: tuple[object, ...]
+
+
+class Qwen3NextQkvEsimdAdapter:
+    """Own the lazy optional import and the fused kernel's output-buffer ABI."""
+
+    def __init__(
+        self,
+        module_loader: Callable[[], object] = _load_esimd_module,
+    ) -> None:
+        self._module_loader = module_loader
+        self._module: object | None = None
+        self._loaded = False
+
+    def _get_module(self) -> object | None:
+        if not self._loaded:
+            self._loaded = True
+            try:
+                self._module = self._module_loader()
+            except (AttributeError, ImportError, OSError, RuntimeError):
+                self._module = None
+        return self._module
+
+    def try_postprocess(
+        self,
+        qkv: torch.Tensor,
+        positions: torch.Tensor,
+        *,
+        projection: Any,
+        norm_wq: torch.Tensor,
+        norm_wk: torch.Tensor,
+        cos_sin_cache: torch.Tensor,
+        q_heads: int,
+        kv_heads: int,
+        head_dim: int,
+        rotary_dim: int,
+        norm_epsilon: float,
+        is_neox_style: bool,
+        attn_output_gate: bool,
+        text_only: bool,
+        positions_bounds_proven: bool = False,
+    ) -> Qwen3NextQkvPostprocessResult | None:
+        projection = _get_base_layer_for_no_lora(projection)
+        if projection is None:
+            return None
+        if (
+            _DISABLE_ESIMD_QKV
+            or torch.compiler.is_compiling()
+            or not _direct_parameters(qkv, positions, norm_wq, norm_wk, cos_sin_cache)
+        ):
+            return None
+        sycl_backend = envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+        # SYCL consumes live QKV/norm/cache, not projection weights or a
+        # transformed weight recipe. Native preflight validates those inputs.
+        source_signature = (
+            ("xpu_sycl",)
+            if sycl_backend
+            else (
+                _qkv_plan_signature(projection),
+                *(
+                    _tensor_storage_signature(t)
+                    for t in (norm_wq, norm_wk, cos_sin_cache)
+                ),
+            )
+        )
+        signature = (
+            source_signature,
+            q_heads,
+            kv_heads,
+            head_dim,
+            rotary_dim,
+            norm_epsilon,
+            is_neox_style,
+            attn_output_gate,
+        )
+        if getattr(projection, "_esimd_qkv_live_signature", None) != signature:
+            projection._esimd_qkv_postprocess_plan = None
+            projection._esimd_qkv_live_signature = signature
+        plan = getattr(projection, "_esimd_qkv_postprocess_plan", None)
+        if not isinstance(plan, _QkvPostprocessPlan):
+            plan = None
+        if plan is None and (
+            _DISABLE_ESIMD_QKV
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+        ):
+            return None
+
+        rows = qkv.shape[0] if qkv.ndim == 2 else 0
+        if positions.ndim == 1:
+            plain_positions = positions
+        elif text_only and positions.ndim == 2 and positions.shape == (3, rows):
+            # V1 broadcasts text-only M-RoPE positions across all three rows.
+            # Identical T/H/W coordinates reduce exactly to plain RoPE.
+            plain_positions = positions[0]
+        else:
+            return None
+        if not 1 <= rows <= 64 or plain_positions.shape[0] != rows:
+            return None
+
+        if sycl_backend and (
+            _DISABLE_ESIMD_QKV
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not positions_bounds_proven
+            or q_heads not in (3, 6)
+            or kv_heads != 1
+            or head_dim != 256
+            or rotary_dim != 64
+            or norm_epsilon != 1e-6
+            or not is_neox_style
+            or not attn_output_gate
+            or plain_positions.dtype not in (torch.int32, torch.int64)
+            or plain_positions.device != qkv.device
+            or qkv.device.type != "xpu"
+            or any(
+                t.device != qkv.device
+                or t.dtype != torch.float16
+                or not t.is_contiguous()
+                for t in (qkv, norm_wq, norm_wk, cos_sin_cache)
+            )
+            or norm_wq.shape != (head_dim,)
+            or norm_wk.shape != (head_dim,)
+            or cos_sin_cache.ndim != 2
+            or cos_sin_cache.shape[0] == 0
+            or cos_sin_cache.shape[1] != rotary_dim
+        ):
+            # Reject before position conversion can submit any device work.
+            return None
+
+        if plan is None or sycl_backend:
+            quant_method = getattr(projection, "quant_method", None)
+            is_sym_int4 = getattr(quant_method, "is_sym_int4", False)
+            if not is_sym_int4:
+                weight = getattr(projection, "weight", None)
+                weight_scale = getattr(projection, "weight_scale", None)
+                weight_scale_inv = getattr(projection, "weight_scale_inv", None)
+                weight_block_size = getattr(projection, "weight_block_size", None)
+                is_runtime_fp8 = (
+                    isinstance(weight, torch.Tensor)
+                    and weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+                    and isinstance(weight_scale, torch.Tensor)
+                    and weight_scale.numel() == 1
+                )
+                is_block_fp8 = (
+                    isinstance(weight, torch.Tensor)
+                    and weight.dtype == torch.float8_e4m3fn
+                    and isinstance(weight_scale_inv, torch.Tensor)
+                    and weight_scale_inv.dtype == torch.float32
+                    and tuple(weight_block_size or ()) == (128, 128)
+                )
+                if not (is_runtime_fp8 or is_block_fp8):
+                    return None
+        if plan is None:
+            q_size = q_heads * head_dim
+            kv_size = kv_heads * head_dim
+            expected_width = q_size * (2 if attn_output_gate else 1) + 2 * kv_size
+            tensors = (qkv, norm_wq, norm_wk, cos_sin_cache)
+            if (
+                head_dim != 256
+                or norm_epsilon != 1e-6
+                or not is_neox_style
+                or q_heads <= 0
+                or kv_heads <= 0
+                or rotary_dim <= 0
+                or rotary_dim > head_dim
+                or rotary_dim % 2 != 0
+                or qkv.shape != (rows, expected_width)
+                or plain_positions.dtype not in (torch.int32, torch.int64)
+                or any(t.device.type != "xpu" for t in tensors)
+                or any(t.device != qkv.device for t in (*tensors[1:], plain_positions))
+                or any(t.dtype != torch.float16 for t in tensors)
+                or norm_wq.shape != (head_dim,)
+                or norm_wk.shape != (head_dim,)
+                or cos_sin_cache.ndim != 2
+                or cos_sin_cache.shape[0] == 0
+                or cos_sin_cache.shape[1] != rotary_dim
+                or any(not t.is_contiguous() for t in tensors)
+            ):
+                return None
+
+            module = self._get_module()
+            op = getattr(module, "esimd_qkv_split_norm_rope", None)
+            if not callable(op):
+                return None
+            plan = _QkvPostprocessPlan(
+                op=op,
+                q_size=q_size,
+                kv_size=kv_size,
+                expected_width=expected_width,
+                norm_wq=norm_wq,
+                norm_wk=norm_wk,
+                cos_sin_cache=cos_sin_cache,
+                q_heads=q_heads,
+                kv_heads=kv_heads,
+                rotary_dim=rotary_dim,
+                attn_output_gate=attn_output_gate,
+            )
+            projection._esimd_qkv_postprocess_plan = plan
+        elif qkv.shape != (rows, plan.expected_width):
+            return None
+
+        if sycl_backend and (
+            plan.norm_wq is not norm_wq
+            or plan.norm_wk is not norm_wk
+            or plan.cos_sin_cache is not cos_sin_cache
+        ):
+            plan = plan._replace(
+                norm_wq=norm_wq, norm_wk=norm_wk, cos_sin_cache=cos_sin_cache
+            )
+            projection._esimd_qkv_postprocess_plan = plan
+
+        if sycl_backend:
+            stream = torch.xpu.current_stream(device=qkv.device)
+            stream_key = (qkv.device, stream, 1 if rows == 1 else 64)
+            buffers_by_stream = getattr(
+                projection, "_sycl_qkv_decode_buffers_by_stream", None
+            )
+            if buffers_by_stream is None:
+                buffers_by_stream = {}
+                projection._sycl_qkv_decode_buffers_by_stream = buffers_by_stream
+            buffers = buffers_by_stream.get(stream_key)
+        else:
+            buffers = getattr(projection, "_esimd_qkv_decode_buffers", None)
+        if (
+            buffers is None
+            or buffers[0].shape[0] < rows
+            or (
+                sycl_backend
+                and (
+                    buffers[0].shape[1] != plan.q_size
+                    or buffers[1].shape[1] != plan.kv_size
+                )
+            )
+        ):
+            capacity = 1 if rows == 1 else 64
+            buffers = (
+                torch.empty(
+                    (capacity, plan.q_size),
+                    dtype=torch.float16,
+                    device=qkv.device,
+                ),
+                torch.empty(
+                    (capacity, plan.kv_size),
+                    dtype=torch.float16,
+                    device=qkv.device,
+                ),
+                torch.empty(
+                    (capacity, plan.kv_size),
+                    dtype=torch.float16,
+                    device=qkv.device,
+                ),
+                torch.empty(
+                    (capacity, plan.q_size),
+                    dtype=torch.float16,
+                    device=qkv.device,
+                ),
+            )
+            if sycl_backend:
+                assert buffers_by_stream is not None
+                buffers_by_stream[stream_key] = buffers
+            else:
+                projection._esimd_qkv_decode_buffers = buffers
+        q, k, v, gate_buffer = (buffer[:rows] for buffer in buffers)
+        gate = gate_buffer if plan.attn_output_gate else None
+        gate_out = gate
+        if gate_out is None:
+            gate_out = gate_buffer
+        positions_i32 = plain_positions.to(dtype=torch.int32).contiguous()
+
+        try:
+            plan.op(
+                qkv,
+                q,
+                gate_out,
+                k,
+                v,
+                plan.norm_wq,
+                plan.norm_wk,
+                positions_i32,
+                plan.q_heads,
+                plan.kv_heads,
+                plan.attn_output_gate,
+                plan.rotary_dim,
+                plan.cos_sin_cache,
+                **({"positions_bounds_proven": True} if sycl_backend else {}),
+            )
+        except (AttributeError, RuntimeError, TypeError):
+            if sycl_backend:
+                raise  # Never replay a fallback after a native submit.
+            return None
+        return Qwen3NextQkvPostprocessResult(q, k, v, gate)
+
+    def try_mrope_postprocess(
+        self,
+        qkv: torch.Tensor,
+        positions: torch.Tensor,
+        *,
+        projection: Any,
+        norm_wq: torch.Tensor,
+        norm_wk: torch.Tensor,
+        cos_sin_cache: torch.Tensor,
+        q_heads: int,
+        kv_heads: int,
+        head_dim: int,
+        rotary_dim: int,
+        norm_epsilon: float,
+        mrope_section: tuple[int, int, int],
+        mrope_interleaved: bool,
+        attn_output_gate: bool,
+        positions_bounds_proven: bool = False,
+    ) -> Qwen3NextQkvPostprocessResult | None:
+        """Try the exact Qwen3.8 three-axis MRoPE postprocess ABI.
+
+        Unlike the plain/text helper above, this path consumes all three
+        position rows in the native kernel.  It is intentionally narrow and
+        returns ``None`` before submission for unsupported configurations.
+        ``positions_bounds_proven`` must come from CPU scheduler metadata for
+        the exact positions submitted to this call.
+        """
+        projection = _get_base_layer_for_no_lora(projection)
+        if projection is None:
+            return None
+        if (
+            _DISABLE_ESIMD_QKV
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not _direct_parameters(qkv, positions, norm_wq, norm_wk, cos_sin_cache)
+        ):
+            return None
+        plan = getattr(projection, "_esimd_qkv_mrope_postprocess_plan", None)
+        if not isinstance(plan, _QkvPostprocessPlan):
+            plan = None
+        if plan is not None and (
+            getattr(projection, "_esimd_qkv_mrope_plan_signature", None)
+            != _qkv_plan_signature(projection)
+            or _tensor_storage_signature(plan.norm_wq)
+            != _tensor_storage_signature(norm_wq)
+            or _tensor_storage_signature(plan.norm_wk)
+            != _tensor_storage_signature(norm_wk)
+            or _tensor_storage_signature(plan.cos_sin_cache)
+            != _tensor_storage_signature(cos_sin_cache)
+        ):
+            plan = None
+        rows = qkv.shape[0] if qkv.ndim == 2 else 0
+        expected_width = q_heads * head_dim * 2 + kv_heads * head_dim * 2
+        # Keep these checks outside the cached-plan branch.  A plan only caches
+        # immutable projection metadata; every call still owns its qkv tensor
+        # and must prove that the submitted pointers use the native ABI.
+        if (
+            qkv.device.type != "xpu"
+            or qkv.dtype != torch.float16
+            or not qkv.is_contiguous()
+            or any(
+                tensor.device != qkv.device
+                or tensor.dtype != torch.float16
+                or not tensor.is_contiguous()
+                for tensor in (norm_wq, norm_wk, cos_sin_cache)
+            )
+            # These checks must run on every call, including a cached plan.
+            # The caller can resize or otherwise mutate a Tensor object in
+            # place, so comparing a plan against that same object is not a
+            # sufficient ABI revalidation.
+            or norm_wq.shape != (head_dim,)
+            or norm_wk.shape != (head_dim,)
+            or cos_sin_cache.ndim != 2
+            or cos_sin_cache.shape[1] != rotary_dim
+            or cos_sin_cache.shape[0] == 0
+            or not 1 <= rows <= 64
+            or qkv.shape != (rows, expected_width)
+            or positions.shape != (3, rows)
+            or positions.dtype not in (torch.int32, torch.int64)
+            or positions.device != qkv.device
+            or positions.stride(1) != 1
+            or not 1 <= positions.stride(0) <= 2**32 - 1
+            or positions.stride(0) < rows
+            or positions.stride(0) > (2**32 - 1 - (rows - 1)) // 2
+            or q_heads
+            not in (
+                (3, 6)
+                if envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+                else (3,)
+            )
+            or kv_heads != 1
+            or head_dim != 256
+            or rotary_dim != 64
+            or norm_epsilon != 1e-6
+            or mrope_section != (11, 11, 10)
+            or not mrope_interleaved
+            or not attn_output_gate
+            or not positions_bounds_proven
+        ):
+            return None
+        if plan is None:
+            quant_method = getattr(projection, "quant_method", None)
+            is_sym_int4 = getattr(quant_method, "is_sym_int4", False)
+            weight = getattr(projection, "weight", None)
+            weight_scale = getattr(projection, "weight_scale", None)
+            weight_scale_inv = getattr(projection, "weight_scale_inv", None)
+            weight_block_size = getattr(projection, "weight_block_size", None)
+            is_runtime_fp8 = (
+                isinstance(weight, torch.Tensor)
+                and weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+                and isinstance(weight_scale, torch.Tensor)
+                and weight_scale.numel() == 1
+            )
+            is_block_fp8 = (
+                isinstance(weight, torch.Tensor)
+                and weight.dtype == torch.float8_e4m3fn
+                and isinstance(weight_scale_inv, torch.Tensor)
+                and weight_scale_inv.dtype == torch.float32
+                and tuple(weight_block_size or ()) == (128, 128)
+            )
+            if not (is_sym_int4 or is_runtime_fp8 or is_block_fp8):
+                return None
+            module = self._get_module()
+            if module is None:
+                raise RuntimeError(
+                    "Qwen3.8 QKV MRoPE native DSO is unavailable after enable"
+                )
+            op = getattr(module, "esimd_qkv_split_norm_rope_mrope_v1", None)
+            if not callable(op):
+                raise RuntimeError("Qwen3.8 QKV MRoPE native ABI symbol is unavailable")
+            plan = _QkvPostprocessPlan(
+                op=op,
+                q_size=q_heads * head_dim,
+                kv_size=kv_heads * head_dim,
+                expected_width=expected_width,
+                norm_wq=norm_wq,
+                norm_wk=norm_wk,
+                cos_sin_cache=cos_sin_cache,
+                q_heads=q_heads,
+                kv_heads=kv_heads,
+                rotary_dim=rotary_dim,
+                attn_output_gate=attn_output_gate,
+            )
+            projection._esimd_qkv_mrope_postprocess_plan = plan
+            projection._esimd_qkv_mrope_plan_signature = _qkv_plan_signature(projection)
+        elif qkv.shape != (rows, plan.expected_width):
+            return None
+
+        stream = torch.xpu.current_stream(device=qkv.device)
+        stream_key = (qkv.device, stream, 1 if rows == 1 else 64)
+        buffers_by_stream = getattr(
+            projection, "_esimd_qkv_mrope_decode_buffers_by_stream", None
+        )
+        if buffers_by_stream is None:
+            buffers_by_stream = {}
+            projection._esimd_qkv_mrope_decode_buffers_by_stream = buffers_by_stream
+        buffers = buffers_by_stream.get(stream_key)
+        if buffers is None or buffers[0].shape[0] < rows:
+            capacity = 1 if rows == 1 else 64
+            buffers = (
+                torch.empty(
+                    (capacity, plan.q_size), dtype=torch.float16, device=qkv.device
+                ),
+                torch.empty(
+                    (capacity, plan.kv_size), dtype=torch.float16, device=qkv.device
+                ),
+                torch.empty(
+                    (capacity, plan.kv_size), dtype=torch.float16, device=qkv.device
+                ),
+                torch.empty(
+                    (capacity, plan.q_size), dtype=torch.float16, device=qkv.device
+                ),
+            )
+            buffers_by_stream[stream_key] = buffers
+        q, k, v, gate = (buffer[:rows] for buffer in buffers)
+        returned = plan.op(
+            qkv,
+            q,
+            gate,
+            k,
+            v,
+            plan.norm_wq,
+            plan.norm_wk,
+            positions,
+            plan.q_heads,
+            plan.kv_heads,
+            plan.attn_output_gate,
+            positions_bounds_proven,
+            plan.cos_sin_cache,
+        )
+        returned_aliases_q = False
+        if isinstance(returned, torch.Tensor):
+            alias_method = getattr(returned, "is_alias_of", None)
+            returned_aliases_q = (
+                bool(alias_method(q))
+                if callable(alias_method)
+                else bool(torch._C._is_alias_of(returned, q))
+            )
+        if (
+            not isinstance(returned, torch.Tensor)
+            or returned.device != q.device
+            or returned.dtype != q.dtype
+            or returned.shape != q.shape
+            or not returned.is_contiguous()
+            or not returned_aliases_q
+            or (returned is not q and returned.data_ptr() != q.data_ptr())
+        ):
+            raise RuntimeError(
+                "Qwen3.8 QKV MRoPE returned an invalid caller-owned output ABI"
+            )
+        return Qwen3NextQkvPostprocessResult(q, k, v, gate)
+
