+}
+
+Tensor compact160_router_out(
+    Tensor x,
+    Tensor router,
+    Tensor router_scale,
+    Tensor w13,
+    Tensor s13,
+    Tensor w2,
+    Tensor s2,
+    Tensor shared_up,
+    Tensor shared_down,
+    Tensor shared_gate,
+    Tensor output,
+    int64_t top_k,
+    int64_t num_shared,
