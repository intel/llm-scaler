+    20000161ULL,
+    20000171ULL};
+constexpr std::array<uint64_t, 16> kMagic{
+    0xad7f2572edd5e756ULL,
+    0xad7f094d2dd3860cULL,
+    0xad7efb3a4f348292ULL,
+    0xad7ee7864c48f7c0ULL,
