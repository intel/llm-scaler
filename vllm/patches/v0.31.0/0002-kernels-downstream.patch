+++ b/csrc/qwen38/peer_general.cpp
@@ -0,0 +1,320 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "qwen38/peer_general_stage.h"
+
+#include <ATen/ATen.h>
+#include <c10/xpu/XPUCachingAllocator.h>
+#include <c10/xpu/XPUStream.h>
+#include <level_zero/ze_api.h>
+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+#include <sycl/ext/oneapi/backend/level_zero.hpp>
+#include <sycl/ext/oneapi/experimental/enqueue_functions.hpp>
+#include <torch/csrc/utils/pybind.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace vllm::qwen38::peer_general {
+namespace {
+constexpr int64_t kAbiVersion = 2;
+constexpr size_t kCookieOffset = kControlBytes - sizeof(uint64_t);
+template <int World>
+class PeerM1Kernel;
+
+void check_ze(ze_result_t result, const char* operation) {
+  if (result == ZE_RESULT_ERROR_OUT_OF_DEVICE_MEMORY ||
+      result == ZE_RESULT_ERROR_OUT_OF_HOST_MEMORY)
+    C10_THROW_ERROR(
+        OutOfMemoryError, c10::str(operation, " failed: ", int(result)));
+  TORCH_CHECK(result == ZE_RESULT_SUCCESS, operation, " failed: ", int(result));
+}
+
+bool supported_device() {
+  const auto stream = c10::xpu::getCurrentXPUStream();
+  const auto& q = stream.queue();
+  const auto device = q.get_device();
+  const auto subgroups = device.get_info<sycl::info::device::sub_group_sizes>();
+  return !stream.is_capturing() && q.is_in_order() &&
+         q.get_backend() == sycl::backend::ext_oneapi_level_zero &&
+         device.has(sycl::aspect::fp16) &&
+         device.get_info<sycl::info::device::name>().find("B70") !=
+             std::string::npos &&
+         device.get_info<sycl::info::device::max_work_group_size>() >= 128 &&
+         std::find(subgroups.begin(), subgroups.end(), 16) != subgroups.end();
+}
+
+class PeerWorkspace final {
+ public:
+  explicit PeerWorkspace(int rank, int world, int width)
+      : queue_(c10::xpu::getCurrentXPUStream().queue()),
+        device_(c10::xpu::current_device()),
+        rank_(rank),
+        world_(world),
+        width_(width),
+        total_bytes_(kControlBytes + 2 * world * kMaxBytes) {
+    TORCH_CHECK(
+        world == 8 && rank >= 0 && rank < world && width == 2560 &&
+            supported_device(),
+        "Qwen peer workspace requires an idle-capture B70 stream and TP8 "
+        "rank");
+    context_ = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(
+        queue_.get_context());
+    native_device_ = sycl::get_native<sycl::backend::ext_oneapi_level_zero>(
+        queue_.get_device());
+    ze_device_properties_t properties{ZE_STRUCTURE_TYPE_DEVICE_PROPERTIES};
+    check_ze(
+        zeDeviceGetProperties(native_device_, &properties),
+        "zeDeviceGetProperties");
+    std::memcpy(uuid_, properties.uuid.id, sizeof(uuid_));
+    ze_device_mem_alloc_desc_t descriptor{
+        ZE_STRUCTURE_TYPE_DEVICE_MEM_ALLOC_DESC,
+        nullptr,
+        ZE_DEVICE_MEM_ALLOC_FLAG_BIAS_UNCACHED,
+        0};
+    void* own = nullptr;
+    check_ze(
+        zeMemAllocDevice(
+            context_, &descriptor, total_bytes_, 4096, native_device_, &own),
+        "zeMemAllocDevice");
+    own_ = static_cast<char*>(own);
+    try {
+      queue_.memset(own_, 0, total_bytes_).wait_and_throw();
+      cookie_ = (uint64_t(getpid()) << 32) ^ uint64_t(uintptr_t(own_)) ^
+                0x9e3779b97f4a7c15ULL;
+      queue_.memcpy(own_ + kCookieOffset, &cookie_, sizeof(cookie_))
+          .wait_and_throw();
+    } catch (...) {
+      zeMemFree(context_, own_);
+      own_ = nullptr;
+      throw;
+    }
+  }
+
+  ~PeerWorkspace() {
+    try {
+      close();
+    } catch (...) { /* Keep mappings alive if their queue failed. */
+    }
+  }
+
+  std::vector<int64_t> export_info() {
+    std::lock_guard<std::mutex> guard(mutex_);
+    require_setup_stream();
+    if (!exported_) {
+      check_ze(zeMemGetIpcHandle(context_, own_, &ipc_), "zeMemGetIpcHandle");
+      exported_ = true;
+    }
+    std::vector<int64_t> result{
+        kAbiVersion,
+        rank_,
+        int64_t(kMaxBytes),
+        int64_t(getpid()),
+        int64_t(uint32_t(cookie_)),
+        int64_t(uint32_t(cookie_ >> 32))};
+    for (uint32_t word : uuid_)
+      result.push_back(word);
+    uint32_t words[ZE_MAX_IPC_HANDLE_SIZE / sizeof(uint32_t)];
+    std::memcpy(words, ipc_.data, sizeof(words));
+    for (uint32_t word : words)
+      result.push_back(word);
+    result.push_back(world_);
+    result.push_back(width_);
+    return result;
+  }
+
+  void open_peer(int rank, const std::vector<int64_t>& info) {
+    std::lock_guard<std::mutex> guard(mutex_);
+    require_setup_stream();
+    TORCH_CHECK(
+        rank >= 0 && rank < world_ && rank != rank_ && !peers_[rank],
+        "invalid peer rank");
+    TORCH_CHECK(
+        info.size() == 12 + ZE_MAX_IPC_HANDLE_SIZE / sizeof(uint32_t) &&
+            info[info.size() - 2] == world_ && info.back() == width_ &&
+            info[0] == kAbiVersion && info[1] == rank && info[2] == kMaxBytes,
+        "Qwen38 peer ABI or capacity mismatch");
+    uint32_t peer_uuid[4];
+    for (int i = 0; i < 4; ++i)
+      peer_uuid[i] = uint32_t(info[6 + i]);
+    TORCH_CHECK(
+        std::memcmp(peer_uuid, uuid_, sizeof(uuid_)) != 0,
+        "duplicate GPU in peer group");
+    bool accessible = false;
+    for (const auto& device :
+         queue_.get_device().get_platform().get_devices()) {
+      auto native =
+          sycl::get_native<sycl::backend::ext_oneapi_level_zero>(device);
+      ze_device_properties_t properties{ZE_STRUCTURE_TYPE_DEVICE_PROPERTIES};
+      check_ze(
+          zeDeviceGetProperties(native, &properties), "zeDeviceGetProperties");
+      if (std::memcmp(properties.uuid.id, peer_uuid, sizeof(peer_uuid)) == 0) {
+        ze_bool_t allowed = false;
+        check_ze(
+            zeDeviceCanAccessPeer(native_device_, native, &allowed),
+            "zeDeviceCanAccessPeer");
+        accessible = allowed;
+        break;
+      }
+    }
+    TORCH_CHECK(
+        accessible, "peer group requires ordinary P2P access to every rank");
+    ze_ipc_mem_handle_t handle{};
+    uint32_t words[ZE_MAX_IPC_HANDLE_SIZE / sizeof(uint32_t)];
+    for (size_t i = 0; i < sizeof(words) / sizeof(words[0]); ++i)
+      words[i] = uint32_t(info[10 + i]);
+    std::memcpy(handle.data, words, sizeof(words));
+    void* mapped = nullptr;
+    check_ze(
+        zeMemOpenIpcHandle(context_, native_device_, handle, 0, &mapped),
+        "zeMemOpenIpcHandle");
+    try {
+      uint64_t observed = 0;
+      queue_
+          .memcpy(
+              &observed,
+              static_cast<char*>(mapped) + kCookieOffset,
+              sizeof(observed))
+          .wait_and_throw();
+      const uint64_t expected =
+          uint32_t(info[4]) | (uint64_t(uint32_t(info[5])) << 32);
+      TORCH_CHECK(observed == expected, "Qwen38 peer IPC cookie mismatch");
+    } catch (...) {
+      zeMemCloseIpcHandle(context_, mapped);
+      throw;
+    }
+    peers_[rank] = static_cast<char*>(mapped);
+  }
+
+  bool try_run(at::Tensor tensor) {
+    std::lock_guard<std::mutex> guard(mutex_);
+    if (!own_ || !tensor.defined() || !tensor.is_xpu() ||
+        tensor.get_device() != device_ || tensor.layout() != at::kStrided ||
+        tensor.scalar_type() != at::kHalf || tensor.dim() != 2 ||
+        tensor.size(0) != 1 || tensor.size(1) != width_ ||
+        !tensor.is_contiguous() || tensor.is_neg() || tensor.is_conj() ||
+        tensor.requires_grad() ||
+        tensor.key_set().has(c10::DispatchKey::Python))
+      return false;
+    const auto stream = c10::xpu::getCurrentXPUStream(device_);
+    auto& q = stream.queue();
+    if (q != queue_ || !q.is_in_order()) return false;
+    auto pointer = tensor.data_ptr();
+    if (uintptr_t(pointer) % 4) return false;
+    const uintptr_t begin = uintptr_t(pointer), end = begin + width_ * 2;
+    if (overlaps(begin, end, own_)) return false;
+    for (int rank = 0; rank < world_; ++rank)
+      if (rank != rank_) {
+        if (!peers_[rank] || overlaps(begin, end, peers_[rank])) return false;
+      }
+    c10::xpu::XPUCachingAllocator::recordStream(
+        tensor.storage().data_ptr(), stream);
+    const Bindings bindings{
+        own_,
+        {peers_[0],
+         peers_[1],
+         peers_[2],
+         peers_[3],
+         peers_[4],
+         peers_[5],
+         peers_[6],
+         peers_[7]},
+        rank_};
+    auto values = static_cast<sycl::half*>(pointer);
+    const int width = width_;
+    auto submit = [&]<int World>() {
+      sycl::ext::oneapi::experimental::nd_launch<PeerM1Kernel<World>>(
+          q,
+          sycl::nd_range<1>(128, 128),
+          [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(16)]] {
+            reduce_m1<World>(item, values, values, bindings, width);
+          });
+    };
+    submit.template operator()<8>();
+    return true;
+  }
+
+  std::vector<int64_t> status() {
+    std::lock_guard<std::mutex> guard(mutex_);
+    require_setup_stream();
+    uint32_t epoch = 0, error = 0;
+    queue_
+        .memcpy(
+            &epoch,
+            reinterpret_cast<uint32_t*>(own_) + kEpochWord,
+            sizeof(epoch))
+        .wait_and_throw();
+    queue_
+        .memcpy(
+            &error,
+            reinterpret_cast<uint32_t*>(own_) + kErrorWord,
+            sizeof(error))
+        .wait_and_throw();
+    return {epoch, error};
+  }
+
+  void close() {
+    std::lock_guard<std::mutex> guard(mutex_);
+    if (!own_) return;
+    TORCH_CHECK(
+        queue_.ext_oneapi_get_state() !=
+            sycl::ext::oneapi::experimental::queue_state::recording,
+        "cannot release an IPC workspace during graph capture");
+    queue_.wait_and_throw();
+    for (auto& peer : peers_)
+      if (peer) {
+        zeMemCloseIpcHandle(context_, peer);
+        peer = nullptr;
+      }
+    if (exported_) {
+      zeMemPutIpcHandle(context_, ipc_);
+      exported_ = false;
+    }
+    zeMemFree(context_, own_);
+    own_ = nullptr;
+  }
+
+ private:
+  void require_setup_stream() const {
+    TORCH_CHECK(
+        own_ && queue_.ext_oneapi_get_state() !=
+                    sycl::ext::oneapi::experimental::queue_state::recording,
+        "IPC setup/status requires a live workspace outside graph capture");
+  }
+  bool overlaps(uintptr_t begin, uintptr_t end, const char* buffer) {
+    return begin < uintptr_t(buffer) + total_bytes_ && uintptr_t(buffer) < end;
+  }
+  sycl::queue queue_;
+  int device_, rank_;
+  ze_context_handle_t context_ = nullptr;
+  ze_device_handle_t native_device_ = nullptr;
+  char* own_ = nullptr;
+  char* peers_[8] = {};
+  ze_ipc_mem_handle_t ipc_{};
+  bool exported_ = false;
+  uint64_t cookie_ = 0;
+  uint32_t uuid_[4] = {};
+  int world_, width_;
+  size_t total_bytes_;
+  std::mutex mutex_;
+};
+}  // namespace
+}  // namespace vllm::qwen38::peer_general
