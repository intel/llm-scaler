@@ -0,0 +1,16 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <torch/types.h>
+#include <optional>
+
+namespace vllm::qwen38 {
+// Private TP8 M1 transport ABI. Packets are FP32 [1,64]; global input is eight
+// such packets in rank order. Indices must be exact integers below 2^24.
+// Eligibility misses return nullopt before submission. Python checks tensor
+// subclasses and Torch modes. Every result owns independent output storage.
+std::optional<at::Tensor> try_local_argmax_packet(
+    const at::Tensor& logits, int64_t vocab_start, int64_t num_padding);
+std::optional<at::Tensor> try_global_argmax_token(const at::Tensor& packets);
+std::optional<at::Tensor>
+try_global_argmax_token_int32(const at::Tensor& packets);
+}  // namespace vllm::qwen38
diff --git a/csrc/qwen38/hc_bindings.cpp b/csrc/qwen38/hc_bindings.cpp
new file mode 100644
index 0000000..c8bd00e
--- /dev/null
+++ b/csrc/qwen38/hc_bindings.cpp
@@ -0,0 +1,143 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <ATen/MemoryOverlap.h>
+#include <torch/library.h>
+
+#include <cstdint>
+
+#include "core/registration.h"
+#include "qwen38/hc_sycl.h"
+
+#define QWEN38_LIBRARY_FRAGMENT(NAME, MODULE) \
+  TORCH_LIBRARY_FRAGMENT(NAME, MODULE)
+
+namespace {
+
+bool hc_outputs_alias_inputs(at::TensorList outputs, at::TensorList inputs) {
+  for (const auto& output : outputs) {
+    for (const auto& input : inputs) {
+      // Retain the conservative storage-alias rule, and also reject overlap
+      // between separate Storage owners wrapping the same physical memory.
+      if (output.is_alias_of(input) ||
+          at::get_overlap_status(output, input) != at::MemOverlapStatus::No) {
+        return true;
+      }
+      const auto out_start =
+          reinterpret_cast<uintptr_t>(output.const_data_ptr());
+      const auto in_start = reinterpret_cast<uintptr_t>(input.const_data_ptr());
+      if (out_start <= in_start
+              ? in_start - out_start < output.numel() * output.element_size()
+              : out_start - in_start < input.numel() * input.element_size()) {
+        return true;
+      }
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+QWEN38_LIBRARY_FRAGMENT(TORCH_EXTENSION_NAME, m) {
+  namespace hc = vllm::qwen38::hc;
+  m.def(
+      "hc_grouped_norm_v1(Tensor input, Tensor weight, Tensor(a!) output, "
+      "float eps) -> ()");
+  m.impl("hc_grouped_norm_v1", torch::kXPU, &hc::grouped_norm);
+  for (const auto* name :
+       {"hc_gate_mix_v1", "hc_gate_mix_m4_v1", "hc_gate_mix_multi_m_v1"}) {
+    const auto schema = std::string(name) +
+                        "(Tensor input, Tensor gate, Tensor(a!) output) -> ()";
+    m.def(schema.c_str());
+    m.impl(name, torch::kXPU, &hc::gate_mix);
+  }
+  m.def(
+      "hc_combine_v1(Tensor hidden, Tensor block, Tensor injection, "
+      "Tensor(a!) output) -> ()");
+  m.impl("hc_combine_v1", torch::kXPU, &hc::combine);
+  for (const auto* name :
+       {"hc_combine_norm_v1",
+        "hc_combine_norm_m4_v1",
+        "hc_combine_norm_multi_m_v1",
+        "hc_combine_norm_multi_m_strided_v1"}) {
+    const auto schema =
+        std::string(name) +
+        "(Tensor hidden, Tensor block, Tensor injection, Tensor weight, "
+        "Tensor(a!) combined, Tensor(b!) normed, float eps) -> ()";
+    m.def(schema.c_str());
+    m.impl(name, torch::kXPU, &hc::combine_norm);
+  }
+  m.def("hc_down(Tensor input, Tensor weight, Tensor(a!) output) -> ()");
+  m.impl("hc_down", torch::kXPU, &hc::down);
+  m.def("hc_up(Tensor input, Tensor weight, Tensor(a!) output) -> ()");
+  m.impl("hc_up", torch::kXPU, &hc::up);
+  m.def(
+      "hc_up_gate_mix(Tensor lowrank, Tensor weight, Tensor normed, "
+      "Tensor(a!) output) -> ()");
+  m.impl("hc_up_gate_mix", torch::kXPU, &hc::up_gate_mix);
+  m.def(
+      "hc_prefill_grouped_norm(Tensor input, Tensor weight, "
+      "Tensor(a!) output, float eps) -> ()");
+  m.impl("hc_prefill_grouped_norm", torch::kXPU, &hc::prefill_grouped_norm);
+  m.def(
+      "hc_prefill_combine(Tensor hidden, Tensor block, Tensor injection, "
+      "Tensor(a!) output) -> ()");
+  m.impl("hc_prefill_combine", torch::kXPU, &hc::prefill_combine);
+  m.def(
+      "hc_prefill_combine_norm(Tensor hidden, Tensor block, Tensor injection, "
+      "Tensor weight, Tensor(a!) combined, Tensor(b!) normed, float eps) -> "
+      "()");
+  m.impl("hc_prefill_combine_norm", torch::kXPU, &hc::prefill_combine_norm);
+  m.def(
+      "hc_prefill_gate_mix(Tensor input, Tensor gate, Tensor(a!) output) -> "
+      "()");
+  m.impl("hc_prefill_gate_mix", torch::kXPU, &hc::prefill_gate_mix);
+  m.def(
+      "hc_outputs_alias_inputs_v1(Tensor[] outputs, Tensor[] inputs) -> bool",
+      &hc_outputs_alias_inputs);
+}
+
+// Do not let dispatcher fallbacks materialize lazy output views before the
+// native whole-transaction preflight can reject them.
+TORCH_LIBRARY_IMPL_EXPAND(TORCH_EXTENSION_NAME, Negative, m) {
+  for (const auto* name :
+       {"hc_grouped_norm_v1",
+        "hc_gate_mix_v1",
+        "hc_gate_mix_m4_v1",
+        "hc_gate_mix_multi_m_v1",
+        "hc_combine_v1",
+        "hc_combine_norm_v1",
+        "hc_combine_norm_m4_v1",
+        "hc_combine_norm_multi_m_v1",
+        "hc_combine_norm_multi_m_strided_v1",
+        "hc_down",
+        "hc_up",
+        "hc_up_gate_mix",
+        "hc_outputs_alias_inputs_v1",
+        "hc_prefill_grouped_norm",
+        "hc_prefill_combine",
+        "hc_prefill_combine_norm",
+        "hc_prefill_gate_mix"}) {
+    m.impl(name, torch::CppFunction::makeFallthrough());
+  }
+}
+TORCH_LIBRARY_IMPL_EXPAND(TORCH_EXTENSION_NAME, Conjugate, m) {
+  for (const auto* name :
+       {"hc_grouped_norm_v1",
+        "hc_gate_mix_v1",
+        "hc_gate_mix_m4_v1",
+        "hc_gate_mix_multi_m_v1",
+        "hc_combine_v1",
+        "hc_combine_norm_v1",
+        "hc_combine_norm_m4_v1",
+        "hc_combine_norm_multi_m_v1",
+        "hc_combine_norm_multi_m_strided_v1",
+        "hc_down",
+        "hc_up",
+        "hc_up_gate_mix",
+        "hc_outputs_alias_inputs_v1",
+        "hc_prefill_grouped_norm",
+        "hc_prefill_combine",
+        "hc_prefill_combine_norm",
+        "hc_prefill_gate_mix"}) {
+    m.impl(name, torch::CppFunction::makeFallthrough());
+  }
+}
diff --git a/csrc/qwen38/hc_dense_sycl.cpp b/csrc/qwen38/hc_dense_sycl.cpp
new file mode 100644
index 0000000..a4dff87
--- /dev/null
+++ b/csrc/qwen38/hc_dense_sycl.cpp
@@ -0,0 +1,953 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <ATen/MemoryOverlap.h>
+#include <c10/core/DeviceGuard.h>
+#include <c10/xpu/XPUCachingAllocator.h>
+#include <c10/xpu/XPUStream.h>
+#include <sycl/ext/oneapi/experimental/enqueue_functions.hpp>
+#include <sycl/ext/oneapi/experimental/group_load_store.hpp>
+#include <sycl/sycl.hpp>
+#include <torch/library.h>
+
+#include <cmath>
+#include <cstdint>
+#include <initializer_list>
+#include <optional>
+
+#include "core/registration.h"
+#include "../xpu/gemv/xe_2/fp8_gemv.hpp"
+
+namespace {
+using half = sycl::half;
+namespace sx = sycl::ext::oneapi::experimental;
+namespace gemv = vllm::fp8_gemv;
+constexpr int kHidden = 5120;
+constexpr int kStreams = 4;
+constexpr int kWidth = kHidden * kStreams;
+constexpr int kLocal = 512;
+constexpr int kSg = 16;
+constexpr int kGlueMaxM = 8192;
+
+void check_tensor(
+    const at::Tensor& value,
+    const at::Tensor& hidden,
+    at::IntArrayRef shape,
+    bool contiguous = true) {
+  TORCH_CHECK(
+      value.device() == hidden.device() && value.scalar_type() == at::kHalf &&
+          value.layout() == at::kStrided && value.sizes() == shape &&
+          (!contiguous || value.is_contiguous()) && !value.is_neg() &&
+          !value.is_conj(),
+      "Qwen4 HC expects same-device, dense FP16 tensors with the stated shape");
+}
+
+void check_hidden(const at::Tensor& hidden) {
+  TORCH_CHECK(
+      hidden.is_xpu() && hidden.dim() == 2 && hidden.size(0) >= 1 &&
+          hidden.size(0) <= 8,
+      "Qwen4 HC supports XPU [M,20480], M=1..8");
+  check_tensor(hidden, hidden, {hidden.size(0), kWidth});
+}
+
+// Only row-wise glue may accept prefill rows. Projection kernels retain the
+// original check_hidden(M<=8), including TP1 DPAS and small-M down/SiLU.
+void check_glue_hidden(const at::Tensor& hidden) {
+  TORCH_CHECK(
+      hidden.is_xpu() && hidden.dim() == 2 && hidden.size(0) >= 1 &&
+          hidden.size(0) <= kGlueMaxM,
+      "Qwen4 HC glue supports XPU [M,20480], M=1..8192");
+  check_tensor(hidden, hidden, {hidden.size(0), kWidth});
+}
+
+void check_disjoint(
+    std::initializer_list<const at::Tensor*> outputs,
+    std::initializer_list<const at::Tensor*> inputs) {
+  for (const auto* output : outputs) {
+    for (const auto* value : inputs) {
+      // Include the storage span for the padded injection view. Separate
+      // Storage owners can wrap overlapping physical memory as well.
+      const auto a = reinterpret_cast<uintptr_t>(output->const_data_ptr());
+      const auto b = reinterpret_cast<uintptr_t>(value->storage().data());
+      TORCH_CHECK(
+          !output->is_alias_of(*value) &&
+              (a <= b ? b - a >= output->numel() * output->element_size()
+                      : a - b >= value->storage().nbytes()),
+          "Qwen4 HC outputs must not overlap any input");
+    }
+    for (const auto* other : outputs) {
+      if (output == other) continue;
+      const auto a = reinterpret_cast<uintptr_t>(output->const_data_ptr());
+      const auto b = reinterpret_cast<uintptr_t>(other->const_data_ptr());
+      TORCH_CHECK(
+          !output->is_alias_of(*other) &&
+              (a <= b ? b - a >= output->numel() * output->element_size()
+                      : a - b >= other->numel() * other->element_size()),
+          "Qwen4 HC outputs must not overlap each other");
+    }
+  }
+}
+
+void record(
+    std::initializer_list<const at::Tensor*> tensors,
+    c10::xpu::XPUStream stream) {
+  for (const auto* value : tensors)
+    c10::xpu::XPUCachingAllocator::recordStream(
+        value->storage().data_ptr(), stream);
+}
+
+const half* data(const at::Tensor& value) {
+  return reinterpret_cast<const half*>(value.const_data_ptr<at::Half>());
+}
+half* data(at::Tensor& value) {
+  return reinterpret_cast<half*>(value.mutable_data_ptr<at::Half>());
+}
+
+template <bool Combine>
+class DenseNormKernel;
+
+template <bool Combine>
+void launch_norm(
+    sycl::queue& queue,
+    const half* hidden,
+    const half* block,
+    const half* injection,
+    int64_t injection_stride,
+    const half* weight,
+    half* combined,
+    half* normed,
+    int rows,
+    float eps) {
+  queue.submit([&](sycl::handler& handler) {
+    sycl::local_accessor<float, 1> partial(kLocal / kSg, handler);
+    handler.parallel_for<DenseNormKernel<Combine>>(
+        sycl::nd_range<1>(size_t(rows * kStreams * kLocal), kLocal),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(kSg)]] {
+          const int group = item.get_group_linear_id();
+          const int row = group / kStreams;
+          const int branch = group % kStreams;
+          const int local = item.get_local_linear_id();
+          const auto sg = item.get_sub_group();
+          const int lane = sg.get_local_linear_id();
+          const int offset = row * kWidth + branch * kHidden;
+          float scale = 0.0f;
+          if constexpr (Combine)
+            scale =
+                2.0f /
+                (1.0f + sycl::exp(
+                            -float(injection[row * injection_stride + branch]) *
+                            0.25f));
+          half values[kHidden / kLocal];
+          float sum = 0.0f;
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = local + i * kLocal;
+            half value = hidden[offset + col];
+            if constexpr (Combine) {
+              value = half(
+                  float(value) + float(block[row * kHidden + col]) * scale);
+              // The residual is materialized in FP16 before computing RMSNorm.
+              volatile uint16_t bits = sycl::bit_cast<uint16_t>(value);
+              value = sycl::bit_cast<half>(uint16_t(bits));
+              combined[offset + col] = value;
+            }
+            values[i] = value;
+            sum += float(value) * float(value);
+          }
+          const float sg_sum =
+              sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+          if (lane == 0) partial[local / kSg] = sg_sum;
+          item.barrier(sycl::access::fence_space::local_space);
+          const float total = sycl::reduce_over_group(
+              sg, partial[lane] + partial[lane + kSg], sycl::plus<float>());
+          const float inv = sycl::rsqrt(total / float(kHidden) + eps);
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = local + i * kLocal;
+            normed[offset + col] = half(
+                (float(values[i]) * inv) *
+                (1.0f + float(weight[branch * kHidden + col])));
+          }
+        });
+  });
+}
+
+void check_norm(
+    const at::Tensor& hidden,
+    const at::Tensor& weight,
+    const at::Tensor& output,
+    double eps) {
+  check_glue_hidden(hidden);
+  check_tensor(weight, hidden, {kWidth});
+  check_tensor(output, hidden, {hidden.size(0), kWidth});
+  TORCH_CHECK(
+      std::isfinite(eps) && eps > 0 && std::isfinite(float(eps)) &&
+          float(eps) > 0,
+      "Qwen4 HC eps must be positive finite FP32");
+}
+
+void grouped_norm(
+    const at::Tensor& hidden,
+    const at::Tensor& weight,
+    at::Tensor& output,
+    double eps) {
+  check_norm(hidden, weight, output, eps);
+  check_disjoint({&output}, {&hidden, &weight});
+  const c10::DeviceGuard guard(hidden.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(hidden.get_device());
+  record({&hidden, &weight, &output}, stream);
+  launch_norm<false>(
+      stream.queue(),
+      data(hidden),
+      nullptr,
+      nullptr,
+      0,
+      data(weight),
+      nullptr,
+      data(output),
+      hidden.size(0),
+      eps);
+}
+
+void combine_norm(
+    const at::Tensor& hidden,
+    const at::Tensor& block,
+    const at::Tensor& injection,
+    const at::Tensor& weight,
+    at::Tensor& combined,
+    at::Tensor& normed,
+    double eps) {
+  check_norm(hidden, weight, normed, eps);
+  check_tensor(combined, hidden, {hidden.size(0), kWidth});
+  check_tensor(block, hidden, {hidden.size(0), kHidden});
+  check_tensor(injection, hidden, {hidden.size(0), kStreams}, false);
+  TORCH_CHECK(
+      injection.stride(1) == 1 && injection.stride(0) >= kStreams,
+      "Qwen4 HC injection must have nonoverlapping rows and unit inner stride");
+  check_disjoint({&combined, &normed}, {&hidden, &block, &injection, &weight});
+  const c10::DeviceGuard guard(hidden.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(hidden.get_device());
+  record({&hidden, &block, &injection, &weight, &combined, &normed}, stream);
+  launch_norm<true>(
+      stream.queue(),
+      data(hidden),
+      data(block),
+      data(injection),
+      injection.stride(0),
+      data(weight),
+      data(combined),
+      data(normed),
+      hidden.size(0),
+      eps);
+}
+
+constexpr int kDenseRank = 320;
+constexpr int kDownSplits = 40;
+constexpr auto kDownLoad = sx::properties{
+    sx::data_placement_striped,
+    sx::contiguous_memory,
+    sx::full_group,
+    sx::alignment<4>};
+
+sycl::vec<half, 16> load_down(sycl::sub_group sg, const half* ptr) {
+  sycl::vec<uint32_t, 8> packed;
+  auto global =
+      sycl::address_space_cast<
+          sycl::access::address_space::global_space,
+          sycl::access::decorated::yes>(reinterpret_cast<const uint32_t*>(ptr))
+          .get_decorated();
+  sx::group_load(sg, global, packed, kDownLoad);
+  return sycl::bit_cast<sycl::vec<half, 16>>(packed);
+}
+
+struct DenseDownSiluKernel {
+  const half* input;
+  const half* weight;
+  half* output;
+
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> item) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+        float[kDownSplits]>(item.get_group());
+    const auto sg = item.get_sub_group();
+    const int row = item.get_group(0);
+    const int split = item.get_local_id(0) / kSg;
+    static_assert(kWidth == 2 * kDownSplits * 256);
+    const int col = split * 256;
+    const auto w0 = load_down(sg, weight + int64_t(row) * kWidth + col);
+    const auto w1 =
+        load_down(sg, weight + int64_t(row) * kWidth + col + kWidth / 2);
+    const auto x0 = load_down(sg, input + col);
+    const auto x1 = load_down(sg, input + col + kWidth / 2);
+    float acc[16];
+  #pragma unroll
+    for (int i = 0; i < 16; ++i) {
+      acc[i] = sycl::fma(float(x0[i]), float(w0[i]), 0.0f);
+      acc[i] = sycl::fma(float(x1[i]), float(w1[i]), acc[i]);
+    }
+    float sum = 0;
+  #pragma unroll
+    for (int i = 0; i < 16; ++i)
+      sum += acc[i];
+    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+    if (sg.get_local_id()[0] == 0) partial[split] = sum;
+    item.barrier(sycl::access::fence_space::local_space);
+    if (item.get_local_id(0) == 0) {
+      sum = 0;
+  #pragma unroll
+      for (int i = 0; i < kDownSplits; ++i)
+        sum += partial[i];
+      half value = half(sum);
+      if (row < kDenseRank) {
+        // Match linear -> FP16 -> divide by four -> FP16 -> SiLU -> FP16.
+        volatile uint16_t bits = sycl::bit_cast<uint16_t>(value);
+        const half scaled =
+            half(float(sycl::bit_cast<half>(uint16_t(bits))) * 0.25f);
+        volatile uint16_t scaled_bits = sycl::bit_cast<uint16_t>(scaled);
+        const float z = float(sycl::bit_cast<half>(uint16_t(scaled_bits)));
+        value = half(z / (1.0f + sycl::exp(-z)));
+      }
+      output[row] = value;
+    }
+#endif
+  }
+};
+
+void down_silu(
+    const at::Tensor& input, const at::Tensor& weight, at::Tensor& output) {
+  check_hidden(input);
+  TORCH_CHECK(input.size(0) == 1, "Qwen4 HC down supports one decode token");
+  TORCH_CHECK(
+      weight.dim() == 2 &&
+          (weight.size(0) == kDenseRank || weight.size(0) == kDenseRank + 16),
+      "Qwen4 HC down expects 320 or 336 weight rows");
+  check_tensor(weight, input, {weight.size(0), kWidth});
+  // The merged projection consumes 320 low-rank and four injection rows;
+  // twelve checkpoint alignment rows need no computation or output storage.
+  const int rows = weight.size(0) == kDenseRank ? kDenseRank : kDenseRank + 4;
+  check_tensor(output, input, {1, rows});
+  TORCH_CHECK(
+      reinterpret_cast<uintptr_t>(input.const_data_ptr()) % 4 == 0 &&
+          reinterpret_cast<uintptr_t>(weight.const_data_ptr()) % 4 == 0,
+      "Qwen4 HC down inputs must be four-byte aligned");
+  check_disjoint({&output}, {&input, &weight});
+  const c10::DeviceGuard guard(input.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(input.get_device());
+  record({&input, &weight, &output}, stream);
+  sx::nd_launch(
+      stream.queue(),
+      sycl::nd_range<1>(size_t(rows * kDownSplits * kSg), kDownSplits * kSg),
+      DenseDownSiluKernel{data(input), data(weight), data(output)});
+}
+
+template <int MP, int KS>
+struct DenseDownDpasKernel {
+  const half *x, *w;
+  half* out;
+  int m, n, k, rows;
+  bool silu;
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> it) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+        float[KS * MP * kSg]>(it.get_group());
+    auto sg = it.get_sub_group();
+    int lane = sg.get_local_linear_id(), ks = sg.get_group_linear_id();
+    int nb = it.get_group(0) * kSg;
+    using D = gemv::Dpas<MP, half>;
+    typename D::C c;
+  #pragma unroll
+    for (int i = 0; i < MP; i++)
+      gemv::vset<MP>(c, i, 0.f);
+    for (int kb = ks * 16; kb < k; kb += KS * 16) {
+      cute::intel::int8 b{};
+      cute::intel::coord_t co = {kb / 2, nb};
+      cute::detail::XeSubgroup2DBlockLoadTranspose<4, 8, 16, 1>{}(
+          w, k * 2, rows, k * 2, co, &b);
+      typename D::A a;
+      cute::intel::coord_t ac = {kb, 0};
+      cute::detail::XeSubgroup2DBlockLoad<2, 16, MP, 1>{}(
+          x, k * 2, m, k * 2, ac, &a);
+      D::mma(c, a, b);
+    }
+  #pragma unroll
+    for (int i = 0; i < MP; i++)
+      partial[(ks * MP + i) * kSg + lane] = gemv::vget<MP>(c, i);
+    sycl::group_barrier(it.get_group());
+    if (nb + lane < rows)
+      for (int i = ks; i < m; i += KS) {
+        float sum = 0.f;
+  #pragma unroll
+        for (int s = 0; s < KS; s++)
+          sum += partial[(s * MP + i) * kSg + lane];
+        half value = half(sum);
+        if (silu && nb + lane < 320) {
+          volatile uint16_t bits = sycl::bit_cast<uint16_t>(value);
+          const half scaled =
+              half(float(sycl::bit_cast<half>(uint16_t(bits))) * .25f);
+          volatile uint16_t sbits = sycl::bit_cast<uint16_t>(scaled);
+          float z = float(sycl::bit_cast<half>(uint16_t(sbits)));
+          value = half(z / (1.f + sycl::exp(-z)));
+        }
+        out[int64_t(i) * rows + nb + lane] = value;
+      }
+#endif
+  }
+};
+template <int MP, int KS>
+struct DenseDownVectorKernel {
+  const half *x, *w;
+  half* out;
+  int m, rows;
+  bool silu;
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> it) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    auto* partial =
+        *sycl::ext::oneapi::group_local_memory_for_overwrite<float[KS * MP]>(
+            it.get_group());
+    auto sg = it.get_sub_group();
+    int split = sg.get_group_linear_id(), row = it.get_group(0),
+        lane = sg.get_local_linear_id();
+    constexpr int K = 20480;
+    float acc[MP] = {};
+    for (int kb = split * 256; kb < K; kb += KS * 256) {
+      auto load = [&](const half* p) {
+        sycl::vec<uint32_t, 8> u;
+        auto g = sycl::address_space_cast<
+                     sycl::access::address_space::global_space,
+                     sycl::access::decorated::yes>(
+                     reinterpret_cast<const uint32_t*>(p))
+                     .get_decorated();
+        sycl::ext::oneapi::experimental::group_load(
+            sg,
+            g,
+            u,
+            sycl::ext::oneapi::experimental::properties{
+                sycl::ext::oneapi::experimental::data_placement_striped,
+                sycl::ext::oneapi::experimental::contiguous_memory,
+                sycl::ext::oneapi::experimental::full_group,
+                sycl::ext::oneapi::experimental::alignment<4>});
+        return sycl::bit_cast<sycl::vec<half, 16>>(u);
+      };
+      auto wv = load(w + int64_t(row) * K + kb);
+  #pragma unroll
+      for (int i = 0; i < MP; i++)
+        if (i < m) {
+          auto xv = load(x + int64_t(i) * K + kb);
+  #pragma unroll
+          for (int j = 0; j < 16; j++)
+            acc[i] = sycl::fma(float(wv[j]), float(xv[j]), acc[i]);
+        }
+    }
+  #pragma unroll
+    for (int i = 0; i < MP; i++) {
+      float sum = sycl::reduce_over_group(sg, acc[i], sycl::plus<float>());
+      if (lane == 0) partial[split * MP + i] = sum;
+    }
+    sycl::group_barrier(it.get_group());
+    if (it.get_local_id(0) == 0)
+      for (int i = 0; i < m; i++) {
+        float sum = 0.f;
+  #pragma unroll
+        for (int s = 0; s < KS; s++)
+          sum += partial[s * MP + i];
+        half value = half(sum);
+        if (silu && row < 320) {
+          volatile uint16_t bits = sycl::bit_cast<uint16_t>(value);
+          const half scaled =
+              half(float(sycl::bit_cast<half>(uint16_t(bits))) * .25f);
+          volatile uint16_t sbits = sycl::bit_cast<uint16_t>(scaled);
+          float z = float(sycl::bit_cast<half>(uint16_t(sbits)));
+          value = half(z / (1.f + sycl::exp(-z)));
+        }
+        out[int64_t(i) * rows + row] = value;
+      }
+#endif
+  }
+};
+
+void down_silu_smallm(
+    const at::Tensor& input, const at::Tensor& weight, at::Tensor& output) {
+  check_hidden(input);
+  TORCH_CHECK(input.size(0) >= 2, "Qwen4 HC small-M down expects M=2..8");
+  TORCH_CHECK(
+      weight.dim() == 2 &&
+          (weight.size(0) == kDenseRank || weight.size(0) == kDenseRank + 16),
+      "Qwen4 HC down expects 320 or 336 weight rows");
+  check_tensor(weight, input, {weight.size(0), kWidth});
+  const int m = input.size(0);
+  const int rows = weight.size(0) == kDenseRank ? kDenseRank : kDenseRank + 4;
+  check_tensor(output, input, {m, rows});
+  const uintptr_t alignment = m == 2 ? 4 : 64;
+  TORCH_CHECK(
+      reinterpret_cast<uintptr_t>(input.const_data_ptr()) % alignment == 0 &&
+          reinterpret_cast<uintptr_t>(weight.const_data_ptr()) % alignment == 0,
+      "Qwen4 HC down inputs do not meet block-load alignment");
+  check_disjoint({&output}, {&input, &weight});
+  const c10::DeviceGuard guard(input.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(input.get_device());
+  record({&input, &weight, &output}, stream);
+  if (m == 2) {
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(rows * 20 * kSg), 20 * kSg),
+        DenseDownVectorKernel<2, 20>{
+            data(input), data(weight), data(output), m, rows, true});
+  } else {
+    auto launch = [&]<int MP>() {
+      sx::nd_launch(
+          stream.queue(),
+          sycl::nd_range<1>(size_t(((rows + 15) / 16) * 31 * kSg), 31 * kSg),
+          DenseDownDpasKernel<MP, 31>{
+              data(input),
+              data(weight),
+              data(output),
+              m,
+              int(weight.size(0)),
+              kWidth,
+              rows,
+              true});
+    };
+    if (m <= 4)
+      launch.template operator()<4>();
+    else
+      launch.template operator()<8>();
+  }
+}
+
+namespace dense_tp1 {
+constexpr int kRank = 640;
+inline sycl::vec<half, 16> load(sycl::sub_group sg, const half* ptr) {
+  sycl::vec<uint32_t, 8> packed;
+  auto global =
+      sycl::address_space_cast<
+          sycl::access::address_space::global_space,
+          sycl::access::decorated::yes>(reinterpret_cast<const uint32_t*>(ptr))
+          .get_decorated();
+  sx::group_load(
+      sg,
+      global,
+      packed,
+      sx::properties{
+          sx::data_placement_striped,
+          sx::contiguous_memory,
+          sx::full_group,
+          sx::alignment<4>});
+  return sycl::bit_cast<sycl::vec<half, 16>>(packed);
+}
+
+inline void store(float sum, int token, int row, half* low, half* injection) {
+  half value = half(sum);
+  if (row < kRank) {
+    volatile uint16_t bits = sycl::bit_cast<uint16_t>(value);
+    const half scaled =
+        half(float(sycl::bit_cast<half>(uint16_t(bits))) * 0.25f);
+    volatile uint16_t scaled_bits = sycl::bit_cast<uint16_t>(scaled);
+    const float z = float(sycl::bit_cast<half>(uint16_t(scaled_bits)));
+    low[token * kRank + row] = half(z / (1.0f + sycl::exp(-z)));
+  } else {
+    injection[token * 4 + row - kRank] = value;
+  }
+}
+
+template <int MP, int KS>
+struct DownDpas {
+  const half* x;
+  const half* w;
+  half* low;
+  half* injection;
+  int m;
+  int rows;
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> it) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+        float[KS * MP * kSg]>(it.get_group());
+    const auto sg = it.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int split = sg.get_group_linear_id();
+    const int nb = it.get_group(0) * kSg;
+    using D = gemv::Dpas<MP, half>;
+    typename D::C acc;
+  #pragma unroll
+    for (int token = 0; token < MP; ++token)
+      gemv::vset<MP>(acc, token, 0.0f);
+    for (int kb = split * 16; kb < kWidth; kb += KS * 16) {
+      cute::intel::int8 b{};
+      const cute::intel::coord_t wc = {kb / 2, nb};
+      cute::detail::XeSubgroup2DBlockLoadTranspose<4, 8, 16, 1>{}(
+          w, kWidth * 2, rows, kWidth * 2, wc, &b);
+      typename D::A a;
+      const cute::intel::coord_t xc = {kb, 0};
+      cute::detail::XeSubgroup2DBlockLoad<2, 16, MP, 1>{}(
+          x, kWidth * 2, m, kWidth * 2, xc, &a);
+      D::mma(acc, a, b);
+    }
+  #pragma unroll
+    for (int token = 0; token < MP; ++token)
+      partial[(split * MP + token) * kSg + lane] = gemv::vget<MP>(acc, token);
+    sycl::group_barrier(it.get_group());
+    if (nb + lane < rows)
+      for (int token = split; token < m; token += KS) {
+        float sum = 0.0f;
+  #pragma unroll
+        for (int s = 0; s < KS; ++s)
+          sum += partial[(s * MP + token) * kSg + lane];
+        store(sum, token, nb + lane, low, injection);
+      }
+#endif
+  }
+};
+
+template <int MP, int KS>
+struct DownVector {
+  const half* x;
+  const half* w;
+  half* low;
+  half* injection;
+  int m;
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> it) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    auto* partial =
+        *sycl::ext::oneapi::group_local_memory_for_overwrite<float[KS * MP]>(
+            it.get_group());
+    const auto sg = it.get_sub_group();
+    const int split = sg.get_group_linear_id();
+    const int row = it.get_group(0);
+    const int lane = sg.get_local_linear_id();
+    float acc[MP] = {};
+    for (int kb = split * 256; kb < kWidth; kb += KS * 256) {
+      const auto weights = load(sg, w + int64_t(row) * kWidth + kb);
+  #pragma unroll
+      for (int token = 0; token < MP; ++token)
+        if (token < m) {
+          const auto values = load(sg, x + int64_t(token) * kWidth + kb);
+  #pragma unroll
+          for (int i = 0; i < 16; ++i)
+            acc[token] =
+                sycl::fma(float(weights[i]), float(values[i]), acc[token]);
+        }
+    }
+  #pragma unroll
+    for (int token = 0; token < MP; ++token) {
+      const float sum =
+          sycl::reduce_over_group(sg, acc[token], sycl::plus<float>());
+      if (lane == 0) partial[split * MP + token] = sum;
+    }
+    sycl::group_barrier(it.get_group());
+    if (it.get_local_id(0) == 0)
+      for (int token = 0; token < m; ++token) {
+        float sum = 0.0f;
+  #pragma unroll
+        for (int s = 0; s < KS; ++s)
+          sum += partial[s * MP + token];
+        store(sum, token, row, low, injection);
+      }
+#endif
+  }
+};
+
+struct DownM1 {
+  const half* x;
+  const half* w;
+  half* low;
+  half* injection;
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> it) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    constexpr int KS = 40;
+    auto* partial =
+        *sycl::ext::oneapi::group_local_memory_for_overwrite<float[KS]>(
+            it.get_group());
+    const auto sg = it.get_sub_group();
+    const int row = it.get_group(0);
+    const int split = it.get_local_id(0) / kSg;
+    const int col = split * 256;
+    const auto w0 = load(sg, w + int64_t(row) * kWidth + col);
+    const auto w1 = load(sg, w + int64_t(row) * kWidth + col + kWidth / 2);
+    const auto x0 = load(sg, x + col);
+    const auto x1 = load(sg, x + col + kWidth / 2);
+    float acc[16];
+  #pragma unroll
+    for (int i = 0; i < 16; ++i) {
+      acc[i] = sycl::fma(float(x0[i]), float(w0[i]), 0.0f);
+      acc[i] = sycl::fma(float(x1[i]), float(w1[i]), acc[i]);
+    }
+    float sum = 0.0f;
+  #pragma unroll
+    for (int i = 0; i < 16; ++i)
+      sum += acc[i];
+    sum = sycl::reduce_over_group(sg, sum, sycl::plus<float>());
+    if (sg.get_local_linear_id() == 0) partial[split] = sum;
+    it.barrier(sycl::access::fence_space::local_space);
+    if (it.get_local_id(0) == 0) {
+      sum = 0.0f;
+  #pragma unroll
+      for (int s = 0; s < KS; ++s)
+        sum += partial[s];
+      store(sum, 0, row, low, injection);
+    }
+#endif
+  }
+};
+
+inline float round_gate(float value) {
+  // GEMM先舍入至FP16，再使用FP32 sigmoid；禁止折叠舍入边界。
+  const half rounded = half(value);
+  volatile uint16_t bits = sycl::bit_cast<uint16_t>(rounded);
+  return float(sycl::bit_cast<half>(uint16_t(bits)));
+}
+
+template <int MP, int KS>
+struct UpGateKernel {
+  const half* input;
+  const half* weight;
+  const half* normed;
+  half* output;
+  int m;
+
+  [[sycl::reqd_sub_group_size(kSg)]] void
+  operator()(sycl::nd_item<1> item) const {
+#ifdef __SYCL_DEVICE_ONLY__
+    using D = gemv::Dpas<MP, half>;
+    auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+        float[kStreams * KS * MP * kSg]>(item.get_group());
+    const auto sg = item.get_sub_group();
+    const int lane = sg.get_local_linear_id();
+    const int subgroup = sg.get_group_linear_id();
+    const int branch = subgroup / KS;
+    const int split = subgroup % KS;
+    const int feature = item.get_group(0) * kSg;
+    typename D::C sums;
+  #pragma unroll
+    for (int row = 0; row < MP; ++row)
+      gemv::vset<MP>(sums, row, 0.0f);
+    for (int kb = split * 16; kb < kRank; kb += KS * 16) {
+      typename D::A a;
+      const cute::intel::coord_t a_coord = {kb, 0};
+      cute::detail::XeSubgroup2DBlockLoad<2, 16, MP, 1>{}(
+          input, kRank * 2, m, kRank * 2, a_coord, &a);
+      cute::intel::int8 b{};
+      const cute::intel::coord_t b_coord = {kb / 2, branch * kHidden + feature};
+      cute::detail::XeSubgroup2DBlockLoadTranspose<4, 8, 16, 1>{}(
+          weight, kRank * 2, kWidth, kRank * 2, b_coord, &b);
+      D::mma(sums, a, b);
+    }
+  #pragma unroll
+    for (int row = 0; row < MP; ++row)
+      partial[((branch * KS + split) * MP + row) * kSg + lane] =
+          gemv::vget<MP>(sums, row);
+    sycl::group_barrier(item.get_group());
+    for (int row = subgroup; row < m; row += kStreams * KS) {
+      float mixed = 0.0f;
+  #pragma unroll
+      for (int stream = 0; stream < kStreams; ++stream) {
+        float sum = 0.0f;
+  #pragma unroll
+        for (int s = 0; s < KS; ++s)
+          sum += partial[((stream * KS + s) * MP + row) * kSg + lane];
+        const float gate = round_gate(sum);
+        const int offset = row * kWidth + stream * kHidden + feature + lane;
+        const float sigmoid = 1.0f / (1.0f + sycl::exp(-gate));
+        mixed += float(normed[offset]) * sigmoid;
+      }
+      output[row * kHidden + feature + lane] = half(mixed * 0.25f);
+    }
+#endif
+  }
+};
+
+void down_silu(
+    const at::Tensor& input,
+    const at::Tensor& weight,
+    at::Tensor& low,
+    std::optional<at::Tensor> injection) {
+  check_hidden(input);
+  const int m = input.size(0);
+  TORCH_CHECK(
+      weight.dim() == 2 &&
+          (weight.size(0) == kRank || weight.size(0) == kRank + 16),
+      "Qwen4 TP1 HC down expects 640 or 656 weight rows");
+  check_tensor(weight, input, {weight.size(0), kWidth});
+  check_tensor(low, input, {m, kRank});
+  const bool merged = weight.size(0) != kRank;
+  TORCH_CHECK(
+      injection.has_value() == merged,
+      "Qwen4 TP1 HC injection output mismatch");
+  if (merged) {
+    check_tensor(*injection, input, {m, 4});
+    check_disjoint({&low, &*injection}, {&input, &weight});
+  } else {
+    check_disjoint({&low}, {&input, &weight});
+  }
+  const int alignment = m >= 5 ? 64 : 4;
+  TORCH_CHECK(
+      reinterpret_cast<uintptr_t>(input.const_data_ptr()) % alignment == 0 &&
+          reinterpret_cast<uintptr_t>(weight.const_data_ptr()) % alignment == 0,
+      "Qwen4 TP1 HC down inputs violate block-load alignment");
+  const c10::DeviceGuard guard(input.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(input.get_device());
+  TORCH_CHECK(
+      stream.queue().is_in_order(),
+      "Qwen4 TP1 HC down requires in-order stream");
+  record({&input, &weight, &low}, stream);
+  if (merged) record({&*injection}, stream);
+  const auto* x = data(input);
+  const auto* w = data(weight);
+  auto* output = data(low);
+  auto* inj = merged ? data(*injection) : nullptr;
+  // The physical checkpoint has 12 alignment rows after injection. They are
+  // excluded from the load surface and output; low stays contiguous [M,640].
+  const int rows = kRank + (merged ? 4 : 0);
+  if (m == 1) {
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(rows * 40 * kSg), 40 * kSg),
+        DownM1{x, w, output, inj});
+  } else if (m == 2) {
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(rows * 40 * kSg), 40 * kSg),
+        DownVector<2, 40>{x, w, output, inj, m});
+  } else if (m <= 4) {
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(rows * 20 * kSg), 20 * kSg),
+        DownVector<4, 20>{x, w, output, inj, m});
+  } else {
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(((rows + 15) / 16) * 20 * kSg), 20 * kSg),
+        DownDpas<8, 20>{x, w, output, inj, m, rows});
+  }
+}
+
+void up_gate_mix(
+    const at::Tensor& input,
+    const at::Tensor& weight,
+    const at::Tensor& normed,
+    at::Tensor& output) {
+  check_hidden(normed);
+  const int m = normed.size(0);
+  check_tensor(input, normed, {m, kRank});
+  check_tensor(weight, normed, {kWidth, kRank});
+  check_tensor(output, normed, {m, kHidden});
+  TORCH_CHECK(
+      reinterpret_cast<uintptr_t>(input.const_data_ptr()) % 64 == 0 &&
+          reinterpret_cast<uintptr_t>(weight.const_data_ptr()) % 64 == 0,
+      "Qwen4 TP1 HC up requires 64-byte aligned block-load inputs");
+  check_disjoint({&output}, {&input, &weight, &normed});
+  const c10::DeviceGuard guard(input.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(input.get_device());
+  TORCH_CHECK(
+      stream.queue().is_in_order(), "Qwen4 TP1 HC up requires in-order stream");
+  record({&input, &weight, &normed, &output}, stream);
+  auto launch = [&]<int MP, int KS>() {
+    constexpr int local = kStreams * KS * kSg;
+    sx::nd_launch(
+        stream.queue(),
+        sycl::nd_range<1>(size_t(kHidden / kSg) * local, local),
+        UpGateKernel<MP, KS>{
+            data(input), data(weight), data(normed), data(output), m});
+  };
+  if (m == 1)
+    launch.template operator()<1, 10>();
+  else if (m == 2)
+    launch.template operator()<2, 10>();
+  else if (m <= 4)
+    launch.template operator()<4, 5>();
+  else
+    launch.template operator()<8, 5>();
+}
+
+}  // namespace dense_tp1
+
+class DenseGateKernel;
+void gate_mix(
+    const at::Tensor& input, const at::Tensor& gate, at::Tensor& output) {
+  check_glue_hidden(input);
+  check_tensor(gate, input, {input.size(0), kWidth});
+  check_tensor(output, input, {input.size(0), kHidden});
+  check_disjoint({&output}, {&input, &gate});
+  const c10::DeviceGuard guard_device(input.device());
+  const auto stream = c10::xpu::getCurrentXPUStream(input.get_device());
+  record({&input, &gate, &output}, stream);
+  const auto* x = data(input);
+  const auto* gates = data(gate);
+  auto* out = data(output);
+  stream.queue().parallel_for<DenseGateKernel>(
+      sycl::nd_range<1>(size_t(input.size(0) * kHidden), 256),
+      [=](sycl::nd_item<1> item) {
+        const int index = item.get_global_linear_id();
+        const int row = index / kHidden;
+        const int col = index % kHidden;
+        float sum = 0;
+#pragma unroll
+        for (int branch = 0; branch < kStreams; ++branch) {
+          const int offset = row * kWidth + branch * kHidden + col;
+          const float sigmoid =
+              1.0f / (1.0f + sycl::exp(-float(gates[offset])));
+          sum += float(x[offset]) * sigmoid;
+        }
+        out[index] = half(sum * 0.25f);
+      });
+}
+}  // namespace
+
+int qwen4_hc_dense_glue_max_m() { return kGlueMaxM; }
+
+#define QWEN4_LIBRARY_FRAGMENT(NAME, MODULE) \
+  TORCH_LIBRARY_FRAGMENT(NAME, MODULE)
+QWEN4_LIBRARY_FRAGMENT(TORCH_EXTENSION_NAME, m) {
+  m.def(
+      "hc_dense_grouped_norm(Tensor hidden, Tensor weight, Tensor(a!) output, "
+      "float eps) -> ()");
+  m.impl("hc_dense_grouped_norm", at::kXPU, &grouped_norm);
+  m.def(
+      "hc_dense_combine_norm(Tensor hidden, Tensor block, Tensor injection, "
+      "Tensor weight, Tensor(a!) combined, Tensor(b!) normed, float eps) -> "
+      "()");
+  m.impl("hc_dense_combine_norm", at::kXPU, &combine_norm);
+  m.def(
+      "hc_dense_gate_mix(Tensor input, Tensor gate, Tensor(a!) output) -> ()");
+  m.impl("hc_dense_gate_mix", at::kXPU, &gate_mix);
+  m.def(
+      "hc_dense_down_silu(Tensor input, Tensor weight, Tensor(a!) output) -> "
+      "()");
+  m.impl("hc_dense_down_silu", at::kXPU, &down_silu);
+  m.def(
+      "hc_dense_down_silu_smallm(Tensor input, Tensor weight, Tensor(a!) "
+      "output) -> ()");
+  m.impl("hc_dense_down_silu_smallm", at::kXPU, &down_silu_smallm);
+  m.def(
+      "hc_dense_down_silu_tp1(Tensor input, Tensor weight, Tensor(a!) low, "
+      "Tensor(b!)? injection) -> ()");
+  m.impl("hc_dense_down_silu_tp1", at::kXPU, &dense_tp1::down_silu);
+  m.def(
+      "hc_dense_up_gate_mix_tp1(Tensor input, Tensor weight, Tensor normed, "
+      "Tensor(a!) output) -> ()");
+  m.impl("hc_dense_up_gate_mix_tp1", at::kXPU, &dense_tp1::up_gate_mix);
+}
+TORCH_LIBRARY_IMPL_EXPAND(TORCH_EXTENSION_NAME, Negative, m) {
+  for (const auto* name :
+       {"hc_dense_grouped_norm",
+        "hc_dense_combine_norm",
+        "hc_dense_gate_mix",
+        "hc_dense_down_silu",
+        "hc_dense_down_silu_smallm",
+        "hc_dense_down_silu_tp1",
+        "hc_dense_up_gate_mix_tp1"})
+    m.impl(name, torch::CppFunction::makeFallthrough());
+}
+TORCH_LIBRARY_IMPL_EXPAND(TORCH_EXTENSION_NAME, Conjugate, m) {
+  for (const auto* name :
+       {"hc_dense_grouped_norm",
+        "hc_dense_combine_norm",
+        "hc_dense_gate_mix",
+        "hc_dense_down_silu",
+        "hc_dense_down_silu_smallm",
+        "hc_dense_down_silu_tp1",
+        "hc_dense_up_gate_mix_tp1"})
+    m.impl(name, torch::CppFunction::makeFallthrough());
+}
diff --git a/csrc/qwen38/hc_down_fused_dpas.h b/csrc/qwen38/hc_down_fused_dpas.h
new file mode 100644
index 0000000..1b3386a
--- /dev/null
+++ b/csrc/qwen38/hc_down_fused_dpas.h
@@ -0,0 +1,72 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "../xpu/gemv/xe_2/fp8_gemv.hpp"
+#include <sycl/ext/intel/math/imf_fp_conversions.hpp>
+
+namespace vllm::qwen38::hc_down_dpas {
+using half = sycl::half;
+namespace gemv = vllm::fp8_gemv;
+constexpr int W = 10240, R = 320, N = 336, SG = 16;
+struct Parameters {
+  const half *input, *weight;
+  half* output;
+  int m;
+};
+
+template <int MP, int KS, int Width = W>
+[[clang::always_inline]] inline void project(
+    sycl::nd_item<1> item,
+    Parameters p,
+    int feature,
+    int split,
+    float* partial) {
+#ifdef __SYCL_DEVICE_ONLY__
+  const int lane = item.get_sub_group().get_local_linear_id();
+  using D = gemv::Dpas<MP, half>;
+  typename D::C acc;
+  #pragma unroll
+  for (int row = 0; row < MP; ++row)
+    gemv::vset<MP>(acc, row, 0.0f);
+  for (int kb = split * 16; kb < Width; kb += KS * 16) {
+    cute::intel::int8 b{};
+    const cute::intel::coord_t bc = {kb / 2, feature};
+    cute::detail::XeSubgroup2DBlockLoadTranspose<4, 8, 16, 1>{}(
+        p.weight, Width * 2, N, Width * 2, bc, &b);
+    typename D::A a;
+    const cute::intel::coord_t ac = {kb, 0};
+    cute::detail::XeSubgroup2DBlockLoad<2, 16, MP, 1>{}(
+        p.input, Width * 2, p.m, Width * 2, ac, &a);
+    D::mma(acc, a, b);
+  }
+  #pragma unroll
+  for (int row = 0; row < MP; ++row)
+    partial[(split * MP + row) * SG + lane] = gemv::vget<MP>(acc, row);
+#endif
+}
+
+template <int MP, int KS>
+[[clang::always_inline]] inline void finish(
+    sycl::nd_item<1> item,
+    Parameters p,
+    int feature,
+    int split,
+    const float* partial) {
+  const int lane = item.get_sub_group().get_local_linear_id();
+  for (int row = split; row < p.m; row += KS) {
+    float sum = 0;
+#pragma unroll
+    for (int s = 0; s < KS; ++s)
+      sum += partial[(s * MP + row) * SG + lane];
+    volatile uint16_t bits =
+        sycl::bit_cast<uint16_t>(sycl::ext::intel::math::float2half_rn(sum));
+    half value = sycl::bit_cast<half>(uint16_t(bits));
+    if (feature + lane < R) {
+      volatile uint16_t scaled_bits = sycl::bit_cast<uint16_t>(
+          sycl::ext::intel::math::float2half_rn(float(value) * .25f));
+      const float z = float(sycl::bit_cast<half>(uint16_t(scaled_bits)));
+      value = half(z * (1.0f / (1.0f + sycl::exp(-z))));
+    }
+    p.output[row * N + feature + lane] = value;
+  }
+}
+}  // namespace vllm::qwen38::hc_down_dpas
diff --git a/csrc/qwen38/hc_fused_cooperative.h b/csrc/qwen38/hc_fused_cooperative.h
new file mode 100644
index 0000000..2544a04
--- /dev/null
+++ b/csrc/qwen38/hc_fused_cooperative.h
@@ -0,0 +1,172 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include <sycl/sycl.hpp>
+#include <sycl/ext/oneapi/backend/level_zero.hpp>
+#include <sycl/ext/oneapi/experimental/enqueue_functions.hpp>
+#include <sycl/ext/oneapi/experimental/root_group.hpp>
+#include <level_zero/ze_api.h>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <variant>
+
+namespace vllm::qwen38 {
+inline void ze_check(ze_result_t code, const char* operation) {
+  if (code != ZE_RESULT_SUCCESS)
+    throw std::runtime_error(
+        std::string(operation) + ": " + std::to_string(uint32_t(code)));
+}
+
+// SYCL adapter for Torch's native Level Zero graph capture.
+// Kernel bindings use compiler metadata and a private native kernel clone.
+template <typename Name, typename Body, int Local>
+class CooperativeGraph {
+  struct State {
+    sycl::kernel_bundle<sycl::bundle_state::executable> bundle;
+    sycl::kernel kernel;
+    ze_kernel_handle_t native = nullptr;
+    int capacity = 0;
+    std::mutex mutex;
+    explicit State(sycl::queue& q)
+        : bundle(
+              sycl::get_kernel_bundle<sycl::bundle_state::executable>(
+                  q.get_context(),
+                  {q.get_device()},
+                  {sycl::get_kernel_id<Name>()})),
+          kernel(bundle.get_kernel(sycl::get_kernel_id<Name>())) {
+      const auto original =
+          sycl::get_native<sycl::backend::ext_oneapi_level_zero>(kernel);
+      size_t size = 0;
+      ze_check(zeKernelGetName(original, &size, nullptr), "kernel name size");
+      std::string name(size, '\0');
+      ze_check(zeKernelGetName(original, &size, name.data()), "kernel name");
+      ze_kernel_desc_t descriptor{};
+      descriptor.stype = ZE_STRUCTURE_TYPE_KERNEL_DESC;
+      descriptor.pKernelName = name.c_str();
+      ze_kernel_handle_t created = nullptr;
+      for (auto module :
+           sycl::get_native<sycl::backend::ext_oneapi_level_zero>(bundle))
+        if (zeKernelCreate(module, &descriptor, &created) == ZE_RESULT_SUCCESS)
+          break;
+      if (!created) throw std::runtime_error("native kernel clone unavailable");
+      // Constructor failures also release the partially created native object.
+      try {
+        ze_kernel_properties_t properties{};
+        properties.stype = ZE_STRUCTURE_TYPE_KERNEL_PROPERTIES;
+        ze_check(
+            zeKernelGetProperties(created, &properties), "kernel properties");
+        using Info = sycl::detail::KernelInfo<Name>;
+        if (properties.numKernelArgs != Info::getNumParams())
+          throw std::runtime_error(
+              "native/compiler argument count mismatch: " +
+              std::to_string(properties.numKernelArgs) + "/" +
+              std::to_string(Info::getNumParams()));
+        for (unsigned i = 0; i < Info::getNumParams(); ++i) {
+          const auto parameter = Info::getParamDesc(i);
+          const int bytes =
+              parameter.kind == sycl::detail::kernel_param_kind_t::kind_pointer
+                  ? int(sizeof(void*))
+                  : parameter.info;
+          if ((parameter.kind !=
+                   sycl::detail::kernel_param_kind_t::kind_pointer &&
+               parameter.kind !=
+                   sycl::detail::kernel_param_kind_t::kind_std_layout) ||
+              bytes <= 0 || parameter.offset < 0 ||
+              parameter.offset + bytes > sizeof(Body))
+            throw std::runtime_error("unsupported native argument metadata");
+        }
+        ze_check(
+            zeKernelSetGroupSize(created, Local, 1, 1), "native group size");
+        ze_check(
+            zeKernelSetIndirectAccess(
+                created,
+                ZE_KERNEL_INDIRECT_ACCESS_FLAG_DEVICE |
+                    ZE_KERNEL_INDIRECT_ACCESS_FLAG_HOST |
+                    ZE_KERNEL_INDIRECT_ACCESS_FLAG_SHARED),
+            "native indirect access");
+        uint32_t count = 0;
+        ze_check(
+            zeKernelSuggestMaxCooperativeGroupCount(created, &count),
+            "cooperative capacity");
+        capacity = int(count);
+        native = created;
+      } catch (...) {
+        zeKernelDestroy(created);
+        throw;
+      }
+    }
+    ~State() {
+      if (native) zeKernelDestroy(native);
+    }
+  };
+  static std::shared_ptr<State> prepare(sycl::queue& q) {
+    static std::mutex mutex;
+    static std::map<std::pair<uintptr_t, uintptr_t>, std::shared_ptr<State>>
+        states;
+    const auto key = std::make_pair(
+        reinterpret_cast<uintptr_t>(
+            sycl::get_native<sycl::backend::ext_oneapi_level_zero>(
+                q.get_context())),
+        reinterpret_cast<uintptr_t>(
+            sycl::get_native<sycl::backend::ext_oneapi_level_zero>(
+                q.get_device())));
+    std::scoped_lock lock(mutex);
+    if (const auto found = states.find(key); found != states.end())
+      return found->second;
+    if (q.ext_oneapi_get_state() ==
+        sycl::ext::oneapi::experimental::queue_state::recording)
+      return {};
+    auto state = std::make_shared<State>(q);
+    states.emplace(key, state);
+    return state;
+  }
+
+ public:
+  static int capacity(sycl::queue& q) {
+    auto state = prepare(q);
+    return state ? state->capacity : 0;
+  }
+  static bool launch(sycl::queue& q, Body body, int groups) {
+    if (!q.is_in_order() || groups < 1) return false;
+    auto state = prepare(q);
+    if (!state || groups > state->capacity) return false;
+    namespace sx = sycl::ext::oneapi::experimental;
+    if (q.ext_oneapi_get_state() != sx::queue_state::recording) {
+      sx::nd_launch<Name>(
+          q,
+          sx::launch_config{
+              sycl::nd_range<1>(groups * Local, Local),
+              sx::properties{sx::use_root_sync}},
+          body);
+      return true;
+    }
+    const auto queue =
+        sycl::get_native<sycl::backend::ext_oneapi_level_zero>(q);
+    const auto* list = std::get_if<ze_command_list_handle_t>(&queue);
+    if (!list) return false;
+    std::scoped_lock lock(state->mutex);
+    using Info = sycl::detail::KernelInfo<Name>;
+    for (unsigned i = 0; i < Info::getNumParams(); ++i) {
+      const auto parameter = Info::getParamDesc(i);
+      const int bytes =
+          parameter.kind == sycl::detail::kernel_param_kind_t::kind_pointer
+              ? int(sizeof(void*))
+              : parameter.info;
+      ze_check(
+          zeKernelSetArgumentValue(
+              state->native,
+              i,
+              bytes,
+              reinterpret_cast<const char*>(&body) + parameter.offset),
+          "native argument");
+    }
+    const ze_group_count_t count{uint32_t(groups), 1, 1};
+    ze_check(
+        zeCommandListAppendLaunchCooperativeKernel(
+            *list, state->native, &count, nullptr, 0, nullptr),
+        "native graph cooperative launch");
+    return true;
+  }
+};
+}  // namespace vllm::qwen38
diff --git a/csrc/qwen38/hc_fused_stages.h b/csrc/qwen38/hc_fused_stages.h
new file mode 100644
index 0000000..2811f01
--- /dev/null
+++ b/csrc/qwen38/hc_fused_stages.h
@@ -0,0 +1,222 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+#include "qwen38/hc_fused_cooperative.h"
+#include "qwen38/hc_norm_m1_manual.h"
+#include "qwen38/hc_down_fused_dpas.h"
+#include "qwen38/hc_up_fused_dpas.h"
+#include <sycl/ext/intel/experimental/grf_size_properties.hpp>
+#include <sycl/ext/oneapi/group_local_memory.hpp>
+namespace vllm::qwen38::fused_hc {
+using half = sycl::half;
+namespace sx = sycl::ext::oneapi::experimental;
+constexpr int H = 2560, W = 10240, R = 320, D = 336, SG = 16;
+constexpr auto LoadProperties = sx::properties{
+    sx::data_placement_striped,
+    sx::contiguous_memory,
+    sx::full_group,
+    sx::alignment<4>};
+template <int N>
+[[clang::always_inline]] inline sycl::vec<half, N>
+load(sycl::sub_group sg, const half* p) {
+  sycl::vec<uint32_t, N / 2> packed;
+  auto ptr =
+      sycl::address_space_cast<
+          sycl::access::address_space::global_space,
+          sycl::access::decorated::yes>(reinterpret_cast<const uint32_t*>(p))
+          .get_decorated();
+  sx::group_load(sg, ptr, packed, LoadProperties);
+  return sycl::bit_cast<sycl::vec<half, N>>(packed);
+}
+[[clang::always_inline]] inline float sigmoid(float x) {
+  return 1.0f / (1.0f + sycl::exp(-x));
+}
+using Count = sycl::atomic_ref<
+    uint32_t,
+    sycl::memory_order::relaxed,
+    sycl::memory_scope::device,
+    sycl::access::address_space::global_space>;
+struct Parameters {
+  const half *hidden, *block, *injection, *norm_weight, *down_weight,
+      *up_weight;
+  half *combined, *normed, *down, *mixed;
+  uint32_t *sync, *status;
+  int64_t injection_stride;
+  float eps;
+  int m;
+};
+struct Scratch {
+  float partial[128];
+};
+
+// Match the native WG512 norm tree. The other half of the cohort participates
+// in all workgroup barriers but does not change the reduction.
+[[clang::always_inline]] inline void
+norm(sycl::nd_item<1> item, Parameters p, Scratch* scratch) {
+  const int tid = item.get_local_linear_id(), bid = item.get_group_linear_id();
+  const int row = p.m == 1 ? 0 : bid / 4;
+  const int branch = p.m == 1 ? bid / 5 : bid % 4;
+  const int tile = p.m == 1 ? bid % 5 : -1;
+  const bool active = tid < 512 && (p.m == 1 ? bid < 20 : bid < p.m * 4);
+  float feedback[5] = {};
+  if (active) {
+    const int offset = row * W + branch * H;
+    const float scale =
+        2.0f *
+        sigmoid(float(p.injection[row * p.injection_stride + branch]) * .25f);
+    float sum_sq = 0;
+#pragma unroll
+    for (int i = 0; i < 5; ++i) {
+      const int col = tid + i * 512;
+      const auto value = vllm::qwen38::hc::manual_norm::round_feedback(
+          float(p.hidden[offset + col]) +
+          float(p.block[row * H + col]) * scale);
+      feedback[i] = value.value;
+      sum_sq += value.value * value.value;
+      if (tile < 0 || i == tile)
+        p.combined[offset + col] = sycl::bit_cast<half>(value.bits);
+    }
+    const float sg_sum = sycl::reduce_over_group(
+        item.get_sub_group(), sum_sq, sycl::plus<float>());
+    if (tid % SG == 0) scratch->partial[tid / SG] = sg_sum;
+  }
+  item.barrier(sycl::access::fence_space::local_space);
+  if (active) {
+    const int lane = tid % SG, offset = row * W + branch * H;
+    const float pair = scratch->partial[lane] + scratch->partial[lane + SG];
+    const float total = sycl::reduce_over_group(
+        item.get_sub_group(), pair, sycl::plus<float>());
+    const float inv = sycl::rsqrt(total / float(H) + p.eps);
+#pragma unroll
+    for (int i = 0; i < 5; ++i) {
+      const int col = tid + i * 512;
+      if (tile < 0 || i == tile)
+        p.normed[offset + col] = half(
+            feedback[i] * inv *
+            (1.0f + float(p.norm_weight[branch * H + col])));
+    }
+  }
+}
+
+constexpr int Groups = 64, Local = 512, Coordinator = 63;
+constexpr int DownGroups = 21, UpGroups = 40, UpFirst = DownGroups;
+constexpr int NormReady = Groups * 16, NormGate = (Groups + 32) * 16;
+constexpr int DownReady = NormGate + 16;
+constexpr int DownGate = DownReady + DownGroups * 16;
+
+[[clang::always_inline]] inline void
+wait_ready(Parameters p, int index, uint32_t epoch, uint32_t diagnostic) {
+  unsigned polls = 0;
+  while (int32_t(Count(p.sync[index]).load() - epoch) < 0) {
+    if (++polls == (1U << 24)) {
+      uint32_t empty = 0;
+      Count(*p.status).compare_exchange_strong(empty, diagnostic);
+    }
+    if ((polls & 31U) == 0)
+      sycl::atomic_fence(
+          sycl::memory_order::acquire, sycl::memory_scope::device);
+  }
+  sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::device);
+}
+
+template <int MP>
+class HCRolesDpasKernel;
+template <int MP>
+struct RolesBody {
+  Parameters p;
+  constexpr auto get(sx::properties_tag) const {
+    return sx::properties{
+        sx::sub_group_size<16>, sycl::ext::intel::experimental::grf_size<128>};
+  }
+  void operator()(sycl::nd_item<1> item) const {
+    const int tid = item.get_local_linear_id(),
+              bid = item.get_group_linear_id();
+    const int sub = tid / SG;
+    const uint32_t epoch = p.sync[bid * 16] + 1;
+    auto scratch = sycl::ext::oneapi::group_local_memory_for_overwrite<Scratch>(
+        item.get_group());
+    if (bid < p.m * 4) {
+      norm(item, p, scratch.get());
+      item.barrier(sycl::access::fence_space::global_and_local);
+      if (tid == 0)
+        Count(p.sync[NormReady + bid * 16])
+            .store(epoch, sycl::memory_order::release);
+    }
+
+    namespace up = vllm::qwen38::hc_up_dpas;
+    constexpr int UpKS = 2, Prefetch = 10;
+    constexpr int TeamGroups = 4 * UpKS, PartialPerTeam = TeamGroups * MP * SG;
+    const bool consumer = bid >= UpFirst && bid < UpFirst + UpGroups;
+    const int team = sub / TeamGroups, logical_sub = sub % TeamGroups;
+    const int feature = (team * UpGroups + bid - UpFirst) * SG;
+    const up::Parameters up_args{
+        p.down, p.up_weight, p.normed, p.mixed, p.m, D};
+    cute::intel::int8 first_weights[Prefetch ? Prefetch : 1]{};
+    if (consumer) {
+#pragma unroll
+      for (int tile = 0; tile < Prefetch; ++tile)
+        first_weights[tile] = up::read_weight(
+            up_args,
+            feature,
+            logical_sub / UpKS,
+            logical_sub % UpKS * 16 + tile * UpKS * 16);
+#ifdef __SYCL_DEVICE_ONLY__
+      asm volatile("" ::: "memory");
+#endif
+    }
+    // UP B loads do not depend on norm or DOWN. Other cohorts can run DOWN
+    // while these consumers move their weights into registers.
+    if (bid == Coordinator) {
+      if (tid < p.m * 4) wait_ready(p, NormReady + tid * 16, epoch, 1000 + tid);
+      item.barrier(sycl::access::fence_space::global_and_local);
+      if (tid == 0)
+        Count(p.sync[NormGate]).store(epoch, sycl::memory_order::release);
+    } else if (tid == 0) {
+      wait_ready(p, NormGate, epoch, 2000 + bid);
+    }
+    item.barrier(sycl::access::fence_space::global_and_local);
+    if (bid < DownGroups) {
+      namespace down = vllm::qwen38::hc_down_dpas;
+      constexpr int DownKS = 20;
+      auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+          float[DownKS * MP * SG]>(item.get_group());
+      const down::Parameters args{p.normed, p.down_weight, p.down, p.m};
+      if (sub < DownKS)
+        down::project<MP, DownKS>(item, args, bid * SG, sub, partial);
+      item.barrier(sycl::access::fence_space::local_space);
+      if (sub < DownKS)
+        down::finish<MP, DownKS>(item, args, bid * SG, sub, partial);
+      item.barrier(sycl::access::fence_space::global_and_local);
+      if (tid == 0)
+        Count(p.sync[DownReady + bid * 16])
+            .store(epoch, sycl::memory_order::release);
+    } else if (bid == Coordinator) {
+      // UP needs only rank320; the independent merged injection rows do not
+      // delay UP. Kernel completion still joins that last DOWN producer.
+      if (tid < R / SG) wait_ready(p, DownReady + tid * 16, epoch, 3000 + tid);
+      item.barrier(sycl::access::fence_space::global_and_local);
+      if (tid == 0)
+        Count(p.sync[DownGate]).store(epoch, sycl::memory_order::release);
+    } else if (consumer) {
+      if (tid == 0) wait_ready(p, DownGate, epoch, 4000 + bid);
+      item.barrier(sycl::access::fence_space::global_and_local);
+      auto* partial = *sycl::ext::oneapi::group_local_memory_for_overwrite<
+          float[4 * PartialPerTeam]>(item.get_group());
+      up::project<MP, UpKS, Prefetch>(
+          item,
+          up_args,
+          feature,
+          logical_sub,
+          partial + team * PartialPerTeam,
+          first_weights);
+      item.barrier(sycl::access::fence_space::local_space);
+      up::mix<MP, UpKS>(
+          item, up_args, feature, logical_sub, partial + team * PartialPerTeam);
+    }
+    item.barrier(sycl::access::fence_space::local_space);
+    if (tid == 0) p.sync[bid * 16] = epoch;
+  }
+};
+template <int MP>
+using RolesLauncher =
+    vllm::qwen38::CooperativeGraph<HCRolesDpasKernel<MP>, RolesBody<MP>, Local>;
+}  // namespace vllm::qwen38::fused_hc
diff --git a/csrc/qwen38/hc_fused_sycl.cpp b/csrc/qwen38/hc_fused_sycl.cpp
new file mode 100644
index 0000000..a27ebb1
--- /dev/null
+++ b/csrc/qwen38/hc_fused_sycl.cpp
@@ -0,0 +1,156 @@
+// SPDX-License-Identifier: Apache-2.0
+#include <sycl/sycl.hpp>
+#include <torch/extension.h>
+#include <ATen/ATen.h>
+#include <c10/xpu/XPUCachingAllocator.h>
+#include <c10/xpu/XPUStream.h>
+#include <vector>
+#include "qwen38/hc_fused_stages.h"
+
+namespace vllm::qwen38::fused_hc {
+namespace {
+bool dense(
+    const at::Tensor& t,
+    const at::Tensor& x,
+    at::IntArrayRef shape,
+    at::ScalarType dtype = at::kHalf,
+    bool contiguous = true) {
+  return t.defined() && t.device() == x.device() && t.scalar_type() == dtype &&
+         t.layout() == at::kStrided && t.sizes() == shape &&
+         (!contiguous || t.is_contiguous()) && !t.is_neg() && !t.is_conj() &&
+         !t.requires_grad() && !t.key_set().has(c10::DispatchKey::Python) &&
+         uintptr_t(t.const_data_ptr()) % 4 == 0;
+}
+std::pair<uintptr_t, uintptr_t> span(const at::Tensor& t) {
+  int64_t elements = 1;
+  for (int d = 0; d < t.dim(); ++d)
+    elements += (t.size(d) - 1) * t.stride(d);
+  const auto begin = uintptr_t(t.const_data_ptr());
+  return {begin, begin + elements * t.element_size()};
+}
+bool disjoint(
+    const std::vector<at::Tensor>& writes,
+    const std::vector<at::Tensor>& reads) {
+  const auto overlaps = [](const auto& a, const auto& b) {
+    const auto [ab, ae] = span(a);
+    const auto [bb, be] = span(b);
+    return ab < be && bb < ae;
+  };
+  for (size_t i = 0; i < writes.size(); ++i) {
+    for (const auto& r : reads)
+      if (overlaps(writes[i], r)) return false;
+    for (size_t j = i + 1; j < writes.size(); ++j)
+      if (overlaps(writes[i], writes[j])) return false;
+  }
+  return true;
+}
+}  // namespace
+
+bool try_run(
+    at::Tensor hidden,
+    at::Tensor block,
+    at::Tensor injection,
+    at::Tensor nw,
+    at::Tensor dw,
+    at::Tensor uw,
+    at::Tensor combined,
+    at::Tensor normed,
+    at::Tensor down,
+    at::Tensor mixed,
+    at::Tensor control,
+    at::Tensor status,
+    double eps) {
+  if (!hidden.defined() || !hidden.is_xpu() || hidden.dim() != 2 ||
+      hidden.size(0) < 2 || hidden.size(0) > 8 || eps != 1e-6)
+    return false;
+  const int m = hidden.size(0);
+  constexpr int Width = 10240, Hidden = 2560;
+  if (!dense(hidden, hidden, {m, Width}) ||
+      !dense(block, hidden, {m, Hidden}) ||
+      !dense(injection, hidden, {m, 4}, at::kHalf, false) ||
+      injection.stride(1) != 1 || injection.stride(0) < 4 ||
+      !dense(nw, hidden, {Width}) || !dense(dw, hidden, {D, Width}) ||
+      !dense(uw, hidden, {Width, R}) || uintptr_t(dw.const_data_ptr()) % 64 ||
+      uintptr_t(uw.const_data_ptr()) % 64 ||
+      !dense(combined, hidden, {m, Width}) ||
+      !dense(normed, hidden, {m, Width}) || !dense(down, hidden, {m, D}) ||
+      !dense(mixed, hidden, {m, Hidden}) ||
+      uintptr_t(normed.const_data_ptr()) % 64 ||
+      uintptr_t(down.const_data_ptr()) % 64 ||
+      !dense(control, hidden, {DownGate + 16}, at::kInt) ||
+      !dense(status, hidden, {1}, at::kInt) ||
+      !disjoint(
+          {combined, normed, down, mixed, control, status},
+          {hidden, block, injection, nw, dw, uw}))
+    return false;
+  auto stream = c10::xpu::getCurrentXPUStream(hidden.get_device());
+  auto& q = stream.queue();
+  if (!q.is_in_order() || !q.get_device().has(sycl::aspect::fp16) ||
+      q.get_device().get_info<sycl::info::device::name>().find("B70") ==
+          std::string::npos)
+    return false;
+  Parameters p{
+      reinterpret_cast<const half*>(hidden.const_data_ptr()),
+      reinterpret_cast<const half*>(block.const_data_ptr()),
+      reinterpret_cast<const half*>(injection.const_data_ptr()),
+      reinterpret_cast<const half*>(nw.const_data_ptr()),
+      reinterpret_cast<const half*>(dw.const_data_ptr()),
+      reinterpret_cast<const half*>(uw.const_data_ptr()),
+      reinterpret_cast<half*>(combined.mutable_data_ptr()),
+      reinterpret_cast<half*>(normed.mutable_data_ptr()),
+      reinterpret_cast<half*>(down.mutable_data_ptr()),
+      reinterpret_cast<half*>(mixed.mutable_data_ptr()),
+      reinterpret_cast<uint32_t*>(control.mutable_data_ptr()),
+      reinterpret_cast<uint32_t*>(status.mutable_data_ptr()),
+      injection.stride(0),
+      float(eps),
+      m};
+  const auto submit = [&]<int MP>() {
+    const int capacity = RolesLauncher<MP>::capacity(q);
+    if (capacity < Groups) return false;
+    for (const auto& t :
+         {hidden,
+          block,
+          injection,
+          nw,
+          dw,
+          uw,
+          combined,
+          normed,
+          down,
+          mixed,
+          control,
+          status})
+      c10::xpu::XPUCachingAllocator::recordStream(
+          t.storage().data_ptr(), stream);
+    const bool submitted =
+        RolesLauncher<MP>::launch(q, RolesBody<MP>{p}, Groups);
+    TORCH_CHECK(submitted, "prepared HC cooperative kernel became unavailable");
+    return true;
+  };
+  if (m == 2) return submit.template operator()<2>();
+  if (m <= 4) return submit.template operator()<4>();
+  return submit.template operator()<8>();
+}
+bool prepare(const at::Tensor& hidden) {
+  if (!hidden.defined() || !hidden.is_xpu()) return false;
+  const auto stream = c10::xpu::getCurrentXPUStream(hidden.get_device());
+  auto& q = stream.queue();
+  if (stream.is_capturing() || !q.is_in_order() ||
+      q.get_device().get_info<sycl::info::device::name>().find("B70") ==
+          std::string::npos)
+    return false;
+  const auto ready = [&]<int MP>() {
+    return RolesLauncher<MP>::capacity(q) >= Groups;
+  };
+  return ready.template operator()<2>() && ready.template operator()<4>() &&
+         ready.template operator()<8>();
+}
+}  // namespace vllm::qwen38::fused_hc
+
+PYBIND11_MODULE(TORCH_EXTENSION_NAME, m) {
+  m.attr("abi_version") = 1;
+  m.attr("control_words") = vllm::qwen38::fused_hc::DownGate + 16;
+  m.def("try_run", &vllm::qwen38::fused_hc::try_run);
+  m.def("prepare", &vllm::qwen38::fused_hc::prepare);
+}
diff --git a/csrc/qwen38/hc_norm_m1_manual.h b/csrc/qwen38/hc_norm_m1_manual.h
new file mode 100644
index 0000000..08c4af1
--- /dev/null
+++ b/csrc/qwen38/hc_norm_m1_manual.h
@@ -0,0 +1,177 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <sycl/sycl.hpp>
+
+#include <cstddef>
+#include <cstdint>
+
+namespace vllm::qwen38::hc::manual_norm {
+using half = sycl::half;
+constexpr int kStreams = 4;
+constexpr int kHidden = 2560;
+constexpr int kSubgroup = 16;
+constexpr int kLocal = 512;
+
+struct RoundedFeedback {
+  uint16_t bits;
+  float value;
+};
+
+inline RoundedFeedback round_feedback(float value) {
+  const uint32_t bits = sycl::bit_cast<uint32_t>(value);
+  const uint32_t magnitude = bits & 0x7fffffffu;
+  if (magnitude >= 0x38800000u && magnitude < 0x477ff000u) {
+    // Preserve the actual FP16 RNE boundary in integer bits. Do not replace
+    // this feedback with float(half(value)): IGC can promote that to value.
+    const uint32_t rounded = magnitude + 0xfffu + ((magnitude >> 13) & 1u);
+    const uint16_t half_bits =
+        uint16_t(((bits >> 16) & 0x8000u) | ((rounded - 0x38000000u) >> 13));
+    const uint32_t feedback = (bits & 0x80000000u) | (rounded & 0xffffe000u);
+    return {half_bits, sycl::bit_cast<float>(feedback)};
+  }
+  // Preserve the previous conversion for small values, overflow and NaNs;
+  // in particular, do not invent a new subnormal or NaN-payload contract.
+  const half rounded = half(value);
+  volatile uint16_t boundary = sycl::bit_cast<uint16_t>(rounded);
+  const uint16_t stored = uint16_t(boundary);
+  return {stored, float(sycl::bit_cast<half>(stored))};
+}
+
+class NormM1ManualKernel;
+constexpr int kM1OutputTiles = kHidden / kLocal;
+
+// The existing HC entry point performs all shape/alias/stream preflights.
+// Its M=1 combine+norm dispatch is the only caller of this helper.
+inline void launch(
+    sycl::queue& queue,
+    const half* hidden,
+    const half* block,
+    const half* injection,
+    int64_t injection_stride,
+    const half* weight,
+    half* combined,
+    half* normed,
+    float eps) {
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> partial(kLocal / kSubgroup + 1, cgh);
+    cgh.parallel_for<NormM1ManualKernel>(
+        sycl::nd_range<1>(size_t(kStreams * kM1OutputTiles * kLocal), kLocal),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(kSubgroup)]] {
+          // Repeat the original reduction without changing its order. Each
+          // group owns one disjoint 512-column output tile; the additional
+          // groups expose parallelism in this otherwise four-group kernel.
+          const int branch = item.get_group_linear_id() / kM1OutputTiles;
+          const int tile = item.get_group_linear_id() % kM1OutputTiles;
+          const int lane = item.get_local_linear_id();
+          const auto sg = item.get_sub_group();
+          const int subgroup = lane / kSubgroup;
+          const int subgroup_lane = sg.get_local_linear_id();
+          const int offset = branch * kHidden;
+          (void)injection_stride;  // The only row is zero.
+          const float injection_value = float(injection[branch]) * 0.25f;
+          const float injection_scale =
+              2.0f * (1.0f / (1.0f + sycl::exp(-injection_value)));
+          float feedback[kHidden / kLocal];
+          float sum_sq = 0.0f;
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = lane + i * kLocal;
+            const float h = float(hidden[offset + col]);
+            const float b = float(block[col]);
+            const auto rounded = round_feedback(h + b * injection_scale);
+            if (i == tile) {
+              combined[offset + col] = sycl::bit_cast<half>(rounded.bits);
+            }
+            feedback[i] = rounded.value;
+            sum_sq += rounded.value * rounded.value;
+          }
+          const float sg_sum =
+              sycl::reduce_over_group(sg, sum_sq, sycl::plus<float>());
+          if (subgroup_lane == 0) partial[subgroup] = sg_sum;
+          item.barrier(sycl::access::fence_space::local_space);
+          const float pair =
+              partial[subgroup_lane] + partial[subgroup_lane + kSubgroup];
+          const float total =
+              sycl::reduce_over_group(sg, pair, sycl::plus<float>());
+          const float inv = sycl::rsqrt(total / float(kHidden) + eps);
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = lane + i * kLocal;
+            const float w = float(weight[offset + col]);
+            if (i == tile) {
+              normed[offset + col] = half(feedback[i] * inv * (1.0f + w));
+            }
+          }
+        });
+  });
+}
+
+class NormSmallMManualKernel;
+
+// All small-M rows share one kernel and the same round_feedback/RNE boundary.
+// Keep their original launch geometry: they already expose multiple rows. The
+// caller retains live shape/stride/alias/stream/lifetime preflights.
+// Unsupported M returns false before submission; execution errors must
+// propagate.
+inline bool launch_small_m(
+    sycl::queue& queue,
+    const half* hidden,
+    const half* block,
+    const half* injection,
+    int64_t injection_stride,
+    const half* weight,
+    half* combined,
+    half* normed,
+    int m,
+    float eps) {
+  if (m < 2 || m > 8) return false;
+  queue.submit([&](sycl::handler& cgh) {
+    sycl::local_accessor<float, 1> partial(kLocal / kSubgroup + 1, cgh);
+    cgh.parallel_for<NormSmallMManualKernel>(
+        sycl::nd_range<1>(size_t(m * kStreams * kLocal), kLocal),
+        [=](sycl::nd_item<1> item) [[sycl::reqd_sub_group_size(kSubgroup)]] {
+          const int group = item.get_group_linear_id();
+          const int row = group / kStreams;
+          const int branch = group % kStreams;
+          const int lane = item.get_local_linear_id();
+          const auto sg = item.get_sub_group();
+          const int subgroup = lane / kSubgroup;
+          const int subgroup_lane = sg.get_local_linear_id();
+          const int offset = group * kHidden;
+          const float injection_value =
+              float(injection[row * injection_stride + branch]) * 0.25f;
+          const float injection_scale =
+              2.0f * (1.0f / (1.0f + sycl::exp(-injection_value)));
+          float feedback[kHidden / kLocal];
+          float sum_sq = 0.0f;
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = lane + i * kLocal;
+            const float h = float(hidden[offset + col]);
+            const float b = float(block[row * kHidden + col]);
+            const auto rounded = round_feedback(h + b * injection_scale);
+            combined[offset + col] = sycl::bit_cast<half>(rounded.bits);
+            feedback[i] = rounded.value;
+            sum_sq += rounded.value * rounded.value;
+          }
+          const float sg_sum =
+              sycl::reduce_over_group(sg, sum_sq, sycl::plus<float>());
+          if (subgroup_lane == 0) partial[subgroup] = sg_sum;
+          item.barrier(sycl::access::fence_space::local_space);
+          const float pair =
+              partial[subgroup_lane] + partial[subgroup_lane + kSubgroup];
+          const float total =
+              sycl::reduce_over_group(sg, pair, sycl::plus<float>());
+          const float inv = sycl::rsqrt(total / float(kHidden) + eps);
+#pragma unroll
+          for (int i = 0; i < kHidden / kLocal; ++i) {
+            const int col = lane + i * kLocal;
+            const float w = float(weight[branch * kHidden + col]);
+            normed[offset + col] = half(feedback[i] * inv * (1.0f + w));
+          }
+        });
+  });
+  return true;
+}
+}  // namespace vllm::qwen38::hc::manual_norm
diff --git a/csrc/qwen38/hc_sycl.cpp b/csrc/qwen38/hc_sycl.cpp
new file mode 100644
index 0000000..fe4614d
--- /dev/null
+++ b/csrc/qwen38/hc_sycl.cpp
@@ -0,0 +1,1271 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "qwen38/hc_sycl.h"
+#include "qwen38/hc_norm_m1_manual.h"
+
+#include <ATen/MemoryOverlap.h>
+#include <c10/core/DeviceGuard.h>
+#include <c10/xpu/XPUCachingAllocator.h>
+#include <c10/xpu/XPUStream.h>
+#include <sycl/ext/intel/math/imf_fp_conversions.hpp>
+#include <sycl/ext/oneapi/experimental/group_load_store.hpp>
+#include <sycl/sycl.hpp>
+#include <torch/library.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <initializer_list>
+#include <type_traits>
+
+namespace vllm::qwen38::hc {
+namespace {
+
+using half = sycl::half;
+namespace sx = sycl::ext::oneapi::experimental;
+constexpr int kStreams = 4;
+constexpr int kHidden = 2560;
+constexpr int kWidth = kStreams * kHidden;
+constexpr int kRank = 320;
+constexpr int kDownMerged = 336;
+constexpr int kSg = 16;
+constexpr int kLocal = 256;
+constexpr int kNormLocal = 512;
+constexpr int kPrefillMaxM = 8192;
+constexpr auto kLoadProperties = sx::properties{
+    sx::data_placement_striped,
+    sx::contiguous_memory,
+    sx::full_group,
+    sx::alignment<4>};
+
+void check_no_overlap(const torch::Tensor& a, const torch::Tensor& b) {
+  at::assert_no_overlap(a, b);
+  // ATen allows TooHard for padded views and No for separate Storage owners
+  // of the same physical bytes. Dense tensors use their actual byte ranges.
+  const bool padded =
+      at::get_overlap_status(a, b) == at::MemOverlapStatus::TooHard;
+  const auto a_start = reinterpret_cast<uintptr_t>(
+      padded ? a.storage().data() : a.const_data_ptr());
+  const auto b_start = reinterpret_cast<uintptr_t>(
+      padded ? b.storage().data() : b.const_data_ptr());
+  const auto a_bytes =
+      padded ? a.storage().nbytes() : a.numel() * a.element_size();
+  const auto b_bytes =
+      padded ? b.storage().nbytes() : b.numel() * b.element_size();
+  TORCH_CHECK(
+      a_start <= b_start ? b_start - a_start >= a_bytes
+                         : a_start - b_start >= b_bytes,
+      "HC tensors have overlapping storage or unprovable overlap");
+}
+
+void check_input(
+    const torch::Tensor& input, int width, const char* name, int max_m = 8) {
+  TORCH_CHECK(input.is_xpu(), name, " must be on XPU");
+  TORCH_CHECK(input.scalar_type() == at::kHalf, name, " must be FP16");
+  TORCH_CHECK(
+      input.dim() == 2 && input.size(0) >= 1 && input.size(0) <= max_m &&
+          input.size(1) == width && input.is_contiguous() && !input.is_neg() &&
+          !input.is_conj(),
+      name,
+      " has an invalid Qwen3.8 HC shape/layout");
+}
+
+void check_same(
+    const torch::Tensor& t, const torch::Tensor& first, const char* name) {
+  TORCH_CHECK(t.device() == first.device(), name, " must be on input device");
+  TORCH_CHECK(t.scalar_type() == at::kHalf, name, " must be FP16");
+  TORCH_CHECK(!t.is_neg() && !t.is_conj(), name, " must not be a lazy view");
+}
+
+void check_matrix(
+    const torch::Tensor& t,
+    const torch::Tensor& first,
+    int rows,
+    int cols,
+    const char* name) {
+  check_same(t, first, name);
+  TORCH_CHECK(
+      t.dim() == 2 && t.size(0) == rows && t.size(1) == cols &&
+          t.is_contiguous(),
+      name,
+      " has an invalid shape/layout");
+}
+
+void check_norm(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& output,
+    double eps,
+    int max_m = 8) {
+  check_input(input, kWidth, "input", max_m);
+  check_same(weight, input, "norm weight");
+  TORCH_CHECK(
+      weight.dim() == 1 && weight.numel() == kWidth && weight.is_contiguous(),
+      "norm weight must be [10240]");
+  check_matrix(output, input, input.size(0), kWidth, "norm output");
+  TORCH_CHECK(
+      std::isfinite(eps) && eps > 0.0 &&
+          std::isfinite(static_cast<float>(eps)) &&
+          static_cast<float>(eps) > 0.0f,
+      "eps must be positive finite FP32");
+  check_no_overlap(output, input);
+  check_no_overlap(output, weight);
+}
+
+void check_gate(
+    const torch::Tensor& input,
+    const torch::Tensor& gate,
+    const torch::Tensor& output,
+    int max_m = 8) {
+  check_input(input, kWidth, "input", max_m);
+  check_matrix(gate, input, input.size(0), kWidth, "gate");
+  check_matrix(output, input, input.size(0), kHidden, "mixed output");
+  check_no_overlap(output, input);
+  check_no_overlap(output, gate);
+}
+
+void check_combine(
+    const torch::Tensor& hidden,
+    const torch::Tensor& block,
+    const torch::Tensor& injection,
+    const torch::Tensor& output,
+    int max_m = 8) {
+  check_input(hidden, kWidth, "hidden", max_m);
+  check_matrix(block, hidden, hidden.size(0), kHidden, "block");
+  check_same(injection, hidden, "injection");
+  TORCH_CHECK(
+      injection.dim() == 2 && injection.size(0) == hidden.size(0) &&
+          injection.size(1) == kStreams && injection.stride(1) == 1 &&
+          injection.stride(0) >= kStreams,
+      "injection must be nonoverlapping [M,4] with unit column stride");
+  check_matrix(output, hidden, hidden.size(0), kWidth, "combined output");
+  check_no_overlap(output, hidden);
+  check_no_overlap(output, block);
+  check_no_overlap(output, injection);
+}
+
+void check_down(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& output) {
+  check_input(input, kWidth, "down input");
+  check_same(weight, input, "down weight");
+  TORCH_CHECK(
+      weight.dim() == 2 && weight.is_contiguous() &&
+          (weight.size(0) == kRank || weight.size(0) == kDownMerged) &&
+          weight.size(1) == kWidth,
+      "down weight must be [320|336,10240]");
+  check_matrix(output, input, input.size(0), weight.size(0), "down output");
+  check_no_overlap(output, input);
+  check_no_overlap(output, weight);
+}
+
+void check_up_input(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& output,
+    int out_width) {
+  TORCH_CHECK(
+      input.is_xpu() && input.scalar_type() == at::kHalf && input.dim() == 2 &&
+          input.size(0) >= 1 && input.size(0) <= 8 && input.size(1) == kRank &&
+          input.stride(1) == 1 && input.stride(0) >= kRank && !input.is_neg() &&
+          !input.is_conj(),
+      "up input must be nonoverlapping FP16 XPU [M,320]");
+  check_matrix(weight, input, kWidth, kRank, "up weight");
+  check_matrix(output, input, input.size(0), out_width, "up output");
+  check_no_overlap(output, input);
+  check_no_overlap(output, weight);
+}
+
+void check_up_gate(
+    const torch::Tensor& input,
+    const torch::Tensor& weight,
+    const torch::Tensor& normed,
+    const torch::Tensor& output) {
+  check_up_input(input, weight, output, kHidden);
+  check_matrix(normed, input, input.size(0), kWidth, "normed");
+  check_no_overlap(output, normed);
+}
+
+void check_distinct_outputs(
+    std::initializer_list<const torch::Tensor*> outputs,
+    std::initializer_list<const torch::Tensor*> inputs) {
+  for (const auto* out : outputs) {
+    for (const auto* in : inputs)
+      check_no_overlap(*out, *in);
+    for (const auto* other : outputs) {
+      if (out != other) check_no_overlap(*out, *other);
+    }
+  }
+}
+
+void record(
+    std::initializer_list<const torch::Tensor*> tensors,
+    c10::xpu::XPUStream stream) {
+  for (const auto* t : tensors)
+    c10::xpu::XPUCachingAllocator::recordStream(
+        t->storage().data_ptr(), stream);
+}
