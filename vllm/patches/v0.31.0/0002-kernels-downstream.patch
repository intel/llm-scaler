--- /dev/null
+++ b/csrc/qwen38/peer_general_stage.h
@@ -0,0 +1,126 @@
+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include "qwen38/sycl_block_io.h"
+
+namespace vllm::qwen38::peer_general {
+constexpr size_t kControlBytes = 65536;
+constexpr int kSlots = 64, kStride = 16, kEpochWord = 8 * kSlots * kStride;
+constexpr int kErrorWord = kEpochWord + kSlots;
+constexpr size_t kMaxBytes = 65536;
+
+struct Bindings {
+  char* own;
+  char* peers[8];
+  int rank;
+};
+
+using Ready = sycl::atomic_ref<
+    uint32_t,
+    sycl::memory_order::relaxed,
+    sycl::memory_scope::system,
+    sycl::access::address_space::global_space>;
+using Error = sycl::atomic_ref<
+    uint32_t,
+    sycl::memory_order::relaxed,
+    sycl::memory_scope::device,
+    sycl::access::address_space::global_space>;
+
+[[clang::always_inline]] inline uint32_t half_pair_add(uint32_t a, uint32_t b) {
+  using Pair = sycl::vec<sycl::half, 2>;
+  return sycl::bit_cast<uint32_t>(
+      sycl::bit_cast<Pair>(a) + sycl::bit_cast<Pair>(b));
+}
+
+// Eight subgroups own the same slices for every replay. Other work-items may
+// participate in barriers when this stage is embedded in a larger workgroup.
+template <int World>
+[[clang::always_inline]] inline void reduce_m1(
+    sycl::nd_item<1> item,
+    const sycl::half* input,
+    sycl::half* output,
+    Bindings p,
+    int width) {
+  const int tid = item.get_local_linear_id(), sub = tid / 16, lane = tid % 16;
+  const auto sg = item.get_sub_group();
+  auto ctrl = reinterpret_cast<uint32_t*>(p.own);
+  const uint32_t epoch = ctrl[kEpochWord] + 1;
+  const size_t parity = size_t(epoch & 1) * World * kMaxBytes;
+  if (tid < 128) {
+    for (int begin = sub * 128; begin < width; begin += 1024) {
+      const auto value = block_io::load<uint32_t, 4>(
+          sg, reinterpret_cast<const uint32_t*>(input + begin));
+#pragma unroll
+      for (int r = 0; r < World; ++r)
+        if (r != p.rank)
+          block_io::store(
+              sg,
+              value,
+              reinterpret_cast<uint32_t*>(
+                  p.peers[r] + kControlBytes + parity + p.rank * kMaxBytes +
+                  begin * 2));
+    }
+  }
+  item.barrier(sycl::access::fence_space::global_and_local);
+  if (tid == 0) {
+#ifdef __SYCL_DEVICE_ONLY__
+    asm volatile("lsc_fence.ugm.clean.sysrel" ::: "memory");
+#endif
+    sycl::atomic_fence(sycl::memory_order::release, sycl::memory_scope::system);
+#pragma unroll
+    for (int r = 0; r < World; ++r)
+      if (r != p.rank)
+        *reinterpret_cast<volatile uint32_t*>(
+            p.peers[r] + p.rank * kSlots * kStride * 4) = epoch;
+#pragma unroll
+    for (int r = 0; r < World; ++r)
+      if (r != p.rank) {
+        unsigned polls = 0;
+        while (int32_t(Ready(ctrl[r * kSlots * kStride]).load() - epoch) < 0) {
+          if (++polls == (1U << 24)) {
+            uint32_t empty = 0;
+            Error(ctrl[kErrorWord]).compare_exchange_strong(empty, r + 1);
+            // This is a diagnostic deadline, not permission to read a missing
+            // peer's payload. Keep waiting so a delayed rank cannot produce a
+            // silently incorrect reduction. The process watchdog handles
+            // stalls.
+          }
+          if ((polls & 31U) == 0)
+            sycl::atomic_fence(
+                sycl::memory_order::acquire, sycl::memory_scope::device);
+        }
+      }
+#ifdef __SYCL_DEVICE_ONLY__
+    asm volatile("lsc_fence.ugm.invalidate.sysacq" ::: "memory");
+#endif
+    sycl::atomic_fence(sycl::memory_order::acquire, sycl::memory_scope::system);
+  }
+  item.barrier(sycl::access::fence_space::global_and_local);
+  if (tid < 128) {
+    for (int begin = sub * 128; begin < width; begin += 1024) {
+      sycl::vec<uint32_t, 4> words[World];
+#pragma unroll
+      for (int r = 0; r < World; ++r)
+        words[r] = block_io::load<uint32_t, 4>(
+            sg,
+            r == p.rank ? reinterpret_cast<const uint32_t*>(input + begin)
+                        : reinterpret_cast<const uint32_t*>(
+                              p.own + kControlBytes + parity + r * kMaxBytes +
+                              begin * 2));
+      sycl::vec<uint32_t, 4> result;
+#pragma unroll
+      for (int i = 0; i < 4; ++i) {
+        const int start = ((begin + 2 * (i * 16 + lane)) / 120) & (World - 1);
+        uint32_t value = words[start][i];
+#pragma unroll
+        for (int r = 1; r < World; ++r)
+          value = half_pair_add(value, words[(start + r) & (World - 1)][i]);
+        result[i] = value;
+      }
+      block_io::store(sg, result, reinterpret_cast<uint32_t*>(output + begin));
+    }
+  }
+  item.barrier(sycl::access::fence_space::global_and_local);
+  if (tid == 0) ctrl[kEpochWord] = epoch;
+}
+}  // namespace vllm::qwen38::peer_general
diff --git a/csrc/qwen38/peer_sycl.cpp b/csrc/qwen38/peer_sycl.cpp
new file mode 100644
