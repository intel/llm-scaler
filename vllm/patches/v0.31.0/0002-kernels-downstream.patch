+// SPDX-License-Identifier: Apache-2.0
+#pragma once
+
+#include <ATen/ATen.h>
+#include <c10/core/Stream.h>
+#include <torch/custom_class.h>
+
+#include <array>
+#include <cstdint>
+#include <mutex>
