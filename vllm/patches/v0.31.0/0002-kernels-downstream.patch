+      "project_mix(Tensor normed, Tensor down_weight, Tensor up_weight, "
+      "Tensor(a!) down_output, Tensor(b!) mixed) -> ()");
+  m.impl("project_mix", torch::kXPU, &vllm::qwen38::hc::project_mix);
+}
