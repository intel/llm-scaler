+# SPDX-License-Identifier: Apache-2.0
+"""Qwen3.8-Flash-Next TP8 M1 all-reduce with native IPC state.
+
+All ranks must call the same shapes on the same ordered stream sequence.
+Setup uses only the supplied CPU group and must finish before graph capture.
+The communicator must retain this owner while any captured graph can replay.
+"""
+
+import importlib
+import os
+import socket
+import threading
+
+import torch
+import torch.distributed as dist
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+
+class QwenPeerAllReduce:
+    def __init__(self, cpu_group, device, width):
+        self.width = width
+        self.group = cpu_group
+        self.device = torch.device(device)
+        self.rank = dist.get_rank(cpu_group)
+        self.world_size = dist.get_world_size(cpu_group)
+        self.workspaces = {}
+        self.setup_errors = {}
+        self.calls = 0
+        self.capture_calls = 0
+        self._lock = threading.RLock()
+
+    def _gather(self, value):
+        values = [None] * self.world_size
+        dist.all_gather_object(values, value, group=self.group)
+        return values
+
+    def _prepare(self, key):
+        module = None
+        error = None
+        oom = False
+        supported = False
+        try:
+            module = importlib.import_module(
+                "vllm_xpu_kernels._qwen38_peer_general_C"
+            )
+            protocol = (
+                os.getenv("CCL_SYCL_ALLREDUCE_LL") == "twoshots"
+                and os.getenv("CCL_SYCL_ALLREDUCE_ARC") == "1"
+                and os.getenv("CCL_SYCL_LL_BUFFER_GLOBAL") == "0"
+                and int(os.getenv("CCL_SYCL_ALLREDUCE_LL_THRESHOLD", "0"))
+                >= self.width * 2
+            )
+            supported = (
+                self.world_size == 8
+                and self.width == 2560
+                and protocol
+                and getattr(module, "peer_m1_abi_version", None) == 2
+                and hasattr(module, "PeerM1WorkspaceV2")
+                and callable(getattr(module, "supported_device", None))
+                and module.supported_device()
+            )
+        except (ImportError, OSError, RuntimeError, ValueError) as exc:
+            error = str(exc)
+            oom = isinstance(exc, torch.OutOfMemoryError)
+        capabilities = self._gather(
+            dict(
+                supported=supported,
+                error=error,
+                host=socket.gethostname(),
+                oom=oom,
+            )
+        )
+        if any(c["oom"] for c in capabilities):
+            raise torch.OutOfMemoryError(
+                "TP8 peer capability check failed: " + repr(capabilities)
+            )
+        if (
+            not all(c["supported"] for c in capabilities)
+            or len({c["host"] for c in capabilities}) != 1
+        ):
+            self.setup_errors[key] = capabilities
+            self.workspaces[key] = None
+            return None
+
+        workspace = None
+        info = None
+        error = None
+        oom = False
+        try:
+            workspace = module.PeerM1WorkspaceV2(
+                self.rank, self.world_size, self.width
+            )
+            info = list(workspace.export_info())
+        except (RuntimeError, OSError) as exc:
+            error = str(exc)
+            oom = isinstance(exc, torch.OutOfMemoryError)
+        infos = self._gather(dict(info=info, error=error, oom=oom))
+        if any(c["oom"] for c in infos):
+            if workspace is not None:
+                workspace.close()
+            raise torch.OutOfMemoryError(
+                "TP8 peer allocation failed: " + repr(infos)
+            )
+        if all(c["info"] is not None and c["error"] is None for c in infos):
+            try:
+                for rank, peer in enumerate(infos):
+                    if rank != self.rank:
+                        workspace.open_peer(rank, peer["info"])
+            except (RuntimeError, OSError) as exc:
+                error = str(exc)
+                oom = isinstance(exc, torch.OutOfMemoryError)
+        else:
+            error = "peer workspace creation failed"
+        errors = self._gather(dict(error=error, oom=oom))
+        if any(e["error"] is not None for e in errors):
+            if workspace is not None:
+                workspace.close()
+            if any(e["oom"] for e in errors):
+                raise torch.OutOfMemoryError(
+                    "TP8 peer import failed: " + repr(errors)
+                )
+            self.setup_errors[key] = dict(creation=infos, imports=errors)
+            self.workspaces[key] = None
+            return None
+        self.workspaces[key] = workspace
+        return workspace
+
+    def try_run(self, tensor):
+        if (
+            self.world_size != 8
+            or self.width != 2560
+            or type(tensor) is not torch.Tensor
+            or tensor.device != self.device
+            or tensor.dtype != torch.float16
+            or tuple(tensor.shape) != (1, self.width)
+            or not tensor.is_contiguous()
+            or tensor.is_neg()
+            or tensor.is_conj()
+            or tensor.requires_grad
+            or tensor.data_ptr() % 4
+            or torch.compiler.is_compiling()
+            or torch._C._is_torch_function_mode_enabled()
+            or _get_current_dispatch_mode() is not None
+            or torch._C._get_tracing_state() is not None
+        ):
+            return False
+        stream = torch.xpu.current_stream(self.device)
+        key = stream.sycl_queue
+        with self._lock, torch.xpu.device(self.device):
+            if key not in self.workspaces:
+                if torch.xpu.is_current_stream_capturing():
+                    return False
+                workspace = self._prepare(key)
+            else:
+                workspace = self.workspaces[key]
+            if workspace is None:
+                return False
+            # A prepared model scope guarantees this device, stream and shape.
+            # A unilateral fallback here could make ranks choose different ops.
+            if not workspace.try_run(tensor):
+                raise RuntimeError(
+                    "prepared Qwen38 IPC tensor/stream contract changed"
+                )
+            self.calls += 1
+            self.capture_calls += int(torch.xpu.is_current_stream_capturing())
+            return True
+
+    def status(self):
+        with self._lock:
+            return [
+                dict(queue=key, epoch=values[0], error=values[1])
+                for key, owner in self.workspaces.items()
+                if owner is not None
+                for values in [owner.status()]
+            ]
+
+    def close(self):
+        """Release only after every referencing graph has been disposed."""
+        with self._lock:
+            for owner in self.workspaces.values():
+                if owner is not None:
+                    owner.close()
+            self.workspaces.clear()
