--- /dev/null
+++ b/vllm_xpu_kernels/qwen38_hc_fused.py
@@ -0,0 +1,159 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Optional M2--8 HC implementation, with an unchanged native fallback."""
+
+import importlib
+import threading
+from collections import Counter
+
+import torch
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+
+class HcFusedWorkspace:
+    def __init__(self, fallback=None, min_rows=2):
+        self.fallback = fallback
+        self.min_rows = min_rows
+        self.module = importlib.import_module("vllm_xpu_kernels._qwen38_hc_C")
+        if self.module.abi_version != 1:
+            raise RuntimeError("HC fused native ABI mismatch")
+        self.scratch = {}
+        self.captures = Counter()
+        self.calls = Counter()
+        self.fallback_calls = Counter()
+        self.lock = threading.RLock()
+
+    def _try_run(self, hidden, block, injection, nw, dw, uw, eps):
+        inputs = (hidden, block, injection, nw, dw, uw)
+        if (
+            type(hidden) is not torch.Tensor
+            or hidden.device.type != "xpu"
+            or hidden.ndim != 2
+            or not self.min_rows <= hidden.shape[0] <= 8
+            or eps != 1e-6
+            or torch.compiler.is_compiling()
+            or torch._C._is_torch_function_mode_enabled()
+            or _get_current_dispatch_mode() is not None
+            or torch._C._get_tracing_state() is not None
+        ):
+            return None
+        m = hidden.shape[0]
+        width, hidden_size = 10240, 2560
+        shapes = (
+            (m, width),
+            (m, hidden_size),
+            (m, 4),
+            (width,),
+            (336, width),
+            (width, 320),
+        )
+        for i, (tensor, shape) in enumerate(zip(inputs, shapes)):
+            if (
+                type(tensor) is not torch.Tensor
+                or tensor.device != hidden.device
+                or tensor.dtype != torch.float16
+                or tensor.layout != torch.strided
+                or tuple(tensor.shape) != shape
+                or tensor.requires_grad
+                or tensor.is_neg()
+                or tensor.is_conj()
+                or tensor.data_ptr() % 4
+                or (i != 2 and not tensor.is_contiguous())
+            ):
+                return None
+        if injection.stride(1) != 1 or injection.stride(0) < 4:
+            return None
+        stream = torch.xpu.current_stream(hidden.device)
+        key = (hidden.device.index, stream.sycl_queue, m)
+        scratch = self.scratch.get(key)
+        if scratch is None:
+            if torch.xpu.is_current_stream_capturing():
+                return None
+            prepare = getattr(self.module, "prepare", None)
+            if prepare is not None and not prepare(hidden):
+                return None
+            # vLLM may warm only the largest batch on the capture stream.
+            # Provision every supported size before any recording begins.
+            for rows in range(2, 9):
+                stream_key = (hidden.device.index, stream.sycl_queue, rows)
+                if stream_key not in self.scratch:
+                    self.scratch[stream_key] = (
+                        torch.empty(
+                            rows,
+                            width,
+                            device=hidden.device,
+                            dtype=hidden.dtype,
+                        ),
+                        torch.zeros(
+                            self.module.control_words,
+                            device=hidden.device,
+                            dtype=torch.int32,
+                        ),
+                        torch.zeros(1, device=hidden.device, dtype=torch.int32),
+                    )
+            scratch = self.scratch[key]
+        normed, control, status = scratch
+        combined = torch.empty_like(hidden)
+        down = torch.empty(m, 336, device=hidden.device, dtype=torch.float16)
+        mixed = torch.empty_like(block)
+        if not self.module.try_run(
+            *inputs, combined, normed, down, mixed, control, status, eps
+        ):
+            return None
+        self.calls[m] += 1
+        self.captures[m] += int(torch.xpu.is_current_stream_capturing())
+        return combined, mixed, down[:, 320:324]
+
+    def run(self, *args):
+        with self.lock:
+            result = self._try_run(*args)
+            if result is None:
+                self.fallback_calls[int(args[0].shape[0])] += 1
+                return self.fallback.run(*args)
+            return result
+
+    def try_run(self, *args):
+        with self.lock:
+            result = self._try_run(*args)
+            if result is None:
+                self.fallback_calls[int(args[0].shape[0])] += 1
+                return (
+                    self.fallback.try_run(*args)
+                    if self.fallback is not None
+                    else None
+                )
+            return result
+
+    def stats(self):
+        with self.lock:
+            errors = []
+            for key, state in self.scratch.items():
+                torch.xpu.synchronize(key[0])
+                errors.append(int(state[-1].item()))
+            return dict(
+                calls=dict(self.calls),
+                captures=dict(self.captures),
+                fallback_calls=dict(self.fallback_calls),
+                errors=errors,
+                prepared=[list(key) for key in self.scratch],
+            )
+
+
+def wrap_workspace_class(fallback, min_rows=4):
+    if fallback is None:
+        return None
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_hc_C")
+    except (ImportError, OSError):
+        return fallback
+    if getattr(module, "abi_version", None) != 1 or not callable(
+        getattr(module, "try_run", None)
+    ):
+        return fallback
+
+    class FusedWorkspace(HcFusedWorkspace):
+        _qwen_fused_hc = True
+
+        def __init__(self):
+            super().__init__(fallback(), min_rows=min_rows)
+
+    return FusedWorkspace
