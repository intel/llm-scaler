diff --git a/vllm_xpu_kernels/custom_all_reduce.py b/vllm_xpu_kernels/custom_all_reduce.py
new file mode 100644
index 0000000..9cd7937
--- /dev/null
+++ b/vllm_xpu_kernels/custom_all_reduce.py
@@ -0,0 +1,84 @@
+"""Python side of the XPU one-shot custom all-reduce (TP=2, Level Zero IPC).
+
+Usage (inside an initialized torch.distributed job):
+    cpu_group = dist.new_group(backend="gloo")
+    car = XpuCustomAllReduce(cpu_group, torch.device("xpu", local_rank))
+    if car.can_use(x):
+        car.all_reduce_(x)          # in place, on the current XPU stream
+    else:
+        dist.all_reduce(x, group=device_group)
+
+All ranks of the group must issue the same sequence of all_reduce_ calls
+(same sizes, same order) on their current stream, like any collective.
+"""
+
+import os
+from contextlib import nullcontext
+
+import torch
+import torch.distributed as dist
+
+
+def _ops():
+    import vllm_xpu_kernels._xpu_C  # noqa: F401
+
+    return torch.ops._xpu_C
+
+
+def is_available() -> bool:
+    try:
+        return hasattr(_ops(), "custom_ar_create")
+    except ImportError:
+        return False
+
+
+class XpuCustomAllReduce:
+    _SUPPORTED = (torch.float16, torch.bfloat16, torch.float32)
+
+    def __init__(self, cpu_group, device, max_bytes=128 * 1024):
+        self.disabled = True
+        self.group = cpu_group
+        self.world_size = dist.get_world_size(cpu_group)
+        self.rank = dist.get_rank(cpu_group)
+        if self.world_size != 2:
+            return  # only TP=2 is implemented
+        dev = torch.device(device)
+        ops = _ops()
+        self.max_bytes = max_bytes
+        with torch.xpu.device(dev):
+            self.handle = ops.custom_ar_create(max_bytes)
+            mine = list(ops.custom_ar_export(self.handle))
+            info = [None] * self.world_size
+            dist.all_gather_object(info, mine, group=cpu_group)
+            mask = int(os.environ.get("VLLM_XPU_CUSTOM_AR_IPC_MODES", "7"))
+            self.ipc_mode = ops.custom_ar_open(
+                self.handle, self.rank, info[1 - self.rank], mask
+            )
+        # both ranks must have imported before either may exit / free
+        dist.barrier(group=cpu_group)
+        self.device = dev
+        self._ar = ops.custom_ar_all_reduce_
+        self.disabled = False
+
+    def can_use(self, x: torch.Tensor) -> bool:
+        return (
+            not self.disabled
+            and x.device == self.device
+            and x.dtype in self._SUPPORTED
+            and x.is_contiguous()
+            and x.numel() * x.element_size() <= self.max_bytes
+        )
+
+    def all_reduce_(self, x: torch.Tensor) -> torch.Tensor:
+        self._ar(x, self.handle)
+        return x
+
+    def capture(self):
+        """IPC buffers and device epochs need no per-graph registration."""
+        return nullcontext()
+
+    def close(self):
+        if not self.disabled:
+            dist.barrier(group=self.group)
+            _ops().custom_ar_destroy(self.handle)
+            self.disabled = True
diff --git a/vllm_xpu_kernels/gemma_moe_fused_interface.py b/vllm_xpu_kernels/gemma_moe_fused_interface.py
new file mode 100644
index 0000000..6ea8b19
--- /dev/null
+++ b/vllm_xpu_kernels/gemma_moe_fused_interface.py
@@ -0,0 +1,139 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Routed per-tensor FP8 GELU-tanh experts for Gemma4 small-M decode.
+
+Small-M routing computes Gemma top-k weights with the active per-expert scale.
+Invalid expert IDs contribute zero. Dense MLP, normalization and TP reduction
+remain with the caller. Each plan owns scratch on the weights device; calls
+sharing scratch must be ordered, with separate plans for overlapping streams.
+"""
+
+from typing import Optional
+
+import torch
+
+HIDDEN, INTERMEDIATE, EXPERTS, TOP_K, MAX_TOKENS = 2816, 352, 128, 8, 8
+
+
+def is_available(device: Optional[torch.device] = None) -> bool:
+    try:
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+    except ImportError:
+        return False
+    if not torch.xpu.is_available() or (device is not None
+                                        and device.type != "xpu"):
+        return False
+    ops = torch.ops._xpu_C
+    if not all(
+            hasattr(ops, name) for name in (
+                "gemma_moe_fused_decode_interface",
+                "gemma_moe_topk_interface",
+                "is_xe2_arch",
+                "is_xe3_arch",
+            )):
+        return False
+    index = -1 if device is None or device.index is None else device.index
+    return ops.is_xe2_arch(index) or ops.is_xe3_arch(index)
+
+
+def supports(
+    dtype: torch.dtype,
+    weight_dtype: torch.dtype,
+    num_tokens: int,
+    hidden_size: int,
+    intermediate_size: int,
+    num_experts: int,
+    top_k: int,
+    device: Optional[torch.device] = None,
+) -> bool:
+    return (is_available(device) and dtype in (torch.float16, torch.bfloat16)
+            and weight_dtype == torch.float8_e4m3fn
+            and 1 <= num_tokens <= MAX_TOKENS
+            and (hidden_size, intermediate_size, num_experts, top_k)
+            == (HIDDEN, INTERMEDIATE, EXPERTS, TOP_K))
+
+
+def workspace_bytes(num_tokens: int) -> int:
+    if not 1 <= num_tokens <= MAX_TOKENS:
+        raise ValueError("Gemma fused decode supports 1..8 tokens")
+    rows = num_tokens * TOP_K
+    packed_offset = (4 * (2 + 5 * rows) + 255) // 256 * 256
+    return packed_offset + 2 * rows * (2 * HIDDEN + 3 * INTERMEDIATE)
+
+
+class XpuGemmaMoEFusedDecode:
+    """Holds active expert tensors and per-M, device-bound uint8 workspace."""
+
+    def __init__(
+        self,
+        w13: torch.Tensor,
+        s13: torch.Tensor,
+        w2: torch.Tensor,
+        s2: torch.Tensor,
+    ):
+        self.device = w13.device
+        if self.device.type != "xpu":
+            raise ValueError("expert weights must be on XPU")
+        if not is_available(self.device):
+            raise ValueError(
+                "Gemma fused decode requires Xe2/Xe3 kernels on this device")
+        for name, tensor in (
+            ("w13", w13),
+            ("s13", s13),
+            ("w2", w2),
+            ("s2", s2),
+        ):
+            if tensor.device != self.device or not tensor.is_contiguous():
+                raise ValueError(
+                    f"{name} must be contiguous on the weights device")
+        if (w13.shape != (EXPERTS, HIDDEN, 2 * INTERMEDIATE)
+                or w2.shape != (EXPERTS, INTERMEDIATE, HIDDEN)
+                or s13.shape != (EXPERTS, ) or s2.shape != (EXPERTS, )
+                or w13.dtype != torch.float8_e4m3fn
+                or w2.dtype != torch.float8_e4m3fn
+                or s13.dtype != torch.float32 or s2.dtype != torch.float32):
+            raise ValueError("unsupported Gemma per-expert FP8 layout")
+        if w13.data_ptr() % 64 or w2.data_ptr() % 64:
+            raise ValueError("expert matrices require 64-byte-aligned bases")
+        self.w13, self.s13, self.w2, self.s2 = w13, s13, w2, s2
+        self._workspace: dict[int, torch.Tensor] = {}
+
+    def workspace(self, num_tokens: int) -> torch.Tensor:
+        if num_tokens not in self._workspace:
+            self._workspace[num_tokens] = torch.empty(
+                workspace_bytes(num_tokens),
+                dtype=torch.uint8,
+                device=self.device,
+            )
+        return self._workspace[num_tokens]
+
+    def route(
+            self, logits: torch.Tensor, per_expert_scale: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if logits.device != self.device:
+            raise ValueError("router logits must be on the weights device")
+        return torch.ops._xpu_C.gemma_moe_topk_interface(
+            logits, per_expert_scale, TOP_K)
+
+    def forward(
+        self,
+        output: torch.Tensor,
+        hidden_states: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> torch.Tensor:
+        if hidden_states.device != self.device:
+            raise ValueError("hidden states must be on the weights device")
+        if hidden_states.ndim != 2:
+            raise ValueError("hidden states must be rank two")
+        torch.ops._xpu_C.gemma_moe_fused_decode_interface(
+            output,
+            hidden_states,
+            topk_weights,
+            topk_ids,
+            self.w13,
+            self.s13,
+            self.w2,
+            self.s2,
+            self.workspace(hidden_states.shape[0]),
+        )
+        return output
diff --git a/vllm_xpu_kernels/moe_shared_decode_interface.py b/vllm_xpu_kernels/moe_shared_decode_interface.py
new file mode 100644
index 0000000..3d9c712
--- /dev/null
+++ b/vllm_xpu_kernels/moe_shared_decode_interface.py
@@ -0,0 +1,211 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fused routed + shared-expert MoE forward for small-M decode on Xe2/Xe3.
+
+Wraps ``torch.ops._xpu_C.moe_shared_fused_decode_interface``: routed experts
+and the single sigmoid-gated shared expert run in one op (six kernels, no
+per-call allocation).
+
+FP16 or BF16 activations with fp8-e4m3 per-tensor (per-expert) weights and fp32
+scalar scales are supported, with SiLU activation and no bias. Padding expert
+IDs (-1) contribute zero to routed experts; the shared expert still runs.
+Valid expert IDs must be distinct within each token's top-k routes.
+The output is the per-rank partial sum (tensor-parallel reduction is left
+to the caller).
+"""
+
+import torch
+
+# Largest num_tokens * top_k handled by the kernel's routing map.
+_MAX_ROUTED_ROWS = 512
+# Xe block-2D descriptors use 24-bit byte widths/pitches.
+_MAX_BLOCK_2D_BYTES = (1 << 24) - 1
+
+
+def is_available() -> bool:
+    """Whether this build provides the fused decode op."""
+    try:
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+    except ImportError:
+        return False
+    return hasattr(torch.ops._xpu_C, "moe_shared_fused_decode_interface")
+
+
+def supports(
+    hidden_states_dtype: torch.dtype,
+    weight_dtype: torch.dtype,
+    num_tokens: int,
+    top_k: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> bool:
+    """Whether the op supports this configuration.
+
+    Requires FP16/BF16 activations, fp8-e4m3 per-tensor weights,
+    positive dimensions, num_tokens * top_k <= 512, and H/I multiples of
+    32. Each compact routed row must start at a 64-byte-aligned address.
+    """
+    return (is_available()
+            and hidden_states_dtype in (torch.float16, torch.bfloat16)
+            and weight_dtype == torch.float8_e4m3fn and num_tokens > 0
+            and top_k > 0 and num_tokens * top_k <= _MAX_ROUTED_ROWS
+            and hidden_size > 0 and hidden_size % 32 == 0
+            and hidden_size <= _MAX_BLOCK_2D_BYTES // 2
+            and intermediate_size > 0 and intermediate_size % 32 == 0
+            and intermediate_size <= _MAX_BLOCK_2D_BYTES // 4)
+
+
+def moe_shared_fused_workspace_bytes(
+    num_tokens: int,
+    top_k: int,
+    hidden_size: int,
+    w13_n: int,
+    w2_k: int,
+) -> int:
+    """Workspace size in bytes; must match the carve-out in the C++ op."""
+    if num_tokens <= 0 or top_k <= 0:
+        raise ValueError("num_tokens and top_k must be positive")
+    rows = num_tokens * top_k
+    if rows > _MAX_ROUTED_ROWS:
+        raise ValueError("num_tokens * top_k must not exceed 512")
+    if (hidden_size <= 0 or w2_k <= 0 or w13_n != 2 * w2_k or hidden_size % 32
+            or w2_k % 32 or hidden_size > _MAX_BLOCK_2D_BYTES // 2
+            or w2_k > _MAX_BLOCK_2D_BYTES // 4):
+        raise ValueError(
+            "H and I must be positive multiples of 32 within the block-2D "
+            "limits, and w13_n must equal 2 * I")
+    # A hot expert can span multiple tiles; reserve one tile per routed row.
+    umt = rows
+
+    def align(b: int) -> int:
+        return (b + 255) // 256 * 256
+
+    o_wperm = align(4 * (3 * umt + 1 + rows))
+    o_gate = align(o_wperm + 4 * rows)
+    o_ap = align(o_gate + 4 * num_tokens)
+    return o_ap + 2 * (rows * hidden_size + (rows + num_tokens) * w13_n +
+                       (rows + num_tokens) * w2_k + rows * hidden_size +
+                       num_tokens * hidden_size)
+
+
+class XpuMoESharedFusedDecode:
+    """Holds the weights of one MoE block and a per-M persistent workspace.
+
+    Weight layouts:
+      w13 [E, H, 2I] fp8-e4m3, w13_scales [E] fp32
+      w2  [E, I, H]  fp8-e4m3, w2_scales  [E] fp32
+      shared_w13 [H, 2I] fp8-e4m3, shared_w13_scale [1] fp32
+      shared_w2  [I, H]  fp8-e4m3, shared_w2_scale  [1] fp32
+      shared_gate [H] or [1, H] with the activation dtype
+
+    Matrices and hidden states require 64-byte-aligned base addresses;
+    shared_gate requires 32-byte alignment. Contiguous storage-offset views
+    do not necessarily meet those native requirements.
+
+    tile_m selects the GEMM M-tile (8 or 16); 0 lets the op pick by M.
+
+    Each instance is bound to its weights' device. Calls use the current XPU
+    stream; calls with the same M share workspace and must be ordered. Use
+    separate instances for overlapping calls on different streams.
+    """
+
+    def __init__(
+        self,
+        w13: torch.Tensor,
+        w13_scales: torch.Tensor,
+        w2: torch.Tensor,
+        w2_scales: torch.Tensor,
+        shared_w13: torch.Tensor,
+        shared_w13_scale: torch.Tensor,
+        shared_w2: torch.Tensor,
+        shared_w2_scale: torch.Tensor,
+        shared_gate: torch.Tensor,
+        top_k: int,
+        tile_m: int = 0,
+    ):
+        if tile_m not in (0, 8, 16):
+            raise ValueError("tile_m must be 0 (auto), 8 or 16")
+        self.device = w13.device
+        if self.device.type != "xpu":
+            raise ValueError("w13 must be an XPU tensor")
+        for name, tensor in (
+            ("w13_scales", w13_scales),
+            ("w2", w2),
+            ("w2_scales", w2_scales),
+            ("shared_w13", shared_w13),
+            ("shared_w13_scale", shared_w13_scale),
+            ("shared_w2", shared_w2),
+            ("shared_w2_scale", shared_w2_scale),
+            ("shared_gate", shared_gate),
+        ):
+            if tensor.device != self.device:
+                raise ValueError(
+                    f"{name} must be on the same XPU device as w13")
+        if w13.dim() != 3 or w2.dim() != 3:
+            raise ValueError("routed weights must be rank three")
+        num_experts, hidden, w13_n = w13.shape
+        if not (0 < num_experts <= 512 and 0 < top_k <= num_experts):
+            raise ValueError("require 1 <= top_k <= num_experts <= 512")
+        if w2.shape[0] != num_experts or w2.shape[2] != hidden:
+            raise ValueError(
+                "routed weight shapes must be [E, H, 2I], [E, I, H]")
+        # Validate dimensions before copying weights or allocating scratch.
+        moe_shared_fused_workspace_bytes(1, top_k, hidden, w13_n, w2.shape[1])
+        self.w13 = w13.contiguous()
+        self.w13_scales = w13_scales.contiguous()
+        self.w2 = w2.contiguous()
+        self.w2_scales = w2_scales.contiguous()
+        self.shared_w13 = shared_w13.contiguous()
+        self.shared_w13_scale = shared_w13_scale.reshape(1).contiguous()
+        self.shared_w2 = shared_w2.contiguous()
+        self.shared_w2_scale = shared_w2_scale.reshape(1).contiguous()
+        self.shared_gate = shared_gate.reshape(-1).contiguous()
+        self.top_k = top_k
+        self.num_experts = w13.shape[0]
+        self.tile_m = tile_m
+        self._ws: dict[int, torch.Tensor] = {}
+
+    def workspace(self, num_tokens: int) -> torch.Tensor:
+        """Return persistent scratch on this instance's weights' device."""
+        ws = self._ws.get(num_tokens)
+        if ws is None:
+            nbytes = moe_shared_fused_workspace_bytes(
+                num_tokens,
+                self.top_k,
+                self.w13.shape[1],
+                self.w13.shape[2],
+                self.w2.shape[1],
+            )
+            ws = torch.empty(nbytes, dtype=torch.uint8, device=self.device)
+            self._ws[num_tokens] = ws
+        return ws
+
+    def forward(
+        self,
+        output: torch.Tensor,
+        hidden_states: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> torch.Tensor:
+        """Writes routed + gated shared (per-rank partial sum) into output."""
+        if hidden_states.device != self.device:
+            raise ValueError(
+                "hidden_states must be on the same XPU device as w13")
+        ws = self.workspace(hidden_states.shape[0])
+        torch.ops._xpu_C.moe_shared_fused_decode_interface(
+            output,
+            hidden_states,
+            topk_ids,
+            topk_weights,
+            self.w13,
+            self.w13_scales,
+            self.w2,
+            self.w2_scales,
+            self.shared_w13,
+            self.shared_w13_scale,
+            self.shared_w2,
+            self.shared_w2_scale,
+            self.shared_gate,
+            ws,
+            self.tile_m,
+        )
+        return output
diff --git a/vllm_xpu_kernels/moe_shared_fused_interface.py b/vllm_xpu_kernels/moe_shared_fused_interface.py
new file mode 100644
index 0000000..4f0e090
--- /dev/null
+++ b/vllm_xpu_kernels/moe_shared_fused_interface.py
@@ -0,0 +1,405 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Fused routed + shared-expert MoE forward for small-M decode on Xe2/Xe3.
+
+Wraps ``torch.ops._xpu_C.moe_shared_fused_decode_interface``: routed experts
+and the single sigmoid-gated shared expert run in one op (six kernels, no
+per-call allocation).
+
+FP16 or BF16 activations with fp8-e4m3 per-tensor (per-expert) weights and fp32
+scalar scales are supported, with SiLU activation and no bias. The output is
+the per-rank partial sum (tensor-parallel reduction is left to the caller).
+"""
+
+import torch
+
+# Largest num_tokens * top_k handled by the kernel's routing map.
+_MAX_ROUTED_ROWS = 512
+# Limits of torch.ops._moe_C.router_gemv_topk_softmax (and of the fused
+# residual-add + RMSNorm variant, which also needs K <= 6144).
+_ROUTER_MAX_TOKENS = 16
+_ROUTER_NORM_MAX_HIDDEN = 6144
+_ROUTER_MAX_EXPERTS = 512
+_ROUTER_MAX_TOP_K = 16
+
+
+def _byte_ranges_overlap(a: torch.Tensor, b: torch.Tensor) -> bool:
+    """Check positive-stride byte spans, including distinct Storage owners.
+
+    Storage identity would incorrectly reject disjoint parameter views in a
+    shared flat buffer. Refresh validates layout/strides before this helper.
+    """
+    if a.device != b.device or a.numel() == 0 or b.numel() == 0:
+        return False
+
+    def span(tensor: torch.Tensor) -> tuple[int, int]:
+        start = tensor.data_ptr()
+        extent = 1 + sum(
+            (size - 1) * stride
+            for size, stride in zip(tensor.shape, tensor.stride()))
+        return start, start + extent * tensor.element_size()
+
+    a0, a1 = span(a)
+    b0, b1 = span(b)
+    return a0 < b1 and b0 < a1
+
+
+def is_available() -> bool:
+    """Whether this build provides the fused decode op."""
+    try:
+        import vllm_xpu_kernels._xpu_C  # noqa: F401
+    except ImportError:
+        return False
+    return hasattr(torch.ops._xpu_C, "moe_shared_fused_decode_interface")
+
+
+def router_is_available() -> bool:
+    """Whether this build provides the fused decode router op."""
+    try:
+        import vllm_xpu_kernels._moe_C  # noqa: F401
+    except ImportError:
+        return False
+    return hasattr(torch.ops._moe_C, "router_gemv_topk_softmax")
+
+
+def router_norm_supports(hidden_size: int) -> bool:
+    """Whether the residual-add + RMSNorm router variant supports hidden_size
+    (in addition to router_supports())."""
+    return (router_is_available() and hasattr(
+        torch.ops._moe_C, "router_resadd_norm_gemv_topk_softmax")
+            and hidden_size <= _ROUTER_NORM_MAX_HIDDEN)
+
+
+def router_supports(
+    router_weight_dtype: torch.dtype,
+    num_experts: int,
+    top_k: int,
+    hidden_size: int,
+) -> bool:
+    """Whether the fused FP16/BF16 router GEMV + softmax top-k supports
+    this configuration (for up to 16 tokens per call)."""
+    return (router_is_available()
+            and router_weight_dtype in (torch.float16, torch.bfloat16)
+            and num_experts <= _ROUTER_MAX_EXPERTS
+            and 1 <= top_k <= min(_ROUTER_MAX_TOP_K, num_experts)
+            and hidden_size % 128 == 0)
+
+
+def supports(
+    hidden_states_dtype: torch.dtype,
+    weight_dtype: torch.dtype,
+    num_tokens: int,
+    top_k: int,
+    hidden_size: int,
+    intermediate_size: int,
+) -> bool:
+    """Whether the op supports this configuration.
+
+    Requires FP16/BF16 activations, fp8-e4m3 per-tensor weights,
+    positive dimensions, num_tokens * top_k <= 512, and H/I multiples of
+    32. Each compact routed row must start at a 64-byte-aligned address.
+    """
+    return (is_available()
+            and hidden_states_dtype in (torch.float16, torch.bfloat16)
+            and weight_dtype == torch.float8_e4m3fn and num_tokens > 0
+            and top_k > 0 and num_tokens * top_k <= _MAX_ROUTED_ROWS
+            and hidden_size > 0 and hidden_size % 32 == 0
+            and hidden_size <= ((1 << 24) - 1) // 2 and intermediate_size > 0
+            and intermediate_size % 32 == 0
+            and intermediate_size <= ((1 << 24) - 1) // 4)
+
+
+def moe_shared_fused_workspace_bytes(
+    num_tokens: int,
+    top_k: int,
+    num_experts: int,
+    hidden_size: int,
+    w13_n: int,
+    w2_k: int,
+) -> int:
+    """Workspace size in bytes; must match the carve-out in the C++ op."""
+    rows = num_tokens * top_k
+    # One expert may require several M-tiles (e.g. M=16, tile_m=8).
+    # The tile map has at most one tile per routed row.
+    umt = rows
+
+    def align(b: int) -> int:
+        return (b + 255) // 256 * 256
+
+    o_wperm = align(4 * (3 * umt + 1 + rows))
+    o_gate = align(o_wperm + 4 * rows)
+    o_ap = align(o_gate + 4 * num_tokens)
+    return o_ap + 2 * (rows * hidden_size + (rows + num_tokens) * w13_n +
+                       (rows + num_tokens) * w2_k + rows * hidden_size +
+                       num_tokens * hidden_size)
+
+
+class XpuMoESharedFusedDecode:
+    """Holds weights and persistent workspace per device, stream and M.
+
+    Weight layouts:
+      w13 [E, H, 2I] fp8-e4m3, w13_scales [E] fp32
+      w2  [E, I, H]  fp8-e4m3, w2_scales  [E] fp32
+      shared_w13 [H, 2I] fp8-e4m3, shared_w13_scale [1] fp32
+      shared_w2  [I, H]  fp8-e4m3, shared_w2_scale  [1] fp32
+      shared_gate [H] or [1, H] with the activation dtype
+
+    tile_m selects the GEMM M-tile (8 or 16); 0 lets the op pick by M.
+
+    With router_weight ([E, H], activation dtype), forward_routed() computes the
+    softmax top-k routing (renormalized if renormalize) in the op, for up to
+    8 tokens per call.
+    """
+
+    def __init__(
+        self,
+        w13: torch.Tensor,
+        w13_scales: torch.Tensor,
+        w2: torch.Tensor,
+        w2_scales: torch.Tensor,
+        shared_w13: torch.Tensor,
+        shared_w13_scale: torch.Tensor,
+        shared_w2: torch.Tensor,
+        shared_w2_scale: torch.Tensor,
+        shared_gate: torch.Tensor,
+        top_k: int,
+        tile_m: int = 0,
+        router_weight: torch.Tensor | None = None,
+        renormalize: bool = True,
+    ):
+        assert tile_m in (0, 8, 16), "tile_m must be 0 (auto), 8 or 16"
+        self.w13 = w13.contiguous()
+        self.w13_scales = w13_scales.contiguous()
+        self.w2 = w2.contiguous()
+        self.w2_scales = w2_scales.contiguous()
+        self.shared_w13 = shared_w13.contiguous()
+        self.shared_w13_scale = shared_w13_scale.reshape(1).contiguous()
+        self.shared_w2 = shared_w2.contiguous()
+        self.shared_w2_scale = shared_w2_scale.reshape(1).contiguous()
+        self.shared_gate = shared_gate.reshape(-1).contiguous()
+        self.top_k = top_k
+        self.num_experts = w13.shape[0]
+        self.tile_m = tile_m
+        self._ws: dict[tuple[str, int | None, int, int], torch.Tensor] = {}
+        self.router_weight = (router_weight.contiguous()
+                              if router_weight is not None else None)
+        self.renormalize = renormalize
+        self._routing: dict[tuple[str, int | None, int, int],
+                            tuple[torch.Tensor, ...]] = {}
+
+    @staticmethod
+    def _cache_key(num_tokens: int,
+                   device: torch.device) -> tuple[str, int | None, int, int]:
+        device = torch.device(device)
+        if device.type == "xpu":
+            stream = torch.xpu.current_stream(device)
+            return (device.type, int(stream.device_index),
+                    int(stream.stream_id), num_tokens)
+        return device.type, device.index, 0, num_tokens
+
+    def refresh_weights(
+        self,
+        w13: torch.Tensor,
+        w13_scales: torch.Tensor,
+        w2: torch.Tensor,
+        w2_scales: torch.Tensor,
+        shared_w13: torch.Tensor,
+        shared_w13_scale: torch.Tensor,
+        shared_w2: torch.Tensor,
+        shared_w2_scale: torch.Tensor,
+        shared_gate: torch.Tensor,
+        router_weight: torch.Tensor | None = None,
+        *,
+        top_k: int | None = None,
+        renormalize: bool | None = None,
+    ) -> None:
+        """Refresh live weights without changing captured tensor addresses.
+
+        Complete metadata/alias validation precedes all writes. The caller
+        must finish an in-flight forward before reloading model weights.
+        """
+        if top_k is not None and top_k != self.top_k:
+            raise ValueError("refresh_weights cannot change top_k")
+        if renormalize is not None and renormalize != self.renormalize:
+            raise ValueError("refresh_weights cannot change renormalize")
+        if (router_weight is None) != (self.router_weight is None):
+            raise ValueError("refresh_weights router_weight presence changed")
+        updates = [
+            ("w13", self.w13, w13),
+            ("w13_scales", self.w13_scales, w13_scales),
+            ("w2", self.w2, w2),
+            ("w2_scales", self.w2_scales, w2_scales),
+            ("shared_w13", self.shared_w13, shared_w13),
+            ("shared_w13_scale", self.shared_w13_scale, shared_w13_scale),
+            ("shared_w2", self.shared_w2, shared_w2),
+            ("shared_w2_scale", self.shared_w2_scale, shared_w2_scale),
+            ("shared_gate", self.shared_gate, shared_gate),
+        ]
+        if self.router_weight is not None:
+            assert router_weight is not None
+            updates.append(
+                ("router_weight", self.router_weight, router_weight))
+        copies = []
+        for name, destination, source in updates:
+            if (not isinstance(source, torch.Tensor)
+                    or source.device != destination.device
+                    or source.dtype != destination.dtype
+                    or source.layout != torch.strided or source.is_neg()
+                    or source.is_conj()):
+                raise ValueError(f"refresh_weights invalid {name} metadata")
+            if name in ("shared_w13_scale", "shared_w2_scale"):
+                if source.numel() != 1:
+                    raise ValueError(f"refresh_weights invalid {name} shape")
+                source = source.reshape(1)
+            elif name == "shared_gate":
+                if tuple(source.shape) not in ((self.w13.shape[1], ),
+                                               (1, self.w13.shape[1])):
+                    raise ValueError(
+                        "refresh_weights invalid shared_gate shape")
+                source = source.reshape(-1)
+            if source.shape != destination.shape:
+                raise ValueError(f"refresh_weights invalid {name} shape")
+            if any(stride <= 0
+                   for size, stride in zip(source.shape, source.stride())
+                   if size > 1):
+                raise ValueError(f"refresh_weights invalid {name} strides")
+            same_view = (source.data_ptr() == destination.data_ptr()
+                         and source.stride() == destination.stride())
+            if not same_view and _byte_ranges_overlap(source, destination):
+                raise ValueError(f"refresh_weights overlapping {name} views")
+            if not same_view:
+                copies.append((destination, source))
+        # A source must not be overwritten by another pending update. This
+        # also catches swapped/partially overlapping cached parameter views.
+        for destination, source in copies:
+            for _, other, _ in updates:
+                if (other is not destination
+                        and _byte_ranges_overlap(source, other)):
+                    raise ValueError(
+                        "refresh_weights sources overlap cached weights")
+        with torch.no_grad():
+            for destination, source in copies:
+                destination.copy_(source)
+
+    def workspace(self, num_tokens: int, device: torch.device) -> torch.Tensor:
+        key = self._cache_key(num_tokens, device)
+        ws = self._ws.get(key)
+        if ws is None:
+            nbytes = moe_shared_fused_workspace_bytes(
+                num_tokens,
+                self.top_k,
+                self.num_experts,
+                self.w13.shape[1],
+                self.w13.shape[2],
+                self.w2.shape[1],
+            )
+            ws = torch.empty(nbytes, dtype=torch.uint8, device=device)
+            self._ws[key] = ws
+        return ws
+
+    def forward(
+        self,
+        output: torch.Tensor,
+        hidden_states: torch.Tensor,
+        topk_weights: torch.Tensor,
+        topk_ids: torch.Tensor,
+    ) -> torch.Tensor:
+        """Writes routed + gated shared (per-rank partial sum) into output."""
+        ws = self.workspace(hidden_states.shape[0], hidden_states.device)
+        torch.ops._xpu_C.moe_shared_fused_decode_interface(
+            output,
+            hidden_states,
+            topk_ids,
+            topk_weights,
+            self.w13,
+            self.w13_scales,
+            self.w2,
+            self.w2_scales,
+            self.shared_w13,
+            self.shared_w13_scale,
+            self.shared_w2,
+            self.shared_w2_scale,
+            self.shared_gate,
+            ws,
+            self.tile_m,
+        )
+        return output
+
+    def route(
+            self,
+            hidden_states: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """Softmax top-k routing of hidden_states with router_weight.
+
+        Returns (topk_weights fp32, topk_ids int32), [M, top_k] each; the
+        buffers are reused on the same device and stream for the same M.
+        """
+        assert self.router_weight is not None, "no router_weight given"
+        logits, topk_weights, topk_ids = self._routing_buffers(
+            hidden_states.shape[0], hidden_states.device)
+        torch.ops._moe_C.router_gemv_topk_softmax(
+            hidden_states,
+            self.router_weight,
+            logits,
+            topk_weights,
+            topk_ids,
+            self.renormalize,
+        )
+        return topk_weights, topk_ids
+
+    def _routing_buffers(self, m: int,
+                         device: torch.device) -> tuple[torch.Tensor, ...]:
+        key = self._cache_key(m, device)
+        bufs = self._routing.get(key)
+        if bufs is None:
+            bufs = (
+                torch.empty(m,
+                            self.num_experts,
+                            dtype=torch.float32,
+                            device=device),
+                torch.empty(m, self.top_k, dtype=torch.float32, device=device),
+                torch.empty(m, self.top_k, dtype=torch.int32, device=device),
+            )
+            self._routing[key] = bufs
+        return bufs
+
+    def forward_routed(
+            self, output: torch.Tensor,
+            hidden_states: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        """route() + forward(); returns (output, topk_ids)."""
+        topk_weights, topk_ids = self.route(hidden_states)
+        out = self.forward(output, hidden_states, topk_weights, topk_ids)
+        return out, topk_ids
+
+    def forward_resadd_norm_routed(
+        self,
+        output: torch.Tensor,
+        x: torch.Tensor,
+        residual: torch.Tensor,
+        norm_weight: torch.Tensor,
+        eps: float,
+        normed_out: torch.Tensor,
+        residual_out: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """MoE block including its input residual-add + Gemma RMSNorm.
+
+        residual_out = x + residual; normed_out = rms_norm(residual_out) *
+        (1 + norm_weight); then routing and experts on normed_out. The norm
+        and the routing run in one kernel. Returns (output, topk_ids).
+        """
+        assert self.router_weight is not None, "no router_weight given"
+        logits, topk_weights, topk_ids = self._routing_buffers(
+            x.shape[0], x.device)
+        torch.ops._moe_C.router_resadd_norm_gemv_topk_softmax(
+            x,
+            residual,
+            norm_weight,
+            eps,
+            self.router_weight,
+            logits,
+            topk_weights,
+            topk_ids,
+            normed_out,
+            residual_out,
+            self.renormalize,
+        )
+        out = self.forward(output, normed_out, topk_weights, topk_ids)
+        return out, topk_ids
