+  pybind11::class_<peer::PeerWorkspace, std::shared_ptr<peer::PeerWorkspace>>(
+      module, "PeerM1WorkspaceV2")
+      .def(pybind11::init<int, int, int>())
+      .def("export_info", &peer::PeerWorkspace::export_info)
+      .def("open_peer", &peer::PeerWorkspace::open_peer)
+      .def("try_run", &peer::PeerWorkspace::try_run)
