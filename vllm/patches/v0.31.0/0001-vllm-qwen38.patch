+def _bind_live_parameters(
+    owner,
+    inputs,
+    modules,
+    cache_names,
+    *,
+    parameter_names=None,
+    input_matrix_rows=None,
+    parameter_values=None,
+) -> bool:
+    if _gdn_projection_disabled() or torch.compiler.is_compiling():
+        return False
+    parameters: list[torch.Tensor] = []
+    default_names = (
+        "weight",
+        "bias",
+        "weight_scale",
+        "weight_scale_inv",
+        "weight_esimd",
+        "scale_esimd",
+        "A_log",
+        "dt_bias",
+    )
+    if parameter_values is not None:
+        # Only call-local live reads may be supplied, not cached source values.
+        parameters.extend(v for v in parameter_values if isinstance(v, torch.Tensor))
+    else:
+        for index, module in enumerate(modules):
+            for name in (
+                default_names if parameter_names is None else parameter_names[index]
+            ):
+                value = getattr(module, name, None)
+                if isinstance(value, torch.Tensor):
+                    parameters.append(value)
+    if not _direct_parameters(*inputs, *parameters) or any(
+        not _is_xpu_tensor(t) or t.dtype != torch.float16 or not t.is_contiguous()
+        for t in inputs
+    ):
+        return False
+    if input_matrix_rows is not None and (
+        inputs[0].ndim != 2 or inputs[0].shape[0] != input_matrix_rows
+    ):
+        return False
+    key = (*_stream_key(inputs[0]), tuple(cache_names))
+    active_keys = getattr(owner, "_esimd_live_active_keys", None)
+    if active_keys is None:
+        active_keys = {}
+        owner._esimd_live_active_keys = active_keys
+    scope = tuple(cache_names)
+    previous_key = active_keys.get(scope)
+    caches = getattr(owner, "_esimd_live_caches", None)
+    if caches is None:
+        caches = {}
+        owner._esimd_live_caches = caches
+    current = caches.get(key)
+    signature = _live_binding_signature(
+        parameters,
+        current[0] if current is not None else None,
+        use_snapshot=(using_qwen38_sycl() and bool(parameters)),
+    )
+    if previous_key == key and current is not None and current[0] == signature:
+        return True  # Live sources/modes checked; attributes are already bound.
+    if previous_key != key and previous_key in caches:
+        previous_signature, _ = caches[previous_key]
+        caches[previous_key] = (
+            previous_signature,
+            {
+                name: getattr(owner, name)
+                for name in cast(tuple[object, object, tuple[str, ...]], previous_key)[
+                    -1
+                ]
+                if hasattr(owner, name)
+            },
+        )
+    saved_signature, saved = caches.get(key, (None, {}))
+    for name in cache_names:
+        if hasattr(owner, name):
+            delattr(owner, name)
+    if saved_signature == signature:
+        for name, value in saved.items():
+            setattr(owner, name, value)
+    caches[key] = signature, saved if saved_signature == signature else {}
+    active_keys[scope] = key
+    return True
+
