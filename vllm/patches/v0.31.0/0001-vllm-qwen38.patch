+def _get_hc_combine_norm_multi_m_operation():
+    global _HC_COMBINE_NORM_MULTI_M_OPERATION
+    global _HC_COMBINE_NORM_MULTI_M_OPERATION_RESOLVED
+
+    if not _HC_COMBINE_NORM_MULTI_M_OPERATION_RESOLVED:
+        try:
+            operation = get_qwen38_hc_op(_HC_COMBINE_NORM_MULTI_M_OP_NAME)
