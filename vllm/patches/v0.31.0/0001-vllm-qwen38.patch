+@lru_cache(maxsize=1)
+def _binding_snapshot_factory():
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_C")
+    except (ImportError, OSError):
+        return None
+    factory = getattr(module, "TensorBindingSnapshotV1", None)
+    if factory is not None and not callable(factory):
+        raise RuntimeError("Invalid TensorBindingSnapshotV1 ABI")
+    return factory
+
+
+@lru_cache(maxsize=1)
+def _gdn_m1_workspace_factory():
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_C")
+    except (ImportError, OSError):
+        return None
+    factory = getattr(module, "GDNM1WorkspaceDirectV1", None)
+    if factory is not None and not callable(factory):
+        raise RuntimeError("Invalid GDNM1WorkspaceDirectV1 ABI")
