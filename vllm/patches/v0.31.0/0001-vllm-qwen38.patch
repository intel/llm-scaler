+            raise ValueError("Invalid Qwen38 draft position shape")
+        if self.uses_mrope:
+            out_positions = self.mrope_positions[:, :input_batch_size]
+            num_axes = positions.shape[0]
+            axis_stride = positions.stride(0)
+            out_axis_stride = out_positions.stride(0)
+        else:
+            out_positions = self.positions[:input_batch_size]
+            num_axes = 1
+            axis_stride = out_axis_stride = 0
+        block_table = common_attn_metadata.block_table_tensor
+        if (
+            block_table.ndim != 2
+            or block_table.shape[0] < batch_size
+            or block_table.shape[1] == 0
+            or common_attn_metadata.seq_lens.ndim != 1
+            or common_attn_metadata.seq_lens.shape[0] < batch_size
+            or out_positions.shape[-1] < input_batch_size
+            or self._slot_mapping_buffer.shape[0] < input_batch_size
+        ):
+            raise ValueError("Insufficient Qwen38 draft metadata/buffer capacity")
+        if input_batch_size:
+            _qwen38_draft_step_kernel[(input_batch_size,)](
+                positions,
+                axis_stride,
+                positions.stride(-1),
+                common_attn_metadata.seq_lens,
+                common_attn_metadata.seq_lens.stride(0),
+                block_table,
+                block_table.stride(0),
+                block_table.stride(1),
+                out_positions,
+                out_axis_stride,
+                out_positions.stride(-1),
+                self._slot_mapping_buffer[:input_batch_size],
+                batch_size,
+                NUM_AXES=num_axes,
+                BLOCK_SIZE=block_size,
+                NUM_BLOCKS=block_table.shape[1],
+                MAX_MODEL_LEN=self.max_model_len,
+                MAX_ROPE_POSITION=getattr(
+                    self, "_qwen38_max_rope_position", self.max_model_len
+                ),
+                PAD_ID=PAD_SLOT_ID,
+            )
+        common_attn_metadata.slot_mapping = self._slot_mapping_buffer[:batch_size]
+        common_attn_metadata.max_seq_len = min(
+            common_attn_metadata.max_seq_len + 1, self.max_model_len
+        )
+        if common_attn_metadata.seq_lens_cpu_upper_bound is not None:
+            common_attn_metadata.seq_lens_cpu_upper_bound += 1
+        # GPU advancement/clamping cannot preserve an exact CPU witness or a
+        # query-length-derived cache, nor the target batch's position proof.
+        common_attn_metadata._seq_lens_cpu = None
+        common_attn_metadata._num_computed_tokens_cache = None
+        common_attn_metadata._token_to_req_indices_cache = None
+        common_attn_metadata.mrope_positions_bounds_proven = False
+        return (
+            out_positions[:, :batch_size]
+            if self.uses_mrope
+            else out_positions[:batch_size]
+        )
