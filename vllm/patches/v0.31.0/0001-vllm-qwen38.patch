+        except Exception:
+            _record_qwen38_moe_m1_asymmetric(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+            raise
+
+        _record_qwen38_moe_m1_asymmetric(EVENT_ELIGIBLE, work_units)
+        _record_qwen38_moe_m1_asymmetric(EVENT_NATIVE_SUBMITTED, work_units)
+        try:
+            if plan.router_weight is not None:
+                native_output = plan.operation(
+                    hidden_states,
+                    plan.router_weight,
+                    plan.router_scale,
+                    plan.w13,
+                    plan.w13_scale,
+                    plan.w2,
+                    plan.w2_scale,
+                    plan.shared_w13,
+                    plan.shared_w2,
+                    plan.shared_expert_gate_weight,
+                    output,
+                    plan.experts_per_token,
+                    1,
+                    self.n_routed_experts,
+                )
+            else:
+                native_output = plan.operation(
+                    hidden_states,
+                    router_logits,
+                    plan.w13,
+                    plan.w13_scale,
+                    plan.w2,
+                    plan.w2_scale,
+                    plan.shared_w13,
+                    plan.shared_w2,
+                    plan.shared_expert_gate_weight,
+                    output,
+                    plan.experts_per_token,
+                    1,
+                    self.n_routed_experts,
