@@ -0,0 +1,106 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""图外一次性CPU状态快照诊断；默认关闭，绝不在已写cache上直接重跑。"""
+
+import json
+import os
+from pathlib import Path
+
+import torch
+
+from vllm.config import CUDAGraphMode
+
+
+def compare_replay(wrapper, state, context, original_metadata, args, kwargs, full):
+    tensors = {}
+    seen = set()
+    for name, layer in context.no_compile_layers.items():
+        cache = getattr(layer, "kv_cache", None)
+        values = cache if isinstance(cache, (tuple, list)) else (cache,)
+        for index, tensor in enumerate(values):
+            if not isinstance(tensor, torch.Tensor) or tensor.numel() == 0:
+                continue
+            binding = (tensor.data_ptr(), tensor.shape, tensor.stride(), tensor.dtype)
+            if binding not in seen:
+                tensors[f"cache:{name}:{index}"] = tensor
+                seen.add(binding)
+    for owner, ledger in state.prepared_history.items():
+        tensors[f"tags:{owner}"] = ledger.tags
+    total = sum(t.numel() * t.element_size() for t in tensors.values())
+    budget = int(os.getenv("QWEN38_VERIFY_COMPARE_CPU_BYTES", str(16 << 30)))
+    # 三份状态CPU副本及输出；没有同等大小的GPU clone。
+    if 3 * total > budget:
+        raise ValueError(
+            f"Paired state snapshot exceeds budget: {3 * total} > {budget}"
+        )
+    torch.xpu.synchronize()
+    before = {key: tensor.detach().cpu().clone() for key, tensor in tensors.items()}
+    output = full()
+    torch.xpu.synchronize()
+    after = {key: tensor.detach().cpu().clone() for key, tensor in tensors.items()}
+    expected_output = output.detach().cpu().clone()
+    hidden = wrapper.runnable.get_mtp_target_hidden_states()
+    expected_hidden = hidden[:5].detach().cpu().clone()
+
+    def restore(snapshot):
+        for key, tensor in tensors.items():
+            tensor.copy_(snapshot[key])
+        torch.xpu.synchronize()
+
+    try:
+        restore(before)
+        context.cudagraph_runtime_mode = CUDAGraphMode.NONE
+        context.attn_metadata = original_metadata
+        saved = context.additional_kwargs.pop("qwen38_xpu_full_decode_state")
+        try:
+            eager = wrapper.runnable(*args, **kwargs)
+            torch.xpu.synchronize()
+            actual_output = eager.detach().cpu().clone()
+            actual_hidden = hidden[:5].detach().cpu().clone()
+            actual_state = {
+                key: tensor.detach().cpu().clone() for key, tensor in tensors.items()
+            }
+        finally:
+            context.cudagraph_runtime_mode = CUDAGraphMode.FULL
+            context.attn_metadata = state.metadata
+            context.additional_kwargs["qwen38_xpu_full_decode_state"] = saved
+
+        def difference(a, b):
+            mismatch = a.view(torch.uint8) != b.view(torch.uint8)
+            return {
+                "shape": list(a.shape),
+                "different_bytes": int(mismatch.sum()),
+                "max_abs": float((a.float() - b.float()).abs().max()),
+                "reference_max": float(b.float().abs().max()),
+            }
+
+        report = {
+            "pid": os.getpid(),
+            "state_bytes": total,
+            "outputs": difference(expected_output, actual_output),
+            "mtp_hidden": difference(expected_hidden, actual_hidden),
+            "states": {
+                key: difference(after[key], actual_state[key]) for key in tensors
+            },
+        }
+        directory = Path(os.environ["QWEN38_VERIFY_COMPARE_DIR"])
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / f"pair_{os.getpid()}.json").write_text(
+            json.dumps(report, indent=2)
+        )
+        print(
+            "QWEN38_FULL_EAGER_PAIR "
+            + json.dumps(
+                {
+                    key: report[key]
+                    for key in ("pid", "state_bytes", "outputs", "mtp_hidden")
+                }
+            ),
+            flush=True,
+        )
+    finally:
+        restore(after)
+        output.copy_(expected_output)
+        hidden[:5].copy_(expected_hidden)
+        torch.xpu.synchronize()
+    return output
