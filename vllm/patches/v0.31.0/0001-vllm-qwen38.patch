@@ -0,0 +1,485 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import atexit
+import json
+import os
+from pathlib import Path
+
+PATH_QSA_SELECTION = 0
+PATH_QSA_ATTENTION = 1
+PATH_NGRAM_IDS = 2
+PATH_NGRAM_EMBEDDING_LOCAL = 3
+PATH_NGRAM_EMBEDDING_TP_REDUCE = 4
+PATH_PLE_STAGED_CHAIN = 5
+PATH_PLE_GROUPED_NORM = 6
+PATH_PLE_SCORE_GATE = 7
+PATH_PLE_GATED_VALUE = 8
+PATH_PLE_RESIDUAL_ADD = 9
+PATH_PLE_SHORT_CONV_DECODE = 10
+PATH_PLE_SHORT_CONV_PREFILL = 11
+PATH_PLE_SHORT_CONV_SPEC = 12
+PATH_PLE_MIXED_SPLIT_SCATTER = 13
+PATH_QSA_CACHE_STORE = 14
+PATH_HC_GROUPED_NORM = 15
+PATH_HC_GATE_MIX = 16
+PATH_HC_COMBINE = 17
+PATH_HC_COMBINE_NORM = 18
+PATH_HC_PROJECTION = 19
+PATH_PLE_GATED_VALUE_GROUPED_NORM = 20
+PATH_MOE_M1_ASYMMETRIC = 21
+PATH_MOE_MULTI_M_ASYMMETRIC = 22
+PATH_QSA_GROUP_COMPRESSION = 23
+PATH_COUNT = 24
+
+EVENT_ATTEMPT = 0
+EVENT_ELIGIBLE = 1
+EVENT_NATIVE_SUBMITTED = 2
+EVENT_FALLBACK = 3
+EVENT_HARD_ERROR_PREFLIGHT = 4
+EVENT_HARD_ERROR_POST_SUBMIT = 5
+EVENT_ZERO_WORK_SKIP = 6
+EVENT_COUNT = 7
+
+QSA_TOKEN_SPLIT_ATTEMPT = 0
+QSA_TOKEN_SPLIT_ELIGIBLE = 1
+QSA_TOKEN_SPLIT_SUBMITTED = 2
+QSA_TOKEN_SPLIT_WORKSPACE_ALLOCATED = 3
+QSA_TOKEN_SPLIT_WORKSPACE_REUSED = 4
+QSA_TOKEN_SPLIT_FALLBACK = 5
+QSA_TOKEN_SPLIT_EVENT_COUNT = 6
+
+REASON_NONE = 0
+REASON_DISABLED = 1
+REASON_DEVICE = 2
+REASON_DTYPE = 3
+REASON_SHAPE = 4
+REASON_LAYOUT = 5
+REASON_PAGE_SIZE = 6
+REASON_METADATA = 7
+REASON_SCENARIO_DECODE_PROOF = 8
+REASON_TP_GEOMETRY = 9
+REASON_COMPILE_GRAPH = 10
+REASON_OP_UNAVAILABLE = 11
+REASON_DSO_NOT_CONFIGURED = 12
+REASON_CAPACITY = 13
+REASON_OTHER_CONTRACT = 14
+REASON_COUNT = 15
+
+QSA_STAGE_SCORE = 0
+QSA_STAGE_TOP_K = 1
+QSA_STAGE_EXPAND = 2
+QSA_STAGE_COUNT = 3
+QSA_SELECTION_PHYSICAL_LAUNCH_GROUP_ID = 0
+
+_PATH_NAMES = (
+    "qsa_selection",
+    "qsa_attention",
+    "ngram_ids",
+    "ngram_embedding_local",
+    "ngram_embedding_tp_reduce",
+    "ple_staged_chain",
+    "ple_grouped_norm",
+    "ple_score_gate",
+    "ple_gated_value",
+    "ple_residual_add",
+    "ple_short_conv_decode",
+    "ple_short_conv_prefill",
+    "ple_short_conv_spec",
+    "ple_mixed_split_scatter",
+    "qsa_cache_store",
+    "hc_grouped_norm",
+    "hc_gate_mix",
+    "hc_combine",
+    "hc_combine_norm",
+    "hc_projection",
+    "ple_gated_value_grouped_norm",
+    "moe_m1_asymmetric",
+    "moe_multi_m_asymmetric",
+    "qsa_group_compression",
+)
+_EVENT_NAMES = (
+    "attempt",
+    "eligible",
+    "native_submitted",
+    "fallback",
+    "hard_error_preflight",
+    "hard_error_post_submit",
+    "zero_work_skip",
+)
+_QSA_TOKEN_SPLIT_EVENT_NAMES = (
+    "candidate_attempt",
+    "candidate_eligible",
+    "candidate_submitted",
+    "workspace_allocated",
+    "workspace_reused",
+    "candidate_fallback",
+)
+_REASON_NAMES = (
+    "none",
+    "disabled",
+    "device",
+    "dtype",
+    "shape",
+    "layout",
+    "page_size",
+    "metadata",
+    "scenario_decode_proof",
+    "tp_geometry",
+    "compile_graph",
+    "op_unavailable",
+    "dso_not_configured",
+    "capacity",
+    "other_contract",
+)
+_QSA_STAGE_NAMES = ("score", "top-k", "expand")
+_TRUE_ENV_VALUES = frozenset(("1", "true", "yes", "on"))
+
+NATIVE_STATS_ENABLED = (
+    os.environ.get("VLLM_XPU_QWEN38_NATIVE_STATS", "").strip().lower()
+    in _TRUE_ENV_VALUES
+)
+
+
+class NativeStats:
+    """Rank-local counters for Qwen3.8 native XPU paths."""
+
+    __slots__ = (
+        "enabled",
+        "_event_calls",
+        "_event_work_units",
+        "_fallback_calls",
+        "_fallback_work_units",
+        "_qsa_reuse_calls",
+        "_qsa_reuse_rows",
+        "_qsa_token_split_calls",
+        "_qsa_token_split_work_units",
+    )
+
+    def __init__(self, enabled: bool = True) -> None:
+        self.enabled = bool(enabled)
+        event_slots = PATH_COUNT * EVENT_COUNT
+        reason_slots = PATH_COUNT * REASON_COUNT
+        self._event_calls = [0] * event_slots
+        self._event_work_units = [0] * event_slots
+        self._fallback_calls = [0] * reason_slots
+        self._fallback_work_units = [0] * reason_slots
+        self._qsa_reuse_calls = 0
+        self._qsa_reuse_rows = 0
+        self._qsa_token_split_calls = [0] * QSA_TOKEN_SPLIT_EVENT_COUNT
+        self._qsa_token_split_work_units = [0] * QSA_TOKEN_SPLIT_EVENT_COUNT
+
+    @staticmethod
+    def _validate_path(path: int) -> None:
+        if type(path) is not int or not 0 <= path < PATH_COUNT:
+            raise ValueError("path must be a fixed PATH_* integer")
+
+    @staticmethod
+    def _validate_event(event: int) -> None:
+        if type(event) is not int or not 0 <= event < EVENT_COUNT:
+            raise ValueError("event must be a fixed EVENT_* integer")
+
+    @staticmethod
+    def _validate_work_units(work_units: int) -> None:
+        if type(work_units) is not int or work_units < 0:
+            raise ValueError("work_units must be a non-negative integer")
+
+    @staticmethod
+    def _validate_fallback_reason(reason: int) -> None:
+        if type(reason) is not int or not REASON_NONE < reason < REASON_COUNT:
+            raise ValueError("fallback reason must be a fixed REASON_* integer")
+
+    def record(
+        self,
+        path: int,
+        event: int,
+        work_units: int,
+        reason: int = REASON_NONE,
+    ) -> None:
+        """Record one event using only fixed integer dimensions."""
+        if not self.enabled:
+            return
+        self._validate_path(path)
+        self._validate_event(event)
+        self._validate_work_units(work_units)
+        if event == EVENT_FALLBACK:
+            self._validate_fallback_reason(reason)
+        elif reason != REASON_NONE:
+            raise ValueError("reason is valid only for fallback events")
+        if event == EVENT_ZERO_WORK_SKIP and work_units != 0:
+            raise ValueError("zero_work_skip must have zero work_units")
+
+        event_offset = path * EVENT_COUNT + event
+        self._event_calls[event_offset] += 1
+        self._event_work_units[event_offset] += work_units
+        if event == EVENT_FALLBACK:
+            reason_offset = path * REASON_COUNT + reason
+            self._fallback_calls[reason_offset] += 1
+            self._fallback_work_units[reason_offset] += work_units
+
+    def record_qsa_reuse(self, rows: int) -> None:
+        """Record one QSA selection reuse and its logical row count."""
+        if not self.enabled:
+            return
+        self._validate_work_units(rows)
+        self._qsa_reuse_calls += 1
+        self._qsa_reuse_rows += rows
+
+    def record_qsa_token_split(self, event: int, work_units: int) -> None:
+        """Record candidate-specific QSA route and workspace events."""
+        if not self.enabled:
+            return
+        if type(event) is not int or not 0 <= event < QSA_TOKEN_SPLIT_EVENT_COUNT:
+            raise ValueError("invalid QSA token-split event")
+        self._validate_work_units(work_units)
+        self._qsa_token_split_calls[event] += 1
+        self._qsa_token_split_work_units[event] += work_units
+
+    @staticmethod
+    def _ratio(numerator: int, denominator: int) -> float | None:
+        if denominator == 0:
+            return None
+        return numerator / denominator
+
+    def _ratios(self, values: list[int], path_offset: int) -> dict[str, float | None]:
+        attempt = values[path_offset + EVENT_ATTEMPT]
+        eligible = values[path_offset + EVENT_ELIGIBLE]
+        native = values[path_offset + EVENT_NATIVE_SUBMITTED]
+        return {
+            "native/attempt": self._ratio(native, attempt),
+            "eligible/attempt": self._ratio(eligible, attempt),
+            "native/eligible": self._ratio(native, eligible),
+        }
+
+    @staticmethod
+    def _lifecycle_invariants(
+        event_values: list[int],
+        event_offset: int,
+        fallback_values: list[int],
+        reason_offset: int,
+    ) -> dict[str, bool]:
+        attempt = event_values[event_offset + EVENT_ATTEMPT]
+        eligible = event_values[event_offset + EVENT_ELIGIBLE]
+        native = event_values[event_offset + EVENT_NATIVE_SUBMITTED]
+        fallback = event_values[event_offset + EVENT_FALLBACK]
+        hard_preflight = event_values[event_offset + EVENT_HARD_ERROR_PREFLIGHT]
+        hard_post_submit = event_values[event_offset + EVENT_HARD_ERROR_POST_SUBMIT]
+        fallback_reason_total = sum(
+            fallback_values[reason_offset + reason] for reason in range(1, REASON_COUNT)
+        )
+        invariants = {
+            "attempt_terminal_balance": (attempt == fallback + hard_preflight + native),
+            "native_submitted_lte_eligible_lte_attempt": (
+                native <= eligible <= attempt
+            ),
+            "hard_error_post_submit_lte_native_submitted": (hard_post_submit <= native),
+            "fallback_reason_balance": fallback_reason_total == fallback,
+        }
+        return {"ok": all(invariants.values()), **invariants}
+
+    def snapshot(self, reset: bool = False) -> dict[str, object]:
+        """Build/reset a snapshot at a quiescent worker control boundary."""
+        paths = []
+        for path, path_name in enumerate(_PATH_NAMES):
+            event_offset = path * EVENT_COUNT
+            reason_offset = path * REASON_COUNT
+            events = []
+            for event, event_name in enumerate(_EVENT_NAMES):
+                offset = event_offset + event
+                events.append(
+                    {
+                        "id": event,
+                        "name": event_name,
+                        "calls": self._event_calls[offset],
+                        "work_units": self._event_work_units[offset],
+                    }
+                )
+            fallback_reasons = []
+            for reason in range(1, REASON_COUNT):
+                offset = reason_offset + reason
+                fallback_reasons.append(
+                    {
+                        "id": reason,
+                        "name": _REASON_NAMES[reason],
+                        "calls": self._fallback_calls[offset],
+                        "work_units": self._fallback_work_units[offset],
+                    }
+                )
+            paths.append(
+                {
+                    "id": path,
+                    "name": path_name,
+                    "events": events,
+                    "fallback_reasons": fallback_reasons,
+                    "ratios": {
+                        "calls": self._ratios(self._event_calls, event_offset),
+                        "work_units": self._ratios(
+                            self._event_work_units, event_offset
+                        ),
+                    },
+                    "lifecycle_invariants": {
+                        "calls": self._lifecycle_invariants(
+                            self._event_calls,
+                            event_offset,
+                            self._fallback_calls,
+                            reason_offset,
+                        ),
+                        "work_units": self._lifecycle_invariants(
+                            self._event_work_units,
+                            event_offset,
+                            self._fallback_work_units,
+                            reason_offset,
+                        ),
+                    },
+                }
+            )
+
+        qsa_selection = []
+        for stage, stage_name in enumerate(_QSA_STAGE_NAMES):
+            qsa_selection.append(
+                {
+                    "stage_id": stage,
+                    "logical_stage": stage_name,
+                    "physical_launch_group_id": (
+                        QSA_SELECTION_PHYSICAL_LAUNCH_GROUP_ID
+                    ),
+                }
+            )
+
+        snapshot = {
+            "schema": "vllm.xpu.qwen38.native_stats.v2",
+            "enabled": self.enabled,
+            "scope": "rank_local",
+            "snapshot_consistency": "quiescent_worker_only",
+            "graph_observer": "unsupported",
+            "paths": paths,
+            "qsa": {
+                "reuse_calls": self._qsa_reuse_calls,
+                "reuse_rows": self._qsa_reuse_rows,
+                "token_split_candidate": {
+                    "events": [
+                        {
+                            "id": event,
+                            "name": _QSA_TOKEN_SPLIT_EVENT_NAMES[event],
+                            "calls": self._qsa_token_split_calls[event],
+                            "work_units": self._qsa_token_split_work_units[event],
+                        }
+                        for event in range(QSA_TOKEN_SPLIT_EVENT_COUNT)
+                    ]
+                },
+                "selection": qsa_selection,
+            },
+        }
+        if reset:
+            self.reset()
+        return snapshot
+
+    def reset(self) -> None:
+        """Reset arrays at a quiescent worker control boundary."""
+        for index in range(len(self._event_calls)):
+            self._event_calls[index] = 0
+            self._event_work_units[index] = 0
+        for index in range(len(self._fallback_calls)):
+            self._fallback_calls[index] = 0
+            self._fallback_work_units[index] = 0
+        self._qsa_reuse_calls = 0
+        self._qsa_reuse_rows = 0
+        for index in range(QSA_TOKEN_SPLIT_EVENT_COUNT):
+            self._qsa_token_split_calls[index] = 0
+            self._qsa_token_split_work_units[index] = 0
+
+
+NATIVE_STATS = NativeStats(NATIVE_STATS_ENABLED)
+
+
+def _dump_native_stats_at_exit() -> None:
+    """Optionally persist one rank-local diagnostic snapshot at worker exit."""
+    dump_dir = os.environ.get("VLLM_XPU_QWEN38_NATIVE_STATS_DUMP_DIR")
+    if not dump_dir:
+        return
+    try:
+        output_dir = Path(dump_dir)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        rank = os.environ.get("RANK", os.environ.get("LOCAL_RANK", "unknown"))
+        output = output_dir / f"native_stats_rank_{rank}_pid_{os.getpid()}.json"
+        output.write_text(json.dumps(NATIVE_STATS.snapshot(), sort_keys=True) + "\n")
+    except Exception:
+        # Diagnostics must never change worker shutdown behavior.
+        return
+
+
+if NATIVE_STATS_ENABLED:
+    atexit.register(_dump_native_stats_at_exit)
+
+
+def snapshot_native_stats(reset: bool = False) -> dict[str, object]:
+    """Snapshot process-global counters at a quiescent worker boundary."""
+    return NATIVE_STATS.snapshot(reset=reset)
+
+
+def reset_native_stats() -> None:
+    """Reset process-global counters at a quiescent worker boundary."""
+    NATIVE_STATS.reset()
+
+
+__all__ = [
+    "EVENT_ATTEMPT",
+    "EVENT_COUNT",
+    "EVENT_ELIGIBLE",
+    "EVENT_FALLBACK",
+    "EVENT_HARD_ERROR_POST_SUBMIT",
+    "EVENT_HARD_ERROR_PREFLIGHT",
+    "EVENT_NATIVE_SUBMITTED",
+    "EVENT_ZERO_WORK_SKIP",
+    "NATIVE_STATS",
+    "NATIVE_STATS_ENABLED",
+    "NativeStats",
+    "PATH_COUNT",
+    "PATH_HC_COMBINE",
+    "PATH_HC_COMBINE_NORM",
+    "PATH_HC_PROJECTION",
+    "PATH_HC_GATE_MIX",
+    "PATH_HC_GROUPED_NORM",
+    "PATH_NGRAM_EMBEDDING_LOCAL",
+    "PATH_NGRAM_EMBEDDING_TP_REDUCE",
+    "PATH_NGRAM_IDS",
+    "PATH_MOE_M1_ASYMMETRIC",
+    "PATH_MOE_MULTI_M_ASYMMETRIC",
+    "PATH_PLE_GATED_VALUE",
+    "PATH_PLE_GATED_VALUE_GROUPED_NORM",
+    "PATH_PLE_GROUPED_NORM",
+    "PATH_PLE_MIXED_SPLIT_SCATTER",
