+
+        num_tokens = main_metadata.num_actual_tokens
+        side_metadata = cast(
+            QSAForwardMetadata,
+            metadata[self.indexer.raw_key_cache.prefix],
+        )
+        compressed_metadata = cast(
+            QSAForwardMetadata,
+            metadata[self.indexer.compressed_key_cache.prefix],
+        )
+        if (
+            side_metadata.num_actual_tokens != num_tokens
+            or compressed_metadata.num_actual_tokens != num_tokens
+        ):
+            raise RuntimeError("QSA main and side metadata token counts disagree")
+        num_mapped_tokens = side_metadata.num_mapped_tokens
+        if compressed_metadata.num_mapped_tokens != num_mapped_tokens:
+            raise RuntimeError("QSA side metadata mapped token counts disagree")
+        if self.kv_cache.ndim != 4:
+            raise RuntimeError("QSA main K/V cache has an invalid rank")
+        main_page_size = int(self.kv_cache.shape[2])
+        compressed_key_cache = self.indexer.compressed_key_cache.kv_cache
+        if compressed_key_cache.ndim != 4:
+            raise RuntimeError("QSA compressed key cache has an invalid rank")
+        compressed_page_size = int(compressed_key_cache.shape[1])
+        if compressed_metadata.storage_block_size != compressed_page_size:
+            raise RuntimeError(
+                "QSA compressed metadata/cache page sizes disagree: "
+                f"metadata={compressed_metadata.storage_block_size}, "
+                f"cache={compressed_page_size}"
+            )
+        if compressed_metadata.compress_ratio != self.indexer.compress_ratio:
+            raise RuntimeError(
+                "QSA compressed metadata compression ratio disagrees: "
+                f"metadata={compressed_metadata.compress_ratio}, "
+                f"indexer={self.indexer.compress_ratio}"
+            )
+        if main_page_size != compressed_page_size * int(
+            compressed_metadata.compress_ratio
+        ):
+            raise RuntimeError(
+                "QSA main/compressed page sizes are incompatible: "
+                f"main={main_page_size}, compressed={compressed_page_size}, "
+                f"ratio={compressed_metadata.compress_ratio}"
+            )
+        selected = self.indexer(
+            hidden_states,
+            positions,
+            self.topk_indices_buffer[:num_tokens],
+        )
+        if selected.shape != (
+            num_tokens,
+            self.indexer.output_width,
+        ):
+            raise RuntimeError("QSA indexer returned an invalid selection shape")
+        impl = cast(Qwen3_8FlashNextQSAFlashAttentionImpl, self.impl)
+        impl.do_kv_cache_update(
+            self,
+            key,
+            value,
+            self.kv_cache,
+            main_metadata.slot_mapping,
+        )
+        impl.forward_qsa(
+            self,
+            query,
+            key,
+            value,
+            self.kv_cache,
+            main_metadata,
+            output,
+            token_to_req=side_metadata.token_to_req,
+            num_mapped_tokens=num_mapped_tokens,
+        )
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor:
+        qkv, _ = self.qkv_proj(hidden_states)
+        fused_qkv = None
+        positions_bounds_proven = False
+        # The Qwen3.8 checkpoint uses true three-axis MRoPE.  Only the
+        # versioned exact ABI may consume [3, T] positions; the existing
+        # plain/text helper is restricted to 1D positions here.
+        if (
+            envs.VLLM_XPU_ENABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and not envs.VLLM_XPU_DISABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+        ):
+            if (
+                positions.ndim == 2
+                or envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+            ):
+                try:
+                    forward_context = get_forward_context()
+                except AssertionError:
+                    forward_metadata = None
+                else:
+                    forward_metadata = getattr(forward_context, "attn_metadata", None)
+                if isinstance(forward_metadata, list):
+                    forward_metadata = (
+                        forward_metadata[0] if len(forward_metadata) == 1 else None
+                    )
+                if isinstance(forward_metadata, dict):
+                    layer_metadata = forward_metadata.get(self.layer_name)
+                    positions_bounds_proven = bool(
+                        getattr(
+                            layer_metadata,
+                            "mrope_positions_bounds_proven",
+                            False,
+                        )
+                    )
+            fused_qkv = try_esimd_qkv_mrope_postprocess(
+                qkv,
+                positions,
+                projection=self.qkv_proj,
+                norm_wq=self.q_norm.weight,
+                norm_wk=self.k_norm.weight,
+                cos_sin_cache=self.rotary_emb.cos_sin_cache,
+                q_heads=self.num_heads,
+                kv_heads=self.num_kv_heads,
+                head_dim=self.head_dim,
+                rotary_dim=self.rotary_emb.rotary_dim,
+                norm_epsilon=self.q_norm.variance_epsilon,
+                mrope_section=tuple(
+                    getattr(self.rotary_emb, "mrope_section", ()) or ()
+                ),
+                mrope_interleaved=bool(
+                    getattr(self.rotary_emb, "mrope_interleaved", False)
+                ),
+                attn_output_gate=self.attn_output_gate,
+                positions_bounds_proven=positions_bounds_proven,
+            )
+        if (
+            fused_qkv is None
+            and positions.ndim == 1
+            and envs.VLLM_XPU_ENABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+            and not envs.VLLM_XPU_DISABLE_QWEN38_QSA_QKV_MROPE_NATIVE
+        ):
+            fused_qkv = try_esimd_qkv_postprocess(
+                qkv,
+                positions,
+                projection=self.qkv_proj,
+                norm_wq=self.q_norm.weight,
+                norm_wk=self.k_norm.weight,
+                cos_sin_cache=self.rotary_emb.cos_sin_cache,
+                q_heads=self.num_heads,
+                kv_heads=self.num_kv_heads,
+                head_dim=self.head_dim,
+                rotary_dim=self.rotary_emb.rotary_dim,
+                norm_epsilon=self.q_norm.variance_epsilon,
+                is_neox_style=getattr(self.rotary_emb, "is_neox_style", False),
+                attn_output_gate=self.attn_output_gate,
+                text_only=False,
+                positions_bounds_proven=positions_bounds_proven,
+            )
+        if fused_qkv is None:
+            q, k, v, gate = self._project_qkv_gate(qkv, positions)
+            gate_is_sigmoid = False
+        else:
+            q, k, v, gate = fused_qkv
+            gate_is_sigmoid = True
+        num_tokens = hidden_states.shape[0]
+        query = q.view(num_tokens, self.num_heads, self.head_dim)
+        if not query.is_contiguous():
+            copy_bytes = query.numel() * query.element_size()
+            query = query.contiguous()
+            logger.info_once(
+                "QSA_QUERY_CONTIGUOUS_COPY bytes=%d rank=%s local_rank=%s",
+                copy_bytes,
+                os.environ.get("RANK", "unknown"),
+                os.environ.get("LOCAL_RANK", "unknown"),
+                scope="local",
+            )
+        key = k.view(num_tokens, self.num_kv_heads, self.head_dim)
+        value = v.view(num_tokens, self.num_kv_heads, self.head_dim)
+        attn_output = torch.empty_like(query)
+        encoded_layer_name = _encode_layer_name(self.layer_name)
+        if current_platform.opaque_attention_op():
+            torch.ops.vllm.qwen3_8_flash_next_qsa_with_output(
+                hidden_states,
+                positions,
+                query,
+                key,
+                value,
+                attn_output,
+                encoded_layer_name,
+            )
+        else:
+            qwen3_8_flash_next_qsa_with_output(
+                hidden_states,
+                positions,
+                query,
+                key,
+                value,
+                attn_output,
+                encoded_layer_name,
+            )
+        flat_output = attn_output.view(num_tokens, -1)
+        if gate is not None:
+            flat_output = _apply_qsa_attention_gate(flat_output, gate, gate_is_sigmoid)
+        output, _ = self.o_proj(flat_output)
+        return output
+
+
+def _apply_qsa_attention_gate(
+    flat_output: torch.Tensor,
+    gate: torch.Tensor,
+    gate_is_sigmoid: bool,
+) -> torch.Tensor:
+    if not gate_is_sigmoid:
+        gate = torch.sigmoid(gate)
+    can_update_in_place = (
+        flat_output.shape[0] == 1
+        and flat_output.shape == gate.shape
+        and flat_output.is_contiguous()
+        and gate.is_contiguous()
+        and flat_output.dtype == gate.dtype
+        and flat_output.device == gate.device
+        and not flat_output.requires_grad
+        and not gate.requires_grad
+        and not torch._C._is_alias_of(flat_output, gate)
+    )
+    if can_update_in_place:
+        flat_output.mul_(gate)
+        return flat_output
+    return flat_output * gate
+
+
+@eager_break_during_capture
+def qwen3_8_flash_next_qsa_with_output(
+    hidden_states: torch.Tensor,
+    positions: torch.Tensor,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: LayerNameType,
+) -> None:
+    """Run the complete QSA state/update/attend transaction."""
+    layer_name = _resolve_layer_name(layer_name)
+    layer = get_forward_context().no_compile_layers[layer_name]
+    if not isinstance(layer, Qwen3_8FlashNextQSAAttention):
+        raise TypeError(f"{layer_name} is not a Qwen3.8-Flash-Next QSA owner")
+    layer._run_qsa(
+        hidden_states,
+        positions,
+        query,
+        key,
+        value,
+        output,
+    )
+
+
+def qwen3_8_flash_next_qsa_with_output_fake(
+    hidden_states: torch.Tensor,
+    positions: torch.Tensor,
+    query: torch.Tensor,
+    key: torch.Tensor,
+    value: torch.Tensor,
+    output: torch.Tensor,
+    layer_name: LayerNameType,
+) -> None:
+    del hidden_states, positions, query, key, value, output, layer_name
+
+
+direct_register_custom_op(
+    op_name="qwen3_8_flash_next_qsa_with_output",
+    op_func=qwen3_8_flash_next_qsa_with_output,
+    mutates_args=["output"],
+    fake_impl=qwen3_8_flash_next_qsa_with_output_fake,
+)
+
+
+__all__ = [
+    "QSAIndexer",
+    "Qwen3_8FlashNextQSAAttention",
+    "Qwen3_8FlashNextQSAFlashAttentionBackend",
+    "Qwen3_8FlashNextQSAFlashAttentionImpl",
+    "qwen3_8_flash_next_qsa_with_output",
+]
