+        )
+        super().__post_init__()
+
+    def copy_with_new_block_size(self, block_size: int):
+        return replace(self, block_size=block_size, storage_block_size=None)
+
+    @classmethod
+    def merge(cls, specs):
+        if not all(spec == specs[0] for spec in specs):
+            raise ValueError("Qwen38 compressed cache owners must have one spec")
+        return copy.deepcopy(specs[0])
