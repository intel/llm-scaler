+                "callable": f"{all_reduce_module}.{all_reduce_name}",
+                "backend": backend,
+                "reduce_op": "sum",
+                "world_size": world_size,
+                "input_shape": tuple(pre_reduce_heads.shape),
+                "input_dtype": str(pre_reduce_heads.dtype),
+                "input_device": str(pre_reduce_heads.device),
+                "output_aliases_input": reduced.data_ptr()
