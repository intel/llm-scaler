+        if self._pending_capture.get("ids_parity_ok") is False:
+            raise RuntimeError("Qwen3.8 N-gram ID capture parity check failed")
+        if self._pending_capture.get("ids_domain_ok") is False:
+            raise RuntimeError("Qwen3.8 N-gram ID escaped the generated domain")
