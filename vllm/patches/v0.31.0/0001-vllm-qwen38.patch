+                    "stride": tuple(owner._esimd_local_partial.stride()),
+                    "storage_offset": owner._esimd_local_partial.storage_offset(),
+                },
+                "pre_reduce_heads": {
+                    "shape": tuple(pre_reduce_heads.shape),
+                    "stride": tuple(pre_reduce_heads.stride()),
+                    "storage_offset": pre_reduce_heads.storage_offset(),
+                },
+                "post_reduce_heads": {
+                    "shape": tuple(reduced.shape),
+                    "stride": tuple(reduced.stride()),
+                    "storage_offset": reduced.storage_offset(),
+                },
+                "flattened": {
+                    "shape": tuple(flattened.shape),
+                    "stride": tuple(flattened.stride()),
+                    "storage_offset": flattened.storage_offset(),
+                },
+                "flatten_aliases_reduced": flattened.data_ptr() == reduced.data_ptr(),
