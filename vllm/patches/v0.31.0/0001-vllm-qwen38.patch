+def _qsa_native_selection_fallback_reason(
+    q: torch.Tensor,
+    token_topk: int,
+    compress_ratio: int,
+) -> int:
+    if q.ndim != 3 or tuple(q.shape[1:]) != (4, 128):
+        return REASON_SHAPE
+    if q.dtype != torch.float16:
+        return REASON_DTYPE
+    if token_topk != 2048 or compress_ratio != 4:
+        return REASON_OTHER_CONTRACT
+    if q.device.type != "xpu":
+        return REASON_DEVICE
+    return REASON_OTHER_CONTRACT
