+        normalized = self._apply_norm(self.norm_conv, gated_value).flatten(-2)
+        conv_output = torch.zeros_like(normalized)
+        torch.ops.vllm.qwen3_8_flash_next_ple_short_conv(
+            normalized,
+            conv_output,
+            self.prefix,
