+
+@lru_cache(maxsize=1)
+def _gdn_spec_workspace_factory():
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_C")
+    except (ImportError, OSError):
+        return None
+    factory = getattr(module, "GDNSpecWorkspaceDirectV1", None)
