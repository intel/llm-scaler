+                        operation = compact80_ops()[0]
+                else:
+                    operation = get_qwen38_moe_m1_asymmetric_op()
+            except Qwen38MoeM1AsymmetricOpUnavailableError:
+                _record_qwen38_moe_m1_asymmetric(
+                    EVENT_FALLBACK, work_units, REASON_DSO_NOT_CONFIGURED
