new file mode 100644
index 0000000..b3dced4
--- /dev/null
+++ b/vllm/v1/spec_decode/qwen38.py
@@ -0,0 +1,400 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen3.8 MTP: ordinary attention plus two independent QSA cache groups."""
+
+import os
+from copy import copy
+from typing import Any
+
+import torch
+
+from vllm.compilation.breakable_cudagraph import BreakableCUDAGraphWrapper
+from vllm.config import CUDAGraphMode, get_layers_from_vllm_config
+from vllm.logger import init_logger
+from vllm.model_executor.layers.attention_layer_base import AttentionLayerBase
+from vllm.triton_utils import tl, triton
+from vllm.v1.attention.backend import CommonAttentionMetadata
+from vllm.v1.attention.backends.utils import PAD_SLOT_ID
+from vllm.v1.kv_cache_interface import KVCacheConfig, UniformTypeKVCacheSpecs
+from vllm.v1.spec_decode.eagle import EagleProposer
+from vllm.v1.worker.utils import AttentionGroup
+
+logger = init_logger(__name__)
+
+
+@triton.jit
+def _qwen38_draft_step_kernel(
+    positions_ptr,
+    positions_axis_stride,
+    positions_req_stride,
+    seq_lens_ptr,
+    seq_lens_stride,
+    block_table_ptr,
+    block_table_req_stride,
+    block_table_col_stride,
+    out_positions_ptr,
+    out_positions_axis_stride,
+    out_positions_req_stride,
+    out_slots_ptr,
+    batch_size,
+    NUM_AXES: tl.constexpr,
+    BLOCK_SIZE: tl.constexpr,
+    NUM_BLOCKS: tl.constexpr,
+    MAX_MODEL_LEN: tl.constexpr,
+    MAX_ROPE_POSITION: tl.constexpr,
+    PAD_ID: tl.constexpr,
+):
+    row = tl.program_id(0)
+    if row >= batch_size:
+        tl.store(out_slots_ptr + row, PAD_ID)
+        for axis in tl.static_range(NUM_AXES):
+            tl.store(
+                out_positions_ptr
+                + axis * out_positions_axis_stride
+                + row * out_positions_req_stride,
+                0,
+            )
+        return
+
+    # seq_lens already excludes rejected tokens. The next logical KV position
+    # is this length, not the MRoPE coordinate (which may carry an MM delta).
+    logical_position = tl.load(seq_lens_ptr + row * seq_lens_stride).to(tl.int64)
+    block_column = logical_position // BLOCK_SIZE
+    invalid = (
+        (logical_position < 0)
+        | (logical_position >= MAX_MODEL_LEN)
+        | (block_column >= NUM_BLOCKS)
+    )
+    for axis in tl.static_range(NUM_AXES):
+        position = tl.load(
+            positions_ptr + axis * positions_axis_stride + row * positions_req_stride
+        ).to(tl.int64)
+        next_position = position + 1
+        invalid = (
+            invalid
+            | (position < 0)
+            | (next_position < 0)
+            | (next_position >= MAX_ROPE_POSITION)
+        )
+
+    block_id = tl.load(
+        block_table_ptr
+        + row * block_table_req_stride
+        + tl.maximum(tl.minimum(block_column, NUM_BLOCKS - 1), 0)
+        * block_table_col_stride,
+        mask=~invalid,
+        other=0,
+    ).to(tl.int64)
+    slot = block_id * BLOCK_SIZE + logical_position % BLOCK_SIZE
+    tl.store(out_slots_ptr + row, tl.where(invalid, PAD_ID, slot))
+    tl.store(
+        seq_lens_ptr + row * seq_lens_stride,
+        tl.where(invalid, 1, logical_position + 1),
+    )
+    # Validate all axes before writing: the input may alias the output buffer.
+    for axis in tl.static_range(NUM_AXES):
+        position = tl.load(
+            positions_ptr + axis * positions_axis_stride + row * positions_req_stride
+        ).to(tl.int64)
+        tl.store(
+            out_positions_ptr
+            + axis * out_positions_axis_stride
+            + row * out_positions_req_stride,
+            tl.where(invalid, 0, position + 1),
+        )
+
+
+class Qwen38MTPProposer(EagleProposer):
+    """Keep Eagle's draft/rejection algorithm; route each QSA cache separately.
+
+    Raw circular keys, compressed keys, and attention K/V do not have the same
+    block geometry. They cannot use the single-group Eagle block table. QSA
+    builders calculate their own slots from the corrected device sequence
+    lengths, including during subsequent serial draft steps.
+    """
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self._qwen38_group_metadata: dict[int, CommonAttentionMetadata] = {}
+        self._qwen38_side_slot_mappings: dict[str, torch.Tensor] = {}
+        self._qwen38_side_slot_actual_tokens: int | None = None
+
+    def set_qwen38_per_group_attn_metadata(
+        self, gid: int, metadata: CommonAttentionMetadata
+    ) -> None:
+        self._qwen38_group_metadata[gid] = copy(metadata)
+
+    def _get_first_pass_output_rows(
+        self,
+        num_tokens: int,
+        num_input_tokens: int,
+        batch_size: int,
+        token_indices_to_sample: torch.Tensor,
+        cudagraph_runtime_mode: CUDAGraphMode,
+        mm_embed_inputs: tuple[list[torch.Tensor], torch.Tensor] | None,
+        num_rejected_tokens_gpu: torch.Tensor | None,
+    ) -> torch.Tensor | None:
+        if (
+            os.getenv("QWEN38_MTP_TAIL_ONLY_PREFILL", "0") != "1"
+            or self.method != "mtp"
+            or self.device.type != "xpu"
+            or cudagraph_runtime_mode != CUDAGraphMode.NONE
+            or self.supports_mm_inputs
+            or mm_embed_inputs is not None
+            or self.needs_extra_input_slots
+            or num_rejected_tokens_gpu is not None
+            or num_input_tokens != num_tokens
+            or not 0 < batch_size < num_tokens
+            or token_indices_to_sample.ndim != 1
+            or token_indices_to_sample.numel() != batch_size
+            or token_indices_to_sample.dtype not in (torch.int32, torch.int64)
+            or token_indices_to_sample.device != self.input_ids.device
+        ):
+            return None
+        parallel = self.vllm_config.parallel_config
+        model_config = self.vllm_config.model_config
+        # 后半段 MoE 的行数不同，DP/EP 的全局 token metadata 暂不在此候选范围。
+        if (
+            parallel.pipeline_parallel_size != 1
+            or parallel.tensor_parallel_size != 4
+            or parallel.data_parallel_size != 1
+            or parallel.enable_expert_parallel
+            or parallel.enable_eplb
+            or parallel.use_sequence_parallel_moe
+            or self.eplb_state is not None
+            or model_config.quantization != "sym_int4"
+            or model_config.dtype != torch.float16
+            or torch.xpu.is_current_stream_capturing()
+        ):
+            return None
+        model = self.model
+        if isinstance(model, BreakableCUDAGraphWrapper):
+            model = model.unwrap()
+        if getattr(model, "supports_qwen38_mtp_tail_only_prefill", False) is not True:
+            return None
+        inner = model.model
+        if (
+            inner.num_mtp_layers != 1
+            or len(inner.layers) != 1
+            or inner.layers[0].ple is not None
+            or inner.layers[0].layer_type != "full_attention"
+        ):
+            return None
+        logger.info_once("Using Qwen38 MTP post-attention tail-only prefill.")
+        return token_indices_to_sample
+
+    def initialize_attn_backend(
+        self,
+        kv_cache_config: KVCacheConfig,
+        kernel_block_sizes: list[int] | None = None,
+    ) -> None:
+        layers = get_layers_from_vllm_config(
+            self.vllm_config,
+            AttentionLayerBase,  # type: ignore[type-abstract]
+        )
+        groups = {}
+        primary_groups = set()
+        found_layers = set()
+        rope_limits = []
+        for gid, cache_group in enumerate(kv_cache_config.kv_cache_groups):
+            for name in sorted(
+                self._draft_attn_layer_names.intersection(cache_group.layer_names)
+            ):
+                spec = cache_group.kv_cache_spec
+                if isinstance(spec, UniformTypeKVCacheSpecs):
+                    spec = spec.kv_cache_specs[name]
+                backend = layers[name].get_attn_backend()
+                key = (gid, backend.full_cls_name(), spec)
+                if key not in groups:
+                    group = AttentionGroup(
+                        backend=backend,
+                        layer_names=[name],
