+def _hc_combine_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+) -> int | None:
+    if (
+        envs.VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NATIVE
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NATIVE
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or hidden_states.shape != (1, _HC_COMBINE_WIDTH)
+        or block_output.shape != (1, _HC_COMBINE_HIDDEN_SIZE)
+        or injection.shape != (1, _HC_COMBINE_COUNT)
+        or hc_count != _HC_COMBINE_COUNT
+    ):
+        return REASON_SHAPE
+    if (
+        hidden_states.dtype != torch.float16
+        or block_output.dtype != torch.float16
+        or injection.dtype != torch.float16
+    ):
+        return REASON_DTYPE
+    if (
+        hidden_states.device.type != "xpu"
+        or block_output.device != hidden_states.device
+        or injection.device != hidden_states.device
+    ):
+        return REASON_DEVICE
+    if (
+        not hidden_states.is_contiguous()
+        or not block_output.is_contiguous()
+        or not injection.is_contiguous()
+        or not _is_four_byte_aligned_fp16_view(hidden_states)
+        or not _is_four_byte_aligned_fp16_view(block_output)
+        or not _is_four_byte_aligned_fp16_view(injection)
+    ):
+        return REASON_LAYOUT
+    return None
+
+
+def _hc_combine_native_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_combine_input_fallback_reason(
+        hidden_states,
+        block_output,
+        injection,
+        hc_count,
+    )
+    if reason is not None:
+        return reason
+    if not isinstance(output, torch.Tensor):
+        return REASON_OTHER_CONTRACT
+    if output.shape != hidden_states.shape:
+        return REASON_SHAPE
+    if output.dtype != hidden_states.dtype:
+        return REASON_DTYPE
+    if output.device != hidden_states.device:
+        return REASON_DEVICE
+    if not output.is_contiguous() or not _is_four_byte_aligned_fp16_view(output):
+        return REASON_LAYOUT
+    if (
+        _tensors_alias(output, hidden_states)
+        or _tensors_alias(output, block_output)
+        or _tensors_alias(output, injection)
+    ):
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def should_prepare_hc_combine_output(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    hc_count: int,
+) -> bool:
+    """Return whether a caller should materialize the combine output."""
+    try:
+        return (
+            _hc_combine_input_fallback_reason(
+                hidden_states,
+                block_output,
+                injection,
+                hc_count,
+            )
+            is None
+        )
+    except Exception:
+        return False
+
+
+def _get_hc_combine_operation():
+    global _HC_COMBINE_OPERATION
+    global _HC_COMBINE_OPERATION_RESOLVED
+
+    if not _HC_COMBINE_OPERATION_RESOLVED:
+        try:
+            operation = get_qwen38_hc_op(_HC_COMBINE_OP_NAME)
+        except Qwen38HCOpUnavailableError:
+            operation = None
+        _HC_COMBINE_OPERATION = operation
+        _HC_COMBINE_OPERATION_RESOLVED = True
+    return _HC_COMBINE_OPERATION
+
+
+def _hc_combine_norm_multi_m_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> int | None:
+    if getattr(
+        envs,
+        "VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NORM_MULTI_M_NATIVE",
+        False,
+    ) or not getattr(
+        envs,
+        "VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NORM_MULTI_M_NATIVE",
+        False,
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or not _is_hc_multi_m_rows(int(hidden_states.shape[0]))
+        or hidden_states.shape[1] != _HC_COMBINE_WIDTH
+        or block_output.shape != (hidden_states.shape[0], _HC_COMBINE_HIDDEN_SIZE)
+        or injection.shape != (hidden_states.shape[0], _HC_COMBINE_COUNT)
+        or weight.shape != (_HC_COMBINE_WIDTH,)
+        or hc_count != _HC_COMBINE_COUNT
+    ):
+        return REASON_SHAPE
+    if any(
+        tensor.dtype != torch.float16
+        for tensor in (hidden_states, block_output, injection, weight)
+    ):
+        return REASON_DTYPE
+    eps_value = float(eps)
+    if (
+        not math.isfinite(eps_value)
+        or eps_value < _HC_FP32_MIN_POSITIVE
+        or eps_value > _HC_FP32_MAX
+    ):
+        return REASON_OTHER_CONTRACT
+    if hidden_states.device.type != "xpu" or any(
+        tensor.device != hidden_states.device
+        for tensor in (block_output, injection, weight)
+    ):
+        return REASON_DEVICE
+    if any(
+        not tensor.is_contiguous() or not _is_four_byte_aligned_fp16_view(tensor)
+        for tensor in (hidden_states, block_output, weight)
+    ) or (
+        # Merged HC down projections expose injection as [:, 320:324]
+        # of [M,336]. Read the row stride directly; do not copy per layer.
+        injection.stride(1) != 1
+        or injection.stride(0) < _HC_COMBINE_COUNT
+        or not _is_four_byte_aligned_fp16_view(injection)
+    ):
+        return REASON_LAYOUT
+    return None
+
+
+def _hc_combine_norm_multi_m_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    combine_output: torch.Tensor | None,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_combine_norm_multi_m_input_fallback_reason(
+        hidden_states, block_output, injection, weight, eps, hc_count
+    )
+    if reason is not None:
+        return reason
+    if not isinstance(combine_output, torch.Tensor) or not isinstance(
+        output, torch.Tensor
+    ):
+        return REASON_OTHER_CONTRACT
+    for candidate in (combine_output, output):
+        if candidate.shape != hidden_states.shape:
+            return REASON_SHAPE
+        if candidate.dtype != hidden_states.dtype:
+            return REASON_DTYPE
+        if candidate.device != hidden_states.device:
+            return REASON_DEVICE
+        if not candidate.is_contiguous() or not _is_four_byte_aligned_fp16_view(
+            candidate
+        ):
+            return REASON_LAYOUT
+    inputs = (hidden_states, block_output, injection, weight)
+    if any(
+        _tensors_alias(candidate, input_tensor)
+        for candidate in (combine_output, output)
+        for input_tensor in inputs
+    ) or _tensors_alias(combine_output, output):
+        return REASON_OTHER_CONTRACT
+    return None
+
+
+def _hc_combine_norm_input_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> int | None:
+    if (
+        envs.VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+        or not envs.VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+    ):
+        return REASON_DISABLED
+    if torch.compiler.is_compiling():
+        return REASON_COMPILE_GRAPH
+    if (
+        hidden_states.ndim != 2
+        or hidden_states.shape != (1, _HC_COMBINE_WIDTH)
+        or block_output.shape != (1, _HC_COMBINE_HIDDEN_SIZE)
+        or injection.shape != (1, _HC_COMBINE_COUNT)
+        or weight.shape != (_HC_COMBINE_WIDTH,)
+        or hc_count != _HC_COMBINE_COUNT
+    ):
+        return REASON_SHAPE
+    if (
+        hidden_states.dtype != torch.float16
+        or block_output.dtype != torch.float16
+        or injection.dtype != torch.float16
+        or weight.dtype != torch.float16
+    ):
+        return REASON_DTYPE
+    eps_value = float(eps)
+    if (
+        not math.isfinite(eps_value)
+        or eps_value < _HC_FP32_MIN_POSITIVE
+        or eps_value > _HC_FP32_MAX
+    ):
+        return REASON_OTHER_CONTRACT
+    if (
+        hidden_states.device.type != "xpu"
+        or block_output.device != hidden_states.device
+        or injection.device != hidden_states.device
+        or weight.device != hidden_states.device
+    ):
+        return REASON_DEVICE
+    if (
+        not hidden_states.is_contiguous()
+        or not block_output.is_contiguous()
+        or not injection.is_contiguous()
+        or not weight.is_contiguous()
+        or not _is_four_byte_aligned_fp16_view(hidden_states)
+        or not _is_four_byte_aligned_fp16_view(block_output)
+        or not _is_four_byte_aligned_fp16_view(injection)
+        or not _is_four_byte_aligned_fp16_view(weight)
+    ):
+        return REASON_LAYOUT
+    return None
+
+
+def _hc_combine_norm_native_fallback_reason(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    combine_output: torch.Tensor | None,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_combine_norm_input_fallback_reason(
+        hidden_states,
+        block_output,
+        injection,
+        weight,
+        eps,
+        hc_count,
+    )
+    if reason is not None:
+        return reason
+    outputs = (combine_output, output)
+    if not all(isinstance(candidate, torch.Tensor) for candidate in outputs):
+        return REASON_OTHER_CONTRACT
+    assert isinstance(combine_output, torch.Tensor)
+    assert isinstance(output, torch.Tensor)
+    for candidate in outputs:
+        if candidate.shape != hidden_states.shape:
+            return REASON_SHAPE
+        if candidate.dtype != hidden_states.dtype:
+            return REASON_DTYPE
+        if candidate.device != hidden_states.device:
+            return REASON_DEVICE
+        if not candidate.is_contiguous() or not _is_four_byte_aligned_fp16_view(
+            candidate
+        ):
+            return REASON_LAYOUT
+    inputs = (hidden_states, block_output, injection, weight)
+    if any(
+        _tensors_alias(candidate, input_tensor)
+        for candidate in outputs
+        for input_tensor in inputs
+    ) or _tensors_alias(combine_output, output):
+        return REASON_OTHER_CONTRACT
+    return None
