@@ -0,0 +1,305 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Qwen3.8 TP8/TP4 compact storage with unchanged group-128 quantization."""
+
+from functools import lru_cache
+
+import torch
+
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+def is_compact80(weight):
+    return getattr(weight, "_qwen38_compact80", False)
+
+
+def compact_intermediate(weight):
+    if is_compact80(weight):
+        return 80
+    return 160 if getattr(weight, "_qwen38_compact160", False) else 0
+
+
+def compact_weights(w13, s13, w2, intermediate, padded):
+    """Slice already-quantized bytes; retain the original W2 group scales."""
+    if intermediate not in (80, 160) or padded != (intermediate + 127) // 128 * 128:
+        raise ValueError("Unsupported Qwen3.8 compact dimensions")
+    q13 = torch.cat(
+        (w13[:, :intermediate], w13[:, padded : padded + intermediate]), dim=1
+    )
+    scales = torch.cat(
+        (s13[:, :intermediate], s13[:, padded : padded + intermediate]), dim=1
+    )
+    scales = guard_compact80_scales(scales, intermediate)
+    return q13.contiguous(), scales, w2[..., : intermediate // 2].contiguous()
+
+
+def guard_compact80_scales(scales, intermediate=80):
+    """Create the small CUTLASS N-tail guard before publishing scale aliases."""
+    guarded = torch.zeros(
+        scales.numel() + (-2 * intermediate % 256) * 20,
+        dtype=scales.dtype,
+        device=scales.device,
+    )
+    view = guarded[: scales.numel()].view_as(scales)
+    view.copy_(scales)
+    return view
+
+
+@lru_cache(maxsize=1)
+def compact80_ops():
+    from vllm.model_executor.layers.esimd_utils import (
+        load_esimd_library,
+        using_qwen38_sycl,
+    )
+
+    if using_qwen38_sycl():
+        from vllm_xpu_kernels.qwen38_moe import compact80_ops as native_ops
+
+        return native_ops()
+
+    names = [
+        "moe_forward_m1_cutlass_nmajor_int4_fp16_shared_compact80_out_v1",
+        "moe_forward_multi_m_cutlass_nmajor_int4_fp16_shared_compact80_out_v1",
+        "moe_compact80_down_grouped_gemm",
+        "qwen38_moe_compact80_weight_contract_v1",
+    ]
+    if not all(
+        torch._C._jit_get_schemas_for_operator("moe_int4_ops::" + n) for n in names
+    ):
+        load_esimd_library("moe_int4_ops")
+    if not all(
+        torch._C._jit_get_schemas_for_operator("moe_int4_ops::" + n) for n in names
+    ):
+        raise RuntimeError(
+            "Compact80 requires a matching moe_int4_ops build; restart with "
+            "VLLM_XPU_QWEN38_MOE_COMPACT=0 to use padded weights"
+        )
+    return tuple(getattr(torch.ops.moe_int4_ops, n) for n in names)
+
+
+@lru_cache(maxsize=1)
+def compact160_ops():
+    from vllm.model_executor.layers.esimd_utils import (
+        load_esimd_library,
+        using_qwen38_sycl,
+    )
+
+    if using_qwen38_sycl():
+        from vllm_xpu_kernels.qwen38_moe import compact160_ops as native_ops
+
+        return native_ops()
+
+    names = (
+        "moe_forward_compact160_out_v1",
+        "moe_forward_compact160_out_v1",
+        "moe_compact160_down_grouped_gemm",
+        "qwen38_moe_compact160_weight_contract_v1",
+        "moe_forward_compact160_router_out_v1",
+    )
+    if not all(
+        torch._C._jit_get_schemas_for_operator("moe_int4_ops::" + n) for n in names
+    ):
+        load_esimd_library("moe_int4_ops")
+    if not all(
+        torch._C._jit_get_schemas_for_operator("moe_int4_ops::" + n) for n in names
+    ):
+        raise RuntimeError(
+            "Compact160 requires a matching moe_int4_ops build; restart with "
+            "VLLM_XPU_QWEN38_MOE_COMPACT=0 to use padded weights"
+        )
+    return tuple(getattr(torch.ops.moe_int4_ops, n) for n in names)
+
+
+def make_xpu_fused_moe(**kwargs):
+    from vllm_xpu_kernels.fused_moe_interface import XpuFusedMoe
+
+    if not compact_intermediate(kwargs["w13"]):
+        original13, original2 = kwargs["w13"], kwargs["w2"]
+        if original13.dtype == torch.int8 and getattr(
+            original13, "xpu_fused_moe", False
+        ):
+            # A previous consumer converted the canonical U4 bytes to S4.
+            # Preserve INT4 recipe selection without applying zero-point
+            # conversion again when the modular fallback creates a wrapper.
+            if original2.dtype != torch.int8:
+                raise ValueError(
+                    "Converted INT4 MoE weights must both use signed bytes"
+                )
+            kwargs = dict(kwargs)
+            kwargs["w13"] = original13.view(torch.uint8)
+            kwargs["w2"] = original2.view(torch.uint8)
+            kwargs["w13"].xpu_fused_moe = True
+            impl = XpuFusedMoe(**kwargs)
+            impl.w13, impl.w2 = original13, original2
+            return impl
+        return XpuFusedMoe(**kwargs)
+    return _compact_class()(**kwargs)
+
+
+@lru_cache(maxsize=1)
+def _compact_class():
+    from vllm_xpu_kernels.fused_moe_interface import XpuFusedMoe
+
+    class Compact80FusedMoe(XpuFusedMoe):
+        def __init__(self, **kwargs):
+            intermediate = compact_intermediate(kwargs["w13"])
+            self._compact_ops = (
+                compact80_ops() if intermediate == 80 else compact160_ops()
+            )
+            original13, original2 = kwargs["w13"], kwargs["w2"]
+            # Another consumer may already have converted this canonical U4
+            # parameter to signed S4. Do not apply implement_zp a second time.
+            converted = original13.dtype == torch.int8
+            if converted:
+                kwargs = dict(kwargs)
+                kwargs["w13"] = original13.view(torch.uint8)
+                kwargs["w2"] = original2.view(torch.uint8)
+                kwargs["w13"].xpu_fused_moe = True
+            super().__init__(**kwargs)
+            if self._use_ref:
+                raise ValueError(
+                    "compact MoE does not support the debug reference backend"
+                )
+            if converted:
+                self.w13, self.w2 = original13, original2
+            if (
+                self.w13.shape != (512, 2 * intermediate, 1280)
+                or self.w2.shape != (512, 2560, intermediate // 2)
+                or self.gemm1_wei_scales.shape != (512, 2 * intermediate, 20)
+                or self.gemm2_wei_scales.shape
+                != (512, 2560, (intermediate + 127) // 128)
+                or self.ep_size != 1
+                or self.w13_bias is not None
+                or self.w2_bias is not None
+                or self.activation != "silu"
+            ):
+                raise ValueError("Unsupported compact MoE geometry")
+            # Existing CUTLASS GEMM masks N-tail outputs, but its scale loader
+            # can read as far as the end of a 256-column tile. Retain only a
+            # tail guard AFTER the final expert, not per-expert padding
+            # (96 rows for I80, 192 for I160).
+            scales = self.gemm1_wei_scales
+            guard_rows = -2 * intermediate % 256
+            required_bytes = (
+                scales.storage_offset() + scales.numel() + guard_rows * 20
+            ) * 2
+            if scales.untyped_storage().nbytes() < required_bytes:
+                raise ValueError(
+                    "compact MoE W13 scales require the load-time tail guard"
+                )
+            logger.info_once(
+                "Qwen3.8 compact MoE enabled: physical I=%d, unchanged group128 "
+                "scales; native decode and direct compact prefill.",
+                intermediate,
+            )
+
+        def apply(
+            self,
+            output,
+            hidden_states,
+            topk_weights,
+            topk_ids,
+            expert_map=None,
+            a1q_scale=None,
+        ):
+            if (
+                a1q_scale is not None
+                or expert_map is not None
+                or hidden_states.dtype != torch.float16
+                or hidden_states.shape[1] != 2560
+            ):
+                raise ValueError(
+                    "compact MoE supports FP16 activations without EP only"
+                )
+            return self._apply_direct(output, hidden_states, topk_weights, topk_ids)
+
+        def _apply_direct(
+            self,
+            output,
+            hidden_states,
+            topk_weights,
+            topk_ids,
+            expert_map=None,
+            a1q_scale=None,
+        ):
+            num_rows, hidden_size = hidden_states.shape
+            num_moe_inputs = self.n_experts_per_token * num_rows
+            remapped_hidden_states = torch.empty(
+                (num_rows * self.n_experts_per_token, hidden_size),
+                dtype=hidden_states.dtype,
+                device=hidden_states.device,
+            )
+            rows_per_expert = torch.empty(
+                (self.num_experts), dtype=torch.int32, device=hidden_states.device
+            )
+            if num_moe_inputs > 256:
+                rows_per_expert.zero_()
+            unpermuted_row_to_permuted_row = torch.empty(
+                (num_rows, self.n_experts_per_token),
+                dtype=torch.int32,
+                device=hidden_states.device,
+            )
+
+            torch.ops._moe_C.remap_hidden_states(
+                hidden_states=hidden_states,
+                hidden_states_scales=None,
+                remapped_hidden_states=remapped_hidden_states,
+                remapped_hidden_states_scales=None,
+                expert_map=expert_map,
+                rows_per_expert=rows_per_expert,
+                unpermuted_row_to_permuted_row=unpermuted_row_to_permuted_row,
+                topk_ids=topk_ids,
+                total_experts_num=self.total_experts_num,
+                local_experts_num=self.local_experts_num,
+            )
+
+            ########### gemm1 ##################
+            gemm1_output = torch.empty(
+                (num_moe_inputs, 2 * self.inter_size),
+                dtype=output.dtype,
+                device=output.device,
+            )
+            torch.ops._xpu_C.cutlass_grouped_gemm_interface(
+                ptr_A=remapped_hidden_states,
+                ptr_A_scale=None,
+                ptr_B=self.w13,
+                ptr_B_scale=self.gemm1_wei_scales,
+                ptr_bias=self.w13_bias,
+                ptr_D=gemm1_output,
+                rows_per_expert=rows_per_expert,
+                N=2 * self.inter_size,
+                K=hidden_size,
+                num_experts=self.num_experts,
+            )
+
+            # Apply swiglu_limit clamping before activation
+            if self.gemm1_clamp_limit is not None and self.gemm1_clamp_limit > 0:
+                gate = gemm1_output[:, : self.inter_size]
+                up = gemm1_output[:, self.inter_size :]
+                gate.clamp_(max=self.gemm1_clamp_limit)
+                up.clamp_(min=-self.gemm1_clamp_limit, max=self.gemm1_clamp_limit)
+
+            # act
+            act_output = torch.empty(
+                (num_moe_inputs, self.inter_size * self.inter_size_scale),
+                dtype=gemm1_output.dtype,
+                device=gemm1_output.device,
+            )
+            self.act_func(act_output, gemm1_output)
+
+            ########### gemm2 ##################
+            gemm2_output = self._compact_ops[2](
+                act_output, self.w2, self.gemm2_wei_scales, rows_per_expert
+            )
+
+            torch.ops._moe_C.moe_gather(
+                output,
+                gemm2_output,
+                topk_weights,
+                unpermuted_row_to_permuted_row,
+                self.num_experts,
+            )
+
+    return Compact80FusedMoe
diff --git a/vllm/model_executor/layers/quantization/_sym_int4_esimd.py b/vllm/model_executor/layers/quantization/_sym_int4_esimd.py
