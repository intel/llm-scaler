@@ -0,0 +1,309 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""B1/M2..8 FULL target；图外准备 lease，图内保留设备历史校验。"""
+
+from __future__ import annotations
+
+import os
+from copy import copy
+from typing import Any
+
+import torch
+
+from vllm.compilation.cuda_graph import CUDAGraphWrapper
+from vllm.compilation.monitor import validate_cudagraph_capturing_enabled
+from vllm.config import CUDAGraphMode
+from vllm.forward_context import get_forward_context, is_forward_context_available
+from vllm.logger import init_logger
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+
+from .full_decode import (
+    _CONTEXT_KEY,
+    Qwen38FullDecodeCUDAGraphWrapper,
+)
+from .full_verify import Qwen38FullVerifyState
+from .ops.qsa_history import QSADeviceRingLedger
+from .short_conv import PleShortConvAttentionMetadata
+
+logger = init_logger(__name__)
+
+
+def full_verify_requested() -> bool:
+    return os.getenv("VLLM_XPU_QWEN38_FULL_VERIFY", "0") == "1"
+
+
+def full_verify_enabled(config) -> bool:
+    spec = config.speculative_config
+    return bool(
+        full_verify_requested()
+        and config.compilation_config.cudagraph_mode == CUDAGraphMode.FULL_DECODE_ONLY
+        and spec is not None
+        and spec.method == "mtp"
+        and 1 <= spec.num_speculative_tokens <= 7
+        and getattr(config.model_config.hf_text_config, "model_type", None)
+        in {
+            "qwen3_8_flash_next",
+            "qwen3_8_flash_next_text",
+            "qwen4_exp",
+            "qwen4_exp_text",
+        }
+    )
+
+
+class Qwen38FullVerifyCUDAGraphWrapper(Qwen38FullDecodeCUDAGraphWrapper):
+    """接收配置对应的真实verify行数；提交前检查输入/缓存重绑定。"""
+
+    def __init__(self, *args: Any, **kwargs: Any):
+        super().__init__(*args, **kwargs)
+        # target 的输出仍由采样器/draft 消费，不与 draft 的临时分配共用池。
+        self.graph_pool = current_platform.graph_pool_handle()
+
+    @staticmethod
+    def _dummy_metadata(metadata, num_tokens):
+        # 预估warm-up将verify行当prefill；构造无真实状态写入的spec布局。
+        result: dict[str, Any] = {}
+        objects: dict[int, Any] = {}
+        for name, source in metadata.items():
+            target = objects.get(id(source))
+            if target is None:
+                target = copy(source)
+                objects[id(source)] = target
+                if isinstance(
+                    target, (GDNAttentionMetadata, PleShortConvAttentionMetadata)
+                ):
+                    device = next(
+                        t.device
+                        for t in vars(source).values()
+                        if isinstance(t, torch.Tensor) and t.device.type == "xpu"
+                    )
+                    target.num_actual_tokens = target.num_spec_decode_tokens = (
+                        num_tokens
+                    )
+                    target.num_spec_decodes = 1
+                    target.num_decodes = target.num_decode_tokens = 0
+                    target.num_prefills = target.num_prefill_tokens = 0
+                    vars(target)["uniform_spec_sequence_length"] = num_tokens
+                    target.spec_sequence_masks = torch.ones(
+                        1, dtype=torch.bool, device=device
+                    )
+                    vars(target)["spec_sequence_masks_cpu"] = torch.ones(
+                        1, dtype=torch.bool
+                    )
+                    target.spec_state_indices_tensor = torch.zeros(
+                        (1, num_tokens)
+                        if isinstance(target, GDNAttentionMetadata)
+                        else (1,),
+                        dtype=torch.int32,
+                        device=device,
+                    )
+                    target.spec_query_start_loc = torch.tensor(
+                        [0, num_tokens], dtype=torch.int32, device=device
+                    )
+                    target.spec_token_indx = torch.arange(
+                        num_tokens, dtype=torch.int32, device=device
+                    )
+                    target.non_spec_token_indx = torch.empty(
+                        0, dtype=torch.int32, device=device
+                    )
+                    target.num_accepted_tokens = torch.ones(
+                        1, dtype=torch.int32, device=device
+                    )
+            result[name] = target
+        return result
+
+    def _prepare_history(self, state, metadata, *, dummy):
+        context = get_forward_context()
+        prepared = {}
+        for layer in context.no_compile_layers.values():
+            owner = getattr(layer, "indexer", None)
+            if owner is None or id(owner) in prepared:
+                continue
+            raw_name = owner.raw_key_cache.prefix
+            if raw_name not in metadata:
+                continue
+            cache = owner.raw_key_cache.key_cache
+            ledger = getattr(owner, "_qsa_device_ring_ledger", None)
+            if (
+                ledger is None
+                or ledger.cache.data_ptr() != cache.data_ptr()
+                or ledger.cache.shape != cache.shape
+                or ledger.cache.device != cache.device
+            ):
+                ledger = QSADeviceRingLedger(cache)
+                owner._qsa_device_ring_ledger = ledger
+            if not dummy:
+                # 当前真实 CPU lease 和设备表一致性在图外校验/入队，不录入 reset。
+                ledger.prepare(metadata[raw_name])
+            prepared[id(owner)] = ledger
+        state.prepared_history = prepared
+
+    @staticmethod
+    def _layout_valid(state, metadata):
+        if tuple(metadata) != state._names:
+            return False
+        if state._object_aliases(metadata) != state._aliases:
+            return False
+        aliases: dict[int, tuple] = {}
+        for name, field, target in state._bindings:
+            source: Any = getattr(metadata[name], field, None)
+            if not (
+                type(source) is torch.Tensor
+                and source.device == target.device
+                and source.dtype == target.dtype
+                and source.shape == target.shape
+                and source.stride() == target.stride()
+            ):
+                return False
+            signature = state._tensor_key(source)
+            if aliases.setdefault(id(target), signature) != signature:
+                return False
+        return True
+
+    def __call__(self, *args: Any, **kwargs: Any) -> Any:
+        # 继承的容器负责清理；state按当前draft配置的真实行数捕获。
+        state: Any
+        if not is_forward_context_available():
+            return self.runnable(*args, **kwargs)
+        context = get_forward_context()
+        spec = self.vllm_config.speculative_config
+        if spec is None:
+            raise ValueError("FULL verify requires an MTP configuration")
+        num_tokens = 1 + spec.num_speculative_tokens
+        dummy = context.additional_kwargs.get("qwen38_xpu_full_verify_dummy") is True
+        if context.cudagraph_runtime_mode != CUDAGraphMode.FULL:
+            if dummy and isinstance(context.attn_metadata, dict):
+                # FULL内存预估先以NONE warm-up；仍须屏蔽dummy的真实cache写入。
+                original_metadata = context.attn_metadata
+                metadata = self._dummy_metadata(original_metadata, num_tokens)
+                state = Qwen38FullVerifyState(
+                    self.vllm_config,
+                    metadata,
+                    max_seq_len=self._capacities[-1],
+                    dummy=True,
+                )
+                state.stage(metadata, num_tokens=num_tokens, num_reqs=1, dummy=True)
+                self._prepare_history(state, metadata, dummy=True)
+                previous_mode = context.cudagraph_runtime_mode
+                context.cudagraph_runtime_mode = CUDAGraphMode.FULL
+                context.attn_metadata = state.metadata
+                context.additional_kwargs[_CONTEXT_KEY] = state
+                try:
+                    return self.runnable(*args, **kwargs)
+                finally:
+                    context.cudagraph_runtime_mode = previous_mode
+                    context.attn_metadata = original_metadata
+                    context.additional_kwargs.pop(_CONTEXT_KEY, None)
+            return self.runnable(*args, **kwargs)
+        descriptor, metadata = context.batch_descriptor, context.attn_metadata
+        if not (
+            descriptor is not None
+            and descriptor.num_tokens == num_tokens
+            and descriptor.num_reqs == 1
+            and descriptor.uniform
+            and not descriptor.has_lora
+            and isinstance(metadata, dict)
+        ):
+            return self._run_eager(args, kwargs)
+        if dummy:
+            validate_cudagraph_capturing_enabled()
+        original_metadata = metadata
+        if dummy:
+            metadata = self._dummy_metadata(metadata, num_tokens)
+        try:
+            Qwen38FullVerifyState._check(metadata, num_tokens=num_tokens, dummy=dummy)
+        except ValueError as error:
+            logger.warning_once("Qwen38 FULL verify fallback before submit: %s", error)
+            return self._run_eager(args, kwargs)
+        if not dummy and not self._cache_bindings_valid():
+            self.clear_graphs()
+            return self._run_eager(args, kwargs)
+        capacity = self._capacities[-1]
+        if not dummy:
+            sequence_length = max(
+                m.max_seq_len for m in metadata.values() if hasattr(m, "compress_ratio")
+            )
+            if not 0 < sequence_length <= capacity:
+                raise ValueError("FULL verify sequence length outside captured bounds")
+            capacity = next(c for c in self._capacities if sequence_length <= c)
+        descriptors = (
+            tuple(self._descriptor(descriptor, c) for c in self._capacities)
+            if dummy
+            else (self._descriptor(descriptor, capacity),)
+        )
+        signature = self._input_signature(args, kwargs)
+        for key in descriptors:
+            entry = self.concrete_cudagraph_entries.get(key)
+            if not dummy and (entry is None or entry.cudagraph is None):
+                return self._run_eager(args, kwargs)
+            state = self._states.get(key)
+            if state is not None and (
+                self._input_bindings[key] != signature
+                or not self._layout_valid(state, metadata)
+            ):
+                self.clear_graphs()
+                return self._run_eager(args, kwargs)
+            if state is None:
+                state = Qwen38FullVerifyState(
+                    self.vllm_config,
+                    metadata,
+                    max_seq_len=key.qsa_seq_capacity,
+                    dummy=dummy,
+                )
+                self._states[key] = state
+                self._input_bindings[key] = signature
+                if not self._cache_bindings:
+                    for layer in context.no_compile_layers.values():
+                        cache = getattr(layer, "kv_cache", None)
+                        if isinstance(cache, torch.Tensor):
+                            self._cache_bindings.append((layer, cache))
+                        elif isinstance(cache, (tuple, list)):
+                            self._cache_bindings.append((layer, tuple(cache)))
+            # 从这里开始允许入队；异常必须传播，不重放 fallback。
+            state.stage(metadata, num_tokens=num_tokens, num_reqs=1, dummy=dummy)
+            self._prepare_history(state, metadata, dummy=dummy)
+            context.batch_descriptor = key
+            context.attn_metadata = state.metadata
+            context.additional_kwargs[_CONTEXT_KEY] = state
+            try:
+                if (
+                    not dummy
+                    and os.getenv("QWEN38_VERIFY_GRAPH_STATE", "0") == "1"
+                    and not getattr(self, "_paired_checked", False)
+                ):
+                    from .verify_compare import compare_replay
+
+                    self._paired_checked = True
+                    output = compare_replay(
+                        self,
+                        state,
+                        context,
+                        original_metadata,
+                        args,
+                        kwargs,
+                        lambda: CUDAGraphWrapper.__call__(self, *args, **kwargs),
+                    )
+                else:
+                    output = CUDAGraphWrapper.__call__(self, *args, **kwargs)
+                if (
+                    not dummy
+                    and os.getenv("QWEN38_FULL_VERIFY_SYNC_REPLAY", "0") == "1"
+                ):
+                    # 仅诊断图完成依赖，不作为性能修复或默认路径。
+                    torch.xpu.synchronize()
+            finally:
+                context.batch_descriptor = descriptor
+                context.attn_metadata = original_metadata
+                context.additional_kwargs.pop(_CONTEXT_KEY, None)
+            if dummy:
+                logger.info(
+                    "QWEN38_FULL_VERIFY_CAPTURE M=%d capacity=%d",
+                    num_tokens,
+                    key.qsa_seq_capacity,
+                )
+        if not dummy and key not in self._replayed:
+            self._replayed.add(key)
+            logger.info(
+                "QWEN38_FULL_VERIFY_REPLAY M=%d capacity=%d", num_tokens, capacity
+            )
+        return output
