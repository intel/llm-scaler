+def _hc_grouped_norm_native_fallback_reason(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    output: torch.Tensor | None,
+) -> int | None:
+    reason = _hc_grouped_norm_input_fallback_reason(
+        hidden_states,
+        weight,
+        eps,
+        hc_count,
+    )
+    if reason is not None:
+        return reason
+    if not isinstance(output, torch.Tensor):
+        return REASON_OTHER_CONTRACT
+    if output.shape != hidden_states.shape:
+        return REASON_SHAPE
+    if output.dtype != hidden_states.dtype:
+        return REASON_DTYPE
+    if output.device != hidden_states.device:
+        return REASON_DEVICE
+    if not output.is_contiguous():
+        return REASON_LAYOUT
+    if _tensors_alias(output, hidden_states) or _tensors_alias(output, weight):
+        return REASON_OTHER_CONTRACT
+    return None
