@@ -0,0 +1,91 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Small eager MTP history checks; one ordered check, no host tensor reads."""
+
+from vllm.triton_utils import tl, triton
+
+
+@triton.jit
+def compressed_first_positions_kernel(
+    Positions, Slots, Output, rows, RATIO: tl.constexpr, WIDTH: tl.constexpr
+):
+    row = tl.program_id(0) * WIDTH + tl.arange(0, WIDTH)
+    position = tl.load(Positions + row, row < rows, 0)
+    slot = tl.load(Slots + row, row < rows, -1)
+    valid = (slot >= 0) & (position >= RATIO - 1)
+    first = tl.where(valid, position - (RATIO - 1), 0)
+    tl.store(Output + row, first, row < rows)
+
+
+@triton.jit
+def check_history_kernel(
+    Tags,
+    Requests,
+    Starts,
+    Positions,
+    Table,
+    CompressedSlots,
+    Result,
+    ROWS: tl.constexpr,
+    REQS: tl.constexpr,
+    BLOCKS: tl.constexpr,
+    RING: tl.constexpr,
+    RATIO: tl.constexpr,
+    WIDTH: tl.constexpr,
+    REQ_STRIDE: tl.constexpr,
+    START_STRIDE: tl.constexpr,
+    POS_STRIDE: tl.constexpr,
+    TABLE_STRIDE: tl.constexpr,
+    SLOT_STRIDE: tl.constexpr,
+):
+    row = tl.arange(0, WIDTH)
+    live = row < ROWS
+    request = tl.load(Requests + row * REQ_STRIDE, live, 0).to(tl.int64)
+    safe_request = tl.minimum(tl.maximum(request, 0), REQS - 1)
+    start = tl.load(Starts + safe_request * START_STRIDE, live, 0).to(tl.int64)
+    end = tl.load(Starts + (safe_request + 1) * START_STRIDE, live, 0).to(tl.int64)
+    position = tl.load(Positions + row * POS_STRIDE, live, 0).to(tl.int64)
+    compressed = tl.load(CompressedSlots + row * SLOT_STRIDE, live, -1)
+    valid = (
+        live
+        & (request >= 0)
+        & (request < REQS)
+        & (row >= start)
+        & (row < end)
+        & (compressed >= 0)
+        & (position >= RATIO - 1)
+    )
+    block = tl.load(Table + safe_request * TABLE_STRIDE, live, 0).to(tl.int64)
+    block_ok = (~valid) | ((block >= 0) & (block < BLOCKS))
+    safe_block = tl.minimum(tl.maximum(block, 0), BLOCKS - 1)
+    history = position[:, None] - (RATIO - 1) + tl.arange(0, RATIO)[None, :]
+    chunk_start = position - (row - start)
+    needed = valid[:, None] & (history < chunk_start[:, None])
+    # Match torch.remainder for negative positions too; never form an OOB
+    # pointer even for rows whose validity mask is false.
+    offsets = ((history % RING) + RING) % RING
+    actual = tl.load(Tags + safe_block[:, None] * RING + offsets)
+    history_ok = (~needed) | (actual == history)
+    ok = tl.sum((~block_ok).to(tl.int32), 0) == 0
+    ok &= tl.sum(tl.sum((~history_ok).to(tl.int32), 1), 0) == 0
+    tl.store(Result, ok)
+
+
+@triton.jit
+def acknowledge_kernel(
+    Tags,
+    Slots,
+    Positions,
+    ROWS: tl.constexpr,
+    CAPACITY: tl.constexpr,
+    SLOT_STRIDE: tl.constexpr,
+    POS_STRIDE: tl.constexpr,
+    WIDTH: tl.constexpr,
+):
+    row = tl.arange(0, WIDTH)
+    live = row < ROWS
+    slot = tl.load(Slots + row * SLOT_STRIDE, live, -1).to(tl.int64)
+    position = tl.load(Positions + row * POS_STRIDE, live, -1).to(tl.int64)
+    valid = live & (slot >= 0) & (slot < CAPACITY)
+    # Unlike the Torch scatter fallback, no sink is needed for masked rows.
+    tl.store(Tags + slot, position, valid)
