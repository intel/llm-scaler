+            full_verify_enabled,
+        )
+
+        verify = full_verify_enabled(self.vllm_config)
+        if full_decode_enabled(self.vllm_config) or verify:
+            self._qwen38_full_dirty_block_tables = True
+            if not isinstance(self.model, CUDAGraphWrapper):
+                raise RuntimeError(
+                    "Qwen38 FULL decode requires the standard graph wrapper"
+                )
+            wrapper = (
+                Qwen38FullVerifyCUDAGraphWrapper
+                if verify
+                else Qwen38FullDecodeCUDAGraphWrapper
+            )
+            self.model = wrapper(
+                self.model.runnable,
+                self.vllm_config,
+                runtime_mode=self.model.runtime_mode,
+            )
+
 
 class XPUModelRunnerV2(GPUModelRunnerV2):
     """A model runner for XPU devices."""
