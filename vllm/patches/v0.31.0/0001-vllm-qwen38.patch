+    """Bucket cache owners by role; None if this is not a CSA+linear model."""
+    if not any(
+        type(spec) is Qwen38CircularBufferSpec for spec in kv_cache_spec.values()
+    ):
+        return None
+    roles = _CSALinearRoles(main_kv={}, compressed={}, compressor_state={}, mamba={})
+    unsupported = []
+    for name, spec in kv_cache_spec.items():
+        if type(spec) is Qwen38FullAttentionSpec:
+            roles.main_kv[name] = spec
+        elif type(spec) is Qwen38CompressedAttentionSpec and spec.compress_ratio > 1:
+            roles.compressed[name] = spec
+        elif type(spec) is Qwen38CircularBufferSpec:
+            roles.compressor_state[name] = spec
