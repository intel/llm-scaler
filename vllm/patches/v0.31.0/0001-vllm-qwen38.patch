+
+    compress_ratio: int = 1
+
+    def __post_init__(self):
+        if self.compress_ratio <= 0 or self.block_size % self.compress_ratio:
+            raise ValueError("Qwen38 block size must divide into complete groups")
+        if self.tokens_per_state not in (1, self.compress_ratio):
+            raise ValueError("Qwen38 tokens_per_state must match compress_ratio")
+        object.__setattr__(self, "tokens_per_state", self.compress_ratio)
+        object.__setattr__(
