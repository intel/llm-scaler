+        conv_state: torch.Tensor,
+        conv_weights: torch.Tensor,
+        output: torch.Tensor | None = None,
+        *,
+        mixed_input_workspace: torch.Tensor | None = None,
+        mixed_branch_workspace: torch.Tensor | None = None,
+        mixed_output: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        return self._prepare_short_conv_dilated_dispatch(
+            inputs,
+            metadata,
+            conv_state,
+            conv_weights,
+            output,
+            mixed_input_workspace=mixed_input_workspace,
+            mixed_branch_workspace=mixed_branch_workspace,
+            mixed_output=mixed_output,
+        ).execute()
