index 0000000..3e596db
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/fp8_moe.py
@@ -0,0 +1,104 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Native-width FP8 MoE adapter; unsupported calls use the ordinary XPU MoE."""
+
+import os
+from functools import lru_cache
+from importlib import import_module
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.model_executor.layers.esimd_utils import ensure_esimd_package_path
+from vllm.model_executor.layers.fused_moe.router.fused_topk_router import (
+    FusedTopKRouter,
+)
+
+from .parameter_dispatch import standard_direct_parameters
+
+logger = init_logger(__name__)
+_DISABLED = os.getenv("VLLM_XPU_DISABLE_QWEN38_FP8_MOE", "0") == "1"
+
+
+@lru_cache(maxsize=1)
+def workspace_class():
+    ensure_esimd_package_path()
+    try:
+        module = import_module("custom_esimd_kernels_vllm.qwen38_fp8_moe_ops")
+    except ImportError:
+        logger.warning_once(
+            "Native-width Qwen3.8 FP8 MoE is unavailable; using XPU MoE."
+        )
+        return None
+    return getattr(module, "Workspace", None)
+
+
+def try_fp8_moe(owner, x: torch.Tensor, sources):
+    if (
+        _DISABLED
+        or torch.compiler.is_compiling()
+        or x.ndim != 2
+        or not 1 <= x.shape[0] <= 8
+        or sources is None
+        or owner.tp_size not in (4, 8)
+        or owner.ep_size != 1
+        or owner.n_shared_experts != 1
+        or sources.experts.moe_config.experts_per_token != 10
+        or sources.gate.bias is not None
+        or sources.shared_expert_gate.bias is not None
+        or sources.shared_gate_up_proj.bias is not None
+        or sources.shared_down_proj.bias is not None
+    ):
+        return None
+    runner = sources.experts
+    config = runner.moe_config
+    router_impl = getattr(runner, "router", None)
+    activation = getattr(config, "activation", None)
+    if (
+        type(router_impl) is not FusedTopKRouter
+        or router_impl.top_k != 10
+        or router_impl.global_num_experts != 512
+        or router_impl.scoring_func != "softmax"
+        or router_impl.renormalize is not True
+        or router_impl.eplb_state is not None
+        or getattr(owner, "enable_eplb", False)
+        or getattr(owner, "is_sequence_parallel", False)
+        or getattr(activation, "value", activation) != "silu"
+        or getattr(config, "has_bias", False)
+        or getattr(config, "skip_final_all_reduce", False)
+        or getattr(runner, "routed_input_transform", None) is not None
+        or getattr(runner, "routed_output_transform", None) is not None
+        or getattr(runner, "routed_scaling_factor", 1.0) != 1.0
+        or getattr(runner, "enable_dbo", False)
+    ):
+        return None
+    experts = sources.routed_experts
+    up, down = sources.shared_gate_up_proj, sources.shared_down_proj
+    weights = (
+        getattr(experts, "w13_weight", None),
+        getattr(experts, "w13_weight_scale", None),
+        getattr(experts, "w2_weight", None),
+        getattr(experts, "w2_weight_scale", None),
+        up.weight,
+        getattr(up, "weight_scale", None),
+        down.weight,
+        getattr(down, "weight_scale", None),
+        sources.shared_expert_gate.weight,
+    )
+    router = sources.gate.weight
+    if not standard_direct_parameters(x, router, *weights):
+        return None
+    run = getattr(owner, "_qwen38_fp8_moe_run", None)
+    if run is None:
+        factory = workspace_class()
+        if factory is None:
+            return None
+        workspace = factory()
+        owner._qwen38_fp8_moe_workspace = workspace
+        run = owner._qwen38_fp8_moe_run = workspace.try_run
+    # Pass live weights on every call. The native preflight runs before any
+    # submission; errors after submission propagate, never rerun a fallback.
+    output = run(x, router, weights)
+    if output is not None:
+        logger.info_once("Qwen3.8 is using native-width FP8 MoE workspace.")
+    return output
diff --git a/vllm/models/qwen4_exp/xpu/full_decode.py b/vllm/models/qwen4_exp/xpu/full_decode.py
new file mode 100644
index 0000000..2c424ef
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/full_decode.py
@@ -0,0 +1,533 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""非 MTP 单 token FULL decode 的图外状态准备与写入确认。"""
+
+from __future__ import annotations
+
+import os
+from copy import copy
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+from vllm.compilation.cuda_graph import CUDAGraphWrapper
+from vllm.compilation.monitor import validate_cudagraph_capturing_enabled
+from vllm.config import CUDAGraphMode, VllmConfig
+from vllm.forward_context import (
+    BatchDescriptor,
+    get_forward_context,
+    is_forward_context_available,
+)
+from vllm.logger import init_logger
+from vllm.models.qwen4_exp.xpu.qsa_cache import (
+    QSAForwardMetadata,
+    _qsa_historical_ring_proven_for_batch,
+)
+from vllm.v1.attention.backends.gdn_attn import GDNAttentionMetadata
+from vllm.v1.core.qsa_provenance import (
+    QSAHistoricalRingPendingTransaction,
+    QSAHistoricalRingWriteAcknowledgement,
+)
+
+from .short_conv import PleShortConvAttentionMetadata
+
+logger = init_logger(__name__)
+_CONTEXT_KEY = "qwen38_xpu_full_decode_state"
+
+
+def _unique_metadata(metadata: dict[str, Any]) -> tuple[tuple[str, Any], ...]:
+    return tuple({id(m): (name, m) for name, m in metadata.items()}.values())
+
+
+def full_decode_requested() -> bool:
+    return os.getenv("VLLM_XPU_QWEN38_FULL_DECODE", "1") == "1"
+
+
+def full_decode_enabled(config: VllmConfig) -> bool:
+    return bool(
+        full_decode_requested()
+        and config.model_config is not None
+        and getattr(config.model_config.hf_text_config, "model_type", None)
+        in {
+            "qwen3_8_flash_next",
+            "qwen3_8_flash_next_text",
+            "qwen4_exp",
+            "qwen4_exp_text",
+        }
+        and config.compilation_config.cudagraph_mode == CUDAGraphMode.FULL_DECODE_ONLY
+        and config.speculative_config is None
+    )
+
+
+def active_full_decode_state() -> Qwen38FullDecodeState | None:
+    if not is_forward_context_available():
+        return None
+    context = get_forward_context()
+    if context.cudagraph_runtime_mode != CUDAGraphMode.FULL:
+        return None
+    state = context.additional_kwargs.get(_CONTEXT_KEY)
+    if state is None:
+        return None
+    supported = type(state) is Qwen38FullDecodeState
+    if not supported:
+        from .full_verify import Qwen38FullVerifyState
+
+        supported = type(state) is Qwen38FullVerifyState
+    if (
+        context.cudagraph_runtime_mode == CUDAGraphMode.FULL
+        and supported
+        and context.attn_metadata is state.metadata
+    ):
+        return state
+    return None
+
+
+class Qwen38FullDecodeState:
+    """固定设备地址；CPU proof 与 receipt 始终属于当前真实调用。"""
+
+    def __init__(self, metadata: dict[str, Any], max_seq_len: int):
+        self.metadata: dict[str, Any] = {}
+        self.max_seq_len = max_seq_len
+        self._fields: list[tuple[str, str, torch.Tensor]] = []
+        self._constant_fields: list[tuple[str, str, torch.Tensor]] = []
+        objects: dict[int, Any] = {}
+        buffers: dict[tuple[Any, ...], torch.Tensor] = {}
+        for name, source in metadata.items():
+            if id(source) in objects:
+                self.metadata[name] = objects[id(source)]
+                continue
+            target = copy(source)
+            objects[id(source)] = target
+            self.metadata[name] = target
+            for field, value in vars(source).items():
+                if (
+                    isinstance(source, PleShortConvAttentionMetadata)
+                    and field == "state_indices_tensor_d"
+                    and isinstance(value, torch.Tensor)
+                    and value.ndim == 2
+                ):
+                    # PLE 实际消费自己的 1D state_indices_tensor。
+                    continue
+                if (
+                    not isinstance(value, torch.Tensor)
+                    or value.device.type != "xpu"
+                    or value.numel() == 0
+                ):
+                    continue
+                key = (
+                    value.data_ptr(),
+                    value.shape,
+                    value.stride(),
+                    value.dtype,
+                    value.device,
+                )
+                buffer = buffers.get(key)
+                if buffer is None:
+                    buffer = torch.empty_strided(
+                        value.shape,
+                        value.stride(),
+                        dtype=value.dtype,
+                        device=value.device,
+                    )
+                    buffers[key] = buffer
+                    # 严格 M1 decode 的 query offsets 由 runner/builder 保证为 [0,1]。
+                    # 使用独立 graph-owned 常量，不借用会被下步覆盖的 producer buffer。
+                    if (
+                        field
+                        in {
+                            "query_start_loc",
+                            "non_spec_query_start_loc",
+                            "query_start_loc_d",
+                        }
+                        and value.shape == (2,)
+                        and value.dtype in (torch.int32, torch.int64)
+                    ):
+                        buffer.copy_(
+                            torch.tensor([0, 1], dtype=value.dtype, device=value.device)
+                        )
+                        self._constant_fields.append((name, field, buffer))
+                    else:
+                        self._fields.append((name, field, buffer))
+                setattr(target, field, buffer)
+            if isinstance(target, QSAForwardMetadata):
+                target.max_seq_len = max_seq_len
+                target.qsa_ring_pending_transaction = None
+                target.qsa_ring_pending_transactions = ()
+                target.qsa_ring_device_guard = False
+                target.mrope_positions_bounds_proven = True
+            elif hasattr(target, "mrope_positions_bounds_proven"):
+                target.mrope_positions_bounds_proven = True
+        self._metadata_ids = frozenset(id(m) for m in self.metadata.values())
+
+    def owns(self, metadata: Any) -> bool:
+        return id(metadata) in self._metadata_ids
+
+    def stage(self, metadata: dict[str, Any], *, dummy: bool) -> None:
+        for name, field, target in (
+            *self._fields,
+            *getattr(self, "_constant_fields", ()),
+        ):
+            source = getattr(metadata[name], field, None)
+            if not (
+                isinstance(source, torch.Tensor)
+                and source.device == target.device
+                and source.dtype == target.dtype
+                and source.shape == target.shape
+                and source.stride() == target.stride()
+            ):
+                raise ValueError(f"FULL decode metadata layout changed: {name}.{field}")
+        for name, field, target in self._fields:
+            target.copy_(getattr(metadata[name], field))
+        if dummy:
+            for target in {id(m): m for m in self.metadata.values()}.values():
+                if isinstance(target, QSAForwardMetadata):
+                    target.slot_mapping.fill_(-1)
+                elif isinstance(target, GDNAttentionMetadata):
+                    indices = target.non_spec_state_indices_tensor
+                    assert indices is not None
+                    indices.fill_(-1)
+                elif isinstance(target, PleShortConvAttentionMetadata):
+                    indices = target.state_indices_tensor
+                    initial = target.has_initial_states_d
+                    assert indices is not None and initial is not None
+                    indices.fill_(0)
+                    initial.fill_(False)
+
+    @staticmethod
+    def check_qsa(raw: QSAForwardMetadata) -> None:
+        pending = raw.qsa_ring_pending_transactions
+        tags = raw.logical_positions_cpu
+        if not (
+            raw.num_actual_tokens == raw.num_mapped_tokens == 1
+            and raw.query_start_loc_cpu == (0, 1)
+            and tags is not None
+            and len(tags) == 1
+            and tags[0] >= 0
+            and len(pending) == 1
+            and type(pending[0]) is QSAHistoricalRingPendingTransaction
+            and pending[0].logical_tags == tags
+            and not pending[0].write_manifest_required
+            and raw.mrope_positions_bounds_proven
+            and isinstance(raw.block_table_cpu, torch.Tensor)
+            and raw.block_table_cpu.device.type == "cpu"
+            and raw.block_table_cpu.ndim == 2
+            and raw.block_table_cpu.shape[0] >= 1
+            and raw.block_table_cpu.shape[1] >= 1
+            and int(raw.block_table_cpu[0, 0]) == pending[0].lease.block_id
+        ):
+            raise ValueError("FULL decode requires this step's QSA transaction")
+        # raw metadata 的 ratio=1；按 indexer 的 ratio=4 验证当前 sealed capability。
+        if (tags[0] + 1) % 4 == 0 and not _qsa_historical_ring_proven_for_batch(
+            common_attn_metadata=raw,
+            query_start_loc_cpu=raw.query_start_loc_cpu,
+            logical_positions_cpu=tags,
+            num_tokens=1,
+            storage_block_size=raw.storage_block_size,
+            compress_ratio=4,
+        ):
+            raise ValueError("FULL decode QSA history is not producer-proven")
+
+    @staticmethod
+    def acknowledge(
+        metadata: dict[str, Any],
+        unique_metadata: tuple[tuple[str, Any], ...] | None = None,
+    ) -> None:
+        for _, raw in (
+            unique_metadata
+            if unique_metadata is not None
+            else _unique_metadata(metadata)
+        ):
+            if not isinstance(raw, QSAForwardMetadata) or raw.compress_ratio != 1:
+                continue
+            receipts = tuple(
+                QSAHistoricalRingWriteAcknowledgement(
+                    request_id=tx.request_id,
+                    lease=tx.lease,
+                    epoch=tx.epoch,
+                    logical_tags=tx.logical_tags,
+                    causal_generation=tx.causal_generation,
+                )
+                for tx in raw.qsa_ring_pending_transactions
+            )
+            raw.qsa_ring_write_acknowledgements = receipts
+            if len(receipts) == 1:
+                raw.qsa_ring_write_acknowledgement = receipts[0]
+
+
+class Qwen38FullDecodeCUDAGraphWrapper(CUDAGraphWrapper):
+    """在标准整图 capture/replay 外准备、校验和确认当前事务。"""
+
+    def __init__(self, *args: Any, **kwargs: Any):
+        super().__init__(*args, **kwargs)
+        self._states: dict[Qwen38FullDecodeDescriptor, Qwen38FullDecodeState] = {}
+        self._replayed: set[Qwen38FullDecodeDescriptor] = set()
+        self._input_bindings: dict[Qwen38FullDecodeDescriptor, tuple] = {}
+        self._cache_bindings: list[tuple[Any, Any]] = []
+        maximum = self.vllm_config.model_config.max_model_len
+        self._capacities = tuple(
+            sorted(
+                {
+                    min(bound, maximum)
+                    for bound in (511, 2047, 4095, 65535, 131071, maximum)
+                }
+            )
+        )
+
+    def clear_graphs(self) -> None:
+        tensor = next(
+            (
+                value
+                for state in self._states.values()
+                for _, _, value in state._fields
+                if value.device.type == "xpu"
+            ),
+            None,
+        )
+        if tensor is not None:
+            torch.xpu.synchronize(tensor.device)
+        super().clear_graphs()
+        # 只移除本 wrapper 创建的 scratch，避免 profiling 的 state 留在 owner key 中。
+        context = self.vllm_config.compilation_config.static_forward_context
+        states = set(self._states.values())
+        for layer in context.values():
+            indexer = getattr(layer, "indexer", None)
+            for name in (
+                "_esimd_qsa_group_compression_buffers",
+                "_esimd_qsa_indexer_norm_rope_buffers",
+            ):
+                buffers = getattr(indexer, name, None)
+                if isinstance(buffers, dict):
+                    for key in tuple(buffers):
+                        if isinstance(key, tuple) and key[-1] in states:
+                            buffers.pop(key)
+        self._states.clear()
+        self._replayed.clear()
+        self._input_bindings.clear()
+        self._cache_bindings.clear()
+
+    def _descriptor(self, descriptor: BatchDescriptor, capacity: int):
+        return Qwen38FullDecodeDescriptor(
+            num_tokens=descriptor.num_tokens,
+            num_reqs=descriptor.num_reqs,
+            uniform=descriptor.uniform,
+            has_lora=descriptor.has_lora,
+            num_active_loras=descriptor.num_active_loras,
+            qsa_seq_capacity=capacity,
+        )
+
+    def _check_step(
+        self,
+        metadata: dict[str, Any],
+        unique_metadata: tuple[tuple[str, Any], ...] | None = None,
+    ) -> None:
+        from .qsa import Qwen3_8FlashNextQSAMetadata
+
+        for name, m in (
+            unique_metadata
+            if unique_metadata is not None
+            else _unique_metadata(metadata)
+        ):
+            if isinstance(m, QSAForwardMetadata):
+                if m.compress_ratio == 1:
+                    Qwen38FullDecodeState.check_qsa(m)
+                elif not (
+                    m.num_actual_tokens == m.num_mapped_tokens == 1
+                    and m.compress_ratio == 4
+                    and m.mrope_positions_bounds_proven
+                ):
+                    raise ValueError("FULL decode compressed QSA metadata is invalid")
+            elif isinstance(m, Qwen3_8FlashNextQSAMetadata):
+                if not (m.num_actual_tokens == 1 and m.mrope_positions_bounds_proven):
+                    raise ValueError("FULL decode QSA position bounds are not proven")
+            elif isinstance(m, GDNAttentionMetadata):
+                if not (
+                    m.num_decodes == m.num_decode_tokens == m.num_actual_tokens == 1
+                    and m.num_prefills == m.num_spec_decodes == 0
+                    and m.spec_sequence_masks is None
+                ):
+                    raise ValueError("FULL decode requires ordinary M1 GDN metadata")
+            elif isinstance(m, PleShortConvAttentionMetadata):
+                layer = get_forward_context().no_compile_layers[name]
+                if not (
+                    m.num_decodes == m.num_decode_tokens == m.num_actual_tokens == 1
+                    and m.num_prefills == m.num_spec_decodes == 0
+                    and layer._short_conv_construction_proof_valid(
+                        m, int(layer.kv_cache[0].shape[0])
+                    )
+                ):
+                    raise ValueError("FULL decode PLE construction proof is invalid")
+            else:
+                raise ValueError(
+                    f"Unsupported FULL decode metadata: {type(m).__name__}"
+                )
+        checked_pairs: set[tuple[int, int, int, int]] = set()
+        for layer in get_forward_context().no_compile_layers.values():
+            indexer = getattr(layer, "indexer", None)
+            if indexer is None:
+                continue
+            raw = metadata[indexer.raw_key_cache.prefix]
+            compressed = metadata[indexer.compressed_key_cache.prefix]
+            raw_page_size = indexer.raw_key_cache.kv_cache.shape[1]
+            compressed_page_size = indexer.compressed_key_cache.kv_cache.shape[1]
+            pair_key = (id(raw), id(compressed), raw_page_size, compressed_page_size)
+            if pair_key in checked_pairs:
+                continue
+            if not (
+                raw.logical_positions_cpu == compressed.logical_positions_cpu
+                and raw.query_start_loc_cpu == compressed.query_start_loc_cpu
+                and raw.logical_positions_source_ids
+                == compressed.logical_positions_source_ids
+                and raw.storage_block_size == raw_page_size
+                and compressed.storage_block_size == compressed_page_size
+            ):
+                raise ValueError("FULL decode QSA paired mapping changed")
+            checked_pairs.add(pair_key)
+
+    @staticmethod
+    def _input_signature(args: tuple, kwargs: dict) -> tuple:
+        values = [*enumerate(args), *sorted(kwargs.items())]
+        return tuple(
+            (
+                name,
+                value.data_ptr(),
+                value.shape,
+                value.stride(),
+                value.dtype,
+                value.device,
+            )
+            for name, value in values
+            if isinstance(value, torch.Tensor)
+        )
+
+    def _cache_bindings_valid(self) -> bool:
+        for layer, expected in self._cache_bindings:
+            current = layer.kv_cache
+            if isinstance(expected, tuple):
+                if not isinstance(current, (tuple, list)) or len(current) != len(
+                    expected
+                ):
+                    return False
+                if any(live is not old for live, old in zip(current, expected)):
+                    return False
+            elif current is not expected:
+                return False
+        return True
+
+    def _run_eager(self, args: tuple, kwargs: dict) -> Any:
+        context = get_forward_context()
+        context.cudagraph_runtime_mode = CUDAGraphMode.NONE
+        try:
+            return self.runnable(*args, **kwargs)
+        finally:
+            context.cudagraph_runtime_mode = CUDAGraphMode.FULL
+
+    def __call__(self, *args: Any, **kwargs: Any) -> Any:
+        if not is_forward_context_available():
+            return super().__call__(*args, **kwargs)
+        context = get_forward_context()
+        if context.cudagraph_runtime_mode != CUDAGraphMode.FULL:
+            return super().__call__(*args, **kwargs)
+        descriptor = context.batch_descriptor
+        if descriptor is None or descriptor.num_tokens != 1:
+            raise ValueError("Qwen38 FULL decode currently captures only M=1")
+        metadata = context.attn_metadata
+        if not isinstance(metadata, dict):
+            raise ValueError("FULL decode requires per-layer metadata")
+        descriptors = tuple(
+            self._descriptor(descriptor, bound) for bound in self._capacities
+        )
+        missing = any(
+            key not in self.concrete_cudagraph_entries
+            or self.concrete_cudagraph_entries[key].cudagraph is None
+            for key in descriptors
+        )
+        dummy = context.additional_kwargs.get("qwen38_xpu_full_decode_dummy") is True
+        if missing and not dummy:
+            return self._run_eager(args, kwargs)
+        if not dummy and not self._cache_bindings_valid():
+            logger.warning_once(
+                "Qwen38 FULL cache binding changed; invalidating graphs"
+            )
+            self.clear_graphs()
+            return self._run_eager(args, kwargs)
+        if dummy:
+            validate_cudagraph_capturing_enabled()
+        if not dummy:
+            unique_metadata = _unique_metadata(metadata)
+            try:
+                self._check_step(metadata, unique_metadata)
+            except ValueError as exc:
+                logger.warning_once(
+                    "Qwen38 FULL decode falls back to eager: %s", str(exc)
+                )
+                return self._run_eager(args, kwargs)
+            sequence_length = max(
+                m.max_seq_len
+                for _, m in unique_metadata
+                if isinstance(m, QSAForwardMetadata)
+            )
+            if not 0 < sequence_length <= self._capacities[-1]:
+                raise ValueError(
+                    "FULL decode sequence length is outside captured bounds"
+                )
+            capacity = next(
+                bound for bound in self._capacities if sequence_length <= bound
+            )
+            descriptors = (self._descriptor(descriptor, capacity),)
+        for key in descriptors:
+            signature = self._input_signature(args, kwargs)
+            if not dummy and self._input_bindings.get(key) != signature:
+                logger.warning_once(
+                    "Qwen38 FULL input binding changed; invalidating graphs"
+                )
+                self.clear_graphs()
+                return self._run_eager(args, kwargs)
+            state = self._states.get(key)
+            if state is None:
+                state = Qwen38FullDecodeState(metadata, key.qsa_seq_capacity)
+                self._states[key] = state
+                self._input_bindings[key] = signature
+                if not self._cache_bindings:
+                    for layer in context.no_compile_layers.values():
+                        cache = getattr(layer, "kv_cache", None)
+                        if isinstance(cache, torch.Tensor):
+                            self._cache_bindings.append((layer, cache))
+                        elif isinstance(cache, (tuple, list)):
+                            self._cache_bindings.append((layer, tuple(cache)))
+            state.stage(metadata, dummy=dummy)
+            context.batch_descriptor = key
+            context.attn_metadata = state.metadata
+            context.additional_kwargs[_CONTEXT_KEY] = state
+            try:
+                output = super().__call__(*args, **kwargs)
+            finally:
+                context.batch_descriptor = descriptor
+                context.attn_metadata = metadata
+                context.additional_kwargs.pop(_CONTEXT_KEY, None)
+            if dummy:
+                logger.info(
+                    "QWEN38_FULL_DECODE_CAPTURE qsa_capacity=%d "
+                    "graphs=1 eager_breaks=0 metadata_copies=%d constant_buffers=%d",
+                    key.qsa_seq_capacity,
+                    len(state._fields),
+                    len(state._constant_fields),
+                )
+        if not dummy:
+            # 与 eager ABI3/v2 相同：成功入队是同一有序 stream 上的 fence。
+            # strict ABI4 事务在图前被拒绝，不在这里伪造完成 receipt。
+            Qwen38FullDecodeState.acknowledge(metadata, unique_metadata)
+            if key not in self._replayed:
+                self._replayed.add(key)
+                logger.info(
+                    "QWEN38_FULL_DECODE_REPLAY qsa_capacity=%d graphs=1 eager_breaks=0",
+                    key.qsa_seq_capacity,
+                )
+        return output
+
+
+@dataclass(frozen=True)
+class Qwen38FullDecodeDescriptor(BatchDescriptor):
+    """同一 M=1 形状按 QSA 真实上下文上界选择已捕获的整图。"""
+
+    qsa_seq_capacity: int = 0
