+
+def _batch_signature(metadata: "PleShortConvAttentionMetadata") -> tuple[int, ...]:
+    return (
+        metadata.num_prefills,
+        metadata.num_prefill_tokens,
+        metadata.num_decodes,
+        metadata.num_decode_tokens,
+        metadata.num_reqs,
+        metadata.num_spec_decodes,
+        metadata.num_spec_decode_tokens,
+        metadata.num_actual_tokens,
+        metadata.spec_query_len,
+        metadata.max_prefill_query_len,
+    )
+
+
+@dataclass
+class PleShortConvAttentionMetadata(ShortConvAttentionMetadata):
+    # Number of speculative-decode (multi-query / MTP) requests and the total
+    # number of tokens they contribute. These are 0 when spec-decode is off.
+    num_spec_decodes: int = 0
+    num_spec_decode_tokens: int = 0
+    num_actual_tokens: int = 0
+
+    # Max query length among spec-decode requests (== num_speculative_tokens + 1).
+    # Used as ``max_query_len`` for the varlen spec causal_conv1d_update.
+    spec_query_len: int = 1
+
+    # Max query length among the non-spec *prefill* requests, precomputed
+    # CPU-side in the builder. The dilated PLE short-conv uses it to size its
+    # packing buffer without a device->host sync (``lengths.max().item()``).
+    # 0 when there are no prefill requests.
+    max_prefill_query_len: int = 0
+    query_start_loc: torch.Tensor | None = None
+
+    # ``state_indices_tensor`` keeps the historical (non-spec) layout used by
+    # all existing short-conv consumers: the conv-state slot for each regular
+    # decode followed by each prefill request. When spec-decode is active this
+    # only covers the non-spec requests.
+    state_indices_tensor: torch.Tensor | None = None
+    has_initial_states_d: torch.Tensor | None = None
+
+    # ``non_spec_query_start_loc`` is the varlen cumulative token offset over
+    # the non-spec requests only (decodes then prefills). It equals
+    # ``query_start_loc`` when there are no spec-decode requests.
+    non_spec_query_start_loc: torch.Tensor | None = None
+
+    # Speculative-decode (MTP) conv metadata. Only column 0 of the block table
+    # is needed for the convolution state, so these tensors are 1-D over the
+    # spec-decode requests.
+    spec_query_start_loc: torch.Tensor | None = None  # [num_spec_decodes + 1]
+    spec_state_indices_tensor: torch.Tensor | None = None  # [num_spec_decodes]
+    spec_sequence_masks: torch.Tensor | None = None  # [batch]
+    spec_token_indx: torch.Tensor | None = None
+    non_spec_token_indx: torch.Tensor | None = None
+    token_permutation_proven: bool = False
+    num_decode_draft_tokens_cpu: torch.Tensor | None = None
+    construction_proof: PleShortConvConstructionProof | None = None
+
+
+class PleShortConvAttentionBackend(ShortConvAttentionBackend):
+    @staticmethod
+    def get_name() -> str:
+        return "PLE_SHORT_CONV_ATTN"
+
+    @staticmethod
+    def get_builder_cls() -> type["PleShortConvAttentionMetadataBuilder"]:
+        return PleShortConvAttentionMetadataBuilder
+
+
+class PleShortConvAttentionMetadataBuilder(ShortConvAttentionMetadataBuilder):
+    metadata_cls = PleShortConvAttentionMetadata
+    # Spec-decode requires a uniform (multi-token) decode batch for full
+    # CUDA graph capture, matching the GDN backend.
+    _cudagraph_support = AttentionCGSupport.UNIFORM_BATCH
+    reorder_batch_threshold: int = 1
+    supports_update_block_table = False
+    # The model-runner MambaHybrid state passes spec-decode conv metadata
+    # (num_accepted_tokens / num_decode_draft_tokens_cpu) to builders that set
+    # this marker, so the dilated PLE short-conv can roll back rejected drafts.
+    provides_spec_decode_conv_metadata = True
+    requires_v1_cpu_provenance = True
+    needs_causal_conv1d_metadata = False
+
+    @torch.inference_mode(False)
+    def __init__(
+        self,
+        kv_cache_spec: MambaSpec,
+        layer_names: list[str],
+        vllm_config: VllmConfig,
+        device: torch.device,
+    ) -> None:
+        super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+        self.num_spec = self.num_spec_tokens
+        self.use_full_cuda_graph = (
+            self.compilation_config.cudagraph_mode.has_full_cudagraphs()
+        )
+
+        max_num_seqs = vllm_config.scheduler_config.max_num_seqs
+        max_capture_size = self.compilation_config.max_cudagraph_capture_size
+        self.decode_cudagraph_max_bs = max_num_seqs
+        self.decode_cudagraph_max_tokens = max_num_seqs * (self.num_spec + 1)
+        if max_capture_size is not None:
+            self.decode_cudagraph_max_bs = min(
+                self.decode_cudagraph_max_bs, max_capture_size
+            )
+            self.decode_cudagraph_max_tokens = min(
+                self.decode_cudagraph_max_tokens, max_capture_size
+            )
+
+        # Persistent buffers reused during full CUDA graph capture and replay.
+        self.spec_state_indices_tensor = torch.empty(
+            (self.decode_cudagraph_max_bs,), dtype=torch.int32, device=device
+        )
+        self.spec_sequence_masks = torch.empty(
+            (self.decode_cudagraph_max_bs,), dtype=torch.bool, device=device
+        )
+        self.spec_token_indx = torch.empty(
+            (self.decode_cudagraph_max_tokens,), dtype=torch.int32, device=device
+        )
+        self.non_spec_token_indx = torch.empty(
+            (self.decode_cudagraph_max_tokens,), dtype=torch.int32, device=device
+        )
+        self.spec_query_start_loc = torch.empty(
+            (self.decode_cudagraph_max_bs + 1,), dtype=torch.int32, device=device
+        )
+        self.num_accepted_tokens = torch.empty(
+            (self.decode_cudagraph_max_bs,), dtype=torch.int32, device=device
+        )
+        self.has_initial_states_d = torch.empty(
+            (self.decode_cudagraph_max_bs,), dtype=torch.bool, device=device
+        )
+
+    def make_v1_cpu_provenance(
+        self,
+        *,
+        issuer: object,
+        generation: int,
+        common_attn_metadata: CommonAttentionMetadata,
+        block_table_cpu: torch.Tensor | None,
+        seq_lens_cpu: torch.Tensor | None,
+        num_accepted_tokens: torch.Tensor | None,
+        num_accepted_tokens_cpu: torch.Tensor | None,
+        num_decode_draft_tokens_cpu: torch.Tensor | None,
+    ) -> _PleShortConvSourceCapability | None:
+        """Seal one runner-owned snapshot of paired V1 metadata sources."""
+        query_start_loc = common_attn_metadata.query_start_loc
+        query_start_loc_cpu = common_attn_metadata.query_start_loc_cpu
+        block_table = common_attn_metadata.block_table_tensor
+        seq_lens = common_attn_metadata.seq_lens
+        required = (
+            query_start_loc,
+            query_start_loc_cpu,
+            block_table,
+            block_table_cpu,
+            seq_lens,
+            seq_lens_cpu,
+        )
+        if (
+            type(issuer) is not object
+            or type(generation) is not int
+            or generation <= 0
+            or not all(type(value) is torch.Tensor for value in required)
+            or (num_accepted_tokens is None) != (num_accepted_tokens_cpu is None)
+        ):
+            return None
+        optional = (
+            num_accepted_tokens,
+            num_accepted_tokens_cpu,
+            num_decode_draft_tokens_cpu,
+        )
+        if any(
+            value is not None and type(value) is not torch.Tensor for value in optional
+        ):
+            return None
+        cpu_tensors = (
+            query_start_loc_cpu,
+            block_table_cpu,
+            seq_lens_cpu,
+            num_accepted_tokens_cpu,
+            num_decode_draft_tokens_cpu,
+        )
+        if any(
+            tensor is not None and tensor.device.type != "cpu" for tensor in cpu_tensors
+        ):
+            return None
+        if any(
+            tensor is not None and tensor.dtype != torch.int32
+            for tensor in (*required, *optional)
+        ):
+            return None
+
+        paired_tensors = (
+            (query_start_loc, query_start_loc_cpu),
+            (block_table, block_table_cpu),
+            (seq_lens, seq_lens_cpu),
+            (num_accepted_tokens, num_accepted_tokens_cpu),
+        )
+        for device_tensor, cpu_tensor in paired_tensors:
+            if device_tensor is None:
+                continue
+            assert cpu_tensor is not None
+            if device_tensor is cpu_tensor:
+                return None
+            if (
+                device_tensor.device == cpu_tensor.device
+                and device_tensor.untyped_storage().data_ptr()
+                == cpu_tensor.untyped_storage().data_ptr()
+            ):
+                return None
+
+        source_items = tuple(
+            (name, tensor)
+            for name, tensor in (
+                ("query_start_loc", query_start_loc),
+                ("query_start_loc_cpu", query_start_loc_cpu),
+                ("block_table", block_table),
+                ("block_table_cpu", block_table_cpu),
+                ("seq_lens", seq_lens),
+                ("seq_lens_cpu", seq_lens_cpu),
+                ("num_accepted_tokens", num_accepted_tokens),
+                ("num_accepted_tokens_cpu", num_accepted_tokens_cpu),
+                ("num_decode_draft_tokens_cpu", num_decode_draft_tokens_cpu),
+            )
+            if tensor is not None
+        )
+        source_versions = tuple(_tensor_version(tensor) for _, tensor in source_items)
+        if any(version is None for version in source_versions):
+            return None
+        source = _PleShortConvSourceCapability(
+            issuer=issuer,
+            generation=generation,
+            query_start_loc=query_start_loc,
+            query_start_loc_cpu=query_start_loc_cpu,
+            block_table=block_table,
+            block_table_cpu=block_table_cpu,
+            seq_lens=seq_lens,
+            seq_lens_cpu=seq_lens_cpu,
+            num_accepted_tokens=num_accepted_tokens,
+            num_accepted_tokens_cpu=num_accepted_tokens_cpu,
+            num_decode_draft_tokens_cpu=num_decode_draft_tokens_cpu,
+            source_names=tuple(name for name, _ in source_items),
+            source_ids=tuple(id(tensor) for _, tensor in source_items),
+            source_versions=tuple(int(version) for version in source_versions),
+            _source_id=0,
+            _seal=_PLE_SHORT_CONV_PROOF_SEAL,
+        )
+        object.__setattr__(source, "_source_id", id(source))
+        return source
+
+    def _take_v1_sources(
+        self,
+        metadata: CommonAttentionMetadata,
+        num_accepted_tokens: torch.Tensor | None,
+        num_decode_draft_tokens_cpu: torch.Tensor | None,
+        kwargs: dict[str, Any],
+    ) -> _PleShortConvSourceCapability | None:
+        source = kwargs.pop(_V1_SOURCE_CAPABILITY_KWARG, None)
+        if not self._source_snapshot_valid(source):
+            return None
+        assert isinstance(source, _PleShortConvSourceCapability)
+        if (
+            source.query_start_loc is not metadata.query_start_loc
+            or source.query_start_loc_cpu is not metadata.query_start_loc_cpu
+            or source.block_table is not metadata.block_table_tensor
+            or source.seq_lens is not metadata.seq_lens
+            or source.seq_lens_cpu is not metadata._seq_lens_cpu
+            or source.num_accepted_tokens is not num_accepted_tokens
+            or source.num_decode_draft_tokens_cpu is not num_decode_draft_tokens_cpu
+        ):
+            return None
+        return source
+
+    @staticmethod
+    def _source_snapshot_valid(source: object) -> bool:
+        if not (
+            type(source) is _PleShortConvSourceCapability
+            and source._seal is _PLE_SHORT_CONV_PROOF_SEAL
+            and source._source_id == id(source)
+            and len(source.source_names)
+            == len(source.source_ids)
+            == len(source.source_versions)
+        ):
+            return False
+        for name, source_id, source_version in zip(
+            source.source_names,
+            source.source_ids,
+            source.source_versions,
+        ):
+            tensor = getattr(source, name, None)
+            if type(tensor) is not torch.Tensor or source_id != id(tensor):
+                return False
+            if _tensor_version(tensor) != source_version:
+                return False
+        return True
+
+    @staticmethod
+    def _cpu_output_matches(
+        output: torch.Tensor | None, expected: torch.Tensor
+    ) -> bool:
+        return output is not None and (
+            output.device.type != "cpu" or torch.equal(output, expected)
+        )
+
+    def _state_slots_cpu(
+        self, source: _PleShortConvSourceCapability
+    ) -> torch.Tensor | None:
+        num_reqs = source.seq_lens_cpu.numel()
+        if (
+            source.block_table_cpu.ndim != 2
+            or source.block_table_cpu.shape[0] != num_reqs
+        ):
+            return None
+        cache_mode = self.vllm_config.cache_config.mamba_cache_mode
+        if num_reqs == 1:
+            column = (
+                max(
+                    (int(source.seq_lens_cpu[0]) - 1) // self.kv_cache_spec.block_size,
+                    0,
+                )
+                if cache_mode == "align"
+                else 0
+            )
+            if column >= source.block_table_cpu.shape[1]:
+                return None
+            # 与 advanced indexing 一样返回独立 CPU fact，不借用可变 source view。
+            return source.block_table_cpu[:1, column].clone()
+        if cache_mode == "align":
+            columns = torch.div(
+                source.seq_lens_cpu - 1,
+                self.kv_cache_spec.block_size,
+                rounding_mode="floor",
+            ).clamp_(min=0)
+        else:
+            columns = torch.zeros(num_reqs, dtype=torch.int32)
+        if bool((columns >= source.block_table_cpu.shape[1]).any().item()):
+            return None
+        rows = torch.arange(num_reqs, dtype=torch.int64)
+        return source.block_table_cpu[rows, columns.to(torch.int64)]
+
+    def _validate_cpu_construction(
+        self,
+        metadata: PleShortConvAttentionMetadata,
+        source: _PleShortConvSourceCapability,
+    ) -> _PleShortConvValidatedCpuFacts | None:
+        num_reqs = metadata.num_reqs
+        query_start = source.query_start_loc_cpu
+        seq_lens = source.seq_lens_cpu
+        if (
+            query_start.ndim != 1
+            or query_start.numel() != num_reqs + 1
+            or seq_lens.ndim != 1
+            or seq_lens.numel() != num_reqs
+            or metadata.query_start_loc is not source.query_start_loc
+            or metadata.seq_lens is not source.seq_lens
+            or int(query_start[0].item()) != 0
+            or int(query_start[-1].item()) != metadata.num_actual_tokens
+        ):
+            return None
+        if (
+            num_reqs
+            == metadata.num_decodes
+            == metadata.num_decode_tokens
+            == metadata.num_actual_tokens
+            == 1
+            and metadata.num_prefills
+            == metadata.num_prefill_tokens
+            == metadata.num_spec_decodes
+            == metadata.num_spec_decode_tokens
+            == 0
+        ):
+            computed_tokens = int(seq_lens[0]) - 1
+            if (
+                computed_tokens < 0
+                or metadata.max_prefill_query_len != 0
+                or metadata.non_spec_query_start_loc is not source.query_start_loc
+            ):
+                return None
+            state_slots = self._state_slots_cpu(source)
+            if (
+                state_slots is None
+                or state_slots.dtype not in (torch.int32, torch.int64)
+                or int(state_slots[0]) < 0
+                or int(state_slots[0]) == NULL_BLOCK_ID
+                or not self._cpu_output_matches(
+                    metadata.state_indices_tensor, state_slots
+                )
+            ):
+                return None
+            if (
+                metadata.has_initial_states_d is not None
+                and not self._cpu_output_matches(
+                    metadata.has_initial_states_d, torch.tensor([computed_tokens > 0])
+                )
+            ):
+                return None
+            if (
+                metadata.has_initial_states_p is not None
+                and not self._cpu_output_matches(
+                    metadata.has_initial_states_p, torch.empty(0, dtype=torch.bool)
+                )
+            ):
+                return None
+            return _PleShortConvValidatedCpuFacts(state_slots)
+
+        query_lens = torch.diff(query_start)
+        computed = seq_lens - query_lens
+        if bool((query_lens < 0).any().item()) or bool((computed < 0).any().item()):
+            return None
+        state_slots = self._state_slots_cpu(source)
+        if (
+            state_slots is None
+            or state_slots.ndim != 1
+            or state_slots.numel() != num_reqs
+            or state_slots.dtype not in (torch.int32, torch.int64)
+            or bool((state_slots < 0).any().item())
+            or bool((state_slots == NULL_BLOCK_ID).any().item())
+            or torch.unique(state_slots).numel() != num_reqs
+        ):
+            return None
+
+        draft = source.num_decode_draft_tokens_cpu
+        has_spec = metadata.num_spec_decodes > 0
+        if not has_spec:
+            if metadata.num_decodes + metadata.num_prefills != num_reqs:
+                return None
+            if metadata.num_decode_tokens != metadata.num_decodes:
+                return None
+            decode_lens = query_lens[: metadata.num_decodes]
+            prefill_lens = query_lens[metadata.num_decodes :]
+            if bool((decode_lens != 1).any().item()):
+                return None
+            if metadata.num_prefill_tokens != int(prefill_lens.sum().item()):
+                return None
+            expected_max = int(prefill_lens.max().item()) if prefill_lens.numel() else 0
+            if metadata.max_prefill_query_len != expected_max:
+                return None
+            if metadata.non_spec_query_start_loc is not source.query_start_loc:
+                return None
+            expected_prefill_starts = (
+                query_start[metadata.num_decodes :] - metadata.num_decode_tokens
+            )
+            if metadata.num_prefills and not self._cpu_output_matches(
+                metadata.query_start_loc_p, expected_prefill_starts
+            ):
+                return None
+            if not self._cpu_output_matches(metadata.state_indices_tensor, state_slots):
+                return None
+            if (
+                metadata.has_initial_states_d is not None
+                and not self._cpu_output_matches(
+                    metadata.has_initial_states_d,
+                    computed[: metadata.num_decodes] > 0,
+                )
+            ):
+                return None
+            if (
+                metadata.has_initial_states_p is not None
+                and not self._cpu_output_matches(
+                    metadata.has_initial_states_p,
+                    computed[metadata.num_decodes :] > 0,
+                )
+            ):
+                return None
+            if metadata.num_spec_decode_tokens != 0:
+                return None
+            return _PleShortConvValidatedCpuFacts(state_slots)
+
+        accepted = source.num_accepted_tokens
+        accepted_cpu = source.num_accepted_tokens_cpu
+        if draft is None or accepted is None or accepted_cpu is None:
+            return None
+        if (
+            draft.ndim != 1
+            or draft.numel() != num_reqs
+            or accepted.ndim != 1
+            or accepted.numel() != num_reqs
+            or accepted_cpu.ndim != 1
+            or accepted_cpu.numel() != num_reqs
+        ):
+            return None
+        spec_mask = draft >= 0
+        decode_mask = (~spec_mask) & (query_lens == 1)
+        prefill_mask = (~spec_mask) & (query_lens > 1)
+        if bool(((~spec_mask) & ~(decode_mask | prefill_mask)).any().item()):
+            return None
+        if (
+            metadata.spec_query_len != self.num_spec + 1
+            or bool((query_lens[spec_mask] != draft[spec_mask] + 1).any().item())
+            or bool((query_lens[spec_mask] > metadata.spec_query_len).any().item())
+        ):
+            return None
+        spec_idx = spec_mask.nonzero(as_tuple=True)[0]
+        decode_idx = decode_mask.nonzero(as_tuple=True)[0]
+        prefill_idx = prefill_mask.nonzero(as_tuple=True)[0]
+        non_spec_idx = torch.cat((decode_idx, prefill_idx))
+        if (
+            metadata.num_spec_decodes != spec_idx.numel()
+            or metadata.num_decodes != decode_idx.numel()
+            or metadata.num_prefills != prefill_idx.numel()
+            or metadata.num_decode_tokens != decode_idx.numel()
+            or metadata.num_spec_decode_tokens != int(query_lens[spec_idx].sum().item())
+            or metadata.num_prefill_tokens != int(query_lens[prefill_idx].sum().item())
+        ):
+            return None
+        expected_max = (
+            int(query_lens[prefill_idx].max().item()) if prefill_idx.numel() else 0
+        )
+        if metadata.max_prefill_query_len != expected_max:
+            return None
+        if (
+            bool((computed[spec_idx] <= 0).any().item())
+            or bool((accepted_cpu[spec_idx] < 1).any().item())
+            or bool((accepted_cpu[spec_idx] > query_lens[spec_idx]).any().item())
+        ):
+            return None
+        expected_non_spec_starts = torch.zeros(
+            non_spec_idx.numel() + 1, dtype=torch.int32
+        )
+        torch.cumsum(query_lens[non_spec_idx], dim=0, out=expected_non_spec_starts[1:])
+        expected_spec_starts = torch.zeros(spec_idx.numel() + 1, dtype=torch.int32)
+        torch.cumsum(query_lens[spec_idx], dim=0, out=expected_spec_starts[1:])
+        if metadata.non_spec_query_start_loc is None:
+            if non_spec_idx.numel() != 0:
+                return None
+        elif not self._cpu_output_matches(
+            metadata.non_spec_query_start_loc, expected_non_spec_starts
+        ):
+            return None
+        expected_prefill_starts = (
+            expected_non_spec_starts[metadata.num_decodes :]
+            - metadata.num_decode_tokens
+        )
+        if metadata.num_prefills and not self._cpu_output_matches(
+            metadata.query_start_loc_p, expected_prefill_starts
+        ):
+            return None
+        if not self._cpu_output_matches(
+            metadata.spec_query_start_loc, expected_spec_starts
+        ):
+            return None
+        if not self._cpu_output_matches(
+            metadata.state_indices_tensor, state_slots[non_spec_idx]
+        ):
+            return None
+        if not self._cpu_output_matches(
+            metadata.spec_state_indices_tensor, state_slots[spec_idx]
+        ):
+            return None
+        if not self._cpu_output_matches(metadata.spec_sequence_masks, spec_mask):
+            return None
+        if not self._cpu_output_matches(
+            metadata.num_accepted_tokens, accepted_cpu[spec_idx]
+        ):
+            return None
+        if metadata.has_initial_states_d is not None and not self._cpu_output_matches(
+            metadata.has_initial_states_d, computed[decode_idx] > 0
+        ):
+            return None
+        if metadata.has_initial_states_p is not None and not self._cpu_output_matches(
+            metadata.has_initial_states_p, computed[prefill_idx] > 0
+        ):
+            return None
+
+        request_groups = torch.full((num_reqs,), 2, dtype=torch.int64)
+        request_groups[spec_idx] = 0
+        request_groups[decode_idx] = 1
+        token_groups = torch.repeat_interleave(request_groups, query_lens)
+        permutation = torch.argsort(token_groups, stable=True).to(torch.int32)
+        spec_tokens = permutation[: metadata.num_spec_decode_tokens]
+        non_spec_tokens = permutation[metadata.num_spec_decode_tokens :]
+        if not self._cpu_output_matches(
+            metadata.spec_token_indx, spec_tokens
+        ) or not self._cpu_output_matches(
+            metadata.non_spec_token_indx, non_spec_tokens
+        ):
+            return None
+        return _PleShortConvValidatedCpuFacts(
+            state_slots,
+            spec_tokens,
+            non_spec_tokens,
+        )
+
+    @staticmethod
+    def _field_proof(
+        output: torch.Tensor | None,
+        source: _PleShortConvSourceCapability,
+        source_names: tuple[str, ...],
+        transform: str,
+    ) -> _PleShortConvFieldProof | None:
+        if output is None:
+            return None
+        output_version = _tensor_version(output)
+        source_tensors = tuple(getattr(source, name) for name in source_names)
+        if output_version is None or any(
+            not isinstance(tensor, torch.Tensor) for tensor in source_tensors
+        ):
+            return None
+        source_versions = tuple(_tensor_version(tensor) for tensor in source_tensors)
+        if any(version is None for version in source_versions):
+            return None
+        proof = _PleShortConvFieldProof(
+            output=output,
+            output_id=id(output),
+            output_version=output_version,
+            source_names=source_names,
+            source_ids=tuple(id(tensor) for tensor in source_tensors),
+            source_versions=tuple(int(version) for version in source_versions),
+            transform=transform,
+            _field_id=0,
+            _seal=_PLE_SHORT_CONV_PROOF_SEAL,
+        )
+        object.__setattr__(proof, "_field_id", id(proof))
+        return proof
+
+    def _attach_construction_proof(
+        self,
+        metadata: PleShortConvAttentionMetadata,
+        source: _PleShortConvSourceCapability | None,
+    ) -> PleShortConvAttentionMetadata:
+        if source is None or not self._source_snapshot_valid(source):
+            return metadata
+        facts = self._validate_cpu_construction(metadata, source)
+        if facts is None or not self._source_snapshot_valid(source):
+            return metadata
+        grouped_sources = (
+            "query_start_loc",
+            "query_start_loc_cpu",
+            "block_table",
+            "block_table_cpu",
+            "seq_lens",
+            "seq_lens_cpu",
+        )
+        spec_sources = (*grouped_sources, "num_decode_draft_tokens_cpu")
+        accepted_sources = (
+            "num_accepted_tokens",
+            "num_accepted_tokens_cpu",
+            "num_decode_draft_tokens_cpu",
+        )
+        fields = dict(
+            state_indices=self._field_proof(
+                metadata.state_indices_tensor,
+                source,
+                spec_sources if metadata.num_spec_decodes else grouped_sources,
+                "mamba-state-slot-selection",
+            ),
+            has_initial_states_d=self._field_proof(
+                metadata.has_initial_states_d,
+                source,
+                spec_sources if metadata.num_spec_decodes else grouped_sources,
+                "computed-token-positive-decode",
+            ),
+            has_initial_states_p=self._field_proof(
+                metadata.has_initial_states_p,
+                source,
+                spec_sources if metadata.num_spec_decodes else grouped_sources,
+                "computed-token-positive-prefill",
+            ),
+            query_start_loc=self._field_proof(
+                metadata.query_start_loc,
+                source,
+                ("query_start_loc", "query_start_loc_cpu"),
+                "identity-query-starts",
+            ),
+            non_spec_query_start_loc=self._field_proof(
+                metadata.non_spec_query_start_loc,
+                source,
+                spec_sources if metadata.num_spec_decodes else grouped_sources,
+                "grouped-non-spec-query-starts",
+            ),
+            prefill_query_start_loc=self._field_proof(
+                metadata.query_start_loc_p,
+                source,
+                spec_sources if metadata.num_spec_decodes else grouped_sources,
+                "prefill-query-starts",
+            ),
+            spec_query_start_loc=self._field_proof(
+                metadata.spec_query_start_loc,
+                source,
+                spec_sources,
+                "grouped-spec-query-starts",
+            ),
+            spec_sequence_masks=self._field_proof(
+                metadata.spec_sequence_masks,
+                source,
+                ("num_decode_draft_tokens_cpu",),
+                "draft-count-spec-mask",
+            ),
+            spec_state_indices=self._field_proof(
+                metadata.spec_state_indices_tensor,
+                source,
+                spec_sources,
+                "grouped-spec-state-slots",
+            ),
+            num_accepted_tokens=self._field_proof(
+                metadata.num_accepted_tokens,
+                source,
+                accepted_sources,
+                "grouped-spec-accepted-counts",
+            ),
+            spec_token_indices=self._field_proof(
+                metadata.spec_token_indx,
+                source,
+                spec_sources,
+                "stable-spec-non-spec-token-permutation",
+            ),
+            non_spec_token_indices=self._field_proof(
+                metadata.non_spec_token_indx,
+                source,
+                spec_sources,
+                "stable-spec-non-spec-token-permutation",
+            ),
+            state_slots_cpu=self._field_proof(
+                facts.state_slots,
+                source,
+                grouped_sources,
+                "cpu-state-slot-fact",
+            ),
+            spec_token_indices_cpu=self._field_proof(
+                facts.spec_token_indices,
+                source,
+                spec_sources,
+                "cpu-spec-token-permutation-fact",
+            ),
+            non_spec_token_indices_cpu=self._field_proof(
+                facts.non_spec_token_indices,
+                source,
+                spec_sources,
+                "cpu-non-spec-token-permutation-fact",
+            ),
+        )
+        required = [
+            fields["state_indices"],
+            fields["query_start_loc"],
+            fields["state_slots_cpu"],
+        ]
+        if metadata.has_initial_states_d is not None:
+            required.append(fields["has_initial_states_d"])
+        if metadata.has_initial_states_p is not None:
+            required.append(fields["has_initial_states_p"])
+        if metadata.num_prefills:
+            required.append(fields["prefill_query_start_loc"])
+        if metadata.non_spec_query_start_loc is not None:
+            required.append(fields["non_spec_query_start_loc"])
+        if metadata.num_spec_decodes:
+            required.extend(
+                fields[name]
+                for name in (
+                    "spec_query_start_loc",
+                    "spec_sequence_masks",
+                    "spec_state_indices",
+                    "num_accepted_tokens",
+                    "spec_token_indices",
+                    "non_spec_token_indices",
+                    "spec_token_indices_cpu",
+                    "non_spec_token_indices_cpu",
+                )
+            )
+        if any(field is None for field in required):
+            return metadata
+        proof = PleShortConvConstructionProof(
+            issuer=source.issuer,
+            generation=source.generation,
+            batch_signature=_batch_signature(metadata),
+            source=source,
+            _proof_id=0,
+            _seal=_PLE_SHORT_CONV_PROOF_SEAL,
+            **fields,
+        )
+        object.__setattr__(proof, "_proof_id", id(proof))
+        return replace(metadata, construction_proof=proof)
+
+    def _build_non_spec_metadata(
+        self,
+        common_prefix_len: int,
+        common_attn_metadata: CommonAttentionMetadata,
+        fast_build: bool,
+        num_decode_draft_tokens_cpu: torch.Tensor | None,
+        source: _PleShortConvSourceCapability | None,
+        **kwargs: Any,
+    ) -> PleShortConvAttentionMetadata:
+        metadata = super().build(
+            common_prefix_len,
+            common_attn_metadata,
+            fast_build,
+            num_accepted_tokens=None,
+            **kwargs,
+        )
+        assert isinstance(metadata, PleShortConvAttentionMetadata)
+
+        state_indices_d = metadata.state_indices_tensor_d
+        if state_indices_d is not None and state_indices_d.dim() > 1:
+            state_indices_d = state_indices_d[:, 0]
+        state_indices_p = metadata.state_indices_tensor_p
+        if metadata.num_prefills == 0:
+            assert state_indices_d is not None
+            # BaseMambaAttentionMetadataBuilder pads decode state indices into
+            # a persistent tensor for full CUDA graphs. Keep those rows so the
+            # PLE decode receives one cache slot per graph-padded token.
+            state_indices_tensor = state_indices_d
+        elif metadata.num_decodes == 0:
+            assert state_indices_p is not None
+            state_indices_tensor = state_indices_p[: metadata.num_prefills]
+        else:
+            assert state_indices_d is not None
+            assert state_indices_p is not None
+            state_indices_tensor = torch.cat(
+                (state_indices_d, state_indices_p[: metadata.num_prefills])
+            )
+
+        # A no-spec *iteration* can still belong to an MTP server. Its Mamba
+        # block table has 1+K columns, so selecting [:, 0] leaves a strided 1D
+        # view when multiple prefills/decodes share this batch. The native PLE
+        # contract consumes packed state slots. Pack once in the metadata
+        # builder, before signing provenance, not once per layer or after a
+        # failed transaction. Already packed/single-row cases are no-ops.
+        state_indices_tensor = state_indices_tensor.contiguous()
+
+        has_initial_states_d = None
+        if metadata.num_decodes > 0:
+            num_computed_tokens = common_attn_metadata.compute_num_computed_tokens()
+            has_initial_states_d = num_computed_tokens[: metadata.num_decodes] > 0
+            if (
+                self.use_full_cuda_graph
+                and metadata.num_prefills == 0
+                and metadata.num_decodes <= self.decode_cudagraph_max_bs
+            ):
+                assert state_indices_d is not None
+                # Prepare tensors for CUDA graph replay. Padded rows have no
+                # initial state and use NULL_BLOCK_ID in state_indices_d.
+                num_decode_rows = state_indices_d.numel()
+                self.has_initial_states_d[: metadata.num_decodes].copy_(
+                    has_initial_states_d, non_blocking=True
+                )
+                self.has_initial_states_d[metadata.num_decodes : num_decode_rows].fill_(
+                    False
+                )
+                has_initial_states_d = self.has_initial_states_d[:num_decode_rows]
+
+        max_prefill_query_len = 0
+        if metadata.num_prefills > 0:
+            query_lens_cpu = torch.diff(common_attn_metadata.query_start_loc_cpu)
+            max_prefill_query_len = int(
+                query_lens_cpu[
+                    metadata.num_decodes : (
+                        metadata.num_decodes + metadata.num_prefills
+                    )
+                ]
+                .max()
+                .item()
+            )
+
+        metadata = replace(
+            metadata,
+            num_actual_tokens=common_attn_metadata.num_actual_tokens,
+            spec_query_len=self.num_spec + 1,
+            max_prefill_query_len=max_prefill_query_len,
+            query_start_loc=common_attn_metadata.query_start_loc,
+            state_indices_tensor=state_indices_tensor,
+            has_initial_states_d=has_initial_states_d,
+            non_spec_query_start_loc=common_attn_metadata.query_start_loc,
+            num_decode_draft_tokens_cpu=num_decode_draft_tokens_cpu,
+        )
+        return self._attach_construction_proof(metadata, source)
+
+    def build(  # type: ignore[override]
+        self,
+        common_prefix_len: int,
+        common_attn_metadata: CommonAttentionMetadata,
+        fast_build: bool = False,
+        *,
+        num_accepted_tokens: torch.Tensor | None = None,
+        num_decode_draft_tokens_cpu: torch.Tensor | None = None,
+        **kwargs: Any,
+    ) -> PleShortConvAttentionMetadata:
+        if (
+            torch.is_inference_mode_enabled()
+            and kwargs.get(_V1_SOURCE_CAPABILITY_KWARG) is not None
+        ):
+            with torch.inference_mode(False), torch.no_grad():
+                return self.build(
+                    common_prefix_len,
+                    common_attn_metadata,
+                    fast_build,
+                    num_accepted_tokens=num_accepted_tokens,
+                    num_decode_draft_tokens_cpu=num_decode_draft_tokens_cpu,
+                    **kwargs,
+                )
+
+        m = common_attn_metadata
+        source = self._take_v1_sources(
+            m,
+            num_accepted_tokens,
+            num_decode_draft_tokens_cpu,
+            kwargs,
+        )
+        spec_sequence_masks_cpu: torch.Tensor | None = None
+        # Detect speculative-decode requests. We use -1 to mark prefill and
+        # plain-decode requests, so any value >= 0 is a (multi-query)
+        # spec-decode request.
+        if self.use_spec_decode and num_decode_draft_tokens_cpu is not None:
+            candidate_mask = num_decode_draft_tokens_cpu[: m.num_reqs] >= 0
+            if bool(candidate_mask.any().item()):
+                spec_sequence_masks_cpu = candidate_mask
+
+        if spec_sequence_masks_cpu is None:
+            return self._build_non_spec_metadata(
+                common_prefix_len,
+                common_attn_metadata,
+                fast_build,
+                num_decode_draft_tokens_cpu,
+                source,
+                **kwargs,
+            )
+
+        del common_prefix_len, fast_build, kwargs
+        query_start_loc = m.query_start_loc
+        query_start_loc_cpu = m.query_start_loc_cpu
+        query_lens_cpu = torch.diff(query_start_loc_cpu)
+        block_table_tensor = mamba_get_block_table_tensor(
+            m.block_table_tensor,
+            m.seq_lens,
+            self.kv_cache_spec,
+            self.vllm_config.cache_config.mamba_cache_mode,
+        )
+
+        if query_start_loc.device.type == "cpu":
+            spec_sequence_masks = spec_sequence_masks_cpu
+        else:
+            spec_sequence_masks = async_tensor_h2d(
+                spec_sequence_masks_cpu, device=query_start_loc.device
+            )
+
+        # For causal_conv1d (non-spec prefill Triton kernel metadata).
+        nums_dict = None
+        batch_ptr = None
+        token_chunk_offset_ptr = None
+        has_initial_states_p = None
+        has_initial_states_d = None
+        num_computed_tokens_p = None
+        # Original request indices of the non-spec requests, ordered
+        # [decodes, prefills]. Used to gather per-request data consistently.
+        non_spec_req_idx_cpu: torch.Tensor | None = None
+
+        query_lens = torch.diff(query_start_loc)
+        # Per-request classification by mask, NOT by position. With
+        # spec-decode, the front decode group can contain both spec-decode
+        # requests and plain non-spec single-token decodes. Spec requests are
+        # therefore not guaranteed to occupy the first num_spec_decodes slots.
+        non_spec_mask_cpu = ~spec_sequence_masks_cpu
+        decode_mask_cpu = non_spec_mask_cpu & (query_lens_cpu == 1)
+        prefill_mask_cpu = non_spec_mask_cpu & (query_lens_cpu > 1)
+
+        num_spec_decodes = int(spec_sequence_masks_cpu.sum().item())
+        num_decodes = int(decode_mask_cpu.sum().item())
+        num_prefills = int(prefill_mask_cpu.sum().item())
+        num_decode_tokens = num_decodes
+        num_prefill_tokens = int(query_lens_cpu[prefill_mask_cpu].sum().item())
+        num_spec_decode_tokens = int(
+            query_lens_cpu[spec_sequence_masks_cpu].sum().item()
+        )
+        # Max prefill query length, CPU-side (no device-to-host sync) for the
+        # PLE dilated short-conv packing buffer.
+        max_prefill_query_len = (
+            int(query_lens_cpu[prefill_mask_cpu].max().item())
+            if num_prefills > 0
+            else 0
+        )
+
+        # Original request indices grouped as
+        # [spec | non-spec decode | non-spec prefill]; each group keeps the
+        # original (already reordered) relative order via a stable nonzero.
+        spec_req_idx_cpu = spec_sequence_masks_cpu.nonzero(as_tuple=True)[0]
+        decode_req_idx_cpu = decode_mask_cpu.nonzero(as_tuple=True)[0]
+        prefill_req_idx_cpu = prefill_mask_cpu.nonzero(as_tuple=True)[0]
+        non_spec_req_idx_cpu = torch.cat((decode_req_idx_cpu, prefill_req_idx_cpu))
+        all_spec_xpu = (
+            _XPU_PURE_SPEC_SLICE
+            and query_start_loc.device.type == "xpu"
+            and num_spec_decodes == spec_sequence_masks_cpu.numel()
+        )
+        if not all_spec_xpu:
+            spec_req_idx = spec_req_idx_cpu.to(query_start_loc.device)
+            non_spec_req_idx = non_spec_req_idx_cpu.to(query_start_loc.device)
+
+        if num_decodes == 0 and num_prefills == 0:
+            # Pure speculative-decode batch: all real tokens are spec tokens.
+            spec_token_indx = torch.arange(
+                num_spec_decode_tokens,
+                dtype=torch.int32,
+                device=query_start_loc.device,
+            )
+            non_spec_token_indx = torch.empty(
+                0, dtype=torch.int32, device=query_start_loc.device
+            )
+            if all_spec_xpu:
+                spec_state_indices_tensor = block_table_tensor[
+                    :num_spec_decodes, 0
+                ].contiguous()
+            else:
+                spec_state_indices_tensor = block_table_tensor[spec_req_idx, 0]
+            non_spec_state_indices_tensor = None
+            spec_query_start_loc = query_start_loc[: num_spec_decodes + 1]
+            non_spec_query_start_loc = None
+            non_spec_query_start_loc_cpu = None
+        else:
+            # Mixed batch: build a per-token group key consistent with the
+            # request grouping above (spec=0 | decode=1 | prefill=2) and a
+            # stable sort, so tokens of each request stay contiguous and in
+            # request order. This yields spec tokens first, then the non-spec
+            # [decode, prefill] tokens.
+            req_group = torch.full(
+                (m.num_reqs,),
+                2,
+                dtype=torch.int64,
+                device=query_start_loc.device,
+            )
+            req_group[spec_req_idx] = 0
+            req_group[decode_req_idx_cpu.to(query_start_loc.device)] = 1
+            token_group = torch.repeat_interleave(req_group, query_lens)
+            token_perm = torch.argsort(token_group, stable=True)
+            spec_token_indx = token_perm[:num_spec_decode_tokens]
+            non_spec_token_indx = token_perm[num_spec_decode_tokens:]
+
+            spec_state_indices_tensor = block_table_tensor[spec_req_idx, 0]
+            non_spec_state_indices_tensor = block_table_tensor[non_spec_req_idx, 0]
+            spec_query_start_loc = torch.zeros(
+                num_spec_decodes + 1,
+                dtype=torch.int32,
+                device=query_start_loc.device,
+            )
+            torch.cumsum(query_lens[spec_req_idx], dim=0, out=spec_query_start_loc[1:])
+            non_spec_query_start_loc = torch.zeros(
+                num_decodes + num_prefills + 1,
+                dtype=torch.int32,
+                device=query_start_loc.device,
+            )
+            torch.cumsum(
+                query_lens[non_spec_req_idx],
+                dim=0,
+                out=non_spec_query_start_loc[1:],
+            )
+            non_spec_query_start_loc_cpu = torch.zeros(
+                num_decodes + num_prefills + 1, dtype=torch.int32
+            )
+            torch.cumsum(
+                query_lens_cpu[non_spec_req_idx_cpu],
+                dim=0,
+                out=non_spec_query_start_loc_cpu[1:],
+            )
+
+        assert num_accepted_tokens is not None
+        # Accepted-token counts must follow the same request order as the
+        # speculative state indices.
+        if all_spec_xpu:
+            # Preserve the old gather's independent storage, but do not upload
+            # an identity permutation with a blocking CPU->XPU transfer.
+            num_accepted_tokens = num_accepted_tokens[:num_spec_decodes].clone()
+        else:
+            num_accepted_tokens = num_accepted_tokens[
+                spec_req_idx_cpu.to(num_accepted_tokens.device)
+            ]
+
+        # Compute the conv-state slots for the non-spec decode/prefill split,
+        # plus the initial-state masks and Triton causal_conv1d metadata.
+        if non_spec_state_indices_tensor is None:
+            state_indices_tensor = block_table_tensor[:0, 0]
+        else:
+            state_indices_tensor = non_spec_state_indices_tensor
+
+        # Build the regular decode/prefill state metadata inherited from the
+        # generic short-conv metadata contract.
+        query_start_loc_p = None
+        query_start_loc_d = None
+        state_indices_tensor_p = None
+        state_indices_tensor_d = None
+        if num_decodes > 0 or num_prefills > 0:
+            num_computed_tokens = m.compute_num_computed_tokens()
+            if non_spec_req_idx_cpu is not None:
+                non_spec_req_idx = non_spec_req_idx_cpu.to(num_computed_tokens.device)
+                num_computed_tokens = num_computed_tokens[non_spec_req_idx]
+
+            state_indices_tensor_d = state_indices_tensor[:num_decodes]
+            state_indices_tensor_p = state_indices_tensor[
+                num_decodes : num_decodes + num_prefills
+            ]
+            if num_decodes > 0:
+                has_initial_states_d = num_computed_tokens[:num_decodes] > 0
+                assert non_spec_query_start_loc is not None
+                query_start_loc_d = non_spec_query_start_loc[: num_decodes + 1]
+            if num_prefills > 0:
+                num_computed_tokens_p = num_computed_tokens[
+                    num_decodes : num_decodes + num_prefills
+                ]
+                has_initial_states_p = num_computed_tokens_p > 0
+                assert non_spec_query_start_loc is not None
+                assert non_spec_query_start_loc_cpu is not None
+                query_start_loc_p = (
+                    non_spec_query_start_loc[num_decodes:] - num_decode_tokens
+                )
+                query_start_loc_p_cpu = (
+                    non_spec_query_start_loc_cpu[num_decodes:] - num_decode_tokens
+                )
+                if query_start_loc.device.type != "cpu":
+                    nums_dict, batch_ptr, token_chunk_offset_ptr = (
+                        compute_causal_conv1d_metadata(
+                            query_start_loc_p_cpu,
+                            device=query_start_loc.device,
+                        )
+                    )
+
+        # Prepare persistent tensors for CUDA graph capture and replay.
+        # ``m.num_actual_tokens`` is already padded by the model runner.
+        # Request-level buffers use ``m.num_reqs`` while token-level buffers
+        # use their independently bounded token count.
+        batch_size = m.num_reqs
+        if (
+            self.use_full_cuda_graph
+            and num_prefills == 0
+            and num_decodes == 0
+            and spec_sequence_masks is not None
+            and num_spec_decodes <= self.decode_cudagraph_max_bs
+            and num_spec_decode_tokens <= self.decode_cudagraph_max_tokens
+        ):
+            assert spec_state_indices_tensor is not None
+            self.spec_state_indices_tensor[:num_spec_decodes].copy_(
+                spec_state_indices_tensor, non_blocking=True
+            )
+            spec_state_indices_tensor = self.spec_state_indices_tensor[:batch_size]
+            spec_state_indices_tensor[num_spec_decodes:].fill_(NULL_BLOCK_ID)
+
+            self.spec_sequence_masks[:batch_size].copy_(
+                spec_sequence_masks[:batch_size], non_blocking=True
+            )
+            spec_sequence_masks = self.spec_sequence_masks[:batch_size]
+
+            assert spec_query_start_loc is not None
+            self.spec_query_start_loc[: num_spec_decodes + 1].copy_(
+                spec_query_start_loc, non_blocking=True
+            )
+            spec_num_query_tokens = spec_query_start_loc[-1]
+            spec_query_start_loc = self.spec_query_start_loc[: batch_size + 1]
+            spec_query_start_loc[num_spec_decodes + 1 :].fill_(spec_num_query_tokens)
+
+            assert num_accepted_tokens is not None
+            self.num_accepted_tokens[:num_spec_decodes].copy_(
+                num_accepted_tokens, non_blocking=True
+            )
+            num_accepted_tokens = self.num_accepted_tokens[:batch_size]
+            num_accepted_tokens[num_spec_decodes:].fill_(1)
+
+        metadata = PleShortConvAttentionMetadata(
+            num_prefills=num_prefills,
+            num_prefill_tokens=num_prefill_tokens,
+            num_decodes=num_decodes,
+            num_decode_tokens=num_decode_tokens,
+            num_reqs=m.num_reqs,
+            num_spec_decodes=num_spec_decodes,
+            num_spec_decode_tokens=num_spec_decode_tokens,
+            num_actual_tokens=m.num_actual_tokens,
+            spec_query_len=self.num_spec + 1,
+            max_prefill_query_len=max_prefill_query_len,
+            query_start_loc=query_start_loc,
+            state_indices_tensor=state_indices_tensor,
+            has_initial_states_p=has_initial_states_p,
+            has_initial_states_d=has_initial_states_d,
+            non_spec_query_start_loc=non_spec_query_start_loc,
+            spec_query_start_loc=spec_query_start_loc,
+            spec_state_indices_tensor=spec_state_indices_tensor,
+            spec_sequence_masks=spec_sequence_masks,
+            spec_token_indx=spec_token_indx,
+            non_spec_token_indx=non_spec_token_indx,
+            token_permutation_proven=True,
+            num_accepted_tokens=num_accepted_tokens,
+            num_decode_draft_tokens_cpu=num_decode_draft_tokens_cpu,
+            nums_dict=nums_dict,
+            batch_ptr=batch_ptr,
+            token_chunk_offset_ptr=token_chunk_offset_ptr,
+            query_start_loc_p=query_start_loc_p,
+            query_start_loc_d=query_start_loc_d,
+            state_indices_tensor_p=state_indices_tensor_p,
+            state_indices_tensor_d=state_indices_tensor_d,
