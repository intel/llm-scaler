@@ -0,0 +1,221 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""TP-sharded pinned-host PLE table, following upstream PR #54371.
+
+XPU reads only selected rows using host USM on the caller's stream. IDs remain
+on device, including async/MTP inputs; no CPU token readback or worker IPC.
+"""
+
+from functools import cache
+
+import torch
+from torch import nn
+
+from vllm import envs
+from vllm.distributed import tensor_model_parallel_all_reduce
+from vllm.logger import init_logger
+from vllm.model_executor.layers.esimd_utils import load_esimd_library
+from vllm.model_executor.layers.vocab_parallel_embedding import (
+    UnquantizedEmbeddingMethod,
+    VocabParallelEmbedding,
+)
+from vllm.model_executor.utils import set_weight_attrs
+from vllm.models.qwen4_exp.common.ple import copy_ple_embedding_shard_
+from vllm.platforms import current_platform
+
+from .collectives import full_decode_all_reduce
+
+logger = init_logger(__name__)
+# A production TP8 shard is 11.92 GiB and rounds to a safe 16 GiB host block.
+# The current XPU host allocator can return a null pointer for a TP4 shard
+# (23.84 GiB rounded to 32 GiB). Keep each physical allocation TP8-sized.
+_PINNED_CHUNK_ROWS = 40_000_192
+
+
+def _validate_pinned_weight(weight: torch.Tensor) -> None:
+    if (
+        weight.device.type != "cpu"
+        or weight.numel() == 0
+        or weight.data_ptr() == 0
+        or not weight.is_pinned()
+    ):
+        raise RuntimeError(
+            "NGram offload allocation did not return valid pinned CPU storage; "
+            "refusing to copy checkpoint data into it"
+        )
+
+
+@cache
+def _lookup_op():
+    if envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl":
+        from vllm_xpu_kernels import qwen38  # noqa: F401
+
+        return torch.ops._qwen38_C.ngram_host_lookup
+    load_esimd_library("ngram_offload_ops")
+    return torch.ops.ngram_offload_ops.lookup_out_v1
+
+
+@cache
+def _chunked_lookup_op():
+    if envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl":
+        from vllm_xpu_kernels import qwen38  # noqa: F401
+
+        return torch.ops._qwen38_C.ngram_host_lookup_chunked
+    load_esimd_library("ngram_offload_ops")
+    return torch.ops.ngram_offload_ops.lookup_chunked_out_v1
+
+
+class _PinnedEmbeddingMethod(UnquantizedEmbeddingMethod):
+    # The table is already in its final format. Moving it for post-processing
+    # would temporarily allocate 23.84 GiB on each TP4 device and defeat offload.
+    requires_device_loading = False
+
+    def process_weights_after_loading(self, layer: nn.Module) -> None:
+        for weight in layer.parameters():
+            _validate_pinned_weight(weight)
+        layer._validate_checkpoint_coverage()
+        layer._refresh_lookup_weight_argument()
+
+
+class Qwen38PinnedNGramEmbedding(VocabParallelEmbedding):
+    """Same vocabulary partition/loading metadata, without a device table."""
+
+    weight: nn.Parameter
+
+    def __init__(self, num_embeddings: int, embedding_dim: int, **kwargs):
+        if not current_platform.is_xpu():
+            raise RuntimeError("This NGram offload backend requires XPU")
+        if embedding_dim != 160:
+            raise ValueError("XPU NGram offload currently requires head_dim=160")
+        operation = _lookup_op()  # Fail before allocating a large table.
+        # Reuse the ordinary TP/weight-loader contract, allocating no payload.
+        with torch.device("meta"):
+            super().__init__(num_embeddings, embedding_dim, **kwargs)
+        if self.weight.dtype not in (torch.float16, torch.bfloat16):
+            raise ValueError("XPU NGram offload supports FP16/BF16 tables")
+        attrs = self.weight.__dict__.copy()
+        rows, dtype = self.weight.shape[0], self.weight.dtype
+        self._chunk_rows = min(rows, _PINNED_CHUNK_ROWS)
+        chunk_count = (rows + self._chunk_rows - 1) // self._chunk_rows
+        if chunk_count > 8:
+            raise ValueError("NGram offload supports at most eight host chunks")
+        if chunk_count > 1:
+            operation = _chunked_lookup_op()  # Fail before allocating payload.
+        chunks = []
+        for start in range(0, rows, self._chunk_rows):
+            weight = torch.empty(
+                (min(self._chunk_rows, rows - start), embedding_dim),
+                dtype=dtype,
+                device="cpu",
+                pin_memory=True,
+            )
+            _validate_pinned_weight(weight)  # Never trust a nonempty shape alone.
+            chunks.append(nn.Parameter(weight, requires_grad=False))
+        self.weight = chunks[0]
+        self._extra_weights = nn.ParameterList(chunks[1:])
+        set_weight_attrs(self.weight, attrs)
+        self.quant_method = _PinnedEmbeddingMethod()
+        self._lookup_operation = operation
+        self._loaded_intervals: list[tuple[int, int]] = []
+        self._refresh_lookup_weight_argument()
+        self._decode_outputs: dict[tuple[int, int, int], torch.Tensor] = {}
+        logger.info(
+            "XPU NGram offload: logical CPU shard %s, %.6f GiB, "
+            "%d pinned chunk(s), TP=%d; "
+            "no device-resident table",
+            (rows, embedding_dim),
+            rows * embedding_dim * self.weight.element_size() / 2**30,
+            chunk_count,
+            self.tp_size,
+        )
+
+    def _refresh_lookup_weight_argument(self) -> None:
+        chunks = (self.weight, *self._extra_weights)
+        # Cached dispatch argument, not another registered Parameter alias.
+        object.__setattr__(
+            self,
+            "_lookup_weight_argument",
+            self.weight if len(chunks) == 1 else chunks,
+        )
+
+    @property
+    def offload_parameter_names(self) -> tuple[str, ...]:
+        return (
+            "weight",
+            *(f"_extra_weights.{i}" for i in range(len(self._extra_weights))),
+        )
+
+    def load_checkpoint_shard(self, loaded_weight: torch.Tensor, start: int) -> None:
+        base = self.shard_indices.org_vocab_start_index
+        end = self.shard_indices.org_vocab_end_index
+        for index, weight in enumerate((self.weight, *self._extra_weights)):
+            bank_start = base + index * self._chunk_rows
+            copy_ple_embedding_shard_(
+                weight.data,
+                loaded_weight,
+                checkpoint_start=start,
+                tp_start=bank_start,
+                tp_end=min(end, bank_start + weight.shape[0]),
+            )
+        overlap = (max(base, start), min(end, start + loaded_weight.shape[0]))
+        if overlap[0] < overlap[1]:
+            self._loaded_intervals.append(overlap)
+
+    def _validate_checkpoint_coverage(self) -> None:
+        # Loaded parameter names alone cannot detect a missing shard_N.weight.
+        # This is load-time CPU metadata only, with no decode overhead.
+        cursor = self.shard_indices.org_vocab_start_index
+        for start, end in sorted(self._loaded_intervals):
+            if start > cursor:
+                break
+            cursor = max(cursor, end)
+        if cursor != self.shard_indices.org_vocab_end_index:
+            raise RuntimeError("Incomplete NGram checkpoint: local TP rows are missing")
+
+    def weight_loader(self, param: nn.Parameter, loaded_weight: torch.Tensor) -> None:
+        # Preserve the ordinary unsplit checkpoint entry as well as the model's
+        # production shard_N.weight loader below.
+        if tuple(loaded_weight.shape) != (self.org_vocab_size, self.embedding_dim):
+            raise ValueError("Unexpected full NGram checkpoint shape")
+        self.load_checkpoint_shard(loaded_weight, 0)
+
+    def forward(self, ids: torch.Tensor) -> torch.Tensor:
+        # Match resident decode's stable collective address. A PLE consumer
+        # uses this borrowed result immediately on the same ordered stream;
+        # another stream or M gets separate storage. Do not retain prefill
+        # shapes (potentially thousands of distinct large allocations).
+        rows = ids.shape[0]
+        key = None
+        output = None
+        if ids.device.type == "xpu" and 1 <= rows <= 8:
+            stream = torch.xpu.current_stream(ids.device)
+            key = (ids.device.index, stream.stream_id, rows)
+            output = self._decode_outputs.get(key)
+        if (
+            output is None
+            or output.shape != (rows, 2560)
+            or output.device != ids.device
+            or output.dtype != self.weight.dtype
+            or not output.is_contiguous()
+            or output.is_neg()
+            or output.is_conj()
+            or torch._C._overlaps(output, ids)
+        ):
+            output = torch.empty(
+                (rows, 2560), dtype=self.weight.dtype, device=ids.device
+            )
+            if key is not None:
+                self._decode_outputs[key] = output
+        self._lookup_operation(
+            self._lookup_weight_argument,
+            ids,
+            output,
+            self.shard_indices.org_vocab_start_index,
+            self.shard_indices.org_vocab_end_index,
+        )
+        if self.tp_size > 1:
+            # 本地 lookup 结果无其他读者；后续 PLE 只消费归约后的值。
+            output = full_decode_all_reduce(
+                output, fallback=tensor_model_parallel_all_reduce
+            )
+        return output
