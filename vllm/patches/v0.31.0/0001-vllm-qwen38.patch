+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperConnection (HC) glue ops for Intel XPU.
+
+Torch fallbacks mirror the CUDA Triton ops in ``nvidia/ops/hc.py`` bit-for-bit
+in math. Target batch-1 FP16 grouped norm, gate mix, and combine may use the
+canonical ESIMD DSO with caller-owned outputs; unsupported cases keep the
+Torch reference.
+Reductions run in float and cast back.
+"""
+
+import math
+import os
+
+import torch
+import torch.nn.functional as F
+
+import vllm.envs as envs
+from vllm.model_executor.layers.esimd_utils import (
+    Qwen38HCOpUnavailableError,
+    get_qwen38_hc_op,
+    using_qwen38_sycl,
+)
+
+from ..audit import (
+    EVENT_ATTEMPT,
+    EVENT_ELIGIBLE,
+    EVENT_FALLBACK,
+    EVENT_HARD_ERROR_POST_SUBMIT,
+    EVENT_HARD_ERROR_PREFLIGHT,
+    EVENT_NATIVE_SUBMITTED,
+    EVENT_ZERO_WORK_SKIP,
+    NATIVE_STATS,
+    NATIVE_STATS_ENABLED,
+    PATH_HC_COMBINE,
+    PATH_HC_COMBINE_NORM,
+    PATH_HC_GATE_MIX,
+    PATH_HC_GROUPED_NORM,
+    PATH_HC_PROJECTION,
+    REASON_COMPILE_GRAPH,
+    REASON_DEVICE,
+    REASON_DISABLED,
+    REASON_DTYPE,
+    REASON_LAYOUT,
+    REASON_NONE,
+    REASON_OP_UNAVAILABLE,
+    REASON_OTHER_CONTRACT,
+    REASON_SHAPE,
+)
+from ..parameter_dispatch import standard_direct_parameters, standard_parameter_context
+
+_HC_GROUPED_NORM_COUNT = 4
+_HC_GROUPED_NORM_HIDDEN_SIZE = 2560
+_HC_GROUPED_NORM_WIDTH = _HC_GROUPED_NORM_COUNT * _HC_GROUPED_NORM_HIDDEN_SIZE
+_HC_GROUPED_NORM_OP_NAME = "hc_grouped_norm_v1"
+_HC_GROUPED_NORM_OPERATION = None
+_HC_GROUPED_NORM_OPERATION_RESOLVED = False
+_HC_GATE_MIX_COUNT = 4
+_HC_GATE_MIX_HIDDEN_SIZE = 2560
+_HC_GATE_MIX_WIDTH = _HC_GATE_MIX_COUNT * _HC_GATE_MIX_HIDDEN_SIZE
+_HC_GATE_MIX_OP_NAME = "hc_gate_mix_v1"
+_HC_GATE_MIX_OPERATION = None
+_HC_GATE_MIX_OPERATION_RESOLVED = False
+_HC_GATE_MIX_M4_OP_NAME = "hc_gate_mix_m4_v1"
+_HC_GATE_MIX_M4_OPERATION = None
+_HC_GATE_MIX_M4_OPERATION_RESOLVED = False
+_HC_GATE_MIX_MULTI_M_OP_NAME = "hc_gate_mix_multi_m_v1"
+_HC_GATE_MIX_MULTI_M_OPERATION = None
+_HC_GATE_MIX_MULTI_M_OPERATION_RESOLVED = False
+_HC_COMBINE_COUNT = 4
+_HC_COMBINE_HIDDEN_SIZE = 2560
+_HC_COMBINE_WIDTH = _HC_COMBINE_COUNT * _HC_COMBINE_HIDDEN_SIZE
+_HC_COMBINE_OP_NAME = "hc_combine_v1"
+_HC_COMBINE_OPERATION = None
+_HC_COMBINE_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_OP_NAME = "hc_combine_norm_v1"
+_HC_COMBINE_NORM_OPERATION = None
+_HC_COMBINE_NORM_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_M4_OP_NAME = "hc_combine_norm_m4_v1"
+_HC_COMBINE_NORM_M4_OPERATION = None
+_HC_COMBINE_NORM_M4_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_MULTI_M_OP_NAME = "hc_combine_norm_multi_m_v1"
+_HC_COMBINE_NORM_MULTI_M_OPERATION = None
+_HC_COMBINE_NORM_MULTI_M_OPERATION_RESOLVED = False
+_HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION = None
+_HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION_RESOLVED = False
+_HC_PROJECTION_DOWN_OP_NAME = "esimd_hc_down_fp16_out"
+_HC_PROJECTION_UP_OP_NAME = "esimd_gemv_fp16"
+_HC_PROJECTION_OPERATIONS = None
+_HC_PROJECTION_OPERATIONS_RESOLVED = False
+_HC_PROJECTION_COUNT = 4
+_HC_PROJECTION_RANK = 320
+_HC_PROJECTION_WIDTH = 10240
+_HC_PROJECTION_MERGED_WIDTH = 336
+_HC_FP32_MIN_POSITIVE = 2.0**-149
+_HC_FP32_MAX = (2.0 - 2.0**-23) * 2.0**127
+_HC_MULTI_M_MIN = 2
+_HC_MULTI_M_MAX = 8
+
+
+def _try_hc_prefill(
+    kind: str,
+    hidden: torch.Tensor,
+    inputs: tuple[torch.Tensor, ...],
+    hc_count: int,
+    outputs: tuple[torch.Tensor | None, ...],
+    eps: float | None = None,
+) -> tuple[torch.Tensor, ...] | None:
+    # 新入口只覆盖大M；旧decode/verify及自定义Tensor/modes保持原分派。
+    if (
+        hidden.ndim != 2
+        or not 9 <= hidden.shape[0] <= 4096
+        or hidden.shape[1] != 10240
+        or hidden.dtype != torch.float16
+        or hidden.device.type != "xpu"
+        or hc_count != 4
+        or os.getenv("QWEN38_HC_PREFILL_NATIVE", "1") != "1"
+        or not using_qwen38_sycl()
+        or torch.compiler.is_compiling()
+        or torch.xpu.is_current_stream_capturing()
+        or not standard_direct_parameters(hidden, *inputs)
+        or not hidden.is_contiguous()
+    ):
+        return None
+    suffix = kind.upper()
+    if not getattr(envs, f"VLLM_XPU_ENABLE_QWEN38_HC_{suffix}_NATIVE") or getattr(
+        envs, f"VLLM_XPU_DISABLE_QWEN38_HC_{suffix}_NATIVE"
+    ):
+        return None
+    if eps is not None and (
+        not math.isfinite(eps) or not _HC_FP32_MIN_POSITIVE <= eps <= _HC_FP32_MAX
+    ):
+        return None
+    if any(
+        t.device != hidden.device
+        or t.dtype != hidden.dtype
+        or t.is_neg()
+        or t.is_conj()
+        for t in inputs
+    ):
+        return None
+    rows = hidden.shape[0]
+    if kind in ("grouped_norm", "combine_norm"):
+        weight = inputs[-1]
+        if weight.shape != (10240,) or not weight.is_contiguous():
+            return None
+    if kind in ("combine", "combine_norm"):
+        block, injection = inputs[:2]
+        if (
+            block.shape != (rows, 2560)
+            or not block.is_contiguous()
+            or injection.shape != (rows, 4)
+            or injection.stride(1) != 1
+            or injection.stride(0) < 4
+        ):
+            return None
+    if kind == "gate_mix" and (
+        inputs[0].shape != hidden.shape or not inputs[0].is_contiguous()
+    ):
+        return None
+    try:
+        import vllm_xpu_kernels.qwen38  # noqa: F401
+    except ModuleNotFoundError as error:
+        if error.name not in ("vllm_xpu_kernels", "vllm_xpu_kernels.qwen38"):
+            raise
+        return None
+
+    operation = getattr(torch.ops._qwen38_C, "hc_prefill_" + kind, None)
+    if operation is None:
+        return None  # 旧库availability miss，尚未分配或提交。
+    width = 2560 if kind == "gate_mix" else 10240
+    allocated = tuple(
+        output
+        if output is not None
+        else torch.empty(
+            (hidden.shape[0], width), device=hidden.device, dtype=hidden.dtype
+        )
+        for output in outputs
+    )
+    if not standard_direct_parameters(*allocated):
+        return None
+    with standard_parameter_context(hidden, *inputs, *allocated):
+        if eps is None:
+            operation(hidden, *inputs, *allocated)
+        else:
+            operation(hidden, *inputs, *allocated, eps)
+    # 现有native完成所有geometry/alias/stride检查后提交，异常不转fallback。
+    return allocated
+
+
+def _is_hc_multi_m_rows(rows: int) -> bool:
+    return _HC_MULTI_M_MIN <= rows <= _HC_MULTI_M_MAX
