index 0000000..0e3a5b1
--- /dev/null
+++ b/vllm/model_executor/models/_qwen3_next_xpu.py
@@ -0,0 +1,1216 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Guarded adapter for optional Qwen3Next XPU ESIMD post-processing."""
+
+import importlib
+import os
+from collections.abc import Callable
+from contextlib import nullcontext
+from functools import lru_cache
+from types import MethodType
+from typing import Any, NamedTuple, cast
+
+import torch
+from torch._subclasses.fake_tensor import FakeTensor
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+import vllm.envs as envs
+from vllm.model_executor.parameter import BasevLLMParameter, ModelWeightParameter
+
+_DISABLE_ESIMD_QKV = os.environ.get("VLLM_XPU_DISABLE_ESIMD_QKV", "0") == "1"
+_PARAMETER_TYPES = (BasevLLMParameter, ModelWeightParameter)
+_BASE_PARAMETER_FUNCTION = cast(
+    MethodType, BasevLLMParameter.__torch_function__
+).__func__
+
+
+def _standard_tensor_type(kind) -> bool:
+    if kind in (torch.Tensor, torch.nn.Parameter):
+        return True
+    if kind not in _PARAMETER_TYPES:
+        return False
+    function = kind.__torch_function__
+    return getattr(function, "__func__", function) is _BASE_PARAMETER_FUNCTION
+
+
+def _direct_parameters(*values: object) -> bool:
+    if (
+        torch._C._is_torch_function_mode_enabled()
+        or torch._C._get_tracing_state() is not None
+        or _get_current_dispatch_mode() is not None
+    ):
+        return False
+    has_parameter_subclass = False
+    checked_kinds: set[type] = set()
+    for value in values:
+        if value is None:
+            continue
+        kind = type(value)
+        if kind not in checked_kinds:
+            if not _standard_tensor_type(kind):
+                return False
+            checked_kinds.add(kind)
+            has_parameter_subclass |= kind in _PARAMETER_TYPES
+    operation = (
+        _native_direct_tensor_flags_host()
+        if envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+        and os.environ.get("VLLM_XPU_DISABLE_NATIVE_TENSOR_FLAGS_HOST", "0") != "1"
+        else None
+    )
+    if operation is not None:
+        # Native metadata access does not invoke the Python tensor dispatcher.
+        # The per-call type/mode proof above is still checked before casting.
+        tensors = cast(
+            list[torch.Tensor], [value for value in values if value is not None]
+        )
+        return operation(tensors)
+    # Only bypass the inherited, unmodified Parameter metadata dispatcher.
+    # User modes/subclasses have already returned above; lazy views still miss.
+    context = (
+        torch._C.DisableTorchFunctionSubclass()
+        if has_parameter_subclass
+        else nullcontext()
+    )
+    with context:
+        # The standard-type checks above prove tensor access for non-None values.
+        tensor: Any
+        for tensor in values:
+            if tensor is not None and (tensor.is_conj() or tensor.is_neg()):
+                return False
+    return True
+
+
+def _stream_key(tensor: torch.Tensor) -> tuple[object, ...]:
+    stream = (
+        torch.xpu.current_stream(device=tensor.device)
+        if tensor.device.type == "xpu"
+        else None
+    )
+    return tensor.device, stream
+
+
+@lru_cache(maxsize=1)
+def _native_direct_tensor_flags_host():
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_C")
+    except ModuleNotFoundError as error:
+        if error.name not in ("vllm_xpu_kernels", "vllm_xpu_kernels._qwen38_C"):
+            raise
+        return None
+    operation = getattr(module, "direct_tensor_flags_host", None)
+    if operation is not None and not callable(operation):
+        raise RuntimeError("Invalid native tensor flags host ABI")
+    return operation
+
+
+@lru_cache(maxsize=1)
+def _native_host_alias_guard():
+    try:
+        module = importlib.import_module("vllm_xpu_kernels._qwen38_C")
+    except ImportError:
+        return None
+    operation = getattr(module, "tensors_disjoint_host", None)
+    if operation is not None and not callable(operation):
+        raise RuntimeError("Invalid native host alias guard ABI")
+    return operation
+
+
+def _disjoint_writes(writes, reads=()) -> bool:
+    if (
+        envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+        and not torch._C._is_torch_function_mode_enabled()
+        and torch._C._get_tracing_state() is None
+        and _get_current_dispatch_mode() is None
+        and all(t is None or _standard_tensor_type(type(t)) for t in (*writes, *reads))
+    ):
+        operation = _native_host_alias_guard()
+        if operation is not None:
+            return operation(writes, reads)
+    return _disjoint_writes_python(writes, reads)
+
+
+def _disjoint_writes_python(writes, reads=()) -> bool:
+    def memory_rows(tensor):
+        if not tensor.numel():
+            return tensor.device, 0, 0, 0, 0, 0
+        start = tensor.data_ptr()
+        item = tensor.element_size()
+        if tensor.is_contiguous():
+            width = tensor.numel() * item
+            return tensor.device, start, start + width, width, width, 1
+        # Match native GDN physical_overlap: dense inner rows with a possibly
+        # padded outer pitch, including conv/SSM slices of the same KV page.
+        inner = 1
+        for size, stride in reversed(tuple(zip(tensor.shape[1:], tensor.stride()[1:]))):
+            if size != 1 and stride != inner:
+                return None
+            inner *= size
+        if tensor.stride(0) < inner:
+            return None
+        width = inner * item
+        pitch = tensor.stride(0) * item
+        rows = tensor.shape[0]
+        return (
+            tensor.device,
+            start,
+            start + (rows - 1) * pitch + width,
+            width,
+            pitch,
+            rows,
+        )
+
+    def physical_overlap(left, right):
+        _, begin_l, end_l, width_l, pitch_l, rows_l = left
+        _, begin_r, end_r, width_r, pitch_r, rows_r = right
+        if not rows_l or not rows_r or end_l <= begin_r or end_r <= begin_l:
+            return False
+        if pitch_l == pitch_r:
+            if begin_l > begin_r:
+                return physical_overlap(right, left)
+            row, offset = divmod(begin_r - begin_l, pitch_l)
+            return (row < rows_l and offset < width_l) or (
+                row + 1 < rows_l and width_r > pitch_l - offset
+            )
+        i = j = 0
+        while i < rows_l and j < rows_r:
+            x, y = begin_l + i * pitch_l, begin_r + j * pitch_r
+            if x <= y and y - x >= width_l:
+                i += (y - x - width_l) // pitch_l + 1
+            elif y <= x and x - y >= width_r:
+                j += (x - y - width_r) // pitch_r + 1
+            else:
+                return True
+        return False
+
+    write_rows = [memory_rows(t) for t in writes]
+    read_rows = [memory_rows(t) for t in reads if t is not None]
+    if any(row is None for row in (*write_rows, *read_rows)):
+        return False  # Unsupported layouts are never treated as disjoint.
+    for index, left in enumerate(write_rows):
+        for right in write_rows[index + 1 :] + read_rows:
+            if left[0] != right[0]:
+                continue
+            if physical_overlap(left, right):
+                return False
+    return True
+
+
+def _load_esimd_module() -> object:
+    if envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl":
+        return importlib.import_module("vllm_xpu_kernels.qwen38")
+    return importlib.import_module("custom_esimd_kernels_vllm")
+
+
+def _get_base_layer_for_no_lora(layer: object) -> object | None:
+    base_layer = getattr(layer, "base_layer", None)
+    if base_layer is None:
+        return layer
+    punica_wrapper = getattr(layer, "punica_wrapper", None)
+    if not getattr(punica_wrapper, "no_lora", False):
+        return None
+    return base_layer
+
+
+def _tensor_storage_signature(tensor: object) -> tuple[object, ...] | None:
+    if not isinstance(tensor, torch.Tensor):
+        return None
+    if (
+        type(tensor) in _PARAMETER_TYPES
+        and _standard_tensor_type(type(tensor))
+        and not torch._C._is_torch_function_mode_enabled()
+        and _get_current_dispatch_mode() is None
+        and torch._C._get_tracing_state() is None
+    ):
+        with torch._C.DisableTorchFunctionSubclass():
+            return _tensor_storage_signature_impl(tensor)
+    return _tensor_storage_signature_impl(tensor)
+
+
+def _tensor_storage_signature_impl(tensor: torch.Tensor) -> tuple[object, ...]:
+    try:
+        data_ptr = None if isinstance(tensor, FakeTensor) else tensor.data_ptr()
+    except (RuntimeError, TypeError):
+        data_ptr = None
+    version = None  # Inference tensors require the explicit reload hook.
+    if not tensor.is_inference():
+        try:
+            version = tensor._version
+        except RuntimeError:
+            version = None
+    return (
+        id(tensor),
+        tensor.device,
+        tensor.dtype,
+        tuple(tensor.shape),
+        tuple(tensor.stride()),
+        data_ptr,
+        version,
+    )
+
+
+def _qkv_plan_signature(projection: object) -> tuple[object, ...]:
+    quant_method = getattr(projection, "quant_method", None)
+    return (
+        id(quant_method),
+        bool(getattr(quant_method, "is_sym_int4", False)),
+        _tensor_storage_signature(getattr(projection, "weight", None)),
+        _tensor_storage_signature(getattr(projection, "weight_scale", None)),
+        _tensor_storage_signature(getattr(projection, "weight_scale_inv", None)),
+        tuple(getattr(projection, "weight_block_size", None) or ()),
+    )
+
+
+def _indexer_int4_plan_signature(projection: object) -> tuple[object, ...]:
+    quant_method = getattr(projection, "quant_method", None)
+    return (
+        id(quant_method),
+        bool(getattr(quant_method, "is_sym_int4", False)),
+        _tensor_storage_signature(getattr(projection, "weight_esimd", None)),
+        _tensor_storage_signature(getattr(projection, "scale_esimd", None)),
+        getattr(projection, "_int4_in_features_padded", None),
+    )
+
+
+def _prepare_linear_cache(projection, x, buffer_name) -> bool:
+    parameters = tuple(
+        getattr(projection, name, None)
+        for name in (
+            "weight",
+            "weight_scale",
+            "weight_scale_inv",
+            "weight_esimd",
+            "scale_esimd",
+        )
+    )
+    if (
+        _DISABLE_ESIMD_QKV
+        or torch.compiler.is_compiling()
+        or not _direct_parameters(x, *parameters)
+        or x.ndim != 2
+        or x.shape[0] != 1
+        or x.device.type != "xpu"
+        or x.dtype != torch.float16
+        or not x.is_contiguous()
+        or getattr(projection, "gather_output", False)
+        or getattr(projection, "bias", None) is not None
+    ):
+        return False
+    signature = (
+        _qkv_plan_signature(projection),
+        _indexer_int4_plan_signature(projection),
+        _stream_key(x),
+        x.shape[1],
+    )
+    signature_name = f"{buffer_name}_signature"
+    if getattr(projection, signature_name, None) != signature:
+        # Keep old-stream storage alive until this layer is destroyed.
+        old_plan = getattr(projection, f"{buffer_name}_plan", None)
+        if old_plan is not None:
+            retired = getattr(projection, "_esimd_retired_linear_plans", None)
+            if retired is None:
+                retired = {}
+                projection._esimd_retired_linear_plans = retired
+            retired[getattr(projection, signature_name, None)] = old_plan
+        setattr(projection, f"{buffer_name}_plan", None)
+        setattr(projection, signature_name, signature)
+    return True
+
+
+class Qwen3NextQkvPostprocessResult(NamedTuple):
+    """Post-processed QKV tensors; ``gate`` has sigmoid already applied."""
+
+    q: torch.Tensor
+    k: torch.Tensor
+    v: torch.Tensor
+    gate: torch.Tensor | None
+
+
+class _QkvPostprocessPlan(NamedTuple):
+    op: Callable[..., object]
+    q_size: int
+    kv_size: int
+    expected_width: int
+    norm_wq: torch.Tensor
+    norm_wk: torch.Tensor
+    cos_sin_cache: torch.Tensor
+    q_heads: int
+    kv_heads: int
+    rotary_dim: int
+    attn_output_gate: bool
+
+
+class _Fp8LinearPlan(NamedTuple):
+    op: Callable[..., object]
+    weight: torch.Tensor
+    scale: torch.Tensor
+    output: torch.Tensor
+    block_size: tuple[int, int] | None
+
+
+class _Int4LinearPlan(NamedTuple):
+    op: Callable[..., object]
+    weight: torch.Tensor
+    scale: torch.Tensor
+    output: torch.Tensor
+    input_width: int
+
+
+class _IndexerInt4ProjectionPlan(NamedTuple):
+    op: Callable[..., object]
+    weight: torch.Tensor
+    scale: torch.Tensor
+    source_signature: tuple[object, ...]
+
+
+class Qwen3NextQkvEsimdAdapter:
+    """Own the lazy optional import and the fused kernel's output-buffer ABI."""
+
+    def __init__(
+        self,
+        module_loader: Callable[[], object] = _load_esimd_module,
+    ) -> None:
+        self._module_loader = module_loader
+        self._module: object | None = None
+        self._loaded = False
+
+    def _get_module(self) -> object | None:
+        if not self._loaded:
+            self._loaded = True
+            try:
+                self._module = self._module_loader()
+            except (AttributeError, ImportError, OSError, RuntimeError):
+                self._module = None
+        return self._module
+
+    def try_postprocess(
+        self,
+        qkv: torch.Tensor,
+        positions: torch.Tensor,
+        *,
+        projection: Any,
+        norm_wq: torch.Tensor,
+        norm_wk: torch.Tensor,
+        cos_sin_cache: torch.Tensor,
+        q_heads: int,
+        kv_heads: int,
+        head_dim: int,
+        rotary_dim: int,
+        norm_epsilon: float,
+        is_neox_style: bool,
+        attn_output_gate: bool,
+        text_only: bool,
+        positions_bounds_proven: bool = False,
+    ) -> Qwen3NextQkvPostprocessResult | None:
+        projection = _get_base_layer_for_no_lora(projection)
+        if projection is None:
+            return None
+        if (
+            _DISABLE_ESIMD_QKV
+            or torch.compiler.is_compiling()
+            or not _direct_parameters(qkv, positions, norm_wq, norm_wk, cos_sin_cache)
+        ):
+            return None
+        sycl_backend = envs.VLLM_SYM_INT4_WEIGHT_QUANT_BACKEND == "xpu_sycl"
+        # SYCL consumes live QKV/norm/cache, not projection weights or a
+        # transformed weight recipe. Native preflight validates those inputs.
+        source_signature = (
+            ("xpu_sycl",)
+            if sycl_backend
+            else (
+                _qkv_plan_signature(projection),
+                *(
+                    _tensor_storage_signature(t)
+                    for t in (norm_wq, norm_wk, cos_sin_cache)
+                ),
+            )
+        )
+        signature = (
+            source_signature,
+            q_heads,
+            kv_heads,
+            head_dim,
+            rotary_dim,
+            norm_epsilon,
+            is_neox_style,
+            attn_output_gate,
+        )
+        if getattr(projection, "_esimd_qkv_live_signature", None) != signature:
+            projection._esimd_qkv_postprocess_plan = None
+            projection._esimd_qkv_live_signature = signature
+        plan = getattr(projection, "_esimd_qkv_postprocess_plan", None)
+        if not isinstance(plan, _QkvPostprocessPlan):
+            plan = None
+        if plan is None and (
+            _DISABLE_ESIMD_QKV
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+        ):
+            return None
+
+        rows = qkv.shape[0] if qkv.ndim == 2 else 0
+        if positions.ndim == 1:
+            plain_positions = positions
+        elif text_only and positions.ndim == 2 and positions.shape == (3, rows):
+            # V1 broadcasts text-only M-RoPE positions across all three rows.
+            # Identical T/H/W coordinates reduce exactly to plain RoPE.
+            plain_positions = positions[0]
+        else:
+            return None
+        if not 1 <= rows <= 64 or plain_positions.shape[0] != rows:
+            return None
+
+        if sycl_backend and (
+            _DISABLE_ESIMD_QKV
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not positions_bounds_proven
+            or q_heads not in (3, 6)
+            or kv_heads != 1
+            or head_dim != 256
+            or rotary_dim != 64
+            or norm_epsilon != 1e-6
+            or not is_neox_style
+            or not attn_output_gate
+            or plain_positions.dtype not in (torch.int32, torch.int64)
+            or plain_positions.device != qkv.device
+            or qkv.device.type != "xpu"
+            or any(
+                t.device != qkv.device
+                or t.dtype != torch.float16
+                or not t.is_contiguous()
+                for t in (qkv, norm_wq, norm_wk, cos_sin_cache)
+            )
+            or norm_wq.shape != (head_dim,)
+            or norm_wk.shape != (head_dim,)
+            or cos_sin_cache.ndim != 2
+            or cos_sin_cache.shape[0] == 0
+            or cos_sin_cache.shape[1] != rotary_dim
+        ):
+            # Reject before position conversion can submit any device work.
+            return None
