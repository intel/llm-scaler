+        query_start_loc_cpu: torch.Tensor | None = None,
+        seq_lens_cpu: torch.Tensor | None = None,
+        async_frontier_proven: bool = True,
+    ) -> tuple[QSAHistoricalRingCapability | None, bool, tuple[int, ...] | None]:
+        """Validate scheduler QSA capabilities against this worker batch.
