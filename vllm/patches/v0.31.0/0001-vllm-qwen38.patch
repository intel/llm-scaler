+def _load_qsa_extension_without_package(package_dir) -> ModuleType | None:
+    """Load QSA directly when the core DSO already owns the package schemas."""
+    candidates = sorted(package_dir.glob("qsa_ops*.so"))
+    configured_dir = os.environ.get("VLLM_XPU_ESIMD_PACKAGE_DIR")
+    existing = sys.modules.get(_QSA_NATIVE_MODULE)
+    if existing is None:
+        existing = sys.modules.get("qsa_ops")
+    if existing is not None and not configured_dir:
+        return existing
+    if existing is not None and configured_dir:
+        existing_file = getattr(existing, "__file__", None)
+        if existing_file is not None:
+            try:
+                if Path(existing_file).resolve().parent == package_dir.resolve():
+                    return existing
+            except OSError:
+                pass
+    if not candidates:
+        return None
+    if len(candidates) != 1:
+        formatted = ", ".join(str(candidate) for candidate in candidates)
+        raise RuntimeError(f"Native QSA package is ambiguous: {formatted}")
+
+    candidate = candidates[0]
+    module_name = candidate.name.split(".", 1)[0]
+    loader = importlib.machinery.ExtensionFileLoader(module_name, str(candidate))
+    spec = importlib.util.spec_from_file_location(
+        module_name, str(candidate), loader=loader
+    )
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"Unable to load native QSA package: {candidate}")
+    # An installed package may already have imported its old qsa_ops module.
+    # Explicit package selection is authoritative for optional QSA v2; remove
+    # only the aliases owned by this loader before loading the requested DSO.
+    sys.modules.pop(module_name, None)
+    sys.modules.pop("qsa_ops", None)
+    sys.modules.pop(_QSA_NATIVE_MODULE, None)
+    module = importlib.util.module_from_spec(spec)
+    sys.modules[module_name] = module
+    sys.modules["qsa_ops"] = module
+    sys.modules[_QSA_NATIVE_MODULE] = module
+    try:
+        spec.loader.exec_module(module)
+    except Exception:
+        if sys.modules.get(module_name) is module:
+            del sys.modules[module_name]
+        if sys.modules.get("qsa_ops") is module:
+            del sys.modules["qsa_ops"]
+        if sys.modules.get(_QSA_NATIVE_MODULE) is module:
+            del sys.modules[_QSA_NATIVE_MODULE]
+        raise
+    return module
+
+
+@lru_cache(maxsize=1)
+def _load_qsa_native_module() -> ModuleType | None:
+    """Load the standard QSA extension, distinguishing absence from breakage."""
+    module: ModuleType | None
+    if using_qwen38_sycl():
+        module = importlib.import_module("vllm_xpu_kernels.qwen38_qsa")
+        observed = {name: getattr(module, name, None) for name in _QSA_SYCL_ABI}
+        if observed != _QSA_SYCL_ABI:
+            raise RuntimeError(
+                "Native QSA SYCL ABI mismatch: "
+                f"expected={_QSA_SYCL_ABI!r}, observed={observed!r}"
+            )
+        for export in (
+            "qsa_select_paged_tokens_v2",
+            "sparse_paged_attention_v2",
+            "sparse_paged_attention_q6_v1",
+        ):
+            if not callable(getattr(module, export, None)):
+                raise RuntimeError(f"Native QSA SYCL module does not export {export}")
+        return module
+    try:
+        package_dir = ensure_esimd_package_path()
+        package_spec = importlib.util.find_spec(_QSA_NATIVE_PACKAGE)
+    except (ImportError, AttributeError, ValueError) as error:
+        if not os.environ.get("VLLM_XPU_ESIMD_PACKAGE_DIR"):
+            return None
+        raise RuntimeError("Unable to inspect the native QSA package") from error
+    if package_spec is None:
+        return None
+    try:
+        # An explicit directory is a deployment contract, not merely an
+        # import-path hint.  It must win over an older wheel that may already
+        # have imported ``custom_esimd_kernels_vllm.qsa_ops``.
+        if os.environ.get("VLLM_XPU_ESIMD_PACKAGE_DIR"):
+            module = _load_qsa_extension_without_package(package_dir)
+        else:
+            core_loaded = bool(
+                torch._C._jit_get_schemas_for_operator(
+                    "custom_esimd_kernels_vllm::esimd_gemv_fp8_pern"
+                )
+            )
+            if core_loaded:
+                module = _load_qsa_extension_without_package(package_dir)
+            else:
+                module = importlib.import_module(_QSA_NATIVE_MODULE)
+    except ModuleNotFoundError as error:
+        if error.name == _QSA_NATIVE_MODULE:
+            return None
+        raise RuntimeError(
+            f"Native QSA package is present but {_QSA_NATIVE_MODULE} failed to import"
+        ) from error
+    except Exception as error:
+        raise RuntimeError(
+            f"Native QSA package is present but {_QSA_NATIVE_MODULE} failed to import"
+        ) from error
+
+    if module is None:
+        return None
+    observed_abi = {name: getattr(module, name, None) for name in _QSA_NATIVE_ABI}
+    if observed_abi != _QSA_NATIVE_ABI:
+        raise RuntimeError(
+            "Native QSA ABI mismatch: "
+            f"expected={_QSA_NATIVE_ABI!r}, observed={observed_abi!r}"
+        )
+    for export in (
+        "qsa_select_paged_tokens",
+        "qsa_select_paged_tokens_v2",
+        "sparse_paged_attention",
+        "sparse_paged_attention_v2",
+        "sparse_paged_attention_bounded",
+        "sparse_paged_attention_bounded_v2",
+    ):
+        if not callable(getattr(module, export, None)):
+            raise RuntimeError(f"Native QSA module does not export {export}")
+    return module
+
