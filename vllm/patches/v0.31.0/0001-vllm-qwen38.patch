+) -> None:
+    """Print paged-selection metadata only for an explicit crash investigation."""
+    if not _QSA_DEBUG_SELECTION_ENABLED:
+        return
+    try:
+        torch.xpu.synchronize()
+
+        def values(tensor: torch.Tensor, limit: int = 16) -> list[int]:
