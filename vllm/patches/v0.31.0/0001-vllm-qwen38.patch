+    def build_per_group_and_layer_attn_metadata(
+        self, common_attn_metadata: CommonAttentionMetadata, draft_index: int = 0
+    ) -> tuple[list[object], dict[str, object]]:
+        per_group = []
+        per_layer = {}
+        side_slots = {}
+        num_reqs = common_attn_metadata.num_reqs
+        # The primary draft mapping carries the current row-validity mask,
+        # including max-model-len clamping. A target side-cache mapping is
+        # stale after serial draft position updates and is not such a mask.
+        row_validity = common_attn_metadata.slot_mapping >= 0
+        for group in self.draft_attn_groups:
+            gid = group.kv_cache_group_id
+            source = self._qwen38_group_metadata.get(gid)
+            if source is None:
+                raise RuntimeError(f"Missing Qwen3.8 draft cache group {gid}")
+            # The shallow copy is extended with eager-only QSA fields that
+            # intentionally are not part of CommonAttentionMetadata's ABI.
+            cm: Any = copy(common_attn_metadata)
+            cm.block_table_tensor = source.block_table_tensor[:num_reqs]
+            cm.block_table_cpu = (
+                None
+                if source.block_table_cpu is None
+                else source.block_table_cpu[:num_reqs]
+            )
+            # Target row receipts do not prove draft writes, even if a cache
+            # group contains both models' layers. Never inherit that proof.
+            cm.qsa_historical_ring_capability = None
+            cm.qsa_historical_ring_capabilities = None
+            cm.qsa_ring_pending_tags = None
+            cm.qsa_ring_pending_transaction = None
+            cm.qsa_ring_pending_transactions = ()
+            # Eager QSA-only extensions intentionally stay off the common ABI.
+            cm.qsa_ring_device_guard = getattr(source, "qsa_ring_device_guard", False)
+            cm.qsa_ring_device_leases = getattr(source, "qsa_ring_device_leases", ())
+            cm.qsa_row_validity = row_validity
+            metadata = group.get_metadata_builder().build_for_drafting(
+                common_attn_metadata=cm, draft_index=draft_index
+            )
+            per_group.append(metadata)
+            for name in group.layer_names:
+                per_layer[name] = metadata
+                if gid != self.kv_cache_gid:
+                    # QSA metadata owns raw/compressed slot computation; do
+                    # not use the primary attention's block size for it.
+                    side_slots[name] = metadata.slot_mapping
+        self._qwen38_side_slot_mappings = side_slots
+        self._qwen38_side_slot_actual_tokens = common_attn_metadata.num_actual_tokens
+        return per_group, per_layer
+
+    def _get_slot_mapping(
+        self, num_tokens: int, slot_mapping: torch.Tensor | None = None
+    ) -> dict[str, torch.Tensor]:
+        result = super()._get_slot_mapping(num_tokens, slot_mapping)
+        for name, slots in self._qwen38_side_slot_mappings.items():
+            if slots.shape[0] < num_tokens:
+                actual = getattr(self, "_qwen38_side_slot_actual_tokens", None)
+                if actual is None or slots.shape[0] != actual:
+                    raise RuntimeError(
+                        "Qwen3.8 MTP QSA padding lacks valid row provenance"
+                    )
+                # Only physical graph padding is added. Never synthesize
+                # slots for missing live rows or write padding into a cache.
+                padded = slots.new_full((num_tokens,), PAD_SLOT_ID)
+                padded[:actual].copy_(slots)
+                result[name] = padded
+            else:
+                result[name] = slots[:num_tokens]
+        return result
