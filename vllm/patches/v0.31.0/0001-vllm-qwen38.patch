+def _qsa_debug_selection_output(label: str, output: torch.Tensor) -> None:
+    """Check the fixed QSA token-index ABI only when explicitly requested."""
+    if not _QSA_DEBUG_SELECTION_ENABLED:
+        return
+    torch.xpu.synchronize()
+    values = output.reshape(-1)
+    if values.numel() == 0:
+        print(f"[QSA_DEBUG_SELECTION] {label} empty", flush=True)
+        return
+    invalid = ((values < -1) | (values >= 8192)).sum().item()
+    print(
+        "[QSA_DEBUG_SELECTION] "
+        f"{label} shape={tuple(output.shape)} invalid={int(invalid)} "
+        f"min={int(values.min().item())} max={int(values.max().item())}",
+        flush=True,
+    )
