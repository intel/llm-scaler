+    def _update_positions_dependent_metadata(
+        self,
+        positions: torch.Tensor,
+        common_attn_metadata: CommonAttentionMetadata,
+        batch_size: int,
+        input_batch_size: int,
+        block_size: int,
+    ) -> torch.Tensor:
+        if batch_size < 0 or input_batch_size < batch_size or block_size <= 0:
+            raise ValueError("Invalid Qwen38 draft batch/block size")
