+def _grouped_gemma_rmsnorm_torch(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> torch.Tensor:
+    input_dtype = hidden_states.dtype
+    hidden_size = hidden_states.shape[-1] // hc_count
+    grouped = hidden_states.float().unflatten(-1, (hc_count, hidden_size))
+    variance = grouped.square().mean(-1, keepdim=True)
+    normalized = (grouped * torch.rsqrt(variance + eps)).flatten(-2)
+    return (normalized * (1.0 + weight.float())).to(input_dtype)
+
+
+def grouped_gemma_rmsnorm(
+    hidden_states: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+    *,
+    output: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Per-HC-stream GemmaRMSNorm with an optional native output buffer."""
+    work_units = int(hidden_states.shape[0]) if hidden_states.ndim else 1
+    prefill = _try_hc_prefill(
+        "grouped_norm", hidden_states, (weight,), hc_count, (output,), eps
+    )
+    if prefill is not None:
+        return prefill[0]
+    if hidden_states.numel() == 0:
+        _record_hc_grouped_norm(EVENT_ZERO_WORK_SKIP, 0)
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    _record_hc_grouped_norm(EVENT_ATTEMPT, work_units)
+    try:
+        reason = _hc_grouped_norm_native_fallback_reason(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+            output,
+        )
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if reason is not None:
+        _record_hc_grouped_norm(EVENT_FALLBACK, work_units, reason)
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    _record_hc_grouped_norm(EVENT_ELIGIBLE, work_units)
+    try:
+        operation = _get_hc_grouped_norm_operation()
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_PREFLIGHT, work_units)
+        raise
+    if operation is None:
+        _record_hc_grouped_norm(
+            EVENT_FALLBACK,
+            work_units,
+            REASON_OP_UNAVAILABLE,
+        )
+        return _grouped_gemma_rmsnorm_torch(
+            hidden_states,
+            weight,
+            eps,
+            hc_count,
+        )
+
+    assert output is not None
+    _record_hc_grouped_norm(EVENT_NATIVE_SUBMITTED, work_units)
+    try:
+        operation(hidden_states, weight, output, eps)
+    except Exception:
+        _record_hc_grouped_norm(EVENT_HARD_ERROR_POST_SUBMIT, work_units)
+        raise
+    return output
+
