+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""HyperConnection (Gated Residual) utilities for Intel XPU.
+
+Implements the HyperConnection residual scheme proposed in
+"HyperConnections" (https://arxiv.org/abs/2409.19606). This variant delays
+each HC combine to the following HC mix boundary. HC glue kernels,
+including fused combine+RMSNorm, live in ``ops/hc.py``. Batch-1 FP16
+projections may use strict raw-weight ESIMD adapters; all other cases retain the
+standard vLLM Linear modules.
+
+Hidden states between layers have shape ``[..., HC*HS]`` with HS inner
+(HC outer, HS inner — checkpoint-native layout).
+
+Typical usage inside a transformer decoder layer::
+
+    self.attn_hc = GatedResidual(hc_config)
+
+    hidden_states, block_input, injection = self.attn_hc.mix(hidden_states)
+    attention_output = attention(block_input)
+    hidden_states, block_input, injection = self.mlp_hc.combine_and_mix(
+        hidden_states, attention_output, injection
+    )
+"""
+
+import os
+from contextlib import nullcontext
+from functools import lru_cache
+from importlib import import_module
+
+import torch
+from torch import nn
+
+from vllm.lora.layers.base import BaseLayerWithLoRA
+from vllm.model_executor.layers.esimd_utils import (
+    Qwen38HCOpUnavailableError,
+    ensure_esimd_package_path,
+    get_qwen38_hc_op,
+    using_qwen38_sycl,
+)
+from vllm.model_executor.layers.linear import (
+    MergedColumnParallelLinear,
+    ReplicatedLinear,
+    UnquantizedLinearMethod,
+)
+from vllm.model_executor.models.utils import maybe_prefix
+from vllm.model_executor.parameter import BasevLLMParameter
+from vllm.model_executor.parameter import ModelWeightParameter as ModelWeightParameter
+from vllm.models.qwen4_exp.common.hyperconnection import (
+    GroupedGemmaRMSNorm,
+    HyperConnectionConfig,
+)
+
+from .audit import NATIVE_STATS_ENABLED
+from .ops import hc as hc_ops
+from .ops.hc import (
+    grouped_gemma_rmsnorm,
+    hc_combine,
+    hc_combine_norm,
+    hc_gate_mix,
+    hc_silu,
+    should_prepare_hc_combine_norm_outputs,
+    should_prepare_hc_combine_output,
+    should_prepare_hc_gate_mix_output,
+    should_prepare_hc_grouped_norm_output,
+    should_prepare_hc_projection_outputs,
+    try_hc_projection_native,
+)
+from .parameter_dispatch import standard_direct_parameters, standard_parameter_context
+
+_DIRECT_WORKSPACE = os.getenv("VLLM_XPU_QWEN38_DIRECT_WORKSPACE", "1") == "1"
+_HC_MULTI_DIRECT = os.getenv("VLLM_XPU_QWEN38_HC_MULTI_DIRECT", "1") == "1"
+
+_PLAIN_PARAMETER_VIEWS = os.getenv("VLLM_XPU_QWEN38_PLAIN_PARAMETER_VIEWS", "1") == "1"
+_HC_NATIVE_PREFLIGHT_ENABLED = (
+    os.getenv("VLLM_XPU_QWEN38_HC_NATIVE_PREFLIGHT", "1") == "1"
+)
+_HC_PARAMETER_DISPATCH_GUARD_ENABLED = (
+    os.getenv("VLLM_XPU_QWEN38_HC_PARAMETER_DISPATCH_GUARD", "1") == "1"
+)
+_HC_HOST_CHAIN_ENABLED = os.getenv("VLLM_XPU_QWEN38_HC_HOST_CHAIN", "1") == "1"
+_HC_FUSED_UP_GATE = os.getenv("VLLM_XPU_QWEN38_HC_FUSED_UP_GATE", "1") == "1"
+_HC_BATCHED_ALIAS_CHECK = (
+    os.getenv("VLLM_XPU_QWEN38_HC_BATCHED_ALIAS_CHECK", "1") == "1"
+)
+_HC_HOST_HOTPATH_ENABLED = os.getenv("VLLM_XPU_QWEN38_HC_HOST_HOTPATH", "1") == "1"
+_HC_MULTI_HOST_CHAIN_ENABLED = (
+    os.getenv("VLLM_XPU_DISABLE_QWEN38_HC_MULTI_HOST_CHAIN", "0") != "1"
+)
+
+
+def _hc_parameter_dispatch_context(*values: object):
+    """Disable standard parameter dispatch only for the M=1 native probe."""
+    if not _HC_PARAMETER_DISPATCH_GUARD_ENABLED:
+        return nullcontext()
+    return standard_parameter_context(*values)
+
+
+@lru_cache(maxsize=1)
+def _get_hc_alias_check_operation():
+    try:
+        return get_qwen38_hc_op("hc_outputs_alias_inputs_v1")
+    except Qwen38HCOpUnavailableError:
+        return None
+
+
+def _hc_outputs_alias_inputs(outputs, inputs):
+    operation = _get_hc_alias_check_operation() if _HC_BATCHED_ALIAS_CHECK else None
+    if operation is not None:
+        return operation(outputs, inputs)
+    # Old DSOs retain the exact original rule; never approximate storage aliasing
+    # with data_ptr or StorageImpl identity (shared-owner storage also aliases).
+    return any(torch._C._is_alias_of(out, value) for out in outputs for value in inputs)
+
+
+@lru_cache(maxsize=1)
+def _get_hc_host_chain_operation():
+    if _HC_FUSED_UP_GATE:
+        try:
+            return get_qwen38_hc_op("hc_combine_mix_m1_v2")
+        except Qwen38HCOpUnavailableError:
+            pass
+    try:
+        return get_qwen38_hc_op("hc_combine_mix_m1_v1")
+    except Qwen38HCOpUnavailableError:
+        return None
+
+
+@lru_cache(maxsize=1)
+def _get_hc_host_chain_workspace_class():
+    """Return the optional native HC M=1 workspace class.
+
+    The class is registered by the canonical main DSO together with the v2
+    host-chain operator.  A missing class is an availability miss so an older
+    DSO keeps using the existing Python-owned scratch fallback; errors proving
+    that the canonical DSO itself is invalid remain hard failures.
+    """
+    if using_qwen38_sycl():
+        import_module("vllm_xpu_kernels.qwen38")
+        try:
+            return torch.classes.qwen38_hc_sycl.HCWorkspace
+        except RuntimeError:
+            return None
+    try:
+        get_qwen38_hc_op("hc_combine_mix_m1_v2")
+    except Qwen38HCOpUnavailableError:
+        return None
+    try:
+        return torch.classes.custom_esimd_kernels_vllm.HCWorkspace
+    except RuntimeError:
+        return None
+
+
+@lru_cache(maxsize=1)
+def _get_hc_direct_workspace_class():
+    if using_qwen38_sycl():
+        module = import_module("vllm_xpu_kernels._qwen38_C")
+        return getattr(module, "HCWorkspaceDirectV1", None)
+    if _get_hc_host_chain_workspace_class() is None:
+        return None
+    ensure_esimd_package_path()
+    module = import_module("custom_esimd_kernels_vllm.custom_esimd_kernels")
+    return getattr(module, "HCWorkspaceDirectV1", None)
+
+
+@lru_cache(maxsize=1)
+def _get_hc_multi_host_chain_workspace_class():
+    if using_qwen38_sycl():
+        import_module("vllm_xpu_kernels.qwen38")
+        try:
+            return torch.classes.qwen38_hc_sycl.HCMultiMWorkspaceV1
+        except RuntimeError:
+            return None
+    # Resolve every optional stage before constructing a workspace. An older
+    # main DSO continues through the established multi-M implementation.
+    try:
+        for name in (
+            "hc_combine_norm_multi_m_strided_v1",
+            "esimd_hc_down_fp16_multi_m_out_v1",
+            "esimd_hc_up_gate_mix_multi_m_v1",
+        ):
+            get_qwen38_hc_op(name)
+    except Qwen38HCOpUnavailableError:
+        return None
+    try:
+        return torch.classes.custom_esimd_kernels_vllm.HCMultiMWorkspaceV1
+    except RuntimeError:
+        return None
+
+
+@lru_cache(maxsize=1)
+def _get_hc_multi_direct_workspace_class():
+    if using_qwen38_sycl():
+        module = import_module("vllm_xpu_kernels._qwen38_C")
+        return getattr(module, "HCMultiMWorkspaceDirectV1", None)
+    if _get_hc_multi_host_chain_workspace_class() is None:
+        return None
+    ensure_esimd_package_path()
+    module = import_module("custom_esimd_kernels_vllm.custom_esimd_kernels")
+    return getattr(module, "HCMultiMWorkspaceDirectV1", None)
+
+
+def _raw_hc_fp16_weight_or_none(
+    layer: object,
+    *,
+    expected_type: type[nn.Module],
+    out_features: int,
+    in_features: int,
+    device: torch.device,
+    merged: bool,
+    validate_geometry: bool = True,
+) -> torch.Tensor | None:
+    # LoRA wrappers expose base_layer.weight, which omits the active delta.
+    if isinstance(layer, BaseLayerWithLoRA):
+        return None
+    if type(layer) is not expected_type:
+        return None
+    if getattr(layer, "quant_config", None) is not None:
+        return None
+    if type(getattr(layer, "quant_method", None)) is not UnquantizedLinearMethod:
+        return None
+    if getattr(layer, "bias", None) is not None:
+        return None
+    if merged and (
+        not getattr(layer, "disable_tp", False)
+        or getattr(layer, "tp_size", None) != 1
+        or getattr(layer, "gather_output", False)
+    ):
+        return None
+
+    weight = getattr(layer, "weight", None)
+    if not isinstance(weight, torch.Tensor):
+        return None
+    if not validate_geometry:
+        # The optional C++ workspace entry checks the live TensorImpl before
+        # any submit. Keep the original Parameter, including storage rebinding.
+        return weight
+    if _PLAIN_PARAMETER_VIEWS and isinstance(weight, BasevLLMParameter):
+        # Use the live storage without the loader subclass's Python dispatch
+        # on every metadata check and native invocation. No weight is copied.
+        weight = weight.detach()
+    if (
+        weight.layout != torch.strided
+        or weight.dtype != torch.float16
+        or weight.device != device
+        or weight.ndim != 2
+        or tuple(weight.shape) != (out_features, in_features)
+        or not weight.is_contiguous()
+        or tuple(weight.stride()) != (in_features, 1)
+    ):
+        return None
+    return weight
+
+
+# ---------------------------------------------------------------------------
+# Gated-residual variant
+# ---------------------------------------------------------------------------
+class GatedResidual(nn.Module):
+    """Gated HyperConnection with learnable low-rank mixing and injection.
+
+    ``combine_and_mix()`` runs the pre pipeline (grouped GemmaRMSNorm -> merged
+    low-rank down+inject GEMM -> silu -> up GEMM -> sigmoid -> gated mean
+    over the HC streams). When passed a pending block output and an injection,
+    it fuses their residual combine with the RMSNorm. Final mixers use
+    ``use_combine=False`` and do not produce a new injection.
+
+    Weights: the norm owns the grouped GemmaRMSNorm affine; the projections
+    are vLLM Linear modules (merged replicated linear for down+inject), so
+    GEMM dispatch (e.g. the low-latency skinny GEMM) applies through the
+    standard quant_method mechanism.
+    """
+
+    def __init__(
+        self,
+        config: HyperConnectionConfig,
+        use_combine: bool = True,
+        prefix: str = "",
+    ) -> None:
+        super().__init__()
+        self.config = config
+        self.lora_rank = config.hc_lowrank
+        self.hc_count = config.hc_count
+        self.hidden_size = config.hidden_size
+        self.use_combine = use_combine
+        self._hc_host_chain_buffers: dict[tuple, tuple[torch.Tensor, ...]] = {}
+        self._hc_host_chain_last_buffer_key: tuple | None = None
+        self._hc_host_chain_last_buffers: tuple[torch.Tensor, ...] | None = None
+        self._hc_host_chain_workspace = None
+        self._hc_host_chain_workspace_run = None
+        self._hc_host_chain_workspace_try_run = None
+        self._hc_host_chain_workspace_checked = False
+        self._hc_multi_host_chain_workspace = None
+        self._hc_multi_host_chain_workspace_run = None
+        self._hc_multi_host_chain_workspace_checked = False
+
+        norm_size = (
+            self.hyper_hidden_size if config.hc_per_branch_norm else config.hidden_size
+        )
+        group_size = config.hidden_size if config.hc_per_branch_norm else None
+        # Normalize each H-sized HC stream independently while retaining a
+        # separate affine weight for every element of the HC*H layout.
+        self.hc_norm = GroupedGemmaRMSNorm(
+            norm_size,
+            eps=config.rms_norm_eps,
+            group_size=group_size,
+            dtype=config.params_dtype,
+        )
+        self.register_buffer(
+            "_hc_grouped_norm_output",
+            None,
+            persistent=False,
+        )
+        self.register_buffer(
+            "_hc_gate_mix_output",
+            None,
+            persistent=False,
+        )
+        self.register_buffer(
+            "_hc_combine_output",
+            None,
+            persistent=False,
+        )
+        self.register_buffer(
+            "_hc_projection_down_output",
+            None,
+            persistent=False,
+        )
+        self.register_buffer(
+            "_hc_projection_up_output",
+            None,
+            persistent=False,
+        )
+
+        # -- vLLM Linear weights --------------------------------------------
+        # The merged skinny-GEMM shape is physically padded to 16 rows for
+        # alignment and efficient low-row-count kernel dispatch.
+        self.pad_size = (-(self.lora_rank + self.hc_count)) % 16 if use_combine else 0
+        if use_combine:
+            self.input_mix_weight_down_block_inject = MergedColumnParallelLinear(
+                self.hyper_hidden_size,
+                [self.lora_rank, self.hc_count]
+                + ([self.pad_size] if self.pad_size else []),
+                bias=False,
+                params_dtype=config.params_dtype,
+                quant_config=None,
+                prefix=maybe_prefix(prefix, "input_mix_weight_down_block_inject"),
+                return_bias=False,
+                disable_tp=True,
+            )
+        else:
+            self.input_mix_weight_down = ReplicatedLinear(
+                self.hyper_hidden_size,
+                self.lora_rank,
+                bias=False,
+                params_dtype=config.params_dtype,
+                quant_config=None,
+                prefix=maybe_prefix(prefix, "input_mix_weight_down"),
+                return_bias=False,
+            )
+        self.input_mix_weight_up = ReplicatedLinear(
+            self.lora_rank,
+            self.hyper_hidden_size,
+            bias=False,
+            params_dtype=config.params_dtype,
+            quant_config=None,
+            prefix=maybe_prefix(prefix, "input_mix_weight_up"),
+            return_bias=False,
+        )
+
+    def _get_hc_grouped_norm_output(
+        self,
+        hidden_states: torch.Tensor,
+    ) -> torch.Tensor | None:
+        weight = self.hc_norm.weight
+        if not should_prepare_hc_grouped_norm_output(
+            hidden_states,
+            weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+        ):
+            return None
+
+        output = self._hc_grouped_norm_output
+        if (
+            not isinstance(output, torch.Tensor)
+            or output.shape != hidden_states.shape
+            or output.dtype != hidden_states.dtype
+            or output.device != hidden_states.device
+            or not output.is_contiguous()
+        ):
+            output = torch.empty_like(
+                hidden_states,
+                memory_format=torch.contiguous_format,
+            )
+            self._hc_grouped_norm_output = output
+        return output
+
+    def _get_hc_gate_mix_output(
+        self,
+        x: torch.Tensor,
+        gate: torch.Tensor,
+    ) -> torch.Tensor | None:
+        if not should_prepare_hc_gate_mix_output(x, gate, self.hc_count):
+            return None
+
+        expected_shape = (x.shape[0], self.hidden_size)
+        output = self._hc_gate_mix_output
+        if (
+            not isinstance(output, torch.Tensor)
+            or output.shape != expected_shape
+            or output.dtype != x.dtype
+            or output.device != x.device
+            or not output.is_contiguous()
+        ):
+            output = torch.empty(
+                expected_shape,
+                dtype=x.dtype,
+                device=x.device,
+            )
+            self._hc_gate_mix_output = output
+        return output
+
+    def _get_hc_combine_output(
+        self,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor,
+        injection: torch.Tensor,
+    ) -> torch.Tensor | None:
+        if not should_prepare_hc_combine_output(
+            hidden_states,
+            block_output,
+            injection,
+            self.hc_count,
+        ):
+            return None
+
+        output = self._hc_combine_output
+        if (
+            not isinstance(output, torch.Tensor)
+            or output.shape != hidden_states.shape
+            or output.dtype != hidden_states.dtype
+            or output.device != hidden_states.device
+            or not output.is_contiguous()
+        ):
+            output = torch.empty_like(
+                hidden_states,
+                memory_format=torch.contiguous_format,
+            )
+            self._hc_combine_output = output
+        return output
+
+    def _get_hc_combine_norm_outputs(
+        self,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor,
+        injection: torch.Tensor,
+        *,
+        combine_output: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor | None, torch.Tensor | None]:
+        weight = self.hc_norm.weight
+        if not should_prepare_hc_combine_norm_outputs(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+        ):
+            return (
+                self._get_hc_combine_output(
+                    hidden_states,
+                    block_output,
+                    injection,
+                ),
+                self._get_hc_grouped_norm_output(hidden_states),
+            )
+
+        inputs = (hidden_states, block_output, injection, weight)
+        if combine_output is None:
+            combine_output = self._hc_combine_output
+        if (
+            not isinstance(combine_output, torch.Tensor)
+            or combine_output.shape != hidden_states.shape
+            or combine_output.dtype != hidden_states.dtype
+            or combine_output.device != hidden_states.device
+            or not combine_output.is_contiguous()
+            or combine_output.storage_offset() % 2 != 0
+            or any(
+                torch._C._is_alias_of(combine_output, input_tensor)
+                for input_tensor in inputs
+            )
+        ):
+            combine_output = torch.empty_like(
+                hidden_states,
+                memory_format=torch.contiguous_format,
+            )
+            self._hc_combine_output = combine_output
+
+        norm_output = self._hc_grouped_norm_output
+        if (
+            not isinstance(norm_output, torch.Tensor)
+            or norm_output.shape != hidden_states.shape
+            or norm_output.dtype != hidden_states.dtype
+            or norm_output.device != hidden_states.device
+            or not norm_output.is_contiguous()
+            or norm_output.storage_offset() % 2 != 0
+            or any(
+                torch._C._is_alias_of(norm_output, input_tensor)
+                for input_tensor in inputs
+            )
+            or torch._C._is_alias_of(norm_output, combine_output)
+        ):
+            norm_output = torch.empty_like(
+                hidden_states,
+                memory_format=torch.contiguous_format,
+            )
+            self._hc_grouped_norm_output = norm_output
+        return combine_output, norm_output
+
+    def _get_hc_projection_weights(
+        self,
+        x: torch.Tensor,
+        *,
+        native_preflight: bool = False,
+    ) -> tuple[torch.Tensor | None, torch.Tensor | None]:
+        if self.use_combine:
+            down_layer = self.input_mix_weight_down_block_inject
+            down_type = MergedColumnParallelLinear
+            down_width = self.lora_rank + self.hc_count + self.pad_size
+        else:
+            down_layer = self.input_mix_weight_down
+            down_type = ReplicatedLinear
+            down_width = self.lora_rank
+        down_weight = _raw_hc_fp16_weight_or_none(
+            down_layer,
+            expected_type=down_type,
+            out_features=down_width,
+            in_features=self.hyper_hidden_size,
+            device=x.device,
+            merged=self.use_combine,
+            validate_geometry=not native_preflight,
+        )
+        up_weight = _raw_hc_fp16_weight_or_none(
+            self.input_mix_weight_up,
+            expected_type=ReplicatedLinear,
+            out_features=self.hyper_hidden_size,
+            in_features=self.lora_rank,
+            device=x.device,
+            merged=False,
+            validate_geometry=not native_preflight,
+        )
+        return down_weight, up_weight
+
+    def _get_hc_projection_outputs(
+        self,
+        x: torch.Tensor,
+        down_weight: torch.Tensor | None,
+        up_weight: torch.Tensor | None,
+    ) -> tuple[torch.Tensor | None, torch.Tensor | None]:
+        if not should_prepare_hc_projection_outputs(
+            x,
+            down_weight,
+            up_weight,
+            self.hc_count,
+            self.use_combine,
+        ):
+            return None, None
+        assert isinstance(down_weight, torch.Tensor)
+        assert isinstance(up_weight, torch.Tensor)
+        inputs = (x, down_weight, up_weight)
+        down_width = (
+            self.lora_rank + self.hc_count + self.pad_size
+            if self.use_combine
+            else self.lora_rank
+        )
+
+        down_output = self._hc_projection_down_output
+        if (
+            not isinstance(down_output, torch.Tensor)
+            or down_output.shape != (1, down_width)
+            or down_output.dtype != x.dtype
+            or down_output.device != x.device
+            or not down_output.is_contiguous()
+            or down_output.storage_offset() % 2 != 0
+            or any(
+                torch._C._is_alias_of(down_output, input_tensor)
+                for input_tensor in inputs
+            )
+        ):
+            down_output = torch.empty(
+                (1, down_width),
+                dtype=x.dtype,
+                device=x.device,
+            )
+            self._hc_projection_down_output = down_output
+
+        up_output = self._hc_projection_up_output
+        if (
+            not isinstance(up_output, torch.Tensor)
+            or up_output.shape != (1, self.hyper_hidden_size)
+            or up_output.dtype != x.dtype
+            or up_output.device != x.device
+            or not up_output.is_contiguous()
+            or up_output.storage_offset() % 2 != 0
+            or any(
+                torch._C._is_alias_of(up_output, input_tensor)
+                for input_tensor in inputs
+            )
+            or torch._C._is_alias_of(up_output, down_output)
+        ):
+            up_output = torch.empty(
+                (1, self.hyper_hidden_size),
+                dtype=x.dtype,
+                device=x.device,
+            )
+            self._hc_projection_up_output = up_output
+        return down_output, up_output
+
+    def _project_hc_gate(
+        self,
+        x: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        down_weight, up_weight = self._get_hc_projection_weights(x)
+        down_output, up_output = self._get_hc_projection_outputs(
+            x,
+            down_weight,
+            up_weight,
+        )
+        native = try_hc_projection_native(
+            x,
+            down_weight,
+            up_weight,
+            down_output,
+            up_output,
+            self.hc_count,
+            merged=self.use_combine,
+        )
+        if native is not None:
+            return native
+
+        if self.use_combine:
+            split_sizes = [self.lora_rank, self.hc_count, self.pad_size]
+            down_and_injection = self.input_mix_weight_down_block_inject(x)
+            lora, injection, _ = down_and_injection.split(
+                split_sizes,
+                dim=-1,
+            )
+        else:
+            lora = self.input_mix_weight_down(x)
+            injection = None
+        lora = hc_silu(lora, self.hc_count)
+        gate = self.input_mix_weight_up(lora)
+        return gate, injection
+
+    def mix(
+        self, hidden_states: torch.Tensor
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+        xn = grouped_gemma_rmsnorm(
+            hidden_states,
+            self.hc_norm.weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+            output=self._get_hc_grouped_norm_output(hidden_states),
+        )
+
+        gate, injection = self._project_hc_gate(xn)
+        block_input = hc_gate_mix(
+            xn,
+            gate,
+            self.hc_count,
+            output=self._get_hc_gate_mix_output(xn, gate),
+        )
+
+        return hidden_states, block_input, injection
+
+    def combine_and_mix(
+        self,
+        hidden_states: torch.Tensor,
+        prev_block_output: torch.Tensor,
+        prev_injection: torch.Tensor,
+        *,
+        combine_output: torch.Tensor | None = None,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+        """Consume a pending combine, then prepare the next block input.
+
+        ``hidden_states`` is the multi-stream state from before the pending
+        block's mix. Its combine with ``block_output`` is fused with this
+        module's input RMSNorm.
+        """
+        if combine_output is None:
+            native = self._try_hc_host_chain(
+                hidden_states, prev_block_output, prev_injection
+            )
+            if native is not None:
+                return native
+        combine_output, norm_output = self._get_hc_combine_norm_outputs(
+            hidden_states,
+            prev_block_output,
+            prev_injection,
+            combine_output=combine_output,
+        )
+        hidden_states, xn = hc_combine_norm(
+            hidden_states,
+            prev_block_output,
+            prev_injection,
+            self.hc_norm.weight,
+            self.config.rms_norm_eps,
+            self.hc_count,
+            combine_output=combine_output,
+            output=norm_output,
+        )
+
+        gate, injection = self._project_hc_gate(xn)
+        block_input = hc_gate_mix(
+            xn,
+            gate,
+            self.hc_count,
+            output=self._get_hc_gate_mix_output(xn, gate),
+        )
+
+        return hidden_states, block_input, injection
+
+    def _get_hc_host_chain_workspace(self):
+        if not self._hc_host_chain_workspace_checked:
+            workspace = None
+            workspace_run = None
+            workspace_class = _get_hc_host_chain_workspace_class()
+            if workspace_class is not None:
+                # The lookup handles a missing class in an older DSO. A
+                # present but broken constructor/ABI is not an availability
+                # miss to silently hide behind fallback.
+                workspace = workspace_class()
+                workspace_run = workspace.run
+                if not callable(workspace_run):
+                    raise RuntimeError("HC workspace exposes a non-callable run")
+            self._hc_host_chain_workspace = workspace
+            self._hc_host_chain_workspace_run = workspace_run
+            # Older native classes return None for this absent optional method.
+            # A present but broken entry is an ABI error, not a fallback miss.
+            try_run = getattr(workspace, "try_run", None)
+            if try_run is not None and not callable(try_run):
+                raise RuntimeError("HC workspace exposes a non-callable try_run")
+            self._hc_host_chain_workspace_try_run = try_run
+            direct_run = None
+            if _DIRECT_WORKSPACE and try_run is not None:
+                direct_class = _get_hc_direct_workspace_class()
+                if direct_class is not None:
+                    direct = direct_class()
+                    direct_run = direct.try_run
+                    if not callable(direct_run):
+                        raise RuntimeError("HC direct workspace has invalid try_run")
+                    self._hc_direct_workspace = direct
+            self._hc_direct_workspace_try_run = direct_run
+            self._hc_host_chain_workspace_checked = True
+        return self._hc_host_chain_workspace
+
+    def _try_hc_host_chain(self, hidden_states, block_output, injection):
+        if hidden_states.ndim == 2 and 2 <= hidden_states.shape[0] <= 8:
+            return self._try_hc_multi_host_chain(hidden_states, block_output, injection)
+        if (
+            not _HC_HOST_CHAIN_ENABLED
+            or NATIVE_STATS_ENABLED
+            or not self.use_combine
+            or self.hc_count != 4
+            or self.hidden_size != 2560
+            or self.lora_rank != 320
+            or self.config.rms_norm_eps != 1e-6
+            or torch.compiler.is_compiling()
+            or hidden_states.device.type != "xpu"
+            or hidden_states.dtype != torch.float16
+            or hidden_states.shape != (1, 10240)
+        ):
+            return None
+        if (
+            not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+            or not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_PROJECTION_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_PROJECTION_NATIVE
+            or not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_GATE_MIX_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_GATE_MIX_NATIVE
+        ):
+            return None
+        if (
+            _HC_NATIVE_PREFLIGHT_ENABLED
+            and _HC_HOST_HOTPATH_ENABLED
+            and _HC_FUSED_UP_GATE
+            and _HC_BATCHED_ALIAS_CHECK
+            and type(hidden_states) is torch.Tensor
+            and type(block_output) is torch.Tensor
+            and type(injection) is torch.Tensor
+        ):
+            self._get_hc_host_chain_workspace()
+            try_run = self._hc_host_chain_workspace_try_run
+            if try_run is not None:
+                down_weight, up_weight = self._get_hc_projection_weights(
+                    hidden_states, native_preflight=True
+                )
+                weight = self.hc_norm.weight
+                if (
+                    down_weight is None
+                    or up_weight is None
+                    or not isinstance(weight, torch.Tensor)
+                ):
+                    return None
+                # None means unsupported BEFORE submit; do not catch execution
+                # errors or fall back after a partial native transaction.
+                direct_run = self._hc_direct_workspace_try_run
+                if (
+                    _DIRECT_WORKSPACE
+                    and direct_run is not None
+                    and standard_direct_parameters(weight, down_weight, up_weight)
+                ):
+                    return direct_run(
+                        hidden_states,
+                        block_output,
+                        injection,
+                        weight,
+                        down_weight,
+                        up_weight,
+                        self.config.rms_norm_eps,
+                    )
+                with _hc_parameter_dispatch_context(weight, down_weight, up_weight):
+                    return try_run(
+                        hidden_states,
+                        block_output,
+                        injection,
+                        weight,
+                        down_weight,
+                        up_weight,
+                        self.config.rms_norm_eps,
+                    )
+        for tensor, shape in (
+            (hidden_states, (1, 10240)),
+            (block_output, (1, 2560)),
+            (injection, (1, 4)),
+        ):
+            if (
+                not isinstance(tensor, torch.Tensor)
+                or tensor.shape != shape
+                or tensor.dtype != torch.float16
+                or tensor.device != hidden_states.device
+                or not tensor.is_contiguous()
+                or tensor.data_ptr() % 4
+            ):
+                return None
+        down_weight, up_weight = self._get_hc_projection_weights(hidden_states)
+        if down_weight is None or up_weight is None:
+            return None
+        weight = self.hc_norm.weight
+        if (
+            weight.shape != (10240,)
+            or weight.dtype != hidden_states.dtype
+            or weight.device != hidden_states.device
+            or not weight.is_contiguous()
+            or weight.data_ptr() % 4
+        ):
+            return None
+        inputs = (
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            down_weight,
+            up_weight,
+        )
+        if _HC_HOST_HOTPATH_ENABLED and _HC_FUSED_UP_GATE and _HC_BATCHED_ALIAS_CHECK:
+            workspace = self._get_hc_host_chain_workspace()
+            workspace_run = self._hc_host_chain_workspace_run
+            if workspace is not None and workspace_run is not None:
+                return workspace_run(*inputs, self.config.rms_norm_eps)
+
+        operation = _get_hc_host_chain_operation()
+        if operation is None:
+            return None
+        stream = torch.xpu.current_stream(device=hidden_states.device)
+        key = (hidden_states.device, stream)
+        if _HC_HOST_HOTPATH_ENABLED and key == self._hc_host_chain_last_buffer_key:
+            buffers = self._hc_host_chain_last_buffers
+        else:
+            buffers = self._hc_host_chain_buffers.get(key)
+        if buffers is None or _hc_outputs_alias_inputs(buffers[:5], inputs):
+            buffers = tuple(
+                torch.empty(
+                    (1, width), dtype=hidden_states.dtype, device=hidden_states.device
+                )
+                for width in (10240, 10240, 336, 10240, 2560)
+            )
+            buffers = (*buffers, buffers[2][:, 320:324])
+            self._hc_host_chain_buffers[key] = buffers
+        if _HC_HOST_HOTPATH_ENABLED:
+            self._hc_host_chain_last_buffer_key = key
+            self._hc_host_chain_last_buffers = buffers
+        # The C++ entry validates the whole transaction before its first submit.
+        # The v2 chain fuses up+gate/mix; v1 keeps four kernels on this stream.
+        operation(*inputs, *buffers[:5], self.config.rms_norm_eps)
+        return buffers[0], buffers[4], buffers[5]
+
+    def _try_hc_multi_host_chain(self, hidden_states, block_output, injection):
+        if (
+            not _HC_MULTI_HOST_CHAIN_ENABLED
+            or not _HC_HOST_CHAIN_ENABLED
+            or not _HC_HOST_HOTPATH_ENABLED
+            or not _HC_FUSED_UP_GATE
+            or not _HC_BATCHED_ALIAS_CHECK
+            or NATIVE_STATS_ENABLED
+            or not self.use_combine
+            or self.hc_count != 4
+            or self.hidden_size != 2560
+            or self.lora_rank != 320
+            or self.config.rms_norm_eps != 1e-6
+            or torch.compiler.is_compiling()
+            or hidden_states.device.type != "xpu"
+            or hidden_states.dtype != torch.float16
+            or hidden_states.ndim != 2
+            or not 2 <= hidden_states.shape[0] <= 8
+            or hidden_states.shape[1] != 10240
+        ):
+            return None
+        if (
+            not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_COMBINE_NORM_NATIVE
+            or not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_PROJECTION_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_PROJECTION_NATIVE
+            or not hc_ops.envs.VLLM_XPU_ENABLE_QWEN38_HC_GATE_MIX_NATIVE
+            or hc_ops.envs.VLLM_XPU_DISABLE_QWEN38_HC_GATE_MIX_NATIVE
+        ):
+            return None
+        for stage in ("COMBINE_NORM_MULTI_M", "GATE_MIX_MULTI_M"):
+            if not getattr(
+                hc_ops.envs, f"VLLM_XPU_ENABLE_QWEN38_HC_{stage}_NATIVE", False
+            ) or getattr(
+                hc_ops.envs, f"VLLM_XPU_DISABLE_QWEN38_HC_{stage}_NATIVE", False
+            ):
+                return None
+        if (
+            _HC_MULTI_DIRECT
+            and _DIRECT_WORKSPACE
+            and _HC_NATIVE_PREFLIGHT_ENABLED
+            and type(hidden_states) is torch.Tensor
+            and type(block_output) is torch.Tensor
+            and type(injection) is torch.Tensor
+        ):
+            factory = _get_hc_multi_direct_workspace_class()
+            if factory is not None:
+                down_weight, up_weight = self._get_hc_projection_weights(
+                    hidden_states, native_preflight=True
+                )
+                weight = self.hc_norm.weight
+                if down_weight is None or up_weight is None:
+                    return None
+                if standard_direct_parameters(weight, down_weight, up_weight):
+                    direct_run = getattr(self, "_hc_multi_direct_workspace_run", None)
+                    if direct_run is None:
+                        workspace = factory()
+                        direct_run = workspace.try_run
+                        if not callable(direct_run):
+                            raise RuntimeError(
+                                "HC multi direct workspace has invalid try_run"
+                            )
+                        self._hc_multi_direct_workspace = workspace
+                        self._hc_multi_direct_workspace_run = direct_run
+                    # None is only an unsupported pre-submit transaction. All
+                    # execution/ABI errors propagate, without replaying fallback.
+                    return direct_run(
+                        hidden_states,
+                        block_output,
+                        injection,
+                        weight,
+                        down_weight,
+                        up_weight,
+                        self.config.rms_norm_eps,
+                    )
+        rows = hidden_states.shape[0]
+        for tensor, shape in (
+            (hidden_states, (rows, 10240)),
+            (block_output, (rows, 2560)),
+            (injection, (rows, 4)),
+        ):
+            if (
+                not isinstance(tensor, torch.Tensor)
+                or tensor.shape != shape
+                or tensor.dtype != torch.float16
+                or tensor.device != hidden_states.device
+                or tensor.layout != torch.strided
+                or tensor.storage_offset() % 2
+            ):
+                return None
+        if (
+            not hidden_states.is_contiguous()
+            or not block_output.is_contiguous()
+            or injection.stride(1) != 1
+            or injection.stride(0) < 4
+        ):
+            return None
+        down_weight, up_weight = self._get_hc_projection_weights(hidden_states)
+        if down_weight is None or up_weight is None:
+            return None
+        weight = self.hc_norm.weight
+        if (
+            weight.shape != (10240,)
+            or weight.dtype != hidden_states.dtype
+            or weight.device != hidden_states.device
+            or not weight.is_contiguous()
+            or weight.storage_offset() % 2
+            or down_weight.storage_offset() % 2
+            or up_weight.storage_offset() % 2
+        ):
+            return None
+        if not self._hc_multi_host_chain_workspace_checked:
+            workspace_class = _get_hc_multi_host_chain_workspace_class()
+            workspace = workspace_class() if workspace_class is not None else None
+            run = workspace.run if workspace is not None else None
+            if workspace is not None and not callable(run):
+                raise RuntimeError("HC multi-M workspace exposes a non-callable run")
+            self._hc_multi_host_chain_workspace = workspace
+            self._hc_multi_host_chain_workspace_run = run
+            self._hc_multi_host_chain_workspace_checked = True
+        run = self._hc_multi_host_chain_workspace_run
+        if run is None:
+            return None
+        # Native code validates the complete transaction and partitions scratch
+        # by stream/M. Never replay fallback after a submission/ABI error.
+        return run(
+            hidden_states,
+            block_output,
+            injection,
+            weight,
+            down_weight,
+            up_weight,
+            self.config.rms_norm_eps,
+        )
+
+    def combine(
+        self,
+        hidden_states: torch.Tensor,
+        block_output: torch.Tensor,
+        injection: torch.Tensor,
+    ) -> torch.Tensor:
+        return hc_combine(
+            hidden_states,
+            block_output,
+            injection,
+            self.hc_count,
+            output=self._get_hc_combine_output(
+                hidden_states,
+                block_output,
+                injection,
+            ),
+        )
+
+    @property
+    def hyper_hidden_size(self) -> int:
+        return self.hc_count * self.hidden_size
+
+
+__all__ = [
+    "GatedResidual",
+    "GroupedGemmaRMSNorm",
+    "HyperConnectionConfig",
+]
