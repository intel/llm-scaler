+            lease=transaction.lease,
+            epoch=transaction.epoch,
+            logical_tags=tags,
+            row_logical_tags=row_tags,
+            raw_slots=tuple(raw_slots),
+            compressed_slots=tuple(compressed_slots),
+            position_slots=tuple(position_slots),
+            raw_ring_size=raw_ring_size,
+            compressed_block_size=compressed_block_size,
