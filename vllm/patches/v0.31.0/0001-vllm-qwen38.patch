+def _get_hc_combine_norm_multi_m_strided_operation():
+    global _HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION
+    global _HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION_RESOLVED
+
+    if not _HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION_RESOLVED:
+        try:
+            operation = get_qwen38_hc_op("hc_combine_norm_multi_m_strided_v1")
+        except Qwen38HCOpUnavailableError:
+            operation = None
+        _HC_COMBINE_NORM_MULTI_M_STRIDED_OPERATION = operation
