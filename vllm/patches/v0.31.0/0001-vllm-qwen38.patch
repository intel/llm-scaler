+def _paged_key_range(
+    k_cache: torch.Tensor,
+    page_table_row: torch.Tensor,
+    start: int,
+    end: int,
+) -> torch.Tensor:
+    """Gather a bounded logical range from one request's paged key cache."""
+    logical = torch.arange(start, end, device=k_cache.device)
+    page_size = k_cache.shape[1]
+    pages = page_table_row.index_select(0, logical // page_size).long()
+    return k_cache[pages, logical % page_size, 0, :]
+
+
+def _score_paged_key_range(
+    q_row: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table_row: torch.Tensor,
+    start: int,
+    end: int,
+) -> torch.Tensor:
+    keys = _paged_key_range(k_cache, page_table_row, start, end)
+    scores = torch.einsum("hd,nd->nh", q_row.float(), keys.float())
+    return torch.relu(scores).sum(dim=-1) / math.sqrt(q_row.shape[-1])
+
+
+def _qsa_mqa_paged_logits(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    visible_lengths: torch.Tensor,
+) -> torch.Tensor:
+    columns = page_table.shape[1] * k_cache.shape[1]
+    logits = torch.full(
+        (q.shape[0], columns),
+        -torch.inf,
+        dtype=torch.float32,
+        device=q.device,
+    )
+    for row in range(q.shape[0]):
+        visible = int(visible_lengths[row].item())
+        if visible:
+            request = int(token_to_req[row].item())
+            logits[row, :visible] = _score_paged_key_range(
+                q[row],
+                k_cache,
+                page_table[request],
+                0,
+                visible,
+            )
+    return logits
+
+
+def _streaming_paged_topk(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    visible_lengths: torch.Tensor,
+    topk: int,
+) -> torch.Tensor:
+    """Select top-k paged keys while bounding temporary XPU allocations."""
+    output = torch.full(
+        (q.shape[0], topk),
+        -1,
+        dtype=torch.int32,
+        device=q.device,
+    )
+    bytes_per_key = (
+        k_cache.shape[-1] * (k_cache.element_size() + torch.float32.itemsize)
+        + q.shape[1] * torch.float32.itemsize
+    )
+    columns_per_chunk = max(1, _LOGITS_WORKSPACE_BYTES // bytes_per_key)
+
+    for row in range(q.shape[0]):
+        visible = int(visible_lengths[row].item())
+        width = min(visible, topk)
+        if not width:
+            continue
+        request = int(token_to_req[row].item())
+        best_scores = torch.empty(0, dtype=torch.float32, device=q.device)
+        best_indices = torch.empty(0, dtype=torch.int64, device=q.device)
+        for start in range(0, visible, columns_per_chunk):
+            end = min(start + columns_per_chunk, visible)
+            scores = _score_paged_key_range(
+                q[row],
+                k_cache,
+                page_table[request],
+                start,
+                end,
+            )
+            indices = torch.arange(start, end, device=q.device)
+            candidate_scores = torch.cat((best_scores, scores))
+            candidate_indices = torch.cat((best_indices, indices))
+            keep = min(width, candidate_scores.numel())
+            best_scores, selected = torch.topk(candidate_scores, keep)
+            best_indices = candidate_indices.index_select(0, selected)
+        output[row, :width] = best_indices.to(torch.int32)
+    return output
+
+
+def qsa_mqa_paged(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    compress_ratio: int,
+    num_columns: int | None = None,
+    score_scale: float | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Score compressed key blocks with ReLU-summed MQA logits."""
+    del num_columns, score_scale
+    row_sequence_lengths = sequence_lengths.index_select(0, token_to_req.long())
+    visible_blocks = torch.minimum(
+        (query_positions + 1) // compress_ratio,
+        row_sequence_lengths // compress_ratio,
+    ).to(torch.int32)
+    logits = _qsa_mqa_paged_logits(q, k_cache, page_table, token_to_req, visible_blocks)
+    return logits, visible_blocks
+
+
+def _relative_topk(
+    logits: torch.Tensor,
+    row_starts: torch.Tensor,
+    row_ends: torch.Tensor,
+    topk: int,
+) -> torch.Tensor:
+    output = torch.full(
+        (logits.shape[0], topk), -1, dtype=torch.int32, device=logits.device
+    )
+    for row in range(logits.shape[0]):
+        start = int(row_starts[row].item())
+        length = int((row_ends[row] - row_starts[row]).item())
+        width = min(length, topk)
+        if width:
+            output[row, :width] = torch.topk(
+                logits[row, start : start + length], width
+            ).indices.to(torch.int32)
+    return output
+
+
+def expand_qsa_block_indices_cuda(
+    block_indices: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    token_to_req: torch.Tensor,
+    compress_ratio: int,
+    token_topk: int,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Expand selected compressed blocks into request-relative token indices."""
+    rows = block_indices.shape[0]
+    block_topk = token_topk // compress_ratio
+    output_width = token_topk + compress_ratio - 1
+    row_sequence_lengths = sequence_lengths.index_select(0, token_to_req.long())
+    offsets = torch.arange(compress_ratio, device=block_indices.device)
+    blocks = block_indices.long()
+    expanded = blocks.unsqueeze(-1) * compress_ratio + offsets
+    expanded = torch.where(
+        blocks.unsqueeze(-1) >= 0, expanded, torch.full_like(expanded, -1)
+    ).reshape(rows, block_topk * compress_ratio)
+    expanded = expanded[:, :token_topk]
+    expanded = torch.where(
+        (expanded >= 0) & (expanded < row_sequence_lengths.unsqueeze(1)),
+        expanded,
+        torch.full_like(expanded, -1),
+    )
+
+    tail_offsets = torch.arange(compress_ratio - 1, device=block_indices.device)
+    visible_tokens = query_positions + 1
+    tail_start = visible_tokens // compress_ratio * compress_ratio
+    tail = tail_start.unsqueeze(1) + tail_offsets.unsqueeze(0)
+    tail_count = (visible_tokens - tail_start).unsqueeze(1)
+    tail_valid = (tail_offsets.unsqueeze(0) < tail_count) & (
+        tail < row_sequence_lengths.unsqueeze(1)
+    )
+    tail = torch.where(tail_valid, tail, torch.full_like(tail, -1))
+
+    result = torch.cat((expanded, tail), dim=1)
+    order = torch.arange(output_width, device=result.device).expand(rows, -1)
+    sort_key = torch.where(result >= 0, order, order + output_width)
+    result = result.gather(1, torch.argsort(sort_key, dim=1, stable=True)).to(
+        torch.int32
+    )
+    if out is not None:
+        out.copy_(result)
+        return out
+    return result
+
+
+def _shares_nonempty_storage(left: torch.Tensor, right: torch.Tensor) -> bool:
+    return bool(
+        left.numel()
+        and right.numel()
+        and left.untyped_storage().data_ptr() == right.untyped_storage().data_ptr()
+    )
