+
+def should_prepare_hc_combine_norm_outputs(
+    hidden_states: torch.Tensor,
+    block_output: torch.Tensor,
+    injection: torch.Tensor,
+    weight: torch.Tensor,
+    eps: float,
+    hc_count: int,
+) -> bool:
+    """Return whether a caller should prepare both fused native outputs."""
+    try:
+        if (
+            _hc_combine_norm_multi_m_input_fallback_reason(
+                hidden_states,
+                block_output,
+                injection,
+                weight,
+                eps,
+                hc_count,
+            )
+            is None
+        ):
+            return True
+        return (
+            _hc_combine_norm_input_fallback_reason(
+                hidden_states,
+                block_output,
+                injection,
+                weight,
+                eps,
+                hc_count,
+            )
+            is None
+        )
+    except Exception:
+        return False
