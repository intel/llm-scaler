+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Scoped dispatch guard for native calls with ordinary inference parameters."""
+
+from contextlib import nullcontext
+
+import torch
+from torch import nn
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+from vllm.model_executor.parameter import BasevLLMParameter, ModelWeightParameter
+
+_PARAMETERS = (BasevLLMParameter, ModelWeightParameter)
+_TENSORS = (torch.Tensor, nn.Parameter)
+_BASE_FUNCTION = getattr(
+    BasevLLMParameter.__torch_function__,
+    "__func__",
+    BasevLLMParameter.__torch_function__,
+)
+
+
+def standard_parameter(value: object) -> bool:
+    kind = type(value)
+    if kind in _TENSORS:
+        return True
+    if kind not in _PARAMETERS:
+        return False
+    function = kind.__torch_function__
+    return getattr(function, "__func__", function) is _BASE_FUNCTION
+
+
+def standard_parameter_context(*values: object):
+    if (
+        not all(standard_parameter(value) for value in values)
+        or not torch._C._is_torch_function_enabled()
+        or torch._C._is_torch_function_mode_enabled()
+    ):
+        return nullcontext()
+    return torch._C.DisableTorchFunctionSubclass()
+
+
+def standard_direct_parameters(*values: object) -> bool:
+    """Direct pybind calls cannot participate in Tensor subclass/mode dispatch."""
+    return (
+        not torch._C._is_torch_function_mode_enabled()
+        and torch._C._get_tracing_state() is None
+        and _get_current_dispatch_mode() is None
+        and all(standard_parameter(value) for value in values)
+    )
