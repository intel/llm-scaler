+        self._pending_capture = None
+
+    @staticmethod
+    def _effective_context(
+        ngram_context: torch.Tensor,
+        eos_token_id: int,
+        input_ids: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        previous_is_eos = ngram_context[:, 1:] == eos_token_id
+        context_boundary = torch.cat(
+            (previous_is_eos, torch.zeros_like(previous_is_eos)), dim=1
+        )
+        effective = torch.where(context_boundary, eos_token_id, ngram_context)
+        if input_ids is not None:
+            # The specialized ABI has no EOS argument.  Make its context
+            # equivalent to the general EOS-aware path on the device: an EOS
+            # current token starts a fresh segment, so every shifted
+            # predecessor is EOS.  This avoids a host scalar sync and keeps the
+            # fixed ABI fail-closed without crossing segment boundaries.
+            current_is_eos = input_ids.reshape(-1, 1) == eos_token_id
+            effective = torch.where(
+                current_is_eos, torch.full_like(effective, eos_token_id), effective
+            )
+        return effective
+
+    def _ids_fallback_reason(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> int | None:
+        if not self._metadata_eligible:
+            return REASON_METADATA
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if not self._decode_eligible():
+            return REASON_SCENARIO_DECODE_PROOF
+        if (
+            input_ids.shape != (1,)
+            or query_start_loc.shape != (2,)
+            or ngram_context.shape != (1, 2)
+        ):
+            return REASON_SHAPE
+        if (
+            input_ids.dtype != torch.int64
+            or query_start_loc.dtype != torch.int64
+            or ngram_context.dtype != torch.int64
+        ):
+            return REASON_DTYPE
+        if (
+            input_ids.device.type != "xpu"
+            or query_start_loc.device != input_ids.device
+            or ngram_context.device != input_ids.device
+        ):
+            return REASON_DEVICE
+        if (
+            not input_ids.is_contiguous()
+            or not query_start_loc.is_contiguous()
+            or not ngram_context.is_contiguous()
+        ):
+            return REASON_LAYOUT
+
+        output = owner._esimd_ngram_ids_output
+        layer_multipliers = owner.layer_multipliers
+        if output.shape != (1, _QWEN38_HEADS) or layer_multipliers.shape != (3,):
+            return REASON_SHAPE
+        if output.dtype != torch.int64 or layer_multipliers.dtype != torch.int64:
+            return REASON_DTYPE
+        if (
+            output.device != input_ids.device
+            or layer_multipliers.device != input_ids.device
+        ):
+            return REASON_DEVICE
+        if not output.is_contiguous() or not layer_multipliers.is_contiguous():
+            return REASON_LAYOUT
+        return None
+
+    def try_generate_ids(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        query_start_loc: torch.Tensor,
+        ngram_context: torch.Tensor,
+    ) -> torch.Tensor | None:
+        work_units = input_ids.numel()
+        if work_units == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ZERO_WORK_SKIP, 0)
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ATTEMPT, work_units)
+        try:
+            disabled = self._ids_disabled()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if disabled:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_DISABLED,
+                )
+            return None
+
+        try:
+            self._ensure_metadata(owner)
+            capture_active = self._capture_active()
+            if capture_active:
+                self._pending_capture = None
+            reason = self._ids_fallback_reason(
+                owner,
+                input_ids,
+                query_start_loc,
+                ngram_context,
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if reason is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    reason,
+                )
+            return None
+        try:
+            op = self._get_ids_op()
+            eos_op = self._get_ids_eos_op() if op is not None else None
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_NGRAM_IDS, EVENT_ELIGIBLE, work_units)
+        if op is None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_OP_UNAVAILABLE,
+                )
+            return None
+        output = owner._esimd_ngram_ids_output
+
+        try:
+            # 正常快路完全由一个 SYCL kernel 处理 EOS；仅调试 capture 保存参考值。
+            effective_context = (
+                self._effective_context(ngram_context, owner.eos_token_id, input_ids)
+                if eos_op is None or capture_active
+                else ngram_context
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_IDS,
+                EVENT_NATIVE_SUBMITTED,
+                work_units,
+            )
+        try:
+            if eos_op is not None:
+                eos_op(
+                    input_ids,
+                    ngram_context,
+                    owner.layer_multipliers,
+                    output,
+                    owner.eos_token_id,
+                )
+            else:
+                op(input_ids, effective_context, owner.layer_multipliers, output)
+            if capture_active:
+                self._capture_ids(
+                    owner,
+                    input_ids,
+                    ngram_context,
+                    effective_context,
+                    output,
+                )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_IDS,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    work_units,
+                )
+            raise
+        return output
+
+    @staticmethod
+    def _embedding_eligible(
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> bool:
+        embedding = owner.ngram_embedding
+        weight = getattr(embedding, "weight", None)
+        return (
+            ngram_ids.shape == (1, _QWEN38_HEADS)
+            and ngram_ids.dtype == torch.int64
+            and ngram_ids.device.type == "xpu"
+            and ngram_ids.is_contiguous()
+            and type(embedding.quant_method) is UnquantizedEmbeddingMethod
+            and isinstance(weight, torch.Tensor)
+            and weight.shape == (_QWEN38_LOCAL_ROWS, _QWEN38_HEAD_DIM)
+            and weight.dtype == torch.float16
+            and weight.device == ngram_ids.device
+            and weight.is_contiguous()
+            and weight.shape[0] == embedding.num_embeddings_per_partition
+        )
+
+    def _embedding_fallback_reason(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> int | None:
+        if not self._metadata_eligible:
+            return REASON_METADATA
+        if torch.compiler.is_compiling():
+            return REASON_COMPILE_GRAPH
+        if not self._decode_eligible():
+            return REASON_SCENARIO_DECODE_PROOF
+        if self._embedding_eligible(owner, ngram_ids):
+            return None
+
+        embedding = owner.ngram_embedding
+        weight = getattr(embedding, "weight", None)
+        if ngram_ids.shape != (1, _QWEN38_HEADS):
+            return REASON_SHAPE
+        if ngram_ids.dtype != torch.int64:
+            return REASON_DTYPE
+        if ngram_ids.device.type != "xpu":
+            return REASON_DEVICE
+        if not ngram_ids.is_contiguous():
+            return REASON_LAYOUT
+        if not isinstance(weight, torch.Tensor):
+            return REASON_OTHER_CONTRACT
+        if weight.shape != (_QWEN38_LOCAL_ROWS, _QWEN38_HEAD_DIM):
+            return REASON_SHAPE
+        if weight.dtype != torch.float16:
+            return REASON_DTYPE
+        if weight.device != ngram_ids.device:
+            return REASON_DEVICE
+        if not weight.is_contiguous():
+            return REASON_LAYOUT
+        return REASON_OTHER_CONTRACT
+
+    @staticmethod
+    def _embedding_workspace_fallback_reason(
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> int | None:
+        local_vocab_start = owner._esimd_local_vocab_start
+        local_num_rows = owner._esimd_local_num_rows
+        local_partial = owner._esimd_local_partial
+        if (
+            local_vocab_start.shape != (1,)
+            or local_num_rows.shape != (1,)
+            or local_partial.shape != (1, _QWEN38_EMBED_DIM)
+        ):
+            return REASON_SHAPE
+        if (
+            local_vocab_start.dtype != torch.int64
+            or local_num_rows.dtype != torch.int64
+            or local_partial.dtype != torch.float16
+        ):
+            return REASON_DTYPE
+        if (
+            local_vocab_start.device != ngram_ids.device
+            or local_num_rows.device != ngram_ids.device
+            or local_partial.device != ngram_ids.device
+        ):
+            return REASON_DEVICE
+        if (
+            not local_vocab_start.is_contiguous()
+            or not local_num_rows.is_contiguous()
+            or not local_partial.is_contiguous()
+        ):
+            return REASON_LAYOUT
+        return None
+
+    def try_embedding(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+    ) -> torch.Tensor | None:
+        work_units = ngram_ids.numel()
+        if work_units == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                    EVENT_ZERO_WORK_SKIP,
+                    0,
+                )
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_ATTEMPT,
+                work_units,
+            )
+        try:
+            disabled = self._embedding_disabled()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if disabled:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_DISABLED,
+                )
+            return None
+
+        try:
+            self._ensure_metadata(owner)
+            capture_active = self._capture_active()
+            reason = self._embedding_fallback_reason(owner, ngram_ids)
+            if reason is None:
+                if capture_active and self._pending_capture is None:
+                    raise RuntimeError(
+                        "Qwen3.8 N-gram capture requires a native ID result"
+                    )
+                embedding = owner.ngram_embedding
+                weight = embedding.weight
+                local_vocab_start = owner._esimd_local_vocab_start
+                local_num_rows = owner._esimd_local_num_rows
+                local_partial = owner._esimd_local_partial
+                reason = self._embedding_workspace_fallback_reason(owner, ngram_ids)
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if reason is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    reason,
+                )
+            return None
+
+        try:
+            op = self._get_embedding_op()
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_ELIGIBLE,
+                work_units,
+            )
+        if op is None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_FALLBACK,
+                    work_units,
+                    REASON_OP_UNAVAILABLE,
+                )
+            return None
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_LOCAL,
+                EVENT_NATIVE_SUBMITTED,
+                work_units,
+            )
+        try:
+            op(
+                ngram_ids,
+                weight,
+                local_vocab_start,
+                local_num_rows,
+                local_partial,
+            )
+            local_partial_heads = local_partial.view(1, _QWEN38_HEADS, _QWEN38_HEAD_DIM)
+            local_capture = (
+                self._capture_local_partial(owner, ngram_ids, local_partial_heads)
+                if capture_active
+                else None
+            )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_LOCAL,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    work_units,
+                )
+            raise
+
+        reduce_work_units = local_partial_heads.shape[0]
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_ATTEMPT,
+                reduce_work_units,
+            )
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_ELIGIBLE,
+                reduce_work_units,
+            )
+            NATIVE_STATS.record(
+                PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                EVENT_NATIVE_SUBMITTED,
+                reduce_work_units,
+            )
+        try:
+            reduced = self._all_reduce(local_partial_heads)
+            flattened = reduced.flatten(-2)
+            if local_capture is not None:
+                self._write_capture(
+                    owner,
+                    ngram_ids,
+                    local_capture,
+                    reduced,
+                    flattened,
+                )
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_NGRAM_EMBEDDING_TP_REDUCE,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    reduce_work_units,
+                )
+            raise
+        return flattened
+
+
+__all__ = ["Qwen38NGramEsimdAdapter"]
