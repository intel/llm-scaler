+    @staticmethod
+    def _cpu_clone(tensor: torch.Tensor) -> torch.Tensor:
+        return tensor.detach().to(device="cpu").clone()
+
+    @staticmethod
+    def _tensor_sha256(tensor: torch.Tensor) -> str:
+        tensor = tensor.detach().to(device="cpu").contiguous()
+        digest = hashlib.sha256()
+        digest.update(str(tensor.dtype).encode())
+        digest.update(repr(tuple(tensor.shape)).encode())
+        digest.update(tensor.view(torch.uint8).numpy().tobytes())
+        return digest.hexdigest()
+
+    @staticmethod
+    def _current_stream_metadata(device: torch.device) -> dict[str, Any]:
+        metadata: dict[str, Any] = {"device_type": device.type}
+        if device.type == "xpu":
+            stream = torch.xpu.current_stream(device)
+            metadata.update(
+                {
+                    "device": str(stream.device),
+                    "stream_id": getattr(stream, "stream_id", None),
+                    "repr": repr(stream),
+                }
+            )
+        return metadata
+
+    def _capture_ids(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        input_ids: torch.Tensor,
+        ngram_context: torch.Tensor,
+        effective_context: torch.Tensor,
+        output: torch.Tensor,
+    ) -> None:
+        current = input_ids[0]
+        previous_2 = effective_context[0, 0]
+        previous = effective_context[0, 1]
+        bigram = (current * owner.layer_multipliers[0]) ^ (
+            previous * owner.layer_multipliers[1]
+        )
+        trigram = bigram ^ (previous_2 * owner.layer_multipliers[2])
+        mixed = torch.cat((bigram.expand(8), trigram.expand(8)))
+        reference = (
+            torch.remainder(mixed, owner.ngram_heads_vocab_sizes)
+            + owner.ngram_heads_offsets
+        ).view(1, _QWEN38_HEADS)
+        ids_parity_ok = torch.equal(output, reference)
+        ids_domain_ok = bool(
+            ((output >= 0) & (output < _QWEN38_GENERATED_VOCAB_SIZE)).all()
+        )
+        self._pending_capture = {
+            "ids_parity_ok": ids_parity_ok,
+            "ids_domain_ok": ids_domain_ok,
+            "input_ids": self._cpu_clone(input_ids),
+            "ngram_context": self._cpu_clone(ngram_context),
+            "effective_context": self._cpu_clone(effective_context),
+            "ngram_ids": self._cpu_clone(output),
+            "ngram_ids_reference": self._cpu_clone(reference),
+        }
+
+    def _capture_local_partial(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+        local_partial_heads: torch.Tensor,
+    ) -> dict[str, Any]:
+        weight = owner.ngram_embedding.weight
+        local_start = owner._esimd_local_vocab_start[0]
+        local_num_rows = owner._esimd_local_num_rows[0]
+        valid = (ngram_ids >= local_start) & (ngram_ids < local_start + local_num_rows)
+        local_ids = torch.where(
+            valid,
+            ngram_ids - local_start,
+            torch.zeros_like(ngram_ids),
+        )
+        gathered = F.embedding(local_ids, weight)
+        reference = torch.where(
+            valid.unsqueeze(-1), gathered, torch.zeros_like(gathered)
+        )
+        local_parity_ok = torch.equal(local_partial_heads, reference)
+        valid_heads = torch.nonzero(valid[0], as_tuple=False).flatten()
+        selected_global_ids = ngram_ids[0].index_select(0, valid_heads)
+        selected_local_ids = local_ids[0].index_select(0, valid_heads)
+        selected_weight_rows = weight.index_select(0, selected_local_ids)
+        return {
+            "local_parity_ok": local_parity_ok,
+            "valid_heads": self._cpu_clone(valid_heads),
+            "selected_global_ids": self._cpu_clone(selected_global_ids),
+            "selected_local_ids": self._cpu_clone(selected_local_ids),
+            "selected_weight_rows": self._cpu_clone(selected_weight_rows),
+            "local_partial": self._cpu_clone(local_partial_heads),
+            "local_partial_reference": self._cpu_clone(reference),
+            "local_vocab_start": self._cpu_clone(owner._esimd_local_vocab_start),
+            "local_num_rows": self._cpu_clone(owner._esimd_local_num_rows),
+        }
+
+    def _write_capture(
+        self,
+        owner: "Qwen3_8FlashNextNGramEmbedding",
+        ngram_ids: torch.Tensor,
+        local_capture: dict[str, Any],
+        reduced: torch.Tensor,
