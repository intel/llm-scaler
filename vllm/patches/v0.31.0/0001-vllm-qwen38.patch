+def _qsa_native_selection_candidate(
+    q: torch.Tensor,
+    token_topk: int,
+    compress_ratio: int,
+) -> bool:
+    return bool(
+        q.device.type == "xpu"
+        and q.dtype == torch.float16
+        and q.ndim == 3
+        and tuple(q.shape[1:]) == (4, 128)
+        and token_topk == 2048
+        and compress_ratio == 4
