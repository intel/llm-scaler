+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPU-side provenance for Qwen3.8 QSA historical circular-cache rows.
+
+This module deliberately contains no tensor or device operations.  A capability
+is issued only from the scheduler-owned ledger after the corresponding rows
+have been acknowledged as committed.  Block IDs alone are never sufficient:
+allocation generation and request incarnation prevent ABA reuse.
+"""
+
+import hashlib
+import json
+from collections.abc import Iterable
+from dataclasses import dataclass
+from enum import Enum
+
+QSA_HISTORICAL_RING_CAPABILITY_VERSION = 1
+QSA_ROW_STORE_RECEIPT_ABI_VERSION = 4
+
+
+class QSASlotState(str, Enum):
+    INVALID = "invalid"
+    PENDING = "pending"
+    COMMITTED = "committed"
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingLease:
+    """Identity of one request-owned physical circular-cache block."""
+
+    ring_group_id: int
+    block_id: int
+    allocation_generation: int
+    owner_incarnation: int
+
+    def __post_init__(self) -> None:
+        if self.ring_group_id < 0:
+            raise ValueError("ring_group_id must be non-negative")
+        if self.block_id < 0:
+            raise ValueError("block_id must be non-negative")
+        if self.allocation_generation <= 0:
+            raise ValueError("allocation_generation must be positive")
+        if self.owner_incarnation <= 0:
+            raise ValueError("owner_incarnation must be positive")
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingCapability:
+    """Sealed proof for committed or stream-ordered ring positions."""
+
+    lease: QSAHistoricalRingLease
+    epoch: int
+    slot_tags: tuple[tuple[int, int], ...]
+    version: int = QSA_HISTORICAL_RING_CAPABILITY_VERSION
+    sealed: bool = True
+    # The producer includes the ring size so consumers can validate the
+    # physical slot mapping without relying on an untyped side channel.
+    ring_size: int | None = None
+    # Async batch-queue transports may include rows from an earlier pending
+    # frame. Those rows are safe only because the worker submits every frame
+    # on one ordered stream; the flag keeps that provenance explicit.
+    stream_ordered: bool = False
+
+    def __post_init__(self) -> None:
+        if self.version != QSA_HISTORICAL_RING_CAPABILITY_VERSION:
+            raise ValueError("unsupported QSA historical-ring capability version")
+        if type(self.stream_ordered) is not bool:
+            raise ValueError("stream-ordered capability marker must be boolean")
+        if self.epoch < 0:
+            raise ValueError("capability epoch must be non-negative")
+        if self.ring_size is not None and self.ring_size <= 0:
+            raise ValueError("capability ring size must be positive")
+        if not self.sealed:
+            raise ValueError("QSA historical-ring capabilities must be sealed")
+        previous_slot = -1
+        seen_tags: set[int] = set()
+        for slot, logical_tag in self.slot_tags:
+            if slot < 0:
+                raise ValueError("capability slot must be non-negative")
+            if logical_tag < 0:
+                raise ValueError("capability logical tag must be non-negative")
+            if slot <= previous_slot:
+                raise ValueError("capability slots must be strictly ordered")
+            if logical_tag in seen_tags:
+                raise ValueError("capability logical tags must be unique")
+            if self.ring_size is not None and slot != logical_tag % self.ring_size:
+                raise ValueError("capability slot does not match ring mapping")
+            previous_slot = slot
+            seen_tags.add(logical_tag)
+
+    @property
+    def logical_tags(self) -> tuple[int, ...]:
+        return tuple(tag for _, tag in self.slot_tags)
+
+    def proves(self, logical_tag: int) -> bool:
+        return logical_tag in self.logical_tags
+
+    def prefix(self, count: int) -> "QSAHistoricalRingCapability":
+        """Return a capability containing only its first ``count`` rows."""
+        if count < 0 or count > len(self.slot_tags):
+            raise ValueError("capability prefix is outside the sealed range")
+        return QSAHistoricalRingCapability(
+            lease=self.lease,
+            epoch=self.epoch,
+            slot_tags=self.slot_tags[:count],
+            ring_size=self.ring_size,
+            version=self.version,
+            stream_ordered=self.stream_ordered,
+        )
+
+
+@dataclass(slots=True)
+class _SlotRecord:
+    logical_tag: int
+    state: QSASlotState
+    epoch: int
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingPendingTransaction:
+    """Transport record for one scheduler-to-worker ring write."""
+
+    request_id: str
+    lease: QSAHistoricalRingLease
+    epoch: int
+    logical_tags: tuple[int, ...]
+    # Request-local causal generation.  It changes only after a predecessor
+    # frame is rejected or invalidated, fencing optimistic async successors.
+    causal_generation: int = 0
+    # New scheduler transports require a formula-checked write manifest.
+    # The default keeps hand-built legacy test transactions readable while all
+    # production scheduler transactions set this explicitly.
+    write_manifest_required: bool = False
+
+    def __post_init__(self) -> None:
+        if not self.request_id:
+            raise ValueError("request_id must not be empty")
+        if self.epoch < 0:
+            raise ValueError("transaction epoch must be non-negative")
+        if self.causal_generation < 0:
+            raise ValueError("causal generation must be non-negative")
+        if not isinstance(self.write_manifest_required, bool):
+            raise ValueError("write manifest requirement must be boolean")
+        if not self.logical_tags:
+            raise ValueError("a pending transaction must contain at least one tag")
+        if len(set(self.logical_tags)) != len(self.logical_tags):
+            raise ValueError("pending transaction tags must be unique")
+        if any(tag < 0 for tag in self.logical_tags):
+            raise ValueError("pending transaction tags must be non-negative")
+
+
+@dataclass(frozen=True, slots=True)
+class QSAHistoricalRingWriteManifest:
+    """Formula-level proof for one QSA cache-row write transaction.
+
+    The manifest is built from the scheduler transaction and the worker's
+    CPU logical-position witness before any cache store is submitted.  The
+    three slot vectors retain the physical row shape, including ``-1`` for
+    rows that are not part of the circular tail.
+    """
+
+    request_id: str
+    lease: QSAHistoricalRingLease
+    epoch: int
+    logical_tags: tuple[int, ...]
+    row_logical_tags: tuple[int, ...]
+    raw_slots: tuple[int, ...]
+    compressed_slots: tuple[int, ...]
+    position_slots: tuple[int, ...]
+    raw_ring_size: int
+    compressed_block_size: int
+    compress_ratio: int
+    causal_generation: int = 0
+    version: int = QSA_HISTORICAL_RING_CAPABILITY_VERSION
+    # Physical block witnesses are supplied by the worker's CPU cache-group
+    # descriptor. ``None`` retains the legacy single-block formula for
+    # hand-built compatibility fixtures; production manifests always carry
+    # both vectors explicitly.
+    raw_block_ids: tuple[int, ...] | None = None
+    compressed_block_ids: tuple[int, ...] | None = None
+
+    def __post_init__(self) -> None:
+        if self.version != QSA_HISTORICAL_RING_CAPABILITY_VERSION:
+            raise ValueError("unsupported QSA write manifest version")
+        if not self.request_id:
+            raise ValueError("manifest request_id must not be empty")
+        if self.epoch < 0 or self.causal_generation < 0:
+            raise ValueError("manifest epoch and generation must be non-negative")
+        if self.raw_ring_size <= 0 or self.compressed_block_size <= 0:
+            raise ValueError("manifest cache page sizes must be positive")
+        if self.compress_ratio <= 0:
+            raise ValueError("manifest compression ratio must be positive")
+        tags = tuple(self.logical_tags)
+        if not tags or tuple(sorted(tags)) != tags:
+            raise ValueError("manifest logical tags must be strictly ordered")
+        if len(set(tags)) != len(tags) or any(tag < 0 for tag in tags):
+            raise ValueError("manifest logical tags must be unique and non-negative")
+        if len(self.row_logical_tags) != len(self.raw_slots):
+            raise ValueError("manifest raw rows and slots must have equal length")
+        if len(self.raw_slots) != len(self.compressed_slots):
+            raise ValueError("manifest cache slot vectors must have equal length")
+        if len(self.raw_slots) != len(self.position_slots):
+            raise ValueError("manifest position slots must match raw slots")
+        row_tags = tuple(self.row_logical_tags)
+        raw_block_ids = (
+            tuple(
+                self.lease.block_id if slot >= 0 else -1
+                for slot in self.raw_slots
+            )
+            if self.raw_block_ids is None
+            else tuple(self.raw_block_ids)
+        )
+        compressed_block_ids = (
+            tuple(
+                self.lease.block_id if slot >= 0 else -1
+                for slot in self.compressed_slots
+            )
+            if self.compressed_block_ids is None
+            else tuple(self.compressed_block_ids)
+        )
+        if len(raw_block_ids) != len(row_tags):
+            raise ValueError("manifest raw block witness length mismatch")
+        if len(compressed_block_ids) != len(row_tags):
+            raise ValueError("manifest compressed block witness length mismatch")
+        tag_set = set(tags)
+        valid_raw_tags: list[int] = []
+        valid_compressed_tags: list[int] = []
+        expected_compressed_tags = tuple(
+            row_tag
+            for row_tag in row_tags
+            if row_tag >= 0 and (row_tag + 1) % self.compress_ratio == 0
+        )
+        previous_tag = -1
+        for (
+            row_tag,
+            raw_slot,
+            compressed_slot,
+            position_slot,
+            raw_block_id,
+            compressed_block_id,
+        ) in zip(
+            row_tags,
+            self.raw_slots,
+            self.compressed_slots,
+            self.position_slots,
+            raw_block_ids,
+            compressed_block_ids,
+            strict=True,
+        ):
+            if row_tag < -1:
+                raise ValueError("manifest row logical tag must be >= -1")
+            if row_tag >= 0 and row_tag <= previous_tag:
+                raise ValueError("manifest row logical tags must be ordered")
+            if row_tag >= 0:
+                previous_tag = row_tag
+            expected_raw = -1
+            expected_compressed = -1
+            if row_tag in tag_set:
+                if raw_block_id < 0:
+                    raise ValueError("manifest raw block witness is missing")
+                expected_raw = (
+                    raw_block_id * self.raw_ring_size
+                    + row_tag % self.raw_ring_size
+                )
+                valid_raw_tags.append(row_tag)
+            elif raw_block_id != -1:
+                raise ValueError("manifest has an out-of-tail raw block witness")
+            if row_tag >= 0 and (row_tag + 1) % self.compress_ratio == 0:
+                if compressed_block_id < 0:
+                    raise ValueError(
+                        "manifest compressed block witness is missing"
+                    )
+                expected_compressed = (
+                    compressed_block_id * self.compressed_block_size
+                    + (row_tag // self.compress_ratio)
+                    % self.compressed_block_size
+                )
+                valid_compressed_tags.append(row_tag)
+            elif compressed_block_id != -1:
+                raise ValueError(
+                    "manifest has a non-boundary compressed block witness"
+                )
+            if raw_slot != expected_raw:
+                raise ValueError("manifest raw slot does not match logical mapping")
+            if compressed_slot != expected_compressed:
+                raise ValueError(
+                    "manifest compressed slot does not match logical mapping"
+                )
+            if position_slot != expected_raw:
+                raise ValueError("manifest position slot does not match raw mapping")
+        if tuple(valid_raw_tags) != tags:
+            raise ValueError("manifest rows do not cover transaction logical tags")
+        if len(
+            {slot for slot in self.raw_slots if slot >= 0}
+        ) != len(valid_raw_tags):
+            raise ValueError("manifest raw slots must be unique")
+        valid_compressed_slots = [
+            slot for slot in self.compressed_slots if slot >= 0
+        ]
+        if len(set(valid_compressed_slots)) != len(valid_compressed_slots):
+            raise ValueError("manifest compressed slots must be unique")
+        if expected_compressed_tags != tuple(valid_compressed_tags):
+            raise ValueError("manifest compressed boundary rows are inconsistent")
+
+    @classmethod
+    def from_transaction(
+        cls,
+        transaction: "QSAHistoricalRingPendingTransaction",
+        row_logical_tags: tuple[int, ...] | list[int],
+        *,
+        raw_ring_size: int,
+        compressed_block_size: int,
+        compress_ratio: int,
+        raw_block_ids: tuple[int, ...] | None = None,
+        compressed_block_ids: tuple[int, ...] | None = None,
+    ) -> "QSAHistoricalRingWriteManifest":
+        tags = tuple(transaction.logical_tags)
