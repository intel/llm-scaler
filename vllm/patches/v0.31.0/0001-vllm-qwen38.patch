+    @staticmethod
+    def _collect_qsa_ring_write_receipts(
+        attn_metadata: PerLayerAttnMetadata,
+    ) -> tuple[QSAHistoricalRingWriteAcknowledgement, ...]:
+        """Collect receipts emitted by completed QSA row-store callers."""
+        values: Iterable[Any]
+        if isinstance(attn_metadata, dict):
+            values = attn_metadata.values()
+        else:
+            values = (
+                metadata
+                for metadata_by_layer in attn_metadata
+                for metadata in metadata_by_layer.values()
+            )
+        receipts: dict[
+            tuple[
+                str,
+                QSAHistoricalRingLease,
+                int,
+                tuple[int, ...],
+                int,
+            ],
+            QSAHistoricalRingWriteAcknowledgement,
+        ] = {}
+        seen_metadata: set[int] = set()
+        for metadata in values:
+            if id(metadata) in seen_metadata:
+                continue
+            seen_metadata.add(id(metadata))
+            receipts_to_check = list(
+                getattr(metadata, "qsa_ring_write_acknowledgements", ())
+            )
+            singular_receipt = getattr(metadata, "qsa_ring_write_acknowledgement", None)
+            if singular_receipt is not None and not any(
+                singular_receipt is receipt for receipt in receipts_to_check
+            ):
+                receipts_to_check.append(singular_receipt)
+            for receipt in receipts_to_check:
+                if type(receipt) is not QSAHistoricalRingWriteAcknowledgement:
+                    continue
+                manifest = receipt.manifest
+                if manifest is not None and (
+                    receipt.receipt_abi_version != QSA_ROW_STORE_RECEIPT_ABI_VERSION
+                    or receipt.manifest_digest != manifest.digest
+                ):
+                    continue
+                key = (
+                    receipt.request_id,
+                    receipt.lease,
+                    receipt.epoch,
+                    receipt.logical_tags,
+                    receipt.causal_generation,
+                )
+                previous = receipts.get(key)
+                if previous is not None and previous != receipt:
+                    # Two layers may share metadata, but conflicting manifests
+                    # must never be resolved by dictionary insertion order.
+                    return ()
+                receipts[key] = receipt
+        return tuple(receipts.values())
+
+    def _finalize_qsa_ring_write_receipts(
+        self, attn_metadata: PerLayerAttnMetadata
+    ) -> None:
+        # Only CPU provenance transactions consume layer receipts. Ordinary
+        # models (and QSA device-ledger MTP) must not scan every layer each step.
+        # A PP stage without local writes still forwards receipts from upstream.
+        local_receipts = (
+            self._collect_qsa_ring_write_receipts(attn_metadata)
+            if self._qsa_ring_pending
+            else ()
+        )
+        self._qsa_ring_write_receipts = merge_qsa_ring_write_acknowledgements(
+            self._qsa_ring_inbound_receipts, local_receipts
+        )
+
+    def _make_qsa_ring_write_acknowledgements(
+        self,
+    ) -> tuple[QSAHistoricalRingWriteAcknowledgement, ...]:
+        if not self._qsa_ring_transport_validated or not self._qsa_ring_pending:
+            return ()
+        receipts = {
+            (
+                receipt.request_id,
+                receipt.lease,
+                receipt.epoch,
+                receipt.logical_tags,
+                receipt.causal_generation,
+            ): receipt
+            for receipt in getattr(self, "_qsa_ring_write_receipts", ())
+        }
+        acknowledgements = []
+        for transaction in self._qsa_ring_pending:
+            key = (
+                transaction.request_id,
+                transaction.lease,
+                transaction.epoch,
+                transaction.logical_tags,
+                transaction.causal_generation,
+            )
+            receipt = receipts.get(key)
+            if receipt is None:
+                return ()
+            if transaction.write_manifest_required:
+                manifest = getattr(receipt, "manifest", None)
+                if (
+                    type(manifest) is not QSAHistoricalRingWriteManifest
+                    or receipt.receipt_abi_version != QSA_ROW_STORE_RECEIPT_ABI_VERSION
+                    or receipt.manifest_digest != manifest.digest
+                ):
+                    return ()
+            acknowledgements.append(receipt)
+        return tuple(acknowledgements)
