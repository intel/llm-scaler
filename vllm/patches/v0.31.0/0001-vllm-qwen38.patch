+    """Record a queue-local start event when debug timing is explicitly enabled."""
+    if enabled is None:
+        enabled = _QSA_TIMING_ENABLED
+    if not enabled:
+        return None
+    try:
+        stream = torch.xpu.current_stream()
+        start = torch.xpu.Event(enable_timing=True)
+        start.record(stream)
+        return label, stream, start
+    except Exception:
+        # Timing must never alter the QSA execution path.
+        return None
+
+
+def _qsa_timing_end(record: tuple[str, object, object] | None) -> None:
+    """Record a queue-local end event without synchronizing the hot path."""
+    if record is None:
+        return
+    label, stream, start = record
+    try:
+        end = torch.xpu.Event(enable_timing=True)
+        end.record(stream)
+        _QSA_TIMING_EVENTS.append((label, start, end))
+    except Exception:
+        return
+
+
+def _qsa_timing_percentile(values: list[float], fraction: float) -> float:
+    if not values:
+        return 0.0
+    ordered = sorted(values)
+    index = min(len(ordered) - 1, int((len(ordered) - 1) * fraction))
+    return ordered[index]
+
+
+def _dump_qsa_timing_at_exit() -> None:
+    """Persist optional queue timing after all recorded work has completed."""
+    dump_dir = os.environ.get("VLLM_XPU_QWEN38_NATIVE_STATS_DUMP_DIR")
+    if (
+        not (_QSA_TIMING_ENABLED or _QSA_MODEL_TIMING_ENABLED)
+        or not dump_dir
+        or not _QSA_TIMING_EVENTS
+    ):
+        return
+    try:
+        torch.xpu.synchronize()
+        grouped: dict[str, list[float]] = {}
+        for label, start, end in _QSA_TIMING_EVENTS:
+            try:
+                grouped.setdefault(label, []).append(
+                    float(start.elapsed_time(end)) * 1000.0
+                )
+            except Exception:
+                continue
+        output = {}
+        for label, values in grouped.items():
+            output[label] = {
+                "calls": len(values),
+                "total_us": sum(values),
+                "mean_us": statistics.fmean(values),
+                "p50_us": _qsa_timing_percentile(values, 0.50),
+                "p95_us": _qsa_timing_percentile(values, 0.95),
+                "max_us": max(values),
+            }
+        output_dir = Path(dump_dir)
+        output_dir.mkdir(parents=True, exist_ok=True)
+        rank = os.environ.get("RANK", os.environ.get("LOCAL_RANK", "unknown"))
+        path = output_dir / f"qsa_timing_rank_{rank}_pid_{os.getpid()}.json"
+        path.write_text(
+            json.dumps(
+                {
+                    "schema": "vllm.xpu.qwen38.qsa_queue_timing.v1",
+                    "scope": "rank_local",
+                    "timing": output,
+                },
+                sort_keys=True,
+            )
+            + "\n"
+        )
+    except Exception:
+        # Diagnostics must never change worker shutdown behavior.
+        return
