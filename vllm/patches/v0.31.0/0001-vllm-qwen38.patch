diff --git a/vllm/models/qwen4_exp/xpu/collectives.py b/vllm/models/qwen4_exp/xpu/collectives.py
new file mode 100644
index 0000000..22b9c5b
--- /dev/null
+++ b/vllm/models/qwen4_exp/xpu/collectives.py
@@ -0,0 +1,96 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""模型局部 FULL decode 路径中已证明 last-use 的通信操作。"""
+
+from collections.abc import Callable
+
+import torch
+from torch.utils._python_dispatch import _get_current_dispatch_mode
+
+from vllm import envs
+from vllm.distributed import get_tp_group, tensor_model_parallel_all_reduce
+from vllm.distributed.device_communicators.xpu_communicator import XpuCommunicator
+from vllm.utils.torch_utils import direct_register_custom_op
+
+from .full_decode import active_full_decode_state
+
+
+def _full_decode_all_reduce_(tensor: torch.Tensor) -> None:
+    communicator = get_tp_group().device_communicator
+    if not isinstance(communicator, XpuCommunicator):
+        raise RuntimeError("FULL decode all-reduce requires an XPU communicator")
+    # 异常可能发生在通信提交之后，不能重试或转入 fallback。
+    output = communicator._all_reduce(tensor, inplace=True)
+    if output is not tensor:
+        raise RuntimeError("FULL decode all-reduce did not mutate its input")
+
+
+def _full_decode_all_reduce_fake(tensor: torch.Tensor) -> None:
+    return None
+
+
+direct_register_custom_op(
+    op_name="qwen38_full_decode_all_reduce_",
+    op_func=_full_decode_all_reduce_,
+    mutates_args=["tensor"],
+    fake_impl=_full_decode_all_reduce_fake,
+    dispatch_key="XPU",
+)
+
+
+def full_decode_all_reduce(
+    tensor: torch.Tensor,
+    *,
+    fallback: Callable[[torch.Tensor], torch.Tensor] | None = None,
+) -> torch.Tensor:
+    """归约已证明 last-use 的中间结果，仅在 FULL decode 中原地修改。
+
+    调用方必须限定非 MTP、TP4 INT4 FP16、FULL_DECODE_ONLY，并证明该结果
+    不 alias 生产者的输入（包括 residual），且 unreduced 值没有后续消费者。
+    所有 TP rank 必须选择相同路径；capture 到 replay 期间 TP group 和
+    communicator 必须保持不变。允许借用 native workspace，但生产、归约、
+    消费及下次覆盖必须在同一 ordered stream，且复用前已证明 last-use。
+    Tensor 是否为 view 并不能证明上述所有权契约。
+
+    Args:
+        tensor: 允许覆盖 unreduced 内容的中间结果。
+        fallback: 不支持原地路径时使用的既有归约入口；默认使用标准 TP
+            all-reduce。调用方可显式传入原模块的引用，保留入口及 mock 行为。
+
+    Returns:
+        原地路径返回同一 tensor；输入或 scope 不支持时返回原 TP 归约的结果。
+
+    Raises:
+        RuntimeError: 通信提交或结果校验失败。调用方必须传播异常，不能重放
+            eager fallback。
+
+    """
+    if fallback is None:
+        fallback = tensor_model_parallel_all_reduce
+    # 非 FULL 热路径先返回，不为 eager/PIECEWISE 增加 dispatcher 状态检查。
+    if active_full_decode_state() is None:
+        return fallback(tensor)
+    if (
+        type(tensor) is not torch.Tensor
+        or torch._C._is_torch_function_mode_enabled()
+        or _get_current_dispatch_mode() is not None
+        or torch._C._get_tracing_state() is not None
+        or tensor.device.type != "xpu"
+        or tensor.dtype != torch.float16
+        or tensor.ndim != 2
+        or tensor.shape[0] != 1
+        or tensor.numel() == 0
+        or not tensor.is_contiguous()
+        or tensor.requires_grad
+        or envs.VLLM_BATCH_INVARIANT
+    ):
+        return fallback(tensor)
+
+    group = get_tp_group()
+    if group.world_size != 4 or not isinstance(
+        group.device_communicator, XpuCommunicator
+    ):
+        return fallback(tensor)
+
+    torch.ops.vllm.qwen38_full_decode_all_reduce_(tensor)
+    return tensor
diff --git a/vllm/models/qwen4_exp/xpu/defaults.py b/vllm/models/qwen4_exp/xpu/defaults.py
