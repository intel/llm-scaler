+class QSAWriteReceiptWorkspace:
+    """Reusable device and pinned-host buffers for strict row-store proofs."""
+
+    __slots__ = ("device_receipt", "host_receipts", "stream_key")
+
+    def __init__(self) -> None:
+        self.device_receipt: torch.Tensor | None = None
+        self.host_receipts: list[torch.Tensor | None] = []
+        self.stream_key: tuple[torch.device, object] | None = None
+
+    def bind_stream(self, device: torch.device) -> None:
+        """Bind the workspace to one stream before its first device submit."""
+        if device.type != "xpu":
+            return
+        stream = torch.xpu.current_stream(device=device)
+        key = (device, stream)
+        if self.stream_key is None:
+            self.stream_key = key
+        elif self.stream_key != key:
+            raise RuntimeError(
+                "QSA row-store receipt workspace cannot cross XPU streams"
+            )
+
+    def ensure_device(self, row_count: int, device: torch.device) -> torch.Tensor:
+        receipt = self.device_receipt
+        if (
+            receipt is None
+            or receipt.ndim != 2
+            or receipt.shape[1] != 2
+            or receipt.shape[0] < row_count
+            or receipt.dtype != torch.int64
+            or receipt.device != device
+        ):
+            receipt = torch.empty((row_count, 2), dtype=torch.int64, device=device)
+            self.device_receipt = receipt
+        return receipt[:row_count]
+
+    def ensure_host(self, index: int, row_count: int) -> torch.Tensor:
+        while len(self.host_receipts) <= index:
+            self.host_receipts.append(None)
+        receipt = self.host_receipts[index]
+        if (
+            receipt is None
+            or receipt.ndim != 2
+            or receipt.shape[1] != 2
+            or receipt.shape[0] < row_count
+        ):
+            receipt = torch.empty(
+                (row_count, 2),
+                dtype=torch.int64,
+                device="cpu",
+                pin_memory=PIN_MEMORY and torch.xpu.is_available(),
+            )
+            self.host_receipts[index] = receipt
+        return receipt[:row_count]
+
+
+def _validate_native_output(
+    returned: object,
+    out: torch.Tensor,
+    operation: str,
+) -> torch.Tensor:
+    if not isinstance(returned, torch.Tensor):
+        raise RuntimeError(f"Native QSA {operation} did not return a tensor")
+    if (
+        returned.shape != out.shape
+        or returned.dtype != out.dtype
+        or returned.device != out.device
+        or returned.data_ptr() != out.data_ptr()
+    ):
+        raise RuntimeError(
+            f"Native QSA {operation} did not return its caller-owned output"
+        )
+    return out
+
