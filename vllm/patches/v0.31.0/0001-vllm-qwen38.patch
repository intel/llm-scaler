+def _python_binding_signature(parameters):
+    return tuple(_tensor_storage_signature(t) for t in parameters) + (
+        using_qwen38_sycl(),
+    )
+
+
+def _live_binding_signature(parameters, current, *, use_snapshot):
+    factory = _binding_snapshot_factory() if use_snapshot else None
+    if factory is not None:
+        if isinstance(current, _NativeBindingSnapshot):
+            if current.fallback_signature is not None:
+                if current.fallback_signature == _python_binding_signature(parameters):
+                    return current
+            else:
+                matched = current.matches(parameters)
+                if type(matched) is not bool:
+                    raise RuntimeError(
+                        "TensorBindingSnapshotV1.matches must return bool"
+                    )
+                if matched:
+                    return current
+        snapshot = factory(parameters)
+        matches = getattr(snapshot, "matches", None)
+        if not callable(matches):
+            raise RuntimeError("TensorBindingSnapshotV1 has no callable matches")
+        supported = matches(parameters)
+        if type(supported) is not bool:
+            raise RuntimeError("TensorBindingSnapshotV1.matches must return bool")
+        return _NativeBindingSnapshot(
+            snapshot,
+            matches,
+            None if supported else _python_binding_signature(parameters),
+        )
+    return _python_binding_signature(parameters)
