+            "compressed_block_ids": self.compressed_block_ids,
+            "compressed_block_size": self.compressed_block_size,
+            "compressed_slots": self.compressed_slots,
+            "compress_ratio": self.compress_ratio,
+            "epoch": self.epoch,
+            "lease": {
+                "allocation_generation": self.lease.allocation_generation,
+                "block_id": self.lease.block_id,
+                "owner_incarnation": self.lease.owner_incarnation,
+                "ring_group_id": self.lease.ring_group_id,
+            },
+            "logical_tags": self.logical_tags,
+            "position_slots": self.position_slots,
+            "raw_block_ids": self.raw_block_ids,
+            "raw_ring_size": self.raw_ring_size,
+            "raw_slots": self.raw_slots,
+            "request_id": self.request_id,
+            "row_logical_tags": self.row_logical_tags,
+            "version": self.version,
