+class QSAHistoricalRingLedger:
+    """Scheduler-side state machine for one active ring lease.
+
+    ``begin_pending`` records intent only.  A row becomes readable by a future
+    decode step only after ``commit_accepted`` is called with the same lease,
+    epoch, and logical tag.  A new allocation or owner incarnation invalidates
+    the entire ledger by replacing its lease.
+    """
+
+    def __init__(self, lease: QSAHistoricalRingLease, ring_size: int) -> None:
+        if ring_size <= 0:
+            raise ValueError("ring_size must be positive")
+        self._lease = lease
+        self._ring_size = ring_size
+        self._epoch = 0
+        self._revoked = False
+        self._slots: dict[int, _SlotRecord] = {}
+
+    @property
+    def lease(self) -> QSAHistoricalRingLease:
+        return self._lease
+
+    @property
+    def epoch(self) -> int:
+        return self._epoch
+
+    @property
+    def ring_size(self) -> int:
+        return self._ring_size
+
+    @property
+    def revoked(self) -> bool:
+        return self._revoked
+
+    def _check_lease(self, lease: QSAHistoricalRingLease) -> None:
+        if self._revoked or lease != self._lease:
+            raise RuntimeError("QSA historical-ring lease is stale or revoked")
+
+    def _slot(self, logical_tag: int) -> int:
+        if logical_tag < 0:
+            raise ValueError("logical tag must be non-negative")
+        return logical_tag % self._ring_size
+
+    @staticmethod
+    def _normalize_tags(logical_tags: Iterable[int]) -> tuple[int, ...]:
+        tags = tuple(logical_tags)
+        if len(set(tags)) != len(tags):
+            raise ValueError("logical tags must be unique")
+        if any(tag < 0 for tag in tags):
+            raise ValueError("logical tags must be non-negative")
+        return tags
+
+    def begin_pending(
+        self,
+        lease: QSAHistoricalRingLease,
+        epoch: int,
+        logical_tags: Iterable[int],
+    ) -> None:
+        """Mark rows as pending before the worker starts its cache write."""
+        self._check_lease(lease)
+        if epoch < 0:
+            raise RuntimeError("QSA pending epoch must be non-negative")
+        tags = self._normalize_tags(logical_tags)
+        if len(tags) > self._ring_size:
+            raise ValueError("pending transaction exceeds QSA ring capacity")
+        slots = [self._slot(tag) for tag in tags]
+        if len(set(slots)) != len(slots):
+            raise ValueError("pending transaction aliases a physical ring slot")
+        if epoch > self._epoch:
+            self._epoch = epoch
+        # Do not clear pending rows merely because a later async/PP schedule
+        # started. They are independent transactions; an older commit remains
+        # valid when its physical slot has not been overwritten.
+        for logical_tag in tags:
+            slot = self._slot(logical_tag)
+            old = self._slots.get(slot)
+            if old is not None and old.logical_tag == logical_tag:
+                raise RuntimeError("QSA logical tag is already tracked")
+            # Ring wrap overwrites the prior logical tag.  It is invalidated
+            # before the new row can become pending.
+            self._slots[slot] = _SlotRecord(
+                logical_tag=logical_tag,
+                state=QSASlotState.PENDING,
+                epoch=epoch,
+            )
+
+    def commit_accepted(
+        self,
+        lease: QSAHistoricalRingLease,
+        epoch: int,
+        logical_tags: Iterable[int],
+    ) -> None:
+        """Commit rows whose worker write and acceptance are confirmed.
+
+        Async v2 can have a successor transaction pending before the
+        predecessor's completion is consumed by the scheduler.  If the
+        successor wraps the ring, its ``begin_pending`` necessarily replaces
+        the predecessor's record for the reused physical slot.  That one old
+        row is no longer ours, but the other rows in the predecessor are still
+        valid and must remain available to the next compression group.
+
+        Treat a newer record in the same physical slot as an already-applied
+        overwrite and commit the remaining matching rows.  A missing or older
+        record still fails closed: it means the ledger cannot establish that
+        the requested row survived.
+        """
+        self._check_lease(lease)
+        if epoch < 0 or epoch > self._epoch:
+            raise RuntimeError("QSA commit epoch does not match ledger epoch")
+        for logical_tag in self._normalize_tags(logical_tags):
+            slot = self._slot(logical_tag)
+            record = self._slots.get(slot)
+            if record is None:
+                raise RuntimeError("QSA commit does not match pending row")
+            if record.logical_tag > logical_tag:
+                # A newer transaction has already claimed this physical slot.
+                # Do not resurrect the overwritten logical row and do not let
+                # it poison the still-live rows from this transaction.
+                continue
+            if record.logical_tag != logical_tag:
+                raise RuntimeError("QSA commit does not match pending row")
+            if record.state is QSASlotState.COMMITTED and record.epoch == epoch:
+                # Completion delivery can be duplicated across PP/TP paths.
+                continue
+            if record.state is not QSASlotState.PENDING or record.epoch != epoch:
+                raise RuntimeError("QSA commit does not match pending row")
+            record.state = QSASlotState.COMMITTED
+
+    def rollback(
+        self,
+        lease: QSAHistoricalRingLease,
+        new_epoch: int,
+        logical_tags: Iterable[int] = (),
+        *,
+        transaction_epoch: int | None = None,
+    ) -> None:
+        """Invalidate rejected or failed rows and advance the write epoch.
+
+        ``transaction_epoch`` identifies the schedule being rolled back when
+        async execution has more than one pending epoch. Without it, the
+        newest pending epoch is used for backwards-compatible single-flight
+        callers.
+        """
+        self._check_lease(lease)
+        if new_epoch < self._epoch:
+            raise RuntimeError("QSA rollback epoch is older than ledger epoch")
+        if transaction_epoch is not None and transaction_epoch < 0:
+            raise ValueError("transaction_epoch must be non-negative")
+        tags = set(self._normalize_tags(logical_tags))
+        pending_epochs = [
+            record.epoch
+            for record in self._slots.values()
+            if record.state is QSASlotState.PENDING
+        ]
+        target_epoch = transaction_epoch
+        if target_epoch is None and pending_epochs:
+            target_epoch = max(pending_epochs)
+        if new_epoch > self._epoch:
+            self._epoch = new_epoch
+        for slot, record in tuple(self._slots.items()):
+            if (
+                (
+                    record.logical_tag in tags
+                    and (target_epoch is None or record.epoch == target_epoch)
+                )
+                or (
+                    record.state is QSASlotState.PENDING
+                    and (target_epoch is None or record.epoch == target_epoch)
+                )
+            ):
+                del self._slots[slot]
+
+    def revoke(self) -> None:
+        """Invalidate all rows immediately when the owner is released."""
+        self._revoked = True
+        self._slots.clear()
+
+    def prove_committed(
+        self, lease: QSAHistoricalRingLease, logical_tag: int
+    ) -> bool:
+        """Return true only for an exact current committed logical tag."""
+        self._check_lease(lease)
+        record = self._slots.get(self._slot(logical_tag))
+        return bool(
+            record is not None
+            and record.logical_tag == logical_tag
+            and record.state is QSASlotState.COMMITTED
+        )
+
+    def snapshot(
+        self,
+        lease: QSAHistoricalRingLease,
+        *,
+        include_pending: bool = False,
+    ) -> QSAHistoricalRingCapability | None:
+        """Seal committed rows, optionally including ordered pending rows."""
+        self._check_lease(lease)
+        slot_tags = sorted(
+            (slot, record.logical_tag)
+            for slot, record in self._slots.items()
+            if include_pending or record.state is QSASlotState.COMMITTED
+        )
+        if not slot_tags:
+            return None
+        return QSAHistoricalRingCapability(
+            lease=lease,
+            epoch=self._epoch,
+            slot_tags=tuple(slot_tags),
+            ring_size=self._ring_size,
+            stream_ordered=include_pending,
+        )
