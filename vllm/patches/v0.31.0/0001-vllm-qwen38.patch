+def _validate_qsa_native_selection_inputs(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    token_topk: int,
+    compress_ratio: int,
+    out: torch.Tensor,
+) -> None:
+    rows = q.shape[0]
+    if k_cache.ndim != 4 or page_table.ndim != 2 or not all(page_table.shape):
+        raise RuntimeError(
+            "Native QSA selection received invalid cache metadata shapes"
+        )
+    compressed_page_size = int(k_cache.shape[1])
+    if compressed_page_size not in _QSA_SELECTION_PAGE_SIZES:
+        raise RuntimeError(
+            "Native QSA selection supports compressed page sizes "
+            f"{_QSA_SELECTION_PAGE_SIZES}, got {compressed_page_size}"
+        )
+    expected = {
+        "q": (q, torch.float16, (rows, 4, 128)),
+        "k_cache": (
+            k_cache,
+            torch.float16,
+            (k_cache.shape[0], compressed_page_size, 1, 128),
+        ),
+        "page_table": (
+            page_table,
+            torch.int32,
+            tuple(page_table.shape),
+        ),
+        "token_to_req": (token_to_req, torch.int32, (rows,)),
+        "query_positions": (query_positions, torch.int64, (rows,)),
+        "sequence_lengths": (
+            sequence_lengths,
+            torch.int32,
+            (page_table.shape[0],),
+        ),
+        "out": (out, torch.int32, (rows, 2051)),
+    }
+    for name, (tensor, dtype, shape) in expected.items():
+        if (
+            tensor.dtype != dtype
+            or tuple(tensor.shape) != shape
+            or tensor.device != q.device
+            or not tensor.is_contiguous()
+        ):
+            raise RuntimeError(
+                f"Native QSA selection {name} violates the fixed tensor contract"
+            )
+    expected_cache_stride = (compressed_page_size * 128, 128, 128, 1)
+    if tuple(k_cache.stride()) != expected_cache_stride:
+        raise RuntimeError(
+            "Native QSA selection cache must have exact contiguous strides "
+            f"{expected_cache_stride}"
+        )
+    if token_topk != 2048 or compress_ratio != 4:
+        raise RuntimeError("Native QSA selection requires token_topk=2048 and ratio=4")
+    if any(
+        _shares_nonempty_storage(out, tensor)
+        for tensor in (
+            q,
+            k_cache,
+            page_table,
+            token_to_req,
+            query_positions,
+            sequence_lengths,
+        )
+    ):
+        raise RuntimeError("Native QSA selection output must not alias an input")
+
+
+def _run_qsa_native_selection(
+    module: ModuleType,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    token_topk: int,
+    compress_ratio: int,
+    out: torch.Tensor,
+    max_seq_len: int = 0,
+) -> torch.Tensor:
+    compressed_page_size = int(k_cache.shape[1])
+    try:
+        _validate_native_page_capability(module, "selection", compressed_page_size)
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_SELECTION,
+                EVENT_HARD_ERROR_PREFLIGHT,
+                q.shape[0],
+            )
+        raise
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(
+            PATH_QSA_SELECTION,
+            EVENT_NATIVE_SUBMITTED,
+            q.shape[0],
+        )
+    try:
+        operation = module.qsa_select_paged_tokens_v2
+        parallel = get_qsa_long_context_select_op(
+            max_seq_len,
+            q.shape[0],
+            preprocessed=True,
+            compressed_page_size=compressed_page_size,
+        )
+        if parallel is not None:
+            operation = parallel
+        kwargs = {"max_seq_len": max_seq_len} if using_qwen38_sycl() else {}
+        returned = operation(
+            q,
+            k_cache,
+            page_table,
+            token_to_req,
+            query_positions,
+            sequence_lengths,
+            token_topk,
+            compress_ratio,
+            compressed_page_size,
+            out,
+            **kwargs,
+        )
+        return _validate_native_output(returned, out, "selection")
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_SELECTION,
+                EVENT_HARD_ERROR_POST_SUBMIT,
+                q.shape[0],
+            )
+        raise
+
+
+def qsa_select_paged_tokens(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    page_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_positions: torch.Tensor,
+    sequence_lengths: torch.Tensor,
+    token_topk: int,
+    compress_ratio: int,
+    out: torch.Tensor | None = None,
+    *,
+    max_seq_len: int = 0,
+) -> torch.Tensor:
+    """Score, top-k select and expand QSA token indices."""
+    rows = q.shape[0]
+    output_width = token_topk + compress_ratio - 1
+    if out is None:
+        out = torch.empty((rows, output_width), dtype=torch.int32, device=q.device)
+    if out.shape != (rows, output_width):
+        if rows and NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ATTEMPT, rows)
+            NATIVE_STATS.record(
+                PATH_QSA_SELECTION,
+                EVENT_HARD_ERROR_PREFLIGHT,
+                rows,
+            )
+        raise ValueError("QSA selection output has an invalid shape")
+    if not rows:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ZERO_WORK_SKIP, 0)
+        return out
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ATTEMPT, rows)
+    if _native_qsa_disabled() or _qsa_env_flag(_QSA_SELECTION_NATIVE_DISABLE_ENV):
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_SELECTION,
+                EVENT_FALLBACK,
+                rows,
+                REASON_DISABLED,
+            )
+    elif not _qsa_native_selection_candidate(q, token_topk, compress_ratio):
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_SELECTION,
+                EVENT_FALLBACK,
+                rows,
+                _qsa_native_selection_fallback_reason(
+                    q,
+                    token_topk,
+                    compress_ratio,
+                ),
+            )
+    else:
+        compressed_page_size = int(k_cache.shape[1]) if k_cache.ndim >= 2 else None
+        if compressed_page_size not in _QSA_SELECTION_PAGE_SIZES:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_SELECTION,
+                    EVENT_FALLBACK,
+                    rows,
+                    REASON_PAGE_SIZE,
+                )
+        else:
+            try:
+                module = _get_qsa_native_module()
+            except Exception:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_QSA_SELECTION,
+                        EVENT_HARD_ERROR_PREFLIGHT,
+                        rows,
+                    )
+                raise
+            if module is None:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ELIGIBLE, rows)
+                    NATIVE_STATS.record(
+                        PATH_QSA_SELECTION,
+                        EVENT_FALLBACK,
+                        rows,
+                        REASON_DSO_NOT_CONFIGURED,
+                    )
+            elif not callable(getattr(module, "qsa_select_paged_tokens_v2", None)):
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ELIGIBLE, rows)
+                    NATIVE_STATS.record(
+                        PATH_QSA_SELECTION,
+                        EVENT_FALLBACK,
+                        rows,
+                        REASON_OP_UNAVAILABLE,
+                    )
+            else:
+                try:
+                    _validate_qsa_native_selection_inputs(
+                        q,
+                        k_cache,
+                        page_table,
+                        token_to_req,
+                        query_positions,
+                        sequence_lengths,
+                        token_topk,
+                        compress_ratio,
+                        out,
+                    )
+                except Exception:
+                    if NATIVE_STATS_ENABLED:
+                        NATIVE_STATS.record(
+                            PATH_QSA_SELECTION,
+                            EVENT_HARD_ERROR_PREFLIGHT,
+                            rows,
+                        )
+                    raise
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_SELECTION, EVENT_ELIGIBLE, rows)
+                return _run_qsa_native_selection(
+                    module,
+                    q,
+                    k_cache,
+                    page_table,
+                    token_to_req,
+                    query_positions,
+                    sequence_lengths,
+                    token_topk,
+                    compress_ratio,
+                    out,
+                    max_seq_len,
+                )
+    row_sequence_lengths = sequence_lengths.index_select(0, token_to_req.long())
+    visible_blocks = torch.minimum(
+        (query_positions + 1) // compress_ratio,
+        row_sequence_lengths // compress_ratio,
+    ).to(torch.int32)
+    blocks = _streaming_paged_topk(
+        q,
+        k_cache,
+        page_table,
+        token_to_req,
+        visible_blocks,
+        token_topk // compress_ratio,
+    )
+    result = expand_qsa_block_indices_cuda(
+        blocks,
+        query_positions,
+        sequence_lengths,
+        token_to_req,
+        compress_ratio,
+        token_topk,
+        out,
+    )
+    return result
+
+
+def _qsa_sparse_paged_attention_torch(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Sparse GQA over paged K/V caches using gathered selected tokens."""
+    if q.ndim != 3 or k_cache.ndim != 4 or v_cache.shape != k_cache.shape:
+        raise ValueError("QSA sparse attention received invalid Q/K/V shapes")
+    if logical_indices.ndim != 2 or logical_indices.shape[0] != q.shape[0]:
+        raise ValueError("QSA indices must have one row per query")
+    if q.shape[2] != k_cache.shape[3] or q.shape[1] % k_cache.shape[2]:
+        raise ValueError("QSA sparse attention requires valid grouped-query heads")
+    if out is None:
+        out = torch.empty_like(q)
+    if out.shape != q.shape:
+        raise ValueError("QSA sparse output must match its query")
+    out.zero_()
+    if not q.shape[0]:
+        return out
+
+    softmax_scale = q.shape[2] ** -0.5
+    repeats = q.shape[1] // k_cache.shape[2]
+    page_size = k_cache.shape[1]
+    for row in range(q.shape[0]):
+        logical = logical_indices[row]
+        logical = logical[logical >= 0].long()
+        if not logical.numel():
+            continue
+        request = token_to_req[row].long()
+        pages = block_table[request, logical // page_size].long()
+        offsets = logical % page_size
+        keys = k_cache[pages, offsets].repeat_interleave(repeats, dim=1)
+        values = v_cache[pages, offsets].repeat_interleave(repeats, dim=1)
+        scores = torch.einsum("hd,khd->hk", q[row].float(), keys.float())
+        probabilities = torch.softmax(scores * softmax_scale, dim=-1)
+        out[row] = torch.einsum("hk,khd->hd", probabilities, values.float()).to(q.dtype)
+    return out
+
+
+def _qsa_native_attention_candidate(q: torch.Tensor) -> bool:
+    return bool(
+        q.device.type == "xpu"
+        and q.dtype == torch.float16
+        and q.ndim == 3
+        and tuple(q.shape[1:]) in ((3, 256), (6, 256))
+    )
+
+
+def _qsa_native_attention_fallback_reason(q: torch.Tensor) -> int:
+    if q.ndim != 3 or tuple(q.shape[1:]) not in ((3, 256), (6, 256)):
+        return REASON_SHAPE
+    if q.dtype != torch.float16:
+        return REASON_DTYPE
+    if q.device.type != "xpu":
+        return REASON_DEVICE
+    return REASON_OTHER_CONTRACT
+
+
+def _validate_qsa_native_attention_inputs(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    out: torch.Tensor,
+) -> None:
+    if q.ndim != 3 or tuple(q.shape[1:]) not in ((3, 256), (6, 256)):
+        raise RuntimeError("Native QSA attention requires q3 or q6 with head_dim=256")
+    rows = q.shape[0]
+    query_heads = q.shape[1]
+    if k_cache.ndim != 4 or block_table.ndim != 2 or not all(block_table.shape):
+        raise RuntimeError(
+            "Native QSA attention received invalid cache metadata shapes"
+        )
+    main_page_size = int(k_cache.shape[1])
+    if main_page_size not in _QSA_ATTENTION_PAGE_SIZES:
+        raise RuntimeError(
+            "Native QSA attention supports main page sizes "
+            f"{_QSA_ATTENTION_PAGE_SIZES}, got {main_page_size}"
+        )
+    expected = {
+        "q": (q, torch.float16, (rows, query_heads, 256), True),
+        "k_cache": (
+            k_cache,
+            torch.float16,
+            (k_cache.shape[0], main_page_size, 1, 256),
+            False,
+        ),
+        "v_cache": (v_cache, torch.float16, tuple(k_cache.shape), False),
+        "logical_indices": (
+            logical_indices,
+            torch.int32,
+            (rows, 2051),
+            True,
+        ),
+        "block_table": (
+            block_table,
+            torch.int32,
+            tuple(block_table.shape),
+            True,
+        ),
+        "token_to_req": (token_to_req, torch.int32, (rows,), True),
+        "out": (out, torch.float16, (rows, query_heads, 256), True),
+    }
+    for name, (tensor, dtype, shape, require_contiguous) in expected.items():
+        if (
+            tensor.dtype != dtype
+            or tuple(tensor.shape) != shape
+            or tensor.device != q.device
+            or (require_contiguous and not tensor.is_contiguous())
+        ):
+            raise RuntimeError(
+                f"Native QSA attention {name} violates the fixed tensor contract"
+            )
+    if (
+        tuple(k_cache.stride()) != _QSA_PACKED_KV_STRIDES[main_page_size]
+        or tuple(v_cache.stride()) != _QSA_PACKED_KV_STRIDES[main_page_size]
+    ):
+        raise RuntimeError(
+            "Native QSA attention K/V must have packed strides "
+            f"{_QSA_PACKED_KV_STRIDES[main_page_size]}"
+        )
+    if not _shares_nonempty_storage(k_cache, v_cache):
+        raise RuntimeError("Native QSA attention K/V must share one packed storage")
+    if v_cache.storage_offset() != k_cache.storage_offset() + 256:
+        raise RuntimeError("Native QSA attention V must start 256 elements after K")
+    if any(
+        _shares_nonempty_storage(out, tensor)
+        for tensor in (
+            q,
+            k_cache,
+            v_cache,
+            logical_indices,
+            block_table,
+            token_to_req,
+        )
+    ):
+        raise RuntimeError("Native QSA attention output must not alias an input")
+
+
+def _run_qsa_native_attention(
+    module: ModuleType,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    out: torch.Tensor,
+) -> torch.Tensor:
+    main_page_size = int(k_cache.shape[1])
+    if q.shape[1] == 6:
+        operation = _load_qsa_sparse_q6_native_op()
+        timing_label = "qsa_attention_native_q6_v1"
+    else:
+        operation = getattr(module, _QSA_V2_ABI_OPERATION, None)
+        timing_label = _QSA_V2_ABI_TIMING_LABEL
+    if not callable(operation):
+        raise RuntimeError(
+            f"Native QSA does not export a compatible q{q.shape[1]} attention op"
+        )
+    try:
+        _validate_native_page_capability(module, "attention", main_page_size)
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_ATTENTION,
+                EVENT_HARD_ERROR_PREFLIGHT,
+                q.shape[0],
+            )
+        raise
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(
+            PATH_QSA_ATTENTION,
+            EVENT_NATIVE_SUBMITTED,
+            q.shape[0],
+        )
+    timing = _qsa_timing_begin(timing_label)
+    try:
+        returned = operation(
+            q,
+            k_cache,
+            v_cache,
+            logical_indices,
+            block_table,
+            token_to_req,
+            main_page_size,
+            out,
+        )
+        return _validate_native_output(returned, out, "attention")
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_ATTENTION,
+                EVENT_HARD_ERROR_POST_SUBMIT,
+                q.shape[0],
+            )
+        raise
+    finally:
+        _qsa_timing_end(timing)
+
+
+def _qsa_token_split_packed_view(k_cache: torch.Tensor) -> torch.Tensor:
+    """Expose the production K cache plus adjacent V cache as packed KV."""
+    return k_cache.as_strided(
+        (k_cache.shape[0], 1, k_cache.shape[1], 512),
+        (k_cache.stride(0), k_cache.stride(0), k_cache.stride(1), 1),
+    )
+
+
+def _get_qsa_token_split_partials(
+    q: torch.Tensor,
+) -> torch.Tensor:
+    """Return scratch ordered by the current stream.
+
+    Every producer/consumer launch and every later reuse is submitted to this
+    stream.  XPU stream ordering is the completion fence: the next kernel
+    cannot touch the scratch until the previous kernel has finished with it.
+    Device events and host-side ``event.query`` calls are unnecessary here and
+    would add work to every QSA layer in async scheduling mode.
+    """
+    stream = torch.xpu.current_stream(q.device)
+    rows = int(q.shape[0])
+    query_heads = int(q.shape[1])
+    key = (stream.device_index, stream.stream_id, rows, query_heads)
+    partials = _TOKEN_SPLIT_WORKSPACE_CACHE.get(key)
+    if partials is not None:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record_qsa_token_split(QSA_TOKEN_SPLIT_WORKSPACE_REUSED, rows)
+        return partials
+
+    partials = torch.empty(
+        (rows, query_heads, *_TOKEN_SPLIT_PARTIAL_SHAPE),
+        dtype=torch.float32,
+        device=q.device,
+    )
+    _TOKEN_SPLIT_WORKSPACE_CACHE[key] = partials
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record_qsa_token_split(QSA_TOKEN_SPLIT_WORKSPACE_ALLOCATED, rows)
+    return partials
+
+
+def _get_qsa_token_split_fused_buffers(
+    q: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, int]:
+    """Return stream-ordered scratch and the next device completion epoch."""
+    stream = torch.xpu.current_stream(q.device)
+    rows = int(q.shape[0])
+    query_heads = int(q.shape[1])
+    key = (stream.device_index, stream.stream_id, rows, query_heads)
+    cached = _TOKEN_SPLIT_FUSED_WORKSPACE_CACHE.get(key)
+    if cached is not None:
+        partials, ready, epoch = cached
+        next_epoch = (epoch + 1) & 0xFFFF
+        _TOKEN_SPLIT_FUSED_WORKSPACE_CACHE[key] = (
+            partials,
+            ready,
+            next_epoch,
+        )
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record_qsa_token_split(QSA_TOKEN_SPLIT_WORKSPACE_REUSED, rows)
+        return partials, ready, next_epoch
+
+    partials = torch.empty(
+        (rows, query_heads, *_TOKEN_SPLIT_PARTIAL_SHAPE),
+        dtype=torch.float32,
+        device=q.device,
+    )
+    ready = torch.zeros((rows, query_heads), dtype=torch.int32, device=q.device)
+    _TOKEN_SPLIT_FUSED_WORKSPACE_CACHE[key] = (partials, ready, 0)
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record_qsa_token_split(QSA_TOKEN_SPLIT_WORKSPACE_ALLOCATED, rows)
+    return partials, ready, 0
+
+
+def _run_qsa_token_split_attention(
+    operation: object,
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    out: torch.Tensor,
+    *,
+    fused: bool = False,
+) -> torch.Tensor:
+    packed_kv = _qsa_token_split_packed_view(k_cache)
+    ready_counters = None
+    ready_epoch = 0
+    if fused:
+        (
+            partials,
+            ready_counters,
+            ready_epoch,
+        ) = _get_qsa_token_split_fused_buffers(q)
+    else:
+        partials = _get_qsa_token_split_partials(q)
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_NATIVE_SUBMITTED, q.shape[0])
+    timing = _qsa_timing_begin(
+        "qsa_attention_token_split_v4" if fused else "qsa_attention_token_split_v3"
+    )
+    try:
+        if fused:
+            assert ready_counters is not None
+            returned = operation(
+                q,
+                packed_kv,
+                logical_indices,
+                block_table,
+                token_to_req,
+                int(k_cache.shape[1]),
+                out,
+                partials,
+                ready_counters,
+                ready_epoch,
+            )
+        else:
+            returned = operation(
+                q,
+                packed_kv,
+                logical_indices,
+                block_table,
+                token_to_req,
+                int(k_cache.shape[1]),
+                out,
+                partials,
+            )
+        result = _validate_native_output(returned, out, "attention")
+        return result
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_ATTENTION,
+                EVENT_HARD_ERROR_POST_SUBMIT,
+                q.shape[0],
+            )
+        raise
+    finally:
+        _qsa_timing_end(timing)
+
+
+def qsa_sparse_paged_attention(
+    q: torch.Tensor,
+    k_cache: torch.Tensor,
+    v_cache: torch.Tensor,
+    logical_indices: torch.Tensor,
+    block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    out: torch.Tensor | None = None,
+) -> torch.Tensor:
+    """Run sparse paged GQA with the native fixed ABI when compatible."""
+    if out is None:
+        out = torch.empty_like(q)
+    rows = q.shape[0]
+    if not rows:
+        result = _qsa_sparse_paged_attention_torch(
+            q,
+            k_cache,
+            v_cache,
+            logical_indices,
+            block_table,
+            token_to_req,
+            out,
+        )
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_ZERO_WORK_SKIP, 0)
+        return result
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_ATTEMPT, rows)
+    if _native_qsa_disabled():
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_ATTENTION,
+                EVENT_FALLBACK,
+                rows,
+                REASON_DISABLED,
+            )
+    elif not _qsa_native_attention_candidate(q):
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_ATTENTION,
+                EVENT_FALLBACK,
+                rows,
+                _qsa_native_attention_fallback_reason(q),
+            )
+    else:
+        main_page_size = int(k_cache.shape[1]) if k_cache.ndim >= 2 else None
+        if main_page_size not in _QSA_ATTENTION_PAGE_SIZES:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_ATTENTION,
+                    EVENT_FALLBACK,
+                    rows,
+                    REASON_PAGE_SIZE,
+                )
+        else:
+            try:
+                module = _get_qsa_native_module()
+            except Exception:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_QSA_ATTENTION,
+                        EVENT_HARD_ERROR_PREFLIGHT,
+                        rows,
+                    )
+                raise
+            if module is None:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_ELIGIBLE, rows)
+                    NATIVE_STATS.record(
+                        PATH_QSA_ATTENTION,
+                        EVENT_FALLBACK,
+                        rows,
+                        REASON_DSO_NOT_CONFIGURED,
+                    )
+            elif q.shape[1] == 6 and (
+                not _qsa_q6_abi_matches(module)
+                or not callable(getattr(module, "sparse_paged_attention_q6_v1", None))
+                or not callable(
+                    getattr(
+                        module,
+                        "sparse_attention_token_split_candidate_q6_v1",
+                        None,
+                    )
+                )
+            ):
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_QSA_ATTENTION,
+                        EVENT_HARD_ERROR_PREFLIGHT,
+                        rows,
+                    )
+                raise RuntimeError("Native QSA q6 ABI is required for TP4 attention")
+            elif not callable(getattr(module, "sparse_paged_attention_v2", None)):
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_ELIGIBLE, rows)
+                    NATIVE_STATS.record(
+                        PATH_QSA_ATTENTION,
+                        EVENT_FALLBACK,
+                        rows,
+                        REASON_OP_UNAVAILABLE,
+                    )
+            else:
+                try:
+                    _validate_qsa_native_attention_inputs(
+                        q,
+                        k_cache,
+                        v_cache,
+                        logical_indices,
+                        block_table,
+                        token_to_req,
+                        out,
+                    )
+                except Exception:
+                    if NATIVE_STATS_ENABLED:
+                        NATIVE_STATS.record(
+                            PATH_QSA_ATTENTION,
+                            EVENT_HARD_ERROR_PREFLIGHT,
+                            rows,
+                        )
+                    raise
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(PATH_QSA_ATTENTION, EVENT_ELIGIBLE, rows)
+                candidate_gate = bool(
+                    (
+                        main_page_size == 256
+                        or (
+                            main_page_size == 512
+                            and getattr(module, "qsa_token_split_candidate_page512", 0)
+                            == 1
+                        )
+                    )
+                    and rows
+                    <= _QSA_TOKEN_SPLIT_NATIVE_ABI["qsa_token_split_candidate_max_rows"]
+                    and _native_qsa_token_split_enabled()
+                )
+                candidate_op = None
+                candidate_fused = False
+                if candidate_gate:
+                    if NATIVE_STATS_ENABLED:
+                        NATIVE_STATS.record_qsa_token_split(
+                            QSA_TOKEN_SPLIT_ATTEMPT, rows
+                        )
+                    # v3 is the default async path: phase 0 and phase 1 are
+                    # submitted to the same current in-order queue without a
+                    # host wait, so the queue carries the dependency.  The
+                    # single-launch fused implementation has an in-kernel
+                    # atomic/spin merge protocol and is currently slower on
+                    # both M=1 and M>1 for the production geometry.  Keep it
+                    # available for explicit experiments and future tuning.
+                    if (
+                        q.shape[1] == 3
+                        and main_page_size == 256
+                        and _qsa_env_flag(_QSA_TOKEN_SPLIT_FUSED_ENABLE_ENV)
+                        and not _qsa_env_flag(_QSA_TOKEN_SPLIT_FUSED_DISABLE_ENV)
+                    ):
+                        candidate_op = _load_qsa_token_split_native_fused_op()
+                        candidate_fused = candidate_op is not None
+                    if candidate_op is None:
+                        candidate_op = (
+                            _load_qsa_token_split_q6_native_op()
+                            if q.shape[1] == 6
+                            else _load_qsa_token_split_native_op()
+                        )
+                    if candidate_op is not None:
+                        if NATIVE_STATS_ENABLED:
+                            NATIVE_STATS.record_qsa_token_split(
+                                QSA_TOKEN_SPLIT_ELIGIBLE, rows
+                            )
+                            NATIVE_STATS.record_qsa_token_split(
+                                QSA_TOKEN_SPLIT_SUBMITTED, rows
+                            )
+                        return _run_qsa_token_split_attention(
+                            candidate_op,
+                            q,
+                            k_cache,
+                            logical_indices,
+                            block_table,
+                            token_to_req,
+                            out,
+                            fused=candidate_fused,
+                        )
+                    if NATIVE_STATS_ENABLED:
+                        NATIVE_STATS.record_qsa_token_split(
+                            QSA_TOKEN_SPLIT_FALLBACK, rows
+                        )
+                return _run_qsa_native_attention(
+                    module,
+                    q,
+                    k_cache,
+                    v_cache,
+                    logical_indices,
+                    block_table,
+                    token_to_req,
+                    out,
+                )
+    return _qsa_sparse_paged_attention_torch(
+        q,
+        k_cache,
+        v_cache,
+        logical_indices,
+        block_table,
+        token_to_req,
+        out,
+    )
+
+
+def _is_positive_non_overlapping(tensor: torch.Tensor) -> bool:
+    dimensions = sorted(
+        (tensor.stride(dimension), tensor.shape[dimension])
+        for dimension in range(tensor.ndim)
+        if tensor.shape[dimension] > 1
+    )
+    required_span = 1
+    for stride, size in dimensions:
+        if stride < required_span:
+            return False
+        required_span += (size - 1) * stride
+    return True
+
+
+def _qsa_native_row_store_candidate(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+) -> bool:
+    width = cache.shape[3]
+    supported_dtype_width = bool(
+        (cache.dtype in (torch.float16, torch.bfloat16) and width == 128)
+        or (cache.dtype == torch.int64 and width == 3)
+    )
+    return bool(
+        rows.shape[0] > 0
+        and supported_dtype_width
+        and rows.dtype == cache.dtype
+        and cache.device.type == "xpu"
+        and slot_mapping.device == cache.device
+        and rows.device == cache.device
+        and slot_mapping.ndim == 1
+        and slot_mapping.dtype == torch.int64
+        and slot_mapping.is_contiguous()
+        and cache.stride(3) == 1
+        and (cache.dtype == torch.int64 or rows.stride(rows.ndim - 1) == 1)
+    )
+
+
+def _qsa_native_row_store_parallel_candidate(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+    unique_slots_proven: bool,
+) -> bool:
+    if not unique_slots_proven or not 2 <= rows.shape[0] <= 32:
+        return False
+    width = cache.shape[3] if cache.ndim == 4 else -1
+    supported_dtype_width = bool(
+        (cache.dtype in (torch.float16, torch.bfloat16) and width == 128)
+        or (cache.dtype == torch.int64 and width == 3)
+    )
+    if rows.ndim == 3 and rows.shape[1] != 1:
+        return False
+    return bool(
+        supported_dtype_width
+        and rows.dtype == cache.dtype
+        and cache.device.type == "xpu"
+        and slot_mapping.device == cache.device
+        and rows.device == cache.device
+        and slot_mapping.ndim == 1
+        and slot_mapping.dtype == torch.int64
+        and slot_mapping.numel() == rows.shape[0]
+        and slot_mapping.is_contiguous()
+        and rows.ndim in (2, 3)
+        and cache.shape[2] == 1
+        and cache.stride(3) == 1
+        and (cache.dtype == torch.int64 or rows.stride(rows.ndim - 1) == 1)
+    )
+
+
+def _qsa_native_row_store_fallback_reason(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+) -> int:
+    if (
+        cache.device.type != "xpu"
+        or slot_mapping.device != cache.device
+        or rows.device != cache.device
+    ):
+        return REASON_DEVICE
+    width = cache.shape[3]
+    if rows.shape[0] < 1 or width not in (3, 128):
+        return REASON_SHAPE
+    if rows.dtype != cache.dtype or not (
+        (cache.dtype in (torch.float16, torch.bfloat16) and width == 128)
+        or (cache.dtype == torch.int64 and width == 3)
+    ):
+        return REASON_DTYPE
+    if (
+        slot_mapping.ndim != 1
+        or slot_mapping.dtype != torch.int64
+        or not slot_mapping.is_contiguous()
+        or cache.stride(3) != 1
+        or (cache.dtype != torch.int64 and rows.stride(rows.ndim - 1) != 1)
+    ):
+        return REASON_LAYOUT
+    return REASON_OTHER_CONTRACT
+
+
+def _validate_qsa_native_row_store_inputs(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+) -> None:
+    if cache.shape[1] <= 0:
+        raise RuntimeError("Native QSA row-store requires a positive page size")
+    if not _is_positive_non_overlapping(cache):
+        raise RuntimeError(
+            "Native QSA row-store cache must have positive non-overlapping strides"
+        )
+    if not _is_positive_non_overlapping(rows):
+        raise RuntimeError(
+            "Native QSA row-store rows must have positive non-overlapping strides"
+        )
+    if _shares_nonempty_storage(cache, slot_mapping) or _shares_nonempty_storage(
+        cache, rows
+    ):
+        raise RuntimeError(
+            "Native QSA row-store cache must not alias slots or source rows"
+        )
+    if cache.shape[0] * cache.shape[1] > (1 << 63) - 1:
+        raise RuntimeError("Native QSA row-store capacity overflows int64")
+
+
+def _qsa_store_cache_rows_torch(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+) -> None:
+    slots = slot_mapping.reshape(-1)
+    if slots.numel() == 0:
+        return
+    # Hybrid cache pages are padded, and raw keys/positions are views of a
+    # packed page. reshape() may copy them: writing that flattened temporary
+    # never updates the real cache. Address the original page/token axes.
+    # Circular slots also repeat within prefills; choose the last input row
+    # explicitly instead of racing duplicate index_copy_/index_put_ writes.
+    order = torch.argsort(slots, stable=True)
+    sorted_slots = slots[order]
+    last = torch.ones_like(sorted_slots, dtype=torch.bool)
+    last[:-1] = sorted_slots[:-1] != sorted_slots[1:]
+    selected = order[(sorted_slots >= 0) & last]
+    destinations = slots[selected].long()
+    cache[destinations // cache.shape[1], destinations % cache.shape[1], 0] = rows[
+        selected
+    ].to(cache.dtype)
+
+
+class _QsaCacheRowStorePlan:
+    __slots__ = (
+        "cache",
+        "slot_mapping",
+        "rows",
+        "rows_2d",
+        "native_operation",
+        "parallel_operation",
+        "fallback_reason",
+        "work_units",
+    )
+
+    def __init__(
+        self,
+        cache: torch.Tensor,
+        slot_mapping: torch.Tensor,
+        rows: torch.Tensor,
+        rows_2d: torch.Tensor,
+        native_operation: object | None,
+        fallback_reason: int,
+        parallel_operation: object | None = None,
+    ) -> None:
+        self.cache = cache
+        self.slot_mapping = slot_mapping
+        self.rows = rows
+        self.rows_2d = rows_2d
+        self.native_operation = native_operation
+        self.parallel_operation = parallel_operation
+        self.fallback_reason = fallback_reason
+        self.work_units = rows.shape[0]
+
+    def submit(self) -> None:
+        if self.work_units == 0:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ZERO_WORK_SKIP, 0)
+            return
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ATTEMPT, self.work_units)
+        if self.parallel_operation is not None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_CACHE_STORE, EVENT_ELIGIBLE, self.work_units
+                )
+                NATIVE_STATS.record(
+                    PATH_QSA_CACHE_STORE,
+                    EVENT_NATIVE_SUBMITTED,
+                    self.work_units,
+                )
+            try:
+                returned = self.parallel_operation(
+                    self.cache, self.slot_mapping, self.rows, True
+                )
+                _validate_native_output(returned, self.cache, "parallel row-store")
+            except Exception:
+                if NATIVE_STATS_ENABLED:
+                    NATIVE_STATS.record(
+                        PATH_QSA_CACHE_STORE,
+                        EVENT_HARD_ERROR_POST_SUBMIT,
+                        self.work_units,
+                    )
+                raise
+            return
+
+        if self.native_operation is None:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_CACHE_STORE,
+                    EVENT_FALLBACK,
+                    self.work_units,
+                    self.fallback_reason,
+                )
+            _qsa_store_cache_rows_torch(self.cache, self.slot_mapping, self.rows_2d)
+            return
+
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ELIGIBLE, self.work_units)
+            NATIVE_STATS.record(
+                PATH_QSA_CACHE_STORE,
+                EVENT_NATIVE_SUBMITTED,
+                self.work_units,
+            )
+        try:
+            returned = self.native_operation(self.cache, self.slot_mapping, self.rows)
+            _validate_native_output(returned, self.cache, "row-store")
+        except Exception:
+            if NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(
+                    PATH_QSA_CACHE_STORE,
+                    EVENT_HARD_ERROR_POST_SUBMIT,
+                    self.work_units,
+                )
+            raise
+
+
+def _prepare_qsa_cache_row_store(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+    *,
+    unique_slots_proven: bool = False,
+) -> _QsaCacheRowStorePlan:
+    if cache.ndim != 4 or cache.shape[1] <= 0 or cache.shape[2] != 1:
+        raise ValueError(
+            "QSA cache must be [pages, page_size, 1, width] with page_size > 0"
+        )
+    if rows.ndim == 3:
+        if rows.shape[1] != 1:
+            raise ValueError("QSA cache rows must have one head")
+        rows_2d = rows[:, 0]
+    elif rows.ndim == 2:
+        rows_2d = rows
+    else:
+        raise ValueError("QSA cache rows must have rank 2 or 3")
+    if rows_2d.shape != (slot_mapping.numel(), cache.shape[3]):
+        raise ValueError("QSA cache rows and slots have incompatible shapes")
+    if rows.shape[0] == 0:
+        return _QsaCacheRowStorePlan(
+            cache, slot_mapping, rows, rows_2d, None, REASON_NONE
+        )
+    if not _native_qsa_row_store_enabled():
+        return _QsaCacheRowStorePlan(
+            cache, slot_mapping, rows, rows_2d, None, REASON_DISABLED
+        )
+    if (
+        _native_qsa_row_store_parallel_enabled()
+        and _qsa_native_row_store_parallel_candidate(
+            cache, slot_mapping, rows, unique_slots_proven
+        )
+    ):
+        _validate_qsa_native_row_store_inputs(cache, slot_mapping, rows)
+        operation, fallback_reason = _load_qsa_row_store_parallel_native_op()
+        if operation is not None:
+            return _QsaCacheRowStorePlan(
+                cache,
+                slot_mapping,
+                rows,
+                rows_2d,
+                None,
+                fallback_reason,
+                parallel_operation=operation,
+            )
+    if not _qsa_native_row_store_candidate(cache, slot_mapping, rows):
+        return _QsaCacheRowStorePlan(
+            cache,
+            slot_mapping,
+            rows,
+            rows_2d,
+            None,
+            _qsa_native_row_store_fallback_reason(cache, slot_mapping, rows),
+        )
+
+    _validate_qsa_native_row_store_inputs(cache, slot_mapping, rows)
+    operation, fallback_reason = _load_qsa_row_store_native_op()
+    return _QsaCacheRowStorePlan(
+        cache,
+        slot_mapping,
+        rows,
+        rows_2d,
+        operation,
+        fallback_reason,
+    )
+
+
+def validate_qsa_write_manifest(
+    stores: tuple[tuple[torch.Tensor, torch.Tensor, torch.Tensor], ...],
+    store_kinds: tuple[str, ...],
+    manifest: QSAHistoricalRingWriteManifest,
+) -> None:
+    """Validate all QSA write mappings before the first cache mutation.
+
+    Device slot tensors are intentionally not converted to host values.  On
+    CPU, the exact vector is checked directly; on XPU, shape/capacity and the
+    immutable manifest contract are checked without introducing a synchronizing
+    scalar read.  The production metadata builder is the sole producer of the
+    device mapping used by the subsequent ABI3 stores.
+    """
+    if type(manifest) is not QSAHistoricalRingWriteManifest:
+        raise TypeError("QSA cache stores require a typed write manifest")
+    if len(stores) != len(store_kinds):
+        raise ValueError("QSA manifest store kinds do not match store count")
+    if len(set(store_kinds)) != len(store_kinds) or not set(store_kinds) <= {
+        "raw",
+        "compressed",
+        "position",
+    }:
+        raise ValueError("QSA manifest store kinds are invalid")
+    for (cache, slot_mapping, rows), store_kind in zip(
+        stores, store_kinds, strict=True
+    ):
+        expected_slots = manifest.expected_slots(store_kind)
+        if slot_mapping.numel() != len(expected_slots):
+            raise ValueError(
+                f"QSA {store_kind} slot mapping length does not match manifest"
+            )
+        if cache.ndim != 4 or cache.shape[1] <= 0 or cache.shape[2] != 1:
+            raise ValueError("QSA manifest cache has an invalid paged shape")
+        if any(slot >= cache.shape[0] * cache.shape[1] for slot in expected_slots):
+            raise ValueError(f"QSA {store_kind} manifest slot exceeds cache capacity")
+        if slot_mapping.device.type == "cpu":
+            actual_slots = tuple(
+                int(value) for value in slot_mapping.reshape(-1).tolist()
+            )
+            if actual_slots != expected_slots:
+                raise ValueError(
+                    f"QSA {store_kind} device mapping disagrees with manifest"
+                )
+        if rows.shape[0] != len(expected_slots):
+            raise ValueError(f"QSA {store_kind} rows do not match manifest row count")
+
+
+def _qsa_record_receipt_completion_fence(device: torch.device) -> None:
+    """Fence the current XPU stream after receipt D2H copies are queued."""
+    if device.type != "xpu":
+        return
+    current_stream = torch.xpu.current_stream(device=device)
+    record_event = getattr(current_stream, "record_event", None)
+    if not callable(record_event):
+        raise RuntimeError("QSA row-store receipt requires a stream event fence")
+    event = record_event()
+    synchronize = getattr(event, "synchronize", None)
+    if not callable(synchronize):
+        raise RuntimeError("QSA row-store receipt event cannot be synchronized")
+    synchronize()
+
+
+def _validate_qsa_host_receipt(
+    receipt: torch.Tensor,
+    expected_slots: tuple[int, ...],
+    store_kind: str,
+) -> None:
+    if (
+        receipt.device.type != "cpu"
+        or receipt.dtype != torch.int64
+        or receipt.shape != (len(expected_slots), 2)
+        or not receipt.is_contiguous()
+    ):
+        raise RuntimeError(
+            f"QSA {store_kind} receipt host buffer has an invalid contract"
+        )
+    actual = tuple(tuple(int(value) for value in row) for row in receipt.tolist())
+    expected = tuple(
+        (_QSA_RECEIPT_PAD, -1) if slot == -1 else (_QSA_RECEIPT_WRITTEN, slot)
+        for slot in expected_slots
+    )
+    if actual != expected:
+        raise RuntimeError(
+            f"QSA {store_kind} receipt disagrees with manifest: "
+            f"expected={expected!r}, actual={actual!r}"
+        )
+
+
+def _qsa_store_cache_rows_strict_transaction(
+    stores: tuple[tuple[torch.Tensor, torch.Tensor, torch.Tensor], ...],
+    store_kinds: tuple[str, ...],
+    manifest: QSAHistoricalRingWriteManifest,
+    receipt_workspace: QSAWriteReceiptWorkspace | None,
+) -> bool:
+    """Submit ABI4 rows and prove every physical write before returning.
+
+    The ABI4 kernel accepts an arbitrary row count, while the ordinary native
+    row-store candidate intentionally remains a single-row fast path.  A
+    manifest-required XPU transaction may therefore submit a multi-row prefill
+    as one-row ABI4 calls, preserving the existing single-row ABI and receipt
+    validation without using an unproven legacy store.
+    """
+    if type(manifest) is not QSAHistoricalRingWriteManifest:
+        raise TypeError("strict QSA cache stores require a typed write manifest")
+    validate_qsa_write_manifest(stores, store_kinds, manifest)
+    if not stores:
+        raise ValueError("strict QSA cache stores cannot be empty")
+    if _qsa_native_graph_unsafe():
+        raise RuntimeError(
+            "strict QSA row-store receipt is unavailable during graph capture"
+        )
+    if not _native_qsa_row_store_receipt_enabled():
+        raise RuntimeError(
+            "strict QSA row-store receipt ABI4 is disabled before submit"
+        )
+    operation, reason = _load_qsa_row_store_receipt_native_op()
+    if operation is None:
+        raise RuntimeError(
+            "strict QSA row-store receipt ABI4 is unavailable before submit: "
+            f"reason={reason}"
+        )
+
+    device = stores[0][0].device
+    for (cache, slot_mapping, rows), store_kind in zip(
+        stores, store_kinds, strict=True
+    ):
+        if cache.device != device:
+            raise ValueError(f"strict QSA {store_kind} store must share one device")
+        multi_row_xpu = device.type == "xpu" and rows.shape[0] > 1
+        if not _qsa_native_row_store_candidate(cache, slot_mapping, rows):
+            if not multi_row_xpu:
+                raise RuntimeError(
+                    f"strict QSA {store_kind} row-store input contract is unsupported"
+                )
+            # Keep all preflight checks ahead of the first physical mutation.
+            # Each one-row slice is the already-proven ABI4 candidate.
+            for row_index in range(rows.shape[0]):
+                row_slots = slot_mapping[row_index : row_index + 1]
+                row_values = rows[row_index : row_index + 1].contiguous()
+                if not _qsa_native_row_store_candidate(cache, row_slots, row_values):
+                    raise RuntimeError(
+                        f"strict QSA {store_kind} row-store input contract "
+                        "is unsupported"
+                    )
+                _validate_qsa_native_row_store_inputs(cache, row_slots, row_values)
+        else:
+            rows = rows.contiguous()
+            _validate_qsa_native_row_store_inputs(cache, slot_mapping, rows)
+
+    # Resolve all reusable receipt buffers before the first physical mutation.
+    # This keeps allocation failures and stream mismatches pre-submit failures.
+    workspace = receipt_workspace or QSAWriteReceiptWorkspace()
+    workspace.bind_stream(device)
+    max_rows = max(rows.shape[0] for _, _, rows in stores)
+    workspace.ensure_device(max_rows, device)
+    host_receipts = [
+        workspace.ensure_host(index, rows.shape[0])
+        for index, (_, _, rows) in enumerate(stores)
+    ]
+
+    for index, ((cache, slot_mapping, rows), _store_kind) in enumerate(
+        zip(stores, store_kinds, strict=True)
+    ):
+        device_receipt = workspace.ensure_device(rows.shape[0], device)
+        # ABI4 currently has a proven one-row caller contract.  Splitting here
+        # also keeps each receipt row tied to exactly one physical submission.
+        if rows.shape[0] == 1:
+            qsa_store_cache_rows_v4(
+                cache,
+                slot_mapping,
+                rows.contiguous(),
+                receipt=device_receipt,
+            )
+        else:
+            for row_index in range(rows.shape[0]):
+                qsa_store_cache_rows_v4(
+                    cache,
+                    slot_mapping[row_index : row_index + 1],
+                    rows[row_index : row_index + 1].contiguous(),
+                    receipt=device_receipt[row_index : row_index + 1],
+                )
+        # The copies are enqueued on the same stream as the native row stores.
+        host_receipts[index].copy_(device_receipt, non_blocking=True)
+
+    _qsa_record_receipt_completion_fence(device)
+    for index, (_, _, _) in enumerate(stores):
+        _validate_qsa_host_receipt(
+            host_receipts[index],
+            manifest.expected_slots(store_kinds[index]),
+            store_kinds[index],
+        )
+    return True
+
+
+@lru_cache(maxsize=1)
+def _load_qsa_store_m1_transaction_op() -> Callable[..., bool] | None:
+    module = _get_qsa_native_module()
+    if getattr(module, "qsa_store_m1_transaction_abi_version", None) != 1:
+        return None
+    # Still validate the existing row-store ABI before bypassing its adapter.
+    legacy, _ = _load_qsa_row_store_native_op()
+    operation = getattr(module, "try_store_m1_transaction_v1", None)
+    return operation if legacy is not None and callable(operation) else None
+
+
+def qsa_store_cache_rows_transaction(
+    stores: tuple[tuple[torch.Tensor, torch.Tensor, torch.Tensor], ...],
+    *,
+    store_kinds: tuple[str, ...] | None = None,
+    manifest: QSAHistoricalRingWriteManifest | None = None,
+    receipt_workspace: QSAWriteReceiptWorkspace | None = None,
+    unique_slots_proven: tuple[bool, ...] | None = None,
+) -> bool:
+    """Preflight and submit cache mutation as one transaction.
+
+    A manifest-required transaction is strict: ABI4 receipt, same-stream
+    completion fence, host validation, and exact manifest slots are all needed
+    before ``True`` is returned.  Legacy callers without a manifest retain the
+    ABI3 behavior for compatibility fixtures and unsupported scenarios.
+    """
+    if manifest is not None:
+        if store_kinds is None:
+            raise ValueError("strict QSA stores require explicit store kinds")
+        return _qsa_store_cache_rows_strict_transaction(
+            stores, store_kinds, manifest, receipt_workspace
+        )
+
+    proofs = (
+        unique_slots_proven
+        if unique_slots_proven is not None
+        else (False,) * len(stores)
+    )
+    if len(proofs) != len(stores):
+        raise ValueError("QSA row-store proof count must match store count")
+    # The native M1 transaction owns every tensor check before its first
+    # mutation. Unsupported cases return False without submitting anything;
+    # exceptions after submission are never caught/replayed through fallback.
+    # Keep strict receipts, audit counters and tensor subclass/mode semantics
+    # on the original path. No CPU reads or stream synchronization are added.
+    if (
+        not NATIVE_STATS_ENABLED
+        and stores
+        and type(stores[0][2]) is torch.Tensor
+        and stores[0][2].ndim in (2, 3)
+        and stores[0][2].shape[0] == 1
+        and not _qsa_env_flag("VLLM_XPU_DISABLE_QWEN38_QSA_STORE_TRANSACTION_NATIVE")
+        and _native_qsa_row_store_enabled()
+        and not torch.compiler.is_compiling()
+        and not torch._C._is_torch_function_mode_enabled()
+        and not torch._C._dispatch_tls_is_dispatch_key_included(
+            torch._C.DispatchKey.Python
+        )
+        and all(type(t) is torch.Tensor for store in stores for t in store)
+    ):
+        operation = _load_qsa_store_m1_transaction_op()
+        if operation is not None and operation(
+            stores, _qsa_env_flag("VLLM_XPU_QWEN38_QSA_STORE_TRANSACTION_FUSED", True)
+        ):
+            return True
+    plans = []
+    for index, (cache, slot_mapping, rows) in enumerate(stores):
+        try:
+            plans.append(
+                _prepare_qsa_cache_row_store(
+                    cache,
+                    slot_mapping,
+                    rows,
+                    unique_slots_proven=bool(proofs[index]),
+                )
+            )
+        except Exception:
+            work_units = slot_mapping.numel()
+            if work_units and NATIVE_STATS_ENABLED:
+                NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ATTEMPT, work_units)
+                NATIVE_STATS.record(
+                    PATH_QSA_CACHE_STORE,
+                    EVENT_HARD_ERROR_PREFLIGHT,
+                    work_units,
+                )
+            raise
+    for plan in plans:
+        plan.submit()
+    return True
+
+
+def qsa_store_cache_rows_v4(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+    *,
+    receipt: torch.Tensor | None = None,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Submit ABI4 row-store and return its caller-owned device receipt.
+
+    ABI4 is deliberately separate from the legacy bool transaction.  It never
+    falls back after native submission.  The optional receipt lets a production
+    caller reuse a preallocated workspace instead of allocating on every row
+    store; the strict transaction validates completion separately.
+    """
+    if rows.ndim == 3:
+        if rows.shape[1] != 1:
+            raise ValueError("QSA cache rows must have one head")
+    elif rows.ndim != 2:
+        raise ValueError("QSA cache rows must have rank 2 or 3")
+    if rows.shape[0] != slot_mapping.numel():
+        raise ValueError("QSA cache rows and slots have incompatible shapes")
+    if receipt is None:
+        receipt = torch.empty(
+            (rows.shape[0], 2), dtype=torch.int64, device=cache.device
+        )
+    if (
+        receipt.shape != (rows.shape[0], 2)
+        or receipt.dtype != torch.int64
+        or receipt.device != cache.device
+        or not receipt.is_contiguous()
+    ):
+        raise ValueError(
+            "QSA row-store receipt must be contiguous int64 [N,2] on cache device"
+        )
+    if (
+        _shares_nonempty_storage(receipt, cache)
+        or _shares_nonempty_storage(receipt, slot_mapping)
+        or _shares_nonempty_storage(receipt, rows)
+    ):
+        raise ValueError("QSA row-store receipt must not alias its inputs")
+    if rows.shape[0] == 0:
+        return cache, receipt
+    if not _native_qsa_row_store_receipt_enabled():
+        raise RuntimeError("QSA row-store receipt ABI4 is not enabled")
+    if not _qsa_native_row_store_candidate(cache, slot_mapping, rows):
+        raise RuntimeError("QSA row-store receipt ABI4 input contract is unsupported")
+    _validate_qsa_native_row_store_inputs(cache, slot_mapping, rows)
+    operation = get_qsa_row_store_receipt_op()
+    if operation is None:
+        raise RuntimeError("QSA row-store receipt ABI4 is unavailable")
+    # ABI4 writes one status/slot pair for every row, including PAD/OOB rows.
+    # Do not clear the caller-owned device buffer with a Torch op here: the
+    # native operation must overwrite every entry before the completion fence.
+    if NATIVE_STATS_ENABLED:
+        NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ATTEMPT, rows.shape[0])
+        NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_ELIGIBLE, rows.shape[0])
+        NATIVE_STATS.record(PATH_QSA_CACHE_STORE, EVENT_NATIVE_SUBMITTED, rows.shape[0])
+    try:
+        returned = operation(cache, slot_mapping, rows, receipt)
+        if not isinstance(returned, (tuple, list)) or len(returned) != 2:
+            raise RuntimeError(
+                "Native QSA row-store receipt ABI4 must return (cache, receipt)"
+            )
+        _validate_native_output(returned[0], cache, "row-store receipt cache")
+        _validate_native_output(returned[1], receipt, "row-store receipt")
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_CACHE_STORE,
+                EVENT_HARD_ERROR_POST_SUBMIT,
+                rows.shape[0],
+            )
+        raise
+    return cache, receipt
+
+
+def qsa_store_cache_rows(
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    rows: torch.Tensor,
+) -> None:
+    """Scatter fixed-width rows into a paged QSA cache at ``slot_mapping``."""
+    qsa_store_cache_rows_transaction(((cache, slot_mapping, rows),))
+
+
+def try_qsa_group_compress_native(
+    raw_keys: torch.Tensor,
+    raw_positions: torch.Tensor,
+    compressor_state_cache: torch.Tensor,
+    rope_position_cache: torch.Tensor | None,
+    compressor_state_block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    logical_positions: torch.Tensor,
+    compressed_slots: torch.Tensor,
+    compress_ratio: int,
+    compressed_capacity: int,
+    *,
+    historical_ring_proven: bool,
+    output_owner: object,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """Run caller-owned stream-ordered QSA compression when safe.
+
+    The v2 ABI accepts one row or a batch of rows.  It owns no cache writes and
+    does not synchronize the host; all reuse of the output buffers is ordered
+    by the current XPU stream.
+    """
+    native_enabled = _native_qsa_group_compression_enabled()
+    graph_unsafe = _qsa_native_graph_unsafe()
+    if not native_enabled or graph_unsafe:
+        return None
+    if not historical_ring_proven or rope_position_cache is None:
+        return None
+    if not isinstance(raw_keys, torch.Tensor):
+        return None
+    rows = raw_keys.shape[0] if raw_keys.ndim >= 1 else 0
+    # Keep this preflight in lock-step with validate_group_compression_v2_inputs
+    # in the extension.  In particular, ``is_contiguous()`` does not imply a
+    # useful inner stride for a dimension of size one; the C++ ABI checks the
+    # position inner stride explicitly for that reason.  This must be a
+    # conjunction of valid predicates.  An earlier OR-shaped version allowed
+    # malformed singleton-stride views through to C++, where they raised after
+    # the async launch had been selected.
+    contract_ok = (
+        rows > 0
+        and raw_keys.device.type == "xpu"
+        and raw_keys.dtype in (torch.float16, torch.bfloat16)
+        and raw_keys.shape == (rows, 1, 128)
+        and raw_keys.stride(2) == 1
+        and raw_positions.device == raw_keys.device
+        and raw_positions.dtype == torch.int64
+        and raw_positions.shape == (rows, 1, 3)
+        and raw_positions.is_contiguous()
+        and raw_positions.stride(2) == 1
+        and compressor_state_cache.device == raw_keys.device
+        and compressor_state_cache.dtype == raw_keys.dtype
+        and compressor_state_cache.ndim == 4
+        and compressor_state_cache.shape[0] > 0
+        and compressor_state_cache.shape[1] >= 4
+        and compressor_state_cache.shape[2:] == (1, 128)
+        and compressor_state_cache.stride(3) == 1
+        and rope_position_cache.device == raw_keys.device
+        and rope_position_cache.dtype == torch.int64
+        and rope_position_cache.shape
+        == (
+            compressor_state_cache.shape[0],
+            compressor_state_cache.shape[1],
+            1,
+            3,
+        )
+        and rope_position_cache.stride(3) == 1
+        and compressor_state_block_table.device == raw_keys.device
+        and compressor_state_block_table.dtype == torch.int32
+        and compressor_state_block_table.ndim == 2
+        and compressor_state_block_table.shape[0] >= 1
+        and compressor_state_block_table.shape[1] >= 1
+        and compressor_state_block_table.is_contiguous()
+        and token_to_req.device == raw_keys.device
+        and token_to_req.dtype == torch.int32
+        and token_to_req.shape == (rows,)
+        and token_to_req.is_contiguous()
+        and query_start_loc.device == raw_keys.device
+        and query_start_loc.dtype == torch.int32
+        and query_start_loc.ndim == 1
+        and query_start_loc.numel() >= 2
+        and compressor_state_block_table.shape[0] >= query_start_loc.numel() - 1
+        and query_start_loc.is_contiguous()
+        and logical_positions.device == raw_keys.device
+        and logical_positions.dtype == torch.int64
+        and logical_positions.shape == (rows,)
+        and logical_positions.is_contiguous()
+        and compressed_slots.device == raw_keys.device
+        and compressed_slots.dtype == torch.int64
+        and compressed_slots.shape == (rows,)
+        and compressed_slots.is_contiguous()
+        and compress_ratio == 4
+        and compressed_capacity > 0
+    )
+    if not contract_ok:
+        return None
+
+    operation = get_qsa_group_compression_op()
+    if operation is None:
+        return None
+    stream = torch.xpu.current_stream(device=raw_keys.device)
+    from ..full_decode import active_full_decode_state
+
+    full_decode_state = active_full_decode_state()
+    stream_key: tuple[object, ...] = (raw_keys.device, stream)
+    if full_decode_state is not None:
+        stream_key += (full_decode_state,)
+    buffers = getattr(output_owner, "_esimd_qsa_group_compression_buffers", None)
+    if buffers is None:
+        buffers = {}
+        output_owner._esimd_qsa_group_compression_buffers = buffers
+    outputs = buffers.get(stream_key)
+    if not (
+        isinstance(outputs, tuple)
+        and len(outputs) == 2
+        and all(isinstance(output, torch.Tensor) for output in outputs)
+        and outputs[0].shape == (rows, 1, 128)
+        and outputs[0].dtype == raw_keys.dtype
+        and outputs[1].shape == (rows, 3)
+        and outputs[1].dtype == torch.int64
+        and outputs[0].device == raw_keys.device
+        and outputs[1].device == raw_keys.device
+        and outputs[0].is_contiguous()
+        and outputs[1].is_contiguous()
+    ):
+        outputs = (
+            torch.empty((rows, 1, 128), dtype=raw_keys.dtype, device=raw_keys.device),
+            torch.empty((rows, 3), dtype=torch.int64, device=raw_keys.device),
+        )
+        buffers[stream_key] = outputs
+    pooled, first_positions = outputs
+
+    def aliases(lhs: torch.Tensor, rhs: torch.Tensor) -> bool:
+        alias_method = getattr(lhs, "is_alias_of", None)
+        if callable(alias_method):
+            return bool(alias_method(rhs))
+        return bool(torch._C._is_alias_of(lhs, rhs))
+
+    if any(
+        aliases(output, tensor)
+        for output in outputs
+        for tensor in (
+            raw_keys,
+            raw_positions,
+            compressor_state_cache,
+            rope_position_cache,
+            compressor_state_block_table,
+            token_to_req,
+            query_start_loc,
+            logical_positions,
+            compressed_slots,
+        )
+    ) or aliases(pooled, first_positions):
+        return None
+
+    try:
+        returned = operation(
+            raw_keys,
+            raw_positions,
+            compressor_state_cache,
+            rope_position_cache,
+            compressor_state_block_table,
+            token_to_req,
+            query_start_loc,
+            logical_positions,
+            compressed_slots,
+            pooled,
+            first_positions,
+            compress_ratio,
+            int(compressed_capacity),
+            bool(historical_ring_proven),
+        )
+        returned_aliases_pooled = False
+        if isinstance(returned, torch.Tensor):
+            alias_method = getattr(returned, "is_alias_of", None)
+            returned_aliases_pooled = (
+                bool(alias_method(pooled))
+                if callable(alias_method)
+                else bool(torch._C._is_alias_of(returned, pooled))
+            )
+        if (
+            not isinstance(returned, torch.Tensor)
+            or returned.device != pooled.device
+            or returned.dtype != pooled.dtype
+            or returned.shape != pooled.shape
+            or not returned.is_contiguous()
+            or not returned_aliases_pooled
+            or returned.data_ptr() != pooled.data_ptr()
+        ):
+            raise RuntimeError(
+                "Qwen3.8 QSA group compression returned an invalid caller-owned ABI"
+            )
+    except Exception:
+        if NATIVE_STATS_ENABLED:
+            NATIVE_STATS.record(
+                PATH_QSA_GROUP_COMPRESSION,
+                EVENT_HARD_ERROR_POST_SUBMIT,
+                rows,
+            )
+        raise
+    return pooled, first_positions
+
+
+def qsa_compress_groups_with_ratio(
+    raw_keys: torch.Tensor,
+    raw_positions: torch.Tensor,
+    compressor_state_cache: torch.Tensor,
+    compressor_state_block_table: torch.Tensor,
+    token_to_req: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    logical_positions: torch.Tensor,
+    compressed_slots: torch.Tensor,
+    compress_ratio: int,
+    rope_cache: torch.Tensor | None = None,
+    *,
+    historical_ring_proven: bool = False,
+    allow_unproven_history: bool = False,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """Mean-pool ``compress_ratio`` consecutive keys per completed group.
+
+    A group's members may straddle this step's raw rows (positions at or after
+    each request's chunk start) and the compressor-state ring (older members
+    committed by previous steps), mirroring ``_compress_qsa_groups_kernel``.
+    Historical members are read only with an explicit producer-owned proof;
+    ``allow_unproven_history`` is an explicit legacy fallback used by the
+    host integration when a complete per-request proof is unavailable.
+    """
+    rows = token_to_req.numel()
+    if compress_ratio <= 0:
+        raise ValueError("QSA compression ratio must be positive")
+    if raw_keys.ndim != 3 or raw_keys.shape[:2] != (rows, 1):
+        raise ValueError("QSA raw keys must be [rows, 1, head_size]")
+    if raw_positions.shape != (rows, 1, 3) or raw_positions.dtype != torch.int64:
+        raise ValueError("QSA raw positions must be [rows, 1, 3] int64")
+    if logical_positions.shape != (rows,) or compressed_slots.shape != (rows,):
+        raise ValueError("QSA compression metadata must match token rows")
+    if compressor_state_cache.ndim != 4 or compressor_state_cache.shape[2] != 1:
+        raise ValueError("QSA compressor-state cache has an invalid shape")
+
+    head_dim = raw_keys.shape[2]
+    ring_size = compressor_state_cache.shape[1]
+    num_blocks = compressor_state_cache.shape[0]
+    num_requests = query_start_loc.shape[0] - 1
+    device = raw_keys.device
+    pooled = torch.zeros((rows, 1, head_dim), dtype=raw_keys.dtype, device=device)
+    first_positions = torch.zeros((rows, 3), dtype=torch.int64, device=device)
+    if not rows:
+        return pooled, first_positions
+
+    load_rope = rope_cache is not None
+    read_historical_ring = historical_ring_proven or allow_unproven_history
+    ring_keys = None
+    ring_positions = None
+    if read_historical_ring:
+        ring_keys = compressor_state_cache[:, :, 0, :]
+        ring_positions = rope_cache[:, :, 0, :] if load_rope else None
+    raw_key_rows = raw_keys[:, 0, :]
+    raw_pos_rows = raw_positions[:, 0, :]
+
+    req = token_to_req.long()
+    valid_request = (req >= 0) & (req < num_requests)
+    safe_req = req.clamp(0, max(num_requests - 1, 0))
+    query_row_start = query_start_loc[safe_req].long()
+    query_row_end = query_start_loc[(safe_req + 1).clamp(max=num_requests)].long()
+    row_ids = torch.arange(rows, device=device)
+    end_position = logical_positions.long()
+    chunk_start = end_position - (row_ids - query_row_start)
+    block = compressor_state_block_table[safe_req, 0].long()
+    valid_block = (block >= 0) & (block < num_blocks)
+    valid_row = (
+        valid_request
+        & (row_ids >= query_row_start)
+        & (row_ids < query_row_end)
+        & (end_position >= compress_ratio - 1)
+        & (compressed_slots >= 0)
+    )
+    first_position = end_position - compress_ratio + 1
+    if not historical_ring_proven:
+        history_needed = torch.any(
+            valid_row & valid_block & (first_position < chunk_start)
+        )
+        if bool(history_needed.item()) and not allow_unproven_history:
+            raise RuntimeError(
+                "QSA compression requires a trusted historical ring proof"
+            )
+
+    accumulator = torch.zeros((rows, head_dim), dtype=torch.float32, device=device)
+    for group_offset in range(compress_ratio):
+        position = end_position - (compress_ratio - 1 - group_offset)
+        use_raw = position >= chunk_start
+        raw_row = (query_row_start + (position - chunk_start)).clamp(0, rows - 1)
+        raw_ok = (
+            valid_row
+            & use_raw
+            & (raw_row >= query_row_start)
+            & (raw_row < query_row_end)
+        )
+        ring_ok = valid_row & (~use_raw) & valid_block & read_historical_ring
+        raw_vals = raw_key_rows.index_select(0, raw_row).float()
+        if read_historical_ring:
+            ring_slot = (position % ring_size).clamp(0, ring_size - 1)
+            ring_vals = ring_keys[
+                block.clamp(0, max(num_blocks - 1, 0)), ring_slot
+            ].float()
+        else:
+            # Do not even index the persistent ring without a producer-owned
+            # proof; masking an already-loaded stale row is not fail-closed.
+            ring_vals = torch.zeros_like(raw_vals)
+        contrib = torch.where(
+            raw_ok.unsqueeze(1),
+            raw_vals,
+            torch.where(ring_ok.unsqueeze(1), ring_vals, torch.zeros_like(raw_vals)),
+        )
+        accumulator += contrib
+    pooled_rows = (accumulator / compress_ratio).to(raw_keys.dtype)
+    pooled[:, 0, :] = torch.where(
+        valid_row.unsqueeze(1), pooled_rows, torch.zeros_like(pooled_rows)
+    )
+
+    if load_rope:
+        first_from_raw = first_position >= chunk_start
+        raw_first_row = (query_row_start + (first_position - chunk_start)).clamp(
+            0, rows - 1
+        )
+        raw_first_ok = (
+            valid_row
+            & first_from_raw
+            & (raw_first_row >= query_row_start)
+            & (raw_first_row < query_row_end)
+        )
+        raw_pos_vals = raw_pos_rows.index_select(0, raw_first_row)
+        if read_historical_ring:
+            ring_first_slot = (first_position % ring_size).clamp(0, ring_size - 1)
+            ring_pos_vals = ring_positions[
+                block.clamp(0, max(num_blocks - 1, 0)), ring_first_slot
+            ]
+        else:
+            # The position sidecar is subject to the same proof as ring keys.
+            ring_pos_vals = torch.zeros_like(raw_pos_vals)
+        ring_first_ok = (
+            valid_row & (~first_from_raw) & valid_block & read_historical_ring
+        )
+        pos_vals = torch.where(raw_first_ok.unsqueeze(1), raw_pos_vals, ring_pos_vals)
+        position_valid = raw_first_ok | ring_first_ok
+        first_positions = torch.where(
+            position_valid.unsqueeze(1), pos_vals, torch.zeros_like(pos_vals)
+        )
+    else:
+        scalar = torch.where(
+            valid_row, first_position, torch.zeros_like(first_position)
+        )
+        first_positions = scalar.unsqueeze(1).expand(rows, 3).contiguous()
+    return pooled, first_positions
+
+
+__all__ = [
+    "expand_qsa_block_indices_cuda",
+    "get_qsa_group_compression_op",
