+        try:
+            plan.op(
+                qkv,
+                q,
+                gate_out,
+                k,
+                v,
+                plan.norm_wq,
+                plan.norm_wk,
+                positions_i32,
+                plan.q_heads,
+                plan.kv_heads,
+                plan.attn_output_gate,
+                plan.rotary_dim,
+                plan.cos_sin_cache,
+                **({"positions_bounds_proven": True} if sycl_backend else {}),
+            )
+        except (AttributeError, RuntimeError, TypeError):
+            if sycl_backend:
+                raise  # Never replay a fallback after a native submit.
+            return None
+        return Qwen3NextQkvPostprocessResult(q, k, v, gate)
