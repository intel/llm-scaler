+        all_reduce_module = getattr(
+            self._all_reduce,
+            "__module__",
+            type(self._all_reduce).__module__,
+        )
+        pre_reduce_heads = owner._esimd_local_partial.view(
+            1, _QWEN38_HEADS, _QWEN38_HEAD_DIM
