+            "schema": "qwen38.tp8.capture.rank.v1",
+            "rank": rank,
+            "world_size": world_size,
+            "call_index": call_index,
+            "run_id": self._capture_run_id,
+            "device": str(ngram_ids.device),
+            "weight_shape": tuple(owner.ngram_embedding.weight.shape),
+            "weight_dtype": str(owner.ngram_embedding.weight.dtype),
+            "stream": self._current_stream_metadata(ngram_ids.device),
+            "collective": {
