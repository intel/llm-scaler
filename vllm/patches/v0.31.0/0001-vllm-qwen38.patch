+    def _get_esimd_moe_sources(
+        self, *, refresh_weight_bindings: bool = True
+    ) -> _EsimdMoeSources | None:
+        """Resolve live layers; native consumers may opt out of Python refresh.
+
+        Callers opting out must preflight the live weights in their native ABI.
+        Default callers retain Python cache invalidation and legacy guards.
+        """
+        experts: object = self.experts
+        base_experts = getattr(experts, "base_layer", None)
+        if base_experts is not None:
+            is_lora_active = getattr(experts, "is_lora_active", None)
+            if not callable(is_lora_active) or is_lora_active():
+                return None
+            experts = base_experts
