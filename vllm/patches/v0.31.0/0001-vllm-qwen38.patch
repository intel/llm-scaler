+                and owner.ngram_heads == _QWEN38_HEADS
+                and owner.head_dim == _QWEN38_HEAD_DIM
+                and owner.embedding_dim == _QWEN38_EMBED_DIM
+                and owner.split_ngram_parts == 128
+                and self._buffer_values(owner.layer_multipliers) == _QWEN38_MULTIPLIERS
+                and self._buffer_values(owner.ngram_heads_vocab_sizes)
+                == _QWEN38_VOCAB_SIZES
+                and self._buffer_values(owner.ngram_heads_offsets) == _QWEN38_OFFSETS
+                and _QWEN38_OFFSETS[-1] + _QWEN38_VOCAB_SIZES[-1]
+                == _QWEN38_GENERATED_VOCAB_SIZE
+                and tp_size in (4, 8)
+                and embedding.embedding_dim == _QWEN38_HEAD_DIM
+                and embedding.padding_size == 128
+                and embedding.num_embeddings == _QWEN38_PADDED_VOCAB_SIZE
+                and embedding.org_vocab_size == _QWEN38_PADDED_VOCAB_SIZE
+                and embedding.num_embeddings_padded == _QWEN38_PADDED_VOCAB_SIZE
+                and embedding.num_embeddings_per_partition == local_rows
+                and local_start in valid_starts
+                and local_end == local_start + local_rows
+                and shard_indices.padded_org_vocab_start_index == local_start
+                and shard_indices.padded_org_vocab_end_index == local_end
+                and shard_indices.num_org_vocab_padding == 0
+                and shard_indices.num_added_elements == 0
+                and shard_indices.num_added_elements_padded == 0
+                and self._buffer_values(owner._esimd_local_vocab_start)
+                == (local_start,)
