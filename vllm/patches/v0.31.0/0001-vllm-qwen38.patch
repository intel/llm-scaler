+
+def _try_esimd_gdn_workspace(
+    layer: Any, hidden_states: torch.Tensor, *, speculative: bool
+) -> torch.Tensor | None:
+    """Try one native host transaction before any legacy projection runs.
+
+    Only metadata/layer semantics and direct-tensor dispatch are checked here.
+    Native preflight checks every live tensor's layout, alias and current stream
+    before submitting. Sources are reread each call; the workspace owns only
+    stream-local scratch and version-checked conversions, invalidated on reload.
+    A native miss is pre-submit; all execution and reduce errors propagate.
+    """
+    disable_env = (
+        "VLLM_XPU_DISABLE_ESIMD_GDN_SPEC_WORKSPACE"
+        if speculative
+        else "VLLM_XPU_DISABLE_ESIMD_GDN_M1_WORKSPACE"
+    )
+    if (
+        os.environ.get(disable_env, "0") == "1"
+        or _gdn_projection_disabled()
+        or _int4_esimd_disabled()
+        or not using_qwen38_sycl()
+        or torch.compiler.is_compiling()
+        or torch.is_grad_enabled()
+    ):
+        return None
+    if speculative and (
+        _SPEC_GDN_DISABLED
+        or os.environ.get("DISABLE_ESIMD_INT4_GEMM", "0") == "1"
+        or os.environ.get("DISABLE_GEMMA4_INT4_BATCH_ESIMD", "0") == "1"
+    ):
+        return None
+    factory = (
+        _gdn_spec_workspace_factory() if speculative else _gdn_m1_workspace_factory()
+    )
+    if factory is None:
+        return None
+    metadata = _metadata_for_layer(layer)
+    if metadata is None:
+        return None  # Profile can precede KV binding.
+    try:
+        m = int(metadata.num_actual_tokens)
+        if int(metadata.num_prefills) != 0 or int(metadata.num_prefill_tokens) != 0:
+            return None
+        if speculative:
+            if not (
+                int(metadata.num_decodes) == int(metadata.num_decode_tokens) == 0
+                and int(metadata.num_spec_decodes) == 1
+                and int(metadata.num_spec_decode_tokens) == m
+                and 2 <= m <= 8
+                and metadata.spec_sequence_masks is not None
+            ):
+                return None
+        elif not (
+            int(metadata.num_decodes) == int(metadata.num_decode_tokens) == m == 1
+            and int(metadata.num_spec_decodes)
+            == int(metadata.num_spec_decode_tokens)
+            == 0
+            and metadata.spec_sequence_masks is None
+        ):
+            return None
+        tp = int(layer.tp_size)
+        if tp not in (4, 8):
+            return None
+        hv = 12 if tp == 4 else 6
+        if not (
+            int(layer.num_k_heads) == tp * (hv // 3)
+            and int(layer.num_v_heads) == tp * hv
+            and int(layer.head_k_dim) == int(layer.head_v_dim) == 128
+            and int(layer.conv_kernel_size) == 4
+            and str(layer.activation).lower() in {"silu", "swish"}
+            and layer.gqa_interleaved_layout is False
+            and not is_conv_state_dim_first()
+        ):
+            return None
+    except (AttributeError, TypeError, ValueError):
+        return None
+
+    kv_cache = layer.kv_cache  # Real decode metadata without binding is a hard error.
+    try:
+        conv_state, ssm_state = kv_cache
+        projections: tuple[Any, ...] = tuple(
+            _get_base_layer_for_no_lora(p)
+            for p in (layer.in_proj_qkvz, layer.in_proj_ba, layer.out_proj)
+        )
+        if any(
+            p is None
+            or not _is_unadapted_linear(p)
+            or getattr(getattr(p, "quant_method", None), "is_sym_int4", False)
+            is not True
+            or getattr(p, "bias", None) is not None
+            or getattr(p, "gather_output", False)
+            for p in projections
+        ):
+            return None
+        if speculative:
+            from vllm.model_executor.layers.linear import (
+                ColumnParallelLinear,
+                MergedColumnParallelLinear,
+                RowParallelLinear,
+            )
+            from vllm.model_executor.layers.quantization.sym_int4 import (
+                SymInt4LinearMethod,
+            )
+
+            for index, p in enumerate(projections):
+                if (
+                    type(p)
+                    not in (
+                        ColumnParallelLinear,
+                        MergedColumnParallelLinear,
+                        RowParallelLinear,
+                    )
+                    or "forward" in p.__dict__
+                    or type(p.quant_method) is not SymInt4LinearMethod
+                    or not getattr(p, "_sym_int4_allow_batch_esimd", False)
+                    or getattr(p, "_int4_in_features_padded", None)
+                    != (2560 if index < 2 else hv * 128)
+                    or (index == 2 and not getattr(p, "input_is_parallel", False))
+                ):
+                    return None
+        norm = layer.norm
+        activation = str(norm.activation).lower()
+        if (
+            norm.group_size is not None
+            or not norm.norm_before_gate
+            or getattr(norm, "bias", None) is not None
+            or activation not in {"silu", "swish", "sigmoid"}
+        ):
+            return None
+        weights = [
+            value for p in projections for value in (p.weight_esimd, p.scale_esimd)
+        ]
+        conv = layer.conv1d
+        weights.extend((conv.weight, layer.A_log, layer.dt_bias, norm.weight))
+        conv_bias = conv.bias
+        indices = (
+            metadata.spec_state_indices_tensor
+            if speculative
+            else metadata.non_spec_state_indices_tensor
+        )
+        spec_inputs = (
+            (metadata.spec_token_indx, metadata.num_accepted_tokens)
+            if speculative
+            else ()
+        )
+        eps = float(norm.eps)
+        reduce_results = tp > 1 and projections[2].reduce_results
+    except (AttributeError, IndexError, TypeError, ValueError):
+        return None
+    if any(
+        not isinstance(t, torch.Tensor)
+        for t in (*weights, conv_state, ssm_state, indices, *spec_inputs)
+    ):
+        return None
+    if conv_bias is not None and not isinstance(conv_bias, torch.Tensor):
+        return None
+    if not _direct_parameters(
+        hidden_states, *weights, conv_bias, conv_state, ssm_state, indices, *spec_inputs
+    ):
+        return None
+    if speculative and activation == "sigmoid" and norm.weight.dtype != torch.float16:
+        # The previous sigmoid path uses the original norm weight in Triton,
+        # unlike the legacy SiLU adapter's explicit half conversion. Do not
+        # silently introduce a new rounding boundary for non-FP16 weights.
+        return None
+    if not (
+        _is_xpu_tensor(hidden_states)
+        and hidden_states.ndim == 2
+        and hidden_states.shape == (m, 2560)
+    ):
+        return None
+
+    workspace_attr = (
+        "_esimd_gdn_spec_workspace" if speculative else "_esimd_gdn_m1_workspace"
+    )
+    workspace = getattr(layer, workspace_attr, None)
+    if workspace is None:
+        workspace = factory()
+        if not callable(getattr(workspace, "try_run", None)) or not callable(
+            getattr(workspace, "invalidate", None)
+        ):
+            raise RuntimeError("Invalid GDN workspace methods")
+        setattr(layer, workspace_attr, workspace)
+    # Do not catch: native may have submitted conversions or state updates.
+    output = workspace.try_run(
+        hidden_states,
+        weights,
+        conv_bias,
+        conv_state,
+        ssm_state,
+        indices,
+        *spec_inputs,
+        hv,
+        eps,
+        activation == "sigmoid",
+    )
+    if output is None:
+        return None
+    if not isinstance(output, torch.Tensor):
+        raise RuntimeError("GDN workspace.try_run must return Tensor or None")
+    if reduce_results:
+        from vllm.distributed import tensor_model_parallel_all_reduce
+        from vllm.models.qwen4_exp.xpu.collectives import full_decode_all_reduce
+
+        # native workspace 已验证输出与所有输入分离；未归约值无其他消费者。
+        output = full_decode_all_reduce(
+            output, fallback=tensor_model_parallel_all_reduce
+        )
+    return output
+
+
+def _fp8_linear_parts(
+    layer: object,
+    input: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor, tuple[int, int] | None] | None:
+    weight = getattr(layer, "weight", None)
+    scale = getattr(layer, "weight_scale", None)
+    block_scale = getattr(layer, "weight_scale_inv", None)
+    block_size = tuple(getattr(layer, "weight_block_size", ()) or ())
+    scalar_scale_ready = (
+        isinstance(scale, torch.Tensor)
+        and _is_contiguous_tensor(scale)
+        and scale.numel() == 1
+        and scale.dtype == torch.float32
+    )
+    block_scale_ready = (
+        isinstance(block_scale, torch.Tensor)
+        and _is_contiguous_tensor(block_scale, dtype=torch.float32, ndim=2)
+        and block_size == (128, 128)
+        and isinstance(weight, torch.Tensor)
+        and tuple(block_scale.shape)
+        == (
+            (weight.shape[0] + block_size[0] - 1) // block_size[0],
+            (weight.shape[1] + block_size[1] - 1) // block_size[1],
+        )
+    )
+    selected_scale = block_scale if block_scale_ready else scale
+    if not isinstance(weight, torch.Tensor) or not isinstance(
+        selected_scale, torch.Tensor
+    ):
+        return None
+    if not (
+        _is_unadapted_linear(layer)
+        and getattr(layer, "bias", None) is None
+        and not getattr(layer, "gather_output", False)
+        and _is_contiguous_tensor(weight, ndim=2)
+        and weight.dtype in (torch.float8_e4m3fn, torch.float8_e5m2)
+        and (scalar_scale_ready or block_scale_ready)
+        and weight.device == input.device
+        and selected_scale.device == input.device
+        and weight.shape[1] == input.shape[1]
+    ):
+        return None
+    if block_scale_ready and isinstance(block_scale, torch.Tensor):
+        return weight, block_scale, (128, 128)
+    if not isinstance(scale, torch.Tensor):
+        return None
+    return weight, scale, None
+
+
+def _int4_linear_parts(
+    layer: object,
+    input: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    quant_method = getattr(layer, "quant_method", None)
+    weight = getattr(layer, "weight_esimd", None)
+    scale = getattr(layer, "scale_esimd", None)
+    if not (
+        not _int4_esimd_disabled()
+        and _is_unadapted_linear(layer)
+        and getattr(quant_method, "is_sym_int4", False)
+        and getattr(layer, "bias", None) is None
+        and not getattr(layer, "gather_output", False)
+        and _is_contiguous_tensor(weight, dtype=torch.uint8, ndim=2)
+        and _is_contiguous_tensor(scale, dtype=torch.float16, ndim=2)
+        and weight.device == input.device
+        and scale.device == input.device
+        and weight.shape[1] * 2 == input.shape[1]
+        and scale.shape[0] == weight.shape[0]
+        and scale.shape[1] == input.shape[1] // 128
+    ):
+        return None
+    return weight.view(torch.int32), scale
+
+
+def _fp16_linear_weight(layer: object, input: torch.Tensor) -> torch.Tensor | None:
+    weight = getattr(layer, "weight", None)
+    if not (
+        _is_unadapted_linear(layer)
+        and getattr(layer, "bias", None) is None
+        and not getattr(layer, "gather_output", False)
+        and isinstance(weight, torch.Tensor)
+        and _is_contiguous_tensor(weight, dtype=torch.float16, ndim=2)
+        and weight.device == input.device
+        and weight.shape[1] == input.shape[1]
+    ):
+        return None
+    return weight
+
+
+def try_esimd_gdn_input_projections(
+    hidden_states: torch.Tensor,
+    qkvz_proj: Any,
+    ba_proj: Any,
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    """Fuse the two scalar-scale FP8 GDN input projections for M=1 decode."""
+    qkvz_proj = _get_base_layer_for_no_lora(qkvz_proj)
+    ba_proj = _get_base_layer_for_no_lora(ba_proj)
+    if qkvz_proj is None or ba_proj is None:
+        return None
+    if getattr(getattr(qkvz_proj, "quant_method", None), "is_sym_int4", False):
+        return None
+    if not isinstance(getattr(qkvz_proj, "weight", None), torch.Tensor):
+        return None  # INT4 has no FP8 weight; do not bind the unused FP8 scope.
+    if any(getattr(p, "gather_output", False) for p in (qkvz_proj, ba_proj)):
+        return None
+    if not _bind_live_parameters(
+        qkvz_proj,
+        (hidden_states,),
+        (qkvz_proj, ba_proj),
+        ("_esimd_gdn_input_plan", "_esimd_gdn_input_buffers"),
+    ):
+        return None
+    if _int4_esimd_disabled() and any(
+        getattr(getattr(p, "quant_method", None), "is_sym_int4", False)
+        for p in (qkvz_proj, ba_proj)
+    ):
+        return None
+    plan = getattr(qkvz_proj, "_esimd_gdn_input_plan", None)
+    if not isinstance(plan, _GdnInputPlan):
+        plan = None
+    if hidden_states.ndim != 2 or hidden_states.shape[0] != 1:
+        return None
+
+    if plan is None:
+        if (
+            _gdn_projection_disabled()
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not _is_contiguous_tensor(hidden_states, dtype=torch.float16, ndim=2)
+        ):
+            return None
+        qkvz_parts = _fp8_linear_parts(qkvz_proj, hidden_states)
+        ba_parts = _fp8_linear_parts(ba_proj, hidden_states)
+        ba_fp16_weight = (
+            None
+            if ba_parts is not None
+            else _fp16_linear_weight(ba_proj, hidden_states)
+        )
+        if qkvz_parts is None or (ba_parts is None and ba_fp16_weight is None):
+            return None
+
+        try:
+            module = _load_esimd_module()
+        except (ImportError, OSError, AttributeError, RuntimeError):
+            return None
+        qkvz_weight, qkvz_scale, qkvz_block_size = qkvz_parts
+        if ba_parts is not None:
+            ba_weight, ba_scale, ba_block_size = ba_parts
+        else:
+            ba_weight, ba_scale, ba_block_size = ba_fp16_weight, None, None
+        if qkvz_block_size is None and ba_block_size is None:
+            op_name = "esimd_gemv_fp8_pert_fused2"
+        elif qkvz_block_size == (128, 128) and ba_block_size == (128, 128):
+            op_name = "esimd_gemv_fp8_blockscale_fused2"
+        elif qkvz_block_size == (128, 128) and ba_fp16_weight is not None:
+            op_name = "esimd_gemv_fp8_blockscale_fp16_fused2"
+        else:
+            return None
+        op = getattr(module, op_name, None)
+        if not callable(op):
+            return None
+
+        qkvz = torch.empty(
+            (1, qkvz_weight.shape[0]),
+            dtype=torch.float16,
+            device=hidden_states.device,
+        )
+        ba = torch.empty(
+            (1, ba_weight.shape[0]),
+            dtype=torch.float16,
+            device=hidden_states.device,
+        )
+        qkvz_proj._esimd_gdn_input_buffers = qkvz, ba
+        plan = _GdnInputPlan(
+            op=op,
+            qkvz_weight=qkvz_weight,
+            qkvz_scale=qkvz_scale,
+            qkvz=qkvz,
+            ba_weight=ba_weight,
+            ba_scale=ba_scale,
+            ba=ba,
+            block_size=qkvz_block_size,
+            ba_is_fp16=ba_fp16_weight is not None,
+        )
+        qkvz_proj._esimd_gdn_input_plan = plan
+
+    if not _disjoint_writes(
+        (plan.qkvz, plan.ba),
+        (
+            hidden_states,
+            plan.qkvz_weight,
+            plan.qkvz_scale,
+            plan.ba_weight,
+            plan.ba_scale,
+        ),
+    ):
+        return None
+    if plan.block_size is None:
+        plan.op(
+            hidden_states,
+            plan.qkvz_weight,
+            plan.qkvz_scale,
+            plan.qkvz,
+            plan.ba_weight,
+            plan.ba_scale,
+            plan.ba,
+        )
+    elif plan.ba_is_fp16:
+        plan.op(
+            hidden_states,
+            plan.qkvz_weight,
+            plan.qkvz_scale,
+            plan.qkvz,
+            plan.ba_weight,
+            plan.ba,
+            plan.block_size[0],
+            plan.block_size[1],
+        )
+    else:
+        plan.op(
+            hidden_states,
+            plan.qkvz_weight,
+            plan.qkvz_scale,
+            plan.qkvz,
+            plan.ba_weight,
+            plan.ba_scale,
+            plan.ba,
+            plan.block_size[0],
+            plan.block_size[1],
+        )
+    return plan.qkvz, plan.ba
+
+
+def try_esimd_gdn_fp16_ba_projection(
+    hidden_states: torch.Tensor,
+    qkvz_proj: Any,
+    ba_proj: Any,
+) -> torch.Tensor | None:
+    """Use the exact FP16 a/b weight with ESIMD for 2..8-token decode.
+
+    Offline block checkpoints keep ``in_proj_ba`` in FP16 while qkvz is block
+    FP8. The M=1 pair is handled by the fused2 kernel above; this helper avoids
+    oneDNN setup for the small batched FP16 projection.
+    """
+    qkvz_proj = _get_base_layer_for_no_lora(qkvz_proj)
+    ba_proj = _get_base_layer_for_no_lora(ba_proj)
+    if qkvz_proj is None or ba_proj is None:
+        return None
+    rows = hidden_states.shape[0] if hidden_states.ndim == 2 else 0
+    if not 2 <= rows <= 8:
+        return None
+    if not _bind_live_parameters(
+        ba_proj,
+        (hidden_states,),
+        (qkvz_proj, ba_proj),
+        ("_esimd_gdn_ba_op", "_esimd_gdn_ba_buffers"),
+    ):
+        return None
+    if (
+        _gdn_projection_disabled()
+        or getattr(torch.compiler, "is_compiling", lambda: False)()
+        or not _is_contiguous_tensor(hidden_states, dtype=torch.float16, ndim=2)
+        or _fp8_linear_parts(qkvz_proj, hidden_states) is None
+    ):
+        return None
+    qkvz_scale = getattr(qkvz_proj, "weight_scale_inv", None)
+    if qkvz_scale is None:
+        return None
+    weight = _fp16_linear_weight(ba_proj, hidden_states)
+    if weight is None:
+        return None
+    op = getattr(ba_proj, "_esimd_gdn_ba_op", None)
+    if op is None:
+        try:
+            module = _load_esimd_module()
+        except (ImportError, OSError, AttributeError, RuntimeError):
+            return None
+        op = getattr(module, "esimd_gemv_fp16", None)
+        if not callable(op):
+            return None
+        ba_proj._esimd_gdn_ba_op = op
+    buffers = getattr(ba_proj, "_esimd_gdn_ba_buffers", None)
+    if buffers is None:
+        buffers = {}
+        ba_proj._esimd_gdn_ba_buffers = buffers
+    output = buffers.get(rows)
+    if output is None:
+        output = torch.empty(
+            rows, weight.shape[0], dtype=torch.float16, device=hidden_states.device
+        )
+        buffers[rows] = output
+    op(hidden_states, weight, output)
+    return output
+
+
+def try_esimd_gdn_int4_input_projections(
+    hidden_states: torch.Tensor, qkvz_proj: Any, ba_proj: Any
+) -> tuple[torch.Tensor, torch.Tensor] | None:
+    from vllm.model_executor.layers.quantization._sym_int4_esimd import (
+        _ESIMD_INT4_ADAPTER,
+    )
+
+    qkvz_proj = _get_base_layer_for_no_lora(qkvz_proj)
+    ba_proj = _get_base_layer_for_no_lora(ba_proj)
+    if qkvz_proj is None or ba_proj is None or _int4_esimd_disabled():
+        return None
+    if any(
+        not _is_unadapted_linear(projection)
+        or not getattr(getattr(projection, "quant_method", None), "is_sym_int4", False)
+        or getattr(projection, "bias", None) is not None
+        or getattr(projection, "gather_output", False)
+        for projection in (qkvz_proj, ba_proj)
+    ):
+        return None
+    if not _bind_live_parameters(
+        qkvz_proj,
+        (hidden_states,),
+        (qkvz_proj, ba_proj),
+        ("_esimd_gdn_int4_input_buffers",),
+        parameter_names=(
+            ("weight_esimd", "scale_esimd", "bias"),
+            ("weight_esimd", "scale_esimd", "bias"),
+        ),
+        input_matrix_rows=1,
+    ):
+        return None
+    w0, s0 = (
+        getattr(qkvz_proj, "weight_esimd", None),
+        getattr(qkvz_proj, "scale_esimd", None),
+    )
+    w1, s1 = (
+        getattr(ba_proj, "weight_esimd", None),
+        getattr(ba_proj, "scale_esimd", None),
+    )
+    if any(not isinstance(t, torch.Tensor) or t.ndim != 2 for t in (w0, s0, w1, s1)):
+        return None
+    # try_fused2 owns the full live dtype/device/layout eligibility check.
+    # Do not build unused int32 weight views via _int4_linear_parts here.
+    buffers = getattr(qkvz_proj, "_esimd_gdn_int4_input_buffers", None)
+    if buffers is None:
+        buffers = (
+            hidden_states.new_empty((1, cast(torch.Tensor, w0).shape[0])),
+            hidden_states.new_empty((1, cast(torch.Tensor, w1).shape[0])),
+        )
+        qkvz_proj._esimd_gdn_int4_input_buffers = buffers
+    if not _disjoint_writes(
+        buffers,
+        (
+            hidden_states,
+            w0,
+            s0,
+            w1,
+            s1,
+        ),
+    ):
+        return None
+    return _ESIMD_INT4_ADAPTER.try_fused2(
+        hidden_states,
+        w0,
+        s0,
+        w1,
+        s1,
+        output0=buffers[0],
+        output1=buffers[1],
+    )
+
+
+def try_esimd_gdn_output_projection(
+    layer: Any,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+) -> torch.Tensor | None:
+    """Fuse gated RMSNorm and FP8 or symmetric INT4 out projection for M=1."""
+    # MTP verify uses the batched norm/projection below. Do not bind/cache
+    # M1-only weights for a plain tensor that cannot enter this path. Keep
+    # subclass and mode eligibility in the existing preflight.
+    if type(core_attn_out) is torch.Tensor and (
+        core_attn_out.ndim != 3 or core_attn_out.shape[0] != 1
+    ):
+        return None
+    base_out_proj = _get_base_layer_for_no_lora(layer.out_proj)
+    if base_out_proj is None:
+        return None
+    is_int4 = (
+        getattr(getattr(base_out_proj, "quant_method", None), "is_sym_int4", False)
+        is True
+    )
+    projection_names = (
+        ("weight_esimd", "scale_esimd", "bias")
+        if is_int4
+        else (
+            "weight",
+            "bias",
+            "weight_scale",
+            "weight_scale_inv",
+            "weight_esimd",
+            "scale_esimd",
+        )
+    )
+    if not _bind_live_parameters(
+        layer,
+        (core_attn_out, z),
+        (base_out_proj, layer.norm),
+        (
+            "_esimd_gdn_output_plan",
+            "_esimd_gdn_output_buffer",
+            "_esimd_gdn_norm_weight_fp16",
+        ),
+        parameter_names=(projection_names, ("weight", "bias")),
+    ):
+        return None
+    if _int4_esimd_disabled() and getattr(
+        getattr(base_out_proj, "quant_method", None), "is_sym_int4", False
+    ):
+        return None
+    plan = getattr(layer, "_esimd_gdn_output_plan", None)
+    if not isinstance(plan, _GdnOutputPlan) or plan.is_sym_int4 != is_int4:
+        plan = None
+    if (
+        core_attn_out.ndim != 3
+        or z.ndim != 3
+        or core_attn_out.shape != z.shape
+        or core_attn_out.shape[0] != 1
+    ):
+        return None
+
+    activation = str(layer.norm.activation).lower()
+    if (
+        layer.norm.group_size is not None
+        or not layer.norm.norm_before_gate
+        or getattr(layer.norm, "bias", None) is not None
+        or getattr(base_out_proj, "gather_output", False)
+        or getattr(base_out_proj, "bias", None) is not None
+    ):
+        return None
+    if plan is None:
+        if (
+            _gdn_projection_disabled()
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not _is_contiguous_tensor(core_attn_out, dtype=torch.float16, ndim=3)
+            or not _is_contiguous_tensor(z, dtype=torch.float16, ndim=3)
+        ):
+            return None
+        norm = layer.norm
+        out_proj = base_out_proj
+        flattened = core_attn_out.flatten(1)
+        fp8_parts = _fp8_linear_parts(out_proj, flattened)
+        int4_parts = (
+            None if fp8_parts is not None else _int4_linear_parts(out_proj, flattened)
+        )
+        if fp8_parts is not None:
+            if activation not in {"silu", "swish"}:
+                return None
+        elif int4_parts is not None:
+            if activation not in {"silu", "swish", "sigmoid"}:
+                return None
+        else:
+            return None
+        if norm.group_size is not None or not norm.norm_before_gate:
+            return None
+
+        local_heads = int(layer.num_v_heads) // int(layer.tp_size)
+        head_dim = int(layer.head_v_dim)
+        if core_attn_out.shape[1:] != (local_heads, head_dim):
+            return None
+
+        if (
+            int4_parts is not None
+            and using_qwen38_sycl()
+            and (local_heads not in (6, 12) or head_dim != 128)
+        ):
+            return None
+
+        if fp8_parts is not None:
+            try:
+                module = _load_esimd_module()
+            except (ImportError, OSError, AttributeError, RuntimeError):
+                return None
+            weight, scale, block_size = fp8_parts
+            op_name = (
+                "esimd_norm_gemv_fp8_blockscale"
+                if block_size is not None
+                else "esimd_norm_gemv_fp8_pert"
+            )
+            op = getattr(module, op_name, None)
+            if not callable(op):
+                return None
+        else:
+            assert int4_parts is not None
+            weight, scale = int4_parts
+            block_size = None
+            if activation == "sigmoid":
+                try:
+                    op = get_gdn_int4_sigmoid_op()
+                except GdnInt4SigmoidOpUnavailableError:
+                    return None
+            else:
+                try:
+                    module = _load_esimd_module()
+                except (ImportError, OSError, AttributeError, RuntimeError):
+                    return None
+                op = getattr(module, "esimd_norm_gemv_int4_pert", None)
+                if not callable(op):
+                    return None
+
+        norm_weight_fp16 = norm.weight.detach().to(dtype=torch.float16).contiguous()
+        if not (
+            _is_contiguous_tensor(norm_weight_fp16, dtype=torch.float16, ndim=1)
+            and norm_weight_fp16.shape == (head_dim,)
+            and norm_weight_fp16.device == core_attn_out.device
+        ):
+            return None
+        layer._esimd_gdn_norm_weight_fp16 = norm_weight_fp16
+
+        output = torch.empty(
+            (1, weight.shape[0]), dtype=torch.float16, device=core_attn_out.device
+        )
+        layer._esimd_gdn_output_buffer = output
+        plan = _GdnOutputPlan(
+            op=op,
+            activation=activation,
+            norm_weight=norm_weight_fp16,
+            weight=weight,
+            scale=scale,
+            output=output,
+            local_heads=local_heads,
+            head_dim=head_dim,
+            eps=norm.eps,
+            reduce_results=int(layer.tp_size) > 1 and out_proj.reduce_results,
+            block_size=block_size,
+            is_sym_int4=is_int4,
+        )
+        layer._esimd_gdn_output_plan = plan
+    elif (
+        core_attn_out.shape[1:] != (plan.local_heads, plan.head_dim)
+        or activation != plan.activation
+    ):
+        return None
+
+    if not _disjoint_writes(
+        (plan.output,), (core_attn_out, z, plan.weight, plan.scale, plan.norm_weight)
+    ):
+        return None
+    plan.op(
+        core_attn_out.view(plan.local_heads, plan.head_dim),
+        z.view(plan.local_heads, plan.head_dim),
+        plan.norm_weight,
+        plan.weight,
+        plan.scale,
+        plan.output,
+        plan.local_heads,
+        plan.head_dim,
+        plan.eps,
+    )
+
+    output = plan.output
+    if plan.reduce_results:
+        from vllm.distributed import tensor_model_parallel_all_reduce
+
+        output = tensor_model_parallel_all_reduce(output)
+    return output
+
+
+def try_esimd_gdn_output_norm_batched(
+    layer: Any,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+) -> torch.Tensor | None:
+    """Replace RMSNormGated (Triton layer_norm_fwd) with the ESIMD gated
+    RMSNorm for the 2 <= M <= 128 pure-decode batch, matching v0.21.0.
+
+    Only the norm is fused here (unlike ``try_esimd_gdn_output_projection``,
+    which fuses norm + FP8 GEMV for the M==1 tail): out_proj for M>1 runs a
+    regular GEMM and already hits its own scaled_mm fast path, so there is
+    nothing to gain from fusing it into this kernel. Caller still reshapes
+    the result and calls ``layer.out_proj`` itself.
+    """
+    if not _bind_live_parameters(
+        layer,
+        (core_attn_out, z),
+        (layer.norm,),
+        ("_esimd_gdn_output_norm_plan", "_esimd_gdn_output_norm_weight_fp16"),
+        parameter_names=(("weight", "bias"),),
+    ):
+        return None
+    plan = getattr(layer, "_esimd_gdn_output_norm_plan", None)
+    if (
+        str(layer.norm.activation).lower() not in {"silu", "swish"}
+        or layer.norm.group_size is not None
+        or not layer.norm.norm_before_gate
+        or getattr(layer.norm, "bias", None) is not None
+    ):
+        return None
+    if not isinstance(plan, _GdnOutputNormPlan):
+        plan = None
+    if (
+        core_attn_out.ndim != 3
+        or z.ndim != 3
+        or core_attn_out.shape != z.shape
+        or not (2 <= core_attn_out.shape[0] <= _MAX_DECODE_BATCH)
+        or (using_qwen38_sycl() and core_attn_out.shape[2] != _HEAD_DIM)
+    ):
+        return None
+
+    if plan is None:
+        if (
+            _gdn_projection_disabled()
+            or getattr(torch.compiler, "is_compiling", lambda: False)()
+            or not _is_contiguous_tensor(core_attn_out, dtype=torch.float16, ndim=3)
+            or not _is_contiguous_tensor(z, dtype=torch.float16, ndim=3)
+        ):
+            return None
+        norm = layer.norm
+        if (
+            str(norm.activation).lower() not in {"silu", "swish"}
+            or norm.group_size is not None
+            or not norm.norm_before_gate
+        ):
+            return None
+
+        local_heads = int(layer.num_v_heads) // int(layer.tp_size)
+        head_dim = int(layer.head_v_dim)
+        if core_attn_out.shape[1:] != (local_heads, head_dim):
+            return None
+
+        try:
+            module = _load_esimd_module()
+        except (ImportError, OSError, AttributeError, RuntimeError):
+            return None
+        op = getattr(module, "esimd_rms_norm_gated", None)
+        if not callable(op):
+            return None
+
+        # Private contiguous fp16 copy: the norm weight is stored fp32 and
+        # the XPU caching allocator may otherwise reuse a shared half()
+        # result mid-run, matching the v0.21.0 comment/workaround.
+        norm_weight_fp16 = norm.weight.detach().to(dtype=torch.float16).contiguous()
+        if not (
+            _is_contiguous_tensor(norm_weight_fp16, dtype=torch.float16, ndim=1)
+            and norm_weight_fp16.shape == (head_dim,)
+            and norm_weight_fp16.device == core_attn_out.device
+        ):
+            return None
+        layer._esimd_gdn_output_norm_weight_fp16 = norm_weight_fp16
+
+        plan = _GdnOutputNormPlan(
+            op=op,
+            norm_weight=norm_weight_fp16,
+            local_heads=local_heads,
+            head_dim=head_dim,
+            eps=norm.eps,
+        )
+        layer._esimd_gdn_output_norm_plan = plan
+    elif core_attn_out.shape[1:] != (plan.local_heads, plan.head_dim):
+        return None
+
+    # RMSNormGated normalizes per head over head_v_dim (the norm weight is
+    # [head_v_dim], not [local_heads*head_dim]); flatten to
+    # [M*local_heads, head_dim] so each row is one head, matching the M==1
+    # fused tail, then reshape to [M, local_heads*head_dim] for out_proj.
+    num_tokens = core_attn_out.shape[0]
+    x_rows = core_attn_out.reshape(num_tokens * plan.local_heads, plan.head_dim)
+    z_rows = z.reshape(num_tokens * plan.local_heads, plan.head_dim)
+    normed_rows = torch.empty_like(x_rows)
+    plan.op(x_rows, z_rows, plan.norm_weight, normed_rows, plan.eps)
+    return normed_rows.reshape(num_tokens, plan.local_heads * plan.head_dim)
+
+
+def _metadata_for_layer(layer: Any):
+    try:
+        metadata = get_forward_context().attn_metadata
+        if not isinstance(metadata, dict):
+            return None
+        return metadata.get(layer.prefix)
+    except (AttributeError, TypeError):
+        return None
+
+
+def _is_contiguous_tensor(
+    value: object,
+    *,
+    dtype: torch.dtype | None = None,
+    ndim: int | None = None,
+) -> TypeGuard[torch.Tensor]:
+    if not isinstance(value, torch.Tensor) or not _is_xpu_tensor(value):
+        return False
+    if not _direct_parameters(value):
+        return False
+    if dtype is not None and value.dtype != dtype:
+        return False
+    if ndim is not None and value.ndim != ndim:
+        return False
+    return value.is_contiguous()
+
+
+def _core_geometry_signature(layer):
+    return (
+        layer.tp_size,
+        layer.num_k_heads,
+        layer.num_v_heads,
+        layer.head_k_dim,
+        layer.head_v_dim,
+        layer.conv_kernel_size,
+        str(layer.activation).lower(),
+        layer.gqa_interleaved_layout,
+        is_conv_state_dim_first(),
+    )
+
+
+def _state_layout_signature(states):
+    # State contents change each step. Cache only their live layout, never
+    # version/pointer ownership; alias checks still run before every submit.
+    return tuple((t.device, t.dtype, tuple(t.shape), tuple(t.stride())) for t in states)
+
+
+def _cached_decode_guard(
+    layer: Any,
+    plan: _GdnCoreGuardPlan,
+    projected_qkvz: torch.Tensor,
+    projected_ba: torch.Tensor,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+    *,
+    sources: _GdnDecodeSources,
+):
+    metadata = sources.metadata
+    if metadata is None:
+        return None
+    try:
+        num_decodes = int(metadata.num_decodes)
+        if not (
+            int(metadata.num_prefills) == 0
+            and int(metadata.num_prefill_tokens) == 0
+            and int(metadata.num_spec_decodes) == 0
+            and int(metadata.num_spec_decode_tokens) == 0
+            and num_decodes
+            == int(metadata.num_decode_tokens)
+            == int(metadata.num_actual_tokens)
+            and 0 < num_decodes <= _MAX_DECODE_BATCH
+            and metadata.spec_sequence_masks is None
+        ):
+            return None
+
+        expected_output_shape = (
+            num_decodes,
+            plan.local_v_heads,
+            plan.head_v_dim,
+        )
+        if not (
+            projected_qkvz.shape == (num_decodes, plan.qkvz_dim)
+            and projected_ba.shape == (num_decodes, plan.ba_dim)
+            and core_attn_out.shape == expected_output_shape
+            and z.shape == expected_output_shape
+        ):
+            return None
+
+        state_indices = metadata.non_spec_state_indices_tensor
+        if not (
+            _is_contiguous_tensor(state_indices, dtype=torch.int32, ndim=1)
+            and state_indices.numel() >= num_decodes
+        ):
+            return None
+
+        conv_state, ssm_state = sources.kv_cache
+        device = conv_state.device
+        if state_indices.device != device or any(
+            t.device != device for t in (projected_qkvz, projected_ba, core_attn_out, z)
+        ):
+            return None
+        if state_indices.device.type == "cpu":
+            selected_indices = state_indices[:num_decodes]
+            if bool((selected_indices < 0).any()) or bool(
+                (selected_indices >= min(conv_state.shape[0], ssm_state.shape[0])).any()
+            ):
+                return None
+        conv_weight = sources.conv_weight
+        conv_bias = sources.conv_bias
+    except (AttributeError, IndexError, TypeError, ValueError):
+        return None
+
+    return (
+        plan.op,
+        metadata,
+        state_indices[:num_decodes],
+        conv_state,
+        ssm_state,
+        conv_weight,
+        conv_bias,
+        num_decodes,
+        plan.local_k_heads,
+        plan.local_v_heads,
+        plan.head_k_dim,
+        plan.head_v_dim,
+    )
+
+
+def _decode_guard(
+    layer: Any,
+    projected_qkvz: torch.Tensor,
+    projected_ba: torch.Tensor,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+    *,
+    sources: _GdnDecodeSources | None = None,
+):
+    """Return validated decode metadata, dimensions, and state tensors."""
+    if sources is None:
+        metadata = _metadata_for_layer(layer)
+        if metadata is None:
+            return None
+        try:
+            conv = layer.conv1d
+            sources = _GdnDecodeSources(
+                metadata,
+                layer.kv_cache,
+                conv.weight,
+                conv.bias,
+                layer.A_log,
+                layer.dt_bias,
+            )
+        except (AttributeError, TypeError):
+            return None
+    metadata = sources.metadata
+    if metadata is None:
+        return None
+    plan = getattr(layer, "_esimd_gdn_core_guard_plan", None)
+    if isinstance(plan, _GdnCoreGuardPlan):
+        try:
+            same_binding = plan.geometry == _core_geometry_signature(
+                layer
+            ) and plan.state_layouts == _state_layout_signature(sources.kv_cache)
+        except (AttributeError, TypeError, ValueError):
+            same_binding = False
+        if same_binding:
+            return _cached_decode_guard(
+                layer,
+                plan,
+                projected_qkvz,
+                projected_ba,
+                core_attn_out,
+                z,
+                sources=sources,
+            )
+
+    try:
+        num_decodes = int(metadata.num_decodes)
+        num_actual_tokens = int(metadata.num_actual_tokens)
+        num_prefills = int(metadata.num_prefills)
+        num_prefill_tokens = int(metadata.num_prefill_tokens)
+        num_spec_decodes = int(metadata.num_spec_decodes)
+        num_spec_decode_tokens = int(metadata.num_spec_decode_tokens)
+        num_decode_tokens = int(metadata.num_decode_tokens)
+        if not (
+            num_prefills == 0
+            and num_prefill_tokens == 0
+            and num_spec_decodes == 0
+            and num_spec_decode_tokens == 0
+            and num_decodes == num_decode_tokens == num_actual_tokens
+            and 0 < num_decodes <= _MAX_DECODE_BATCH
+            and metadata.spec_sequence_masks is None
+        ):
+            return None
+
+        tp_size = int(layer.tp_size)
+        num_k_heads = int(layer.num_k_heads)
+        num_v_heads = int(layer.num_v_heads)
+        head_k_dim = int(layer.head_k_dim)
+        head_v_dim = int(layer.head_v_dim)
+        if (
+            tp_size <= 0
+            or num_k_heads % tp_size != 0
+            or num_v_heads % tp_size != 0
+            or head_k_dim != _HEAD_DIM
+            or head_v_dim != _HEAD_DIM
+            or int(layer.conv_kernel_size) != 4
+            or num_v_heads % num_k_heads != 0
+            or str(layer.activation).lower() not in {"silu", "swish"}
+            or is_conv_state_dim_first()
+            or not isinstance(layer.gqa_interleaved_layout, bool)
+        ):
+            return None
+
+        local_k_heads = num_k_heads // tp_size
+        local_v_heads = num_v_heads // tp_size
+        if layer.gqa_interleaved_layout:
+            remaining_threads = 32 - 4 * local_k_heads
+            if remaining_threads <= 0:
+                return None
+            double_v = local_v_heads > remaining_threads // 2
+            useful_threads = 4 * local_k_heads + (
+                local_v_heads if double_v else 2 * local_v_heads
+            )
+            if useful_threads > 32:
+                return None
+        conv_dim = 2 * local_k_heads * head_k_dim + local_v_heads * head_v_dim
+        qkvz_dim = 2 * local_k_heads * head_k_dim + 2 * local_v_heads * head_v_dim
+        ba_dim = 2 * local_v_heads
+        expected_output_shape = (num_decodes, local_v_heads, head_v_dim)
+
+        if not (
+            _is_contiguous_tensor(projected_qkvz, dtype=torch.float16, ndim=2)
+            and projected_qkvz.shape == (num_decodes, qkvz_dim)
+            and _is_contiguous_tensor(projected_ba, dtype=torch.float16, ndim=2)
+            and projected_ba.shape == (num_decodes, ba_dim)
+            and _is_contiguous_tensor(core_attn_out, dtype=torch.float16, ndim=3)
+            and core_attn_out.shape == expected_output_shape
+            and _is_contiguous_tensor(z, dtype=torch.float16, ndim=3)
+            and z.shape == expected_output_shape
+        ):
+            return None
+
+        state_indices = metadata.non_spec_state_indices_tensor
+        if not (
+            _is_contiguous_tensor(state_indices, dtype=torch.int32, ndim=1)
+            and state_indices.numel() >= num_decodes
+        ):
+            return None
+
+        conv_state, ssm_state = sources.kv_cache
+        if not (
+            _is_xpu_tensor(conv_state)
+            and conv_state.dtype == torch.float16
+            and conv_state.ndim == 3
+            and conv_state.shape[0] > 0
+            and conv_state.shape[1] == int(layer.conv_kernel_size) - 1
+            and conv_state.shape[2] == conv_dim
+            and conv_state.stride()[1:] == (conv_dim, 1)
+            and _is_xpu_tensor(ssm_state)
+            and ssm_state.dtype == torch.float16
+            and ssm_state.ndim == 4
+            and ssm_state.shape[0] > 0
+            and ssm_state.shape[1:] == (local_v_heads, head_v_dim, head_k_dim)
+            and ssm_state.stride()[1:] == (head_v_dim * head_k_dim, head_k_dim, 1)
+            and state_indices.device == conv_state.device
+            and conv_state.device == ssm_state.device
+        ):
+            return None
+
+        conv_weight = sources.conv_weight
+        a_log = sources.a_log
+        dt_bias = sources.dt_bias
+        if not (
+            _is_xpu_tensor(conv_weight)
+            and conv_weight.ndim == 3
+            and conv_weight.shape == (conv_dim, 1, int(layer.conv_kernel_size))
+            and conv_weight.is_contiguous()
+            and conv_weight.dtype in (torch.float16, torch.bfloat16, torch.float32)
+            and _is_xpu_tensor(a_log)
+            and a_log.ndim == 1
+            and a_log.shape == (local_v_heads,)
+            and _is_xpu_tensor(dt_bias)
+            and dt_bias.ndim == 1
+            and dt_bias.shape == (local_v_heads,)
+            and conv_weight.device == a_log.device
+            and conv_weight.device == dt_bias.device
+            and projected_qkvz.device == conv_weight.device
+            and projected_ba.device == projected_qkvz.device
+            and core_attn_out.device == projected_qkvz.device
+            and z.device == projected_qkvz.device
+        ):
+            return None
+
+        # Metadata builders produce in-range XPU indices. Validate CPU/mock
+        # indices here as well without introducing a per-layer device sync on
+        # the real eager XPU path.
+        if state_indices.device.type == "cpu":
+            selected_indices = state_indices[:num_decodes]
+            if bool((selected_indices < 0).any()) or bool(
+                (selected_indices >= conv_state.shape[0]).any()
+            ):
+                return None
+
+        conv_bias = sources.conv_bias
+        if conv_bias is not None and (
+            not _is_xpu_tensor(conv_bias)
+            or conv_bias.ndim != 1
+            or conv_bias.shape != (conv_dim,)
+            or conv_bias.device != conv_weight.device
+        ):
+            return None
+    except (AttributeError, IndexError, TypeError, ValueError):
+        return None
+
+    try:
+        module = _load_esimd_module()
+    except (ImportError, OSError, AttributeError, RuntimeError):
+        return None
+    op_name = (
+        "esimd_gdn_conv_fused"
+        if layer.gqa_interleaved_layout
+        else "esimd_gdn_conv_fused_seq"
+    )
+    if using_qwen38_sycl():
+        capability = getattr(module, "has_esimd_gdn_conv_fused_seq", None)
+        if (
+            layer.gqa_interleaved_layout
+            or not callable(capability)
+            or not capability(local_k_heads, local_v_heads, head_k_dim, head_v_dim)
+        ):
+            return None
+    op = getattr(module, op_name, None)
+    if not callable(op):
+        return None
+
+    layer._esimd_gdn_core_guard_plan = _GdnCoreGuardPlan(
+        op=op,
+        local_k_heads=local_k_heads,
+        local_v_heads=local_v_heads,
+        head_k_dim=head_k_dim,
+        head_v_dim=head_v_dim,
+        qkvz_dim=qkvz_dim,
+        ba_dim=ba_dim,
+        geometry=_core_geometry_signature(layer),
+        state_layouts=_state_layout_signature(sources.kv_cache),
+    )
+    return (
+        op,
+        metadata,
+        state_indices[:num_decodes],
+        conv_state,
+        ssm_state,
+        conv_weight,
+        conv_bias,
+        num_decodes,
+        local_k_heads,
+        local_v_heads,
+        head_k_dim,
+        head_v_dim,
+    )
+
+
+def try_esimd_gdn_core_decode(
+    layer: Any,
+    projected_qkvz: torch.Tensor,
+    projected_ba: torch.Tensor,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+) -> bool:
+    """Run the ESIMD GDN core when all decode-only guards pass.
+
+    The function returns ``False`` without mutating state when the optional
+    package, metadata, layout, dtype, or shape is not eligible. Callers must
+    invoke the existing native GDN op when this returns ``False``.
+    """
+    metadata = _metadata_for_layer(layer)
+    if metadata is None:
+        return False  # Profiling precedes KV-cache binding in v0.31.
+    kv_cache = layer.kv_cache  # Real metadata without a binding is a hard error.
+    if getattr(metadata, "spec_sequence_masks", None) is not None:
+        # The following speculative adapter owns all live binding/state checks.
+        # The decode guard always rejects this scenario, so do not run a second
+        # set of weight/mode/stream probes before that adapter.
+        return False
+    conv = layer.conv1d
+    try:
+        sources = _GdnDecodeSources(
+            metadata, kv_cache, conv.weight, conv.bias, layer.A_log, layer.dt_bias
+        )
+    except (AttributeError, TypeError):
+        return False
+    if not _bind_live_parameters(
+        layer,
+        (projected_qkvz, projected_ba, core_attn_out, z),
+        (layer, conv),
+        (*_PARAM_ATTRS, "_esimd_gdn_core_guard_plan", "_esimd_gdn_A_log_spec_v2"),
+        parameter_names=(("A_log", "dt_bias"), ("weight", "bias")),
+        parameter_values=(
+            sources.a_log,
+            sources.dt_bias,
+            sources.conv_weight,
+            sources.conv_bias,
+        ),
+    ):
+        return False
+    if not _direct_parameters(*kv_cache):
+        return False
+
+    guard = _decode_guard(
+        layer, projected_qkvz, projected_ba, core_attn_out, z, sources=sources
+    )
+    if guard is None:
+        return False
+
+    (
+        op,
+        _metadata,
+        state_indices,
+        conv_state,
+        ssm_state,
+        conv_weight,
+        conv_bias,
+        num_decodes,
+        local_k_heads,
+        local_v_heads,
+        head_k_dim,
+        head_v_dim,
+    ) = guard
+    if not _disjoint_writes(
+        (conv_state, ssm_state, core_attn_out, z),
+        (
+            projected_qkvz,
+            projected_ba,
+            conv_weight,
+            conv_bias,
+            sources.a_log,
+            sources.dt_bias,
+        ),
+    ):
+        return False
+
+    # The optional kernel consumes fp16 parameter buffers. Build them only
+    # after every fallback guard above has passed, so rejection is side-effect
+    # free with respect to the layer and both state pools.
+    if not all(hasattr(layer, name) for name in _PARAM_ATTRS):
+        try:
+            conv_weight_fp16 = (
+                conv_weight.view(conv_weight.shape[0], conv_weight.shape[2])
+                .detach()
+                .to(dtype=torch.float16)
+                .contiguous()
+            )
+            conv_bias_fp16 = (
+                torch.zeros(
+                    conv_weight.shape[0],
+                    dtype=torch.float16,
+                    device=conv_weight.device,
+                )
+                if conv_bias is None
+                else conv_bias.detach().to(dtype=torch.float16).contiguous()
+            )
+            a_log_fp16 = sources.a_log.detach().to(dtype=torch.float16).contiguous()
+            dt_bias_fp16 = sources.dt_bias.detach().to(dtype=torch.float16).contiguous()
+            attn_scale = float(head_k_dim**-0.5)
+        except (AttributeError, RuntimeError, TypeError, ValueError):
+            return False
+        layer._esimd_gdn_conv_weight_fp16 = conv_weight_fp16
+        layer._esimd_gdn_conv_bias_fp16 = conv_bias_fp16
+        layer._esimd_gdn_A_log_fp16 = a_log_fp16
+        layer._esimd_gdn_dt_bias_fp16 = dt_bias_fp16
+        layer._esimd_gdn_attn_scale = attn_scale
+
+    # Do not catch execution errors here. The kernel mutates the recurrent
+    # state in place, so falling back after a partial launch could corrupt it.
+    op(
+        projected_qkvz,
+        conv_state,
+        layer._esimd_gdn_conv_weight_fp16,
+        layer._esimd_gdn_conv_bias_fp16,
+        state_indices,
+        layer._esimd_gdn_A_log_fp16,
+        layer._esimd_gdn_dt_bias_fp16,
+        projected_ba,
+        ssm_state,
+        state_indices,
+        core_attn_out,
+        z,
+        num_decodes,
+        local_k_heads,
+        local_v_heads,
+        head_k_dim,
+        head_v_dim,
+        layer._esimd_gdn_attn_scale,
+    )
+    return True
+
+
+def _active_prefix(value: torch.Tensor, size: int) -> torch.Tensor | None:
+    if value.numel() < size:
+        return None
+    if value.numel() == size:
+        return value
+    return value.narrow(0, 0, size)
+
+
+def _active_spec_state_prefix(
+    value: torch.Tensor, num_spec_tokens: int
+) -> torch.Tensor | None:
+    if value.numel() < num_spec_tokens:
+        return None
+    if value.numel() == num_spec_tokens:
+        return value
+    if value.ndim != 2 or value.shape[0] < 1 or value.shape[1] != num_spec_tokens:
+        return None
+    return value.narrow(0, 0, 1)
+
+
+_QWEN38_SPEC_V2_MAX_TOKENS = 8
+
+
+def _spec_gdn_op_name(
+    local_k_heads: int, local_v_heads: int, num_spec_tokens: int
+) -> str | None:
+    if local_k_heads == 8 and local_v_heads in (16, 24):
+        return "esimd_gdn_conv_fused_seq_spec"
+    if (local_k_heads, local_v_heads) in (
+        (2, 6),
+        (4, 12),
+    ) and 2 <= num_spec_tokens <= _QWEN38_SPEC_V2_MAX_TOKENS:
+        return "esimd_gdn_conv_fused_seq_spec_v2"
+    return None
+
+
+def try_esimd_gdn_core_spec_decode(
+    layer: Any,
+    projected_qkvz: torch.Tensor,
+    projected_ba: torch.Tensor,
+    core_attn_out: torch.Tensor,
+    z: torch.Tensor,
+) -> bool:
+    """Run the sequential ESIMD GDN core for one speculative request."""
+    metadata = _metadata_for_layer(layer)
+    if metadata is None:
+        return False
+    kv_cache = layer.kv_cache  # Do not hide an incomplete real cache binding.
+    if _SPEC_GDN_DISABLED or getattr(torch.compiler, "is_compiling", lambda: False)():
+        return False
+    if not _bind_live_parameters(
+        layer,
+        (projected_qkvz, projected_ba, core_attn_out, z),
+        (layer, layer.conv1d),
+        (*_PARAM_ATTRS, "_esimd_gdn_core_guard_plan", "_esimd_gdn_A_log_spec_v2"),
+        parameter_names=(("A_log", "dt_bias"), ("weight", "bias")),
+    ):
+        return False
+    if not _direct_parameters(*kv_cache):
+        return False
+
+    try:
+        num_spec_decodes = int(metadata.num_spec_decodes)
+        num_spec_tokens = int(metadata.num_spec_decode_tokens)
+        tp_size = int(layer.tp_size)
+        if not (
+            int(metadata.num_prefills) == 0
+            and int(metadata.num_prefill_tokens) == 0
+            and int(metadata.num_decodes) == 0
+            and int(metadata.num_decode_tokens) == 0
+            and num_spec_decodes == 1
+            and num_spec_tokens == int(metadata.num_actual_tokens)
+            and num_spec_tokens > 1
+            and metadata.spec_sequence_masks is not None
+            and not layer.gqa_interleaved_layout
+            and tp_size > 0
+            and int(layer.num_k_heads) % tp_size == 0
+            and int(layer.num_v_heads) % tp_size == 0
+            and int(layer.head_k_dim) == _HEAD_DIM
+            and int(layer.head_v_dim) == _HEAD_DIM
+            and int(layer.conv_kernel_size) == 4
+            and str(layer.activation).lower() in {"silu", "swish"}
+            and not is_conv_state_dim_first()
+        ):
+            return False
+
+        local_k_heads = int(layer.num_k_heads) // tp_size
+        local_v_heads = int(layer.num_v_heads) // tp_size
+        if _spec_gdn_op_name(local_k_heads, local_v_heads, num_spec_tokens) is None:
+            return False
+
+        qkvz_dim = 2 * local_k_heads * _HEAD_DIM + 2 * local_v_heads * _HEAD_DIM
+        ba_dim = 2 * local_v_heads
+        output_shape = (num_spec_tokens, local_v_heads, _HEAD_DIM)
+        if not (
+            _is_contiguous_tensor(projected_qkvz, dtype=torch.float16, ndim=2)
+            and projected_qkvz.shape == (num_spec_tokens, qkvz_dim)
+            and _is_contiguous_tensor(projected_ba, dtype=torch.float16, ndim=2)
+            and projected_ba.shape == (num_spec_tokens, ba_dim)
+            and _is_contiguous_tensor(core_attn_out, dtype=torch.float16, ndim=3)
+            and core_attn_out.shape == output_shape
+            and _is_contiguous_tensor(z, dtype=torch.float16, ndim=3)
+            and z.shape == output_shape
+        ):
+            return False
+
+        state_indices = metadata.spec_state_indices_tensor
+        spec_token_indices = metadata.spec_token_indx
+        num_accepted_tokens = metadata.num_accepted_tokens
+        if not (
+            _is_contiguous_tensor(state_indices, dtype=torch.int32)
+            and state_indices.ndim in (1, 2)
+            and _is_contiguous_tensor(spec_token_indices, dtype=torch.int32, ndim=1)
+            and _is_contiguous_tensor(num_accepted_tokens, dtype=torch.int32, ndim=1)
+        ):
+            return False
+        state_indices = _active_spec_state_prefix(state_indices, num_spec_tokens)
+        spec_token_indices = _active_prefix(spec_token_indices, num_spec_tokens)
+        num_accepted_tokens = _active_prefix(num_accepted_tokens, num_spec_decodes)
+        if (
+            state_indices is None
+            or spec_token_indices is None
+            or num_accepted_tokens is None
+        ):
+            return False
+
+        conv_state, ssm_state = layer.kv_cache
+        conv_dim = 2 * local_k_heads * _HEAD_DIM + local_v_heads * _HEAD_DIM
+        conv_weight = layer.conv1d.weight
+        conv_bias = layer.conv1d.bias
+        if not (
+            _is_xpu_tensor(conv_state)
+            and conv_state.dtype == torch.float16
+            and conv_state.ndim == 3
+            and conv_state.shape[0] > 0
+            and (conv_state.shape[1] == 3 or conv_state.shape[1] >= num_spec_tokens + 2)
+            and conv_state.shape[2] == conv_dim
+            and conv_state.stride()[1:] == (conv_dim, 1)
+            and _is_xpu_tensor(ssm_state)
+            and ssm_state.dtype == torch.float16
+            and ssm_state.shape[1:]
+            == (
+                local_v_heads,
+                _HEAD_DIM,
+                _HEAD_DIM,
+            )
+            and _is_xpu_tensor(conv_weight)
+            and conv_weight.shape == (conv_dim, 1, 4)
+            and conv_weight.is_contiguous()
+            and conv_weight.dtype in (torch.float16, torch.bfloat16, torch.float32)
+            and _is_xpu_tensor(layer.A_log)
+            and layer.A_log.shape == (local_v_heads,)
+            and _is_xpu_tensor(layer.dt_bias)
+            and layer.dt_bias.shape == (local_v_heads,)
+            and state_indices.device == conv_state.device
+            and spec_token_indices.device == conv_state.device
+            and num_accepted_tokens.device == conv_state.device
+            and ssm_state.device == conv_state.device
+            and conv_weight.device == conv_state.device
+            and layer.A_log.device == conv_state.device
+            and layer.dt_bias.device == conv_state.device
+            and projected_qkvz.device == conv_state.device
+            and projected_ba.device == conv_state.device
+            and core_attn_out.device == conv_state.device
+            and z.device == conv_state.device
+        ):
+            return False
+        if state_indices.device.type == "cpu" and (
+            bool((state_indices < 0).any())
+            or bool((state_indices >= conv_state.shape[0]).any())
+        ):
+            return False
+        if conv_bias is not None and (
+            not _is_xpu_tensor(conv_bias)
+            or conv_bias.shape != (conv_dim,)
+            or conv_bias.device != conv_weight.device
+        ):
+            return False
+    except (AttributeError, IndexError, TypeError, ValueError):
+        return False
