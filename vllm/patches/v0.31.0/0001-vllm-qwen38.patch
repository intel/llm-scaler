+        runtime_tensors = {
+            "hidden_states": hidden_states,
+            "query": query,
+            "key": key,
+            "value": value,
+            "output": output,
+            "main_kv_cache": self.kv_cache,
+            "raw_key_cache": self.indexer.raw_key_cache.kv_cache,
+            "compressed_key_cache": self.indexer.compressed_key_cache.kv_cache,
+        }
