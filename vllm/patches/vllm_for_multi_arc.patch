+
+from vllm.model_executor.models import _qwen3_next_xpu, qwen3_next
+from vllm.model_executor.models._qwen3_next_xpu import Qwen3NextQkvEsimdAdapter
+
+
+@pytest.mark.parametrize(
+    ("quant_name", "expected"),
