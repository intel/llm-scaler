+            bias=None,
+            return_value=(torch.zeros(4, 2, dtype=torch.float16), None),
+        ),
+        _esimd_moe_ops=SimpleNamespace(
+            moe_forward_full_fp8_block=lambda *args: args[2],
+            esimd_gemv_fp16=Mock(),
