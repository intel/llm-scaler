+_VOCAB = {
+    "<think>": 10,
+    "</think>": 11,
+    "<|im_end|>": 12,
+    "<tool_call>": 13,
+    "</tool_call>": 14,
+}
+
+_TOOLS = [
+    ChatCompletionToolsParam(
+        type="function",
+        function={
