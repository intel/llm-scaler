+                    pos3d[2, 0, t_bs:t_be] = w_idx + base
+                else:
+                    fallback = (
+                        torch.arange(n_thumb, device=device, dtype=torch.long) + base
+                    )
+                    for d in range(3):
+                        pos3d[d, 0, t_bs:t_be] = fallback
+
