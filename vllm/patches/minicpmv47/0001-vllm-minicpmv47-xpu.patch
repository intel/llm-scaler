+# ---------------------------------------------------------------------------
+# XpuQkvNormRopeFusionPass
+# ---------------------------------------------------------------------------
+FUSED_OP = "_xpu_C.qkv_split_norm_rope"
+
+ROPE_PARAMETERS = {
+    "mrope_interleaved": True,
+    "mrope_section": [11, 11, 10],
+    "partial_rotary_factor": 0.25,
+    "rope_theta": 10000000,
+    "rope_type": "default",
+}
